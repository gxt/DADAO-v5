# id: stm.b_rrri_rd
# stm 允许 rdHA 为 rd0（rd0 作为源寄存器读出 0）、允许索引寄存器落入传送范围（§1 限制）⇒ 均不判 ILLI
if (immu6 == 6'd0) {                          # 个数为 0（有效范围 1~63）
