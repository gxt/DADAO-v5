 #include "semihosting/uaccess.h"
+
+/*
+ * String argument measurement (SYS_WRITE0 and the length-less path forms).
+ *
+ * The default walks the address through the current MMU context, which is what
+ * a target whose semihosting pointers are VAs needs.  DADAO is the opposite:
+ * spec/Kaiwu §5.2 / contract-semihosting §2 make every semihosting
+ * pointer a **physical address**, so `target/dadao/common-semi-target.c`
+ * provides a strong definition of this hook that reads physical memory.  The
+ * weak default keeps every other target on its existing path, byte for byte.
+ */
+ssize_t __attribute__((weak)) common_semi_strlen(CPUState *cs, vaddr addr)
+{
+    CPUArchState *env G_GNUC_UNUSED = cpu_env(cs);
+
+    return target_strlen(addr);
+}
+#else
+ssize_t __attribute__((weak)) common_semi_strlen(CPUState *cs, vaddr addr)
+{
+    (void)cs;
+
+    return target_strlen(addr);
+}
 #endif
 
 static inline uint32_t get_swi_errno(CPUState *cs)
@@ -404,7 +428,23 @@ void do_common_semihosting(CPUState *cs)
         GET_ARG(0);
