-        s = lock_user_string(arg0);
+        /*
+         * Lock the file name.  Its length comes from the target's semihosting
+         * string hook instead of lock_user_string(): the latter would measure
+         * the pointer through the page table (uaccess_strlen_user ->
+         * probe_access_flags), which is wrong for a target whose semihosting
+         * pointers are physical addresses (spec/Kaiwu §5.2,
+         * contract-semihosting §2) — the file name would fault with EFAULT
+         * before the lock even happened.  This is the system-mode twin of
+         * lock_user_string() (target_strlen + lock_user), and the hook's weak
+         * default is exactly target_strlen(), so every other target keeps its
+         * previous behaviour byte for byte.
+         */
+        ssize_t name_len = common_semi_strlen(cs, arg0);
+        if (name_len < 0) {
+            goto do_fault;
+        }
+        s = lock_user(VERIFY_READ, arg0, name_len + 1, 1);
         if (!s) {
             goto do_fault;
         }
