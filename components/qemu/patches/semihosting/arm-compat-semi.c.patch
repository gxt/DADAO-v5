+/*
+ * String argument measurement (SYS_WRITE0 and the length-less path forms).
+ *
+ * The default walks the address through the current MMU context, which is what
+ * a target whose semihosting pointers are VAs needs.  DADAO is the opposite:
+ * spec/Kaiwu §5.2 / contract-semihosting §2 make every semihosting
+ * pointer a **physical address**, so `target/dadao/common-semi-target.c`
+ * provides a strong definition of this hook that reads physical memory.  The
+ * weak default keeps every other target on its existing path, byte for byte.
+ */
+ssize_t __attribute__((weak)) common_semi_strlen(CPUState *cs, vaddr addr)
+{
+    CPUArchState *env G_GNUC_UNUSED = cpu_env(cs);
+
+    return target_strlen(addr);
+}
+#else
+ssize_t __attribute__((weak)) common_semi_strlen(CPUState *cs, vaddr addr)
+{
+    (void)cs;
+
+    return target_strlen(addr);
+}
 #endif
 
+/*
+ * Address of the internal scratch slot (ISS-452).
+ *
+ * SYS_READC (0x07) and SYS_FLEN (0x0c) take no buffer argument, yet both need
+ * a byte / a 64-byte gdb_stat block in target memory; upstream puts it just
+ * below the target's stack pointer, i.e. inside the target's own pointer
+ * space.  That is only correct while the stack pointer is expressed in the
+ * same address space as semihosting pointers.
+ *
+ * DADAO is the case where it is not: semihosting pointers are **physical
+ * addresses** (spec/Kaiwu §5.2, contract-semihosting §2, user ruling
+ * 2026-11-15) while the stack pointer is a VA once the kernel runs on the
+ * page table (contract/linux-boot.yml §6.3), so `SP - 1` names a VA that the
+ * responder then reads as a PA — an address outside RAM, hence EFAULT.
+ * `target/dadao/common-semi-target.c` therefore provides a strong definition
+ * of this hook that converts the stack slot to its physical address.  The weak
+ * default below is exactly upstream's `SP - size`, so every other target keeps
+ * its previous behaviour byte for byte.
+ *
+ * Returns: 0 with @addr set to the slot, or -1 when the slot cannot be named
+ *          in the target's semihosting pointer space.
+ */
+int __attribute__((weak)) common_semi_scratch_addr(CPUState *cs, uint64_t size,
+                                                   uint64_t *addr)
+{
+    *addr = common_semi_stack_bottom(cs) - size;
+    return 0;
+}
