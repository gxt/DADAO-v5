+/* ---------------------------------------------------------------------------
+ * Image loading
+ *
+ * Path selection is governed by contract-elf.md §5/§6 and ADR-0004 D2.2/D2.3.
+ * On the ELF path the segment load (every PT_LOAD, VA=PA, with the
+ * (p_memsz - p_filesz) tail zero-filled) and the entry point (e_entry) are
+ * delegated to the upstream loader in hw/core/loader.c (the standard
+ * load_elf() API) rather than re-implemented here.  The ELF header rules
+ * (e_type == ET_EXEC, e_flags version 1 / reserved bits zero) and the segment
+ * consistency/range rules (p_filesz <= p_memsz, p_vaddr == p_paddr, segment
+ * interval inside RAM -- RAM-only, a ROM-window segment is a load error; user
+ * decision D, 2026-10-09) that the upstream loader does not enforce
+ * -- contract-elf.md §1.3/§5.2/§6.1.2 -- are checked here before the load.
+ * ------------------------------------------------------------------------- */
+
+/* EM_DADAO is project-custom and not defined by QEMU's include/elf.h. */
+#define DADAO_EM_MACHINE            0x0DA0
+
+/* contract-elf.md §1.3: e_flags bits 0-7 = object/ABI format version (M1 = 1),
+ * bits 8-31 reserved and must be 0. */
+#define DADAO_EFLAGS_VERSION_MASK   0x000000FFu
+#define DADAO_EFLAGS_RESERVED_MASK  0xFFFFFF00u
+#define DADAO_EFLAGS_VERSION_1      0x00000001u
+
+/*
+ * Regions an ELF PT_LOAD interval may occupy (contract-elf.md §5/§6.1.2).
+ *
+ * Vast: an ELF loaded over -kernel is a PA RAM image (identity VA=PA) --
+ * only RAM is allowed.  A segment in the boot ROM window is a load-stage
+ * error (non-zero exit), never a ROM load.  This table is used only to
+ * validate a segment interval before the load; the placement itself is still
+ * done by the upstream loader.
+ *
+ * Kaiwu-Tiny: the host loader loads only the application's SRAM segments
+ * (spec/Kaiwu §6/§6.2).  A PT_LOAD in the BootROM or in hmon SRAM is a
+ * load-stage error -- the power stub inside the fixed firmware is the only
+ * writer of hmon SRAM and the firmware image itself is supplied separately.
+ */
+typedef struct DadaoMappedRegion {
+    uint64_t base;
+    uint64_t size;
+} DadaoMappedRegion;
+
+#define DADAO_MAX_MAPPED_REGIONS 3
+
+static unsigned
+dadao_mapped_regions(const DadaoProfile *prof,
+                     DadaoMappedRegion regions[DADAO_MAX_MAPPED_REGIONS])
+{
+    unsigned n = 0;
+
+    regions[n++] = (DadaoMappedRegion){ prof->ram_base, prof->ram_size };
+    if (prof->rom_elf_segments) {
+        regions[n++] = (DadaoMappedRegion){ prof->rom_base, prof->rom_size };
+    }
+    if (prof->mon_elf_segments) {
+        /* Opt-in profile hook only (no current profile sets it): the host
+         * loader would install the hmon image straight into hmon SRAM. */
+        regions[n++] = (DadaoMappedRegion){ DADAO_HMON_CFX_BASE,
+                                            DADAO_MON_SRAM_SIZE };
+    }
+    return n;
+}
+
+static bool dadao_addr_mapped(const DadaoProfile *prof, uint64_t addr)
+{
+    DadaoMappedRegion regions[DADAO_MAX_MAPPED_REGIONS];
+    unsigned n = dadao_mapped_regions(prof, regions);
+    unsigned r;
+
+    for (r = 0; r < n; r++) {
+        if (addr >= regions[r].base && addr < regions[r].base + regions[r].size) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Big-endian field readers (ELFDATA2MSB, contract-elf.md §1.1): the ELF is
+ * always big-endian regardless of host byte order. */
+static uint16_t dadao_rd_be16(const uint8_t *p)
+{
+    return (uint16_t)(((uint16_t)p[0] << 8) | (uint16_t)p[1]);
+}
+
+static uint32_t dadao_rd_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint64_t dadao_rd_be64(const uint8_t *p)
+{
+    return ((uint64_t)dadao_rd_be32(p) << 32) | (uint64_t)dadao_rd_be32(p + 4);
+}
+
+/*
+ * Explicit size-limit guards (ADR-0004 D2.3).  Kept behind a single switch so
+ * the evidence script can inject a "guards removed" counterexample.
+ */
+#define DADAO_ENFORCE_SIZE_LIMITS   1
+static const bool dadao_enforce_size_limits = DADAO_ENFORCE_SIZE_LIMITS;
+
+/* True if the buffer starts with the ELF magic number (contract-elf §6.1.2). */
+static bool dadao_is_elf_magic(const uint8_t *buf, gsize len)
+{
+    return len >= SELFMAG &&
+           buf[0] == ELFMAG0 && buf[1] == ELFMAG1 &&
+           buf[2] == ELFMAG2 && buf[3] == ELFMAG3;
+}
+
+/*
+ * Path selector (ADR-0004 D2.3, SPEC-107t): read only the leading magic so a
+ * large raw-bin kernel is not slurped into host memory just to classify it.
+ * Returns false when the file is unreadable or is not an ELF.
+ */
+static bool dadao_kernel_is_elf(const char *filename)
+{
+    uint8_t magic[SELFMAG];
+    ssize_t n;
+    int fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+
+    if (fd < 0) {
+        return false;
+    }
+    n = read(fd, magic, sizeof(magic));
+    close(fd);
+    return n == (ssize_t)sizeof(magic) &&
+           dadao_is_elf_magic(magic, sizeof(magic));
+}
+
+/*
+ * ELF header checks the upstream loader does not perform (contract-elf.md
+ * §1.3/§6.1.2): e_type must be ET_EXEC and e_flags must carry format version 1
+ * in bits 0-7 with reserved bits 8-31 clear.  Halts the process on a violation
+ * (load-stage error layer, ADR-0004 D2.3).  A file too short to hold
+ * Elf64_Ehdr is malformed and rejected here as well.  Fields are read
+ * big-endian (ELFDATA2MSB, §1.1); EI_DATA/EI_CLASS/e_machine are still left to
+ * the loader.
+ */
+static void dadao_elf_check_header(const char *filename)
+{
+    uint8_t hdr[sizeof(Elf64_Ehdr)];
+    uint16_t e_type;
+    uint32_t e_flags;
+    const size_t t_off = offsetof(Elf64_Ehdr, e_type);
+    const size_t f_off = offsetof(Elf64_Ehdr, e_flags);
+    ssize_t n;
+    int fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+
+    if (fd < 0) {
+        return; /* unreadable: let the loader report the real open error */
+    }
+    n = read(fd, hdr, sizeof(hdr));
+    close(fd);
+    if (n != (ssize_t)sizeof(hdr)) {
+        error_report("dadao: ELF kernel '%s' is smaller than Elf64_Ehdr",
+                     filename);
+        exit(1);
+    }
+
+    e_type = (uint16_t)((hdr[t_off] << 8) | hdr[t_off + 1]);
+    e_flags = ((uint32_t)hdr[f_off] << 24) | ((uint32_t)hdr[f_off + 1] << 16) |
+              ((uint32_t)hdr[f_off + 2] << 8) | (uint32_t)hdr[f_off + 3];
+
+    if (e_type != ET_EXEC) {
+        error_report("dadao: ELF kernel '%s' has e_type %u, expected "
+                     "ET_EXEC (%u)", filename, e_type, ET_EXEC);
+        exit(1);
+    }
+    if ((e_flags & DADAO_EFLAGS_VERSION_MASK) != DADAO_EFLAGS_VERSION_1) {
+        error_report("dadao: ELF kernel '%s' has e_flags %#x: version "
+                     "(e_flags[7:0]) %u is not 1",
+                     filename, e_flags, e_flags & DADAO_EFLAGS_VERSION_MASK);
+        exit(1);
+    }
+    if (e_flags & DADAO_EFLAGS_RESERVED_MASK) {
+        error_report("dadao: ELF kernel '%s' has e_flags %#x with reserved "
+                     "bits [31:8] set (must be 0)", filename, e_flags);
+        exit(1);
+    }
+}
+
+/*
+ * Raw-bin size guard (ADR-0004 D2.3): reject a blob larger than its region
+ * before loading, with the actual size and the limit in the message.  Returns
+ * 0 if within the limit or unreadable (the load reports the real error), -1 if
+ * oversize (message already reported).
+ */
+static int dadao_check_image_limit(const char *filename, const char *what,
+                                   uint64_t limit)
+{
+    int64_t size = get_image_size(filename, NULL);
+
+    if (size < 0) {
+        return 0;
+    }
+    if ((uint64_t)size > limit) {
+        error_report("dadao: %s image '%s' is %" PRId64 " bytes, exceeds the "
+                     "%s region size limit of %" PRIu64 " bytes",
+                     what, filename, size, what, limit);
+        return -1;
+    }
+    return 0;
+}
+
+/*
+ * PT_LOAD consistency and range checks the upstream loader does not enforce
+ * (contract-elf.md §5.2/§6.1.2, ADR-0004 D2.3): p_filesz <= p_memsz, VA == PA
+ * (p_vaddr == p_paddr), and the segment interval [p_vaddr, p_vaddr + p_memsz)
+ * fitting inside RAM with no arithmetic overflow.  An ELF loaded over -kernel
+ * is a RAM image, so a segment in the boot ROM window is a load-stage error
+ * too (user decision D, 2026-10-09).  A violation is a load-stage error
+ * (non-zero process exit), a different layer from guest faults (ADR-0004
+ * D4/D5).  The check is read-only and leaves the actual placement to the
+ * upstream loader.  A malformed file (short header, program header table out
+ * of file bounds, ...) is left to the loader, which reports it and returns an
+ * error.
+ */
+static void dadao_elf_check_segments(const char *filename,
+                                     const DadaoProfile *prof)
+{
+    uint8_t ehdr[sizeof(Elf64_Ehdr)];
+    uint8_t phdr[sizeof(Elf64_Phdr)];
+    uint64_t phoff;
+    uint16_t phentsize, phnum;
+    ssize_t n;
+    int fd;
+    unsigned i;
+
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        return; /* unreadable: let the loader report the real open error */
+    }
+    n = read(fd, ehdr, sizeof(ehdr));
+    if (n != (ssize_t)sizeof(ehdr)) {
+        close(fd);
+        return; /* too short: dadao_elf_check_header already rejected it */
+    }
+
+    phoff = dadao_rd_be64(ehdr + offsetof(Elf64_Ehdr, e_phoff));
+    phentsize = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phentsize));
+    phnum = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phnum));
+    if (phentsize != sizeof(Elf64_Phdr)) {
+        close(fd);
+        return; /* unexpected entry size: let the loader handle the file */
+    }
+
+    {
+    DadaoMappedRegion regions[DADAO_MAX_MAPPED_REGIONS];
+    unsigned nregions = dadao_mapped_regions(prof, regions);
+
+    for (i = 0; i < phnum; i++) {
+        uint64_t off = phoff + (uint64_t)i * phentsize;
+        uint64_t p_vaddr, p_paddr, p_filesz, p_memsz, end;
+        uint32_t p_type;
+        bool mapped = false;
+        unsigned r;
+
+        if (lseek(fd, (off_t)off, SEEK_SET) != (off_t)off) {
+            break; /* malformed: let the loader report it */
+        }
+        if (read(fd, phdr, sizeof(phdr)) != (ssize_t)sizeof(phdr)) {
+            break;
+        }
+        p_type = dadao_rd_be32(phdr + offsetof(Elf64_Phdr, p_type));
+        if (p_type != PT_LOAD) {
+            continue;
+        }
+        p_vaddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_vaddr));
+        p_paddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_paddr));
+        p_filesz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_filesz));
+        p_memsz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_memsz));
+
+        /* consistency: p_filesz <= p_memsz (contract-elf.md §6.1.2) */
+        if (p_filesz > p_memsz) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u has "
+                         "p_filesz %#" PRIx64 " > p_memsz %#" PRIx64,
+                         filename, i, p_filesz, p_memsz);
+            close(fd);
+            exit(1);
+        }
+        /* An empty PT_LOAD (p_memsz == 0) places nothing: skip the range
+         * check.  The Vast link script always emits a `.rom` PT_LOAD phdr
+         * even when the section is empty (dadao-node.lds), and a rejected
+         * empty ROM segment would make every Vast ELF unloadable. */
+        if (p_memsz == 0) {
+            continue;
+        }
+        /* VA=PA (contract-elf.md §5.2): the loader places at p_paddr */
+        if (p_vaddr != p_paddr) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u has "
+                         "p_vaddr %#" PRIx64 " != p_paddr %#" PRIx64
+                         " (VA=PA required)",
+                         filename, i, p_vaddr, p_paddr);
+            close(fd);
+            exit(1);
+        }
+        /* range + overflow (contract-elf.md §6.1.2) */
+        end = p_vaddr + p_memsz;
+        if (end < p_vaddr) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                         "interval [%#" PRIx64 ", %#" PRIx64 ") overflows",
+                         filename, i, p_vaddr, end);
+            close(fd);
+            exit(1);
+        }
+        for (r = 0; r < nregions; r++) {
+            uint64_t rbase = regions[r].base;
+            uint64_t rend = rbase + regions[r].size;
+
+            if (p_vaddr >= rbase && end <= rend) {
+                mapped = true;
+                break;
+            }
+        }
+        if (!mapped) {
+            /* Name the forbidden window when it is the Tiny contract that
+             * rejected the segment (spec/Kaiwu §6/§6.2). */
+            if (prof->bootrom_required &&
+                p_vaddr < prof->rom_base + prof->rom_size &&
+                end > prof->rom_base) {
+                error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                             "interval [%#" PRIx64 ", %#" PRIx64 ") targets "
+                             "the BootROM; the Kaiwu-Tiny load contract "
+                             "loads only SRAM (the fixed firmware is supplied "
+                             "by bootrom-image/-bios)",
+                             filename, i, p_vaddr, end);
+                close(fd);
+                exit(1);
+            }
+            if (prof->bootrom_required &&
+                p_vaddr < DADAO_HMON_CFX_BASE + DADAO_MON_SRAM_SIZE &&
+                end > DADAO_HMON_CFX_BASE) {
+                error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                             "interval [%#" PRIx64 ", %#" PRIx64 ") targets "
+                             "the hmon SRAM; the host must not preload hmon "
+                             "(the power stub copies it from the firmware)",
+                             filename, i, p_vaddr, end);
+                close(fd);
+                exit(1);
+            }
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                         "interval [%#" PRIx64 ", %#" PRIx64 ") is outside the "
+                         "mapped regions (RAM %#" PRIx64 " + %" PRIu64 " bytes%s%s)",
+                         filename, i, p_vaddr, end, (uint64_t)prof->ram_base,
+                         (uint64_t)prof->ram_size,
+                         prof->rom_elf_segments
+                             ? " or the BootROM"
+                             : "; the boot ROM window is rejected",
+                         prof->mon_elf_segments
+                             ? " or the hmon SRAM"
+                             : "");
+            close(fd);
+            exit(1);
+        }
+    }
+    }
+    close(fd);
+}
+
+/* DADAO Kaiwu machine state.  Both registered types share it. */
+typedef struct DadaoMachineState {
+    MachineState parent_obj;
+    /* BootROM image path (ADR-0043 D1/D2); NULL => -bios / ELF paths. */
+    char *bootrom_image;
+} DadaoMachineState;
+
+/* One registered machine type (M12): the profile is fixed per type. */
+typedef struct DadaoMachineDesc {
+    const char *desc;
+    const DadaoProfile *profile;
+} DadaoMachineDesc;
+
+typedef struct DadaoMachineClass {
+    MachineClass parent_class;
+    const DadaoProfile *profile;
+} DadaoMachineClass;
+
+/* Every registered type uses this instance/class size, so the casts below are
+ * the same first-member offset QOM's container_of macros would use. */
+static inline DadaoMachineState *dadao_machine_state(MachineState *machine)
+{
+    return (DadaoMachineState *)machine;
+}
+
+static inline DadaoMachineClass *dadao_machine_class(MachineClass *mc)
+{
+    return (DadaoMachineClass *)mc;
+}
+
+static char *dadao_machine_get_bootrom_image(Object *obj, Error **errp)
+{
+    DadaoMachineState *ms = dadao_machine_state(MACHINE(obj));
+
+    return g_strdup(ms->bootrom_image);
+}
+
+static void dadao_machine_set_bootrom_image(Object *obj, const char *value,
+                                            Error **errp)
+{
+    DadaoMachineState *ms = dadao_machine_state(MACHINE(obj));
+
+    g_free(ms->bootrom_image);
+    ms->bootrom_image = g_strdup(value);
+}
+
+/*
+ * Raw -kernel reserved prefix (spec/Kaiwu §6): Tiny's raw image starts at
+ * kernel_base and the first kernel_reserved bytes are reserved and must be
+ * zero; the application entry is base+reserved.  Returns 0 when within the
+ * rule (or the file is unreadable -- the loader reports that), -1 after
+ * reporting a violation.
+ */
+static int dadao_check_raw_prefix(const char *filename, uint64_t reserved)
+{
+    uint8_t *buf;
+    ssize_t n;
+    int fd;
+    uint64_t i;
+
+    if (reserved == 0) {
+        return 0;
+    }
+    if (reserved > SIZE_MAX) {
+        error_report("dadao: raw kernel reserved prefix is too large "
+                     "(%" PRIu64 " bytes)", reserved);
+        return -1;
+    }
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        return 0;
+    }
+    buf = g_malloc(reserved);
+    n = read(fd, buf, reserved);
+    close(fd);
+    if (n < 0) {
+        g_free(buf);
+        return 0;
+    }
+    if ((uint64_t)n < reserved) {
+        error_report("dadao: raw kernel '%s' is %" PRId64 " bytes, smaller "
+                     "than the reserved prefix of %" PRIu64 " bytes",
+                     filename, (int64_t)n, reserved);
+        g_free(buf);
+        return -1;
+    }
+    for (i = 0; i < reserved; i++) {
+        if (buf[i] != 0) {
+            error_report("dadao: raw kernel '%s': reserved prefix byte %"
+                         PRIu64 " is %#x, the first %" PRIu64 " bytes must be "
+                         "zero", filename, i, buf[i], reserved);
+            g_free(buf);
+            return -1;
+        }
+    }
+    g_free(buf);
+    return 0;
+}
+
+static void dadao_load_raw_kernel(const char *filename,
+                                  const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    uint64_t limit = prof->ram_size - prof->kernel_reserved;
+    ssize_t kernel_size;
+
+    if (dadao_enforce_size_limits &&
+        dadao_check_image_limit(filename, "RAM", limit) < 0) {
+        exit(1);
+    }
+    if (dadao_check_raw_prefix(filename, prof->kernel_reserved) < 0) {
+        exit(1);
+    }
+    kernel_size = load_image_targphys_as(filename, prof->kernel_base, limit,
+                                         &address_space_memory, &err);
+    if (kernel_size < 0) {
+        error_report("dadao: could not load kernel image '%s': %s",
+                     filename, err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+}
+
+/* Load an ELF -kernel and return its e_entry (validated to be mapped). */
+static uint64_t dadao_load_elf_kernel(const char *filename,
+                                      const DadaoProfile *prof)
+{
+    uint64_t entry = 0;
+    ssize_t elf_size;
+
+    dadao_elf_check_header(filename);
+    dadao_elf_check_segments(filename, prof);
+    elf_size = load_elf(filename, NULL, NULL, NULL, &entry, NULL,
+                        NULL, NULL, ELFDATA2MSB, DADAO_EM_MACHINE, 0, 0);
+    if (elf_size < 0) {
+        error_report("dadao: could not load ELF kernel '%s': %s",
+                     filename, load_elf_strerror(elf_size));
+        exit(1);
+    }
+    /* Kaiwu-Tiny: the fixed application entry is part of the load
+     * contract (spec/Kaiwu §6).  A different e_entry is a load-stage
+     * error, never silently overridden. */
+    if (prof->fixed_kernel_entry && entry != prof->kernel_entry) {
+        error_report("dadao: ELF kernel '%s': e_entry %#" PRIx64
+                     " is not the fixed application entry %#" PRIx64,
+                     filename, entry, prof->kernel_entry);
+        exit(1);
+    }
+    if (!dadao_addr_mapped(prof, entry)) {
+        error_report("dadao: ELF kernel '%s': e_entry %#" PRIx64 " is "
+                     "outside the mapped regions", filename, entry);
+        exit(1);
+    }
+    return entry;
+}
+
+static void dadao_load_bootrom_image(const char *filename,
+                                     const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    ssize_t bios_size;
+
+    bios_size = load_image_targphys_as(filename, prof->rom_base, prof->rom_size,
+                                       &address_space_memory, &err);
+    if (bios_size != (ssize_t)prof->rom_size) {
+        error_report("dadao: bootrom-image '%s' is %" PRId64 " bytes, "
+                     "expected exactly %" PRIu64 " bytes",
+                     filename, (int64_t)bios_size, prof->rom_size);
+        exit(1);
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Kaiwu-Vast K0 kernel boot ABI (spec/Kaiwu §6.3)
+ *
+ * The `bootrom-image` + `-kernel` path is the K1 (kernel boot) path: the host
+ * loader validates the kernel image against §6.3.2 (ELF: 7 rules; raw: 4
+ * rules), places it at the PA its VA maps to (`VA = PA + 2 TiB`; the page
+ * table carrying that mapping is built by smon, never here), writes the fixed
+ * 15-field boot info at VA 0x0200_0001_0000 (§6.3.3), and leaves the reset PC
+ * at the firmware reset vector (§6.3.2: the only entry jump is smon's
+ * `escape`).  The boot info page is written by the *host loader*; power, hmon
+ * and smon only read it.
+ *
+ * Every violation is a load-stage error: error_report() names the rule and the
+ * offending value, then exit(1) (FAIL-HOST).  No truncation, relocation or
+ * silent downgrade, and no half-loaded image is ever paired with a boot info.
+ *
+ * Rule names are the frozen identifiers of §6.3.2 / contracts/linux-boot.yaml
+ * `rules[].id`, so a rejected image can be attributed mechanically.
+ * ------------------------------------------------------------------------- */
+#define DADAO_K0_VA_OFFSET        0x0000020000000000ULL /* kernel window bias */
+#define DADAO_K0_RAM_BASE_VA      0x0000020000000000ULL /* ram_base (VA) */
+#define DADAO_K0_RAM_SIZE         0x0000000080000000ULL /* 2 GiB */
+#define DADAO_K0_BOOTINFO_VA      0x0000020000010000ULL
+#define DADAO_K0_RESERVED_END_VA  0x0000020000020000ULL
+#define DADAO_K0_KERNEL_BASE_VA   0x0000020000100000ULL
+#define DADAO_K0_KERNEL_END_VA    0x0000020004000000ULL
+#define DADAO_K0_INITRAMFS_BASE_VA 0x0000020004000000ULL
+#define DADAO_K0_INITRAMFS_END_VA 0x0000020006000000ULL
+#define DADAO_K0_PAGE_SHIFT       16
+#define DADAO_K0_PAGE_SIZE        (1ULL << DADAO_K0_PAGE_SHIFT) /* 64 KiB */
+#define DADAO_K0_KERNEL_ALIGN     DADAO_K0_PAGE_SIZE
+#define DADAO_K0_BOOTINFO_SIZE    0x60
+#define DADAO_K0_BOOTINFO_MAGIC   0x4442494E /* ASCII "DBIN" */
+#define DADAO_K0_BOOTINFO_VERSION 1
+#define DADAO_K0_HART_ID          0
+#define DADAO_K0_FLAGS            0x1 /* bit0: semihosting console available */
+
+/*
+ * The §6.3 contract is Kaiwu-Vast's: it is the only profile with the
+ * page-table walker and the smon firmware (spec/Kaiwu §1.1/§6.3).
+ */
+static bool dadao_k0_contract(const DadaoProfile *prof)
+{
+    return prof->ptw_supported && prof->smon_sram && prof->pmem_sram;
+}
+
+/* VA of the kernel window -> PA, the only place the bias is applied. */
+static uint64_t dadao_k0_pa(uint64_t va)
+{
+    return va - DADAO_K0_VA_OFFSET;
+}
+
+/* Big-endian boot info writers (§6.3.3: every multi-byte field is big-endian). */
+static void dadao_wr_be16(uint8_t *p, uint16_t v)
+{
+    p[0] = (uint8_t)(v >> 8);
+    p[1] = (uint8_t)v;
+}
+
+static void dadao_wr_be32(uint8_t *p, uint32_t v)
+{
+    dadao_wr_be16(p, (uint16_t)(v >> 16));
+    dadao_wr_be16(p + 2, (uint16_t)v);
+}
+
+static void dadao_wr_be64(uint8_t *p, uint64_t v)
+{
+    dadao_wr_be32(p, (uint32_t)(v >> 32));
+    dadao_wr_be32(p + 4, (uint32_t)v);
+}
+
+/*
+ * Write the fixed boot info at VA 0x0200_0001_0000 (§6.3.3): 15 fields,
+ * `size = 0x60`, everything after `size` up to the page end stays zero (RAM is
+ * zero on reset and no loaded segment may touch this page).  `kernel_size` is
+ * computed by the caller: ELF = max(p_vaddr + p_memsz) - kernel_base, raw =
+ * the image's byte count.  K1 installs no initramfs (initramfs_size = 0).
+ */
+static void dadao_k0_write_boot_info(const char *filename, uint64_t kernel_size)
+{
+    uint8_t bi[DADAO_K0_BOOTINFO_SIZE];
+    MemTxResult res;
+
+    memset(bi, 0, sizeof(bi));
+    dadao_wr_be32(bi + 0x00, DADAO_K0_BOOTINFO_MAGIC);
+    dadao_wr_be16(bi + 0x04, DADAO_K0_BOOTINFO_VERSION);
+    dadao_wr_be16(bi + 0x06, DADAO_K0_BOOTINFO_SIZE);
+    dadao_wr_be64(bi + 0x08, DADAO_K0_RAM_BASE_VA);
+    dadao_wr_be64(bi + 0x10, DADAO_K0_RAM_SIZE);
+    dadao_wr_be64(bi + 0x18, DADAO_K0_KERNEL_BASE_VA);
+    dadao_wr_be64(bi + 0x20, kernel_size);
+    dadao_wr_be64(bi + 0x28, DADAO_K0_INITRAMFS_BASE_VA);
+    dadao_wr_be64(bi + 0x30, 0);                 /* initramfs_size (K1: none) */
+    dadao_wr_be64(bi + 0x38, 0);                 /* cmdline_base */
+    dadao_wr_be64(bi + 0x40, 0);                 /* cmdline_size */
+    dadao_wr_be64(bi + 0x48, 0);                 /* ptbr (PA; PPN << 16) */
+    dadao_wr_be32(bi + 0x50, DADAO_K0_PAGE_SHIFT);
+    dadao_wr_be32(bi + 0x54, DADAO_K0_HART_ID);
+    dadao_wr_be64(bi + 0x58, DADAO_K0_FLAGS);
+
+    res = address_space_write(&address_space_memory,
+                              dadao_k0_pa(DADAO_K0_BOOTINFO_VA),
+                              MEMTXATTRS_UNSPECIFIED, bi, sizeof(bi));
+    if (res != MEMTX_OK) {
+        error_report("dadao: boot info write at VA %#" PRIx64 " (PA %#" PRIx64
+                     ") failed for kernel '%s': FAIL-HOST (boot info)",
+                     (uint64_t)DADAO_K0_BOOTINFO_VA,
+                     (uint64_t)dadao_k0_pa(DADAO_K0_BOOTINFO_VA), filename);
+        exit(1);
+    }
+}
+
+/* True when [base, end) intersects the §6.3 forbidden windows. */
+static bool dadao_k0_forbidden_overlap(uint64_t base, uint64_t end,
+                                       const DadaoProfile *prof,
+                                       const char **what)
+{
+    if (base < DADAO_K0_RESERVED_END_VA && end > DADAO_K0_RAM_BASE_VA) {
+        *what = "the boot reservation (page table + boot info page)";
+        return true;
+    }
+    if (base < prof->rom_base + prof->rom_size && end > prof->rom_base) {
+        *what = "the BootROM";
+        return true;
+    }
+    if (base < DADAO_HMON_CFX_BASE + DADAO_MON_SRAM_SIZE &&
+        end > DADAO_HMON_CFX_BASE) {
+        *what = "the hmon SRAM";
+        return true;
+    }
+    if (base < DADAO_SMON_CFX_BASE + DADAO_MON_SRAM_SIZE &&
+        end > DADAO_SMON_CFX_BASE) {
+        *what = "the smon SRAM";
+        return true;
+    }
+    return false;
+}
+
+/*
+ * §6.3.2 ELF path (7 rules).  The header/phdr tables are read big-endian by
+ * hand because the §6.3 contract has its own placement semantics (`p_vaddr` is
+ * the load address, `p_paddr` must be the matching PA) that the upstream
+ * loader does not check; the placement itself is then delegated to load_elf()
+ * (PA = p_paddr = p_vaddr - 2 TiB), which also zero-fills `.bss`.
+ */
+static uint64_t dadao_k0_check_elf(const char *filename,
+                                   const DadaoProfile *prof)
+{
+    uint8_t ehdr[sizeof(Elf64_Ehdr)];
+    uint8_t phdr[sizeof(Elf64_Phdr)];
+    uint64_t phoff, entry, kernel_size = 0;
+    uint16_t phentsize, phnum;
+    bool saw_load = false;
+    ssize_t n;
+    int fd;
+    unsigned i;
+
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        error_report("dadao: K0 ELF kernel '%s': cannot open", filename);
+        exit(1);
+    }
+    n = read(fd, ehdr, sizeof(ehdr));
+    if (n != (ssize_t)sizeof(ehdr)) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-FORMAT: file is %" PRId64
+                     " bytes, smaller than Elf64_Ehdr", filename, (int64_t)n);
+        close(fd);
+        exit(1);
+    }
+    /* ELF-FORMAT: ELFCLASS64, big-endian, e_machine, ET_EXEC, e_flags v1. */
+    if (!dadao_is_elf_magic(ehdr, SELFMAG) ||
+        ehdr[EI_CLASS] != ELFCLASS64 || ehdr[EI_DATA] != ELFDATA2MSB) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-FORMAT: expected "
+                     "ELFCLASS64/ELFDATA2MSB, got class %u/data %u",
+                     filename, ehdr[EI_CLASS], ehdr[EI_DATA]);
+        close(fd);
+        exit(1);
+    }
+    {
+        uint16_t e_type = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_type));
+        uint16_t e_machine =
+            dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_machine));
+        uint32_t e_flags =
+            dadao_rd_be32(ehdr + offsetof(Elf64_Ehdr, e_flags));
+
+        if (e_machine != DADAO_EM_MACHINE || e_type != ET_EXEC ||
+            (e_flags & DADAO_EFLAGS_VERSION_MASK) != DADAO_EFLAGS_VERSION_1 ||
+            (e_flags & DADAO_EFLAGS_RESERVED_MASK) != 0) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-FORMAT: e_machine "
+                         "%#x, e_type %u, e_flags %#x (expected %#x/ET_EXEC/"
+                         "version 1, reserved 0)", filename, e_machine, e_type,
+                         e_flags, DADAO_EM_MACHINE);
+            close(fd);
+            exit(1);
+        }
+    }
+    entry = dadao_rd_be64(ehdr + offsetof(Elf64_Ehdr, e_entry));
+    phoff = dadao_rd_be64(ehdr + offsetof(Elf64_Ehdr, e_phoff));
+    phentsize = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phentsize));
+    phnum = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phnum));
+    if (phentsize != sizeof(Elf64_Phdr) || phnum == 0) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-FORMAT: e_phentsize %u "
+                     "(expected 56), e_phnum %u", filename, phentsize, phnum);
+        close(fd);
+        exit(1);
+    }
+
+    for (i = 0; i < phnum; i++) {
+        uint32_t p_type;
+        uint64_t p_vaddr, p_paddr, p_filesz, p_memsz, p_align, end;
+        uint64_t off = phoff + (uint64_t)i * phentsize;
+        const char *what = NULL;
+
+        if (lseek(fd, (off_t)off, SEEK_SET) != (off_t)off ||
+            read(fd, phdr, sizeof(phdr)) != (ssize_t)sizeof(phdr)) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-PT-LOAD: program "
+                         "header table is outside the file", filename);
+            close(fd);
+            exit(1);
+        }
+        p_type = dadao_rd_be32(phdr + offsetof(Elf64_Phdr, p_type));
+        if (p_type != PT_LOAD) {
+            continue; /* ELF-PT-LOAD: only PT_LOAD is ever loaded */
+        }
+        p_vaddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_vaddr));
+        p_paddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_paddr));
+        p_filesz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_filesz));
+        p_memsz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_memsz));
+        p_align = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_align));
+
+        if (p_filesz > p_memsz) {
+            /* contract-elf §6.1.2 program-header consistency; no §6.3 rule
+             * name covers it on its own, so it is reported as ELF-PT-LOAD. */
+            error_report("dadao: K0 ELF kernel '%s': ELF-PT-LOAD: PT_LOAD "
+                         "segment %u has p_filesz %#" PRIx64 " > p_memsz %#"
+                         PRIx64, filename, i, p_filesz, p_memsz);
+            close(fd);
+            exit(1);
+        }
+        if (p_memsz == 0) {
+            /* An empty PT_LOAD places nothing (same rationale as the legacy
+             * Vast path: the link script may emit an empty .rom segment). */
+            continue;
+        }
+        saw_load = true;
+        /* ELF-VA-TO-PA: p_vaddr is the VA, p_paddr its PA (bias 2 TiB). */
+        if (p_paddr != p_vaddr - DADAO_K0_VA_OFFSET ||
+            p_vaddr < DADAO_K0_VA_OFFSET) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-VA-TO-PA: PT_LOAD "
+                         "segment %u has p_vaddr %#" PRIx64 ", p_paddr %#"
+                         PRIx64 " (expected p_paddr = p_vaddr - %#" PRIx64 ")",
+                         filename, i, p_vaddr, p_paddr,
+                         (uint64_t)DADAO_K0_VA_OFFSET);
+            close(fd);
+            exit(1);
+        }
+        /* ELF-ALIGN: 64 KiB page aligned, p_align at least one page. */
+        if ((p_vaddr % DADAO_K0_KERNEL_ALIGN) != 0 ||
+            p_align < DADAO_K0_KERNEL_ALIGN) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-ALIGN: PT_LOAD "
+                         "segment %u p_vaddr %#" PRIx64 " p_align %#" PRIx64
+                         " (both must be a multiple of/at least %#" PRIx64 ")",
+                         filename, i, p_vaddr, p_align,
+                         (uint64_t)DADAO_K0_KERNEL_ALIGN);
+            close(fd);
+            exit(1);
+        }
+        if (p_memsz > UINT64_MAX - p_vaddr) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-RANGE: PT_LOAD "
+                         "segment %u [%#" PRIx64 ", +%#" PRIx64 ") overflows",
+                         filename, i, p_vaddr, p_memsz);
+            close(fd);
+            exit(1);
+        }
+        end = p_vaddr + p_memsz;
+        /* ELF-NO-OVERLAP is checked before ELF-RANGE so a segment aimed at the
+         * boot info page is reported by the rule that names the clash. */
+        if (dadao_k0_forbidden_overlap(p_vaddr, end, prof, &what)) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-NO-OVERLAP: PT_LOAD "
+                         "segment %u interval [%#" PRIx64 ", %#" PRIx64
+                         ") overlaps %s", filename, i, p_vaddr, end, what);
+            close(fd);
+            exit(1);
+        }
+        /* ELF-RANGE: inside the kernel image region. */
+        if (p_vaddr < DADAO_K0_KERNEL_BASE_VA ||
+            end > DADAO_K0_KERNEL_END_VA) {
+            error_report("dadao: K0 ELF kernel '%s': ELF-RANGE: PT_LOAD "
+                         "segment %u interval [%#" PRIx64 ", %#" PRIx64
+                         ") is outside [%#" PRIx64 ", %#" PRIx64 ")",
+                         filename, i, p_vaddr, end,
+                         (uint64_t)DADAO_K0_KERNEL_BASE_VA,
+                         (uint64_t)DADAO_K0_KERNEL_END_VA);
+            close(fd);
+            exit(1);
+        }
+        if (end - DADAO_K0_KERNEL_BASE_VA > kernel_size) {
+            kernel_size = end - DADAO_K0_KERNEL_BASE_VA;
+        }
+    }
+    close(fd);
+
+    if (!saw_load) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-PT-LOAD: no non-empty "
+                     "PT_LOAD segment", filename);
+        exit(1);
+    }
+    /* ELF-ENTRY: the entry is the kernel base (VA), exactly. */
+    if (entry != DADAO_K0_KERNEL_BASE_VA) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-ENTRY: e_entry %#"
+                     PRIx64 " is not the kernel base VA %#" PRIx64,
+                     filename, entry, (uint64_t)DADAO_K0_KERNEL_BASE_VA);
+        exit(1);
+    }
+    return kernel_size;
+}
+
+static void dadao_k0_load_elf(const char *filename, const DadaoProfile *prof)
+{
+    uint64_t kernel_size = dadao_k0_check_elf(filename, prof);
+    uint64_t entry = 0;
+    ssize_t loaded;
+
+    loaded = load_elf(filename, NULL, NULL, NULL, &entry, NULL, NULL, NULL,
+                      ELFDATA2MSB, DADAO_EM_MACHINE, 0, 0);
+    if (loaded < 0) {
+        error_report("dadao: K0 ELF kernel '%s': ELF-PT-LOAD: the image could "
+                     "not be loaded into PA memory: %s", filename,
+                     load_elf_strerror(loaded));
+        exit(1);
+    }
+    dadao_k0_write_boot_info(filename, kernel_size);
+}
+
+/*
+ * §6.3.2 raw path (4 rules): the flat image *is* the kernel, so RAW-BASE is
+ * the load address (VA kernel_base), RAW-ENTRY its first byte, RAW-LENGTH the
+ * 63 MiB cap and RAW-BSS the kernel's own `.bss` duty (the loader does not
+ * interpret the blob).  The image is placed at the PA of kernel_base.
+ */
+static void dadao_k0_load_raw(const char *filename, const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    int64_t size = get_image_size(filename, NULL);
+    uint64_t limit = DADAO_K0_KERNEL_END_VA - DADAO_K0_KERNEL_BASE_VA;
+    ssize_t loaded;
+
+    if (size < 0) {
+        error_report("dadao: K0 raw kernel '%s': RAW-BASE: cannot read the "
+                     "image", filename);
+        exit(1);
+    }
+    if ((uint64_t)size > limit) {
+        error_report("dadao: K0 raw kernel '%s': RAW-LENGTH: %" PRId64
+                     " bytes exceeds the %#" PRIx64 "-byte kernel image "
+                     "region", filename, size, limit);
+        exit(1);
+    }
+    loaded = load_image_targphys_as(filename, dadao_k0_pa(DADAO_K0_KERNEL_BASE_VA),
+                                    limit, &address_space_memory, &err);
+    if (loaded < 0) {
+        error_report("dadao: K0 raw kernel '%s': RAW-BASE: could not load at "
+                     "VA %#" PRIx64 " (PA %#" PRIx64 "): %s", filename,
+                     (uint64_t)DADAO_K0_KERNEL_BASE_VA,
+                     (uint64_t)dadao_k0_pa(DADAO_K0_KERNEL_BASE_VA),
+                     err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+    dadao_k0_write_boot_info(filename, (uint64_t)size);
+}
+
+static void dadao_k0_load_kernel(const char *filename, const DadaoProfile *prof)
+{
+    if (dadao_kernel_is_elf(filename)) {
+        dadao_k0_load_elf(filename, prof);
+    } else {
+        dadao_k0_load_raw(filename, prof);
+    }
+}
+
+/*
+ * Kaiwu-Tiny `-bios` size rule (spec/Kaiwu §6): the option carries
+ * the fixed BootROM firmware -- the same image as `bootrom-image` -- and
+ * nothing else.  The image must be exactly rom_size (64 KiB); the legacy
+ * <= 4096-byte flat trampoline window is removed and no intermediate size is
+ * accepted, so a truncated firmware can never be mistaken for a trampoline.
+ *
+ * Returns 0 when the rule holds or the file is unreadable (the loader reports
+ * the real open error), -1 after reporting a violation by name.
+ */
+static int dadao_check_bios_firmware_size(const char *filename,
+                                          const DadaoProfile *prof)
+{
+    int64_t size = get_image_size(filename, NULL);
+
+    if (size < 0) {
+        return 0;
+    }
+    if (prof->bootrom_required && size != (int64_t)prof->rom_size) {
+        error_report("dadao: -bios image '%s' is %" PRId64 " bytes; the "
+                     "Kaiwu-Tiny -bios path accepts only the fixed "
+                     "%" PRIu64 "-byte BootROM firmware (the same image as "
+                     "bootrom-image, spec/Kaiwu §6)",
+                     filename, size, prof->rom_size);
+        return -1;
+    }
+    return 0;
+}
+
+static void dadao_load_bios(const char *filename, const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    ssize_t bios_size;
+
+    if (dadao_enforce_size_limits &&
+        dadao_check_image_limit(filename, "ROM", prof->bios_window_size) < 0) {
+        exit(1);
+    }
+    if (dadao_check_bios_firmware_size(filename, prof) < 0) {
+        exit(1);
+    }
+    bios_size = load_image_targphys_as(filename, prof->bios_load_base,
+                                       prof->bios_window_size,
+                                       &address_space_memory, &err);
+    if (bios_size < 0) {
+        error_report("dadao: could not load ROM image '%s': %s",
+                     filename, err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+}
+
+static void dadao_machine_init(MachineState *machine)
+{
+    DadaoMachineState *ms = dadao_machine_state(machine);
+    const DadaoProfile *prof =
+        dadao_machine_class(MACHINE_GET_CLASS(machine))->profile;
+    DadaoCPU *cpu;
+    MemoryRegion *ram, *rom;
+    MemoryRegion *system_memory;
+    const char *kernel = machine->kernel_filename;
+    const char *bootrom = ms->bootrom_image;
+
+    if (!kernel && !bootrom) {
+        error_report("dadao: -kernel test.bin is required");
+        exit(1);
+    }
+    if (bootrom && machine->firmware) {
+        error_report("dadao: bootrom-image and -bios cannot be combined");
+        exit(1);
+    }
+
+    /* Create the CPU and pin its profile before realize: reset derives PC and
+     * geometry from env->prof (spec/Kaiwu §1; QEMU-079t). */
+    cpu = DADAO_CPU(qdev_new(DADAO_CPU_TYPE_NAME("any")));
+    cpu->env.prof = prof;
+    qdev_realize_and_unref(DEVICE(cpu), NULL, &error_fatal);
+
+    system_memory = get_system_memory();
+
+    /* RAM (profile geometry): Vast 2 GiB at PA 0, Tiny 8 MiB at
+     * 0xffff_ff00_0000 (spec/Kaiwu §1.1). */
+    ram = g_new(MemoryRegion, 1);
+    memory_region_init_ram(ram, NULL, "dadao-ram", prof->ram_size,
+                           &error_fatal);
+    memory_region_add_subregion(system_memory, prof->ram_base, ram);
+
+    /* A profile whose RAM is not already at PA 0 would need an alias for the
+     * first page table (PTBR=0).  Vast and Tiny both set this false. */
+    if (prof->ram_alias) {
+        MemoryRegion *ram_alias = g_new(MemoryRegion, 1);
+
+        memory_region_init_alias(ram_alias, NULL, "dadao-ram-alias", ram, 0,
+                                 prof->ram_size);
+        memory_region_add_subregion(system_memory, DADAO_RAM_ALIAS_BASE,
+                                    ram_alias);
+    }
+
+    /* BootROM: Vast 4 MiB at 0xffff_ffc0_0000, Tiny 64 KiB at
+     * 0xffff_ffff_0000 (spec/Kaiwu §1.1/§6). */
+    rom = g_new(MemoryRegion, 1);
+    memory_region_init_rom(rom, NULL, "dadao-rom", prof->rom_size,
+                           &error_fatal);
+    memory_region_add_subregion(system_memory, prof->rom_base, rom);
+
+    /* cfx_pmem SRAM (Vast only): 64 KiB at a host address outside the
+     * 56-bit guest PA space, so a guest PA can never alias it. */
+    if (prof->pmem_sram) {
+        MemoryRegion *pmem_sram = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(pmem_sram, NULL, "dadao-pmem-sram",
+                               DADAO_PMEM_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_PMEM_SRAM_HOST_BASE,
+                                    pmem_sram);
+    }
+
+    /* hmon (cfx3) / smon (cfx2) SRAM, 64 KiB each (spec/Kaiwu §1.1:
+     * Tiny implements hmon only, Vast implements both).  Like the cfx_pmem
+     * SRAM they are backed at host addresses outside the 56-bit guest PA
+     * space; the CPU reaches them through tlb_fill and the monitor's own
+     * internal address, never through a guest PA. */
+    if (prof->hmon_sram) {
+        MemoryRegion *hmon_sram = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(hmon_sram, NULL, "dadao-hmon-sram",
+                               DADAO_MON_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_HMON_SRAM_HOST_BASE,
+                                    hmon_sram);
+        if (prof->mon_elf_segments) {
+            /* Loader-only window: the ELF loader places segments by guest
+             * address, so the hmon image needs an address-space view of the
+             * same RAM at the monitor's internal address (Tiny, R13-A).  This
+             * is the SRAM's own address, not a second alias for it. */
+            MemoryRegion *hmon_load = g_new(MemoryRegion, 1);
+
+            memory_region_init_alias(hmon_load, NULL, "dadao-hmon-load",
+                                     hmon_sram, 0, DADAO_MON_SRAM_SIZE);
+            memory_region_add_subregion(system_memory, DADAO_HMON_CFX_BASE,
+                                        hmon_load);
+        }
+    }
+    if (prof->smon_sram) {
+        MemoryRegion *smon_sram = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(smon_sram, NULL, "dadao-smon-sram",
+                               DADAO_MON_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_SMON_SRAM_HOST_BASE,
+                                    smon_sram);
+    }
+
+    /* Kaiwu-Tiny load contract (spec/Kaiwu §6/§6.2).  The contract
+     * path is the fixed 64 KiB BootROM firmware plus the application: the
+     * firmware is loaded verbatim (exactly 64 KiB) from `bootrom-image` or
+     * from `-bios` (both accept the same image), only the application's SRAM
+     * segments are loaded (never a PT_LOAD in the BootROM or hmon SRAM), the
+     * ELF entry must be the fixed 0xffff_ff01_0100, and QEMU executes the real
+     * power -> hmon -> escape -> entry chain.
+     *
+     * There is no free-form `-bios` window on Tiny any more: the legacy
+     * <= 4096-byte flat trampoline window and its raw-kernel harness path are
+     * removed (spec/Kaiwu §6).  `-bios` must be the fixed firmware,
+     * exactly 64 KiB; any other size is a load-stage error naming the rule. */
+    if (prof->bootrom_required) {
+        if (bootrom) {
+            if (!kernel) {
+                error_report("dadao: Kaiwu-Tiny requires an application "
+                             "-kernel image (fixed firmware + application)");
+                exit(1);
+            }
+            dadao_load_bootrom_image(bootrom, prof);
+            if (dadao_kernel_is_elf(kernel)) {
+                (void)dadao_load_elf_kernel(kernel, prof);
+            } else {
+                dadao_load_raw_kernel(kernel, prof);
+            }
+            return;
+        }
+        if (machine->firmware) {
+            /* The size rule comes first: a short/truncated image is rejected
+             * by name before anything is written into the BootROM window. */
+            dadao_load_bios(machine->firmware, prof);
+            if (!kernel) {
+                error_report("dadao: Kaiwu-Tiny requires an application "
+                             "-kernel image (fixed firmware + application)");
+                exit(1);
+            }
+            if (dadao_kernel_is_elf(kernel)) {
+                (void)dadao_load_elf_kernel(kernel, prof);
+            } else {
+                dadao_load_raw_kernel(kernel, prof);
+            }
+            return;
+        }
+        if (kernel) {
+            error_report("dadao: Kaiwu-Tiny application '%s' requires the "
+                         "fixed BootROM firmware (bootrom-image=... or the same "
+                         "64 KiB image through -bios); the legacy flat "
+                         "trampoline -bios window was removed", kernel);
+            exit(1);
+        }
+    }
+
+    /* Path C: BootROM image (ADR-0043 D1/D2).  -kernel is optional; a given
+     * ELF is preloaded but does not override the reset PC.
+     *
+     * Kaiwu-Vast with `bootrom-image` is the K1 boot path: the kernel is
+     * the payload smon hands over to, so §6.3.2/§6.3.3 apply (validated load
+     * at the VA's PA + host-written boot info).  Tiny returned above. */
+    if (bootrom) {
+        dadao_load_bootrom_image(bootrom, prof);
+        if (kernel) {
+            if (dadao_k0_contract(prof)) {
+                dadao_k0_load_kernel(kernel, prof);
+            } else if (dadao_kernel_is_elf(kernel)) {
+                (void)dadao_load_elf_kernel(kernel, prof);
+            } else {
+                dadao_load_raw_kernel(kernel, prof);
+            }
+        }
+        return;
+    }
+
+    /* The kernel's magic selects the loading path (ADR-0004 D2.3). */
+    if (dadao_kernel_is_elf(kernel)) {
+        /*
+         * Path A: ELF.  Header and PT_LOAD rules the upstream loader does not
+         * enforce are checked first (contract-elf.md §1.3/§5.2/§6.1.2); the
+         * allowed segment regions follow the profile.  Vast allows PA RAM
+         * only (Tiny never reaches this path: it requires the fixed BootROM
+         * firmware above and rejects BootROM/hmon PT_LOAD).  Placement and
+         * .bss zero-fill stay with the upstream loader.
+         */
+        uint64_t entry = dadao_load_elf_kernel(kernel, prof);
+
+        /* Entry: PC = e_entry (path A; rb0 reset value is the ROM base). */
+        cpu_set_pc(CPU(cpu), entry);
+        return;
+    }
+
+    /*
+     * Path B: raw-bin dual image (Vast only).  The legacy 64 KiB `-bios`
+     * reset window plus the flat test binary; the raw entry is fixed by the
+     * profile.  Tiny returned above, so this window no longer carries the
+     * deleted <= 4096-byte flat trampoline.
+     */
+    if (!machine->firmware) {
+        error_report("dadao: kernel image '%s' is not an ELF (bad magic); "
+                     "-bios rom.bin is required for the raw-bin path", kernel);
+        exit(1);
+    }
+
+    dadao_load_bios(machine->firmware, prof);
+    dadao_load_raw_kernel(kernel, prof);
+}
+
+static void dadao_machine_class_init(ObjectClass *oc, const void *data)
+{
+    const DadaoMachineDesc *desc = data;
+    MachineClass *mc = MACHINE_CLASS(oc);
+    DadaoMachineClass *dc = dadao_machine_class(mc);
+
+    dc->profile = desc->profile;
+
+    mc->init = dadao_machine_init;
+    mc->desc = desc->desc;
+    mc->default_cpus = 1;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->no_floppy = 1;
+    mc->no_cdrom = 1;
+    mc->default_cpu_type = DADAO_CPU_TYPE_NAME("any");
+
+    /* BootROM image property (ADR-0043 D1/D2): a machine property rather than
+     * a new CLI switch so every existing command line stays valid:
+     * `-machine kaiwu-vast,bootrom-image=<path>`. */
+    object_class_property_add_str(oc, "bootrom-image",
+                                  dadao_machine_get_bootrom_image,
+                                  dadao_machine_set_bootrom_image);
+    object_class_property_set_description(oc, "bootrom-image",
+        "BootROM image loaded at the profile ROM base (exact ROM size)");
+}
+
