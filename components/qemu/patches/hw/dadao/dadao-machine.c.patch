+/* ---------------------------------------------------------------------------
+ * Image loading
+ *
+ * Path selection is governed by contract-elf.md §5/§6 and ADR-0004 D2.2/D2.3.
+ * On the ELF path the segment load (every PT_LOAD, VA=PA, with the
+ * (p_memsz - p_filesz) tail zero-filled) and the entry point (e_entry) are
+ * delegated to the upstream loader in hw/core/loader.c (the standard
+ * load_elf() API) rather than re-implemented here.  The ELF header rules
+ * (e_type == ET_EXEC, e_flags version 1 / reserved bits zero) and the segment
+ * consistency/range rules (p_filesz <= p_memsz, p_vaddr == p_paddr, segment
+ * interval inside RAM -- RAM-only, a ROM-window segment is a load error; user
+ * decision D, 2026-10-09) that the upstream loader does not enforce
+ * -- contract-elf.md §1.3/§5.2/§6.1.2 -- are checked here before the load.
+ * ------------------------------------------------------------------------- */
+
+/* EM_DADAO is project-custom and not defined by QEMU's include/elf.h. */
+#define DADAO_EM_MACHINE            0x0DA0
+
+/* contract-elf.md §1.3: e_flags bits 0-7 = object/ABI format version (M1 = 1),
+ * bits 8-31 reserved and must be 0. */
+#define DADAO_EFLAGS_VERSION_MASK   0x000000FFu
+#define DADAO_EFLAGS_RESERVED_MASK  0xFFFFFF00u
+#define DADAO_EFLAGS_VERSION_1      0x00000001u
+
+/*
+ * Regions an ELF PT_LOAD interval may occupy (contract-elf.md §5/§6.1.2).
+ *
+ * Vast: an ELF loaded over -kernel is a PA RAM image (identity VA=PA) --
+ * only RAM is allowed.  A segment in the boot ROM window is a load-stage
+ * error (non-zero exit), never a ROM load.  This table is used only to
+ * validate a segment interval before the load; the placement itself is still
+ * done by the upstream loader.
+ *
+ * Machine-v5-Tiny (QEMU-079t): the crt/startup stub lives in the BootROM, so
+ * a PT_LOAD may target the BootROM as well as the SRAM (spec/Machine-v5 §6).
+ */
+typedef struct DadaoMappedRegion {
+    uint64_t base;
+    uint64_t size;
+} DadaoMappedRegion;
+
+static unsigned dadao_mapped_regions(const DadaoProfile *prof,
+                                     DadaoMappedRegion regions[2])
+{
+    unsigned n = 0;
+
+    regions[n++] = (DadaoMappedRegion){ prof->ram_base, prof->ram_size };
+    if (prof->rom_elf_segments) {
+        regions[n++] = (DadaoMappedRegion){ prof->rom_base, prof->rom_size };
+    }
+    return n;
+}
+
+static bool dadao_addr_mapped(const DadaoProfile *prof, uint64_t addr)
+{
+    DadaoMappedRegion regions[2];
+    unsigned n = dadao_mapped_regions(prof, regions);
+    unsigned r;
+
+    for (r = 0; r < n; r++) {
+        if (addr >= regions[r].base && addr < regions[r].base + regions[r].size) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Big-endian field readers (ELFDATA2MSB, contract-elf.md §1.1): the ELF is
+ * always big-endian regardless of host byte order. */
+static uint16_t dadao_rd_be16(const uint8_t *p)
+{
+    return (uint16_t)(((uint16_t)p[0] << 8) | (uint16_t)p[1]);
+}
+
+static uint32_t dadao_rd_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint64_t dadao_rd_be64(const uint8_t *p)
+{
+    return ((uint64_t)dadao_rd_be32(p) << 32) | (uint64_t)dadao_rd_be32(p + 4);
+}
+
+/*
+ * Explicit size-limit guards (ADR-0004 D2.3).  Kept behind a single switch so
+ * the evidence script can inject a "guards removed" counterexample.
+ */
+#define DADAO_ENFORCE_SIZE_LIMITS   1
+static const bool dadao_enforce_size_limits = DADAO_ENFORCE_SIZE_LIMITS;
+
+/* True if the buffer starts with the ELF magic number (contract-elf §6.1.2). */
+static bool dadao_is_elf_magic(const uint8_t *buf, gsize len)
+{
+    return len >= SELFMAG &&
+           buf[0] == ELFMAG0 && buf[1] == ELFMAG1 &&
+           buf[2] == ELFMAG2 && buf[3] == ELFMAG3;
+}
+
+/*
+ * Path selector (ADR-0004 D2.3, SPEC-107t): read only the leading magic so a
+ * large raw-bin kernel is not slurped into host memory just to classify it.
+ * Returns false when the file is unreadable or is not an ELF.
+ */
+static bool dadao_kernel_is_elf(const char *filename)
+{
+    uint8_t magic[SELFMAG];
+    ssize_t n;
+    int fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+
+    if (fd < 0) {
+        return false;
+    }
+    n = read(fd, magic, sizeof(magic));
+    close(fd);
+    return n == (ssize_t)sizeof(magic) &&
+           dadao_is_elf_magic(magic, sizeof(magic));
+}
+
+/*
+ * ELF header checks the upstream loader does not perform (contract-elf.md
+ * §1.3/§6.1.2): e_type must be ET_EXEC and e_flags must carry format version 1
+ * in bits 0-7 with reserved bits 8-31 clear.  Halts the process on a violation
+ * (load-stage error layer, ADR-0004 D2.3).  A file too short to hold
+ * Elf64_Ehdr is malformed and rejected here as well.  Fields are read
+ * big-endian (ELFDATA2MSB, §1.1); EI_DATA/EI_CLASS/e_machine are still left to
+ * the loader.
+ */
+static void dadao_elf_check_header(const char *filename)
+{
+    uint8_t hdr[sizeof(Elf64_Ehdr)];
+    uint16_t e_type;
+    uint32_t e_flags;
+    const size_t t_off = offsetof(Elf64_Ehdr, e_type);
+    const size_t f_off = offsetof(Elf64_Ehdr, e_flags);
+    ssize_t n;
+    int fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+
+    if (fd < 0) {
+        return; /* unreadable: let the loader report the real open error */
+    }
+    n = read(fd, hdr, sizeof(hdr));
+    close(fd);
+    if (n != (ssize_t)sizeof(hdr)) {
+        error_report("dadao: ELF kernel '%s' is smaller than Elf64_Ehdr",
+                     filename);
+        exit(1);
+    }
+
+    e_type = (uint16_t)((hdr[t_off] << 8) | hdr[t_off + 1]);
+    e_flags = ((uint32_t)hdr[f_off] << 24) | ((uint32_t)hdr[f_off + 1] << 16) |
+              ((uint32_t)hdr[f_off + 2] << 8) | (uint32_t)hdr[f_off + 3];
+
+    if (e_type != ET_EXEC) {
+        error_report("dadao: ELF kernel '%s' has e_type %u, expected "
+                     "ET_EXEC (%u)", filename, e_type, ET_EXEC);
+        exit(1);
+    }
+    if ((e_flags & DADAO_EFLAGS_VERSION_MASK) != DADAO_EFLAGS_VERSION_1) {
+        error_report("dadao: ELF kernel '%s' has e_flags %#x: version "
+                     "(e_flags[7:0]) %u is not 1",
+                     filename, e_flags, e_flags & DADAO_EFLAGS_VERSION_MASK);
+        exit(1);
+    }
+    if (e_flags & DADAO_EFLAGS_RESERVED_MASK) {
+        error_report("dadao: ELF kernel '%s' has e_flags %#x with reserved "
+                     "bits [31:8] set (must be 0)", filename, e_flags);
+        exit(1);
+    }
+}
+
+/*
+ * Raw-bin size guard (ADR-0004 D2.3): reject a blob larger than its region
+ * before loading, with the actual size and the limit in the message.  Returns
+ * 0 if within the limit or unreadable (the load reports the real error), -1 if
+ * oversize (message already reported).
+ */
+static int dadao_check_image_limit(const char *filename, const char *what,
+                                   uint64_t limit)
+{
+    int64_t size = get_image_size(filename, NULL);
+
+    if (size < 0) {
+        return 0;
+    }
+    if ((uint64_t)size > limit) {
+        error_report("dadao: %s image '%s' is %" PRId64 " bytes, exceeds the "
+                     "%s region size limit of %" PRIu64 " bytes",
+                     what, filename, size, what, limit);
+        return -1;
+    }
+    return 0;
+}
+
+/*
+ * PT_LOAD consistency and range checks the upstream loader does not enforce
+ * (contract-elf.md §5.2/§6.1.2, ADR-0004 D2.3): p_filesz <= p_memsz, VA == PA
+ * (p_vaddr == p_paddr), and the segment interval [p_vaddr, p_vaddr + p_memsz)
+ * fitting inside RAM with no arithmetic overflow.  An ELF loaded over -kernel
+ * is a RAM image, so a segment in the boot ROM window is a load-stage error
+ * too (user decision D, 2026-10-09).  A violation is a load-stage error
+ * (non-zero process exit), a different layer from guest faults (ADR-0004
+ * D4/D5).  The check is read-only and leaves the actual placement to the
+ * upstream loader.  A malformed file (short header, program header table out
+ * of file bounds, ...) is left to the loader, which reports it and returns an
+ * error.
+ */
+static void dadao_elf_check_segments(const char *filename,
+                                     const DadaoProfile *prof)
+{
+    uint8_t ehdr[sizeof(Elf64_Ehdr)];
+    uint8_t phdr[sizeof(Elf64_Phdr)];
+    uint64_t phoff;
+    uint16_t phentsize, phnum;
+    ssize_t n;
+    int fd;
+    unsigned i;
+
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        return; /* unreadable: let the loader report the real open error */
+    }
+    n = read(fd, ehdr, sizeof(ehdr));
+    if (n != (ssize_t)sizeof(ehdr)) {
+        close(fd);
+        return; /* too short: dadao_elf_check_header already rejected it */
+    }
+
+    phoff = dadao_rd_be64(ehdr + offsetof(Elf64_Ehdr, e_phoff));
+    phentsize = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phentsize));
+    phnum = dadao_rd_be16(ehdr + offsetof(Elf64_Ehdr, e_phnum));
+    if (phentsize != sizeof(Elf64_Phdr)) {
+        close(fd);
+        return; /* unexpected entry size: let the loader handle the file */
+    }
+
+    {
+    DadaoMappedRegion regions[2];
+    unsigned nregions = dadao_mapped_regions(prof, regions);
+
+    for (i = 0; i < phnum; i++) {
+        uint64_t off = phoff + (uint64_t)i * phentsize;
+        uint64_t p_vaddr, p_paddr, p_filesz, p_memsz, end;
+        uint32_t p_type;
+        bool mapped = false;
+        unsigned r;
+
+        if (lseek(fd, (off_t)off, SEEK_SET) != (off_t)off) {
+            break; /* malformed: let the loader report it */
+        }
+        if (read(fd, phdr, sizeof(phdr)) != (ssize_t)sizeof(phdr)) {
+            break;
+        }
+        p_type = dadao_rd_be32(phdr + offsetof(Elf64_Phdr, p_type));
+        if (p_type != PT_LOAD) {
+            continue;
+        }
+        p_vaddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_vaddr));
+        p_paddr = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_paddr));
+        p_filesz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_filesz));
+        p_memsz = dadao_rd_be64(phdr + offsetof(Elf64_Phdr, p_memsz));
+
+        /* consistency: p_filesz <= p_memsz (contract-elf.md §6.1.2) */
+        if (p_filesz > p_memsz) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u has "
+                         "p_filesz %#" PRIx64 " > p_memsz %#" PRIx64,
+                         filename, i, p_filesz, p_memsz);
+            close(fd);
+            exit(1);
+        }
+        /* An empty PT_LOAD (p_memsz == 0) places nothing: skip the range
+         * check.  The Vast link script always emits a `.rom` PT_LOAD phdr
+         * even when the section is empty (dadao-node.lds), and a rejected
+         * empty ROM segment would make every Vast ELF unloadable. */
+        if (p_memsz == 0) {
+            continue;
+        }
+        /* VA=PA (contract-elf.md §5.2): the loader places at p_paddr */
+        if (p_vaddr != p_paddr) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u has "
+                         "p_vaddr %#" PRIx64 " != p_paddr %#" PRIx64
+                         " (VA=PA required)",
+                         filename, i, p_vaddr, p_paddr);
+            close(fd);
+            exit(1);
+        }
+        /* range + overflow (contract-elf.md §6.1.2) */
+        end = p_vaddr + p_memsz;
+        if (end < p_vaddr) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                         "interval [%#" PRIx64 ", %#" PRIx64 ") overflows",
+                         filename, i, p_vaddr, end);
+            close(fd);
+            exit(1);
+        }
+        for (r = 0; r < nregions; r++) {
+            uint64_t rbase = regions[r].base;
+            uint64_t rend = rbase + regions[r].size;
+
+            if (p_vaddr >= rbase && end <= rend) {
+                mapped = true;
+                break;
+            }
+        }
+        if (!mapped) {
+            error_report("dadao: ELF kernel '%s': PT_LOAD segment %u "
+                         "interval [%#" PRIx64 ", %#" PRIx64 ") is outside the "
+                         "mapped regions (RAM %#" PRIx64 " + %" PRIu64 " bytes%s)",
+                         filename, i, p_vaddr, end, (uint64_t)prof->ram_base,
+                         (uint64_t)prof->ram_size,
+                         prof->rom_elf_segments
+                             ? " or the BootROM (Tiny crt stub)"
+                             : "; the boot ROM window is rejected");
+            close(fd);
+            exit(1);
+        }
+    }
+    }
+    close(fd);
+}
+
+/* DADAO Machine-v5 machine state.  Both registered types share it. */
+typedef struct DadaoMachineState {
+    MachineState parent_obj;
+    /* BootROM image path (ADR-0043 D1/D2); NULL => -bios / ELF paths. */
+    char *bootrom_image;
+} DadaoMachineState;
+
+/* One registered machine type (M12): the profile is fixed per type. */
+typedef struct DadaoMachineDesc {
+    const char *desc;
+    const DadaoProfile *profile;
+} DadaoMachineDesc;
+
+typedef struct DadaoMachineClass {
+    MachineClass parent_class;
+    const DadaoProfile *profile;
+} DadaoMachineClass;
+
+/* Every registered type uses this instance/class size, so the casts below are
+ * the same first-member offset QOM's container_of macros would use. */
+static inline DadaoMachineState *dadao_machine_state(MachineState *machine)
+{
+    return (DadaoMachineState *)machine;
+}
+
+static inline DadaoMachineClass *dadao_machine_class(MachineClass *mc)
+{
+    return (DadaoMachineClass *)mc;
+}
+
+static char *dadao_machine_get_bootrom_image(Object *obj, Error **errp)
+{
+    DadaoMachineState *ms = dadao_machine_state(MACHINE(obj));
+
+    return g_strdup(ms->bootrom_image);
+}
+
+static void dadao_machine_set_bootrom_image(Object *obj, const char *value,
+                                            Error **errp)
+{
+    DadaoMachineState *ms = dadao_machine_state(MACHINE(obj));
+
+    g_free(ms->bootrom_image);
+    ms->bootrom_image = g_strdup(value);
+}
+
+/*
+ * Raw -kernel reserved prefix (spec/Machine-v5 §6): Tiny's raw image starts at
+ * kernel_base and the first kernel_reserved bytes are reserved and must be
+ * zero; the application entry is base+reserved.  Returns 0 when within the
+ * rule (or the file is unreadable -- the loader reports that), -1 after
+ * reporting a violation.
+ */
+static int dadao_check_raw_prefix(const char *filename, uint64_t reserved)
+{
+    uint8_t *buf;
+    ssize_t n;
+    int fd;
+    uint64_t i;
+
+    if (reserved == 0) {
+        return 0;
+    }
+    if (reserved > SIZE_MAX) {
+        error_report("dadao: raw kernel reserved prefix is too large "
+                     "(%" PRIu64 " bytes)", reserved);
+        return -1;
+    }
+    fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+    if (fd < 0) {
+        return 0;
+    }
+    buf = g_malloc(reserved);
+    n = read(fd, buf, reserved);
+    close(fd);
+    if (n < 0) {
+        g_free(buf);
+        return 0;
+    }
+    if ((uint64_t)n < reserved) {
+        error_report("dadao: raw kernel '%s' is %" PRId64 " bytes, smaller "
+                     "than the reserved prefix of %" PRIu64 " bytes",
+                     filename, (int64_t)n, reserved);
+        g_free(buf);
+        return -1;
+    }
+    for (i = 0; i < reserved; i++) {
+        if (buf[i] != 0) {
+            error_report("dadao: raw kernel '%s': reserved prefix byte %"
+                         PRIu64 " is %#x, the first %" PRIu64 " bytes must be "
+                         "zero", filename, i, buf[i], reserved);
+            g_free(buf);
+            return -1;
+        }
+    }
+    g_free(buf);
+    return 0;
+}
+
+static void dadao_load_raw_kernel(const char *filename,
+                                  const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    uint64_t limit = prof->ram_size - prof->kernel_reserved;
+    ssize_t kernel_size;
+
+    if (dadao_enforce_size_limits &&
+        dadao_check_image_limit(filename, "RAM", limit) < 0) {
+        exit(1);
+    }
+    if (dadao_check_raw_prefix(filename, prof->kernel_reserved) < 0) {
+        exit(1);
+    }
+    kernel_size = load_image_targphys_as(filename, prof->kernel_base, limit,
+                                         &address_space_memory, &err);
+    if (kernel_size < 0) {
+        error_report("dadao: could not load kernel image '%s': %s",
+                     filename, err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+}
+
+/* Load an ELF -kernel and return its e_entry (validated to be mapped). */
+static uint64_t dadao_load_elf_kernel(const char *filename,
+                                      const DadaoProfile *prof)
+{
+    uint64_t entry = 0;
+    ssize_t elf_size;
+
+    dadao_elf_check_header(filename);
+    dadao_elf_check_segments(filename, prof);
+    elf_size = load_elf(filename, NULL, NULL, NULL, &entry, NULL,
+                        NULL, NULL, ELFDATA2MSB, DADAO_EM_MACHINE, 0, 0);
+    if (elf_size < 0) {
+        error_report("dadao: could not load ELF kernel '%s': %s",
+                     filename, load_elf_strerror(elf_size));
+        exit(1);
+    }
+    if (!dadao_addr_mapped(prof, entry)) {
+        error_report("dadao: ELF kernel '%s': e_entry %#" PRIx64 " is "
+                     "outside the mapped regions", filename, entry);
+        exit(1);
+    }
+    return entry;
+}
+
+static void dadao_load_bootrom_image(const char *filename,
+                                     const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    ssize_t bios_size;
+
+    bios_size = load_image_targphys_as(filename, prof->rom_base, prof->rom_size,
+                                       &address_space_memory, &err);
+    if (bios_size != (ssize_t)prof->rom_size) {
+        error_report("dadao: bootrom-image '%s' is %" PRId64 " bytes, "
+                     "expected exactly %" PRIu64 " bytes",
+                     filename, (int64_t)bios_size, prof->rom_size);
+        exit(1);
+    }
+}
+
+static void dadao_load_bios(const char *filename, const DadaoProfile *prof)
+{
+    Error *err = NULL;
+    ssize_t bios_size;
+
+    if (dadao_enforce_size_limits &&
+        dadao_check_image_limit(filename, "ROM", prof->bios_window_size) < 0) {
+        exit(1);
+    }
+    bios_size = load_image_targphys_as(filename, prof->bios_load_base,
+                                       prof->bios_window_size,
+                                       &address_space_memory, &err);
+    if (bios_size < 0) {
+        error_report("dadao: could not load ROM image '%s': %s",
+                     filename, err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+}
+
+static void dadao_machine_init(MachineState *machine)
+{
+    DadaoMachineState *ms = dadao_machine_state(machine);
+    const DadaoProfile *prof =
+        dadao_machine_class(MACHINE_GET_CLASS(machine))->profile;
+    DadaoCPU *cpu;
+    MemoryRegion *ram, *rom;
+    MemoryRegion *system_memory;
+    const char *kernel = machine->kernel_filename;
+    const char *bootrom = ms->bootrom_image;
+
+    if (!kernel && !bootrom) {
+        error_report("dadao: -kernel test.bin is required");
+        exit(1);
+    }
+    if (bootrom && machine->firmware) {
+        error_report("dadao: bootrom-image and -bios cannot be combined");
+        exit(1);
+    }
+
+    /* Create the CPU and pin its profile before realize: reset derives PC and
+     * geometry from env->prof (spec/Machine-v5 §1; QEMU-079t). */
+    cpu = DADAO_CPU(qdev_new(DADAO_CPU_TYPE_NAME("any")));
+    cpu->env.prof = prof;
+    qdev_realize_and_unref(DEVICE(cpu), NULL, &error_fatal);
+
+    system_memory = get_system_memory();
+
+    /* RAM (profile geometry): Vast 2 GiB at PA 0, Tiny 8 MiB at
+     * 0xffff_ff00_0000 (spec/Machine-v5 §1.1). */
+    ram = g_new(MemoryRegion, 1);
+    memory_region_init_ram(ram, NULL, "dadao-ram", prof->ram_size,
+                           &error_fatal);
+    memory_region_add_subregion(system_memory, prof->ram_base, ram);
+
+    /* A profile whose RAM is not already at PA 0 would need an alias for the
+     * first page table (PTBR=0).  Vast and Tiny both set this false. */
+    if (prof->ram_alias) {
+        MemoryRegion *ram_alias = g_new(MemoryRegion, 1);
+
+        memory_region_init_alias(ram_alias, NULL, "dadao-ram-alias", ram, 0,
+                                 prof->ram_size);
+        memory_region_add_subregion(system_memory, DADAO_RAM_ALIAS_BASE,
+                                    ram_alias);
+    }
+
+    /* BootROM: Vast 4 MiB at 0xffff_ffc0_0000, Tiny 64 KiB at
+     * 0xffff_ffff_0000 (spec/Machine-v5 §1.1/§6). */
+    rom = g_new(MemoryRegion, 1);
+    memory_region_init_rom(rom, NULL, "dadao-rom", prof->rom_size,
+                           &error_fatal);
+    memory_region_add_subregion(system_memory, prof->rom_base, rom);
+
+    /* cfx_pmem SRAM (Vast only): 64 KiB at a host address outside the
+     * 56-bit guest PA space, so a guest PA can never alias it. */
+    if (prof->pmem_sram) {
+        MemoryRegion *pmem_sram = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(pmem_sram, NULL, "dadao-pmem-sram",
+                               DADAO_PMEM_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_PMEM_SRAM_HOST_BASE,
+                                    pmem_sram);
+    }
+
+    /* hmon (cfx3) / smon (cfx2) SRAM (Vast only), 64 KiB each. */
+    if (prof->mon_sram) {
+        MemoryRegion *hmon_sram = g_new(MemoryRegion, 1);
+        MemoryRegion *smon_sram = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(hmon_sram, NULL, "dadao-hmon-sram",
+                               DADAO_MON_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_HMON_SRAM_HOST_BASE,
+                                    hmon_sram);
+        memory_region_init_ram(smon_sram, NULL, "dadao-smon-sram",
+                               DADAO_MON_SRAM_SIZE, &error_fatal);
+        memory_region_add_subregion(system_memory, DADAO_SMON_SRAM_HOST_BASE,
+                                    smon_sram);
+    }
+
+    /* Path C: BootROM image (ADR-0043 D1/D2).  -kernel is optional; a given
+     * ELF is preloaded but does not override the reset PC. */
+    if (bootrom) {
+        dadao_load_bootrom_image(bootrom, prof);
+        if (kernel) {
+            if (dadao_kernel_is_elf(kernel)) {
+                (void)dadao_load_elf_kernel(kernel, prof);
+            } else {
+                dadao_load_raw_kernel(kernel, prof);
+            }
+        }
+        return;
+    }
+
+    /* The kernel's magic selects the loading path (ADR-0004 D2.3). */
+    if (dadao_kernel_is_elf(kernel)) {
+        /*
+         * Path A: ELF.  Header and PT_LOAD rules the upstream loader does not
+         * enforce are checked first (contract-elf.md §1.3/§5.2/§6.1.2); the
+         * allowed segment regions follow the profile (Vast: PA RAM only; Tiny:
+         * RAM + BootROM, the crt stub lives in ROM).  Placement and .bss
+         * zero-fill stay with the upstream loader.
+         */
+        uint64_t entry = dadao_load_elf_kernel(kernel, prof);
+
+        /* Entry: PC = e_entry (path A; rb0 reset value is the ROM base). */
+        cpu_set_pc(CPU(cpu), entry);
+        return;
+    }
+
+    /*
+     * Path B: raw-bin dual image.  Both a ROM trampoline (-bios) and the flat
+     * test binary (-kernel) are required; the raw entry is fixed by the
+     * profile (Tiny: kernel_base + 0x100) and reached by the trampoline.
+     */
+    if (!machine->firmware) {
+        error_report("dadao: kernel image '%s' is not an ELF (bad magic); "
+                     "-bios rom.bin is required for the raw-bin path", kernel);
+        exit(1);
+    }
+
+    dadao_load_bios(machine->firmware, prof);
+    dadao_load_raw_kernel(kernel, prof);
+}
+
+static void dadao_machine_class_init(ObjectClass *oc, const void *data)
+{
+    const DadaoMachineDesc *desc = data;
+    MachineClass *mc = MACHINE_CLASS(oc);
+    DadaoMachineClass *dc = dadao_machine_class(mc);
+
+    dc->profile = desc->profile;
+
+    mc->init = dadao_machine_init;
+    mc->desc = desc->desc;
+    mc->default_cpus = 1;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->no_floppy = 1;
+    mc->no_cdrom = 1;
+    mc->default_cpu_type = DADAO_CPU_TYPE_NAME("any");
+
+    /* BootROM image property (ADR-0043 D1/D2): a machine property rather than
+     * a new CLI switch so every existing command line stays valid:
+     * `-machine dadao-vast,bootrom-image=<path>`. */
+    object_class_property_add_str(oc, "bootrom-image",
+                                  dadao_machine_get_bootrom_image,
+                                  dadao_machine_set_bootrom_image);
+    object_class_property_set_description(oc, "bootrom-image",
+        "BootROM image loaded at the profile ROM base (exact ROM size)");
+}
+
+/*
+ * Registered machine types (M12; spec/Machine-v5 §1).
+ */
+static const DadaoMachineDesc dadao_tiny_machine = {
+    .desc = "DADAO Machine-v5-Tiny bare-metal test machine "
+            "(64 KiB BootROM + 8 MiB SRAM; no cfx/PTW)",
+    .profile = &dadao_profile_tiny,
+};
+
+static const DadaoMachineDesc dadao_vast_machine = {
+    .desc = "DADAO Machine-v5-Vast bare-metal test machine "
+            "(4 MiB BootROM + 2 GiB PA RAM; full cfx/PTW)",
+    .profile = &dadao_profile_vast,
+};
+
+#define DADAO_MACHINE_TYPE_INFO(_name, _desc)                                \
+    {                                                                        \
+        .name = MACHINE_TYPE_NAME(_name),                                    \
+        .parent = TYPE_MACHINE,                                              \
+        .instance_size = sizeof(DadaoMachineState),                          \
+        .class_size = sizeof(DadaoMachineClass),                             \
+        .class_init = dadao_machine_class_init,                              \
+        .class_data = &(_desc),                                              \
+    }
+
+static const TypeInfo dadao_machine_types[] = {
+    DADAO_MACHINE_TYPE_INFO("dadao-tiny", dadao_tiny_machine),
+    DADAO_MACHINE_TYPE_INFO("dadao-vast", dadao_vast_machine),
+};
