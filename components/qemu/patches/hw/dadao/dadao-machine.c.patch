+/* Exit port MMIO handler */
+typedef struct DadaoExitPort {
+    SysBusDevice parent_obj;
+    MemoryRegion mr;
+} DadaoExitPort;
+
+#define TYPE_DADAO_EXIT_PORT "dadao-exit-port"
+OBJECT_DECLARE_SIMPLE_TYPE(DadaoExitPort, DADAO_EXIT_PORT)
+
+static uint64_t dadao_exit_port_read(void *opaque, hwaddr addr, unsigned size)
+{
+    /* Exit port is write-only; reads trigger ILLI */
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
+                                           DADAO_EXIT_ILLI);
+    return 0;
+}
+
+static void dadao_exit_port_write(void *opaque, hwaddr addr,
+                                  uint64_t data, unsigned size)
+{
+    /*
+     * Per ADR-0004 D3:
+     * - Only 8-byte (octa) writes are valid exit port accesses
+     * - Write value & 0xFF = exit code propagated to host $?
+     * - Non-8B writes trigger ILLI (0x88)
+     *
+     * .impl.max_access_size = 8 prevents TCG from splitting 64-bit MMIO
+     * writes into two 32-bit writes. Without this, a guest st.o would be
+     * split into two 4-byte writes, neither of which is a valid exit.
+     */
+    if (size != 8) {
+        qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
+                                               DADAO_EXIT_ILLI);
+        cpu_loop_exit(current_cpu);
+        return;
+    }
+
+    int exit_code = (int)(data & 0xFF);
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_SHUTDOWN,
+                                           exit_code);
+    /* Per ADR-0011 D1: cpu_loop_exit longjmps back to cpu_exec's setjmp
+     * point, guaranteeing no further guest instructions execute after the
+     * exit port write. This prevents subsequent instructions (e.g., FAIL
+     * stores, UNDI terminators) from overriding the locked exit code. */
+    cpu_loop_exit(current_cpu);
+}
+
+static const MemoryRegionOps dadao_exit_port_ops = {
+    .read = dadao_exit_port_read,
+    .write = dadao_exit_port_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 8,
+    .impl.max_access_size = 8,
+};
+
+static void dadao_exit_port_init(Object *obj)
+{
+    DadaoExitPort *s = DADAO_EXIT_PORT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mr, obj, &dadao_exit_port_ops, s,
+                          "dadao-exit-port", DADAO_EXIT_PORT_SIZE);
+    sysbus_init_mmio(sbd, &s->mr);
+}
+
+static const TypeInfo dadao_exit_port_info = {
+    .name = TYPE_DADAO_EXIT_PORT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(DadaoExitPort),
+    .instance_init = dadao_exit_port_init,
+};
+
+/* ---------------------------------------------------------------------------
+ * Image loading
+ *
+ * Path selection and validation are governed by contract-elf.md §5/§6 and
+ * ADR-0004 D2.2/D2.3.  The ELF image is big-endian (ELFDATA2MSB); all header
+ * fields are read with explicit big-endian accessors so the loader does not
+ * depend on the host byte order or on C struct padding.
+ * ------------------------------------------------------------------------- */
+
+/* EM_DADAO is project-custom and not defined by QEMU's include/elf.h. */
+#define DADAO_EM_MACHINE            0x0DA0
+/* e_flags: bits[7:0] = object/ABI format version (M1 = 1); bits[31:8] = 0. */
+#define DADAO_ELF_FLAGS_VERSION     0x00000001u
+
+/* Elf64_Ehdr field offsets (ELFCLASS64). */
+#define DADAO_EHDR_E_TYPE_OFF       16
+#define DADAO_EHDR_E_MACHINE_OFF    18
+#define DADAO_EHDR_E_ENTRY_OFF      24
+#define DADAO_EHDR_E_PHOFF_OFF      32
+#define DADAO_EHDR_E_FLAGS_OFF      48
+#define DADAO_EHDR_E_PHENTSIZE_OFF  54
+#define DADAO_EHDR_E_PHNUM_OFF      56
+
+/* Elf64_Phdr field offsets. */
+#define DADAO_PHDR_P_TYPE_OFF       0
+#define DADAO_PHDR_P_OFFSET_OFF     8
+#define DADAO_PHDR_P_VADDR_OFF      16
+#define DADAO_PHDR_P_FILESZ_OFF     32
+#define DADAO_PHDR_P_MEMSZ_OFF      40
+
+/*
+ * Explicit size-limit guards (ADR-0004 D2.3).  Kept behind a single switch so
+ * the evidence script can inject a "guards removed" counterexample.
+ */
+#define DADAO_ENFORCE_SIZE_LIMITS   1
+static const bool dadao_enforce_size_limits = DADAO_ENFORCE_SIZE_LIMITS;
+
+typedef struct DadaoLoadRegion {
+    const char *name;
+    uint64_t base;
+    uint64_t size;
+} DadaoLoadRegion;
+
+static const DadaoLoadRegion dadao_load_regions[] = {
+    { "RAM", DADAO_RAM_BASE, DADAO_RAM_SIZE },
+    { "ROM", DADAO_ROM_BASE, DADAO_ROM_SIZE },
+};
+
+static uint16_t dadao_elf_rd16(const uint8_t *p)
+{
+    return ((uint16_t)p[0] << 8) | (uint16_t)p[1];
+}
+
+static uint32_t dadao_elf_rd32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+static uint64_t dadao_elf_rd64(const uint8_t *p)
+{
+    return ((uint64_t)dadao_elf_rd32(p) << 32) |
+           (uint64_t)dadao_elf_rd32(p + 4);
+}
+
+/* True if [vaddr, vaddr + memsz) lies entirely inside the region. */
+static bool dadao_region_contains(const DadaoLoadRegion *r,
+                                  uint64_t vaddr, uint64_t memsz)
+{
+    if (vaddr < r->base) {
+        return false;
+    }
+    if (vaddr - r->base > r->size) {
+        return false;
+    }
+    return memsz <= r->size - (vaddr - r->base);
+}
+
+/* Zero-fill [addr, addr + len), including ROM (write_rom bypasses RO). */
+static MemTxResult dadao_fill_zero(uint64_t addr, uint64_t len)
+{
+    static const uint8_t zeros[512];
+    MemTxResult res = MEMTX_OK;
+
+    while (len > 0) {
+        uint64_t chunk = MIN(len, (uint64_t)sizeof(zeros));
+
+        res |= address_space_write_rom(&address_space_memory, addr,
+                                       MEMTXATTRS_UNSPECIFIED, zeros, chunk);
+        addr += chunk;
+        len -= chunk;
+    }
+    return res;
+}
+
+/* True if the buffer starts with the ELF magic number (contract-elf §6.1.2). */
+static bool dadao_is_elf_magic(const uint8_t *buf, gsize len)
+{
+    return len >= SELFMAG &&
+           buf[0] == ELFMAG0 && buf[1] == ELFMAG1 &&
+           buf[2] == ELFMAG2 && buf[3] == ELFMAG3;
+}
+
+/*
+ * Path selector (ADR-0004 D2.3, SPEC-107t): read only the leading magic so a
+ * large raw-bin kernel is not slurped into host memory just to classify it.
+ * Returns false when the file is unreadable or is not an ELF.
+ */
+static bool dadao_kernel_is_elf(const char *filename)
+{
+    uint8_t magic[SELFMAG];
+    ssize_t n;
+    int fd = qemu_open(filename, O_RDONLY | O_BINARY, NULL);
+
+    if (fd < 0) {
+        return false;
+    }
+    n = read(fd, magic, sizeof(magic));
+    close(fd);
+    return n == (ssize_t)sizeof(magic) &&
+           dadao_is_elf_magic(magic, sizeof(magic));
+}
+
+/*
+ * ELF path (ADR-0004 D2.2/D2.3 path A; contract-elf §5/§6): parse the
+ * big-endian Elf64 header/program headers, load every PT_LOAD segment VA=PA
+ * (p_filesz bytes from file + (p_memsz - p_filesz) zero fill), then set
+ * PC = e_entry.  Any malformed field or out-of-range segment is a load error.
+ * Returns 0 on success, -1 on failure (message already reported).
+ */
+static int dadao_load_elf(DadaoCPU *cpu, const char *filename,
+                          const uint8_t *buf, gsize len)
+{
+    uint16_t e_type, e_machine, e_phentsize, e_phnum, i;
+    uint32_t e_flags;
+    uint64_t e_entry, e_phoff;
+    unsigned r;
+
+    if (len < sizeof(Elf64_Ehdr)) {
+        error_report("dadao-m1: malformed ELF '%s': file is %" G_GSIZE_FORMAT
+                     " bytes, smaller than Elf64_Ehdr (%zu bytes)",
+                     filename, len, sizeof(Elf64_Ehdr));
+        return -1;
+    }
+
+    if (buf[EI_CLASS] != ELFCLASS64) {
+        error_report("dadao-m1: malformed ELF '%s': EI_CLASS=%u, expected "
+                     "ELFCLASS64 (%u)", filename, buf[EI_CLASS], ELFCLASS64);
+        return -1;
+    }
+    if (buf[EI_DATA] != ELFDATA2MSB) {
+        error_report("dadao-m1: malformed ELF '%s': EI_DATA=%u, expected "
+                     "ELFDATA2MSB (%u)", filename, buf[EI_DATA], ELFDATA2MSB);
+        return -1;
+    }
+
+    e_type = dadao_elf_rd16(buf + DADAO_EHDR_E_TYPE_OFF);
+    if (e_type != ET_EXEC) {
+        error_report("dadao-m1: malformed ELF '%s': e_type=0x%04x, expected "
+                     "ET_EXEC (0x%04x)", filename, e_type, ET_EXEC);
+        return -1;
+    }
+
+    e_machine = dadao_elf_rd16(buf + DADAO_EHDR_E_MACHINE_OFF);
+    if (e_machine != DADAO_EM_MACHINE) {
+        error_report("dadao-m1: malformed ELF '%s': e_machine=0x%04x, expected "
+                     "EM_DADAO (0x%04x)", filename, e_machine, DADAO_EM_MACHINE);
+        return -1;
+    }
+
+    e_flags = dadao_elf_rd32(buf + DADAO_EHDR_E_FLAGS_OFF);
+    if ((e_flags & 0xFF) != (DADAO_ELF_FLAGS_VERSION & 0xFF)) {
+        error_report("dadao-m1: malformed ELF '%s': e_flags version=%u, "
+                     "expected 1", filename, e_flags & 0xFF);
+        return -1;
+    }
+    if ((e_flags & ~0xFFu) != 0) {
+        error_report("dadao-m1: malformed ELF '%s': e_flags=0x%08x has reserved "
+                     "bits [31:8] set", filename, e_flags);
+        return -1;
+    }
+
+    e_entry = dadao_elf_rd64(buf + DADAO_EHDR_E_ENTRY_OFF);
+    e_phoff = dadao_elf_rd64(buf + DADAO_EHDR_E_PHOFF_OFF);
+    e_phentsize = dadao_elf_rd16(buf + DADAO_EHDR_E_PHENTSIZE_OFF);
+    e_phnum = dadao_elf_rd16(buf + DADAO_EHDR_E_PHNUM_OFF);
+
+    if (e_phnum == 0) {
+        error_report("dadao-m1: malformed ELF '%s': no program headers "
+                     "(e_phnum=0)", filename);
+        return -1;
+    }
+    if (e_phentsize != sizeof(Elf64_Phdr)) {
+        error_report("dadao-m1: malformed ELF '%s': e_phentsize=%u, expected "
+                     "sizeof(Elf64_Phdr)=%zu", filename, e_phentsize,
+                     sizeof(Elf64_Phdr));
+        return -1;
+    }
+    if (e_phoff > len || (uint64_t)e_phnum > (len - e_phoff) / e_phentsize) {
+        error_report("dadao-m1: malformed ELF '%s': program header table out of "
+                     "file bounds (e_phoff=0x%" PRIx64 ", e_phnum=%u, "
+                     "e_phentsize=%u, file size=0x%" G_GSIZE_FORMAT ")",
+                     filename, e_phoff, e_phnum, e_phentsize, len);
+        return -1;
+    }
+
+    for (i = 0; i < e_phnum; i++) {
+        const uint8_t *ph = buf + e_phoff + (uint64_t)i * e_phentsize;
+        const DadaoLoadRegion *region = NULL;
+        uint64_t p_offset, p_vaddr, p_filesz, p_memsz;
+        uint32_t p_type = dadao_elf_rd32(ph + DADAO_PHDR_P_TYPE_OFF);
+
+        if (p_type != PT_LOAD) {
+            continue;
+        }
+
+        p_offset = dadao_elf_rd64(ph + DADAO_PHDR_P_OFFSET_OFF);
+        p_vaddr  = dadao_elf_rd64(ph + DADAO_PHDR_P_VADDR_OFF);
+        p_filesz = dadao_elf_rd64(ph + DADAO_PHDR_P_FILESZ_OFF);
+        p_memsz  = dadao_elf_rd64(ph + DADAO_PHDR_P_MEMSZ_OFF);
+
+        if (p_filesz > p_memsz) {
+            error_report("dadao-m1: malformed ELF '%s': PT_LOAD[%u] p_filesz "
+                         "(0x%" PRIx64 ") > p_memsz (0x%" PRIx64 ")",
+                         filename, i, p_filesz, p_memsz);
+            return -1;
+        }
+        if (p_filesz > 0 &&
+            (p_offset > len || p_filesz > len - p_offset)) {
+            error_report("dadao-m1: malformed ELF '%s': PT_LOAD[%u] file range "
+                         "[0x%" PRIx64 ", +0x%" PRIx64 ") exceeds file size "
+                         "0x%" G_GSIZE_FORMAT,
+                         filename, i, p_offset, p_filesz, len);
+            return -1;
+        }
+        if (p_memsz == 0) {
+            continue;
+        }
+
+        for (r = 0; r < ARRAY_SIZE(dadao_load_regions); r++) {
+            if (dadao_region_contains(&dadao_load_regions[r], p_vaddr, p_memsz)) {
+                region = &dadao_load_regions[r];
+                break;
+            }
+        }
+        if (!region) {
+            error_report("dadao-m1: ELF segment out of range '%s': PT_LOAD[%u] "
+                         "load interval [0x%016" PRIx64 ", +0x%016" PRIx64 ") is "
+                         "outside the mapped regions (RAM 0x%016" PRIx64
+                         " size 0x%" PRIx64 ", ROM 0x%016" PRIx64
+                         " size 0x%" PRIx64 ")",
+                         filename, i, p_vaddr, p_memsz,
+                         (uint64_t)DADAO_RAM_BASE, (uint64_t)DADAO_RAM_SIZE,
+                         (uint64_t)DADAO_ROM_BASE, (uint64_t)DADAO_ROM_SIZE);
+            return -1;
+        }
+
+        if (p_filesz > 0) {
+            MemTxResult res =
+                address_space_write_rom(&address_space_memory, p_vaddr,
+                                        MEMTXATTRS_UNSPECIFIED,
+                                        buf + p_offset, p_filesz);
+            if (res != MEMTX_OK) {
+                error_report("dadao-m1: ELF segment load failed '%s': PT_LOAD[%u] "
+                             "data write at 0x%016" PRIx64 " (0x%" PRIx64
+                             " bytes) into %s failed",
+                             filename, i, p_vaddr, p_filesz, region->name);
+                return -1;
+            }
+        }
+        if (p_memsz > p_filesz) {
+            MemTxResult res =
+                dadao_fill_zero(p_vaddr + p_filesz, p_memsz - p_filesz);
+            if (res != MEMTX_OK) {
+                error_report("dadao-m1: ELF segment load failed '%s': PT_LOAD[%u] "
+                             ".bss zero-fill at 0x%016" PRIx64 " (0x%" PRIx64
+                             " bytes) into %s failed",
+                             filename, i, p_vaddr + p_filesz,
+                             p_memsz - p_filesz, region->name);
+                return -1;
+            }
+        }
+    }
+
+    /* Entry: PC = e_entry (path A; rb0 reset value is the ROM base). */
+    cpu_set_pc(CPU(cpu), e_entry);
+    return 0;
+}
+
+/*
+ * Raw-bin size guard (ADR-0004 D2.3): reject a blob larger than its region
+ * before loading, with the actual size and the limit in the message.  Returns
+ * 0 if within the limit or unreadable (the load reports the real error), -1 if
+ * oversize (message already reported).
+ */
+static int dadao_check_image_limit(const char *filename, const char *what,
+                                   uint64_t limit)
+{
+    int64_t size = get_image_size(filename, NULL);
+
+    if (size < 0) {
+        return 0;
+    }
+    if ((uint64_t)size > limit) {
+        error_report("dadao-m1: %s image '%s' is %" PRId64 " bytes, exceeds the "
+                     "%s region size limit of %" PRIu64 " bytes",
+                     what, filename, size, what, limit);
+        return -1;
+    }
+    return 0;
+}
+
+/* DADAO M1 machine */
+typedef struct DadaoMachineState {
+    MachineState parent_obj;
+} DadaoMachineState;
+
+typedef struct DadaoMachineClass {
+    MachineClass parent_class;
+} DadaoMachineClass;
+
+#define TYPE_DADAO_M1_MACHINE MACHINE_TYPE_NAME("dadao-m1")
+OBJECT_DECLARE_SIMPLE_TYPE(DadaoMachineState, DADAO_M1_MACHINE)
+
+static void dadao_m1_init(MachineState *machine)
+{
+    DadaoCPU *cpu;
+    MemoryRegion *ram, *rom, *system_memory;
+    DadaoExitPort *exit_port;
+    Error *err = NULL;
+    ssize_t bios_size, kernel_size;
+    const char *kernel = machine->kernel_filename;
+
+    if (!kernel) {
+        error_report("dadao-m1: -kernel test.bin is required");
+        exit(1);
+    }
+
+    /* Create CPU */
+    cpu = DADAO_CPU(qdev_new(DADAO_CPU_TYPE_NAME("any")));
+    qdev_realize_and_unref(DEVICE(cpu), NULL, &error_fatal);
+
+    system_memory = get_system_memory();
+
+    /* RAM: 0xffff_0000_0000, 16 MiB */
+    ram = g_new(MemoryRegion, 1);
+    memory_region_init_ram(ram, NULL, "dadao-ram", DADAO_RAM_SIZE, &error_fatal);
+    memory_region_add_subregion(system_memory, DADAO_RAM_BASE, ram);
+
+    /* Boot ROM: 0xffff_ffff_0000, 64 KiB */
+    rom = g_new(MemoryRegion, 1);
+    memory_region_init_rom(rom, NULL, "dadao-rom", DADAO_ROM_SIZE, &error_fatal);
+    memory_region_add_subregion(system_memory, DADAO_ROM_BASE, rom);
+
+    /* Exit port: 0xffff_8000_0000, 8 B */
+    exit_port = DADAO_EXIT_PORT(qdev_new(TYPE_DADAO_EXIT_PORT));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(exit_port), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(exit_port), 0, DADAO_EXIT_PORT_BASE);
+
+    /* The kernel's magic selects the loading path (ADR-0004 D2.3). */
+    if (dadao_kernel_is_elf(kernel)) {
+        /*
+         * Path A: ELF.  No external -bios ROM; segments are placed by their
+         * p_vaddr and PC is taken from e_entry (ADR-0004 D2.2/D2.3).
+         */
+        g_autofree gchar *kernel_data = NULL;
+        gsize kernel_len = 0;
+        GError *gerr = NULL;
+
+        if (!g_file_get_contents(kernel, &kernel_data, &kernel_len, &gerr)) {
+            error_report("dadao-m1: could not read kernel image '%s': %s",
+                         kernel, gerr->message);
+            g_error_free(gerr);
+            exit(1);
+        }
+        if (dadao_load_elf(cpu, kernel, (const uint8_t *)kernel_data,
+                           kernel_len) < 0) {
+            exit(1);
+        }
+        return;
+    }
+
+    /*
+     * Path B: raw-bin dual image (M1-M3).  Both a ROM trampoline (-bios) and
+     * the flat test binary (-kernel) are required; entry is the RAM base.
+     */
+    if (!machine->firmware) {
+        error_report("dadao-m1: kernel image '%s' is not an ELF (bad magic); "
+                     "-bios rom.bin is required for the raw-bin path", kernel);
+        exit(1);
+    }
+
+    if (dadao_enforce_size_limits) {
+        if (dadao_check_image_limit(machine->firmware, "ROM",
+                                    DADAO_ROM_SIZE) < 0) {
+            exit(1);
+        }
+        if (dadao_check_image_limit(kernel, "RAM", DADAO_RAM_SIZE) < 0) {
+            exit(1);
+        }
+    }
+
+    /* Load BIOS (ROM trampoline) into ROM region */
+    bios_size = load_image_targphys_as(machine->firmware,
+                                       DADAO_ROM_BASE,
+                                       DADAO_ROM_SIZE,
+                                       &address_space_memory,
+                                       &err);
+    if (bios_size < 0) {
+        error_report("dadao-m1: could not load ROM image '%s': %s",
+                     machine->firmware,
+                     err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+
+    /* Load kernel (test binary) into RAM region */
+    err = NULL;
+    kernel_size = load_image_targphys_as(kernel,
+                                         DADAO_RAM_BASE,
+                                         DADAO_RAM_SIZE,
+                                         &address_space_memory,
+                                         &err);
+    if (kernel_size < 0) {
+        error_report("dadao-m1: could not load kernel image '%s': %s",
+                     kernel,
+                     err ? error_get_pretty(err) : "unknown error");
+        exit(1);
+    }
+}
+
+static void dadao_m1_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->init = dadao_m1_init;
+    mc->desc = "DADAO M1 bare-metal test machine";
+    mc->default_cpus = 1;
+    mc->min_cpus = 1;
+    mc->max_cpus = 1;
+    mc->no_floppy = 1;
+    mc->no_cdrom = 1;
+    mc->default_cpu_type = DADAO_CPU_TYPE_NAME("any");
+}
+
+static const TypeInfo dadao_m1_type = {
+    .name = TYPE_DADAO_M1_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_size = sizeof(DadaoMachineState),
+    .class_size = sizeof(DadaoMachineClass),
+    .class_init = dadao_m1_class_init,
+};
+
+static void dadao_m1_machine_init(void)
+{
+    type_register_static(&dadao_exit_port_info);
+    type_register_static(&dadao_m1_type);
+}
+
+type_init(dadao_m1_machine_init);
