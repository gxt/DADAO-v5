 {
     gen_helper_raise_exception(tcg_env, tcg_constant_i32(DADAO_EXCP_UNDI));
@@ -285,45 +319,98 @@ static void gen_div_with_checks(DisasContext *ctx,
 
 /* ── DADAO decodetree trans_* implementations ────────────────────────── */
 
+/* ── §4.1 RD Load/Store helpers ──────────────────────────────────────── */
+
+/* Load rb[n] into a TCG temp. rb0 = PC, computed at translation time. */
+static TCGv_i64 load_rb(DisasContext *ctx, int n)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    if (n == 0) {
+        /* rb0 = PC = current instruction address.
+         * ctx->base.pc_next is the address of the instruction being translated
+         * (set before decode, incremented after). */
+        tcg_gen_movi_i64(t, ctx->base.pc_next);
+    } else {
+        tcg_gen_ld_i64(t, tcg_env, offsetof(CPUDADAOState, rb[n]));
+    }
+    return t;
+}
+
+/* Compute effective address: EA = (rbhb + sext12(imms12)) & 0x0000FFFFFFFFFFFF
+ * For rrii format: imms12 = hc[5:0] (high) | hd[5:0] (low), signed. */
+static TCGv_i64 gen_ea_rrii(DisasContext *ctx, int rbhb, int hc, int hd)
+{
+    TCGv_i64 base = load_rb(ctx, rbhb);
+    int32_t imm12 = (int32_t)((hc << 6) | hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1); /* sign-extend from 12 bits */
+    }
+    TCGv_i64 ea = tcg_temp_new_i64();
+    tcg_gen_addi_i64(ea, base, (int64_t)imm12);
+    /* 48-bit EA truncation: mask to 48 bits */
+    tcg_gen_andi_i64(ea, ea, 0x0000FFFFFFFFFFFFULL);
+    return ea;
+}
+
+/* §4.1.1 Single RD Load (rrii): ld.sb/ld.ub/ld.sw/ld.uw/ld.st/ld.ut/ld.o
+ * ILLI: rdha == 0 */
