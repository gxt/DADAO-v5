 {
-    /* ld.ub-rd - stub: ILLI */
-    gen_exception_illegal(ctx);
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 ea = gen_ea_rrii(ctx, a->hb, a->hc, a->hd);
+    TCGv_i64 val = tcg_temp_new_i64();
+    tcg_gen_qemu_ld_i64(val, ea, ctx->memidx, MO_UB);
