From d871bb16c31e3e487fb6211e1b573380ab0fef7c Mon Sep 17 00:00:00 2001
From: Guan Xuetao <gxt@pku.edu.cn>
Date: Sat, 19 Sep 2026 15:48:23 +0000
Subject: [PATCH] target/dadao: Implement RD load/store + MALIGN + jump/br.nz
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replace ILLI stubs with real TCG code for:
- §4.1.1: Single RD load/store (11 instructions: ld.sb/ub/sw/uw/st/ut/o, st.b/w/t/o)
- §4.1.2: Multi RD load/store (11 instructions: ldm.sb/ub/sw/uw/st/ut/o, stm.b/w/t/o)
- §5.3: jump-rrii (absolute jump, 48-bit EA)
- §5.2.3: br.nz rd (conditional branch, rd!=0)
- MALIGN: cpu_do_unaligned_access registered in CPUClass

Key design decisions:
- Big-endian MemOp (MO_BE*) for all accesses
- 48-bit EA truncation (& 0x0000FFFFFFFFFFFF)
- MO_ALIGN_N: byte=none, wyde=2, tetra=4, octa=8
- Multi load/store: rdhc snapshotted before loop, ascending order
- ILLI checks (rdha==0, immu6==0, rdha+immu6>64) before any write
- br.nz: translation-time PC for rb0, conditional exit_tb for taken path
- jump-rrii: 48-bit absolute address with tcg_gen_exit_tb before NORETURN
- Exit port: .impl.max_access_size=8 prevents TCG splitting
- ROM store: detected in tlb_fill and raises ILLI
---
 hw/dadao/dadao-machine.c |   7 +-
 target/dadao/cpu.c       |  11 +
 target/dadao/helper.c    |  10 +
 target/dadao/translate.c | 454 ++++++++++++++++++++++++++++++++++-----
 4 files changed, 427 insertions(+), 55 deletions(-)

diff --git a/hw/dadao/dadao-machine.c b/hw/dadao/dadao-machine.c
index eed2647..1db9a61 100644
--- a/hw/dadao/dadao-machine.c
+++ b/hw/dadao/dadao-machine.c
@@ -59,9 +59,13 @@ static void dadao_exit_port_write(void *opaque, hwaddr addr,
 {
     /*
      * Per ADR-0004 D3:
-     * - Only 8-byte (octa) writes are valid
+     * - Only 8-byte (octa) writes are valid exit port accesses
      * - Write value & 0xFF = exit code propagated to host $?
      * - Non-8B writes trigger ILLI (0x88)
+     *
+     * .impl.max_access_size = 8 prevents TCG from splitting 64-bit MMIO
+     * writes into two 32-bit writes. Without this, a guest st.o would be
+     * split into two 4-byte writes, neither of which is a valid exit.
      */
     if (size != 8) {
         qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
@@ -80,6 +84,7 @@ static const MemoryRegionOps dadao_exit_port_ops = {
     .endianness = DEVICE_BIG_ENDIAN,
     .valid.min_access_size = 1,
     .valid.max_access_size = 8,
+    .impl.max_access_size = 8,
 };
 
