+/* ── RD register access helpers ──────────────────────────────────────── */
+
+/* Load rd[n] into a TCG temp. rd0 always reads as 0. */
+static TCGv_i64 load_rd(int n)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    if (n == 0) {
+        tcg_gen_movi_i64(t, 0);
+    } else {
+        tcg_gen_ld_i64(t, tcg_env, offsetof(CPUDADAOState, rd[n]));
+    }
+    return t;
+}
+
+/* Store val into rd[n]. Writes to rd0 are silently ignored. */
+static void store_rd(int n, TCGv_i64 val)
+{
+    if (n == 0) {
+        return; /* rd0 hardwired to 0, ignore write */
+    }
+    tcg_gen_st_i64(val, tcg_env, offsetof(CPUDADAOState, rd[n]));
+}
+
+/* ── 128-bit result helpers (rrrr: add/sub/mul) ──────────────────────── */
+
+/* Check ILLI for rrrr dual-dest instructions:
+ * rdha==rd0 && rdhb==rd0 → ILLI
+ * rdha==rdhb && rdha!=rd0 → ILLI
+ * Returns true if legal (not ILLI). */
+static bool check_dual_dest_legal(DisasContext *ctx, int rdha, int rdhb)
+{
+    if (rdha == 0 && rdhb == 0) {
+        gen_exception_illegal(ctx);
+        return false;
+    }
+    if (rdha == rdhb && rdha != 0) {
+        gen_exception_illegal(ctx);
+        return false;
+    }
+    return true;
+}
+
+/* ── Fixed-width helpers (orrr MISC-byte/wyde/tetra/octa) ────────────── */
+
+/* Sign-extend a value from bit 'bit' (0-indexed) to 64 bits. */
+static TCGv_i64 gen_sign_extend(TCGv_i64 src, int bit)
+{
+    TCGv_i64 dst = tcg_temp_new_i64();
+    tcg_gen_shli_i64(dst, src, 63 - bit);
+    tcg_gen_sari_i64(dst, dst, 63 - bit);
+    return dst;
+}
+
+/* Zero-extend a value from bit 'bit' (0-indexed) to 64 bits.
+ * When bit >= 63, the full 64-bit value is returned unchanged.
+ * Avoids C UB: (1ULL << 64) is undefined behavior on x86-64. */
+static TCGv_i64 gen_zero_extend(TCGv_i64 src, int bit)
+{
+    if (bit >= 63) {
+        /* All 64 bits are valid; return as-is */
+        return src;
+    }
+    TCGv_i64 dst = tcg_temp_new_i64();
+    tcg_gen_andi_i64(dst, src, (1ULL << (bit + 1)) - 1);
+    return dst;
+}
+
+/* Runtime ILLI check: if cond is false, raise ILLI and continue TB.
+ * Use for runtime value checks (e.g., ext orrr hd>N) where the TB
+ * must continue past the check point. */
+static void gen_runtime_illi_check(DisasContext *ctx,
+                                   TCGv_i64 val, uint64_t limit)
+{
+    TCGLabel *label_ok = gen_new_label();
+    tcg_gen_brcondi_i64(TCG_COND_LEU, val, limit, label_ok);
+    gen_raise_exception_illi(ctx);
+    gen_set_label(label_ok);
+}
+
+/* ── Compare helper ──────────────────────────────────────────────────── */
+
+/* Generate compare: result = (a < b) ? -1 : (a == b) ? 0 : 1
+ * Three-branch pattern per task spec known-pit #6. */
+static void gen_cmp_three_way(TCGv_i64 result, TCGv_i64 a, TCGv_i64 b,
+                              bool is_signed)
+{
+    TCGLabel *label_lt = gen_new_label();
+    TCGLabel *label_eq = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+
+    /* Default result = 1 (greater) */
+    tcg_gen_movi_i64(result, 1);
+
+    /* Check equal */
+    tcg_gen_brcond_i64(TCG_COND_EQ, a, b, label_eq);
+
+    /* Not equal: check less-than */
+    if (is_signed) {
+        tcg_gen_brcond_i64(TCG_COND_LT, a, b, label_lt);
+    } else {
+        tcg_gen_brcond_i64(TCG_COND_LTU, a, b, label_lt);
+    }
+    /* Greater: result already 1 */
+    tcg_gen_br(label_done);
+
+    /* Equal: result = 0 */
+    gen_set_label(label_eq);
+    tcg_gen_movi_i64(result, 0);
+    tcg_gen_br(label_done);
+
+    /* Less: result = -1 */
+    gen_set_label(label_lt);
+    tcg_gen_movi_i64(result, -1);
+
+    gen_set_label(label_done);
+}
+
+/* ── Division helper (runtime ILLI for div-by-zero / INT_MIN÷-1) ─────── */
+
+/* Generate division with runtime ILLI checks.
+ * quotient = a / b (or rem), with checks for:
+ *   b == 0 → ILLI
+ *   signed && a == INT_MIN && b == -1 → ILLI
+ * Returns quotient/remainder via 'result'. Caller must NOT write result
+ * until after all checks pass (precise exception: no side-effect on fault).
+ * 'size' = 7/15/31/63 for byte/wyde/tetra/octa.
+ * 'is_signed' = true for signed div.
+ * 'is_rem' = true for remainder instead of quotient. */
+static void gen_div_with_checks(DisasContext *ctx,
+                                TCGv_i64 result,
+                                TCGv_i64 src_a, TCGv_i64 src_b,
+                                int size, bool is_signed, bool is_rem)
+{
+    TCGv_i64 a = tcg_temp_new_i64();
+    TCGv_i64 b = tcg_temp_new_i64();
+    TCGv_i64 q = tcg_temp_new_i64();
+    TCGLabel *label_ok = gen_new_label();
+
+    /* Truncate sources to size bits */
+    tcg_gen_andi_i64(a, src_a, (2ULL << size) - 1);
+    tcg_gen_andi_i64(b, src_b, (2ULL << size) - 1);
+
+    if (is_signed) {
+        /* Sign-extend truncated values */
+        tcg_gen_shli_i64(a, a, 63 - size);
+        tcg_gen_sari_i64(a, a, 63 - size);
+        tcg_gen_shli_i64(b, b, 63 - size);
+        tcg_gen_sari_i64(b, b, 63 - size);
+    }
+
+    /* Check b == 0 → ILLI */
+    tcg_gen_brcondi_i64(TCG_COND_NE, b, 0, label_ok);
+    gen_raise_exception_illi(ctx); /* runtime: don't set is_jmp */
+
+    gen_set_label(label_ok);
+
+    if (is_signed) {
+        /* Check INT_MIN ÷ -1 → ILLI
+         * Combined setcond+brcond for reliable runtime check.
+         * gen_raise_exception_illi raises the exception at runtime.
+         * helper_raise_exception uses cpu_loop_exit_restore(GETPC())
+         * to restore precise exception state (prevents TB replay). */
+        int64_t int_min = (size >= 63) ? INT64_MIN : -(1LL << size);
+        TCGLabel *label_no_overflow = gen_new_label();
+        TCGv_i64 c1 = tcg_temp_new_i64();
+        TCGv_i64 c2 = tcg_temp_new_i64();
+        TCGv_i64 combined = tcg_temp_new_i64();
+
+        tcg_gen_setcondi_i64(TCG_COND_EQ, c1, a, int_min);
+        tcg_gen_setcondi_i64(TCG_COND_EQ, c2, b, -1);
+        tcg_gen_and_i64(combined, c1, c2);
+        tcg_gen_brcondi_i64(TCG_COND_EQ, combined, 0, label_no_overflow);
+        gen_raise_exception_illi(ctx);
+
+        gen_set_label(label_no_overflow);
+
+        /* Signed division */
+        if (is_rem) {
+            /* remainder = a - (a/b)*b (truncate-toward-zero, per C99) */
+            TCGv_i64 quot = tcg_temp_new_i64();
+            tcg_gen_div_i64(quot, a, b);
+            tcg_gen_mul_i64(quot, quot, b);
+            tcg_gen_sub_i64(q, a, quot);
+        } else {
+            tcg_gen_div_i64(q, a, b);
+        }
+    } else {
+        /* Unsigned division */
+        if (is_rem) {
+            tcg_gen_remu_i64(q, a, b);
+        } else {
+            tcg_gen_divu_i64(q, a, b);
+        }
+    }
+
+    /* Truncate result to size bits, then sign/zero extend */
+    if (is_signed) {
+        TCGv_i64 ext = gen_sign_extend(q, size);
+        tcg_gen_mov_i64(result, ext);
+    } else {
+        TCGv_i64 ext = gen_zero_extend(q, size);
+        tcg_gen_mov_i64(result, ext);
+    }
+}
+
