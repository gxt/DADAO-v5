diff --git a/linux-user/dadao/target_mman.h b/linux-user/dadao/target_mman.h
new file mode 100644
index 0000000..63114ba
--- /dev/null
+++ b/linux-user/dadao/target_mman.h
@@ -0,0 +1,14 @@
+/*
+ * Guest mmap layout for linux-user (P3).
+ *
+ * Same shape as the other 64-bit asm-generic ports: mmap without a hint walks
+ * up from TASK_UNMAPPED_BASE, and a PIE/interpreter is placed at
+ * ELF_ET_DYN_BASE.  Both are derived from the target address-space size, not
+ * from any v5 constant.
+ */
+#define TASK_UNMAPPED_BASE \
+    TARGET_PAGE_ALIGN((1ull << (TARGET_VIRT_ADDR_SPACE_BITS - 1)) / 3)
+
+#define ELF_ET_DYN_BASE       (TASK_UNMAPPED_BASE * 2)
+
+#include "../generic/target_mman.h"
