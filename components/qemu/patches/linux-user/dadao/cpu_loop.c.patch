+/*
+ * QEMU user-mode CPU loop for DADAO (P3, ADR-0025 D2/D6).
+ *
+ * The contract this implements:
+ *
+ *   * entry: `trap cfx0, 0` -- umon / SBI_UMON_SYSCALL (immu18 = 0), decoded to
+ *     DADAO_EXCP_SYSCALL in target/dadao/insn_trans/trans_ctrl.c.inc when
+ *     CONFIG_USER_ONLY (contract-syscall.md §2);
+ *   * number: rd15, RISC-V/asm-generic numbering (contract-syscall.md §1.1);
+ *   * arguments: routed BY TYPE into rd16+ (data) / rb16+ (address) with the
+ *     two banks counted independently (contract-syscall.md §3);
+ *   * result: rd8; an error is a NEGATIVE rd8 (-errno), never rd1
+ *     (contract-syscall.md §4, user ruling 2026-10-14);
+ *   * the callee resumes at the instruction after the trap;
+ *   * an unknown number reaches do_syscall() and comes back as -ENOSYS -- it is
+ *     never silently "successful".
+ *
+ * The guest side of the argument routing is musl's port
+ * (arch/dadao/syscall_arch.h:__dadao_argmask and
+ * src/thread/dadao/syscall_cp.s, which carry the same table because musl passes
+ * plain `long`s and recovers pointer-ness from the syscall number).  The host
+ * side below must reconstruct the same positional list, so it mirrors that
+ * table number for number.  This is a protocol invariant, not an oracle:
+ * tools/qemu/check_syscall_abi.py cross-checks both tables so a number added
+ * on one side only fails a gate instead of reading garbage.
+ */
+#include "qemu/osdep.h"
+#include "qemu.h"
+#include "user-internals.h"
+#include "user/cpu_loop.h"
+#include "signal-common.h"
+
+QEMU_BUILD_BUG_ON(AUDIT_ARCH_DADAO != (0x0DA0u | 0x80000000u));
+
+/* Bit i set <=> positional syscall argument i lives in the RB (address)
+ * bank; the banks are counted independently, so the n-th address
+ * argument is read from rb(16+n) and the n-th data argument from
+ * rd(16+n) (contract-syscall.md §3).  This table mirrors musl's
+ * __dadao_argmask() number for number -- the derivation of each mask
+ * is documented there; tools/qemu/check_syscall_abi.py fails the gate
+ * when the two drift apart.
+ */
