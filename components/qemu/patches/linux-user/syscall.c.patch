+#if defined(TARGET_DADAO)
+    /*
+     * QEMU-066t (ISS-297): registration/query consistency only.
+     *
+     * The kernel uses this list to walk the *guest* list on thread death; a
+     * host kernel cannot do that (guest pointers are not host pointers), and it
+     * is not needed here: musl walks `self->robust_list.head` itself in
+     * src/thread/pthread_create.c:119-137 (before SYS_exit) and marks each held
+     * robust mutex with 0x40000000 in user space -- the comment there names
+     * "non-pshared mutexes and the detached thread case" as the reason, which
+     * are exactly the two shapes libc-test exercises.  What musl *does* probe
+     * through the syscall is support itself: pthread_mutexattr_setrobust()
+     * calls get_robust_list(0, ...) and turns ENOSYS into "no robust mutexes".
+     * So the contract implemented here is the kernel's own ABI shape
+     * (kernel/futex/syscalls.c): set/get persist and return the same {head,len}
+     * per thread.
+     */
+    case TARGET_NR_set_robust_list:
+    {
+        TaskState *ts = get_task_state(cpu);
+
+        /* The kernel knows exactly one list layout: 3 longs.  `len` is
+         * validated before the assignment (so unregistering with a bogus length
+         * is EINVAL, as on the host), and head == 0 unregisters. */
+        if (arg2 != 3 * sizeof(abi_ulong)) {
+            return -TARGET_EINVAL;
+        }
+        ts->robust_list_head = arg1;
+        return 0;
+    }
+    case TARGET_NR_get_robust_list:
+    {
+        TaskState *ts = get_task_state(cpu);
+
+        /*
+         * Scope: pid == 0 (the caller) and the caller's own tid.  Querying
+         * *another* thread's list is not implemented -- qemu-user has no
+         * per-tid lookup for guest threads here, and the kernel ABI also
+         * requires a ptrace-style permission check that has no meaning for a
+         * same-process thread.  Any other pid is reported the way the kernel
+         * reports an unknown one: ESRCH (explicitly, not by returning a
+         * made-up list).
+         */
+        if (arg1 != 0 && arg1 != (abi_ulong)sys_gettid()) {
+            return -TARGET_ESRCH;
+        }
+        if (put_user_ual(ts->robust_list_head, arg2) ||
+            put_user_ual(3 * sizeof(abi_ulong), arg3)) {
+            return -TARGET_EFAULT;
+        }
+        return 0;
+    }
+#else
     case TARGET_NR_set_robust_list:
     case TARGET_NR_get_robust_list:
         /* The ABI for supporting robust futexes has userspace pass
@@ -13566,6 +13700,7 @@ static abi_long do_syscall1(CPUArchState *cpu_env, int num, abi_long arg1,
          */
         return -TARGET_ENOSYS;
 #endif
+#endif
 
