+++ b/include/semihosting/common-semi.h
@@ -34,6 +34,8 @@
 #ifndef COMMON_SEMI_H
 #define COMMON_SEMI_H
 
+#include "exec/vaddr.h"
+
 void do_common_semihosting(CPUState *cs);
 uint64_t common_semi_arg(CPUState *cs, int argno);
 void common_semi_set_ret(CPUState *cs, uint64_t ret);
@@ -42,4 +44,53 @@ bool common_semi_sys_exit_is_extended(CPUState *cs);
 uint64_t common_semi_stack_bottom(CPUState *cs);
 bool common_semi_has_synccache(CPUArchState *env);
 
+/**
+ * common_semi_strlen:
+ * @cs: CPU state
+ * @addr: guest address of a NUL-terminated string, in the address space the
+ *        target's semihosting convention uses for pointer arguments
+ *
+ * Measures a semihosting string argument whose length the guest did not state
+ * (the length field is 0 / absent):
+ *   - SYS_WRITE0's NUL-terminated string (0x04);
+ *   - SYS_OPEN's file name (0x01), which the responder locks through this hook
+ *     instead of `lock_user_string()`.
+ *
+ * The default walks @addr through the current MMU context, which is right for
+ * targets whose semihosting pointers are virtual addresses.  A target whose
+ * pointers are *physical* addresses overrides this hook (a strong definition
+ * in ``target/<t>/common-semi-target.c`` replaces the weak default at link
+ * time); see ``target/dadao`` for DADAO, whose rule is fixed by
+ * spec/Kaiwu §5.2 and contract-semihosting §2.
+ *
+ * Returns: the length in bytes (terminator excluded), or -1 when the string
+ *          cannot be read.
+ */
+ssize_t common_semi_strlen(CPUState *cs, vaddr addr);
+
+/**
+ * common_semi_scratch_addr:
+ * @cs: CPU state
+ * @size: bytes of scratch the service needs (1 for SYS_READC, 64 for SYS_FLEN)
+ * @addr: out-parameter, the scratch slot in the address space the target's
+ *        semihosting convention uses for pointer arguments
+ *
+ * Names the internal scratch slot the responder uses for the services that
+ * need target memory but take no buffer argument:
+ *   - SYS_READC (0x07): one byte holding the character just read;
+ *   - SYS_FLEN (0x0c): the 64-byte gdb_stat block the remote gdb fills in.
+ *
+ * The default is upstream's "just below the target's stack pointer", which is
+ * only correct when the stack pointer lives in the semihosting pointer space.
+ * A target whose pointers are physical addresses while its stack pointer is a
+ * VA overrides this hook with a strong definition (see
+ * ``target/dadao/common-semi-target.c``; ISS-452).
+ *
+ * Returns: 0 with @addr set to the slot, or -1 when the slot cannot be named
+ *          in the target's semihosting pointer space.  @addr is only written
+ *          on success; a target's strong definition must keep that rule (a
+ *          caller may pre-seed it with a placeholder).
+ */
+int common_semi_scratch_addr(CPUState *cs, uint64_t size, uint64_t *addr);
+
 #endif /* COMMON_SEMI_H */
