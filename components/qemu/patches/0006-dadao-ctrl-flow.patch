diff --git a/target/dadao/insn_trans/trans_ctrl.c.inc b/target/dadao/insn_trans/trans_ctrl.c.inc
index 0c7cca5..a86512c 100644
--- a/target/dadao/insn_trans/trans_ctrl.c.inc
+++ b/target/dadao/insn_trans/trans_ctrl.c.inc
@@ -1,228 +1,593 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
+/* ── Helper: RegRAS push (§5.6.1) ───────────────────────────────────── */
+/* Push return_addr onto RegRAS (ra1-ra63 stack, ra63=top).
+ * M1: no MemRAS (ra0 low48==0), overflow → RASOF.
+ * NOTE: This implementation only handles ra0 low48==0 (RegRAS-only) path.
+ * If ra0 low48!=0 (MemRAS enabled, e.g. via ld.o-ra), this code will
+ * incorrectly throw RASOF instead of spilling to MemRAS. This limitation
+ * is tracked for QEMU-013t/018t.
+ * Three cases:
+ *   1. ra63[63:48]==0 (empty) → write ret_addr, refcount=1
+ *   2. ra63[63:48]!=0 && !overflow && ret_addr==ra63[47:0] → refcount++
+ *   3. Otherwise → shift down, insert new at top, RASOF if ra1 was valid
+ * §9.2: RASOF is precise — no RA registers are modified on overflow. */
+static void gen_ras_push(DisasContext *ctx, TCGv_i64 ret_addr)
+{
+    TCGv_i64 ra63_val = tcg_temp_new_i64();
+    tcg_gen_ld_i64(ra63_val, tcg_env, offsetof(CPUDADAOState, ra[63]));
+
+    TCGv_i64 ra63_hi = tcg_temp_new_i64();
+    tcg_gen_shri_i64(ra63_hi, ra63_val, 48);
+
+    /* Case 1: ra63 empty (refcount==0) */
+    TCGLabel *label_empty = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+    tcg_gen_brcondi_i64(TCG_COND_EQ, ra63_hi, 0, label_empty);
+
+    /* Case 2: recursive (ret_addr == ra63 low48 && refcount < 0xFFFF) */
+    TCGv_i64 ra63_lo = tcg_temp_new_i64();
+    tcg_gen_andi_i64(ra63_lo, ra63_val, 0x0000FFFFFFFFFFFFULL);
+    TCGLabel *label_shift = gen_new_label();
+    tcg_gen_brcond_i64(TCG_COND_NE, ret_addr, ra63_lo, label_shift);
+
+    /* Check refcount not maxed out (0xFFFF) */
+    tcg_gen_brcondi_i64(TCG_COND_GE, ra63_hi, 0xFFFF, label_shift);
+
+    /* Increment refcount */
+    TCGv_i64 new_ra63 = tcg_temp_new_i64();
+    tcg_gen_addi_i64(new_ra63, ra63_hi, 1);
+    tcg_gen_shli_i64(new_ra63, new_ra63, 48);
+    tcg_gen_or_i64(new_ra63, new_ra63, ra63_lo);
+    tcg_gen_st_i64(new_ra63, tcg_env, offsetof(CPUDADAOState, ra[63]));
+    tcg_gen_br(label_done);
+
+    /* Case 1: empty → write new entry, refcount=1 */
+    gen_set_label(label_empty);
+    {
+        TCGv_i64 new_val = tcg_temp_new_i64();
+        TCGv_i64 one_hi = tcg_constant_i64(1ULL << 48);
+        tcg_gen_or_i64(new_val, ret_addr, one_hi);
+        tcg_gen_st_i64(new_val, tcg_env, offsetof(CPUDADAOState, ra[63]));
+    }
+    tcg_gen_br(label_done);
+
+    /* Case 3: shift down, insert new at top.
+     * §5.6.1: ra63→ra62, ra62→ra61, ..., ra2→ra1.
+     * F4: RASOF check must happen BEFORE any register writes (precise exception). */
+    gen_set_label(label_shift);
+    {
+        /* F4: Check RASOF BEFORE any writes.
+         * If ra[1] is valid AND ra0 low48==0 → RASOF (no RegRAS changes). */
+        {
+            TCGv_i64 ra1_val = tcg_temp_new_i64();
+            tcg_gen_ld_i64(ra1_val, tcg_env, offsetof(CPUDADAOState, ra[1]));
+            TCGv_i64 ra1_hi = tcg_temp_new_i64();
+            tcg_gen_shri_i64(ra1_hi, ra1_val, 48);
+            TCGLabel *label_no_overflow = gen_new_label();
+            tcg_gen_brcondi_i64(TCG_COND_EQ, ra1_hi, 0, label_no_overflow);
+            /* ra1 is valid → RASOF (M1: no MemRAS, ra0 low48==0) */
+            gen_helper_raise_exception(tcg_env,
+                                       tcg_constant_i32(DADAO_EXCP_RASOF));
+            gen_set_label(label_no_overflow);
+        }
+
+        /* §5.6.1 shift: ra63→ra62, ra62→ra61, ..., ra2→ra1.
+         * ASCENDING iteration (i=2..63): read ra[i], store ra[i-1].
+         * Since destination (i-1) < source (i), ascending avoids overwriting
+         * unread entries. */
+        for (int i = 2; i <= 63; i++) {
+            TCGv_i64 src_val = tcg_temp_new_i64();
+            tcg_gen_ld_i64(src_val, tcg_env, offsetof(CPUDADAOState, ra[i]));
+            TCGv_i64 src_hi = tcg_temp_new_i64();
+            tcg_gen_shri_i64(src_hi, src_val, 48);
+            TCGLabel *label_skip = gen_new_label();
+            tcg_gen_brcondi_i64(TCG_COND_EQ, src_hi, 0, label_skip);
+            /* Valid entry: move ra[i] → ra[i-1] */
+            tcg_gen_st_i64(src_val, tcg_env, offsetof(CPUDADAOState, ra[i - 1]));
+            gen_set_label(label_skip);
+        }
+
+        /* Insert new entry at ra63: refcount=1, addr=ret_addr */
+        {
+            TCGv_i64 new_val = tcg_temp_new_i64();
+            TCGv_i64 one_hi = tcg_constant_i64(1ULL << 48);
+            tcg_gen_or_i64(new_val, ret_addr, one_hi);
+            tcg_gen_st_i64(new_val, tcg_env, offsetof(CPUDADAOState, ra[63]));
+        }
+    }
+
+    gen_set_label(label_done);
+}
+
+/* ── Helper: RegRAS pop (§5.6.2) ────────────────────────────────────── */
+/* Pop return address from RegRAS. Returns the return address (48-bit).
+ * NOTE: This implementation only handles ra0 low48==0 (RegRAS-only) path.
+ * If ra0 low48!=0 (MemRAS enabled), this code will throw RASUF instead of
+ * popping from MemRAS. Limitation tracked for QEMU-013t/018t.
+ * Three cases:
+ *   1. ra63[63:48] > 1 → decrement refcount, return ra63[47:0]
+ *   2. ra63[63:48] == 1 → pop, shift up (ra62→ra63, ra61→ra62, ..., ra1→ra2),
+ *      ra1 cleared, return addr
+ *   3. ra63[63:48] == 0 → RASUF (M1: no MemRAS) */
+static TCGv_i64 gen_ras_pop(DisasContext *ctx)
+{
+    TCGv_i64 result = tcg_temp_new_i64();
+    TCGv_i64 ra63_val = tcg_temp_new_i64();
+    tcg_gen_ld_i64(ra63_val, tcg_env, offsetof(CPUDADAOState, ra[63]));
+
+    TCGv_i64 ra63_hi = tcg_temp_new_i64();
+    tcg_gen_shri_i64(ra63_hi, ra63_val, 48);
+
+    TCGv_i64 ra63_lo = tcg_temp_new_i64();
+    tcg_gen_andi_i64(ra63_lo, ra63_val, 0x0000FFFFFFFFFFFFULL);
+
+    TCGLabel *label_refcount_gt1 = gen_new_label();
+    TCGLabel *label_refcount_eq1 = gen_new_label();
+    TCGLabel *label_rasuf = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+
+    /* Case 1: refcount > 1 → decrement */
+    tcg_gen_brcondi_i64(TCG_COND_GT, ra63_hi, 1, label_refcount_gt1);
+    /* Case 2: refcount == 1 → pop and shift */
+    tcg_gen_brcondi_i64(TCG_COND_EQ, ra63_hi, 1, label_refcount_eq1);
+    /* Case 3: refcount == 0 → RASUF */
+    tcg_gen_br(label_rasuf);
+
+    /* Case 1: decrement refcount */
+    gen_set_label(label_refcount_gt1);
+    {
+        TCGv_i64 new_hi = tcg_temp_new_i64();
+        tcg_gen_subi_i64(new_hi, ra63_hi, 1);
+        TCGv_i64 new_val = tcg_temp_new_i64();
+        tcg_gen_shli_i64(new_hi, new_hi, 48);
+        tcg_gen_or_i64(new_val, new_hi, ra63_lo);
+        tcg_gen_st_i64(new_val, tcg_env, offsetof(CPUDADAOState, ra[63]));
+        tcg_gen_mov_i64(result, ra63_lo);
+    }
+    tcg_gen_br(label_done);
+
+    /* Case 2: pop and shift up.
+     * §5.6.2: ra62→ra63, ra61→ra62, ..., ra1→ra2, then ra1 cleared.
+     * DESCENDING iteration (i=62..1): read ra[i], store ra[i+1].
+     * Since destination (i+1) > source (i), descending avoids overwriting
+     * unread entries. Includes ra62→ra63 (was missing before). */
+    gen_set_label(label_refcount_eq1);
+    {
+        tcg_gen_mov_i64(result, ra63_lo);
+        /* Shift: ra[i] → ra[i+1] for i=62..1 (descending) */
+        for (int i = 62; i >= 1; i--) {
+            TCGv_i64 src_val = tcg_temp_new_i64();
+            tcg_gen_ld_i64(src_val, tcg_env, offsetof(CPUDADAOState, ra[i]));
+            TCGv_i64 src_hi = tcg_temp_new_i64();
+            tcg_gen_shri_i64(src_hi, src_val, 48);
+            TCGLabel *label_clear = gen_new_label();
+            TCGLabel *label_store = gen_new_label();
+            tcg_gen_brcondi_i64(TCG_COND_EQ, src_hi, 0, label_clear);
+            /* Valid: store ra[i] → ra[i+1] */
+            tcg_gen_st_i64(src_val, tcg_env, offsetof(CPUDADAOState, ra[i + 1]));
+            tcg_gen_br(label_store);
+            gen_set_label(label_clear);
+            /* Invalid: clear ra[i+1] */
+            TCGv_i64 zero = tcg_constant_i64(0);
+            tcg_gen_st_i64(zero, tcg_env, offsetof(CPUDADAOState, ra[i + 1]));
+            gen_set_label(label_store);
+        }
+        /* Clear ra1 (bottom of stack, shifted out) */
+        {
+            TCGv_i64 zero = tcg_constant_i64(0);
+            tcg_gen_st_i64(zero, tcg_env, offsetof(CPUDADAOState, ra[1]));
+        }
+    }
+    tcg_gen_br(label_done);
+
+    /* Case 3: RASUF */
+    gen_set_label(label_rasuf);
+    gen_helper_raise_exception(tcg_env, tcg_constant_i32(DADAO_EXCP_RASUF));
+
+    gen_set_label(label_done);
+    return result;
+}
+
+/* ── Helper: branch taken path ──────────────────────────────────────── */
+/* Compute branch target: rb0(PC) + sign_extend(imm18) << 2, mask 48-bit.
+ * Update PC, rb[0], exit TB. */
+static void gen_branch_taken(DisasContext *ctx, int ha, int hb, int hc, int hd)
+{
+    int32_t imm18 = (int32_t)((hb << 12) | (hc << 6) | hd);
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    int64_t offset = (int64_t)imm18 << 2;
+
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    tcg_gen_andi_i64(target, target, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+/* ── Helper: branch taken path for rrii (br.eq/br.ne) ──────────────── */
+static void gen_branch_taken_rrii(DisasContext *ctx, int hc, int hd)
+{
+    int32_t imm12 = (int32_t)((hc << 6) | hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1);
+    }
+    int64_t offset = (int64_t)imm12 << 2;
+
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    tcg_gen_andi_i64(target, target, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+/* ── §4.7 PC-relative: rela.si rbha, imms18 (riii) ─────────────────── */
+/* rbha = (PC & ~0xFFF) + sign_extend(imms18 << 12), high 16 bits preserved.
+ * ILLI: rbha == rb0 */
 static bool trans_rela_si_rb(DisasContext *ctx, arg_main *a)
 {
-    /* rela.si-rb - stub: ILLI */
-    gen_exception_illegal(ctx);
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+
+    int32_t imm18 = (int32_t)((a->hb << 12) | (a->hc << 6) | a->hd);
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    int64_t offset = (int64_t)imm18 << 12;
+
+    TCGv_i64 rbha = load_rb(ctx, a->ha);
+    /* Preserve high 16 bits */
+    TCGv_i64 hi16 = tcg_temp_new_i64();
+    tcg_gen_andi_i64(hi16, rbha, 0xFFFF000000000000ULL);
+
+    /* PC & ~0xFFF */
+    uint64_t pc_aligned = ctx->base.pc_next & ~0xFFFULL;
+    TCGv_i64 base = tcg_constant_i64(pc_aligned);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_addi_i64(result, base, offset);
+    /* Mask to 48 bits */
+    tcg_gen_andi_i64(result, result, 0x0000FFFFFFFFFFFFULL);
+    /* Restore high 16 bits */
+    tcg_gen_or_i64(result, result, hi16);
+    store_rb(a->ha, result);
     return true;
 }
 
