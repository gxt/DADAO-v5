+/* §4.1.2 Multi RD Load (rrri): ldm.sb/ldm.ub/ldm.sw/ldm.uw/ldm.st/ldm.ut/ldm.o
+ * EA_i = (rbhb + rdhc + i*N) mod 2^48, rd(ha)..rd(ha+immu6-1)
+ * ILLI: rdha==0, immu6==0, rdha+immu6>64
+ * rdhc snapshotted before loop. */
+static bool trans_ldm_ub_rd(DisasContext *ctx, arg_main *a)
+{
+    if (a->ha == 0 || a->hd == 0 || a->ha + a->hd > 64) {
+        gen_exception_illegal(ctx); return true;
+    }
+    TCGv_i64 base = load_rb(ctx, a->hb);
+    TCGv_i64 offset = load_rd(a->hc); /* snapshot rdhc */
+    tcg_gen_add_i64(base, base, offset);
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 ea = tcg_temp_new_i64();
+        if (i == 0) {
+            tcg_gen_mov_i64(ea, base);
+        } else {
+            tcg_gen_addi_i64(ea, base, i); /* byte stride=1 */
+        }
+        TCGv_i64 val = tcg_temp_new_i64();
+        tcg_gen_qemu_ld_i64(val, ea, ctx->memidx, MO_UB);
+        store_rd(a->ha + i, val);
+    }
+    return true;
+}
