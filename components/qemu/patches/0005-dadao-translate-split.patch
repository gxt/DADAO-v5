+/* §3.1.1 add.uo/add.so/sub.uo/sub.so (rrrr): 128-bit add/sub */
+static bool trans_add_uo_rd(DisasContext *ctx, arg_main *a)
+{
+    if (!check_dual_dest_legal(ctx, a->ha, a->hb)) {
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    /* Unsigned: zero-extend to 128, add, hi=carry(0 or 1) */
+    tcg_gen_add_i64(lo, rdhc, rdhd);
+    tcg_gen_setcond_i64(TCG_COND_LTU, hi, lo, rdhc); /* carry */
+    store_rd(a->hb, lo);
+    store_rd(a->ha, hi);
+    return true;
+}
+
+static bool trans_add_so_rd(DisasContext *ctx, arg_main *a)
+{
+    if (!check_dual_dest_legal(ctx, a->ha, a->hb)) {
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    /* Signed: sign-extend to 128, add2 */
+    TCGv_i64 hc_hi = tcg_temp_new_i64();
+    TCGv_i64 hd_hi = tcg_temp_new_i64();
+    tcg_gen_sari_i64(hc_hi, rdhc, 63);
+    tcg_gen_sari_i64(hd_hi, rdhd, 63);
+    tcg_gen_add2_i64(lo, hi, rdhc, hc_hi, rdhd, hd_hi);
+    store_rd(a->hb, lo);
+    store_rd(a->ha, hi);
+    return true;
+}
+
