+}
+
+/* §5.2.3 br.nz rd (riii): if (rdha != 0) PC = rb0 + sign_extend(imms18 << 2)
+ * Immediate: imms18 = hb[5:0] (hi) | hc[5:0] (mid) | hd[5:0] (lo)
+ * rb0 = PC (current instruction address). Computed at runtime for TB relinking. */
+static bool trans_br_nz_rd(DisasContext *ctx, arg_main *a)
+{
+    /* Reconstruct 18-bit signed immediate */
+    int32_t imm18 = (int32_t)((a->hb << 12) | (a->hc << 6) | a->hd);
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    int64_t offset = (int64_t)imm18 << 2;
+
+    TCGv_i64 rdha = load_rd(a->ha);
+
+    /* Branch if rdha != 0 */
+    TCGLabel *label_taken = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+    tcg_gen_brcondi_i64(TCG_COND_NE, rdha, 0, label_taken);
+
+    /* Not taken: fall through to next instruction (PC already advanced by QEMU) */
+    tcg_gen_br(label_done);
+
+    gen_set_label(label_taken);
+    /* Taken path: compute target = rb0 + offset, set PC, exit TB
+     * rb0 = current instruction address (translation-time PC) */
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    tcg_gen_andi_i64(target, target, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    /* Exit TB to pick up new PC; not-taken path jumps to label_done */
+    tcg_gen_exit_tb(NULL, 0);
+
+    gen_set_label(label_done);
+    return true;
+}
+
