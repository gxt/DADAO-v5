+}
+
+/* §5.3 jump-rrii: PC = rbha + rdhb + sign_extend(imms12 << 2)
+ * 48-bit absolute address. Used by harness trampoline.
+ * Fields: ha=rbha(rb), hb=rdhb(rd), hc=imms12_hi, hd=imms12_lo */
+static bool trans_jump_rrii(DisasContext *ctx, arg_main *a)
+{
+    /* Reconstruct 12-bit signed immediate */
+    int32_t imm12 = (int32_t)((a->hc << 6) | a->hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1);
+    }
+    int64_t offset = (int64_t)imm12 << 2;
+
+    TCGv_i64 rbha = load_rb(ctx, a->ha); /* rbha = rb register */
+    TCGv_i64 rdhb = load_rd(a->hb); /* rdhb = rd register */
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_add_i64(target, rbha, rdhb);
+    tcg_gen_addi_i64(target, target, offset);
+    /* 48-bit EA truncation */
+    tcg_gen_andi_i64(target, target, 0x0000FFFFFFFFFFFFULL);
+
+    /* Write target to PC and rb[0] */
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    /* Exit TB to pick up new PC, then mark NORETURN (no exit generated by tb_stop) */
+    tcg_gen_exit_tb(NULL, 0);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+}
