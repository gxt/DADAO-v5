+
+/* Load ra[n] into a TCG temp. All ra registers (including ra0) are
+ * directly addressable. §4.9.1: ra0 can be read without exception. */
+static TCGv_i64 load_ra(int n)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    tcg_gen_ld_i64(t, tcg_env, offsetof(CPUDADAOState, ra[n]));
+    return t;
+}
+
+/* Store val into ra[n]. All ra registers (including ra0) are
+ * directly addressable. §4.9.1: ra0 can be written without exception. */
+static void store_ra(int n, TCGv_i64 val)
+{
+    tcg_gen_st_i64(val, tcg_env, offsetof(CPUDADAOState, ra[n]));
