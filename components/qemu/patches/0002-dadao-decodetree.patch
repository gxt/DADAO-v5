 target/dadao/meson.build |    3 +
 target/dadao/translate.c | 1851 +++++++++++++++++++++++++++++++++++++-
 3 files changed, 2095 insertions(+), 33 deletions(-)
 create mode 100644 target/dadao/insn.decode

