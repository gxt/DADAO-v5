+                                uint64_t *val)
+{
+    (void)env; (void)cg; (void)rc; (void)val;
+    return false;                       /* user build: CFXREG, no stub */
+}
+
+static bool dadao_pmem_reg_write(CPUDADAOState *env, uint32_t cg, uint32_t rc,
+                                 uint64_t val)
+{
+    (void)env; (void)cg; (void)rc; (void)val;
+    return false;                       /* user build: CFXREG, no stub */
+}
