+#endif /* !CONFIG_USER_ONLY */
+
+/* ===================================================================
+ * cfx_time (cfxha 34) + single-hart cfx_hart timer (cfxha 15)
+ * (spec/DADAO-12 §4.7/§4.10; contract-see §3; INTEG-050t/INTEG-051t)
+ *
+ * cfx_time_value and cfx_hart_cycle are derived from QEMU_CLOCK_VIRTUAL
+ * (test-machine model: 1 count = 1 ns, epoch = reset time_base_ns).  cfx_hart
+ * insn is accumulated per TB by translate.c.  The timer is one-shot and its
+ * deadline is a 64-bit absolute cfx_time value; TIMER (1 << 10) is maskable
+ * with cause_info = 0.  A pending TIMER lives in the target cfx's cg5 rc5
+ * (cfx_hart bit10); the unified arbiter below only selects (INTEG-051t).
+ * =================================================================== */
+
+static uint64_t dadao_time_now_ns(void)
+{
+#ifdef CONFIG_USER_ONLY
+    /* linux-user has no QEMU_CLOCK_VIRTUAL; reads stay non-faulting. */
+    return 0;
+#else
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+#endif
+}
+
+static uint64_t dadao_time_value(CPUDADAOState *env)
+{
+    uint64_t now = dadao_time_now_ns();
+
+    return (now >= env->time_base_ns) ? now - env->time_base_ns : 0;
+}
+
+static bool dadao_time_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg10 rc0: time_freq (Hz) */
+        *val = DADAO_TIME_FREQ;
+        return true;
+    case 1:                             /* cg10 rc1: time_value (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool dadao_hart_istatus(CPUDADAOState *env)
+{
+    return (env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) &&
+           (env->hart_timer_cmp != ~0ULL) &&
+           (dadao_time_value(env) >= env->hart_timer_cmp);
+}
+
+static bool dadao_hart_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg8 rc0: hart_id (single hart) */
+        *val = 0;
+        return true;
+    case 2:                             /* cg8 rc2: cycle (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    case 3:                             /* cg8 rc3: insn (64-bit) */
+        *val = env->hart_insn;
+        return true;
+#ifdef CONFIG_USER_ONLY
+    case 4:
+    case 5:
+        return false;                   /* timer regs withheld: CFXREG */
+#else
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+        *val = env->hart_timer_cmp;
+        return true;
+    case 5:                             /* cg8 rc5: ctrl[1:0] | ISTATUS << 2 */
+        *val = (env->hart_timer_ctrl & (DADAO_HART_TIMER_ENABLE |
+                                        DADAO_HART_TIMER_IMASK)) |
+               (dadao_hart_istatus(env) ? DADAO_HART_TIMER_ISTATUS : 0);
+        return true;
+#endif
+    default:                            /* rc1/rc6/rc7/others: reserved */
+        return false;
+    }
+}
+
+#ifndef CONFIG_USER_ONLY
+
+/* Wake the vCPU for TIMER.  The timer callback runs in the main loop with
+ * the BQL held; the same expiry can also be reached synchronously from a
+ * cfx2rc helper (write cmp/ctrl) where the BQL is not held, so use the
+ * BQL-free atomic request in that case (cpu_interrupt asserts bql_locked). */
+static void dadao_hart_notify(CPUState *cs)
+{
+    if (bql_locked()) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_set_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+}
+
+/* ── Unified async arbitration (INTEG-051t; DADAO-12 §5, ADR-0045 D3) ──
+ * Every asynchronous source records its pending bit in the *target* cfx's
+ * cg5 rc5 (TIMER -> cfx_hart bit10, PMEM_DMA -> cfx_pmem bit8); cfx_hart is
+ * not a pending store and no cross-cfx bitmap exists.  This arbiter only
+ * selects: the two-level masks stay in cfx_enter (step 3), whose `entered`
+ * result says whether the pending bit was consumed or
+ * must stay for a later kick.  At most one cfx_enter(async) per call. */
+
+/* Sources in target-cfxha order: the lowest deliverable cfxha wins. */
+static const struct dadao_async_source {
+    int cfxha;
+    uint64_t cause;
+} dadao_async_sources[] = {
+    { DADAO_CFXHA_HART, DADAO_CAUSE_TIMER },       /* 15 */
+    { DADAO_CFXHA_PMEM, DADAO_CAUSE_PMEM_DMA },    /* 32 */
+};
+
+/* Lowest target cfxha whose pending bit is set and may be delivered.  The
+ * masks are deliberately not evaluated here (cfx_enter is the only authority);
+ * only the source-local TIMER IMASK gate applies.  -1 when nothing is pending. */
+static int dadao_async_lowest(CPUDADAOState *env)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(dadao_async_sources); i++) {
+        int cfxha = dadao_async_sources[i].cfxha;
+        int ci = cfx_idx(env, cfxha);
+
+        if (ci < 0 || !(env->cfx[ci].pending & dadao_async_sources[i].cause)) {
+            continue;
+        }
+        if (cfxha == DADAO_CFXHA_HART &&
+            (env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+            continue;
+        }
+        return cfxha;
+    }
+    return -1;
+}
+
+/* Re-raise CPU_INTERRUPT_HARD when a source is still pending.  Called from
+ * every point that can unblock one (mask/pending writes, escape, a new source
+ * event); never spins, because exec_interrupt clears HARD on every call. */
+static void dadao_async_kick(CPUDADAOState *env)
+{
+    if (dadao_async_lowest(env) >= 0) {
+        dadao_hart_notify(env_cpu(env));
+    }
+}
+
+/* Deliver at most one pending source; true iff one cfx_enter(async) ran. */
+bool dadao_async_arbitrate(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(dadao_async_sources); i++) {
+        int cfxha = dadao_async_sources[i].cfxha;
+        uint64_t cause = dadao_async_sources[i].cause;
+        uint8_t entry_mode = env->inner_run_mode;
+        uint64_t info;
+        uint64_t vec;
+        int ci = cfx_idx(env, cfxha);
+        bool entered = false;
+
+        if (ci < 0 || !(env->cfx[ci].pending & cause)) {
+            continue;                   /* this source has no event */
+        }
+        if (cfxha == DADAO_CFXHA_HART &&
+            (env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+            continue;                   /* source-local gate */
+        }
+        /* TIMER has cause_info = 0; PMEM_DMA carries the dma_status at the
+         * moment of delivery (050 convention). */
+        info = (cfxha == DADAO_CFXHA_HART) ? 0 : env->pmem_dma_status;
+        vec = cfx_enter(env, cause, cfxha, env->pc, info, false, &entered);
+        if (!entered) {
+            /* Masked by step 3/4/5: cfx_enter kept the pending bit; the next
+             * source must not be held back by this one. */
+            continue;
+        }
+        env->cfx[ci].pending &= ~cause;  /* consumed: one event, one delivery */
+        env->pc = vec;
+        env->rb[0] = vec;
+        cfx_frame_block_async(env, ci, entry_mode);
+        return true;                     /* single layer: one source per call */
+    }
+    return false;
+}
+
+static void dadao_hart_timer_expire(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        return;
+    }
+    if (dadao_time_value(env) < env->hart_timer_cmp) {
+        return;                         /* re-armed after the callback fired */
+    }
+    /* The expiry is an event: record it in the target cfx's pending bit
+     * (cfx_hart cg5 rc5 bit10, the single record) and let the arbiter deliver.
+     * IMASK is the source-local delivery gate, so a masked expiry only records
+     * and waits for the ctrl write that releases it. */
+    if (ci >= 0) {
+        env->cfx[ci].pending |= DADAO_CAUSE_TIMER;
+    }
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+        dadao_async_kick(env);
+    }
+}
+
+static void dadao_hart_timer_arm(CPUDADAOState *env, CPUState *cs)
+{
+    uint64_t now;
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        timer_del(env->hart_timer);
+        return;
+    }
+    now = dadao_time_value(env);
+    if (now >= env->hart_timer_cmp) {
+        timer_del(env->hart_timer);
+        dadao_hart_timer_expire(cs);
+        return;
+    }
+    /* QEMU_CLOCK_VIRTUAL deadline in ns: epoch + absolute cfx_time value
+     * (1 count = 1 ns on the test machine). */
+    timer_mod(env->hart_timer,
+              (int64_t)(env->time_base_ns + env->hart_timer_cmp));
+}
+
+static void dadao_hart_timer_cb(void *opaque)
+{
+    dadao_hart_timer_expire((CPUState *)opaque);
+}
+
+void dadao_hart_timer_init(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->hart_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                   dadao_hart_timer_cb, cs);
+}
+
+void dadao_hart_timer_reset(CPUDADAOState *env)
+{
+    if (env->hart_timer) {
+        timer_del(env->hart_timer);
+    }
+    env->time_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    env->hart_insn = 0;
+    env->hart_timer_cmp = 0;
+    env->hart_timer_ctrl = 0;
+}
+
+#endif /* !CONFIG_USER_ONLY */
+
+static bool dadao_hart_reg_write(CPUDADAOState *env, uint32_t rc, uint64_t val)
+{
+    switch (rc) {
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+            /* A new compare value cancels the old deadline and this match. */
+            env->hart_timer_cmp = val;
+            if (ci >= 0) {
+                env->cfx[ci].pending &= ~DADAO_CAUSE_TIMER;
+            }
+            timer_del(env->hart_timer);
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    case 5:                             /* cg8 rc5: ENABLE/IMASK (bit2 RO) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+            env->hart_timer_ctrl = (uint8_t)(val & (DADAO_HART_TIMER_ENABLE |
+                                                    DADAO_HART_TIMER_IMASK));
+            /* Releasing IMASK while ISTATUS=1 keeps the recorded pending bit
+             * (re-setting it if software cleared it) and re-kicks, so the
+             * arbiter performs the delivery (050 "release delivers" semantics). */
+            if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK) &&
+                dadao_hart_istatus(env)) {
+                if (ci >= 0) {
+                    env->cfx[ci].pending |= DADAO_CAUSE_TIMER;
+                }
+                dadao_async_kick(env);
+            }
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    default:                            /* rc2/rc3 are RO; rc0/1/6/7 reserved */
+        return false;
+    }
+}
+
+/* trap cfxha, immu18 : general trap (not the semihosting tag) -> §5 flow.
+ * Semihosting (immu18[17:8] == 0x3FF, i.e. 0x3FF00-0x3FFFF) is handled by the
+ * decode-layer short-circuit (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST,
+ * QEMU-046t/ADR-0038 D4) and therefore never reaches this helper; the tag
+ * check below is a defensive explicit failure only. */
+void helper_cfx_trap(CPUDADAOState *env, uint32_t cfxha, uint32_t immu18,
+                     uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7F << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(immu18 & 0x3FFFF);
+    uint64_t cause;
+    int target;
+    int ci;
+
+    if (immu18 >= 0x3FF00) {
+        /* Semihosting tag (immu18[17:8] == 0x3FF, ADR-0038 D1): short-circuited
+         * at the decode layer (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST) and
+         * must never reach this general-trap helper.  Fail explicitly (ILLI)
+         * if it does, rather than silently entering a cfx vector. */
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* Allocated but not implemented by this profile: Tiny maps a general
+         * trap there to ILLI (spec/Machine-v5 §3 Tiny bullet), Vast keeps the
+         * register-access rule CFXREG.  Either way the target is the current
+         * run-mode monitor. */
+        cfx_raise(env, DADAO_PROFILE(env)->unimpl_cfx_trap_illi
+                       ? DADAO_CAUSE_ILLI : DADAO_CAUSE_CFXREG,
+                  env->inner_run_mode, pc, info);
+        return;
+    }
+    /* cfxtrap permission: target's source mask, self bypasses the cfx axis
+     * but still uses the current-mode row (ADR-0045 D1/D2). */
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_TRAP)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    target = cfxha;
+    cause = DADAO_CAUSE_CFXTRAP;
+
+    {
+        uint8_t entry_mode = env->inner_run_mode;
+        bool entered;
+        uint64_t vec = cfx_enter(env, cause, target, pc, info, true, &entered);
+
+        env->pc = entered ? vec : pc + 4;
+        env->rb[0] = env->pc;
+        if (entered && env->inner_cfx_code == cfxha) {
+            cfx_frame_block_async(env, ci, entry_mode);
+        }
+    }
+}
+
+/* escape cfxha, imms18 : §5 exception-exit flow (steps 0-4).  D8: cfxha is the
+ * current cfx; the return target/mode/IP come from the current frame.  A
+ * different target or an invalid frame is CFXESC (current cfx), and no state is
+ * switched before the error is raised. */
+void helper_cfx_escape(CPUDADAOState *env, uint32_t cfxha, uint32_t imms18,
+                       uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7E << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(imms18 & 0x3FFFF);
+
+    /* imms18[17:1] is SBZ: the legal escape offset set is {0, +4}.  Raise
+     * before the reserved-cfxha/CFXESC checks and before any state switch,
+     * on the same pc/info path as reserved-cfxha ILLI. */
+    if (imms18 & ~0x1u) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    int ci = cfx_idx(env, env->inner_cfx_code);
+    int32_t imm = (int32_t)(imms18 & 0x3FFFF);
+
+    if (imm & (1 << 17)) {
+        imm |= ~0x1FFFF;    /* sign-extend from 18 bits */
+    }
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    /* CFXESC: target error (cfxha must be the current cfx) or no frame. */
+    if (ci < 0 || cfxha != env->inner_cfx_code || env->cfx[ci].cause_id == 0) {
+        cfx_raise(env, DADAO_CAUSE_CFXESC, env->inner_cfx_code, pc, info);
+        return;
+    }
+
+    /* step 1: restore the global_cfx_intr_mask saved by a `trap` entry (D9).
+     * A synchronous exception (no trap) saved nothing, so a plain
+     * fault -> escape round trip must not clobber the monitor's mask. */
+    if (env->cfx[ci].saved_intr_mask_valid) {
+        env->cfx[env->cfx[ci].saved_intr_monitor & 0x3].global_cfx_intr_mask =
+            env->cfx[ci].saved_global_intr_mask;
+        env->cfx[ci].saved_intr_mask_valid = false;
+    }
+#ifndef CONFIG_USER_ONLY
+    /* The live frame blocked every async source; once the mask is back,
+     * re-kick so the arbiter can deliver what accumulated meanwhile. */
+    dadao_async_kick(env);
+#endif
+    /* step 2: restore the previous run mode from the frame (no cfx-mask
+     * layer is restored; the trap saved only global_cfx_intr_mask). */
+    env->inner_run_mode = env->cfx[ci].prev_run_mode & 0x3;
+    dadao_soft_tlb_flush(env);
+    /* step 3: increment the escape counter */
+    env->cfx[ci].escape_num++;
+    /* step 4: return address = cause_ip + (imms18 << 2); the offset is a
+     * compile-time immediate, not an arbitrary target. */
+    {
+        uint64_t ret = env->cfx[ci].cause_ip + ((int64_t)imm << 2);
+        env->pc = ret;
+        env->rb[0] = ret;
+    }
+}
+
+/* cfx2rd cfxha, cghb, rchc, rdhd */
+void helper_cfx2rd(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7A << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* No register file row for a cfx this profile does not implement
+         * (spec/Machine-v5 §3) => CFXREG in the current run-mode monitor.
+         * A reserved cfxha already took the ILLI path above (DADAO-12
+         * §5.2(一)). */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v;
+
+        if (!dadao_pmem_dma_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        uint64_t v;
+
+        if (!dadao_time_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_hart cg8 (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v;
+
+        if (!dadao_hart_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 internal space description
+                                          * (read-only, DADAO-12 §3.8) */
+        if (rd != 0) {
+            env->rd[rd] = dadao_cg7_space_reg(DADAO_PROFILE(env), cfxha, rc);
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, false);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (rd != 0) {
+        env->rd[rd] = *p;
+    }
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
+
+/* cfx2rc cfxha, cghb, rchc, rdhd */
+void helper_cfx2rc(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7B << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* No register file row for a cfx this profile does not implement
+         * (spec/Machine-v5 §3) => CFXREG in the current run-mode monitor.
+         * A reserved cfxha already took the ILLI path above (DADAO-12
+         * §5.2(一)). */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_pmem_dma_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 is RO (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    /* cfx_hart cg8: only rc4/rc5 accept writes (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_hart_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 is read-only: any rc write
+                                          * => CFXREG (DADAO-12 §3.8) */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, true);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (p == &env->ptbr) {
+        /* Single PTBR stores PPN[55:16]; [15:0] and [63:56] read as 0. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_PTBR_MASK;
+        /* Writing PTBR does not invalidate guest TLB entries (DADAO-12 §2.2,
+         * ADR-0041 D5); only QEMU's derived translation cache is dropped so
+         * that the guest TLB stays the single authority on hits/misses. */
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->ptw_enable) {
+        /* 1-bit enable (DADAO-12 §4.5). */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 1;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_asid) {
+        /* 16-bit ASID; switching it never invalidates guest TLB entries. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 0xFFFFULL;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_start) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_size) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_control) {
+        /* TLB command: executed synchronously on write (DADAO-12 §4.5). */
+        uint64_t val = (rd == 0) ? 0 : env->rd[rd];
+        hwaddr err_pa = 0;
+        int ret = dadao_tlb_control_exec(env, val, &err_pa);
+
+        if (ret == DADAO_TLB_CMD_CFXREG) {
+            /* Illegal scope / range with size 0 => CFXREG (ADR-0041 D6). */
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (ret == DADAO_TLB_CMD_AD_WB_FAIL) {
+            /* A/D write-back failed: monitor CFXMEM, entry kept (ADR-0041 D7/D10).
+             * Precise: the cfx2rc instruction did not complete. */
+            CPUState *cs = env_cpu(env);
+
+            env->pc = pc;
+            env->rb[0] = pc;
+            env->ptw_fault_cause = DADAO_CAUSE_CFXMEM;
+            env->ptw_fault_info = err_pa;
+            cs->exception_index = DADAO_EXCP_PTW_FAULT;
+            cpu_loop_exit_restore(cs, GETPC());
+            /* not reached */
+            return;
+        }
+        /* CLEAN keeps entries (mappings unchanged); INVALID/FLUSH drop them,
+         * so QEMU's derived translation cache must be dropped with them. */
+        if (val & 0x2) {
+            dadao_soft_tlb_flush(env);
+        }
+    } else if (cg == 3 && rc == 12) {
+        /* bit3 is hardware-fixed 1 (DADAO-13 §1): a software 0 is ignored and
+         * the register reads back with bit3 set. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) | (1ULL << 3);
+    } else if (rc == 10) {
+        /* DADAO-13 §1 (cg3 rc10; the same field exists in cg0-cg2): a write
+         * ignores the low 2 bits (value[1:0] <- 0, 4-byte aligned), no
+         * exception; reads return the stored value. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & ~0x3ULL;
+        dadao_soft_tlb_flush(env);
+    } else if (rc == 8 && DADAO_PROFILE(env)->switch_run_mode_write_ignored) {
+        /* Machine-v5-Tiny §2: the write is ignored; the register keeps its
+         * saved value (3 = hypv) and a read returns that saved value.  The
+         * exception-entry path forces hypv independently. */
+    } else {
+        *p = (rd == 0) ? 0 : env->rd[rd];
+        /* Any cfx2rc write may change a two-axis permission mask (cfxtrap/
+         * cfxmem/cfxreg/cfxexe/cfx_intr_mask/global_cfx_intr_mask); drop the
+         * derived translation cache so the next access re-checks. */
+        dadao_soft_tlb_flush(env);
+    }
+#ifndef CONFIG_USER_ONLY
+    /* A write to a mask / pending register may unblock a
+     * pending async source; re-kick here so the generic write path covers
+     * every such register (INTEG-051t). */
+    dadao_async_kick(env);
+#endif
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
