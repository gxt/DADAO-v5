+/*
+ * raise_exception helper: raise a DADAO exception.
+ * env is the implicit first argument passed by TCG.
+ * excp is the DADAO exception index.
+ */
+void helper_raise_exception(CPUDADAOState *env, uint32_t excp)
+{
+    CPUState *cs = env_cpu(env);
+
+    cs->exception_index = excp;
+    cpu_loop_exit_restore(cs, GETPC());
+}
+
+/* ── Ring-buffer RA access helpers (ADR-0012 D7) ──────────────────── */
+
+/* Compute physical index for logical RA register n (1..63).
+ * ra0 is always at physical 0 (metadata). */
+static inline int ra_phys(CPUDADAOState *env, int n)
+{
+    if (n == 0) return 0;
+    int r = (env->ras_base + n) % 63;
+    if (r < 0) r += 63;
+    return 1 + r;
+}
+
+/* Store val into ra[logical_n] (ring-buffer view). */
+void helper_ra_store(CPUDADAOState *env, uint64_t logical_idx, uint64_t val)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    env->ra[phys] = val;
+}
+
+/* Load from ra[logical_n] (ring-buffer view). */
+uint64_t helper_ra_load(CPUDADAOState *env, uint64_t logical_idx)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    return env->ra[phys];
+}
+
+/* ── RAS push (ADR-0012 D7 §3) ───────────────────────────────────── */
+void helper_ras_push(CPUDADAOState *env, uint64_t ret_addr)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    /* Read stack top (logical 63) */
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    ret_addr &= 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt == 0) {
+        /* C1: empty stack → push, RACNT = 1 */
+        env->ra[top_phys] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | (1ULL << 48);
+        return;
+    }
+
+    if (ret_addr == top_lo && top_hi < 0xFFFF) {
+        /* C2: recursive fold */
+        env->ra[top_phys] = ((uint64_t)(top_hi + 1) << 48) | top_lo;
+        return;
+    }
+
+    if (racnt < 63) {
+        /* C3a: advance ras_base, push new entry, RACNT++ */
+        env->ras_base = (env->ras_base + 1) % 63;
+        int new_top = ra_phys(env, 63);
+        env->ra[new_top] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt + 1) << 48);
+        return;
+    }
+
+    /* C3b: RACNT == 63, overflow path */
+    if (mrptr == 0) {
+        /* RASOF: precise — no side effects */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASOF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Spill bottom to MemRAS */
+    int bottom_phys = ra_phys(env, 1); /* logical 1 = 64-63 */
+    uint64_t bottom_val = env->ra[bottom_phys];
+    uint64_t new_mrptr = mrptr - 8;
+    /* Write to MemRAS (guest memory, big-endian) */
+    cpu_stq_be_data_ra(env, new_mrptr, bottom_val, GETPC());
+
+    /* Advance ras_base, write new entry */
+    env->ras_base = (env->ras_base + 1) % 63;
+    int new_top = ra_phys(env, 63);
+    env->ra[new_top] = (1ULL << 48) | ret_addr;
+
+    /* Update ra0: new MRPTR, RACNT stays 63 */
+    env->ra[0] = (ra0 & 0x003F000000000000ULL) | (new_mrptr & 0x0000FFFFFFFFFFFFULL);
+}
+
+/* ── RAS pop (ADR-0012 D7 §4) ────────────────────────────────────── */
+/* Pop return address from RAS. Result stored in env->ras_tmp. */
+void helper_ras_pop(CPUDADAOState *env)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt > 0) {
+        if (top_hi == 0) {
+            /* D1: RASUF — precise, no side effects */
+            CPUState *cs = env_cpu(env);
+            cs->exception_index = DADAO_EXCP_RASUF;
+            cpu_loop_exit_restore(cs, GETPC());
+            return;
+        }
+
+        if (top_hi > 1) {
+            /* D2: decrement recursive count */
+            env->ra[top_phys] = ((uint64_t)(top_hi - 1) << 48) | top_lo;
+            env->ras_tmp = top_lo;
+            return;
+        }
+
+        /* D3: top_hi == 1 → pop, rotate ras_base backward */
+        env->ras_tmp = top_lo;
+        env->ras_base = (env->ras_base + 62) % 63;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt - 1) << 48);
+        return;
+    }
+
+    /* D4: RACNT == 0 */
+    if (mrptr == 0) {
+        /* D4a: RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* D4b: read from MemRAS */
+    uint64_t mem_val = cpu_ldq_be_data_ra(env, mrptr, GETPC());
+    uint16_t mem_hi = (uint16_t)(mem_val >> 48);
+    uint64_t mem_lo = mem_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 0) {
+        /* Invalid entry → RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Commit: MRPTR += 8 */
+    env->ra[0] = (mrptr + 8) & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 1) {
+        /* D4b count==1: return address, RACNT stays 0 */
+        env->ras_tmp = mem_lo;
+        return;
+    }
+
+    /* D4b count>1: decrement, push to RegRAS, RACNT=1 */
+    int top_phys2 = ra_phys(env, 63);
+    env->ra[top_phys2] = ((uint64_t)(mem_hi - 1) << 48) | mem_lo;
+    env->ra[0] = (env->ra[0] & ~0x003F000000000000ULL) | (1ULL << 48);
+    env->ras_tmp = mem_lo;
+}
+
+/* ── FP softfloat conversion family (QEMU-036t) ──────────────────────── */
+/*
+ * First use of the upstream softfloat in the DADAO target.  A local
+ * float_status is built from the FCSR on every call (no CPUArchState field
+ * is added): the rf0[33:32] rounding mode is mapped to a softfloat round
+ * mode and accrued exception flags are merged back into rf0[4:0].
+ *
+ * Sources:
+ *   spec/SimRISC-07 §格式转换指令
+ *   .tao/contracts/contract-fp.md §1/§2/§3/§4
+ *   spec/SimRISC-00 §浮点状态寄存器
+ */
+
+/* rf0[33:32] → softfloat rounding mode:
+ *   00 RNE, 01 RTZ, 10 RDN, 11 RUP  (SimRISC-00 §浮点状态寄存器) */
+static FloatRoundMode rf0_round_mode(uint64_t rf0)
+{
+    switch ((rf0 >> 32) & 0x3) {
+    case 0:
+        return float_round_nearest_even;
+    case 1:
+        return float_round_to_zero;
+    case 2:
+        return float_round_down;
+    default:
+        return float_round_up;
+    }
+}
+
+/* Build a local softfloat status from the current FCSR value. */
+static void fp_status_init(CPUDADAOState *env, float_status *st)
+{
+    memset(st, 0, sizeof(*st));
+    set_float_rounding_mode(rf0_round_mode(env->rf[0]), st);
+    set_float_detect_tininess(float_tininess_after_rounding, st);
+    /* Default generated qNaN = the FCSR qNaN(ft)/qNaN(fo) pattern (mantissa
+     * MSB set, rest zero ⇒ 0x7FC00000 / 0x7FF8000000000000).  memset() alone
+     * leaves default_nan_pattern == 0, which parts64_default_nan() rejects
+     * (the invalid-operation results of add/sub/mul/div/rem/scalb/sqrt would
+     * otherwise be malformed or abort the assert). */
+    set_float_default_nan_pattern(0b01000000, st);
+    /* 2-NaN propagation rule.  Which input NaN is propagated when both
+     * operands are NaN is implementation-defined: IEEE 754-2019 §6.2.3 only
+     * *recommends* the sNaN-first s_ab order, and SimRISC-07/contract-fp.md
+     * require merely "符合 IEEE 754" (payload selection is not specified).
+     * We match the current host (x86_64 scalar SSE, -mfpmath=sse): for
+     * +,-,*,/ with qNaN/sNaN operand pairs in both orders the host returns
+     * the FIRST operand's NaN (quieted if signalling) regardless of sNaN vs
+     * qNaN — i.e. float_2nan_prop_ab.  Without a rule here softfloat aborts
+     * (parts64_pick_nan g_assert_not_reached) as soon as any NaN operand
+     * reaches add/sub/mul/div/rem (ISS-195). */
+    set_float_2nan_prop_rule(float_2nan_prop_ab, st);
+}
+
+/* Merge the softfloat exception flags into the accrued FCSR status bits.
+ * softfloat's NV/DZ/OF/UF/NX occupy the low 5 bits, bit-for-bit identical to
+ * rf0[4:0], so the merge is a masked OR. */
+static void fp_status_commit(CPUDADAOState *env, float_status *st)
+{
+    env->rf[0] |= (uint64_t)(get_float_exception_flags(st) & 0x1F);
+}
+
+/* Only the IEEE invalid (NV) flag is propagated for float→int conversions.
+ * Per contract-fp.md §16 the spec does not say whether precision loss also
+ * raises NX, so we do not invent one: only the saturation/NV behaviour is
+ * observable. */
+static void fp_status_commit_nv_only(CPUDADAOState *env, float_status *st)
+{
+    env->rf[0] |= (uint64_t)(get_float_exception_flags(st) & float_flag_invalid);
+}
+
+/* convert_ff (float→float):
+ *   kind 0 ft2fo (widening, exact)
+ *   kind 1 fo2ft (narrowing, rf0 rounding mode; result zero-extended to 64b)
+ * ft is held in the low 32 bits of the rf register. */
+uint64_t helper_fp_cvt_ff(CPUDADAOState *env, uint64_t src, uint32_t kind)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    if (kind == 0) {
+        res = (uint64_t)float32_to_float64((float32)src, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float64_to_float32((float64)src, &st);
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* convert_f2i (float→int): saturating, round-toward-zero, NV on NaN/Inf/
+ * out-of-range (spec §格式转换指令).  The 32-bit results are sign- or
+ * zero-extended to the 64-bit rd width following the SimRISC convention.
+ *
+ * kind: 0 ft2it, 1 ft2io, 2 ft2ut, 3 ft2uo,
+ *       4 fo2it, 5 fo2io, 6 fo2ut, 7 fo2uo */
+uint64_t helper_fp_cvt_f2i(CPUDADAOState *env, uint64_t src, uint32_t kind)
+{
+    float_status st;
+    uint64_t res;
+    float32 f32 = (float32)src;
+    float64 f64 = (float64)src;
+
+    fp_status_init(env, &st);
+    switch (kind) {
+    case 0:  /* ft2it */
+        res = (uint64_t)(int64_t)float32_to_int32_round_to_zero(f32, &st);
+        break;
+    case 1:  /* ft2io */
+        res = (uint64_t)float32_to_int64_round_to_zero(f32, &st);
+        break;
+    case 2:  /* ft2ut */
+        res = (uint64_t)(uint32_t)float32_to_uint32_round_to_zero(f32, &st);
+        break;
+    case 3:  /* ft2uo */
+        res = (uint64_t)float32_to_uint64_round_to_zero(f32, &st);
+        break;
+    case 4:  /* fo2it */
+        res = (uint64_t)(int64_t)float64_to_int32_round_to_zero(f64, &st);
+        break;
+    case 5:  /* fo2io */
+        res = (uint64_t)float64_to_int64_round_to_zero(f64, &st);
+        break;
+    case 6:  /* fo2ut */
+        res = (uint64_t)(uint32_t)float64_to_uint32_round_to_zero(f64, &st);
+        break;
+    default: /* fo2uo */
+        res = (uint64_t)float64_to_uint64_round_to_zero(f64, &st);
+        break;
+    }
+    fp_status_commit_nv_only(env, &st);
+    return res;
+}
+
+/* convert_i2f (int→float): rf0 rounding mode, IEEE flags (may be inexact).
+ * 32-bit source integers live in the low 32 bits of rd and are sign- or
+ * zero-extended according to signedness; ft results are zero-extended to 64b.
+ *
+ * kind: 0 it2ft, 1 io2ft, 2 ut2ft, 3 uo2ft,
+ *       4 it2fo, 5 io2fo, 6 ut2fo, 7 uo2fo */
+uint64_t helper_fp_cvt_i2f(CPUDADAOState *env, uint64_t src, uint32_t kind)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    switch (kind) {
+    case 0:  /* it2ft: int32 (sign-extend low 32) */
+        res = (uint64_t)(uint32_t)int32_to_float32((int32_t)(uint32_t)src, &st);
+        break;
+    case 1:  /* io2ft: int64 */
+        res = (uint64_t)(uint32_t)int64_to_float32((int64_t)src, &st);
+        break;
+    case 2:  /* ut2ft: uint32 */
+        res = (uint64_t)(uint32_t)uint32_to_float32((uint32_t)src, &st);
+        break;
+    case 3:  /* uo2ft: uint64 */
+        res = (uint64_t)(uint32_t)uint64_to_float32(src, &st);
+        break;
+    case 4:  /* it2fo */
+        res = (uint64_t)int32_to_float64((int32_t)(uint32_t)src, &st);
+        break;
+    case 5:  /* io2fo */
+        res = (uint64_t)int64_to_float64((int64_t)src, &st);
+        break;
+    case 6:  /* ut2fo */
+        res = (uint64_t)uint32_to_float64((uint32_t)src, &st);
+        break;
+    default: /* uo2fo */
+        res = (uint64_t)uint64_to_float64(src, &st);
+        break;
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ── FP softfloat arithmetic + root family (QEMU-037t) ───────────────── */
+/*
+ * S2D1 (addition/subtraction/multiplication/division/remainder/scaleB) and
+ * S1D1 (square root) reused from the upstream softfloat.
+ *
+ * Sources:
+ *   spec/SimRISC-07 §S2D1 / §S1D1
+ *   .tao/contracts/contract-fp.md §5/§6
+ *   spec/SimRISC-00 §浮点状态寄存器
+ *
+ * kind (helper_fp_arith): 0..5  = ft add/sub/mul/div/rem/scalb
+ *                         6..11 = fo add/sub/mul/div/rem/scalb
+ * The rf0 rounding mode and accrued flags are handled by fp_status_init() /
+ * fp_status_commit() exactly as for the conversion family.
+ */
+
+/* scaleB's second source is an integer-valued floating-point operand; the
+ * exponent n is its rounded integer value (spec §S2D1: "rfHD 取整数值").
+ * Softfloat's float-to-int conversion follows the same status rounding mode,
+ * so an inexact/exotic rfHD is reflected in the accrued flags. */
+uint64_t helper_fp_arith(CPUDADAOState *env, uint64_t a, uint64_t b,
+                         uint32_t kind)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    switch (kind) {
+    case 0:  /* ftadd */
+        res = (uint64_t)(uint32_t)float32_add((float32)a, (float32)b, &st);
+        break;
+    case 1:  /* ftsub */
+        res = (uint64_t)(uint32_t)float32_sub((float32)a, (float32)b, &st);
+        break;
+    case 2:  /* ftmul */
+        res = (uint64_t)(uint32_t)float32_mul((float32)a, (float32)b, &st);
+        break;
+    case 3:  /* ftdiv */
+        res = (uint64_t)(uint32_t)float32_div((float32)a, (float32)b, &st);
+        break;
+    case 4:  /* ftrem: IEEE 754 remainder (nearest quotient, ties to even) */
+        res = (uint64_t)(uint32_t)float32_rem((float32)a, (float32)b, &st);
+        break;
+    case 5:  /* ftsclb: rfHC * 2^rfHD */
+        res = (uint64_t)(uint32_t)float32_scalbn((float32)a,
+                                                 float32_to_int32((float32)b,
+                                                                  &st),
+                                                 &st);
+        break;
+    case 6:  /* foadd */
+        res = (uint64_t)float64_add((float64)a, (float64)b, &st);
+        break;
+    case 7:  /* fosub */
+        res = (uint64_t)float64_sub((float64)a, (float64)b, &st);
+        break;
+    case 8:  /* fomul */
+        res = (uint64_t)float64_mul((float64)a, (float64)b, &st);
+        break;
+    case 9:  /* fodiv */
+        res = (uint64_t)float64_div((float64)a, (float64)b, &st);
+        break;
+    case 10: /* forem */
+        res = (uint64_t)float64_rem((float64)a, (float64)b, &st);
+        break;
+    default: /* 11 fosclb */
+        res = (uint64_t)float64_scalbn((float64)a,
+                                       float64_to_int32((float64)b, &st),
+                                       &st);
+        break;
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* rootn(x, 2): the translate layer has already enforced n == 2 and selects
+ * the format via isdbl (0 = ft/float32, 1 = fo/float64). */
+uint64_t helper_fp_root(CPUDADAOState *env, uint64_t x, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    if (isdbl) {
+        res = (uint64_t)float64_sqrt((float64)x, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_sqrt((float32)x, &st);
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ── roundToIntegral 六档 (QEMU-072t) ────────────────────────────────── */
+/*
+ * ftrnd/fornd: immu6 is a one-hot *rounding code*, not a register count
+ * (SimRISC-07 §取整（roundToIntegral）, contract-fp.md §18):
+ *   0x01 ties-to-even / 0x02 ties-away / 0x04 toward-zero /
+ *   0x08 toward-+inf / 0x10 toward--inf  ⇒ static directions;
+ *   0x20 roundToIntegralExact ⇒ direction from rf0[33:32].
+ * The translate layer has already rejected every other immu6 value.
+ *
+ * Static directions must be independent of rf0[33:32] *and* must not accrue
+ * NX, so the call runs on a status copy with the static mode and only NV is
+ * merged back.  The dynamic code runs on the rf0-derived status and merges
+ * NV|NX (roundToIntegralExact semantics).
+ */
+static FloatRoundMode fp_round_code_mode(uint32_t code)
+{
+    switch (code) {
+    case 0x01:
+        return float_round_nearest_even;
+    case 0x02:
+        return float_round_ties_away;
+    case 0x04:
+        return float_round_to_zero;
+    case 0x08:
+        return float_round_up;
+    default:                    /* 0x10, enforced by the translate layer */
+        return float_round_down;
+    }
+}
+
+uint64_t helper_fp_round_to_int(CPUDADAOState *env, uint64_t x,
+                                uint32_t code, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    /* contract-fp.md §18: every NaN result is a qNaN and the contract fixes
+     * the canonical form (qNaN input ⇒ canonical qNaN; sNaN ⇒ NV + canonical
+     * qNaN), so request the FCSR default qNaN pattern for NaN results. */
+    set_default_nan_mode(1, &st);
+    if (code != 0x20) {
+        set_float_rounding_mode(fp_round_code_mode(code), &st);
+    }
+    if (isdbl) {
+        res = (uint64_t)float64_round_to_int((float64)x, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_round_to_int((float32)x, &st);
+    }
+    if (code == 0x20) {
+        env->rf[0] |= (uint64_t)(get_float_exception_flags(&st)
+                                 & (float_flag_invalid | float_flag_inexact));
+    } else {
+        env->rf[0] |= (uint64_t)(get_float_exception_flags(&st)
+                                 & float_flag_invalid);
+    }
+    return res;
+}
+
+/* minimumNumber/maximumNumber (QEMU-071t, IEEE 754-2019 §9.6 strict form).
+ *   source: spec/SimRISC-07 §2.4, contract-fp.md §19
+ * The whole boundary behaviour lives in upstream softfloat's
+ * float{32,64}_{min,maximum}_number(): ordered comparison with −0 < +0, the
+ * numeric operand for a single NaN (q or s), and NV for any sNaN input.
+ * Two NaNs go through pick_nan(); default-NaN mode turns that into the
+ * canonical qNaN required by the contract (sign 0, payload 0), independent of
+ * which input NaN softfloat would otherwise propagate.  No rounding takes
+ * place, so NX/OF/UF stay clear; fp_status_commit() merges NV as usual.
+ */
+uint64_t helper_fp_minmax(CPUDADAOState *env, uint64_t a, uint64_t b,
+                          uint32_t isdbl, uint32_t ismax)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    set_default_nan_mode(1, &st);
+    if (isdbl) {
+        res = (uint64_t)(ismax
+                         ? float64_maximum_number((float64)a, (float64)b, &st)
+                         : float64_minimum_number((float64)a, (float64)b, &st));
+    } else {
+        res = (uint64_t)(uint32_t)(ismax
+                         ? float32_maximum_number((float32)a, (float32)b, &st)
+                         : float32_minimum_number((float32)a, (float32)b, &st));
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* fusedMultiplyAdd (QEMU-070t, IEEE 754-2019 fusedMultiplyAdd).
+ *   source: spec/SimRISC-07 §融合乘加（fusedMultiplyAdd）,
+ *           contract-fp.md §20
+ * Single rounding is delegated to upstream softfloat's float{32,64}_muladd()
+ * with muladd flags 0 (no negation, no zero-product suppression) — the fused
+ * a*b+c operation, never a separate mul followed by an add.
+ * default-NaN mode canonicalizes every NaN result (contract §20); softfloat's
+ * default infzero-NaN rule keeps 0×Inf raising NV even when the addend is a
+ * NaN.  fp_status_commit() merges the flags once, so NX/OF/UF are raised at
+ * most once for the whole operation.
+ */
+uint64_t helper_fp_muladd(CPUDADAOState *env, uint64_t a, uint64_t b,
+                          uint64_t c, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    set_default_nan_mode(1, &st);
+    if (isdbl) {
+        res = (uint64_t)float64_muladd((float64)a, (float64)b, (float64)c,
+                                       0, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_muladd((float32)a, (float32)b,
+                                                 (float32)c, 0, &st);
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ===================================================================
+ * SEE/HEE run mode + cfx register file + exception flow (QEMU-044t)
+ *
+ * Sources (spec-first):
+ *   spec/DADAO-12-SEE-主管系统运行环境.md §1 (run modes / cfxha table),
+ *     §3 (cg0-cg7 shared registers), §4 (per-cfx registers / monitor exception
+ *     tables), §5 (exception entry steps 1-10 + exception exit).
+ *   spec/DADAO-13-HEE-超管系统运行环境.md §1 (cg3 / hypv reset values).
+ *   spec/SimRISC-11-其它.md §特权指令 (trap/escape/cfx2rd/cfx2rc; reserved =>
+ *     ILLI; non-existent register combination => CFXREG).
+ *   .tao/contracts/contract-see.md §1/§3/§4; spec/Machine-01-测试机运行环境.md.
+ *
+ * Test-machine scope (ADR-0020 D9, Machine-01 §3): only cfx0/1/2/3/63 are
+ * fully implemented, plus cfx4/ptw's Step 1 register subset (PTBR +
+ * ptw_enable, ADR-0039 §8.5), cfx17/pmem's SRAM+DMA (ADR-0042) and
+ * cfx15/cfx18 (single-hart timer + global time, INTEG-050t).  Access to any
+ * other allocated-but-unimplemented cfx => CFXREG.
+ * =================================================================== */
+
+const int dadao_cfxha_map[DADAO_NUM_CFX] = { 0, 1, 2, 3, 4, 15, 17, 18, 63 };
+
+/* cfxha -> compact index into env->cfx[], or -1 if not implemented here. */
+static int cfx_idx(int cfxha)
+{
+    int i;
+    for (i = 0; i < DADAO_NUM_CFX; i++) {
+        if (dadao_cfxha_map[i] == cfxha) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* cg0-cg3 shared per-mode register -> pointer (DADAO-12 §3; ADR-0045 D2/D3). */
+static uint64_t *cfx_mode_reg(int ci, DADAOCfxModeRegs *m, int rc)
+{
+    switch (rc) {
+    case 0:  return &m->cfxtrap;
+    case 1:  return &m->cfxmem;
+    case 2:  return &m->cfxreg;
+    case 3:  return &m->cfxexe;
+    case 4:  return &m->cfx_intr_mask;
+    case 8:  return &m->switch_run_mode;
+    case 9:  return &m->switch_cfx_mask;
+    case 10: return &m->excp_vector;
+    case 11: return &m->excp_cause_mask;
+    case 12: return (ci >= 0) ? &m->cg_reg_deleg : NULL;   /* cg3 only */
+    default: return NULL;
+    }
+}
+
+/*
+ * cg7 internal space description (DADAO-12 §3.8): 16 blocks of 4 words,
+ * rc = 4i+0..3 = desc / start / size / attr.  desc bit0 = exists, bits1-5 =
+ * SRAM/ROM/MMIO/DRAM/OTHER (one-hot when exists); attr bit0 = R, bit1 = W,
+ * bit2 = X, bit3 = cacheable, bit4 = shareable, bit5 = volatile.  The table is
+ * a compile-time constant: cg7 carries no per-cfx state and is read-only.
+ * Test-machine blocks (§2.1: smon/hmon/pmem 64 KiB SRAM, power 256 KiB
+ * BootROM); every other block (space[1..15] and cfx0/1/4/...) reads 0.
+ */
+static uint64_t dadao_cg7_space_reg(int cfxha, unsigned rc)
+{
+    static const uint64_t smon[4] = {
+        0x3,                    /* desc: exists | SRAM */
+        0x3FF00000000ULL,       /* start: 0x3ff_0000_0000 */
+        0x10000ULL,             /* size:  64 KiB */
+        0x7,                    /* attr: R | W | X */
+    };
+    static const uint64_t pmem[4] = {
+        0x3,                    /* desc: exists | SRAM */
+        0x3FF00000000ULL,       /* start: 0x3ff_0000_0000 */
+        0x10000ULL,             /* size:  64 KiB */
+        0x3,                    /* attr: R | W (X = 0) */
+    };
+    static const uint64_t power[4] = {
+        0x5,                    /* desc: exists | ROM */
+        0x3FFFFFC0000ULL,       /* start: 0x3ff_fffc_0000 */
+        0x40000ULL,             /* size:  256 KiB (start + size = 2^42) */
+        0x5,                    /* attr: R | X */
+    };
+    const uint64_t *blk;
+
+    if (rc / 4 != 0) {
+        return 0;               /* space[1..15]: exists = 0 => all fields 0 */
+    }
+    switch (cfxha) {
+    case 2:                     /* cfx_smon */
+    case 3:                     /* cfx_hmon */
+        blk = smon;
+        break;
+    case 17:                    /* cfx_pmem */
+        blk = pmem;
+        break;
+    case 63:                    /* cfx_power */
+        blk = power;
+        break;
+    default:
+        return 0;               /* umon/jmon/ptw: 16 blocks all empty */
+    }
+    return blk[rc % 4];
+}
+
+/*
+ * Resolve (cfxha, cg, rc) to a register pointer.  Returns NULL for any
+ * non-existent register combination or a read/write permission mismatch
+ * (DADAO-12 §3: rc >= scratch_regs_num => CFXREG; SimRISC-11 §特权指令:
+ * "读写权限不匹配时触发 CFXREG").  cg3 is only accessible in hypv
+ * (DADAO-13 §1).  cg7 is answered before this call from the static space
+ * table (DADAO-12 §3.8).  Callers must handle reserved/unimplemented cfxha
+ * first.
+ */
+static uint64_t *cfx_reg_ptr(CPUDADAOState *env, int ci, int cg, int rc,
+                             bool write)
+{
+    DADAOCfxRegs *r = &env->cfx[ci];
+
+    if (cg <= 2) {
+        if (rc <= 4 || (rc >= 8 && rc <= 11)) {
+            return cfx_mode_reg(ci, &r->mode[cg], rc);
+        }
+        return NULL;
+    }
+    if (cg == 3) {
+        if (env->inner_run_mode != DADAO_MODE_HYPV) {
+            return NULL;   /* cg3 only in hypv (DADAO-13 §1) => CFXREG */
+        }
+        if ((rc <= 4) || (rc >= 8 && rc <= 12)) {
+            return cfx_mode_reg(ci, &r->mode[3], rc);
+        }
+        return NULL;
+    }
+    switch (cg) {
+    case 4:
+        switch (rc) {
+        case 0: return write ? NULL : &r->cfx_id;
+        case 1: return write ? NULL : &r->version;
+        case 2: return write ? NULL : &r->trap_num;
+        case 3: return write ? NULL : &r->excp_sync_num;
+        case 4: return write ? NULL : &r->excp_async_num;
+        case 5: return write ? NULL : &r->escape_num;
+        case 6: return write ? NULL : &r->scratch_regs_num;
+        default: return NULL;
+        }
+    case 5:
+        switch (rc) {
+        case 0: return &r->prev_run_mode;
+        case 1: return &r->prev_cfx_mask;
+        case 2: return write ? NULL : &r->cause_id;
+        case 3: return &r->cause_ip;
+        case 4: return write ? NULL : &r->cause_info;
+        case 5: return &r->pending;
+        case 63: return write ? NULL : &r->cause_nonmaskable;
+        default: return NULL;
+        }
+    case 6:
+        if ((uint64_t)rc >= r->scratch_regs_num) {
+            return NULL;   /* rc >= N => CFXREG (DADAO-12 §3) */
+        }
+        return &r->scratch[rc];
+    case 8:
+        /* cfx0-3: global_cfx_intr_mask (cg8 rc1; ADR-0045 D3). */
+        if (ci >= 0 && dadao_cfxha_map[ci] < 4 && rc == 1) {
+            return &r->global_cfx_intr_mask;
+        }
+        /* cfx_ptw only: Step 1 PTW enable (DADAO-12 §4.5). */
+        return (ci >= 0 && dadao_cfxha_map[ci] == 4 && rc == 8)
+               ? &env->ptw_enable : NULL;
+    case 9:
+        /* cfx_ptw only: the single PTBR (DADAO-12 §4.5). */
+        return (ci >= 0 && dadao_cfxha_map[ci] == 4 && rc == 0)
+               ? &env->ptbr : NULL;
+    case 12:
+        /* cfx_ptw only: TLB maintenance interface (DADAO-12 §4.5;
+         * ADR-0041 D3).  rc0 is a write-only command trigger. */
+        if (ci < 0 || dadao_cfxha_map[ci] != DADAO_CFXHA_PTW) {
+            return NULL;
+        }
+#ifdef CONFIG_USER_ONLY
+        /* No PTW/TLB in the user-mode build: explicit CFXREG, no stub. */
+        return NULL;
+#else
+        switch (rc) {
+        case 0: return write ? &env->tlb_control : NULL;
+        case 1: return &env->tlb_asid;      /* 16-bit ASID */
+        case 2: return &env->tlb_start;
+        case 3: return &env->tlb_size;
+        default: return NULL;
+        }
+#endif
+    default:
+        return NULL;
+    }
+}
+
+/*
+ * DADAO-12 §5 exception-entry flow (steps 1-10).  `target` is the initially
+ * determined target cfxha (from step 1); `sync` selects the sync/async
+ * masking behaviour.  Returns the exception vector to jump to; *entered is
+ * set to false when the exception is masked and only records `pending`.
+ *
+ * Deviation note (documented): spec §5 step 3/4 "goto check_nonmaskable"
+ * after an ILLI redirect would re-apply the inner/global mask to the
+ * redirect target (the current-mode monitor) forever; hardware must terminate,
+ * so a single redirect is performed and the monitor (current-mode cfx0-3) is
+ * then entered without re-checking the inner/global mask.
+ */
+static uint64_t cfx_enter(CPUDADAOState *env, uint64_t cause, int target,
+                          uint64_t cause_ip, uint64_t cause_info,
+                          bool sync, bool *entered)
+{
+    uint8_t entry_mode = env->inner_run_mode;
+    bool redirected = false;
+    int ci;
+    uint64_t vec;
+
+    for (;;) {
+        ci = cfx_idx(target);
+        if (ci < 0) {
+            /* A frame can only exist for an implemented cfx. */
+            *entered = false;
+            return 0;
+        }
+        if (!redirected && !(env->cfx[ci].cause_nonmaskable & cause)) {
+            /* step 3: inner_cfx_mask (self cfxha is not checked) */
+            if (target != env->inner_cfx_code &&
+                (env->inner_cfx_mask & (1ULL << target))) {
+                if (sync) {
+                    cause = DADAO_CAUSE_ILLI;
+                    target = entry_mode;      /* redirect to current monitor */
+                    redirected = true;
+                    continue;
+                }
+                env->cfx[ci].pending |= cause;
+                *entered = false;
+                return 0;
+            }
+            /* step 4 (async only): two-level interrupt source filter
+             * (ADR-0045 D3).  The current cfx's cfx_intr_mask and the current
+             * mode monitor's global_cfx_intr_mask both mask by source cfxha;
+             * either one set => pending, no delivery. */
+            if (!sync) {
+                int cur = cfx_idx(env->inner_cfx_code);
+                uint64_t cur_mask = (cur >= 0)
+                    ? env->cfx[cur].mode[entry_mode].cfx_intr_mask : 0;
+                uint64_t global_mask =
+                    env->cfx[entry_mode & 0x3].global_cfx_intr_mask;
+
+                if ((cur_mask & (1ULL << target)) ||
+                    (global_mask & (1ULL << target))) {
+                    env->cfx[ci].pending |= cause;
+                    *entered = false;
+                    return 0;
+                }
+            }
+            /* step 5: exception-cause mask */
+            if (env->cfx[ci].mode[entry_mode].excp_cause_mask & cause) {
+                env->cfx[ci].pending |= cause;
+                *entered = false;
+                return 0;
+            }
+        }
+        break;
+    }
+
+    /* step 6: increment the trap / sync / async counter (keyed on the
+     * (possibly redirected) cause, per §5 step 6). */
+    if (cause == DADAO_CAUSE_CFXTRAP) {
+        env->cfx[ci].trap_num++;
+    } else if (!sync) {
+        env->cfx[ci].excp_async_num++;
+    } else {
+        env->cfx[ci].excp_sync_num++;
+    }
+    /* step 7: save the previous run mode / cfx mask */
+    env->cfx[ci].prev_run_mode = entry_mode;
+    env->cfx[ci].prev_cfx_mask = env->inner_cfx_mask;
+    /* step 8: switch run mode / cfx mask to the <entry_mode> switch values.
+     * HSJU permission is re-checked on every tlb_fill against the entry, so the
+     * derived translation cache must not survive a run-mode change: guest TLB
+     * entries stay (only QEMU's cache of their result is dropped). */
+    dadao_soft_tlb_flush(env);
+    vec = env->cfx[ci].mode[entry_mode].excp_vector;
+    env->inner_run_mode = env->cfx[ci].mode[entry_mode].switch_run_mode & 0x3;
+    env->inner_cfx_mask = env->cfx[ci].mode[entry_mode].switch_cfx_mask;
+    env->inner_cfx_code = (uint8_t)target;
+    /* step 9: record cause ip / id / info */
+    env->cfx[ci].cause_ip = cause_ip;
+    env->cfx[ci].cause_id = cause;
+    env->cfx[ci].cause_info = cause_info;
+    /* step 10: jump to the exception vector */
+    *entered = true;
+    return vec;
+}
+
+/* Enter the flow and set the next PC (vector on entry, pc+4 when masked). */
+static void cfx_raise(CPUDADAOState *env, uint64_t cause, int target,
+                      uint64_t pc, uint64_t cause_info)
+{
+    bool entered;
+    uint64_t vec = cfx_enter(env, cause, target, pc, cause_info, true, &entered);
+    env->pc = entered ? vec : pc + 4;
+    env->rb[0] = env->pc;
+}
+
+/* CFXPERM is delivered to the monitor of the current run mode (cfx0-3). */
+static void cfx_raise_perm(CPUDADAOState *env, uint64_t info, uint64_t pc)
+{
+    cfx_raise(env, DADAO_CAUSE_CFXPERM, env->inner_run_mode, pc, info);
+}
+
+/* D9: entering a frame saves the entry-mode monitor's global_cfx_intr_mask and
+ * blocks every async source while the single frame is live; escape restores
+ * it.  Shared by the sync trap path and the async arbiter so that both record
+ * the frame's saved mask and neither can deliver a second source inside it. */
+static void cfx_frame_block_async(CPUDADAOState *env, int ci, uint8_t entry_mode)
+{
+    int mon = entry_mode & 0x3;
+
+    env->cfx[ci].saved_global_intr_mask = env->cfx[mon].global_cfx_intr_mask;
+    env->cfx[ci].saved_intr_monitor = (uint8_t)mon;
+    env->cfx[mon].global_cfx_intr_mask = ~0ULL;
+}
+
+/* ===================================================================
+ * cfx_pmem SRAM + DMA (spec/DADAO-12 §2.1/§4.9; ADR-0042 D3/D4/D6/D7)
+ *
+ * The DMA moves at most 64 KiB between the cfx_pmem SRAM and physical memory.
+ * Registers are cfx_pmem cg15 rc0..rc4; START launches the transfer, which
+ * completes asynchronously on a virtual-clock timer so that BUSY is
+ * observable (the transfer itself is one memcpy).
+ * =================================================================== */
+#ifndef CONFIG_USER_ONLY
+
+/* Completion latency of the test-machine DMA (virtual clock). */
+#define DADAO_PMEM_DMA_DELAY_NS  1000000ULL   /* 1 ms */
+
+/* Re-raise CPU_INTERRUPT_HARD when a source is still pending; defined with the
+ * arbitration block next to the cfx_hart timer section below.  The DMA
+ * completion runs before that definition, hence the forward declaration. */
+static void dadao_async_kick(CPUDADAOState *env);
+
+static bool dadao_pmem_dma_pa_ok(uint64_t pa, uint64_t len, bool write)
+{
+    uint64_t end = pa + len;
+
+    if (pa >= DADAO_RAM_BASE && end <= DADAO_RAM_BASE + DADAO_RAM_SIZE) {
+        return true;
+    }
+    /* PA 0 aliases the same 16 MiB RAM (ADR-0043 D10): the first page table
+     * lives at PA 0 (PTBR=0), so DMA must reach it there as well. */
+    if (pa >= DADAO_RAM_ALIAS_BASE &&
+        end <= DADAO_RAM_ALIAS_BASE + DADAO_RAM_SIZE) {
+        return true;
+    }
+    /* The boot ROM is readable, never writable. */
+    if (!write && pa >= DADAO_ROM_BASE && end <= DADAO_ROM_BASE + DADAO_ROM_SIZE) {
+        return true;
+    }
+    return false;
+}
+
+static void dadao_pmem_dma_complete(void *opaque)
+{
+    CPUState *cs = opaque;
+    CPUDADAOState *env = cpu_env(cs);
+    g_autofree uint8_t *buf = NULL;
+    MemTxResult res;
+    bool dir = env->pmem_dma_dir;
+    uint64_t err = 0;
+
+    if (!(env->pmem_dma_status & DADAO_PMEM_DMA_BUSY)) {
+        return;                       /* defensive: no transfer in flight */
+    }
+
+    buf = g_malloc(env->pmem_dma_len);
+    if (dir == 0) {
+        /* CFX -> PA */
+        res = address_space_read(&address_space_memory,
+                                 DADAO_PMEM_SRAM_HOST_BASE + env->pmem_dma_cfx_off,
+                                 MEMTXATTRS_UNSPECIFIED, buf, env->pmem_dma_len);
+        if (res == MEMTX_OK) {
+            res = address_space_write(&address_space_memory, env->pmem_dma_pa,
+                                      MEMTXATTRS_UNSPECIFIED, buf,
+                                      env->pmem_dma_len);
+        }
+    } else {
+        /* PA -> CFX */
+        res = address_space_read(&address_space_memory, env->pmem_dma_pa,
+                                 MEMTXATTRS_UNSPECIFIED, buf, env->pmem_dma_len);
+        if (res == MEMTX_OK) {
+            res = address_space_write(&address_space_memory,
+                                      DADAO_PMEM_SRAM_HOST_BASE + env->pmem_dma_cfx_off,
+                                      MEMTXATTRS_UNSPECIFIED, buf,
+                                      env->pmem_dma_len);
+        }
+    }
+
+    env->pmem_dma_status &= ~DADAO_PMEM_DMA_BUSY;
+    if (res != MEMTX_OK) {
+        err = DADAO_PMEM_DMA_ERR_PA_FAULT;
+        env->pmem_dma_status |= DADAO_PMEM_DMA_ERROR |
+                                (err << DADAO_PMEM_DMA_ERR_CODE_SHIFT);
+    } else {
+        env->pmem_dma_status |= DADAO_PMEM_DMA_DONE;
+    }
+
+    if (env->pmem_dma_irq_en) {
+        /* The pending record is the target cfx's cg5 rc5 bit8 (INTEG-051t);
+         * the arbiter turns it into a delivery. */
+        int ci = cfx_idx(DADAO_CFXHA_PMEM);
+
+        if (ci >= 0) {
+            env->cfx[ci].pending |= DADAO_CAUSE_PMEM_DMA;
+        }
+        dadao_async_kick(env);
+    }
+}
+
+/*
+ * START (dma_ctrl bit0): validate size / SRAM range / PA range / PA target.
+ * Setup errors never start a transfer (BUSY stays 0) and set ERROR + ERR_CODE.
+ */
+static void dadao_pmem_dma_start(CPUDADAOState *env, uint64_t ctrl)
+{
+    uint64_t dir = (ctrl & DADAO_PMEM_DMA_CTRL_DIR) ? 1 : 0;
+    uint64_t cfx_addr = (dir ? env->pmem_dma_dst : env->pmem_dma_src) &
+                        DADAO_VA_MASK;
+    uint64_t pa = (dir ? env->pmem_dma_src : env->pmem_dma_dst) &
+                  0x00FFFFFFFFFFFFFFULL;              /* PA[55:0] */
+    uint64_t size = env->pmem_dma_size & 0x3FFFFFFFULL;  /* 30-bit field */
+    uint64_t err = 0;
+
+    if (size == 0 || size > (1ULL << 29)) {
+        err = DADAO_PMEM_DMA_ERR_SIZE;
+    } else if (size > DADAO_PMEM_SRAM_SIZE) {
+        err = DADAO_PMEM_DMA_ERR_CFX_RANGE;
+    } else if (cfx_addr < DADAO_PMEM_SRAM_CFX_OFFSET ||
+               cfx_addr - DADAO_PMEM_SRAM_CFX_OFFSET >
+                   DADAO_PMEM_SRAM_SIZE - size) {
+        err = DADAO_PMEM_DMA_ERR_CFX_RANGE;
+    } else if (size > (1ULL << 56) - pa) {
+        err = DADAO_PMEM_DMA_ERR_PA_RANGE;
+    } else if (!dadao_pmem_dma_pa_ok(pa, size, dir == 0)) {
+        err = DADAO_PMEM_DMA_ERR_PA_FAULT;
+    }
+
+    if (err) {
+        env->pmem_dma_status |= DADAO_PMEM_DMA_ERROR |
+                                (err << DADAO_PMEM_DMA_ERR_CODE_SHIFT);
+        if (env->pmem_dma_irq_en) {
+            int ci = cfx_idx(DADAO_CFXHA_PMEM);
+
+            if (ci >= 0) {
+                env->cfx[ci].pending |= DADAO_CAUSE_PMEM_DMA;
+            }
+            dadao_async_kick(env);
+        }
+        return;
+    }
+
+    env->pmem_dma_dir = dir;
+    env->pmem_dma_cfx_off = cfx_addr - DADAO_PMEM_SRAM_CFX_OFFSET;
+    env->pmem_dma_pa = pa;
+    env->pmem_dma_len = size;
+    env->pmem_dma_status |= DADAO_PMEM_DMA_BUSY;
+    timer_mod(env->pmem_dma_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + DADAO_PMEM_DMA_DELAY_NS);
+}
+
+/* cfx_pmem cg15 read (rc0..rc4).  Returns false for a reserved rc (CFXREG). */
+static bool dadao_pmem_dma_reg_read(CPUDADAOState *env, uint32_t rc,
+                                    uint64_t *val)
+{
+    switch (rc) {
+    case 0: *val = env->pmem_dma_src; return true;
+    case 1: *val = env->pmem_dma_dst; return true;
+    case 2: *val = env->pmem_dma_size & 0x3FFFFFFFULL; return true;
+    case 3: *val = env->pmem_dma_ctrl & ~DADAO_PMEM_DMA_CTRL_START; return true;
+    case 4: *val = env->pmem_dma_status; return true;
+    default: return false;
+    }
+}
+
+/*
+ * cfx_pmem cg15 write (rc0..rc4).  While BUSY, writes to rc0..rc3 and the
+ * DONE/ERROR W1C of rc4 are ignored (DADAO-12 §4.9).  Returns false for a
+ * reserved rc (CFXREG).
+ */
+static bool dadao_pmem_dma_reg_write(CPUDADAOState *env, uint32_t rc,
+                                     uint64_t val)
+{
+    bool busy = (env->pmem_dma_status & DADAO_PMEM_DMA_BUSY) != 0;
+
+    switch (rc) {
+    case 0:
+        if (!busy) {
+            env->pmem_dma_src = val;
+        }
+        return true;
+    case 1:
+        if (!busy) {
+            env->pmem_dma_dst = val;
+        }
+        return true;
+    case 2:
+        if (!busy) {
+            env->pmem_dma_size = val & 0x3FFFFFFFULL;
+        }
+        return true;
+    case 3:
+        if (busy) {
+            return true;
+        }
+        /* START self-clears; DIR/IRQ_EN read back what was written. */
+        env->pmem_dma_ctrl = val & (DADAO_PMEM_DMA_CTRL_DIR |
+                                    DADAO_PMEM_DMA_CTRL_IRQ_EN);
+        env->pmem_dma_irq_en = (val & DADAO_PMEM_DMA_CTRL_IRQ_EN) ? 1 : 0;
+        if (val & DADAO_PMEM_DMA_CTRL_START) {
+            dadao_pmem_dma_start(env, val);
+        }
+        return true;
+    case 4:
+        if (busy) {
+            return true;              /* W1C ignored while BUSY */
+        }
+        if (val & DADAO_PMEM_DMA_DONE) {
+            env->pmem_dma_status &= ~DADAO_PMEM_DMA_DONE;
+        }
+        if (val & DADAO_PMEM_DMA_ERROR) {
+            env->pmem_dma_status &= ~(DADAO_PMEM_DMA_ERROR |
+                                      DADAO_PMEM_DMA_ERR_CODE_MASK);
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+void dadao_pmem_dma_init(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->pmem_dma_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       dadao_pmem_dma_complete, cs);
+}
+
+void dadao_pmem_dma_reset(CPUDADAOState *env)
+{
+    if (env->pmem_dma_timer) {
+        timer_del(env->pmem_dma_timer);
+    }
+    env->pmem_dma_src = 0;
+    env->pmem_dma_dst = 0;
+    env->pmem_dma_size = 0;
+    env->pmem_dma_ctrl = 0;
+    env->pmem_dma_status = 0;
+    env->pmem_dma_dir = 0;
+    env->pmem_dma_irq_en = 0;
+    env->pmem_dma_cfx_off = 0;
+    env->pmem_dma_pa = 0;
+    env->pmem_dma_len = 0;
+}
+
+#else /* CONFIG_USER_ONLY */
+
+/*
+ * The linux-user build has no system address space and no cfx internal SRAM:
+ * the cfx_pmem cg15 interface is withheld explicitly (CFXREG), never a
+ * silent success.
+ */
+static bool dadao_pmem_dma_reg_read(CPUDADAOState *env, uint32_t rc,
+                                    uint64_t *val)
+{
+    (void)env; (void)rc; (void)val;
+    return false;
+}
+
+static bool dadao_pmem_dma_reg_write(CPUDADAOState *env, uint32_t rc,
+                                     uint64_t val)
+{
+    (void)env; (void)rc; (void)val;
+    return false;
+}
+
+#endif /* !CONFIG_USER_ONLY */
+
+/* ===================================================================
+ * cfx_time (cfxha 18) + single-hart cfx_hart timer (cfxha 15)
+ * (spec/DADAO-12 §4.7/§4.10; contract-see §3; INTEG-050t/INTEG-051t)
+ *
+ * cfx_time_value and cfx_hart_cycle are derived from QEMU_CLOCK_VIRTUAL
+ * (test-machine model: 1 count = 1 ns, epoch = reset time_base_ns).  cfx_hart
+ * insn is accumulated per TB by translate.c.  The timer is one-shot and its
+ * deadline is a 64-bit absolute cfx_time value; TIMER (1 << 10) is maskable
+ * with cause_info = 0.  A pending TIMER lives in the target cfx's cg5 rc5
+ * (cfx_hart bit10); the unified arbiter below only selects (INTEG-051t).
+ * =================================================================== */
+
+static uint64_t dadao_time_now_ns(void)
+{
+#ifdef CONFIG_USER_ONLY
+    /* linux-user has no QEMU_CLOCK_VIRTUAL; reads stay non-faulting. */
+    return 0;
+#else
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+#endif
+}
+
+static uint64_t dadao_time_value(CPUDADAOState *env)
+{
+    uint64_t now = dadao_time_now_ns();
+
+    return (now >= env->time_base_ns) ? now - env->time_base_ns : 0;
+}
+
+static bool dadao_time_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg10 rc0: time_freq (Hz) */
+        *val = DADAO_TIME_FREQ;
+        return true;
+    case 1:                             /* cg10 rc1: time_value (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool dadao_hart_istatus(CPUDADAOState *env)
+{
+    return (env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) &&
+           (env->hart_timer_cmp != ~0ULL) &&
+           (dadao_time_value(env) >= env->hart_timer_cmp);
+}
+
+static bool dadao_hart_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg8 rc0: hart_id (single hart) */
+        *val = 0;
+        return true;
+    case 2:                             /* cg8 rc2: cycle (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    case 3:                             /* cg8 rc3: insn (64-bit) */
+        *val = env->hart_insn;
+        return true;
+#ifdef CONFIG_USER_ONLY
+    case 4:
+    case 5:
+        return false;                   /* timer regs withheld: CFXREG */
+#else
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+        *val = env->hart_timer_cmp;
+        return true;
+    case 5:                             /* cg8 rc5: ctrl[1:0] | ISTATUS << 2 */
+        *val = (env->hart_timer_ctrl & (DADAO_HART_TIMER_ENABLE |
+                                        DADAO_HART_TIMER_IMASK)) |
+               (dadao_hart_istatus(env) ? DADAO_HART_TIMER_ISTATUS : 0);
+        return true;
+#endif
+    default:                            /* rc1/rc6/rc7/others: reserved */
+        return false;
+    }
+}
+
+#ifndef CONFIG_USER_ONLY
+
+/* Wake the vCPU for TIMER.  The timer callback runs in the main loop with
+ * the BQL held; the same expiry can also be reached synchronously from a
+ * cfx2rc helper (write cmp/ctrl) where the BQL is not held, so use the
+ * BQL-free atomic request in that case (cpu_interrupt asserts bql_locked). */
+static void dadao_hart_notify(CPUState *cs)
+{
+    if (bql_locked()) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_set_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+}
+
+/* ── Unified async arbitration (INTEG-051t; DADAO-12 §5, ADR-0045 D3) ──
+ * Every asynchronous source records its pending bit in the *target* cfx's
+ * cg5 rc5 (TIMER -> cfx_hart bit10, PMEM_DMA -> cfx_pmem bit8); cfx_hart is
+ * not a pending store and no cross-cfx bitmap exists.  This arbiter only
+ * selects: the two-level masks and excp_cause_mask stay in cfx_enter (steps
+ * 3/4/5), whose `entered` result says whether the pending bit was consumed or
+ * must stay for a later kick.  At most one cfx_enter(async) per call. */
+
+/* Sources in target-cfxha order: the lowest deliverable cfxha wins. */
+static const struct dadao_async_source {
+    int cfxha;
+    uint64_t cause;
+} dadao_async_sources[] = {
+    { DADAO_CFXHA_HART, DADAO_CAUSE_TIMER },       /* 15 */
+    { DADAO_CFXHA_PMEM, DADAO_CAUSE_PMEM_DMA },    /* 17 */
+};
+
+/* Lowest target cfxha whose pending bit is set and may be delivered.  The
+ * masks are deliberately not evaluated here (cfx_enter is the only authority);
+ * only the source-local TIMER IMASK gate applies.  -1 when nothing is pending. */
+static int dadao_async_lowest(CPUDADAOState *env)
+{
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(dadao_async_sources); i++) {
+        int cfxha = dadao_async_sources[i].cfxha;
+        int ci = cfx_idx(cfxha);
+
+        if (ci < 0 || !(env->cfx[ci].pending & dadao_async_sources[i].cause)) {
+            continue;
+        }
+        if (cfxha == DADAO_CFXHA_HART &&
+            (env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+            continue;
+        }
+        return cfxha;
+    }
+    return -1;
+}
+
+/* Re-raise CPU_INTERRUPT_HARD when a source is still pending.  Called from
+ * every point that can unblock one (mask/pending writes, escape, a new source
+ * event); never spins, because exec_interrupt clears HARD on every call. */
+static void dadao_async_kick(CPUDADAOState *env)
+{
+    if (dadao_async_lowest(env) >= 0) {
+        dadao_hart_notify(env_cpu(env));
+    }
+}
+
+/* Deliver at most one pending source; true iff one cfx_enter(async) ran. */
+bool dadao_async_arbitrate(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(dadao_async_sources); i++) {
+        int cfxha = dadao_async_sources[i].cfxha;
+        uint64_t cause = dadao_async_sources[i].cause;
+        uint8_t entry_mode = env->inner_run_mode;
+        uint64_t info;
+        uint64_t vec;
+        int ci = cfx_idx(cfxha);
+        bool entered = false;
+
+        if (ci < 0 || !(env->cfx[ci].pending & cause)) {
+            continue;                   /* this source has no event */
+        }
+        if (cfxha == DADAO_CFXHA_HART &&
+            (env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+            continue;                   /* source-local gate */
+        }
+        /* TIMER has cause_info = 0; PMEM_DMA carries the dma_status at the
+         * moment of delivery (050 convention). */
+        info = (cfxha == DADAO_CFXHA_HART) ? 0 : env->pmem_dma_status;
+        vec = cfx_enter(env, cause, cfxha, env->pc, info, false, &entered);
+        if (!entered) {
+            /* Masked by step 3/4/5: cfx_enter kept the pending bit; the next
+             * source must not be held back by this one. */
+            continue;
+        }
+        env->cfx[ci].pending &= ~cause;  /* consumed: one event, one delivery */
+        env->pc = vec;
+        env->rb[0] = vec;
+        cfx_frame_block_async(env, ci, entry_mode);
+        return true;                     /* single layer: one source per call */
+    }
+    return false;
+}
+
+static void dadao_hart_timer_expire(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int ci = cfx_idx(DADAO_CFXHA_HART);
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        return;
+    }
+    if (dadao_time_value(env) < env->hart_timer_cmp) {
+        return;                         /* re-armed after the callback fired */
+    }
+    /* The expiry is an event: record it in the target cfx's pending bit
+     * (cfx_hart cg5 rc5 bit10, the single record) and let the arbiter deliver.
+     * IMASK is the source-local delivery gate, so a masked expiry only records
+     * and waits for the ctrl write that releases it. */
+    if (ci >= 0) {
+        env->cfx[ci].pending |= DADAO_CAUSE_TIMER;
+    }
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+        dadao_async_kick(env);
+    }
+}
+
+static void dadao_hart_timer_arm(CPUDADAOState *env, CPUState *cs)
+{
+    uint64_t now;
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        timer_del(env->hart_timer);
+        return;
+    }
+    now = dadao_time_value(env);
+    if (now >= env->hart_timer_cmp) {
+        timer_del(env->hart_timer);
+        dadao_hart_timer_expire(cs);
+        return;
+    }
+    /* QEMU_CLOCK_VIRTUAL deadline in ns: epoch + absolute cfx_time value
+     * (1 count = 1 ns on the test machine). */
+    timer_mod(env->hart_timer,
+              (int64_t)(env->time_base_ns + env->hart_timer_cmp));
+}
+
+static void dadao_hart_timer_cb(void *opaque)
+{
+    dadao_hart_timer_expire((CPUState *)opaque);
+}
+
+void dadao_hart_timer_init(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->hart_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                   dadao_hart_timer_cb, cs);
+}
+
+void dadao_hart_timer_reset(CPUDADAOState *env)
+{
+    if (env->hart_timer) {
+        timer_del(env->hart_timer);
+    }
+    env->time_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    env->hart_insn = 0;
+    env->hart_timer_cmp = 0;
+    env->hart_timer_ctrl = 0;
+}
+
+#endif /* !CONFIG_USER_ONLY */
+
+static bool dadao_hart_reg_write(CPUDADAOState *env, uint32_t rc, uint64_t val)
+{
+    switch (rc) {
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(DADAO_CFXHA_HART);
+
+            /* A new compare value cancels the old deadline and this match. */
+            env->hart_timer_cmp = val;
+            if (ci >= 0) {
+                env->cfx[ci].pending &= ~DADAO_CAUSE_TIMER;
+            }
+            timer_del(env->hart_timer);
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    case 5:                             /* cg8 rc5: ENABLE/IMASK (bit2 RO) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(DADAO_CFXHA_HART);
+
+            env->hart_timer_ctrl = (uint8_t)(val & (DADAO_HART_TIMER_ENABLE |
+                                                    DADAO_HART_TIMER_IMASK));
+            /* Releasing IMASK while ISTATUS=1 keeps the recorded pending bit
+             * (re-setting it if software cleared it) and re-kicks, so the
+             * arbiter performs the delivery (050 "release delivers" semantics). */
+            if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK) &&
+                dadao_hart_istatus(env)) {
+                if (ci >= 0) {
+                    env->cfx[ci].pending |= DADAO_CAUSE_TIMER;
+                }
+                dadao_async_kick(env);
+            }
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    default:                            /* rc2/rc3 are RO; rc0/1/6/7 reserved */
+        return false;
+    }
+}
+
+/* trap cfxha, immu18 : general trap (not the semihosting tag) -> §5 flow.
+ * Semihosting (immu18[17:8] == 0x3FF, i.e. 0x3FF00-0x3FFFF) is handled by the
+ * decode-layer short-circuit (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST,
+ * QEMU-046t/ADR-0038 D4) and therefore never reaches this helper; the tag
+ * check below is a defensive explicit failure only. */
+void helper_cfx_trap(CPUDADAOState *env, uint32_t cfxha, uint32_t immu18,
+                     uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7F << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(immu18 & 0x3FFFF);
+    uint64_t cause;
+    int target;
+    int ci;
+
+    if (immu18 >= 0x3FF00) {
+        /* Semihosting tag (immu18[17:8] == 0x3FF, ADR-0038 D1): short-circuited
+         * at the decode layer (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST) and
+         * must never reach this general-trap helper.  Fail explicitly (ILLI)
+         * if it does, rather than silently entering a cfx vector. */
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(cfxha);
+    if (ci < 0) {
+        /* allocated but not implemented by the test machine => CFXREG */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    /* cfxtrap permission: target's source mask, self bypasses the cfx axis
+     * but still uses the current-mode row (ADR-0045 D1/D2). */
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_TRAP)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    target = cfxha;
+    cause = DADAO_CAUSE_CFXTRAP;
+
+    {
+        uint8_t entry_mode = env->inner_run_mode;
+        bool entered;
+        uint64_t vec = cfx_enter(env, cause, target, pc, info, true, &entered);
+
+        env->pc = entered ? vec : pc + 4;
+        env->rb[0] = env->pc;
+        if (entered && env->inner_cfx_code == cfxha) {
+            cfx_frame_block_async(env, ci, entry_mode);
+        }
+    }
+}
+
+/* escape cfxha, imms18 : §5 exception-exit flow (steps 0-4).  D8: cfxha is the
+ * current cfx; the return target/mode/IP come from the current frame.  A
+ * different target or an invalid frame is CFXESC (current cfx), and no state is
+ * switched before the error is raised. */
+void helper_cfx_escape(CPUDADAOState *env, uint32_t cfxha, uint32_t imms18,
+                       uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7E << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(imms18 & 0x3FFFF);
+    int ci = cfx_idx(env->inner_cfx_code);
+    int32_t imm = (int32_t)(imms18 & 0x3FFFF);
+
+    if (imm & (1 << 17)) {
+        imm |= ~0x1FFFF;    /* sign-extend from 18 bits */
+    }
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    /* CFXESC: target error (cfxha must be the current cfx) or no frame. */
+    if (ci < 0 || cfxha != env->inner_cfx_code || env->cfx[ci].cause_id == 0) {
+        cfx_raise(env, DADAO_CAUSE_CFXESC, env->inner_cfx_code, pc, info);
+        return;
+    }
+
+    /* step 1: restore the saved global_cfx_intr_mask (D9). */
+    env->cfx[env->cfx[ci].saved_intr_monitor & 0x3].global_cfx_intr_mask =
+        env->cfx[ci].saved_global_intr_mask;
+#ifndef CONFIG_USER_ONLY
+    /* The live frame blocked every async source; once the mask is back,
+     * re-kick so the arbiter can deliver what accumulated meanwhile. */
+    dadao_async_kick(env);
+#endif
+    /* step 2: restore the per-hart cfx mask and run mode from the frame. */
+    env->inner_cfx_mask = env->cfx[ci].prev_cfx_mask;
+    env->inner_run_mode = env->cfx[ci].prev_run_mode & 0x3;
+    dadao_soft_tlb_flush(env);
+    /* step 3: increment the escape counter */
+    env->cfx[ci].escape_num++;
+    /* step 4: return address = cause_ip + (imms18 << 2); the offset is a
+     * compile-time immediate, not an arbitrary target. */
+    {
+        uint64_t ret = env->cfx[ci].cause_ip + ((int64_t)imm << 2);
+        env->pc = ret;
+        env->rb[0] = ret;
+    }
+}
+
+/* cfx2rd cfxha, cghb, rchc, rdhd */
+void helper_cfx2rd(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7A << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(cfxha);
+    if (ci < 0) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v;
+
+        if (!dadao_pmem_dma_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        uint64_t v;
+
+        if (!dadao_time_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_hart cg8 (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v;
+
+        if (!dadao_hart_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 internal space description
+                                          * (read-only, DADAO-12 §3.8) */
+        if (rd != 0) {
+            env->rd[rd] = dadao_cg7_space_reg(cfxha, rc);
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, false);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+        return;
+    }
+    if (rd != 0) {
+        env->rd[rd] = *p;
+    }
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
+
+/* cfx2rc cfxha, cghb, rchc, rdhd */
+void helper_cfx2rc(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7B << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(cfxha);
+    if (ci < 0) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, info, pc);
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_pmem_dma_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 is RO (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+        return;
+    }
+    /* cfx_hart cg8: only rc4/rc5 accept writes (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_hart_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 is read-only: any rc write
+                                          * => CFXREG (DADAO-12 §3.8) */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, true);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+        return;
+    }
+    if (p == &env->ptbr) {
+        /* Single PTBR stores PPN[55:16]; [15:0] and [63:56] read as 0. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_PTBR_MASK;
+        /* Writing PTBR does not invalidate guest TLB entries (DADAO-12 §2.2,
+         * ADR-0041 D5); only QEMU's derived translation cache is dropped so
+         * that the guest TLB stays the single authority on hits/misses. */
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->ptw_enable) {
+        /* 1-bit enable (DADAO-12 §4.5). */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 1;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_asid) {
+        /* 16-bit ASID; switching it never invalidates guest TLB entries. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 0xFFFFULL;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_start) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_size) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_control) {
+        /* TLB command: executed synchronously on write (DADAO-12 §4.5). */
+        uint64_t val = (rd == 0) ? 0 : env->rd[rd];
+        hwaddr err_pa = 0;
+        int ret = dadao_tlb_control_exec(env, val, &err_pa);
+
+        if (ret == DADAO_TLB_CMD_CFXREG) {
+            /* Illegal scope / range with size 0 => CFXREG (ADR-0041 D6). */
+            cfx_raise(env, DADAO_CAUSE_CFXREG, cfxha, pc, info);
+            return;
+        }
+        if (ret == DADAO_TLB_CMD_PTWERR) {
+            /* A/D write-back failed: PTWERR, entry kept (ADR-0041 D7/D10).
+             * Precise: the cfx2rc instruction did not complete. */
+            CPUState *cs = env_cpu(env);
+
+            env->pc = pc;
+            env->rb[0] = pc;
+            env->ptw_fault_cause = DADAO_CAUSE_PTWERR;
+            env->ptw_fault_info = err_pa;
+            cs->exception_index = DADAO_EXCP_PTW_FAULT;
+            cpu_loop_exit_restore(cs, GETPC());
+            /* not reached */
+            return;
+        }
+        /* CLEAN keeps entries (mappings unchanged); INVALID/FLUSH drop them,
+         * so QEMU's derived translation cache must be dropped with them. */
+        if (val & 0x2) {
+            dadao_soft_tlb_flush(env);
+        }
+    } else if (cg == 3 && rc == 12) {
+        /* bit3 is hardware-fixed 1 (DADAO-13 §1): a software 0 is ignored and
+         * the register reads back with bit3 set. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) | (1ULL << 3);
+    } else {
+        *p = (rd == 0) ? 0 : env->rd[rd];
+        /* Any cfx2rc write may change a two-axis permission mask (cfxtrap/
+         * cfxmem/cfxreg/cfxexe/cfx_intr_mask/global_cfx_intr_mask); drop the
+         * derived translation cache so the next access re-checks. */
+        dadao_soft_tlb_flush(env);
+    }
+#ifndef CONFIG_USER_ONLY
+    /* A write to a mask / excp_cause_mask / pending register may unblock a
+     * pending async source; re-kick here so the generic write path covers
+     * every such register (INTEG-051t). */
+    dadao_async_kick(env);
+#endif
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
