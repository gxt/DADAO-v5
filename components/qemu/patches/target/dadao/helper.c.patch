+#ifndef CONFIG_USER_ONLY
+/* DADAO-12 §5 exception-entry flow (defined below; used by the page-fault
+ * path in dadao_cpu_do_interrupt / dadao_cpu_tlb_fill). */
+static uint64_t cfx_enter(CPUDADAOState *env, uint64_t cause, int target,
+                          uint64_t cause_ip, uint64_t cause_info,
+                          bool *entered);
+static void cfx_raise(CPUDADAOState *env, uint64_t cause, int target,
+                      uint64_t pc, uint64_t cause_info);
+static int cfx_idx(CPUDADAOState *env, int cfxha);
+static DADAOTlbEntry *dadao_tlb_lookup(CPUDADAOState *env, uint64_t va);
+
+/* `sync_fault_info` sentinel for "the raise site could not supply cause_info".
+ * Instruction encodings are 32-bit zero-extended values, so a 64-bit all-ones
+ * word can never collide with one. */
+#define DADAO_INFO_UNSET  (~(uint64_t)0)
+
+/* Instruction word at the faulting IP, for `ILLI`'s cause_info
+ * (DADAO-12 §4.1 / Kaiwu §4.4: `cause_info` = 指令编码).
+ *
+ * Every other ILLI raise site carries the encoding from the translator
+ * (`ctx->opcode`, see gen_exception_illegal); the read-only-ROM store check in
+ * dadao_cpu_tlb_fill is raised from the TLB fill path, which cannot see the
+ * instruction, so the word is read back from the faulting IP.  The address
+ * rules are the ones that fetch used: core-internal segments are identity (the
+ * cfx SRAM windows map onto their host region) and the memory window uses the
+ * TLB entry the fetch installed.  Returns false when the word cannot be read;
+ * the caller reports that instead of recording a made-up value.
+ */
+static bool dadao_insn_word(CPUDADAOState *env, uint64_t pc, uint32_t *word)
+{
+    const DadaoProfile *prof = DADAO_PROFILE(env);
+    unsigned cfxha = DADAO_ADDR_CFXHA(pc);
+    uint64_t off;
+    hwaddr pa;
+    MemTxResult res = MEMTX_OK;
+
+    pc &= DADAO_ADDR_MASK;
+    if (cfxha == DADAO_CFXHA_MEM) {
+        DADAOTlbEntry *e;
+
+        if (!prof->ptw_supported || !(env->ptw_enable & 1)) {
+            return false;
+        }
+        e = dadao_tlb_lookup(env, pc);
+        if (e == NULL) {
+            return false;
+        }
+        pa = e->pa | (pc & ((1ULL << e->size_log2) - 1));
+    } else if (cfxha == DADAO_CFXHA_PMEM && prof->pmem_sram &&
+               (off = pc & DADAO_VA_MASK) >= DADAO_PMEM_SRAM_CFX_OFFSET &&
+               off - DADAO_PMEM_SRAM_CFX_OFFSET < DADAO_PMEM_SRAM_SIZE) {
+        pa = DADAO_PMEM_SRAM_HOST_BASE + (off - DADAO_PMEM_SRAM_CFX_OFFSET);
+    } else if (((cfxha == DADAO_CFXHA_HMON && prof->hmon_sram) ||
+                (cfxha == 2 && prof->smon_sram)) &&
+               (off = pc & DADAO_VA_MASK) >= DADAO_MON_SRAM_CFX_OFFSET &&
+               off - DADAO_MON_SRAM_CFX_OFFSET < DADAO_MON_SRAM_SIZE) {
+        pa = (cfxha == DADAO_CFXHA_HMON ? DADAO_HMON_SRAM_HOST_BASE
+                                        : DADAO_SMON_SRAM_HOST_BASE)
+             + (off - DADAO_MON_SRAM_CFX_OFFSET);
+    } else if (pc >= prof->ram_base && pc - prof->ram_base < prof->ram_size) {
+        pa = pc;
+    } else if (pc >= prof->rom_base && pc - prof->rom_base < prof->rom_size) {
+        pa = pc;
+    } else {
+        return false;
+    }
+    *word = address_space_ldl_be(&address_space_memory, pa,
+                                 MEMTXATTRS_UNSPECIFIED, &res);
+    return res == MEMTX_OK;
+}
