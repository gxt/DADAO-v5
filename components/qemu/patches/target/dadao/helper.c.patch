+#ifndef CONFIG_USER_ONLY
+/* DADAO-12 §5 exception-entry flow (defined below; used by the page-fault
+ * path in dadao_cpu_do_interrupt / dadao_cpu_tlb_fill). */
+static uint64_t cfx_enter(CPUDADAOState *env, uint64_t cause, int target,
+                          uint64_t cause_ip, uint64_t cause_info,
+                          bool sync, bool *entered);
+static void cfx_raise(CPUDADAOState *env, uint64_t cause, int target,
+                      uint64_t pc, uint64_t cause_info);
+static int cfx_idx(CPUDADAOState *env, int cfxha);
+
+/* Map a direct machine fault to its exit code (spec/Machine-v5 §7.1).
+ *
+ * Used only as the *machine-fault* fallback: when a synchronous exception
+ * cannot enter the current run-mode monitor because that monitor's vector is
+ * not a mapped, 4-byte-aligned address (entering it would recurse forever),
+ * the process halts with the monitor-segment code (spec/Machine-v5 §7.1:
+ * "若未被 hmon 处理而作为机器 fault 终止，按 monitor 段的 hypv 编码"):
+ *   0xC0 | (run_mode << 4) | cause_bit_index
+ * `UNMAPPED` is reported as CFXMEM (bit index 1), never as a separate code.
+ * CFXTRAP/CFXESC never reach this function: entering the target/current cfx
+ * uses the other-cfx segment (DADAO_EXIT_CFX) instead.
+ */
+static int dadao_excp_to_exit_code(CPUDADAOState *env, int excp)
+{
+    int index;
+
+    switch (excp) {
+    case DADAO_EXCP_UNDI:   index = 9;  break;
+    case DADAO_EXCP_RASOF:  index = 10; break;
+    case DADAO_EXCP_RASUF:  index = 11; break;
+    case DADAO_EXCP_MALIGN: index = 12; break;
+    case DADAO_EXCP_IALIGN: index = 13; break;
+    case DADAO_EXCP_CFXMEM:
+    case DADAO_EXCP_UNMAPPED: index = 1; break;   /* unmapped => CFXMEM */
+    case DADAO_EXCP_CFXREG:  index = 2;  break;
+    case DADAO_EXCP_CFXPERM: index = 7;  break;
+    case DADAO_EXCP_ILLI:
+    default:                 index = 8;  break;   /* ILLI (explicit fallback) */
+    }
+    return DADAO_EXIT_MONITOR(env->inner_run_mode, index);
+}
+
+/*
+ * cause id / cause info of a synchronous exception that is not a `trap`
+ * (`DADAO-12 §5.2(一)(二)`, `Machine-v5 §4.4`):
+ *
+ *   ILLI / UNDI         1<<8 / 1<<9   info = instruction encoding
+ *   CFXMEM / UNMAPPED   1<<1          info = the faulting address
+ *   CFXREG              1<<2          info = instruction encoding
+ *   CFXPERM             1<<7          info = address or instruction encoding
+ *   MALIGN              1<<12         info = the faulting address
+ *   IALIGN              1<<13         info = the IP value
+ *   RASOF / RASUF       1<<10 / 1<<11 info = return address / 0
+ *
+ * ILLI/UNDI/CFXREG carry the instruction word from raise_exception();
+ * CFXMEM/MALIGN carry the faulting address from tlb_fill /
+ * do_unaligned_access; IALIGN and RASOF/RASUF derive from the IP.
+ */
+static void dadao_sync_cause(CPUDADAOState *env, int excp,
+                             uint64_t *cause, uint64_t *info)
+{
+    switch (excp) {
+    case DADAO_EXCP_UNDI:
+        *cause = DADAO_CAUSE_UNDI;
+        *info = env->sync_fault_info;
+        break;
+    case DADAO_EXCP_RASOF:
+        *cause = DADAO_CAUSE_RASOF;
+        *info = env->sync_fault_info;
+        break;
+    case DADAO_EXCP_RASUF:
+        *cause = DADAO_CAUSE_RASUF;
+        *info = 0;
+        break;
+    case DADAO_EXCP_MALIGN:
+        *cause = DADAO_CAUSE_MALIGN;
+        *info = env->sync_fault_info;
+        break;
+    case DADAO_EXCP_IALIGN:
+        /* IP[1:0] != 00: precise exception, IP stays at the illegal address
+         * (DADAO-12 §5, Machine-v5 §4.4) => cause_ip and cause_info are the
+         * illegal IP itself. */
+        *cause = DADAO_CAUSE_IALIGN;
+        *info = env->pc;
+        break;
+    case DADAO_EXCP_CFXMEM:
+    case DADAO_EXCP_UNMAPPED:
+        *cause = DADAO_CAUSE_CFXMEM;
+        *info = env->sync_fault_info;
+        break;
+    case DADAO_EXCP_CFXREG:
+        *cause = DADAO_CAUSE_CFXREG;
+        *info = env->sync_fault_info;
+        break;
+    case DADAO_EXCP_CFXPERM:
+        *cause = DADAO_CAUSE_CFXPERM;
+        *info = env->cfx_perm_info;
+        break;
+    case DADAO_EXCP_ILLI:
+    default:
+        *cause = DADAO_CAUSE_ILLI;
+        *info = env->sync_fault_info;
+        break;
+    }
+}
+
+/*
+ * Is the monitor vector a location code fetch can reach?  Entering an
+ * unreachable vector turns one exception into an endless CFXMEM recursion, so
+ * such an exception is a machine fault instead (spec/Machine-v5 §7.1 "若未被
+ * hmon 处理而作为机器 fault 终止").
+ *
+ * The vector follows the ordinary address rules (DADAO-12 §5.2 step 7): with
+ * `addr[47:42] != 0` it is a core-internal address whose reachability is
+ * fixable from the profile geometry; with `addr[47:42] == 0` it is a virtual
+ * address, and either PTW is off (=> CFXMEM) or the software guarantees the
+ * page is mapped ("软件须保证异常向量所在页不会发生页缺失").
+ */
+static bool dadao_vector_reachable(CPUDADAOState *env, uint64_t vec)
+{
+    const DadaoProfile *prof = DADAO_PROFILE(env);
+    unsigned cfxha = DADAO_ADDR_CFXHA(vec & DADAO_ADDR_MASK);
+
+    if (vec & 3) {
+        return false;
+    }
+    if (cfxha == DADAO_CFXHA_MEM) {
+        return prof->ptw_supported && (env->ptw_enable & 1);
+    }
+    if (vec >= prof->ram_base && vec - prof->ram_base < prof->ram_size) {
+        return true;
+    }
+    if (vec >= prof->rom_base && vec - prof->rom_base < prof->rom_size) {
+        return true;
+    }
+    if (cfxha == DADAO_CFXHA_HMON && prof->hmon_sram &&
+        (vec & DADAO_VA_MASK) >= DADAO_MON_SRAM_CFX_OFFSET &&
+        (vec & DADAO_VA_MASK) - DADAO_MON_SRAM_CFX_OFFSET < DADAO_MON_SRAM_SIZE) {
+        return true;
+    }
+    if (cfxha == 2 && prof->smon_sram &&
+        (vec & DADAO_VA_MASK) >= DADAO_MON_SRAM_CFX_OFFSET &&
+        (vec & DADAO_VA_MASK) - DADAO_MON_SRAM_CFX_OFFSET < DADAO_MON_SRAM_SIZE) {
+        return true;
+    }
+    if (cfxha == DADAO_CFXHA_PMEM && prof->pmem_sram &&
+        (vec & DADAO_VA_MASK) >= DADAO_PMEM_SRAM_CFX_OFFSET &&
+        (vec & DADAO_VA_MASK) - DADAO_PMEM_SRAM_CFX_OFFSET < DADAO_PMEM_SRAM_SIZE) {
+        return true;
+    }
+    return false;
+}
+
+/* Enter the current run-mode monitor for a synchronous exception, or halt as a
+ * machine fault when the monitor vector cannot be reached (which would recurse
+ * forever).  Machine-v5 §7.1: an unhandled sync exception ends in the monitor
+ * segment code of the current run mode. */
+static void dadao_sync_enter(CPUDADAOState *env, int excp)
+{
+    uint64_t cause, info;
+    int target = env->inner_run_mode;   /* U->0, J->1, S->2, H->3 */
+    bool entered = false;
+    uint64_t vec;
+
+    dadao_sync_cause(env, excp, &cause, &info);
+    vec = cfx_enter(env, cause, target, env->pc, info, true, &entered);
+    if (!entered || !dadao_vector_reachable(env, vec)) {
+        int exit_code = dadao_excp_to_exit_code(env, excp);
+
+        qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
+                                               exit_code);
+        cpu_exit(env_cpu(env));
+        return;
+    }
+    env->pc = vec;
+    env->rb[0] = env->pc;
+}
+
+void dadao_cpu_do_interrupt(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    /*
+     * Exception/interrupt entry clears this hart's LR/SC reservation
+     * (SimRISC-11 §4.2: "异常或中断进入" is one of the clearing events, so an
+     * sc executed after a handler ran can never succeed -- QEMU-067t).
+     */
+    env->lock_valid = 0;
+
+    /*
+     * Semihosting short-circuit (ADR-0038 D1/D4; Machine-01 §5): the trap
+     * tag immu18[17:8] == 0x3FF (0x3FF00-0x3FFFF) is raised from the decode
+     * layer (trans_trap_ciii_cfx) as DADAO_EXCP_SEMIHOST.  Serve the call
+     * through the shared responder do_common_semihosting() and advance PC past
+     * the trap -- semihosting never enters a cfx vector and is not a fault
+     * (same shape as RISCV_EXCP_SEMIHOST).  cpu_loop_exit_restore has already
+     * set env->pc to the trapping instruction, so += 4 is the return step.
+     */
+    if (cs->exception_index == DADAO_EXCP_SEMIHOST) {
+        do_common_semihosting(cs);
+        env->pc += 4;       /* no `escape`; return by stepping past the trap */
+        env->rb[0] = env->pc;
+        return;
+    }
+
+    /*
+     * Page-table walk / TLB-hit fault (DADAO-12 §2.2.6/§5.2): the exception
+     * goes to the *current run-mode monitor*, never to cfx_ptw.  Missing /
+     * fragment / A-D write-back failures carry CFXMEM; HSJU/R/W/X failures
+     * carry CFXPERM (both already encoded by the translation layer).
+     */
+    if (cs->exception_index == DADAO_EXCP_PTW_FAULT) {
+        bool entered = false;
+
+        /* Do not override an already pending clean shutdown (same rule as the
+         * generic fault path below). */
+        if (qemu_shutdown_requested_get() != SHUTDOWN_CAUSE_NONE) {
+            return;
+        }
+        uint64_t vec = cfx_enter(env, env->ptw_fault_cause,
+                                 env->inner_run_mode, env->pc,
+                                 env->ptw_fault_info, true, &entered);
+
+        if (!entered) {
+            error_report("dadao: page-table fault (cause=%016" PRIx64
+                         ", VA=%016" PRIx64 ") could not enter the current "
+                         "run-mode monitor", env->ptw_fault_cause,
+                         env->ptw_fault_info);
+            exit(1);
+        }
+        env->pc = vec;
+        env->rb[0] = env->pc;
+        return;
+    }
+
+    /*
+     * Everything below is an execution-time synchronous exception that belongs
+     * to the current run-mode monitor (`DADAO-12 §5.2(一)`): ILLI / UNDI /
+     * CFXMEM / CFXREG / CFXPERM / MALIGN / IALIGN / RASOF / RASUF.  CFXPERM
+     * (two-axis permission denial, ADR-0045 D6) is one of them: it also goes
+     * to the monitor of the *current* run mode and never enters a cfx vector.
+     *
+     * If a clean shutdown is already pending, do not override it with a
+     * monitor entry or a panic exit code.
+     */
+    if (qemu_shutdown_requested_get() != SHUTDOWN_CAUSE_NONE) {
+        return;
+    }
+
+    if (DADAO_PROFILE(env)->sync_exc_monitor_entry) {
+        /* Machine-v5-Tiny (fixed hypv, monitor = cfx3 hmon): every cause
+         * enters the hmon vector instead of being mapped straight to an exit
+         * code (spec/Machine-v5 §4.4); the shared helper also keeps an
+         * unreachable vector from recursing. */
+        dadao_sync_enter(env, cs->exception_index);
+        return;
+    }
+
+    /*
+     * Staged model still used by Machine-v5-Vast, which maps these causes to
+     * the monitor-segment machine-fault exit code rather than entering a
+     * vector (the PTW-fault and CFXPERM paths above do enter the monitor).
+     * The deviation from DADAO-12 §5.2 is registered in the task's spec-gap
+     * list because the Vast probe oracles encode it.
+     */
+    if (cs->exception_index == DADAO_EXCP_CFXPERM) {
+        cfx_raise(env, DADAO_CAUSE_CFXPERM, env->inner_run_mode,
+                  env->pc, env->cfx_perm_info);
+        return;
+    }
+    {
+        int exit_code = dadao_excp_to_exit_code(env, cs->exception_index);
+
+        qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
+                                               exit_code);
+        cpu_exit(cs);
+    }
+}
+
+/*
+ * PTE field layout (DADAO-12 §2.2.3/§2.2.4; ADR-0040 D1/D9, ADR-0041 D4/D9).
+ *
+ *   [63:60] HSJU   H=63, S=62, J=61, U=60
+ *   [59:56] reserved (ignored)
+ *   [55:16] PPN    ([55:29] for a superpage)
+ *   [15:8]  SPF (L1 superpage) / GPF (L2 page); bit8 = lowest fragment
+ *   [7] R  [6] W  [5] X  [4] G  [3] A  [2] D  [1] SP  [0] P
+ */
+#define DADAO_PTE_PPN_MASK   0x00FFFFFFFFFF0000ULL  /* PPN[55:16] */
+#define DADAO_PTE_SPPN_MASK  0x00FFFFFFE0000000ULL  /* PPN[55:29] */
+#define DADAO_PTE_FRAG_SHIFT 8
+#define DADAO_PTE_P          (1ULL << 0)
+#define DADAO_PTE_SP         (1ULL << 1)
+#define DADAO_PTE_D          (1ULL << 2)
+#define DADAO_PTE_A          (1ULL << 3)
+#define DADAO_PTE_G          (1ULL << 4)
+#define DADAO_PTE_X          (1ULL << 5)
+#define DADAO_PTE_W          (1ULL << 6)
+#define DADAO_PTE_R          (1ULL << 7)
+
+/* Page sizes (DADAO-12 §2.2.1/§2.2.2): 512 MiB superpage / 64 KiB page. */
+#define DADAO_PAGE_SHIFT_SUPER   29
+#define DADAO_PAGE_SHIFT_NORMAL  16
+
+#define DADAO_SIZE_MASK(log2)    ((1ULL << (log2)) - 1)
+
+/* Page-table walk result: 1 = mapped, 0 = fault (*cause set), -1 = the PTE
+ * itself could not be read from memory (outside pmem; undefined by the
+ * architecture, so the caller fails explicitly rather than inventing a cause).
+ */
+static int dadao_ptw_read_pte(hwaddr pa, uint64_t *pte)
+{
+    MemTxResult res = MEMTX_OK;
+
+    /* Physical memory (pmem) is the system address space; reading it here
+     * bypasses the PTW/TLB by construction (ADR-0040 D2/§2.2.1 step 3). */
+    *pte = address_space_ldq_be(&address_space_memory, pa,
+                                MEMTXATTRS_UNSPECIFIED, &res);
+    return res == MEMTX_OK ? 0 : -1;
+}
+
+/*
+ * A/D write-back (ADR-0041 D4): atomically OR the pending A/D bits into the
+ * leaf PTE, keeping every other field.  The model is single-threaded, so a
+ * read-modify-write through the system address space is atomic with respect
+ * to guest accesses (page tables are only accessed by this path).
+ * Returns 0, or -1 when the PTE cannot be written (readonly ROM / no memory).
+ */
+static int dadao_ptw_or_ad(hwaddr pte_pa, bool a, bool d)
+{
+    MemTxResult res = MEMTX_OK;
+    uint64_t bits = (a ? DADAO_PTE_A : 0) | (d ? DADAO_PTE_D : 0);
+    uint64_t old;
+
+    if (bits == 0) {
+        return 0;
+    }
+    old = address_space_ldq_be(&address_space_memory, pte_pa,
+                               MEMTXATTRS_UNSPECIFIED, &res);
+    if (res != MEMTX_OK) {
+        return -1;
+    }
+    address_space_stq_be(&address_space_memory, pte_pa, old | bits,
+                         MEMTXATTRS_UNSPECIFIED, &res);
+    return res == MEMTX_OK ? 0 : -1;
+}
+
+/* ── TLB (DADAO-12 §2.2.1/§2.2.2 step 2, §4.5; ADR-0041 D2-D9) ───────── */
+
+static bool dadao_tlb_va_match(const DADAOTlbEntry *e, uint64_t va)
+{
+    return (va & ~DADAO_SIZE_MASK(e->size_log2)) == e->va;
+}
+
+static bool dadao_tlb_asid_match(const CPUDADAOState *env,
+                                 const DADAOTlbEntry *e)
+{
+    /* G=1 entries are global: they match every ASID (ADR-0041 D9). */
+    if (e->flags & DADAO_TLB_FLAG_G) {
+        return true;
+    }
+    return e->asid == (uint16_t)env->tlb_asid;
+}
+
+static DADAOTlbEntry *dadao_tlb_lookup(CPUDADAOState *env, uint64_t va)
+{
+    int i;
+
+    for (i = 0; i < DADAO_TLB_ENTRIES; i++) {
+        DADAOTlbEntry *e = &env->tlb[i];
+
+        if (e->valid && dadao_tlb_va_match(e, va) &&
+            dadao_tlb_asid_match(env, e)) {
+            return e;
+        }
+    }
+    return NULL;
+}
+
+/*
+ * Hit-path permission check: fragment presence -> HSJU -> R/W/X, the same
+ * order as the page walk (ADR-0040 D8; §2.2.6).  Returns 1 when the access may
+ * proceed, 0 on fault (*cause set).  The entry is not re-read from the PTE.
+ */
+static int dadao_tlb_check(const CPUDADAOState *env, const DADAOTlbEntry *e,
+                           uint64_t va, MMUAccessType access_type,
+                           uint64_t *cause)
+{
+    bool fetch = (access_type == MMU_INST_FETCH);
+    bool super = (e->size_log2 == DADAO_PAGE_SHIFT_SUPER);
+    int frag = super ? (int)((va >> 26) & 0x7) : (int)((va >> 13) & 0x7);
+
+    if (!(e->frags & (1u << frag))) {
+        if (super) {
+            *cause = DADAO_CAUSE_CFXMEM;
+        } else {
+            *cause = DADAO_CAUSE_CFXMEM;
+        }
+        return 0;
+    }
+
+    /* HSJU: the current run mode's bit must be set (ADR-0040 D6). */
+    if (!(e->hsju & (1u << (env->inner_run_mode & 0x3)))) {
+        *cause = DADAO_CAUSE_CFXPERM;
+        return 0;
+    }
+
+    /* R/W/X, orthogonal to HSJU (ADR-0040 D7). */
+    if (fetch) {
+        if (!(e->flags & DADAO_TLB_FLAG_X)) {
+            *cause = DADAO_CAUSE_CFXPERM;
+            return 0;
+        }
+    } else if (access_type == MMU_DATA_STORE) {
+        if (!(e->flags & DADAO_TLB_FLAG_W)) {
+            *cause = DADAO_CAUSE_CFXPERM;
+            return 0;
+        }
+    } else if (!(e->flags & DADAO_TLB_FLAG_R)) {
+        *cause = DADAO_CAUSE_CFXPERM;
+        return 0;
+    }
+    return 1;
+}
+
+/*
+ * Mark A/D locally for an access that passed the checks (ADR-0041 D4): a
+ * load/fetch sets A, a store sets A and D.  Only 0->1 transitions set the
+ * write-back flag.
+ */
+static void dadao_tlb_touch(DADAOTlbEntry *e, MMUAccessType access_type)
+{
+    if (!e->a_local) {
+        e->a_local = true;
+        e->a_dirty = true;
+    }
+    if (access_type == MMU_DATA_STORE && !e->d_local) {
+        e->d_local = true;
+        e->d_dirty = true;
+    }
+}
+
+/* Write the pending A/D bits back (CLEAN/FLUSH/evict).  0 = ok, -1 = failed. */
+static int dadao_tlb_writeback(DADAOTlbEntry *e)
+{
+    if (!e->a_dirty && !e->d_dirty) {
+        return 0;
+    }
+    if (dadao_ptw_or_ad(e->pte_pa, e->a_dirty, e->d_dirty) < 0) {
+        return -1;
+    }
+    e->a_dirty = false;
+    e->d_dirty = false;
+    return 0;
+}
+
+/*
+ * Fill the TLB after a successful walk (ADR-0041 D4/D8).  A dirty entry being
+ * replaced is written back first; a failed write-back is reported as CFXMEM
+ * without touching the victim entry (*err_pa = its PTE PA).
+ * Returns 0 and sets *out, or -1 with *err_pa set.
+ */
+static int dadao_tlb_insert(CPUDADAOState *env, uint64_t va, uint64_t leaf_pte,
+                            hwaddr leaf_pa, bool superpage,
+                            DADAOTlbEntry **out, hwaddr *err_pa)
+{
+    DADAOTlbEntry *e = &env->tlb[env->tlb_next];
+
+    if (e->valid && dadao_tlb_writeback(e) < 0) {
+        *err_pa = e->pte_pa;
+        return -1;
+    }
+    env->tlb_next = (env->tlb_next + 1) % DADAO_TLB_ENTRIES;
+
+    memset(e, 0, sizeof(*e));
+    e->size_log2 = superpage ? DADAO_PAGE_SHIFT_SUPER : DADAO_PAGE_SHIFT_NORMAL;
+    e->va = va & ~DADAO_SIZE_MASK(e->size_log2);
+    e->pa = superpage ? (leaf_pte & DADAO_PTE_SPPN_MASK)
+                      : (leaf_pte & DADAO_PTE_PPN_MASK);
+    e->pte_pa = leaf_pa;
+    e->hsju = (leaf_pte >> 60) & 0xF;
+    e->frags = (leaf_pte >> DADAO_PTE_FRAG_SHIFT) & 0xFF;
+    e->flags = ((leaf_pte & DADAO_PTE_R) ? DADAO_TLB_FLAG_R : 0) |
+               ((leaf_pte & DADAO_PTE_W) ? DADAO_TLB_FLAG_W : 0) |
+               ((leaf_pte & DADAO_PTE_X) ? DADAO_TLB_FLAG_X : 0) |
+               ((leaf_pte & DADAO_PTE_G) ? DADAO_TLB_FLAG_G : 0);
+    e->asid = (uint16_t)env->tlb_asid;
+    e->a_local = (leaf_pte & DADAO_PTE_A) != 0;
+    e->d_local = (leaf_pte & DADAO_PTE_D) != 0;
+    e->valid = true;
+    *out = e;
+    return 0;
+}
+
+/*
+ * Soft-TLB protection for an entry.  Write permission is only mapped once both
+ * A and D are already settled in the entry: the first store to a page that was
+ * filled by a read must come back through tlb_fill so the guest A/D bits are
+ * updated (ADR-0041 D4).  This keeps the guest-visible A/D independent of
+ * QEMU's own translation cache.
+ */
+static int dadao_tlb_prot(const DADAOTlbEntry *e)
+{
+    int prot = 0;
+
+    if (e->flags & DADAO_TLB_FLAG_R) {
+        prot |= PAGE_READ;
+    }
+    if (e->flags & DADAO_TLB_FLAG_X) {
+        prot |= PAGE_EXEC;
+    }
+    if ((e->flags & DADAO_TLB_FLAG_W) && e->a_local && e->d_local) {
+        prot |= PAGE_WRITE;
+    }
+    return prot;
+}
+
+/*
+ * Execute a cfx_ptw_tlb_control write: op ([1:0]), scope ([3:2]) and ASID_ANY
+ * (bit4) are orthogonal; the match condition is (ASID match) AND (address
+ * match).  Normal completion (including op=00) raises nothing; only an illegal
+ * operand (scope=reserved, range with size=0) yields CFXREG.
+ */
+static int dadao_tlb_control_exec(CPUDADAOState *env, uint64_t val,
+                                 hwaddr *err_pa)
+{
+    unsigned op = val & 0x3;
+    unsigned scope = (val >> 2) & 0x3;
+    bool asid_any = (val >> 4) & 0x1;
+    uint64_t start = env->tlb_start;
+    uint64_t size = env->tlb_size;
+    int i;
+
+    /* op=00 is a no-op and wins over the operand checks: it raises nothing
+     * (ADR-0041 D3.2 "00 为 no-op，不报异常"), whatever scope/size hold. */
+    if (op == 0x0) {
+        return DADAO_TLB_CMD_OK;
+    }
+    if (scope == 0x3) {
+        return DADAO_TLB_CMD_CFXREG;        /* reserved scope */
+    }
+    if (scope == 0x2 && size == 0) {
+        return DADAO_TLB_CMD_CFXREG;        /* range needs a size */
+    }
+
+    for (i = 0; i < DADAO_TLB_ENTRIES; i++) {
+        DADAOTlbEntry *e = &env->tlb[i];
+
+        if (!e->valid) {
+            continue;
+        }
+        /* ASID dimension: G entries are bypassed unless ASID_ANY is set. */
+        if (!asid_any && ((e->flags & DADAO_TLB_FLAG_G) ||
+                          e->asid != (uint16_t)env->tlb_asid)) {
+            continue;
+        }
+        /* Address dimension (independent of the ASID dimension). */
+        if (scope == 0x1) {
+            if (!dadao_tlb_va_match(e, start)) {
+                continue;
+            }
+        } else if (scope == 0x2) {
+            uint64_t end = start + size;
+            uint64_t epage_end = e->va + (1ULL << e->size_log2);
+
+            if (end < start) {
+                end = UINT64_MAX;           /* saturate on wrap */
+            }
+            if (!(e->va < end && start < epage_end)) {
+                continue;
+            }
+        }
+        if (op & 0x1) {                     /* clean / flush: write back */
+            if (dadao_tlb_writeback(e) < 0) {
+                *err_pa = e->pte_pa;        /* entry kept (FLUSH failure) */
+                return DADAO_TLB_CMD_AD_WB_FAIL;
+            }
+        }
+        if (op & 0x2) {                     /* invalid / flush: delete */
+            e->valid = false;
+        }
+    }
+    return DADAO_TLB_CMD_OK;
+}
+
+static int dadao_ptw_walk(CPUDADAOState *env, uint64_t va,
+                          MMUAccessType access_type, hwaddr *paddr,
+                          uint64_t *cause, int *prot,
+                          uint64_t *leaf_pte, hwaddr *leaf_pa)
+{
+    bool fetch = (access_type == MMU_INST_FETCH);
+    uint64_t l1pa = (env->ptbr & DADAO_PTBR_MASK) + (((va >> 29) & 0x1FFF) << 3);
+    uint64_t hsju = 1ULL << (60 + (env->inner_run_mode & 0x3));
+    uint64_t pte;
+    int frag;
+
+    if (dadao_ptw_read_pte(l1pa, &pte) < 0) {
+        return -1;
+    }
+
+    /* Step 1: L1 present / superpage (DADAO-12 §2.2.1/§2.2.2 step 3). */
+    if (!(pte & DADAO_PTE_P)) {
+        if (pte & DADAO_PTE_SP) {
+            *cause = DADAO_CAUSE_CFXMEM;
+        } else {
+            *cause = DADAO_CAUSE_CFXMEM;
+        }
+        return 0;
+    }
+
+    if (pte & DADAO_PTE_SP) {
+        /* Step 2: 512 MiB superpage + SPF fragment presence. */
+        frag = (va >> 26) & 0x7;
+        if (!(pte & (1ULL << (DADAO_PTE_FRAG_SHIFT + frag)))) {
+            *cause = DADAO_CAUSE_CFXMEM;
+            return 0;
+        }
+        /* PPN[28:16] is forced to zero (ADR-0040 D9): mask, never fault. */
+        *paddr = (pte & DADAO_PTE_SPPN_MASK) | (va & 0x1FFFFFFFULL);
+        *leaf_pa = l1pa;
+    } else {
+        /* Step 2: L2 table, then a 64 KiB normal page + GPF fragment. */
+        uint64_t l2pa = (pte & DADAO_PTE_PPN_MASK) +
+                        (((va >> 16) & 0x1FFF) << 3);
+
+        if (dadao_ptw_read_pte(l2pa, &pte) < 0) {
+            return -1;
+        }
+        if (!(pte & DADAO_PTE_P)) {
+            *cause = DADAO_CAUSE_CFXMEM;
+            return 0;
+        }
+        frag = (va >> 13) & 0x7;
+        if (!(pte & (1ULL << (DADAO_PTE_FRAG_SHIFT + frag)))) {
+            *cause = DADAO_CAUSE_CFXMEM;
+            return 0;
+        }
+        *paddr = (pte & DADAO_PTE_PPN_MASK) | (va & 0xFFFFULL);
+        *leaf_pa = l2pa;
+    }
+
+    /* Step 3: HSJU (current run mode) before R/W/X (ADR-0040 D6-D8). */
+    if (!(pte & hsju)) {
+        *cause = DADAO_CAUSE_CFXPERM;
+        return 0;
+    }
+
+    /* Step 4: R/W/X, orthogonal to HSJU (ADR-0040 D7). */
+    if (fetch) {
+        if (!(pte & DADAO_PTE_X)) {
+            *cause = DADAO_CAUSE_CFXPERM;
+            return 0;
+        }
+    } else if (access_type == MMU_DATA_STORE) {
+        if (!(pte & DADAO_PTE_W)) {
+            *cause = DADAO_CAUSE_CFXPERM;
+            return 0;
+        }
+    } else if (!(pte & DADAO_PTE_R)) {
+        *cause = DADAO_CAUSE_CFXPERM;
+        return 0;
+    }
+
+    *prot = ((pte & DADAO_PTE_R) ? PAGE_READ : 0) |
+            ((pte & DADAO_PTE_W) ? PAGE_WRITE : 0) |
+            ((pte & DADAO_PTE_X) ? PAGE_EXEC : 0);
+    *leaf_pte = pte;
+    return 1;
+}
+
+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr)
+{
+    /*
+     * Address-space Step 1 (ADR-0039 §8.5; DADAO-12 §2.2) and Step 3 TLB
+     * (ADR-0041):
+     *
+     * The CPU address is 48 bits; addr[47:42] is the partition key:
+     *   high6 == 0  -> memory window (VA[41:0]):
+     *       ptw_enable == 0: no translation => CFXMEM (current-mode cfx);
+     *                        never a silent pmem pass-through (TLB bypassed).
+     *       ptw_enable == 1: TLB lookup first, then a two-level page-table
+     *                        walk on a miss; a successful walk fills the TLB.
+     *   high6 == 63 -> test-machine RAM/ROM (identity map); OOB is an
+     *                  unmapped access, reported as CFXMEM.
+     *   reserved cfx (6-14, 16-31, 35-61) plain ld/st -> CFXMEM (ADR-0039 Step 1-c).
+     *   other high6 -> unmapped access, reported as CFXMEM.
+     */
+    CPUDADAOState *env = cpu_env(cs);
+    const DadaoProfile *prof = DADAO_PROFILE(env);
+    uint64_t addr = address & DADAO_ADDR_MASK;
+    unsigned cfxha = DADAO_ADDR_CFXHA(addr);
+    uint64_t cause = 0;
+    int ret;
+    int prot;
+    hwaddr paddr;
+
+    /* IALIGN (DADAO-12 §2.2.6 item 1, checked *before* the fetch; §5:
+     * "IP 停留在非法地址").  The instruction-fetch path reaches this function
+     * for the exact pc, so a misaligned target is reported here before the
+     * segment/legality checks below can turn it into CFXMEM.  The IP is not
+     * written back: cause_ip / cause_info are the illegal address itself. */
+    if (access_type == MMU_INST_FETCH && (addr & 3)) {
+        if (probe) {
+            return false;
+        }
+        env->sync_fault_info = addr;
+        cs->exception_index = DADAO_EXCP_IALIGN;
+        cpu_loop_exit_restore(cs, retaddr);
+        /* not reached */
+        return false;
+    }
+
+    /* Two-axis cfx permission (ADR-0045 D1/D2/D6): direct ld/st => cfxmem,
+     * fetch => cfxexe of the target cfx; self bypasses the cfx axis only.
+     * This check precedes address/range legality (CFXMEM/CFXREG).  A cfx the
+     * profile does not implement has no masks at all (no rows), so it is
+     * handled by the segment map below (CFXMEM), never by a mask denial
+     * (spec/Machine-v5 §3). */
+    if (cfxha != DADAO_CFXHA_MEM &&
+        dadao_cfx_implemented(prof, cfxha) &&
+        cfx_perm_denied(env, cfxha,
+                        access_type == MMU_INST_FETCH ? DADAO_CFX_PERM_EXE
+                                                      : DADAO_CFX_PERM_MEM)) {
+        if (probe) {
+            return false;
+        }
+        env->cfx_perm_info = addr;
+        cs->exception_index = DADAO_EXCP_CFXPERM;
+        cpu_loop_exit_restore(cs, retaddr);
+        /* not reached */
+        return false;
+    }
+
+    if (cfxha == DADAO_CFXHA_MEM) {
+        DADAOTlbEntry *e;
+        uint64_t leaf_pte = 0;
+        hwaddr leaf_pa = 0;
+        bool superpage;
+
+        /* Tiny has no PTW (spec/Machine-v5 §1.2): the memory window is never
+         * a pmem pass-through, so every high6==0 access/fetch is CFXMEM. */
+        if (!prof->ptw_supported || !(env->ptw_enable & 1)) {
+            /* ptw_enable == 0: the window is never a pmem pass-through and
+             * the TLB is bypassed (ADR-0041 D5). */
+            if (probe) {
+                return false;
+            }
+            env->sync_fault_info = addr;   /* cause_info = 访存地址 */
+            cs->exception_index = DADAO_EXCP_CFXMEM;
+            cpu_loop_exit_restore(cs, retaddr);
+            /* not reached */
+            return false;
+        }
+
+        /* Step 2: TLB lookup (DADAO-12 §2.2.1/§2.2.2; ADR-0041 D8/D9). */
+        e = dadao_tlb_lookup(env, addr);
+        if (e) {
+            if (!dadao_tlb_check(env, e, addr, access_type, &cause)) {
+                if (probe) {
+                    return false;
+                }
+                env->ptw_fault_cause = cause;
+                env->ptw_fault_info = addr;
+                cs->exception_index = DADAO_EXCP_PTW_FAULT;
+                cpu_loop_exit_restore(cs, retaddr);
+                /* not reached */
+                return false;
+            }
+            if (!probe) {
+                dadao_tlb_touch(e, access_type);
+            }
+            paddr = e->pa | (addr & DADAO_SIZE_MASK(e->size_log2));
+            prot = dadao_tlb_prot(e);
+            goto map;
+        }
+
+        /* Step 3: two-level page-table walk on a miss.  Page-table pages are
+         * read with physical addresses through the address space, never
+         * through this function, so the walk cannot recurse. */
+        ret = dadao_ptw_walk(env, addr, access_type, &paddr, &cause, &prot,
+                             &leaf_pte, &leaf_pa);
+        if (ret < 0) {
+            /* Architecture does not define a page-table page outside pmem
+             * (Machine-01: page tables live in pmem).  Fail loudly instead of
+             * inventing a page-fault cause. */
+            if (probe) {
+                return false;
+            }
+            error_report("dadao: page-table access outside physical memory "
+                         "(VA=%016" PRIx64 ", PTBR=%016" PRIx64 ")",
+                         addr, env->ptbr);
+            exit(1);
+        }
+        if (ret == 0) {
+            /* Missing page / permission failure: no fill, no A/D update. */
+            if (probe) {
+                return false;
+            }
+            env->ptw_fault_cause = cause;
+            env->ptw_fault_info = addr;
+            cs->exception_index = DADAO_EXCP_PTW_FAULT;
+            cpu_loop_exit_restore(cs, retaddr);
+            /* not reached */
+            return false;
+        }
+
+        superpage = (leaf_pte & DADAO_PTE_SP) != 0;
+        if (probe) {
+            /* Probing must not change TLB or A/D state. */
+            prot = ((leaf_pte & DADAO_PTE_R) ? PAGE_READ : 0) |
+                   ((leaf_pte & DADAO_PTE_W) ? PAGE_WRITE : 0) |
+                   ((leaf_pte & DADAO_PTE_X) ? PAGE_EXEC : 0);
+            goto map;
+        }
+        {
+            hwaddr err_pa = 0;
+
+            if (dadao_tlb_insert(env, addr, leaf_pte, leaf_pa, superpage,
+                                 &e, &err_pa) < 0) {
+                /* Replacing a dirty entry failed to write back: CFXMEM
+                 * (ADR-0041 D7/D10), cause_info = the failing PTE PA. */
+                env->ptw_fault_cause = DADAO_CAUSE_CFXMEM;
+                env->ptw_fault_info = err_pa;
+                cs->exception_index = DADAO_EXCP_PTW_FAULT;
+                cpu_loop_exit_restore(cs, retaddr);
+                /* not reached */
+                return false;
+            }
+        }
+        /* The access that caused the fill is itself an access (ADR-0041 D4):
+         * a load/fetch sets A, a store sets A/D. */
+        dadao_tlb_touch(e, access_type);
+        prot = dadao_tlb_prot(e);
+        goto map;
+    }
+
+    /* cfx_pmem (cfx32): the 64 KiB SRAM window at internal offset
+     * 0x3ff_0000_0000 (DADAO-12 §2.1/§4.9; ADR-0042 D3).  The test machine backs it with a
+     * RAM region at a host address outside the 56-bit PA space.  An offset
+     * outside the SRAM is an illegal internal-space access => CFXMEM. */
+    if (prof->pmem_sram && cfxha == DADAO_CFXHA_PMEM) {
+        uint64_t off = addr & DADAO_VA_MASK;
+
+        if (off >= DADAO_PMEM_SRAM_CFX_OFFSET &&
+            off - DADAO_PMEM_SRAM_CFX_OFFSET < DADAO_PMEM_SRAM_SIZE) {
+            paddr = DADAO_PMEM_SRAM_HOST_BASE + (off - DADAO_PMEM_SRAM_CFX_OFFSET);
+            prot = PAGE_READ | PAGE_WRITE;
+            goto map;
+        }
+        if (probe) {
+            return false;
+        }
+        env->sync_fault_info = addr;
+        cs->exception_index = DADAO_EXCP_CFXMEM;
+        cpu_loop_exit_restore(cs, retaddr);
+        /* not reached */
+        return false;
+    }
+
+    /* hmon (cfx3) / smon (cfx2) SRAM: 64 KiB at internal offset
+     * 0x3ff_0000_0000 of the owning cfx (ADR-0043 D4/D5).  The test machine
+     * backs each with a host RAM region outside the 56-bit PA space.  An
+     * offset outside the SRAM is an illegal internal-space access => CFXMEM.
+     * Machine-v5-Tiny implements hmon only (spec/Machine-v5 §1.1). */
+    if ((cfxha == DADAO_CFXHA_HMON && prof->hmon_sram) ||
+        (cfxha == 2 && prof->smon_sram)) {
+        uint64_t off = addr & DADAO_VA_MASK;
+        uint64_t host = (cfxha == DADAO_CFXHA_HMON) ? DADAO_HMON_SRAM_HOST_BASE
+                                                    : DADAO_SMON_SRAM_HOST_BASE;
+
+        if (off >= DADAO_MON_SRAM_CFX_OFFSET &&
+            off - DADAO_MON_SRAM_CFX_OFFSET < DADAO_MON_SRAM_SIZE) {
+            paddr = host + (off - DADAO_MON_SRAM_CFX_OFFSET);
+            prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+            goto map;
+        }
+        if (probe) {
+            return false;
+        }
+        env->sync_fault_info = addr;
+        cs->exception_index = DADAO_EXCP_CFXMEM;
+        cpu_loop_exit_restore(cs, retaddr);
+        /* not reached */
+        return false;
+    }
+
+    /* RAM (profile geometry): Node 2 GiB at PA 0, Tiny 8 MiB at
+     * 0xffff_ff00_0000 (spec/Machine-v5 §1.1). */
+    if (addr >= prof->ram_base && addr < prof->ram_base + prof->ram_size) {
+        prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    if (addr >= prof->rom_base && addr < prof->rom_base + prof->rom_size) {
+        /* ROM: read+exec allowed. Store to ROM triggers ILLI (ADR-0004 D5.6).
+         * The ROM MemoryRegion is readonly, so stores should not succeed.
+         * However, TCG fast-path stores may not check write permission.
+         * Catch stores here in the TLB fill path to raise ILLI. */
+        if (access_type == MMU_DATA_STORE) {
+            /* cause_info would be the instruction encoding, which this path
+             * cannot see; leave 0 rather than a stale value. */
+            env->sync_fault_info = 0;
+            cs->exception_index = DADAO_EXCP_ILLI;
+            cpu_loop_exit_restore(cs, retaddr);
+            /* not reached */
+            return false;
+        }
+        prot = PAGE_READ | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    /* Unmapped address */
+    if (probe) {
+        return false;
+    }
+
+    /*
+     * Machine-level fault classification:
+     *  - a profile with no cfx segment map (Tiny) reports every unmapped
+     *    access/fetch as CFXMEM (spec/Machine-v5 §1.2) -- both the
+     *    high6==0 window and "cfxha 63 outside BootROM/SRAM";
+     *  - reserved cfxha (6-14, 16-31, 35-61) plain ld/st => CFXMEM (ADR-0039
+     *    Step 1-c), routed to that cfxha (DADAO-12 §5.2);
+     *  - every other unmapped segment (incl. the power segment 63 outside
+     *    RAM/ROM) is also CFXMEM (spec/Machine-v5 §7.1).
+     * Data accesses and instruction fetches are treated identically: the
+     * fetch path reaches this function through get_page_addr_code ->
+     * cpu_ldl_code_maybe_mmu (MMU_INST_FETCH), so no `access_type` special
+     * case is needed and an out-of-range fetch never silently continues.
+     */
+    env->sync_fault_info = addr;       /* cause_info = 访存地址 */
+    if (prof->unmapped_is_cfxmem || DADAO_CFX_IS_RESERVED(cfxha)) {
+        cs->exception_index = DADAO_EXCP_CFXMEM;
+    } else {
+        cs->exception_index = DADAO_EXCP_UNMAPPED;
+    }
+    cpu_loop_exit_restore(cs, retaddr);
+    /* not reached */
+    return false;
+
+map:
+    tlb_set_page(cs, address, paddr, prot, mmu_idx, TARGET_PAGE_SIZE);
+    return true;
+}
+#endif /* !CONFIG_USER_ONLY */
+
+/*
+ * QEMU's own translation cache is a derived cache of the guest TLB/PTW result;
+ * dropping it never invalidates guest TLB entries.  It must be dropped when the
+ * inputs that produced guest-visible mappings change (PTBR / ptw_enable / ASID)
+ * or when guest TLB entries are deleted, otherwise a stale host mapping would
+ * outlive the guest state it was derived from (ADR-0041 D5).
+ */
+#ifndef CONFIG_USER_ONLY
+static void dadao_soft_tlb_flush(CPUDADAOState *env)
+{
+    tlb_flush(env_cpu(env));
+}
+#else
+/*
+ * The linux-user build has no PTW/TLB (ADR-0041 is a system-mode structure):
+ * there is nothing to flush, and the cfx_ptw cg12 interface is withheld by
+ * cfx_reg_ptr, so a command write there takes the generic CFXREG path rather
+ * than silently succeeding.
+ */
+static void dadao_soft_tlb_flush(CPUDADAOState *env)
+{
+    (void)env;
+}
+
+/* Unreachable: cfx_reg_ptr withholds cfx_ptw cg12 in this build, so a command
+ * write is rejected there with CFXREG.  Present only to keep the link whole. */
+static int dadao_tlb_control_exec(CPUDADAOState *env, uint64_t val,
+                                 hwaddr *err_pa)
+{
+    (void)env;
+    (void)val;
+    (void)err_pa;
+    return DADAO_TLB_CMD_CFXREG;
+}
+#endif
+
+/*
+ * raise_exception helper: raise a DADAO synchronous exception.
+ * env is the implicit first argument passed by TCG.
+ * excp is the DADAO exception index; info is the cause_info the monitor
+ * records for it (DADAO-12 §5.2(二)): the instruction encoding for
+ * ILLI/UNDI/CFXREG, the faulting address for MALIGN/CFXMEM.
+ */
+void helper_raise_exception(CPUDADAOState *env, uint32_t excp, uint64_t info)
+{
+    CPUState *cs = env_cpu(env);
+
+    env->sync_fault_info = info;
+    cs->exception_index = excp;
+    cpu_loop_exit_restore(cs, GETPC());
+}
+
+/* ── Ring-buffer RA access helpers (ADR-0012 D7) ──────────────────── */
+
+/* Compute physical index for logical RA register n (1..63).
+ * ra0 is always at physical 0 (metadata). */
+static inline int ra_phys(CPUDADAOState *env, int n)
+{
+    if (n == 0) return 0;
+    int r = (env->ras_base + n) % 63;
+    if (r < 0) r += 63;
+    return 1 + r;
+}
+
+/* Store val into ra[logical_n] (ring-buffer view). */
+void helper_ra_store(CPUDADAOState *env, uint64_t logical_idx, uint64_t val)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    env->ra[phys] = val;
+}
+
+/* Load from ra[logical_n] (ring-buffer view). */
+uint64_t helper_ra_load(CPUDADAOState *env, uint64_t logical_idx)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    return env->ra[phys];
+}
+
+/* ── RAS push (ADR-0012 D7 §3) ───────────────────────────────────── */
+void helper_ras_push(CPUDADAOState *env, uint64_t ret_addr)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    /* Read stack top (logical 63) */
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    ret_addr &= 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt == 0) {
+        /* C1: empty stack → push, RACNT = 1 */
+        env->ra[top_phys] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | (1ULL << 48);
+        return;
+    }
+
+    if (ret_addr == top_lo && top_hi < 0xFFFF) {
+        /* C2: recursive fold */
+        env->ra[top_phys] = ((uint64_t)(top_hi + 1) << 48) | top_lo;
+        return;
+    }
+
+    if (racnt < 63) {
+        /* C3a: advance ras_base, push new entry, RACNT++ */
+        env->ras_base = (env->ras_base + 1) % 63;
+        int new_top = ra_phys(env, 63);
+        env->ra[new_top] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt + 1) << 48);
+        return;
+    }
+
+    /* C3b: RACNT == 63, overflow path */
+    if (mrptr == 0) {
+        /* RASOF: precise — no side effects.  cause_info is the return address
+         * that could not be pushed (DADAO-13 §2 / DADAO-12 §5.2(二)). */
+        CPUState *cs = env_cpu(env);
+        env->sync_fault_info = ret_addr;
+        cs->exception_index = DADAO_EXCP_RASOF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Spill bottom to MemRAS */
+    int bottom_phys = ra_phys(env, 1); /* logical 1 = 64-63 */
+    uint64_t bottom_val = env->ra[bottom_phys];
+    uint64_t new_mrptr = mrptr - 8;
+    /* Write to MemRAS (guest memory, big-endian) */
+    cpu_stq_be_data_ra(env, new_mrptr, bottom_val, GETPC());
+
+    /* Advance ras_base, write new entry */
+    env->ras_base = (env->ras_base + 1) % 63;
+    int new_top = ra_phys(env, 63);
+    env->ra[new_top] = (1ULL << 48) | ret_addr;
+
+    /* Update ra0: new MRPTR, RACNT stays 63 */
+    env->ra[0] = (ra0 & 0x003F000000000000ULL) | (new_mrptr & 0x0000FFFFFFFFFFFFULL);
+}
+
+/* ── RAS pop (ADR-0012 D7 §4) ────────────────────────────────────── */
+/* Pop return address from RAS. Result stored in env->ras_tmp. */
+void helper_ras_pop(CPUDADAOState *env)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt > 0) {
+        if (top_hi == 0) {
+            /* D1: RASUF — precise, no side effects */
+            CPUState *cs = env_cpu(env);
+            cs->exception_index = DADAO_EXCP_RASUF;
+            cpu_loop_exit_restore(cs, GETPC());
+            return;
+        }
+
+        if (top_hi > 1) {
+            /* D2: decrement recursive count */
+            env->ra[top_phys] = ((uint64_t)(top_hi - 1) << 48) | top_lo;
+            env->ras_tmp = top_lo;
+            return;
+        }
+
+        /* D3: top_hi == 1 → pop, rotate ras_base backward */
+        env->ras_tmp = top_lo;
+        env->ras_base = (env->ras_base + 62) % 63;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt - 1) << 48);
+        return;
+    }
+
+    /* D4: RACNT == 0 */
+    if (mrptr == 0) {
+        /* D4a: RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* D4b: read from MemRAS */
+    uint64_t mem_val = cpu_ldq_be_data_ra(env, mrptr, GETPC());
+    uint16_t mem_hi = (uint16_t)(mem_val >> 48);
+    uint64_t mem_lo = mem_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 0) {
+        /* Invalid entry → RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Commit: MRPTR += 8 */
+    env->ra[0] = (mrptr + 8) & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 1) {
+        /* D4b count==1: return address, RACNT stays 0 */
+        env->ras_tmp = mem_lo;
+        return;
+    }
+
+    /* D4b count>1: decrement, push to RegRAS, RACNT=1 */
+    int top_phys2 = ra_phys(env, 63);
+    env->ra[top_phys2] = ((uint64_t)(mem_hi - 1) << 48) | mem_lo;
+    env->ra[0] = (env->ra[0] & ~0x003F000000000000ULL) | (1ULL << 48);
+    env->ras_tmp = mem_lo;
+}
+
+/* ── FP softfloat conversion family (QEMU-036t) ──────────────────────── */
+/*
+ * First use of the upstream softfloat in the DADAO target.  A local
+ * float_status is built from the FCSR on every call (no CPUArchState field
+ * is added): the rf0[33:32] rounding mode is mapped to a softfloat round
+ * mode and accrued exception flags are merged back into rf0[4:0].
+ *
+ * Sources:
+ *   spec/SimRISC-07 §格式转换指令
+ *   .tao/contracts/contract-fp.md §1/§2/§3/§4
+ *   spec/SimRISC-00 §浮点状态寄存器
+ */
+
+/* rf0[33:32] → softfloat rounding mode:
+ *   00 RNE, 01 RTZ, 10 RDN, 11 RUP  (SimRISC-00 §浮点状态寄存器) */
+static FloatRoundMode rf0_round_mode(uint64_t rf0)
+{
+    switch ((rf0 >> 32) & 0x3) {
+    case 0:
+        return float_round_nearest_even;
+    case 1:
+        return float_round_to_zero;
+    case 2:
+        return float_round_down;
+    default:
+        return float_round_up;
+    }
+}
+
+/* Build a local softfloat status from the current FCSR value. */
+static void fp_status_init(CPUDADAOState *env, float_status *st)
+{
+    memset(st, 0, sizeof(*st));
+    set_float_rounding_mode(rf0_round_mode(env->rf[0]), st);
+    set_float_detect_tininess(float_tininess_after_rounding, st);
+    /* Default generated qNaN = the FCSR qNaN(ft)/qNaN(fo) pattern (mantissa
+     * MSB set, rest zero ⇒ 0x7FC00000 / 0x7FF8000000000000).  memset() alone
+     * leaves default_nan_pattern == 0, which parts64_default_nan() rejects
+     * (the invalid-operation results of add/sub/mul/div/rem/scalb/sqrt would
+     * otherwise be malformed or abort the assert). */
+    set_float_default_nan_pattern(0b01000000, st);
+    /* 2-NaN propagation rule.  Which input NaN is propagated when both
+     * operands are NaN is implementation-defined: IEEE 754-2019 §6.2.3 only
+     * *recommends* the sNaN-first s_ab order, and SimRISC-07/contract-fp.md
+     * require merely "符合 IEEE 754" (payload selection is not specified).
+     * We match the current host (x86_64 scalar SSE, -mfpmath=sse): for
+     * +,-,*,/ with qNaN/sNaN operand pairs in both orders the host returns
+     * the FIRST operand's NaN (quieted if signalling) regardless of sNaN vs
+     * qNaN — i.e. float_2nan_prop_ab.  Without a rule here softfloat aborts
+     * (parts64_pick_nan g_assert_not_reached) as soon as any NaN operand
+     * reaches add/sub/mul/div/rem (ISS-195). */
+    set_float_2nan_prop_rule(float_2nan_prop_ab, st);
+}
+
+/* Merge the softfloat exception flags into the accrued FCSR status bits.
+ * softfloat's NV/DZ/OF/UF/NX occupy the low 5 bits, bit-for-bit identical to
+ * rf0[4:0], so the merge is a masked OR. */
+static void fp_status_commit(CPUDADAOState *env, float_status *st)
+{
+    env->rf[0] |= (uint64_t)(get_float_exception_flags(st) & 0x1F);
+}
+
+/* Map a conversion's 6-bit direction field to a softfloat rounding mode
+ * (ADR-0050 D2): one-hot 0x01 RNE / 0x02 RNA / 0x04 RTZ / 0x08 RUP /
+ * 0x10 RDN, and 0x20 dynamic (read rf0[33:32]).  Anything else is ILLI and
+ * is rejected by the translator before the helper runs. */
+static FloatRoundMode conv_round_mode(CPUDADAOState *env, uint32_t code)
+{
+    switch (code) {
+    case 0x01:
+        return float_round_nearest_even;
+    case 0x02:
+        return float_round_ties_away;
+    case 0x04:
+        return float_round_to_zero;
+    case 0x08:
+        return float_round_up;
+    case 0x10:
+        return float_round_down;
+    default: /* 0x20 dynamic */
+        return rf0_round_mode(env->rf[0]);
+    }
+}
+
+/* Decode the packed conversion operand: low 8 bits = kind, bits [15:8] = the
+ * 6-bit direction field. */
+static void conv_select_mode(CPUDADAOState *env, float_status *st,
+                             uint32_t packed)
+{
+    set_float_rounding_mode(conv_round_mode(env, (packed >> 8) & 0x3F), st);
+}
+
+/* convert_ff (float→float):
+ *   kind 0 ft2fo (widening, exact, SBZ)
+ *   kind 1 fo2ft (narrowing, low 6 bits = rounding direction)
+ * ft is held in the low 32 bits of the rf register. */
+uint64_t helper_fp_cvt_ff(CPUDADAOState *env, uint64_t src, uint32_t packed)
+{
+    float_status st;
+    uint64_t res;
+    uint32_t kind = packed & 0xFF;
+
+    fp_status_init(env, &st);
+    conv_select_mode(env, &st, packed);
+    if (kind == 0) {
+        res = (uint64_t)float32_to_float64((float32)src, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float64_to_float32((float64)src, &st);
+        /* contract-fp §2 / SimRISC-07: conversion overflow returns ±Inf and
+         * sets OF regardless of the rounding direction (IEEE 754 would return
+         * the largest finite under RTZ/RDN/RUP). */
+        if (get_float_exception_flags(&st) & float_flag_overflow) {
+            res = (src >> 63) ? 0xFF800000ull : 0x7F800000ull;
+        }
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* convert_f2i (float→int): saturating, direction from the low 6 bits (one-hot
+ * or 0x20 dynamic), NV on NaN/Inf/out-of-range and NX on a finite inexact
+ * result (ADR-0050 D5).  The 32-bit results are sign- or zero-extended to the
+ * 64-bit rd width following the SimRISC convention.
+ *
+ * kind: 0 ft2it, 1 ft2io, 2 ft2ut, 3 ft2uo,
+ *       4 fo2it, 5 fo2io, 6 fo2ut, 7 fo2uo */
+uint64_t helper_fp_cvt_f2i(CPUDADAOState *env, uint64_t src, uint32_t packed)
+{
+    float_status st;
+    uint64_t res;
+    float32 f32 = (float32)src;
+    float64 f64 = (float64)src;
+    uint32_t kind = packed & 0xFF;
+
+    fp_status_init(env, &st);
+    conv_select_mode(env, &st, packed);
+    switch (kind) {
+    case 0:  /* ft2it */
+        res = (uint64_t)(int64_t)float32_to_int32(f32, &st);
+        break;
+    case 1:  /* ft2io */
+        res = (uint64_t)float32_to_int64(f32, &st);
+        break;
+    case 2:  /* ft2ut */
+        res = (uint64_t)(uint32_t)float32_to_uint32(f32, &st);
+        break;
+    case 3:  /* ft2uo */
+        res = (uint64_t)float32_to_uint64(f32, &st);
+        break;
+    case 4:  /* fo2it */
+        res = (uint64_t)(int64_t)float64_to_int32(f64, &st);
+        break;
+    case 5:  /* fo2io */
+        res = (uint64_t)float64_to_int64(f64, &st);
+        break;
+    case 6:  /* fo2ut */
+        res = (uint64_t)(uint32_t)float64_to_uint32(f64, &st);
+        break;
+    default: /* fo2uo */
+        res = (uint64_t)float64_to_uint64(f64, &st);
+        break;
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* convert_i2f (int→float): direction from the low 6 bits (one-hot or 0x20
+ * dynamic), IEEE flags (may be inexact).  32-bit source integers live in the
+ * low 32 bits of rd and are sign- or zero-extended according to signedness;
+ * ft results are zero-extended to 64b.
+ *
+ * kind: 0 it2ft, 1 io2ft, 2 ut2ft, 3 uo2ft,
+ *       4 it2fo, 5 io2fo, 6 ut2fo, 7 uo2fo */
+uint64_t helper_fp_cvt_i2f(CPUDADAOState *env, uint64_t src, uint32_t packed)
+{
+    float_status st;
+    uint64_t res;
+    uint32_t kind = packed & 0xFF;
+
+    fp_status_init(env, &st);
+    conv_select_mode(env, &st, packed);
+    switch (kind) {
+    case 0:  /* it2ft: int32 (sign-extend low 32) */
+        res = (uint64_t)(uint32_t)int32_to_float32((int32_t)(uint32_t)src, &st);
+        break;
+    case 1:  /* io2ft: int64 */
+        res = (uint64_t)(uint32_t)int64_to_float32((int64_t)src, &st);
+        break;
+    case 2:  /* ut2ft: uint32 */
+        res = (uint64_t)(uint32_t)uint32_to_float32((uint32_t)src, &st);
+        break;
+    case 3:  /* uo2ft: uint64 */
+        res = (uint64_t)(uint32_t)uint64_to_float32(src, &st);
+        break;
+    case 4:  /* it2fo */
+        res = (uint64_t)int32_to_float64((int32_t)(uint32_t)src, &st);
+        break;
+    case 5:  /* io2fo */
+        res = (uint64_t)int64_to_float64((int64_t)src, &st);
+        break;
+    case 6:  /* ut2fo */
+        res = (uint64_t)uint32_to_float64((uint32_t)src, &st);
+        break;
+    default: /* uo2fo */
+        res = (uint64_t)uint64_to_float64(src, &st);
+        break;
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ── FP softfloat arithmetic + root family (QEMU-037t) ───────────────── */
+/*
+ * S2D1 (addition/subtraction/multiplication/division/remainder/scaleB) and
+ * S1D1 (square root) reused from the upstream softfloat.
+ *
+ * Sources:
+ *   spec/SimRISC-07 §S2D1 / §S1D1
+ *   .tao/contracts/contract-fp.md §5/§6
+ *   spec/SimRISC-00 §浮点状态寄存器
+ *
+ * kind (helper_fp_arith): 0..5  = ft add/sub/mul/div/rem/scalb
+ *                         6..11 = fo add/sub/mul/div/rem/scalb
+ * The rf0 rounding mode and accrued flags are handled by fp_status_init() /
+ * fp_status_commit() exactly as for the conversion family.
+ */
+
+/* scaleB's exponent is rdHD, a signed 64-bit integer (SimRISC-07 §2.1;
+ * SPEC-181t F5.2 C1).  scalbn() takes an int; clamp out-of-range exponents so
+ * that a huge positive one overflows to ±Inf (OF) and a huge negative one
+ * underflows toward zero (UF/NX), per IEEE 754 scaleB. */
+static int fp_scaleb_exp(uint64_t raw)
+{
+    int64_t exp = (int64_t)raw;
+
+    if (exp > 0x7fffffff) {
+        return 0x7fffffff;
+    }
+    if (exp < -0x7fffffff - 1) {
+        return -0x7fffffff - 1;
+    }
+    return (int)exp;
+}
+
+uint64_t helper_fp_arith(CPUDADAOState *env, uint64_t a, uint64_t b,
+                         uint32_t kind)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    switch (kind) {
+    case 0:  /* ftadd */
+        res = (uint64_t)(uint32_t)float32_add((float32)a, (float32)b, &st);
+        break;
+    case 1:  /* ftsub */
+        res = (uint64_t)(uint32_t)float32_sub((float32)a, (float32)b, &st);
+        break;
+    case 2:  /* ftmul */
+        res = (uint64_t)(uint32_t)float32_mul((float32)a, (float32)b, &st);
+        break;
+    case 3:  /* ftdiv */
+        res = (uint64_t)(uint32_t)float32_div((float32)a, (float32)b, &st);
+        break;
+    case 4:  /* ftrem: IEEE 754 remainder (nearest quotient, ties to even) */
+        res = (uint64_t)(uint32_t)float32_rem((float32)a, (float32)b, &st);
+        break;
+    case 5:  /* ftsclb: rfHC * 2^rdHD (rdHD = signed 64-bit exponent) */
+        res = (uint64_t)(uint32_t)float32_scalbn((float32)a,
+                                                 fp_scaleb_exp(b), &st);
+        break;
+    case 6:  /* foadd */
+        res = (uint64_t)float64_add((float64)a, (float64)b, &st);
+        break;
+    case 7:  /* fosub */
+        res = (uint64_t)float64_sub((float64)a, (float64)b, &st);
+        break;
+    case 8:  /* fomul */
+        res = (uint64_t)float64_mul((float64)a, (float64)b, &st);
+        break;
+    case 9:  /* fodiv */
+        res = (uint64_t)float64_div((float64)a, (float64)b, &st);
+        break;
+    case 10: /* forem */
+        res = (uint64_t)float64_rem((float64)a, (float64)b, &st);
+        break;
+    default: /* 11 fosclb */
+        res = (uint64_t)float64_scalbn((float64)a,
+                                       fp_scaleb_exp(b), &st);
+        break;
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* rootn(x, 2): the translate layer has already enforced n == 2 and selects
+ * the format via isdbl (0 = ft/float32, 1 = fo/float64). */
+uint64_t helper_fp_root(CPUDADAOState *env, uint64_t x, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    if (isdbl) {
+        res = (uint64_t)float64_sqrt((float64)x, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_sqrt((float32)x, &st);
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ── roundToIntegral 六档 (QEMU-072t) ────────────────────────────────── */
+/*
+ * ftrnd/fornd: immu6 is a one-hot *rounding code*, not a register count
+ * (SimRISC-07 §取整（roundToIntegral）, contract-fp.md §18):
+ *   0x01 ties-to-even / 0x02 ties-away / 0x04 toward-zero /
+ *   0x08 toward-+inf / 0x10 toward--inf  ⇒ static directions;
+ *   0x20 roundToIntegralExact ⇒ direction from rf0[33:32].
+ * The translate layer has already rejected every other immu6 value.
+ *
+ * Static directions must be independent of rf0[33:32] *and* must not accrue
+ * NX, so the call runs on a status copy with the static mode and only NV is
+ * merged back.  The dynamic code runs on the rf0-derived status and merges
+ * NV|NX (roundToIntegralExact semantics).
+ */
+static FloatRoundMode fp_round_code_mode(uint32_t code)
+{
+    switch (code) {
+    case 0x01:
+        return float_round_nearest_even;
+    case 0x02:
+        return float_round_ties_away;
+    case 0x04:
+        return float_round_to_zero;
+    case 0x08:
+        return float_round_up;
+    default:                    /* 0x10, enforced by the translate layer */
+        return float_round_down;
+    }
+}
+
+uint64_t helper_fp_round_to_int(CPUDADAOState *env, uint64_t x,
+                                uint32_t code, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    /* contract-fp.md §18: every NaN result is a qNaN and the contract fixes
+     * the canonical form (qNaN input ⇒ canonical qNaN; sNaN ⇒ NV + canonical
+     * qNaN), so request the FCSR default qNaN pattern for NaN results. */
+    set_default_nan_mode(1, &st);
+    if (code != 0x20) {
+        set_float_rounding_mode(fp_round_code_mode(code), &st);
+    }
+    if (isdbl) {
+        res = (uint64_t)float64_round_to_int((float64)x, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_round_to_int((float32)x, &st);
+    }
+    if (code == 0x20) {
+        env->rf[0] |= (uint64_t)(get_float_exception_flags(&st)
+                                 & (float_flag_invalid | float_flag_inexact));
+    } else {
+        env->rf[0] |= (uint64_t)(get_float_exception_flags(&st)
+                                 & float_flag_invalid);
+    }
+    return res;
+}
+
+/* minimumNumber/maximumNumber (QEMU-071t, IEEE 754-2019 §9.6 strict form).
+ *   source: spec/SimRISC-07 §2.4, contract-fp.md §19
+ * The whole boundary behaviour lives in upstream softfloat's
+ * float{32,64}_{min,maximum}_number(): ordered comparison with −0 < +0, the
+ * numeric operand for a single NaN (q or s), and NV for any sNaN input.
+ * Two NaNs go through pick_nan(); default-NaN mode turns that into the
+ * canonical qNaN required by the contract (sign 0, payload 0), independent of
+ * which input NaN softfloat would otherwise propagate.  No rounding takes
+ * place, so NX/OF/UF stay clear; fp_status_commit() merges NV as usual.
+ */
+uint64_t helper_fp_minmax(CPUDADAOState *env, uint64_t a, uint64_t b,
+                          uint32_t isdbl, uint32_t ismax)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    set_default_nan_mode(1, &st);
+    if (isdbl) {
+        res = (uint64_t)(ismax
+                         ? float64_maximum_number((float64)a, (float64)b, &st)
+                         : float64_minimum_number((float64)a, (float64)b, &st));
+    } else {
+        res = (uint64_t)(uint32_t)(ismax
+                         ? float32_maximum_number((float32)a, (float32)b, &st)
+                         : float32_minimum_number((float32)a, (float32)b, &st));
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* fusedMultiplyAdd (QEMU-070t, IEEE 754-2019 fusedMultiplyAdd).
+ *   source: spec/SimRISC-07 §融合乘加（fusedMultiplyAdd）,
+ *           contract-fp.md §20
+ * Single rounding is delegated to upstream softfloat's float{32,64}_muladd()
+ * with muladd flags 0 (no negation, no zero-product suppression) — the fused
+ * a*b+c operation, never a separate mul followed by an add.
+ * default-NaN mode canonicalizes every NaN result (contract §20); softfloat's
+ * default infzero-NaN rule keeps 0×Inf raising NV even when the addend is a
+ * NaN.  fp_status_commit() merges the flags once, so NX/OF/UF are raised at
+ * most once for the whole operation.
+ */
+uint64_t helper_fp_muladd(CPUDADAOState *env, uint64_t a, uint64_t b,
+                          uint64_t c, uint32_t isdbl)
+{
+    float_status st;
+    uint64_t res;
+
+    fp_status_init(env, &st);
+    set_default_nan_mode(1, &st);
+    if (isdbl) {
+        res = (uint64_t)float64_muladd((float64)a, (float64)b, (float64)c,
+                                       0, &st);
+    } else {
+        res = (uint64_t)(uint32_t)float32_muladd((float32)a, (float32)b,
+                                                 (float32)c, 0, &st);
+    }
+    fp_status_commit(env, &st);
+    return res;
+}
+
+/* ===================================================================
+ * SEE/HEE run mode + cfx register file + exception flow (QEMU-044t)
+ *
+ * Sources (spec-first):
+ *   spec/DADAO-12-SEE-主管系统运行环境.md §1 (run modes / cfxha table),
+ *     §3 (cg0-cg7 shared registers), §4 (per-cfx registers / monitor exception
+ *     tables), §5 (exception entry steps 1-10 + exception exit).
+ *   spec/DADAO-13-HEE-超管系统运行环境.md §1 (cg3 / hypv reset values).
+ *   spec/SimRISC-11-其它.md §特权指令 (trap/escape/cfx2rd/cfx2rc; reserved =>
+ *     ILLI; non-existent register combination => CFXREG).
+ *   .tao/contracts/contract-see.md §1/§3/§4; spec/Machine-01-测试机运行环境.md.
+ *
+ * Test-machine scope (ADR-0020 D9, Machine-01 §3): only cfx0/1/2/3/63 are
+ * fully implemented, plus cfx4/ptw's Step 1 register subset (PTBR +
+ * ptw_enable, ADR-0039 §8.5), cfx32/pmem's SRAM+DMA (ADR-0042) and
+ * cfx15/cfx34 (single-hart timer + global time, INTEG-050t).  Access to any
+ * other allocated-but-unimplemented cfx => CFXREG.
+ * =================================================================== */
+
+const int dadao_cfxha_map[DADAO_NUM_CFX] = { 0, 1, 2, 3, 4, 15, 32, 34, 63 };
+
+/* cfxha -> compact index into env->cfx[], or -1 if the active profile does not
+ * implement that cfx (spec/Machine-v5 §3 per-profile list).  A profile that
+ * implements no row has no masks/vector/frame for it, so every caller must
+ * treat -1 as "no such cfx" rather than reaching into env->cfx[]. */
+static int cfx_idx(CPUDADAOState *env, int cfxha)
+{
+    int i;
+
+    if (!dadao_cfx_implemented(DADAO_PROFILE(env), cfxha)) {
+        return -1;
+    }
+    for (i = 0; i < DADAO_NUM_CFX; i++) {
+        if (dadao_cfxha_map[i] == cfxha) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* cg0-cg3 shared per-mode register -> pointer (DADAO-12 §3; ADR-0045 D2/D3). */
+static uint64_t *cfx_mode_reg(int ci, DADAOCfxModeRegs *m, int rc)
+{
+    switch (rc) {
+    case 0:  return &m->cfxtrap;
+    case 1:  return &m->cfxmem;
+    case 2:  return &m->cfxreg;
+    case 3:  return &m->cfxexe;
+    case 4:  return &m->cfx_intr_mask;
+    case 8:  return &m->switch_run_mode;
+    case 10: return &m->excp_vector;
+    case 12: return (ci >= 0) ? &m->cg_reg_deleg : NULL;   /* cg3 only */
+    default: return NULL;
+    }
+}
+
+/*
+ * cg7 internal space description (DADAO-12 §3.8): 16 blocks of 4 words,
+ * rc = 4i+0..3 = desc / start / size / attr.  desc bit0 = exists, bits1-5 =
+ * SRAM/ROM/MMIO/DRAM/OTHER (one-hot when exists); attr bit0 = R, bit1 = W,
+ * bit2 = X, bit3 = cacheable, bit4 = shareable, bit5 = volatile.  cg7 carries
+ * no per-cfx state and is read-only.
+ * Test-machine blocks: smon/hmon/pmem are the §2.1 64 KiB SRAM constants;
+ * the power BootROM interval is derived from the active profile
+ * (spec/Machine-v5 §1.1: Node 4 MiB at cfx offset 0x3ff_ffc0_0000; Tiny has
+ * no cfx at all, so this branch is unreachable there).  Every other block
+ * (space[1..15] and cfx0/1/4/...) reads 0.
+ */
+static uint64_t dadao_cg7_space_reg(const DadaoProfile *prof, int cfxha,
+                                    unsigned rc)
+{
+    static const uint64_t smon[4] = {
+        0x3,                    /* desc: exists | SRAM */
+        0x3FF00000000ULL,       /* start: 0x3ff_0000_0000 */
+        0x10000ULL,             /* size:  64 KiB */
+        0x7,                    /* attr: R | W | X */
+    };
+    static const uint64_t pmem[4] = {
+        0x3,                    /* desc: exists | SRAM */
+        0x3FF00000000ULL,       /* start: 0x3ff_0000_0000 */
+        0x10000ULL,             /* size:  64 KiB */
+        0x3,                    /* attr: R | W (X = 0) */
+    };
+    uint64_t power[4] = {
+        0x5,                            /* desc: exists | ROM */
+        prof->rom_base & ((1ULL << 42) - 1), /* start: cfx offset */
+        prof->rom_size,                 /* size:  BootROM (profile) */
+        0x5,                            /* attr: R | X */
+    };
+    const uint64_t *blk;
+
+    if (rc / 4 != 0) {
+        return 0;               /* space[1..15]: exists = 0 => all fields 0 */
+    }
+    switch (cfxha) {
+    case 2:                     /* cfx_smon */
+    case 3:                     /* cfx_hmon */
+        blk = smon;
+        break;
+    case 32:                    /* cfx_pmem */
+        blk = pmem;
+        break;
+    case 63:                    /* cfx_power */
+        blk = power;
+        break;
+    default:
+        return 0;               /* umon/jmon/ptw: 16 blocks all empty */
+    }
+    return blk[rc % 4];
+}
+
+/*
+ * Resolve (cfxha, cg, rc) to a register pointer.  Returns NULL for any
+ * non-existent register combination or a read/write permission mismatch
+ * (DADAO-12 §3: rc >= scratch_regs_num => CFXREG; SimRISC-11 §特权指令:
+ * "读写权限不匹配时触发 CFXREG").  cg3 is only accessible in hypv
+ * (DADAO-13 §1).  cg7 is answered before this call from the static space
+ * table (DADAO-12 §3.8).  Callers must handle reserved/unimplemented cfxha
+ * first.
+ */
+static uint64_t *cfx_reg_ptr(CPUDADAOState *env, int ci, int cg, int rc,
+                             bool write)
+{
+    DADAOCfxRegs *r = &env->cfx[ci];
+
+    if (cg <= 2) {
+        if (rc <= 4 || (rc >= 8 && rc <= 11)) {
+            return cfx_mode_reg(ci, &r->mode[cg], rc);
+        }
+        return NULL;
+    }
+    if (cg == 3) {
+        if (env->inner_run_mode != DADAO_MODE_HYPV) {
+            return NULL;   /* cg3 only in hypv (DADAO-13 §1) => CFXREG */
+        }
+        if ((rc <= 4) || (rc >= 8 && rc <= 12)) {
+            return cfx_mode_reg(ci, &r->mode[3], rc);
+        }
+        return NULL;
+    }
+    switch (cg) {
+    case 4:
+        switch (rc) {
+        case 0: return write ? NULL : &r->cfx_id;
+        case 1: return write ? NULL : &r->version;
+        case 2: return write ? NULL : &r->trap_num;
+        case 3: return write ? NULL : &r->excp_sync_num;
+        case 4: return write ? NULL : &r->excp_async_num;
+        case 5: return write ? NULL : &r->escape_num;
+        case 6: return write ? NULL : &r->scratch_regs_num;
+        default: return NULL;
+        }
+    case 5:
+        switch (rc) {
+        case 0: return &r->prev_run_mode;
+        case 2: return write ? NULL : &r->cause_id;
+        case 3: return &r->cause_ip;
+        case 4: return write ? NULL : &r->cause_info;
+        case 5: return &r->pending;
+        default: return NULL;
+        }
+    case 6:
+        if ((uint64_t)rc >= r->scratch_regs_num) {
+            return NULL;   /* rc >= N => CFXREG (DADAO-12 §3) */
+        }
+        return &r->scratch[rc];
+    case 8:
+        /* cfx0-3: global_cfx_intr_mask (cg8 rc1; ADR-0045 D3). */
+        if (ci >= 0 && dadao_cfxha_map[ci] < 4 && rc == 1) {
+            return &r->global_cfx_intr_mask;
+        }
+        /* cfx_ptw only: Step 1 PTW enable (DADAO-12 §4.5). */
+        return (ci >= 0 && dadao_cfxha_map[ci] == 4 && rc == 8)
+               ? &env->ptw_enable : NULL;
+    case 9:
+        /* cfx_ptw only: the single PTBR (DADAO-12 §4.5). */
+        return (ci >= 0 && dadao_cfxha_map[ci] == 4 && rc == 0)
+               ? &env->ptbr : NULL;
+    case 12:
+        /* cfx_ptw only: TLB maintenance interface (DADAO-12 §4.5;
+         * ADR-0041 D3).  rc0 is a write-only command trigger. */
+        if (ci < 0 || dadao_cfxha_map[ci] != DADAO_CFXHA_PTW) {
+            return NULL;
+        }
+#ifdef CONFIG_USER_ONLY
+        /* No PTW/TLB in the user-mode build: explicit CFXREG, no stub. */
+        return NULL;
+#else
+        switch (rc) {
+        case 0: return write ? &env->tlb_control : NULL;
+        case 1: return &env->tlb_asid;      /* 16-bit ASID */
+        case 2: return &env->tlb_start;
+        case 3: return &env->tlb_size;
+        default: return NULL;
+        }
+#endif
+    default:
+        return NULL;
+    }
+}
+
+/*
+ * DADAO-12 §5.2 exception-entry flow (steps 1-7).  `target` is the initially
+ * determined target cfxha (from step 1); `sync` selects the sync/async
+ * masking behaviour.  Returns the exception vector to jump to; *entered is
+ * set to false when the exception is masked and only records `pending`.
+ *
+ * Sync exceptions are never masked (§5.2 step 2); async ones are filtered only
+ * by the two source masks (step 3).
+ */
+static uint64_t cfx_enter(CPUDADAOState *env, uint64_t cause, int target,
+                          uint64_t cause_ip, uint64_t cause_info,
+                          bool sync, bool *entered)
+{
+    uint8_t entry_mode = env->inner_run_mode;
+    int ci = cfx_idx(env, target);
+    uint64_t vec;
+
+    if (ci < 0) {
+        /* A frame can only exist for an implemented cfx. */
+        *entered = false;
+        return 0;
+    }
+    /* step 3 (async only): two-level interrupt source filter (ADR-0045 D3).
+     * The current cfx's cfx_intr_mask and the current mode monitor's
+     * global_cfx_intr_mask both mask by source cfxha; either one set =>
+     * pending, no delivery. */
+    if (!sync) {
+        int cur = cfx_idx(env, env->inner_cfx_code);
+        uint64_t cur_mask = (cur >= 0)
+            ? env->cfx[cur].mode[entry_mode].cfx_intr_mask : 0;
+        uint64_t global_mask =
+            env->cfx[entry_mode & 0x3].global_cfx_intr_mask;
+
+        if ((cur_mask & (1ULL << target)) ||
+            (global_mask & (1ULL << target))) {
+            env->cfx[ci].pending |= cause;
+            *entered = false;
+            return 0;
+        }
+    }
+
+    /* step 4: increment the trap / sync / async counter. */
+    if (cause == DADAO_CAUSE_CFXTRAP) {
+        env->cfx[ci].trap_num++;
+    } else if (!sync) {
+        env->cfx[ci].excp_async_num++;
+    } else {
+        env->cfx[ci].excp_sync_num++;
+    }
+    /* step 5: save the previous run mode (no independent cfx-mask state). */
+    env->cfx[ci].prev_run_mode = entry_mode;
+    /* step 6: switch run mode to the <entry_mode> switch value; the cfx
+     * target changes but there is no cfx-mask layer to switch.
+     * HSJU permission is re-checked on every tlb_fill against the entry, so the
+     * derived translation cache must not survive a run-mode change: guest TLB
+     * entries stay (only QEMU's cache of their result is dropped). */
+    dadao_soft_tlb_flush(env);
+    vec = env->cfx[ci].mode[entry_mode].excp_vector;
+    env->inner_run_mode = env->cfx[ci].mode[entry_mode].switch_run_mode & 0x3;
+    if (!DADAO_PROFILE(env)->user_mode) {
+        /* Machine-v5 §2: Tiny provides no mode-switch path -- the run mode is
+         * fixed at hypv, so a software-written switch value cannot leave it. */
+        env->inner_run_mode = DADAO_MODE_HYPV;
+    }
+    env->inner_cfx_code = (uint8_t)target;
+    /* step 5 continued: record cause ip / id / info */
+    env->cfx[ci].cause_ip = cause_ip;
+    env->cfx[ci].cause_id = cause;
+    env->cfx[ci].cause_info = cause_info;
+    /* step 7: jump to the exception vector */
+    *entered = true;
+    return vec;
+}
+
+/* Enter the flow and set the next PC (vector on entry, pc+4 when masked). */
+static void cfx_raise(CPUDADAOState *env, uint64_t cause, int target,
+                      uint64_t pc, uint64_t cause_info)
+{
+    bool entered;
+    uint64_t vec = cfx_enter(env, cause, target, pc, cause_info, true, &entered);
+    env->pc = entered ? vec : pc + 4;
+    env->rb[0] = env->pc;
+}
+
+/* CFXPERM is delivered to the monitor of the current run mode (cfx0-3). */
+static void cfx_raise_perm(CPUDADAOState *env, uint64_t info, uint64_t pc)
+{
+    cfx_raise(env, DADAO_CAUSE_CFXPERM, env->inner_run_mode, pc, info);
+}
+
+/* D9: entering a frame saves the entry-mode monitor's global_cfx_intr_mask and
+ * blocks every async source while the single frame is live; escape restores
+ * it.  Shared by the sync trap path and the async arbiter so that both record
+ * the frame's saved mask and neither can deliver a second source inside it. */
+static void cfx_frame_block_async(CPUDADAOState *env, int ci, uint8_t entry_mode)
+{
+    int mon = entry_mode & 0x3;
+
+    env->cfx[ci].saved_global_intr_mask = env->cfx[mon].global_cfx_intr_mask;
+    env->cfx[ci].saved_intr_monitor = (uint8_t)mon;
+    env->cfx[ci].saved_intr_mask_valid = true;
+    env->cfx[mon].global_cfx_intr_mask = ~0ULL;
+}
+
+/* ===================================================================
+ * cfx_pmem SRAM + DMA (spec/DADAO-12 §2.1/§4.9; ADR-0042 D3/D4/D6/D7)
+ *
+ * The DMA moves at most 64 KiB between the cfx_pmem SRAM and physical memory.
+ * Registers are cfx_pmem cg15 rc0..rc4; START launches the transfer, which
+ * completes asynchronously on a virtual-clock timer so that BUSY is
+ * observable (the transfer itself is one memcpy).
+ * =================================================================== */
+#ifndef CONFIG_USER_ONLY
+
+/* Completion latency of the test-machine DMA (virtual clock). */
+#define DADAO_PMEM_DMA_DELAY_NS  1000000ULL   /* 1 ms */
+
+/* Re-raise CPU_INTERRUPT_HARD when a source is still pending; defined with the
+ * arbitration block next to the cfx_hart timer section below.  The DMA
+ * completion runs before that definition, hence the forward declaration. */
+static void dadao_async_kick(CPUDADAOState *env);
+
+static bool dadao_pmem_dma_pa_ok(uint64_t pa, uint64_t len, bool write)
+{
+    uint64_t end = pa + len;
+
+    if (pa >= DADAO_RAM_BASE && end <= DADAO_RAM_BASE + DADAO_RAM_SIZE) {
+        return true;
+    }
+    /* Node RAM starts at PA 0 (the first page table lives at PTBR=0), so the
+     * low alias is the same range; kept for a profile whose RAM base is not
+     * zero (ADR-0043 D10). */
+    if (pa >= DADAO_RAM_ALIAS_BASE &&
+        end <= DADAO_RAM_ALIAS_BASE + DADAO_RAM_SIZE) {
+        return true;
+    }
+    /* The boot ROM is readable, never writable. */
+    if (!write && pa >= DADAO_ROM_BASE && end <= DADAO_ROM_BASE + DADAO_ROM_SIZE) {
+        return true;
+    }
+    return false;
+}
+
+static void dadao_pmem_dma_complete(void *opaque)
+{
+    CPUState *cs = opaque;
+    CPUDADAOState *env = cpu_env(cs);
+    g_autofree uint8_t *buf = NULL;
+    MemTxResult res;
+    bool dir = env->pmem_dma_dir;
+    uint64_t err = 0;
+
+    if (!(env->pmem_dma_status & DADAO_PMEM_DMA_BUSY)) {
+        return;                       /* defensive: no transfer in flight */
+    }
+
+    buf = g_malloc(env->pmem_dma_len);
+    if (dir == 0) {
+        /* CFX -> PA */
+        res = address_space_read(&address_space_memory,
+                                 DADAO_PMEM_SRAM_HOST_BASE + env->pmem_dma_cfx_off,
+                                 MEMTXATTRS_UNSPECIFIED, buf, env->pmem_dma_len);
+        if (res == MEMTX_OK) {
+            res = address_space_write(&address_space_memory, env->pmem_dma_pa,
+                                      MEMTXATTRS_UNSPECIFIED, buf,
+                                      env->pmem_dma_len);
+        }
+    } else {
+        /* PA -> CFX */
+        res = address_space_read(&address_space_memory, env->pmem_dma_pa,
+                                 MEMTXATTRS_UNSPECIFIED, buf, env->pmem_dma_len);
+        if (res == MEMTX_OK) {
+            res = address_space_write(&address_space_memory,
+                                      DADAO_PMEM_SRAM_HOST_BASE + env->pmem_dma_cfx_off,
+                                      MEMTXATTRS_UNSPECIFIED, buf,
+                                      env->pmem_dma_len);
+        }
+    }
+
+    env->pmem_dma_status &= ~DADAO_PMEM_DMA_BUSY;
+    if (res != MEMTX_OK) {
+        err = DADAO_PMEM_DMA_ERR_PA_FAULT;
+        env->pmem_dma_status |= DADAO_PMEM_DMA_ERROR |
+                                (err << DADAO_PMEM_DMA_ERR_CODE_SHIFT);
+    } else {
+        env->pmem_dma_status |= DADAO_PMEM_DMA_DONE;
+    }
+
+    if (env->pmem_dma_irq_en) {
+        /* The pending record is the target cfx's cg5 rc5 bit8 (INTEG-051t);
+         * the arbiter turns it into a delivery. */
+        int ci = cfx_idx(env, DADAO_CFXHA_PMEM);
+
+        if (ci >= 0) {
+            env->cfx[ci].pending |= DADAO_CAUSE_PMEM_DMA;
+        }
+        dadao_async_kick(env);
+    }
+}
+
+/*
+ * START (dma_ctrl bit0): validate size / SRAM range / PA range / PA target.
+ * Setup errors never start a transfer (BUSY stays 0) and set ERROR + ERR_CODE.
+ */
+static void dadao_pmem_dma_start(CPUDADAOState *env, uint64_t ctrl)
+{
+    uint64_t dir = (ctrl & DADAO_PMEM_DMA_CTRL_DIR) ? 1 : 0;
+    uint64_t cfx_addr = (dir ? env->pmem_dma_dst : env->pmem_dma_src) &
+                        DADAO_VA_MASK;
+    uint64_t pa = (dir ? env->pmem_dma_src : env->pmem_dma_dst) &
+                  0x00FFFFFFFFFFFFFFULL;              /* PA[55:0] */
+    uint64_t size = env->pmem_dma_size & 0x3FFFFFFFULL;  /* 30-bit field */
+    uint64_t err = 0;
+
+    if (size == 0 || size > (1ULL << 29)) {
+        err = DADAO_PMEM_DMA_ERR_SIZE;
+    } else if (size > DADAO_PMEM_SRAM_SIZE) {
+        err = DADAO_PMEM_DMA_ERR_CFX_RANGE;
+    } else if (cfx_addr < DADAO_PMEM_SRAM_CFX_OFFSET ||
+               cfx_addr - DADAO_PMEM_SRAM_CFX_OFFSET >
+                   DADAO_PMEM_SRAM_SIZE - size) {
+        err = DADAO_PMEM_DMA_ERR_CFX_RANGE;
+    } else if (size > (1ULL << 56) - pa) {
+        err = DADAO_PMEM_DMA_ERR_PA_RANGE;
+    } else if (!dadao_pmem_dma_pa_ok(pa, size, dir == 0)) {
+        err = DADAO_PMEM_DMA_ERR_PA_FAULT;
+    }
+
+    if (err) {
+        env->pmem_dma_status |= DADAO_PMEM_DMA_ERROR |
+                                (err << DADAO_PMEM_DMA_ERR_CODE_SHIFT);
+        if (env->pmem_dma_irq_en) {
+            int ci = cfx_idx(env, DADAO_CFXHA_PMEM);
+
+            if (ci >= 0) {
+                env->cfx[ci].pending |= DADAO_CAUSE_PMEM_DMA;
+            }
+            dadao_async_kick(env);
+        }
+        return;
+    }
+
+    env->pmem_dma_dir = dir;
+    env->pmem_dma_cfx_off = cfx_addr - DADAO_PMEM_SRAM_CFX_OFFSET;
+    env->pmem_dma_pa = pa;
+    env->pmem_dma_len = size;
+    env->pmem_dma_status |= DADAO_PMEM_DMA_BUSY;
+    timer_mod(env->pmem_dma_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + DADAO_PMEM_DMA_DELAY_NS);
+}
+
+/* cfx_pmem cg15 read (rc0..rc4).  Returns false for a reserved rc (CFXREG). */
+static bool dadao_pmem_dma_reg_read(CPUDADAOState *env, uint32_t rc,
+                                    uint64_t *val)
+{
+    switch (rc) {
+    case 0: *val = env->pmem_dma_src; return true;
+    case 1: *val = env->pmem_dma_dst; return true;
+    case 2: *val = env->pmem_dma_size & 0x3FFFFFFFULL; return true;
+    case 3: *val = env->pmem_dma_ctrl & ~DADAO_PMEM_DMA_CTRL_START; return true;
+    case 4: *val = env->pmem_dma_status; return true;
+    default: return false;
+    }
+}
+
+/*
+ * cfx_pmem cg15 write (rc0..rc4).  While BUSY, writes to rc0..rc3 and the
+ * DONE/ERROR W1C of rc4 are ignored (DADAO-12 §4.9).  Returns false for a
+ * reserved rc (CFXREG).
+ */
+static bool dadao_pmem_dma_reg_write(CPUDADAOState *env, uint32_t rc,
+                                     uint64_t val)
+{
+    bool busy = (env->pmem_dma_status & DADAO_PMEM_DMA_BUSY) != 0;
+
+    switch (rc) {
+    case 0:
+        if (!busy) {
+            env->pmem_dma_src = val;
+        }
+        return true;
+    case 1:
+        if (!busy) {
+            env->pmem_dma_dst = val;
+        }
+        return true;
+    case 2:
+        if (!busy) {
+            env->pmem_dma_size = val & 0x3FFFFFFFULL;
+        }
+        return true;
+    case 3:
+        if (busy) {
+            return true;
+        }
+        /* START self-clears; DIR/IRQ_EN read back what was written. */
+        env->pmem_dma_ctrl = val & (DADAO_PMEM_DMA_CTRL_DIR |
+                                    DADAO_PMEM_DMA_CTRL_IRQ_EN);
+        env->pmem_dma_irq_en = (val & DADAO_PMEM_DMA_CTRL_IRQ_EN) ? 1 : 0;
+        if (val & DADAO_PMEM_DMA_CTRL_START) {
+            dadao_pmem_dma_start(env, val);
+        }
+        return true;
+    case 4:
+        if (busy) {
+            return true;              /* W1C ignored while BUSY */
+        }
+        if (val & DADAO_PMEM_DMA_DONE) {
+            env->pmem_dma_status &= ~DADAO_PMEM_DMA_DONE;
+        }
+        if (val & DADAO_PMEM_DMA_ERROR) {
+            env->pmem_dma_status &= ~(DADAO_PMEM_DMA_ERROR |
+                                      DADAO_PMEM_DMA_ERR_CODE_MASK);
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+void dadao_pmem_dma_init(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->pmem_dma_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       dadao_pmem_dma_complete, cs);
+}
+
+void dadao_pmem_dma_reset(CPUDADAOState *env)
+{
+    if (env->pmem_dma_timer) {
+        timer_del(env->pmem_dma_timer);
+    }
+    env->pmem_dma_src = 0;
+    env->pmem_dma_dst = 0;
+    env->pmem_dma_size = 0;
+    env->pmem_dma_ctrl = 0;
+    env->pmem_dma_status = 0;
+    env->pmem_dma_dir = 0;
+    env->pmem_dma_irq_en = 0;
+    env->pmem_dma_cfx_off = 0;
+    env->pmem_dma_pa = 0;
+    env->pmem_dma_len = 0;
+}
+
+#else /* CONFIG_USER_ONLY */
+
+/*
+ * The linux-user build has no system address space and no cfx internal SRAM:
+ * the cfx_pmem cg15 interface is withheld explicitly (CFXREG), never a
+ * silent success.
+ */
+static bool dadao_pmem_dma_reg_read(CPUDADAOState *env, uint32_t rc,
+                                    uint64_t *val)
+{
+    (void)env; (void)rc; (void)val;
+    return false;
+}
+
+static bool dadao_pmem_dma_reg_write(CPUDADAOState *env, uint32_t rc,
+                                     uint64_t val)
+{
+    (void)env; (void)rc; (void)val;
+    return false;
+}
