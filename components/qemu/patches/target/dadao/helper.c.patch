+static int cfx_idx(CPUDADAOState *env, int cfxha);
+
+/* Two-axis permission check (ADR-0045 D1/D2): the target cfx owns four
+ * per-mode source masks.  The mode axis selects `mode[inner_run_mode]`; the
+ * cfx axis tests the current cfx's bit.  Self bypasses only the cfx axis. */
+enum {
+    DADAO_CFX_PERM_TRAP = 0,
+    DADAO_CFX_PERM_MEM,
+    DADAO_CFX_PERM_REG,
+    DADAO_CFX_PERM_EXE,
+};
+
+static bool cfx_perm_denied(CPUDADAOState *env, int target, int kind)
+{
+    DADAOCfxModeRegs *m;
+    uint64_t mask;
+    int ci = cfx_idx(env, target);
+
+    if (ci < 0) {
+        return false;
+    }
+    if (target == env->inner_cfx_code) {
+        return false;                 /* self: cfx axis bypassed */
+    }
+    m = &env->cfx[ci].mode[env->inner_run_mode & 0x3];
+    switch (kind) {
+    case DADAO_CFX_PERM_TRAP: mask = m->cfxtrap; break;
+    case DADAO_CFX_PERM_MEM:  mask = m->cfxmem;  break;
+    case DADAO_CFX_PERM_REG:  mask = m->cfxreg;  break;
+    default:                  mask = m->cfxexe;  break;
+    }
+    return (mask & (1ULL << (env->inner_cfx_code & 0x3F))) != 0;
+}
+
+/* supv 访问目标 cfx 的 cg 需其 hypv_cg_reg_deleg 对应位 = 0 (DADAO-13 §1)。
+ * cg3 不作例外：其 bit3 恒 1 => supv 恒拒（CFXPERM）；hypv/user/jail 不受本检查约束。
+ * 软件侧「整组开放」的写法是 0x8（除恒 1 的 bit3 外无置位），硬件仍按位判定。 */
+static bool cfx_deleg_denied(CPUDADAOState *env, int ci, int cg)
+{
+    uint64_t mask;
+
+    if (env->inner_run_mode != DADAO_MODE_SUPV || cg > 63) {
+        return false;
+    }
+    mask = env->cfx[ci].mode[DADAO_MODE_HYPV].cg_reg_deleg;
+    return (mask & (1ULL << cg)) != 0;
+}
