+/* ===================================================================
+ * cfx_time (cfxha 34) + single-hart cfx_hart timer (cfxha 15)
+ * (spec/DADAO-12 §4.7/§4.10; contract-see §3; INTEG-050t/INTEG-051t)
+ *
+ * cfx_time_value and cfx_hart_cycle are derived from QEMU_CLOCK_VIRTUAL
+ * (test-machine model: 1 count = 1 ns, epoch = reset time_base_ns).  cfx_hart
+ * insn is accumulated per TB by translate.c.  The timer is one-shot and its
+ * deadline is a 64-bit absolute cfx_time value; TIMER (1 << 10) is maskable
+ * with cause_info = 0.  A pending TIMER lives in the target cfx's cg5 rc5
+ * (cfx_hart bit10); the unified arbiter below only selects (INTEG-051t).
+ * =================================================================== */
+
+static uint64_t dadao_time_now_ns(void)
+{
+#ifdef CONFIG_USER_ONLY
+    /* linux-user has no QEMU_CLOCK_VIRTUAL; reads stay non-faulting. */
+    return 0;
+#else
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+#endif
+}
+
+static uint64_t dadao_time_value(CPUDADAOState *env)
+{
+    uint64_t now = dadao_time_now_ns();
+
+    return (now >= env->time_base_ns) ? now - env->time_base_ns : 0;
+}
+
+static bool dadao_time_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg10 rc0: time_freq (Hz) */
+        *val = DADAO_TIME_FREQ;
+        return true;
+    case 1:                             /* cg10 rc1: time_value (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool dadao_hart_istatus(CPUDADAOState *env)
+{
+    return (env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) &&
+           (env->hart_timer_cmp != ~0ULL) &&
+           (dadao_time_value(env) >= env->hart_timer_cmp);
+}
+
+static bool dadao_hart_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cg8 rc0: hart_id (single hart) */
+        *val = 0;
+        return true;
+    case 2:                             /* cg8 rc2: cycle (64-bit) */
+        *val = dadao_time_value(env);
+        return true;
+    case 3:                             /* cg8 rc3: insn (64-bit) */
+        *val = env->hart_insn;
+        return true;
+#ifdef CONFIG_USER_ONLY
+    case 4:
+    case 5:
+        return false;                   /* timer regs withheld: CFXREG */
+#else
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+        *val = env->hart_timer_cmp;
+        return true;
+    case 5:                             /* cg8 rc5: ctrl[1:0] | ISTATUS << 2 */
+        *val = (env->hart_timer_ctrl & (DADAO_HART_TIMER_ENABLE |
+                                        DADAO_HART_TIMER_IMASK)) |
+               (dadao_hart_istatus(env) ? DADAO_HART_TIMER_ISTATUS : 0);
+        return true;
+#endif
+    default:                            /* rc1/rc6/rc7/others: reserved */
+        return false;
+    }
+}
+
+/* ── cfx_cache register face (contract-cache §1/§2; m16-qemu-001) ──────
+ * Register numbers and bit positions come from contract-cache, never from
+ * this implementation:
+ *   cg8 rc0  cache_exist      RO   bit0 = I, bit1 = D (CACHE-03/06)
+ *   cg8 rc8  cache_enable     RW   bit0 = I, bit1 = D (CACHE-03/07)
+ *   cg8 rc9  cache_ctrl       WO   write-executes a command (CACHE-03/09)
+ *   cg8 rc10 cache_addr_start RW   PA[55:0]; [63:56] read 0 (CACHE-03/18)
+ *   cg8 rc11 cache_addr_size  RW   byte count (CACHE-03)
+ * Any other rc of cg8 is reserved => CFXREG (CACHE-04).  The shared cg0-cg7
+ * rows are contract-required for every cfx (contract-see §3) and are served
+ * by the generic cfx_reg_ptr path; cfx5 does not special-case them.
+ *
+ * `cache-model` only decides *effects* (user ruling 2026-11-22): with `on`
+ * the machine reports I+D (`cache_exist` = 0b11, CACHE-27) and with `off` it
+ * reports no cache (`cache_exist` = 0) -- but the register face answers in
+ * both settings, and a legal `cache_ctrl` write is accepted and completes
+ * synchronously (CACHE-24/CACHE-25); with the shadow D-cache absent (`off`)
+ * the maintenance action itself has no effect (CACHE-27).  An illegal
+ * encoding still raises CFXREG before any maintenance action.
+ */
+/* cache_ctrl fields (CACHE-09): [1:0] op, [3:2] range, [15:14] selection
+ * (bit15 = I, bit14 = D).  Unused bits are reserved and ignored. */
+#define DADAO_CACHE_CTRL_OP_SHIFT     0
+#define DADAO_CACHE_CTRL_RANGE_SHIFT  2
+#define DADAO_CACHE_CTRL_SEL_SHIFT   14
+#define DADAO_CACHE_CTRL_FIELD_MASK   0x3ULL
+#define DADAO_CACHE_OP_NONE           0x0
+#define DADAO_CACHE_OP_CLEAN          0x1
+#define DADAO_CACHE_OP_INVALIDATE     0x2
+#define DADAO_CACHE_OP_FLUSH          0x3
+#define DADAO_CACHE_RANGE_ALL         0x0
+#define DADAO_CACHE_RANGE_LINE        0x1
+#define DADAO_CACHE_RANGE_SPAN        0x2
+#define DADAO_CACHE_RANGE_RESERVED    0x3
+#define DADAO_CACHE_SEL_NONE          0x0
+#define DADAO_CACHE_SEL_D             0x1   /* bit14 */
+#define DADAO_CACHE_SEL_I             0x2   /* bit15 */
+
+/* ── cache_ctrl maintenance effects (m16-qemu-003) ──────────────────────
+ *
+ * The D side is the shadow array from m16-qemu-002: a line is written back
+ * with address_space_write() to its real PA, which is also the channel the
+ * cfx_pmem DMA uses, so a later DMA read observes exactly what the contract
+ * promises (CACHE-20/CACHE-30).  Only lines of the shadow's RAM window can
+ * exist, which is what makes MMIO/uncacheable PAs a natural no-op
+ * (CACHE-22): such a PA never has a line to match.
+ *
+ * The I side keeps no array (m16-qemu-002 §4: instruction fetch is not
+ * redirected).  Its only modelled state is QEMU's translated-code cache, so
+ * `invalidate`/`flush` drop the translations covering the selected PA range
+ * -- the same effect ARM's `IC IVAU` asks of `tb_invalidate_phys_range()` --
+ * and `clean` is a no-op (CACHE-19).  Guest code on this machine executes
+ * from RAM, so `all` folds onto the shadow's RAM window.
+ */
+#ifndef CONFIG_USER_ONLY
+static bool dadao_cache_line_matches(uint64_t line_pa, unsigned range,
+                                     uint64_t start, uint64_t size)
+{
+    uint64_t end;
+
+    switch (range) {
+    case DADAO_CACHE_RANGE_ALL:
+        return true;                    /* CACHE-15: every line */
+    case DADAO_CACHE_RANGE_LINE:
+        /* CACHE-16: the line that contains addr_start, compared as a
+         * 56-bit PA (no truncation). */
+        return line_pa <= start && start - line_pa < DADAO_DCACHE_LINE_SIZE;
+    case DADAO_CACHE_RANGE_SPAN:
+        /* CACHE-17: [start, start + size) intersects [line_pa, line_pa +
+         * line).  Saturate instead of wrapping on a 64-bit overflow. */
+        end = start + size;
+        if (end < start) {
+            end = UINT64_MAX;
+        }
+        return line_pa < end && start < line_pa + DADAO_DCACHE_LINE_SIZE;
+    default:
+        return false;                   /* reserved: rejected before here */
+    }
+}
+#endif
+
+/* Apply a legal command to the shadow D-cache (CACHE-20/CACHE-24). */
+#ifndef CONFIG_USER_ONLY
+static void dadao_cache_d_maintain(CPUDADAOState *env, unsigned op,
+                                   unsigned range, uint64_t start,
+                                   uint64_t size)
+{
+    DadaoDCache *c = env->dcache;
+    unsigned set, way;
+
+    if (!c) {
+        return;                         /* CACHE-27 off: accepted, no effect */
+    }
+    for (set = 0; set < DADAO_DCACHE_SETS; set++) {
+        for (way = 0; way < DADAO_DCACHE_WAYS; way++) {
+            DadaoDCacheLine *line = &c->line[set][way];
+            uint64_t line_pa;
+
+            if (!line->valid) {
+                continue;
+            }
+            line_pa = dadao_dcache_line_pa(c, set, line->tag);
+            if (!dadao_cache_line_matches(line_pa, range, start, size)) {
+                continue;
+            }
+            if ((op == DADAO_CACHE_OP_CLEAN ||
+                 op == DADAO_CACHE_OP_FLUSH) && line->dirty) {
+                /* clean = write back + clear dirty; flush additionally drops
+                 * the line below.  `invalidate` never takes this branch: its
+                 * dirty data is discarded without a write-back (CACHE-20). */
+                address_space_write(&address_space_memory, line_pa,
+                                    MEMTXATTRS_UNSPECIFIED, line->data,
+                                    DADAO_DCACHE_LINE_SIZE);
+                line->dirty = 0;
+            }
+            if (op == DADAO_CACHE_OP_INVALIDATE ||
+                op == DADAO_CACHE_OP_FLUSH) {
+                line->valid = 0;
+                line->dirty = 0;
+            }
+        }
+    }
+}
+#else
+static void dadao_cache_d_maintain(CPUDADAOState *env, unsigned op,
+                                   unsigned range, uint64_t start,
+                                   uint64_t size)
+{
+    /* User mode has no shadow array (cfx5 is not implemented there). */
+}
+#endif
+
+/* Drop QEMU's translated code for [start, end) (CACHE-19/CACHE-24). */
+static void dadao_cache_i_drop_translations(CPUDADAOState *env,
+                                            uint64_t start, uint64_t end)
+{
+#ifndef CONFIG_USER_ONLY
+    CPUState *cs = env_cpu(env);
+    uint64_t pa = start;
+
+    while (pa < end) {
+        hwaddr xlat = 0, len = end - pa;
+        MemoryRegion *mr;
+
+        mr = address_space_translate(&address_space_memory, pa, &xlat, &len,
+                                     false, MEMTXATTRS_UNSPECIFIED);
+        if (len == 0) {
+            break;                      /* unassigned window: no code there */
+        }
+        len = MIN(len, end - pa);
+        if (memory_region_is_ram(mr)) {
+            /* tb_page_addr_t is a RAMBlock offset, not a guest PA: the
+             * translation supplies both (invalidate_and_set_dirty() does the
+             * same conversion after a plain RAM write). */
+            ram_addr_t ra = memory_region_get_ram_addr(mr) + xlat;
+
+            tb_invalidate_phys_range(cs, ra, ra + len - 1);
+        }
+        pa += len;
+    }
+#endif
+}
+
+/* Apply a legal command to the I side (CACHE-19/CACHE-21). */
+static void dadao_cache_i_maintain(CPUDADAOState *env, unsigned op,
+                                   unsigned range, uint64_t start,
+                                   uint64_t size)
+{
+    DadaoDCache *c = env->dcache;
+    uint64_t first, last;
+
+    if (!c) {
+        return;                         /* CACHE-27 off: accepted, no effect */
+    }
+    if (op == DADAO_CACHE_OP_CLEAN) {
+        return;                         /* CACHE-19: no dirty state on I */
+    }
+    /* The only executable memory that can change under this model is RAM in
+     * the shadow window, so fold `all` (and any part of a request outside
+     * the window) onto that window. */
+    if (range == DADAO_CACHE_RANGE_ALL) {
+        first = c->pa_base;
+        last = c->pa_base + c->size;
+    } else if (range == DADAO_CACHE_RANGE_LINE) {
+        first = start;
+        last = start + DADAO_DCACHE_LINE_SIZE;
+    } else {
+        first = start;
+        last = start + size;
+        if (last < first) {
+            last = UINT64_MAX;          /* saturate like CACHE-17 */
+        }
+    }
+    if (first < c->pa_base) {
+        first = c->pa_base;
+    }
+    if (last > c->pa_base + c->size) {
+        last = c->pa_base + c->size;
+    }
+    if (first >= last) {
+        return;
+    }
+    dadao_cache_i_drop_translations(env, first, last);
+}
+
+static bool dadao_cache_reg_read(CPUDADAOState *env, uint32_t rc, uint64_t *val)
+{
+    switch (rc) {
+    case 0:                             /* cache_exist (RO) */
+        *val = dadao_cache_exist(env);
+        return true;
+    case 8:                             /* cache_enable (RW) */
+        *val = env->cache_enable & dadao_cache_exist(env);
+        return true;
+    case 9:                             /* cache_ctrl is WO (CACHE-03) */
+        return false;
+    case 10:                            /* cache_addr_start (RW) */
+        *val = env->cache_addr_start & DADAO_CACHE_PA_MASK;
+        return true;
+    case 11:                            /* cache_addr_size (RW) */
+        *val = env->cache_addr_size;
+        return true;
+    default:                            /* CACHE-04: reserved rc => CFXREG */
+        return false;
+    }
+}
+
+/* Execute a cache_ctrl write (CACHE-09..CACHE-14).  Returns false when the
+ * encoding is illegal and the caller must raise CFXREG. */
+static bool dadao_cache_ctrl_exec(CPUDADAOState *env, uint64_t val)
+{
+    unsigned sel = (val >> DADAO_CACHE_CTRL_SEL_SHIFT) &
+                   DADAO_CACHE_CTRL_FIELD_MASK;
+    unsigned op = (val >> DADAO_CACHE_CTRL_OP_SHIFT) &
+                  DADAO_CACHE_CTRL_FIELD_MASK;
+    unsigned range = (val >> DADAO_CACHE_CTRL_RANGE_SHIFT) &
+                     DADAO_CACHE_CTRL_FIELD_MASK;
+
+    /* CACHE-11 order: selection, then operation, then range/operand. */
+    if (sel == DADAO_CACHE_SEL_NONE) {
+        return true;                    /* CACHE-12: unconditional no-op */
+    }
+    if (op == DADAO_CACHE_OP_NONE) {
+        return true;                    /* CACHE-13: unconditional no-op */
+    }
+    if (range == DADAO_CACHE_RANGE_RESERVED) {
+        return false;                   /* CACHE-14: [3:2] = 11 */
+    }
+    if (range == DADAO_CACHE_RANGE_SPAN && env->cache_addr_size == 0) {
+        return false;                   /* CACHE-14: PA span needs size != 0 */
+    }
+    /* Legal command.  CACHE-21: with both sides selected the I side is
+     * handled first, then the D side; each side matches the range on its own.
+     * CACHE-08: an enable bit of 0 makes that side's command a no-op, but the
+     * validation above already ran regardless of the enable bits.  With
+     * cache-model=off, cache_enable is 0 (exist = 0, CACHE-07), so both sides
+     * fall through and the command is a legal no-op (CACHE-27). */
+    if ((sel & DADAO_CACHE_SEL_I) &&
+        (env->cache_enable & (1ULL << DADAO_CACHE_BIT_I))) {
+        dadao_cache_i_maintain(env, op, range, env->cache_addr_start &
+                               DADAO_CACHE_PA_MASK, env->cache_addr_size);
+    }
+    if ((sel & DADAO_CACHE_SEL_D) &&
+        (env->cache_enable & (1ULL << DADAO_CACHE_BIT_D))) {
+        dadao_cache_d_maintain(env, op, range, env->cache_addr_start &
+                               DADAO_CACHE_PA_MASK, env->cache_addr_size);
+    }
+    return true;
+}
+
+/* Write a cfx_cache cg8 register (CACHE-03/07/09/18).  Returns false when the
+ * register is read-only/reserved or the ctrl encoding is illegal (CFXREG). */
+static bool dadao_cache_reg_write(CPUDADAOState *env, uint32_t rc, uint64_t val)
+{
+    switch (rc) {
+    case 0:                             /* cache_exist is RO (CACHE-03) */
+        return false;
+    case 8:                             /* bit0 = I, bit1 = D (CACHE-07);
+                                         * `exist=0` bits ignore writes */
+        env->cache_enable = val & dadao_cache_exist(env);
+        return true;
+    case 9:                             /* WO, write-executes (CACHE-09) */
+        return dadao_cache_ctrl_exec(env, val);
+    case 10:                            /* PA[55:0]; [63:56] read 0 (CACHE-18) */
+        env->cache_addr_start = val & DADAO_CACHE_PA_MASK;
+        return true;
+    case 11:
+        env->cache_addr_size = val;
+        return true;
+    default:                            /* CACHE-04: reserved rc => CFXREG */
+        return false;
+    }
+}
+
+#ifndef CONFIG_USER_ONLY
+
+/* Wake the vCPU for TIMER.  The timer callback runs in the main loop with
+ * the BQL held; the same expiry can also be reached synchronously from a
+ * cfx2rc helper (write cmp/ctrl) where the BQL is not held, so use the
+ * BQL-free atomic request in that case (cpu_interrupt asserts bql_locked). */
+static void dadao_hart_notify(CPUState *cs)
+{
+    if (bql_locked()) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_set_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+}
+
+/* ── Unified async arbitration (INTEG-051t; hart-first, ADR-0061 D1/D3/D5) ──
+ * Every asynchronous source records delivery pending in cfx_hart cg9 rc4, bit
+ * = source cfxha (TIMER 15 / PMEM_DMA 32).  The target is always cfx_hart's
+ * supv async vector (cg9 rc5/rc6); neither the source cfx nor a monitor is a
+ * pending store.  Source identity never occupies excp_cause_id.  The only
+ * mask is the *running mode* monitor's cg8 rc1 (`async_intr_mask`, bit = source
+ * cfxha, 1 = masked).  One instruction boundary merges every pending and
+ * allowed source into one capture.  cg9 is a capture buffer, not a live
+ * frame: a previous capture (src_frame != 0) never blocks a new entry, the
+ * entry overwrites cg9 and there is no valid bit (ADR-0061 R2 D3/D4). */
+
+/* The two sources this machine implements. */
+#define DADAO_ASYNC_SOURCE_MASK (DADAO_ASYNC_SRC_TIMER | DADAO_ASYNC_SRC_PMEM)
+
+/* Bits that may enter a capture at this instruction boundary: pending, allowed
+ * by the running mode monitor's mask, and opened by the source-local gate
+ * (TIMER IMASK).  0 without a hart or when nothing is deliverable. */
+static uint64_t dadao_async_allowed(CPUDADAOState *env)
+{
+    DadaoHartAsync *a = dadao_hart_async(env);
+    int mon;
+    uint64_t allowed;
+
+    if (!a) {
+        return 0;
+    }
+    mon = cfx_idx(env, env->inner_run_mode & 0x3);
+    if (mon < 0) {
+        return 0;              /* no monitor row => no delivery policy */
+    }
+    allowed = a->src_pending & ~env->cfx[mon].async_intr_mask &
+              DADAO_ASYNC_SOURCE_MASK;
+    if (env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK) {
+        allowed &= ~DADAO_ASYNC_SRC_TIMER;      /* source-local gate */
+    }
+    return allowed;
+}
+
+/* DADAO-12 §5.4(五): enter one capture carrying `src_bits`.  The caller has
+ * already filtered by the running mode mask; the bits are consumed from
+ * pending and become the capture's source set.  Every entry overwrites cg9
+ * (`prev_*`/`cause_ip`/`src_frame`), even while a previous capture is still
+ * readable; `excp_async_num` counts entries, not sources. */
+static bool dadao_async_enter(CPUDADAOState *env, uint64_t src_bits,
+                              uint64_t cause_ip)
+{
+    DadaoHartAsync *a = dadao_hart_async(env);
+    int ci = cfx_idx(env, DADAO_CFXHA_HART);
+    uint8_t entry_mode = env->inner_run_mode;
+
+    if (!a || ci < 0 || src_bits == 0) {
+        return false;                   /* profile has no cfx_hart */
+    }
+    a->src_frame = src_bits;            /* capture: union of these sources */
+    a->src_pending &= ~src_bits;        /* delivered: consumed from pending */
+    /* cfx_hart's async-entry counter: once per entry (D3). */
+    env->cfx[ci].excp_async_num++;
+    /* Overwrite the capture.  prev_cfx_code is sampled before the switch
+     * rewrites inner_cfx_code; async_cause_ip is the next instruction address. */
+    a->prev_run_mode = entry_mode & 0x3;
+    a->prev_cfx_code = env->inner_cfx_code & 0x3F;
+    a->cause_ip = cause_ip & 0x0000FFFFFFFFFFFFULL & ~0x3ULL;  /* 48-bit, aligned */
+    /* Switch to cfx_hart at the async vector, in the run mode held by
+     * `cg9 rc6` (async_switch_run_mode; RW, reset 2 = supv; §4.7/§5.4). */
+    dadao_soft_tlb_flush(env);
+    env->inner_run_mode = a->switch_run_mode & 0x3;
+    env->inner_cfx_code = DADAO_CFXHA_HART;
+    env->lock_valid = 0;                /* exception entry clears LR/SC */
+    env->pc = a->excp_vector & ~0x3ULL;
+    env->rb[0] = env->pc;
+    return true;
+}
+
+/* Re-raise CPU_INTERRUPT_HARD when a source may now be delivered.  Called from
+ * every point that can unblock one (mask writes, a new source event, the
+ * cg5 sync escape); never spins, because exec_interrupt clears HARD on each
+ * call. */
+static void dadao_async_kick(CPUDADAOState *env)
+{
+    if (dadao_async_allowed(env) != 0) {
+        dadao_hart_notify(env_cpu(env));
+    }
+}
+
+/* Deliver one capture with every pending and allowed source; true iff entered. */
+bool dadao_async_arbitrate(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    uint64_t allowed = dadao_async_allowed(env);
+
+    if (allowed == 0) {
+        return false;                   /* nothing deliverable */
+    }
+    return dadao_async_enter(env, allowed, env->pc);
+}
+
+static void dadao_hart_timer_expire(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        return;
+    }
+    if (dadao_time_value(env) < env->hart_timer_cmp) {
+        return;                         /* re-armed after the callback fired */
+    }
+    /* The expiry is an event: record it in cfx_hart cg9 rc4 bit 15 (the single
+     * delivery record, bit = source cfxha) and let the arbiter deliver.  IMASK is the source-local
+     * gate, so a masked expiry only records and waits for the ctrl write that
+     * releases it. */
+    if (ci >= 0) {
+        env->cfx[ci].async.src_pending |= DADAO_ASYNC_SRC_TIMER;
+    }
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK)) {
+        dadao_async_kick(env);
+    }
+}
+
+static void dadao_hart_timer_arm(CPUDADAOState *env, CPUState *cs)
+{
+    uint64_t now;
+
+    if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_ENABLE) ||
+        env->hart_timer_cmp == ~0ULL) {
+        timer_del(env->hart_timer);
+        return;
+    }
+    now = dadao_time_value(env);
+    if (now >= env->hart_timer_cmp) {
+        timer_del(env->hart_timer);
+        dadao_hart_timer_expire(cs);
+        return;
+    }
+    /* QEMU_CLOCK_VIRTUAL deadline in ns: epoch + absolute cfx_time value
+     * (1 count = 1 ns on the test machine). */
+    timer_mod(env->hart_timer,
+              (int64_t)(env->time_base_ns + env->hart_timer_cmp));
+}
+
+static void dadao_hart_timer_cb(void *opaque)
+{
+    dadao_hart_timer_expire((CPUState *)opaque);
+}
+
+void dadao_hart_timer_init(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->hart_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                   dadao_hart_timer_cb, cs);
+}
+
+void dadao_hart_timer_reset(CPUDADAOState *env)
+{
+    if (env->hart_timer) {
+        timer_del(env->hart_timer);
+    }
+    env->time_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    env->hart_insn = 0;
+    env->hart_timer_cmp = 0;
+    env->hart_timer_ctrl = 0;
+}
+
+#endif /* !CONFIG_USER_ONLY */
+
+static bool dadao_hart_reg_write(CPUDADAOState *env, uint32_t rc, uint64_t val)
+{
+    switch (rc) {
+    case 4:                             /* cg8 rc4: timer_cmp (64-bit) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+            /* A new compare value cancels the old deadline and this match. */
+            env->hart_timer_cmp = val;
+            if (ci >= 0) {
+                env->cfx[ci].async.src_pending &= ~DADAO_ASYNC_SRC_TIMER;
+            }
+            timer_del(env->hart_timer);
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    case 5:                             /* cg8 rc5: ENABLE/IMASK (bit2 RO) */
+#ifdef CONFIG_USER_ONLY
+        return false;
+#else
+        {
+            CPUState *cs = env_cpu(env);
+            int ci = cfx_idx(env, DADAO_CFXHA_HART);
+
+            env->hart_timer_ctrl = (uint8_t)(val & (DADAO_HART_TIMER_ENABLE |
+                                                    DADAO_HART_TIMER_IMASK));
+            /* Releasing IMASK while ISTATUS=1 (re)records the pending bit and
+             * re-kicks, so the arbiter performs the delivery (050 "release
+             * delivers" semantics); software cannot write the bitmap itself. */
+            if (!(env->hart_timer_ctrl & DADAO_HART_TIMER_IMASK) &&
+                dadao_hart_istatus(env)) {
+                if (ci >= 0) {
+                    env->cfx[ci].async.src_pending |= DADAO_ASYNC_SRC_TIMER;
+                }
+                dadao_async_kick(env);
+            }
+            dadao_hart_timer_arm(env, cs);
+        }
+        return true;
+#endif
+    default:                            /* rc2/rc3 are RO; rc0/1/6/7 reserved */
+        return false;
+    }
+}
+
+/* ── cfx_hart cg9: async frame / two bitmaps (DADAO-12 §4.7;
+ * ADR-0061 D4/D7) ────────────────────────────────────────────────────── */
+#define DADAO_ASYNC_ADDR_MASK 0x0000FFFFFFFFFFFFULL   /* 48-bit internal addr */
+
+static bool dadao_hart_async_reg_read(CPUDADAOState *env, uint32_t rc,
+                                      uint64_t *val)
+{
+    DadaoHartAsync *a = dadao_hart_async(env);
+
+    if (!a) {
+        return false;                   /* only cfx_hart implements cg9 */
+    }
+    switch (rc) {
+    case 0: *val = a->prev_run_mode & 0x3; return true;
+    case 1: *val = a->prev_cfx_code & 0x3F; return true;
+    case 2: *val = a->cause_ip & DADAO_ASYNC_ADDR_MASK; return true;
+    case 3: *val = a->src_frame; return true;      /* HW/RO */
+    case 4: *val = a->src_pending;
+        return true;    /* HW/RO */
+    case 5: *val = a->excp_vector & DADAO_ASYNC_ADDR_MASK; return true;
+    case 6: *val = a->switch_run_mode & 0x3; return true;   /* RW (§4.7) */
+    default:                            /* rc7-rc15 reserved => CFXREG */
+        return false;
+    }
+}
+
+static bool dadao_hart_async_reg_write(CPUDADAOState *env, uint32_t rc,
+                                       uint64_t val)
+{
+    DadaoHartAsync *a = dadao_hart_async(env);
+
+    if (!a) {
+        return false;                   /* only cfx_hart implements cg9 */
+    }
+    switch (rc) {
+    case 0: a->prev_run_mode = val & 0x3; return true;
+    case 1: a->prev_cfx_code = val & 0x3F; return true;
+    case 2:                             /* 48-bit, low 2 bits ignored */
+        a->cause_ip = val & DADAO_ASYNC_ADDR_MASK & ~0x3ULL;
+        return true;
+    case 3:                             /* src_frame: HW/RO, write ignored */
+    case 4:                             /* src_pending: HW/RO, write ignored */
+        return true;                    /* no change, no exception */
+    case 5:                             /* 48-bit, low 2 bits ignored */
+        a->excp_vector = val & DADAO_ASYNC_ADDR_MASK & ~0x3ULL;
+        return true;
+    case 6:                             /* RW 2-bit: store it (§4.7) */
+        a->switch_run_mode = val & 0x3;
+        return true;
+    default:                            /* rc7-rc15 reserved => CFXREG */
+        return false;
+    }
+}
+
+/* trap cfxha, immu18 : general trap (not the semihosting tag) -> §5 flow.
+ * Semihosting (immu18[17:8] == 0x3FF, i.e. 0x3FF00-0x3FFFF) is handled by the
+ * decode-layer short-circuit (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST,
+ * QEMU-046t/ADR-0038 D4) and therefore never reaches this helper; the tag
+ * check below is a defensive explicit failure only. */
+void helper_cfx_trap(CPUDADAOState *env, uint32_t cfxha, uint32_t immu18,
+                     uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7F << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(immu18 & 0x3FFFF);
+    uint64_t cause;
+    int target;
+    int ci;
+
+    if (immu18 >= 0x3FF00) {
+        /* Semihosting tag (immu18[17:8] == 0x3FF, ADR-0038 D1): short-circuited
+         * at the decode layer (trans_trap_ciii_cfx -> DADAO_EXCP_SEMIHOST) and
+         * must never reach this general-trap helper.  Fail explicitly (ILLI)
+         * if it does, rather than silently entering a cfx vector. */
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* Allocated but not implemented by this profile: Tiny maps a general
+         * trap there to ILLI (spec/Kaiwu §3 Tiny bullet), Vast keeps the
+         * register-access rule CFXREG.  Either way the target is the current
+         * run-mode monitor. */
+        cfx_raise(env, DADAO_PROFILE(env)->unimpl_cfx_trap_illi
+                       ? DADAO_CAUSE_ILLI : DADAO_CAUSE_CFXREG,
+                  env->inner_run_mode, pc, info);
+        return;
+    }
+    /* cfxtrap permission: target's source mask, self bypasses the cfx axis
+     * but still uses the current-mode row (ADR-0045 D1/D2). */
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_TRAP)) {
+        cfx_raise_perm(env, pc);
+        return;
+    }
+    target = cfxha;
+    cause = DADAO_CAUSE_CFXTRAP;
+
+    {
+        bool entered;
+        uint64_t vec = cfx_enter(env, cause, target, pc, info, &entered);
+
+        env->pc = entered ? vec : pc + 4;
+        env->rb[0] = env->pc;
+    }
+}
+
+/* escape cfxha, imms18 : §5 exception-exit flow (steps 0-4).  `cfxha` is the
+ * current cfx.  `imms18[0]` is the cg5 byte-offset bit (0 / +4) and
+ * `imms18[1]` is the frame selector: 0 = cg5 synchronous frame, 1 = the cfx_hart
+ * cg9 capture buffer.  Legal `imms18` values are {0, 1, 2}: 3 (cg9 + offset +4)
+ * and any imms18[17:2] != 0 raise ILLI before any state switch; a wrong target
+ * raises CFXESC.  cg9 is a capture buffer, not a return frame: selecting it
+ * (imms18 = 2) is an invalid frame and also raises the current cfx's CFXESC,
+ * leaving run mode / cfx / cg9 untouched (ADR-0061 R2 D9; DADAO-12 §5.1/§5.4(七)). */
+void helper_cfx_escape(CPUDADAOState *env, uint32_t cfxha, uint32_t imms18,
+                       uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7E << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    (uint64_t)(imms18 & 0x3FFFF);
+    uint32_t sel = imms18 & 0x3u;
+    int ci;
+
+    /* step 0: encoding check (imms18[17:2] SBZ; imms18 == 3 is cg9 + offset
+     * +4, which no frame allows). */
+    if ((imms18 & ~0x3u) != 0 || sel == 3) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, env->inner_cfx_code);
+    /* CFXESC: target error (cfxha must be the current cfx) or invalid frame. */
+    if (ci < 0 || cfxha != env->inner_cfx_code) {
+        cfx_raise(env, DADAO_CAUSE_CFXESC, env->inner_cfx_code, pc, info);
+        return;
+    }
+    if (sel & 0x2u) {
+        /* imms18[1] = 1 names cg9, the capture buffer of the last entry; it is
+         * never a return frame (the software copies it out and discards it, and
+         * returns through smon/umon), so the selected frame is invalid: raise
+         * CFXESC before changing any state.  Neither cg9 nor run mode / cfx
+         * move here (no "release the frame", no counter). */
+        cfx_raise(env, DADAO_CAUSE_CFXESC, env->inner_cfx_code, pc, info);
+        return;
+    }
+    if (env->cfx[ci].cause_id == 0) {
+        cfx_raise(env, DADAO_CAUSE_CFXESC, env->inner_cfx_code, pc, info);
+        return;
+    }
+
+#ifndef CONFIG_USER_ONLY
+    dadao_async_kick(env);              /* a pending source may be deliverable */
+#endif
+    /* cg5 step 2: restore the previous run mode and current cfx from the
+     * frame.  Without the cfx restore a frame that received a nested async
+     * delivery could never escape: step 6 of the nested entry moved
+     * inner_cfx_code to the delivered cfx, so this escape's cfxha check would
+     * fail with CFXESC (DADAO-12 §5.3 step 2). */
+    env->inner_run_mode = env->cfx[ci].prev_run_mode & 0x3;
+    env->inner_cfx_code = env->cfx[ci].prev_cfx_code & 0x3F;
+    dadao_soft_tlb_flush(env);
+    /* cg5 step 3: increment the escape counter */
+    env->cfx[ci].escape_num++;
+    /* cg5 step 4: return address = cause_ip + ((imms18 & 1) << 2); the offset
+     * is a compile-time immediate, not an arbitrary target. */
+    {
+        uint64_t ret = env->cfx[ci].cause_ip + ((uint64_t)(sel & 0x1u) << 2);
+
+        env->pc = ret;
+        env->rb[0] = ret;
+    }
+}
+
+/*
+ * cfx_power_ctrl (cg8 rc1, cfx_power) write side (DADAO-12 §4.12;
+ * m16-qemu-006).  The register is WO: the write is always accepted (reads are
+ * CFXREG), and the defined action bits are latched into QEMU's run state:
+ * bit0 = power off, bit1 = hard reset, bit2 = soft reset.  QEMU models one
+ * guest reset, so hard and soft reset both request it; a write of 0 is the
+ * ordinary "accepted, no action" case the arch probe exercises.
+ */
+static void dadao_power_ctrl_write(CPUDADAOState *env, uint64_t val)
+{
+#ifndef CONFIG_USER_ONLY
+    if (val & 0x1) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+    if (val & 0x2) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+    if (val & 0x4) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+    if (val & 0x7) {
+        cpu_exit(env_cpu(env));
+    }
+#else
+    (void)env;
+    (void)val;
+#endif
+}
+
+/* cfx2rd cfxha, cghb, rchc, rdhd */
+void helper_cfx2rd(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7A << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* No register file row for a cfx this profile does not implement
+         * (spec/Kaiwu §3) => CFXREG in the current run-mode monitor.
+         * A reserved cfxha already took the ILLI path above (DADAO-12
+         * §5.2(一)). */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, pc);
+        return;
+    }
+    /* cfx_pmem descriptor face: cg8 rc0 / cg12/13/14 (DADAO-12 §4.9;
+     * m16-qemu-006). */
+    if (dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM &&
+        (cg == 8 || cg == 12 || cg == 13 || cg == 14)) {
+        uint64_t v;
+
+        if (!dadao_pmem_reg_read(env, cg, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v;
+
+        if (!dadao_pmem_dma_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        uint64_t v;
+
+        if (!dadao_time_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_hart cg8 (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v;
+
+        if (!dadao_hart_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_cache cg8 register face (contract-cache §1/§2; m16-qemu-001). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_CACHE) {
+        uint64_t v;
+
+        if (!dadao_cache_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_hart cg9: async frame / two bitmaps (DADAO-12 §4.7). */
+    if (cg == 9 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v;
+
+        if (!dadao_hart_async_reg_read(env, rc, &v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (rd != 0) {
+            env->rd[rd] = v;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 internal space description
+                                          * (read-only, DADAO-12 §3.8) */
+        if (rd != 0) {
+            env->rd[rd] = dadao_cg7_space_reg(DADAO_PROFILE(env), cfxha, rc);
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, false);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (rd != 0) {
+        env->rd[rd] = *p;
+    }
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
+
+/* cfx2rc cfxha, cghb, rchc, rdhd */
+void helper_cfx2rc(CPUDADAOState *env, uint32_t cfxha, uint32_t cg,
+                   uint32_t rc, uint32_t rd, uint64_t pc)
+{
+    uint64_t info = ((uint64_t)0x7B << 24) | ((uint64_t)(cfxha & 0x3F) << 18) |
+                    ((uint64_t)(cg & 0x3F) << 12) | ((uint64_t)(rc & 0x3F) << 6) |
+                    (rd & 0x3F);
+    uint64_t *p;
+    int ci;
+
+    if (DADAO_CFX_IS_RESERVED(cfxha)) {
+        cfx_raise(env, DADAO_CAUSE_ILLI, env->inner_run_mode, pc, info);
+        return;
+    }
+    ci = cfx_idx(env, cfxha);
+    if (ci < 0) {
+        /* No register file row for a cfx this profile does not implement
+         * (spec/Kaiwu §3) => CFXREG in the current run-mode monitor.
+         * A reserved cfxha already took the ILLI path above (DADAO-12
+         * §5.2(一)). */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (cfx_perm_denied(env, cfxha, DADAO_CFX_PERM_REG)) {
+        cfx_raise_perm(env, pc);
+        return;
+    }
+    /* cg_reg_deleg (supv only; DADAO-13 §1).  cg3 has no exception: its bit3
+     * is hardware-fixed 1, so a supv cg3 access is always CFXPERM. */
+    if (cfx_deleg_denied(env, ci, cg)) {
+        cfx_raise_perm(env, pc);
+        return;
+    }
+    /* cfx_pmem descriptor face: cg8 rc0 / cg12/13/14 (DADAO-12 §4.9;
+     * m16-qemu-006).  cg8 rc0 is RO; a write there stays CFXREG. */
+    if (dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM &&
+        (cg == 8 || cg == 12 || cg == 13 || cg == 14)) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_pmem_reg_write(env, cg, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_power_ctrl (cg8 rc1): WO, write accepted, read stays CFXREG
+     * (DADAO-12 §4.12; m16-qemu-006).  Kaiwu-Tiny does not implement the
+     * register (spec/Kaiwu §3) => fall through to the generic path (CFXREG). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_POWER && rc == 1 &&
+        DADAO_PROFILE(env)->power_ctrl) {
+        dadao_power_ctrl_write(env, (rd == 0) ? 0 : env->rd[rd]);
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_pmem cg15: DMA registers (DADAO-12 §4.9; ADR-0042 D7.3). */
+    if (cg == 15 && dadao_cfxha_map[ci] == DADAO_CFXHA_PMEM) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_pmem_dma_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_time cg10 is RO (DADAO-12 §4.10; INTEG-050t). */
+    if (cg == 10 && dadao_cfxha_map[ci] == DADAO_CFXHA_TIME) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    /* cfx_hart cg8: only rc4/rc5 accept writes (DADAO-12 §4.7; INTEG-050t). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_hart_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_cache cg8 register face (contract-cache §1/§2; m16-qemu-001). */
+    if (cg == 8 && dadao_cfxha_map[ci] == DADAO_CFXHA_CACHE) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_cache_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    /* cfx_hart cg9: async frame / two bitmaps (DADAO-12 §4.7).  Writes to
+     * the HW/RO bitmaps are ignored; a vector/switch write may change where
+     * the next frame enters, so re-kick at the tail. */
+    if (cg == 9 && dadao_cfxha_map[ci] == DADAO_CFXHA_HART) {
+        uint64_t v = (rd == 0) ? 0 : env->rd[rd];
+
+        if (!dadao_hart_async_reg_write(env, rc, v)) {
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+#ifndef CONFIG_USER_ONLY
+        /* A cg9 write may open a mask, clear pending or release the frame;
+         * re-kick so the arbiter can deliver what is now unblocked. */
+        dadao_async_kick(env);
+#endif
+        env->pc = pc + 4;
+        env->rb[0] = pc + 4;
+        return;
+    }
+    if (cg == 7) {                       /* cg7 is read-only: any rc write
+                                          * => CFXREG (DADAO-12 §3.8) */
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    p = cfx_reg_ptr(env, ci, cg, rc, true);
+    if (!p) {
+        cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+        return;
+    }
+    if (p == &env->ptbr) {
+        /* Single PTBR stores PPN[55:16]; [15:0] and [63:56] read as 0. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_PTBR_MASK;
+        /* Writing PTBR does not invalidate guest TLB entries (DADAO-12 §2.2,
+         * ADR-0041 D5); only QEMU's derived translation cache is dropped so
+         * that the guest TLB stays the single authority on hits/misses. */
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->ptw_enable) {
+        /* 1-bit enable (DADAO-12 §4.5). */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 1;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_asid) {
+        /* 16-bit ASID; switching it never invalidates guest TLB entries. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & 0xFFFFULL;
+        dadao_soft_tlb_flush(env);
+    } else if (p == &env->tlb_start) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_size) {
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & DADAO_VA_MASK;
+    } else if (p == &env->tlb_control) {
+        /* TLB command: executed synchronously on write (DADAO-12 §4.5). */
+        uint64_t val = (rd == 0) ? 0 : env->rd[rd];
+        hwaddr err_pa = 0;
+        int ret = dadao_tlb_control_exec(env, val, &err_pa);
+
+        if (ret == DADAO_TLB_CMD_CFXREG) {
+            /* Illegal scope / range with size 0 => CFXREG (ADR-0041 D6). */
+            cfx_raise(env, DADAO_CAUSE_CFXREG, env->inner_run_mode, pc, info);
+            return;
+        }
+        if (ret == DADAO_TLB_CMD_AD_WB_FAIL) {
+            /* A/D write-back failed: monitor CFXMEM + [56] ADWBFAIL, entry
+             * kept (ADR-0041 D7/D10; contract-see §6.1.1).  Precise: the
+             * cfx2rc instruction did not complete. */
+            CPUState *cs = env_cpu(env);
+
+            env->pc = pc;
+            env->rb[0] = pc;
+            env->ptw_fault_cause = DADAO_SUB_ADWBFAIL;
+            env->ptw_fault_info = err_pa;
+            cs->exception_index = DADAO_EXCP_PTW_FAULT;
+            cpu_loop_exit_restore(cs, GETPC());
+            /* not reached */
+            return;
+        }
+        /* CLEAN keeps entries (mappings unchanged); INVALID/FLUSH drop them,
+         * so QEMU's derived translation cache must be dropped with them. */
+        if (val & 0x2) {
+            dadao_soft_tlb_flush(env);
+        }
+    } else if (cg == 3 && rc == 12) {
+        /* bit3 is hardware-fixed 1 (DADAO-13 §1): a software 0 is ignored and
+         * the register reads back with bit3 set. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) | (1ULL << 3);
+    } else if (rc == 10) {
+        /* DADAO-13 §1 (cg3 rc10; the same field exists in cg0-cg2): a write
+         * ignores the low 2 bits (value[1:0] <- 0, 4-byte aligned), no
+         * exception; reads return the stored value. */
+        *p = ((rd == 0) ? 0 : env->rd[rd]) & ~0x3ULL;
+        dadao_soft_tlb_flush(env);
+    } else if (rc == 8 && DADAO_PROFILE(env)->switch_run_mode_write_ignored) {
+        /* Kaiwu-Tiny §2: the write is ignored; the register keeps its
+         * saved value (3 = hypv) and a read returns that saved value.  The
+         * exception-entry path forces hypv independently. */
+    } else {
+        *p = (rd == 0) ? 0 : env->rd[rd];
+        /* Any cfx2rc write may change a two-axis permission mask
+         * (cfxtrap/cfxmem/cfxreg/cfxexe/async_intr_mask); drop the derived
+         * translation cache so the next access re-checks. */
+        dadao_soft_tlb_flush(env);
+    }
+#ifndef CONFIG_USER_ONLY
+    /* A write to a mask / pending register may unblock a
+     * pending async source; re-kick here so the generic write path covers
+     * every such register (INTEG-051t). */
+    dadao_async_kick(env);
+#endif
+    env->pc = pc + 4;
+    env->rb[0] = pc + 4;
+}
