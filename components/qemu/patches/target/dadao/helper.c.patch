+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr)
+{
+    /*
+     * M1: no MMU, 1:1 virtual-to-physical mapping.
+     * Check if address falls within known regions:
+     *   RAM:   0xFC00_0000_0000 .. +DADAO_RAM_SIZE (16 MiB, cfxha 63/power)
+     *   ROM:   0xffff_ffff_0000 .. 0xffff_ffff_ffff (64 KiB)
+     * Unmapped/illegal accesses are classified per ADR-0020 D15 (see below).
+     */
+    uint64_t addr = address;
+    int prot;
+    hwaddr paddr;
+
+    /* RAM (ADR-0004 R3 + rev. 2026-10-11): the single 16 MiB RAM at
+     * 0xFC00_0000_0000 (cfxha 63, power).  The legacy RAM segment and the
+     * exit-port device were removed in step2. */
+    if (addr >= DADAO_RAM_BASE && addr < DADAO_RAM_BASE + DADAO_RAM_SIZE) {
+        prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    if (addr >= DADAO_ROM_BASE && addr < DADAO_ROM_BASE + DADAO_ROM_SIZE) {
+        /* ROM: read+exec allowed. Store to ROM triggers ILLI (ADR-0004 D5.6).
+         * The ROM MemoryRegion is readonly, so stores should not succeed.
+         * However, TCG fast-path stores may not check write permission.
+         * Catch stores here in the TLB fill path to raise ILLI. */
+        if (access_type == MMU_DATA_STORE) {
+            cs->exception_index = DADAO_EXCP_ILLI;
+            cpu_loop_exit_restore(cs, retaddr);
+            /* not reached */
+            return false;
+        }
+        prot = PAGE_READ | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    /* Unmapped address */
+    if (probe) {
+        return false;
+    }
+
+    /*
+     * Machine-level fault classification (ADR-0020 D15 / ADR-0004 R3):
+     *  - inside the umon segment (cfxha 0), which now holds no RAM => illegal
+     *    access/fetch to the internal address space => CFXMEM (exit 0x81).
+     *  - addresses elsewhere (including the power segment 63) keep the
+     *    historical test-machine unmapped code 0x87 (ADR-0004 D5.8).
+     * Data accesses and instruction fetches are treated identically here: the
+     * fetch path reaches this function through get_page_addr_code ->
+     * cpu_ldl_code_mmu (MMU_INST_FETCH), so no `access_type` special case is
+     * needed and an out-of-range fetch never silently continues.
+     */
+    if (DADAO_ADDR_CFXHA(addr) == DADAO_CFXHA_UMON) {
+        cs->exception_index = DADAO_EXCP_CFXMEM;
+    } else {
+        cs->exception_index = DADAO_EXCP_UNMAPPED;
+    }
+    cpu_loop_exit_restore(cs, retaddr);
+    /* not reached */
+    return false;
+
+map:
+    tlb_set_page(cs, address, paddr, prot, mmu_idx, TARGET_PAGE_SIZE);
+    return true;
+}
