+/* Map QEMU-internal exception index to ADR-0004 exit code */
+static int dadao_excp_to_exit_code(int excp)
+{
+    switch (excp) {
+    case DADAO_EXCP_ILLI:
+        return DADAO_EXIT_ILLI;       /* 0x88 */
+    case DADAO_EXCP_UNDI:
+        return DADAO_EXIT_UNDI;       /* 0x89 */
+    case DADAO_EXCP_RASOF:
+        return DADAO_EXIT_RASOF;      /* 0x8A */
+    case DADAO_EXCP_RASUF:
+        return DADAO_EXIT_RASUF;      /* 0x8B */
+    case DADAO_EXCP_MALIGN:
+        return DADAO_EXIT_MALIGN;     /* 0x8C */
+    case DADAO_EXCP_IALIGN:
+        return DADAO_EXIT_IALIGN;     /* 0x8D */
+    case DADAO_EXCP_UNMAPPED:
+        return DADAO_EXIT_UNMAPPED;   /* 0x87 */
+    default:
+        return DADAO_EXIT_ILLI;       /* fallback */
+    }
+}
+
+void dadao_cpu_do_interrupt(CPUState *cs)
+{
+    /*
+     * M1: no guest exception handler. QEMU directly maps fault → exit code
+     * and exits. Per ADR-0004 D6.1, this avoids pre-setting future exception
+     * model. The exit code is propagated to host $? via
+     * qemu_system_shutdown_request_with_code().
+     *
+     * If a clean shutdown (exit port write) is already pending, do not
+     * override it with a panic exit code. This can happen when gen_update_pc
+     * in tb_stop advances env->pc past an exit port write, causing the CPU
+     * to continue into a UNDI terminator.
+     */
+    if (qemu_shutdown_requested_get() != SHUTDOWN_CAUSE_NONE) {
+        return;
+    }
+
+    int exit_code = dadao_excp_to_exit_code(cs->exception_index);
+
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC,
+                                           exit_code);
+    cpu_exit(cs);
+}
+
+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr)
+{
+    /*
+     * M1: no MMU, 1:1 virtual-to-physical mapping.
+     * Check if address falls within known regions:
+     *   RAM:  0xffff_0000_0000 .. 0xffff_00ff_ffff (16 MiB)
+     *   Exit: 0xffff_8000_0000 .. 0xffff_8000_0007 (8 B)
+     *   ROM:  0xffff_ffff_0000 .. 0xffff_ffff_ffff (64 KiB)
+     * Unmapped accesses cause UNMAPPED exception.
+     */
+    uint64_t addr = address;
+    int prot;
+    hwaddr paddr;
+
+    if (addr >= DADAO_RAM_BASE && addr < DADAO_RAM_BASE + DADAO_RAM_SIZE) {
+        prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    if (addr >= DADAO_EXIT_PORT_BASE &&
+        addr < DADAO_EXIT_PORT_BASE + DADAO_EXIT_PORT_SIZE) {
+        prot = PAGE_READ | PAGE_WRITE;
+        paddr = addr;
+        goto map;
+    }
+
+    if (addr >= DADAO_ROM_BASE && addr < DADAO_ROM_BASE + DADAO_ROM_SIZE) {
+        /* ROM: read+exec allowed. Store to ROM triggers ILLI (ADR-0004 D5.6).
+         * The ROM MemoryRegion is readonly, so stores should not succeed.
+         * However, TCG fast-path stores may not check write permission.
+         * Catch stores here in the TLB fill path to raise ILLI. */
+        if (access_type == MMU_DATA_STORE) {
+            cs->exception_index = DADAO_EXCP_ILLI;
+            cpu_loop_exit_restore(cs, retaddr);
+            /* not reached */
+            return false;
+        }
+        prot = PAGE_READ | PAGE_EXEC;
+        paddr = addr;
+        goto map;
+    }
+
+    /* Unmapped address */
+    if (probe) {
+        return false;
+    }
+
+    /* Trigger unmapped access fault */
+    cs->exception_index = DADAO_EXCP_UNMAPPED;
+    cpu_loop_exit_restore(cs, retaddr);
+    /* not reached */
+    return false;
+
+map:
+    tlb_set_page(cs, address, paddr, prot, mmu_idx, TARGET_PAGE_SIZE);
+    return true;
+}
+
+/*
+ * raise_exception helper: raise a DADAO exception.
+ * env is the implicit first argument passed by TCG.
+ * excp is the DADAO exception index.
+ */
+void helper_raise_exception(CPUDADAOState *env, uint32_t excp)
+{
+    CPUState *cs = env_cpu(env);
+
+    cs->exception_index = excp;
+    cpu_loop_exit_restore(cs, GETPC());
+}
+
+/* ── Ring-buffer RA access helpers (ADR-0012 D7) ──────────────────── */
+
+/* Compute physical index for logical RA register n (1..63).
+ * ra0 is always at physical 0 (metadata). */
+static inline int ra_phys(CPUDADAOState *env, int n)
+{
+    if (n == 0) return 0;
+    int r = (env->ras_base + n) % 63;
+    if (r < 0) r += 63;
+    return 1 + r;
+}
+
+/* Store val into ra[logical_n] (ring-buffer view). */
+void helper_ra_store(CPUDADAOState *env, uint64_t logical_idx, uint64_t val)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    env->ra[phys] = val;
+}
+
+/* Load from ra[logical_n] (ring-buffer view). */
+uint64_t helper_ra_load(CPUDADAOState *env, uint64_t logical_idx)
+{
+    int phys = ra_phys(env, (int)logical_idx);
+    return env->ra[phys];
+}
+
+/* ── RAS push (ADR-0012 D7 §3) ───────────────────────────────────── */
+void helper_ras_push(CPUDADAOState *env, uint64_t ret_addr)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    /* Read stack top (logical 63) */
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    ret_addr &= 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt == 0) {
+        /* C1: empty stack → push, RACNT = 1 */
+        env->ra[top_phys] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | (1ULL << 48);
+        return;
+    }
+
+    if (ret_addr == top_lo && top_hi < 0xFFFF) {
+        /* C2: recursive fold */
+        env->ra[top_phys] = ((uint64_t)(top_hi + 1) << 48) | top_lo;
+        return;
+    }
+
+    if (racnt < 63) {
+        /* C3a: advance ras_base, push new entry, RACNT++ */
+        env->ras_base = (env->ras_base + 1) % 63;
+        int new_top = ra_phys(env, 63);
+        env->ra[new_top] = (1ULL << 48) | ret_addr;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt + 1) << 48);
+        return;
+    }
+
+    /* C3b: RACNT == 63, overflow path */
+    if (mrptr == 0) {
+        /* RASOF: precise — no side effects */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASOF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Spill bottom to MemRAS */
+    int bottom_phys = ra_phys(env, 1); /* logical 1 = 64-63 */
+    uint64_t bottom_val = env->ra[bottom_phys];
+    uint64_t new_mrptr = mrptr - 8;
+    /* Write to MemRAS (guest memory, big-endian) */
+    cpu_stq_be_data_ra(env, new_mrptr, bottom_val, GETPC());
+
+    /* Advance ras_base, write new entry */
+    env->ras_base = (env->ras_base + 1) % 63;
+    int new_top = ra_phys(env, 63);
+    env->ra[new_top] = (1ULL << 48) | ret_addr;
+
+    /* Update ra0: new MRPTR, RACNT stays 63 */
+    env->ra[0] = (ra0 & 0x003F000000000000ULL) | (new_mrptr & 0x0000FFFFFFFFFFFFULL);
+}
+
+/* ── RAS pop (ADR-0012 D7 §4) ────────────────────────────────────── */
+/* Pop return address from RAS. Result stored in env->ras_tmp. */
+void helper_ras_pop(CPUDADAOState *env)
+{
+    uint64_t ra0 = env->ra[0];
+    int racnt = (int)((ra0 >> 48) & 0x3F);
+    uint64_t mrptr = ra0 & 0x0000FFFFFFFFFFFFULL;
+
+    int top_phys = ra_phys(env, 63);
+    uint64_t top_val = env->ra[top_phys];
+    uint16_t top_hi = (uint16_t)(top_val >> 48);
+    uint64_t top_lo = top_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (racnt > 0) {
+        if (top_hi == 0) {
+            /* D1: RASUF — precise, no side effects */
+            CPUState *cs = env_cpu(env);
+            cs->exception_index = DADAO_EXCP_RASUF;
+            cpu_loop_exit_restore(cs, GETPC());
+            return;
+        }
+
+        if (top_hi > 1) {
+            /* D2: decrement recursive count */
+            env->ra[top_phys] = ((uint64_t)(top_hi - 1) << 48) | top_lo;
+            env->ras_tmp = top_lo;
+            return;
+        }
+
+        /* D3: top_hi == 1 → pop, rotate ras_base backward */
+        env->ras_tmp = top_lo;
+        env->ras_base = (env->ras_base + 62) % 63;
+        env->ra[0] = (ra0 & ~0x003F000000000000ULL) | ((uint64_t)(racnt - 1) << 48);
+        return;
+    }
+
+    /* D4: RACNT == 0 */
+    if (mrptr == 0) {
+        /* D4a: RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* D4b: read from MemRAS */
+    uint64_t mem_val = cpu_ldq_be_data_ra(env, mrptr, GETPC());
+    uint16_t mem_hi = (uint16_t)(mem_val >> 48);
+    uint64_t mem_lo = mem_val & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 0) {
+        /* Invalid entry → RASUF */
+        CPUState *cs = env_cpu(env);
+        cs->exception_index = DADAO_EXCP_RASUF;
+        cpu_loop_exit_restore(cs, GETPC());
+        return;
+    }
+
+    /* Commit: MRPTR += 8 */
+    env->ra[0] = (mrptr + 8) & 0x0000FFFFFFFFFFFFULL;
+
+    if (mem_hi == 1) {
+        /* D4b count==1: return address, RACNT stays 0 */
+        env->ras_tmp = mem_lo;
+        return;
+    }
+
+    /* D4b count>1: decrement, push to RegRAS, RACNT=1 */
+    int top_phys2 = ra_phys(env, 63);
+    env->ra[top_phys2] = ((uint64_t)(mem_hi - 1) << 48) | mem_lo;
+    env->ra[0] = (env->ra[0] & ~0x003F000000000000ULL) | (1ULL << 48);
+    env->ras_tmp = mem_lo;
+}
