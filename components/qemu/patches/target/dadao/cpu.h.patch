+#define CPU_RESOLVING_TYPE TYPE_DADAO_CPU
+
+/*
+ * User-mode mmu index: one address space, no MMU (P3).  System mode uses the
+ * single index 0 as well (dadao_cpu_mmu_index()); the generic TCG helpers read
+ * MMU_USER_IDX directly when CONFIG_USER_ONLY is set.
+ */
+#define MMU_USER_IDX 0
+
+/* DADAO exception indices (QEMU-internal, mapped to exit codes in do_interrupt) */
+enum {
+    DADAO_EXCP_ILLI = 1,       /* Illegal instruction */
+    DADAO_EXCP_UNDI = 2,       /* Undefined instruction */
+    DADAO_EXCP_RASOF = 3,      /* RAS overflow */
+    DADAO_EXCP_RASUF = 4,      /* RAS underflow */
+    DADAO_EXCP_MALIGN = 5,     /* Memory alignment fault */
+    DADAO_EXCP_IALIGN = 6,     /* Instruction alignment fault */
+    DADAO_EXCP_UNMAPPED = 7,   /* Unmapped memory access */
+    DADAO_EXCP_CFXMEM = 8,     /* Illegal internal-address-space access */
+    DADAO_EXCP_SEMIHOST = 9,   /* semihosting trap tag (not a fault) */
+    /*
+     * linux-user only (P3): the umon syscall entry `trap cfx0, 0`
+     * (contract-syscall.md §2).  It is not a fault: cpu_loop forwards it to
+     * the host and resumes at pc+4.  Never raised in system mode (no kernel
+     * there, ADR-0025 D2).
+     */
+    DADAO_EXCP_SYSCALL = 10,
+    /*
+     * System mode: a page-table walk / TLB-hit fault.  The model enters the
+     * current run-mode monitor (DADAO-12 §2.2.6/§5.2) with
+     * env->ptw_fault_cause (CFXMEM or CFXPERM) / env->ptw_fault_info instead
+     * of mapping straight to an exit code.
+     */
+    DADAO_EXCP_PTW_FAULT = 11,
+    /*
+     * System mode: two-axis permission denial (ADR-0045 D6).  Routed to the
+     * current-mode monitor as CFXPERM with env->cfx_perm_info.
+     */
+    DADAO_EXCP_CFXPERM = 12,
+    /*
+     * System mode: an illegal cfx-register access (DADAO-12 §5.2(一)):
+     * a `cfx2rd`/`cfx2rc` to a cfx this profile does not implement, or an
+     * out-of-range (cg, rc).  It is a synchronous exception of the current
+     * run-mode monitor (cfx_hmon on both test machines), not a cfx entry.
+     */
+    DADAO_EXCP_CFXREG = 13,
+};
+
+/*
+ * DADAO exit codes (propagated to host $?, spec/Machine-v5 §7.1):
+ *
+ *   0x00-0x3F  guest PASS
+ *   0x40-0x7F  guest FAIL (guest-defined code)
+ *   0x80-0xBF  other cfx: bit7=1, bit6=0, bit5:0 = cfxHA
+ *   0xC0-0xFF  monitor:  bit7=1, bit6=1, bit5:4 = run mode,
+ *                        bit3:0 = DADAO exception bit index
+ *
+ * The monitor segment is NOT "0x80 | bit index": it carries the current run
+ * mode in bit5:4.  `CFXTRAP`/`CFXESC` that enter the target/current cfx use
+ * the other-cfx segment (DADAO_EXIT_CFX), never the monitor segment.
+ */
+#define DADAO_EXIT_PASS          0x00
+#define DADAO_EXIT_GUEST_FAIL    0x40
+#define DADAO_EXIT_CFX(cfxha)    (0x80 | ((cfxha) & 0x3F))
+#define DADAO_EXIT_MONITOR(mode, index) \
+    (0xC0 | (((mode) & 0x3) << 4) | ((index) & 0xF))
+
+/* spec/Machine-v5 §7.1 formula self-checks (compile-time, never silent). */
+_Static_assert(DADAO_EXIT_CFX(1) == 0x81, "other-cfx segment: cfxHA 1");
+_Static_assert(DADAO_EXIT_CFX(63) == 0xBF, "other-cfx segment: cfxHA 63");
+_Static_assert(DADAO_EXIT_MONITOR(0, 13) == 0xCD, "monitor: user IALIGN");
+_Static_assert(DADAO_EXIT_MONITOR(3, 8) == 0xF8, "monitor: hypv ILLI");
+_Static_assert(DADAO_EXIT_MONITOR(2, 1) == 0xE1, "monitor: supv CFXMEM");
+
+/* Memory map constants (canonical = Machine-v5-Vast; spec/Machine-v5 §1.1,
+ * ADR-0043 D1/D2; QEMU-080t).  These canonical macros are consumed by
+ * `check-interface` and by the cfx_pmem DMA physical-range check; every other
+ * runtime decision goes through the selected DadaoProfile.
+ *
+ * Vast: PA RAM is the single writable memory, 2 GiB at PA 0.  The CPU reaches
+ * it only through the PTW (VA=PA identity in the first page table), so the
+ * canonical base is 0 (= the unmapped-alias constant below).  The single
+ * non-volatile BootROM is 4 MiB at 0xffff_ffc0_0000..0xffff_ffff_ffff; the
+ * reset vector is its last 64 KiB start (0xffff_ffff_0000). */
+#define DADAO_RAM_BASE      0x000000000000ULL
+#define DADAO_RAM_SIZE      (2048ULL * 1024 * 1024)  /* 2 GiB; 64-bit product */
+#define DADAO_ROM_BASE      0xFFFFFFC00000ULL
+#define DADAO_ROM_SIZE      (4 * 1024 * 1024)     /* 4 MiB */
+#define DADAO_BIOS_LOAD_BASE 0xffffffff0000ULL   /* legacy -bios reset window */
+#define DADAO_BIOS_WINDOW_SIZE (64 * 1024)       /* legacy -bios limit */
+/* PA 0 is the start of the Vast RAM (the first page table lives at PA 0 /
+ * PTBR=0); the constant is kept for the DMA range check. */
+#define DADAO_RAM_ALIAS_BASE 0x000000000000ULL
+
+/* Internal address space: cfxha = addr[47:42] (DADAO-12 §2.1).  addr[47:42]
+ * == 0 is the memory window: with ptw_enable == 0 an access/fetch there is a
+ * CFXMEM because the window is never a pmem pass-through; with ptw_enable == 1
+ * the two-level page-table walk runs (DADAO-12 §2.2.1/§2.2.2; ADR-0040
+ * D1-D10).  All of these direct machine faults leave through the current
+ * run-mode monitor segment (spec/Machine-v5 §7.1).
+ * Reserved cfx (6-14, 16-31, 35-61) plain ld/st are also CFXMEM (ADR-0039
+ * Step 1-c); unmapped addresses are reported as CFXMEM too. */
+#define DADAO_CFXHA_SHIFT   42
+#define DADAO_CFXHA_MASK    0x3F
+#define DADAO_CFXHA_UMON    0
+#define DADAO_CFXHA_POWER   63
+#define DADAO_CFXHA_HMON    3
+#define DADAO_ADDR_CFXHA(a) (((uint64_t)(a) >> DADAO_CFXHA_SHIFT) & DADAO_CFXHA_MASK)
+
+/* ===================================================================
+ * Runtime machine profiles (spec/Machine-v5 §1, ADR-0043; QEMU-079t/080t)
+ *
+ * The machine type selects its geometry / capability set from a DadaoProfile,
+ * so the Tiny (64 KiB BootROM + 8 MiB SRAM, no cfx) and Vast (4 MiB BootROM +
+ * 2 GiB PA RAM, full cfx/PTW) geometries never share compile-time constants.
+ * The canonical DADAO_RAM_BASE / DADAO_RAM_SIZE / DADAO_ROM_BASE /
+ * DADAO_ROM_SIZE / DADAO_RESET_PC macros above are the Vast values
+ * (`check-interface`); every runtime decision goes through env->prof, never
+ * through those macros.
+ *
+ * Selection: `-machine dadao-tiny` / `-machine dadao-vast` (M12) fixes the
+ * profile; there is no runtime `profile=` selector or machine-name alias.
+ * =================================================================== */
+typedef struct DadaoProfile {
+    const char *name;           /* selector value: "tiny" / "vast" */
+    uint64_t ram_base;
+    uint64_t ram_size;
+    uint64_t rom_base;          /* BootROM (non-volatile) */
+    uint64_t rom_size;
+    uint64_t reset_pc;          /* cfx_power_hypv_excp_vector */
+    uint64_t bios_load_base;    /* legacy `-bios` 64 KiB reset window */
+    uint64_t bios_window_size;
+    uint64_t kernel_base;       /* raw `-kernel` load base */
+    uint64_t kernel_entry;      /* raw application entry (base+reserved) */
+    uint64_t kernel_reserved;   /* leading zero bytes of a raw image */
+    /* Tiny: the fixed 64 KiB BootROM firmware is mandatory (spec/Machine-v5
+     * §6 "image = fixed firmware + application"); an ELF e_entry must also be
+     * the fixed application entry (0xffff_ff01_0100). */
+    bool bootrom_required;
+    bool fixed_kernel_entry;
+    /* Tiny test-machine convention (spec/Machine-v5 §2): switch_run_mode
+     * writes are ignored; the register keeps its saved value (3 = hypv) and
+     * reads it back. */
+    bool switch_run_mode_write_ignored;
+    bool ram_alias;             /* add a PA-0 alias for the first page table */
+    bool hmon_sram;             /* cfx3 hmon 64 KiB SRAM (both profiles) */
+    bool smon_sram;             /* cfx2 smon 64 KiB SRAM (Vast only) */
+    bool pmem_sram;             /* cfx_pmem (cfx32) 64 KiB SRAM */
+    /* cfxha values this profile implements: bit N set => cfxN exists
+     * (DADAO-12 §5.2(一); spec/Machine-v5 §3 per-profile list).  Every other
+     * cfxha is reserved (ILLI) or allocated-but-unimplemented (CFXREG for a
+     * register access). */
+    uint64_t cfx_impl_mask;
+    /* `trap` to an allocated-but-unimplemented cfx: Tiny maps it to ILLI
+     * (spec/Machine-v5 §3 Tiny bullet), Vast keeps CFXREG. */
+    bool unimpl_cfx_trap_illi;
+    /* ELF PT_LOAD may target the hmon SRAM.  No profile allows it under the
+     * Tiny hmon load contract (spec/Machine-v5 §6.2): the power stub is the
+     * only writer of hmon SRAM.  The field is kept for the loader's region
+     * table so a future profile can opt in explicitly. */
+    bool mon_elf_segments;
+    bool ptw_supported;         /* cfx4 PTW/TLB (memory window can translate) */
+    bool rom_elf_segments;      /* ELF PT_LOAD may target the BootROM */
+    bool unmapped_is_cfxmem;    /* every unmapped access => CFXMEM (Tiny) */
+    /* Every execution-time synchronous exception enters the current run-mode
+     * monitor (DADAO-12 §5.2(一), Machine-v5 §4.4).  Tiny needs this; Vast
+     * still uses the staged M1 mapping of those causes to a machine-fault exit
+     * code (see dadao_cpu_do_interrupt), which its probe oracles encode. */
+    bool sync_exc_monitor_entry;
+    bool user_mode;             /* user/jail/supv reachable via cfx switches */
+    bool semihosting;
+} DadaoProfile;
+
+/* Machine-v5-Tiny geometry (spec/Machine-v5 §1.1/§6).  Address high 6 bits
+ * are always 0x3F; the SRAM is the only writable memory and the BootROM is
+ * exactly the 64 KiB reset window. */
+#define DADAO_TINY_RAM_BASE        0xFFFFFF000000ULL
+#define DADAO_TINY_RAM_SIZE        (8 * 1024 * 1024)
+#define DADAO_TINY_ROM_BASE        0xFFFFFFFF0000ULL
+#define DADAO_TINY_ROM_SIZE        (64 * 1024)
+#define DADAO_TINY_RESET_PC        0xFFFFFFFF0000ULL
+#define DADAO_TINY_KERNEL_BASE     0xFFFFFF010000ULL
+#define DADAO_TINY_KERNEL_ENTRY    0xFFFFFF010100ULL
+#define DADAO_TINY_KERNEL_RESERVED 0x100ULL
+
+/* Machine-v5-Vast geometry (spec/Machine-v5 §1.1/§6; user ruling 2026-11-03):
+ * 4 MiB BootROM, reset at its last 64 KiB start, 2 GiB PA RAM at PA 0 reached
+ * through the PTW identity map, and the test body entry at RAM + 1 MiB.  The
+ * raw -kernel image has no reserved prefix (kernel_base == entry). */
+#define DADAO_VAST_RAM_BASE        0x000000000000ULL
+#define DADAO_VAST_RAM_SIZE        (2048ULL * 1024 * 1024)
+#define DADAO_VAST_ROM_BASE        0xFFFFFFC00000ULL
+#define DADAO_VAST_ROM_SIZE        (4 * 1024 * 1024)
+#define DADAO_VAST_RESET_PC        0xFFFFFFFF0000ULL
+#define DADAO_VAST_KERNEL_BASE     0x000000100000ULL
+#define DADAO_VAST_KERNEL_ENTRY    0x000000100000ULL
+#define DADAO_VAST_KERNEL_RESERVED 0x0ULL
+
+extern const DadaoProfile dadao_profile_vast;
+extern const DadaoProfile dadao_profile_tiny;
+
+/* True iff the active profile implements cfx `cfxha` (DADAO-12 §5.2(一)).
+ * A profile that does not implement a cfx has no register file row, no
+ * exception vector and no two-axis masks for it: register access =>
+ * CFXREG, `trap`/`escape` => ILLI, plain ld/st => CFXMEM. */
+static inline bool dadao_cfx_implemented(const DadaoProfile *prof, int cfxha)
+{
+    return cfxha >= 0 && cfxha < 64 &&
+           (prof->cfx_impl_mask & (1ULL << cfxha)) != 0;
+}
+
+/*
+ * Address space (ADR-0039 §8.5 Step 1; DADAO-12 §2.2; ADR-0040 Step 2):
+ *   - CPU address = 48 bits; addr[47:42] selects the partition.
+ *   - addr[47:42] == 0 is the memory window (VA[41:0], PTW).
+ *     ptw_enable == 0 => no translation => CFXMEM (never a pmem pass-through).
+ *     ptw_enable == 1 => two-level page-table walk; page-table pages live in
+ *     pmem and are read with physical addresses (no PTW/TLB recursion).
+ *   - addr[47:42] == 1..63 is cfx internal space (direct ld/st).
+ *   - PTBR is a single register holding PPN[55:16]; low 16 bits and bits
+ *     [63:56] are forced to zero.  Writing PTBR / enabling PTW does not
+ *     implicitly invalidate any TLB.
+ */
+#define DADAO_ADDR_BITS     48
+#define DADAO_ADDR_MASK     0x0000FFFFFFFFFFFFULL
+#define DADAO_PTBR_MASK     0x00FFFFFFFFFF0000ULL  /* PPN[55:16] */
+#define DADAO_VA_MASK       0x000003FFFFFFFFFFULL  /* VA[41:0] */
+#define DADAO_CFXHA_MEM     0
+
+/* Reset values (per ADR-0004 D2).  The canonical value is the Vast reset
+ * window: BootROM base + 0x3f_0000 (spec/Machine-v5 §1.1). */
+#define DADAO_RESET_PC      0xFFFFFFFF0000ULL
+#define DADAO_RESET_RF0     0x7FF800007FC00000ULL
+
+/* ===================================================================
+ * SEE/HEE run mode + cfx register file (QEMU-044t)
+ * Spec sources: spec/DADAO-12 §1/§3/§4 ("共有/专有寄存器"), §5 (异常进入/退出
+ * 流程), spec/DADAO-13 §1 (cg3/hypv), spec/SimRISC-11 §特权指令.  See also
+ * .tao/contracts/contract-see.md §1/§3/§4 and spec/Machine-01-测试机运行环境.md.
+ * =================================================================== */
+
+/* Run modes: 0b00 user / 0b01 jail / 0b10 supv / 0b11 hypv (DADAO-12 §1). */
+enum {
+    DADAO_MODE_USER = 0,
+    DADAO_MODE_JAIL = 1,
+    DADAO_MODE_SUPV = 2,
+    DADAO_MODE_HYPV = 3,
+};
+
+/* Test-machine implemented cfx set: umon/jmon/smon/hmon/power (ADR-0020 D9,
+ * Machine-01 §3) plus cfx4/ptw's PTW/TLB register subset (ADR-0039 §8.5,
+ * ADR-0041), cfx32/pmem's 64 KiB SRAM + cg15 DMA (ADR-0042 Step 4), and
+ * cfx15/cfx34 (single-hart timer + global time, INTEG-050t).  Every other
+ * cfxha either is reserved (6-14, 16-31, 35-61 => ILLI) or
+ * allocated-but-unimplemented here (=> CFXREG). */
+#define DADAO_NUM_CFX 9
+extern const int dadao_cfxha_map[DADAO_NUM_CFX]; /* defined in helper.c */
+
+#define DADAO_CFX_IS_RESERVED(h)  (((h) >= 6 && (h) <= 14) || \
+                                   ((h) >= 16 && (h) <= 31) || \
+                                   ((h) >= 35 && (h) <= 61))
+
+/* Exception cause ids (one-hot, DADAO-12 §4 monitor exception table). */
+#define DADAO_CAUSE_CFXTRAP   (1ULL << 0)
+#define DADAO_CAUSE_CFXMEM    (1ULL << 1)
+#define DADAO_CAUSE_CFXREG    (1ULL << 2)
+/* Every cfx: escape frame/target error (DADAO-12 §4; ADR-0045 D6). */
+#define DADAO_CAUSE_CFXESC    (1ULL << 3)
+/* cfx0-3 monitors: cfx two-axis permission denial and page-table
+ * HSJU/R/W/X denial (DADAO-12 §2.2.6/§5.2; ADR-0045 D6). */
+#define DADAO_CAUSE_CFXPERM   (1ULL << 7)
+#define DADAO_CAUSE_ILLI      (1ULL << 8)
+#define DADAO_CAUSE_UNDI      (1ULL << 9)
+#define DADAO_CAUSE_RASOF     (1ULL << 10)
+#define DADAO_CAUSE_RASUF     (1ULL << 11)
+#define DADAO_CAUSE_MALIGN    (1ULL << 12)
+#define DADAO_CAUSE_IALIGN    (1ULL << 13)
+/* Page-table missing/fragment and A/D write-back failure are reported as
+ * CFXMEM (DADAO-12 §2.2.6/§5.2 + Machine-v5 §7.1); there is no PTWERR or
+ * page-level one-hot cause any more. */
+
+#define DADAO_CFXHA_PTW        4   /* cfx4 / ptw (DADAO-12 §1) */
+#define DADAO_CFXHA_HART       15  /* cfx15 / hart (DADAO-12 §4.7) */
+#define DADAO_CFXHA_PMEM       32  /* cfx32 / pmem (DADAO-12 §1) */
+#define DADAO_CFXHA_TIME       34  /* cfx34 / time (DADAO-12 §4.10) */
+
+/* ── cfx_hart timer + cfx_time (DADAO-12 §4.7/§4.10; INTEG-050t) ─────────
+ * Single hart only: the timer is one-shot, deadline in the cfx_time domain
+ * (1 count = 1 ns on the test machine).  TIMER is maskable (1 << 10) with
+ * cause_info = 0; an IMASK-ed expiry records the existing per-cfx pending bit
+ * (cfx_hart cg5 rc5), it does not create a new pending bitmap. */
+#define DADAO_CAUSE_TIMER      (1ULL << 10)
+#define DADAO_TIME_FREQ        1000000000ULL
+#define DADAO_HART_TIMER_ENABLE (1U << 0)
+#define DADAO_HART_TIMER_IMASK  (1U << 1)
+#define DADAO_HART_TIMER_ISTATUS (1U << 2)
+
+/* ── cfx_pmem SRAM + DMA (DADAO-12 §2.1/§4.9; ADR-0042 D3/D4/D6/D7) ─────
+ * The 64 KiB SRAM lives at internal offset 0x3ff_0000_0000 of cfx_pmem.  The test machine
+ * backs it with a RAM MemoryRegion mapped at a host address *outside* the
+ * 56-bit guest PA space, so a guest PA can never alias it; the CPU reaches it
+ * through tlb_fill (paddr = DADAO_PMEM_SRAM_HOST_BASE + offset) and the DMA
+ * through the system address space.
+ *
+ * dma_status: bit0 BUSY (RO), bit1 DONE (W1C), bit2 ERROR (W1C),
+ * bits[15:3] ERR_CODE (one-hot, RO). */
+#define DADAO_PMEM_SRAM_SIZE    (64 * 1024)
+#define DADAO_PMEM_SRAM_CFX_OFFSET 0x3FF00000000ULL
+#define DADAO_PMEM_SRAM_HOST_BASE  0x0100000000000000ULL
+
+/* ── hmon/smon SRAM (ADR-0043 D4/D5) ────────────────────────────────────
+ * Each monitor owns a 64 KiB SRAM at internal offset 0x3ff_0000_0000 of its
+ * own cfx (hmon = cfx3 at 0x0fff_0000_0000, smon = cfx2 at
+ * 0x0bff_0000_0000).  Like the cfx_pmem SRAM they are backed by RAM regions
+ * at host addresses outside the 56-bit guest PA space; tlb_fill routes the
+ * cfx-internal window, an offset beyond 64 KiB is CFXMEM. */
+#define DADAO_MON_SRAM_SIZE        (64 * 1024)
+#define DADAO_MON_SRAM_CFX_OFFSET  0x3FF00000000ULL
+#define DADAO_HMON_CFX_BASE        ((3ULL << 42) | DADAO_MON_SRAM_CFX_OFFSET)
+#define DADAO_SMON_CFX_BASE        ((2ULL << 42) | DADAO_MON_SRAM_CFX_OFFSET)
+#define DADAO_HMON_SRAM_HOST_BASE  0x0100000001000000ULL
+#define DADAO_SMON_SRAM_HOST_BASE  0x0100000002000000ULL
+
+#define DADAO_PMEM_DMA_BUSY     (1ULL << 0)
+#define DADAO_PMEM_DMA_DONE     (1ULL << 1)
+#define DADAO_PMEM_DMA_ERROR    (1ULL << 2)
+#define DADAO_PMEM_DMA_ERR_CODE_SHIFT 3
+#define DADAO_PMEM_DMA_ERR_CODE_MASK  0x1FFFULL   /* status[15:3] */
+/* ERR_CODE one-hot values (spec §4.9); the field holds 13 bits (bit3..15). */
+#define DADAO_PMEM_DMA_ERR_SIZE      (1ULL << 0)
+#define DADAO_PMEM_DMA_ERR_CFX_RANGE (1ULL << 1)
+#define DADAO_PMEM_DMA_ERR_PA_RANGE  (1ULL << 2)
+#define DADAO_PMEM_DMA_ERR_PA_FAULT  (1ULL << 3)
+/* dma_ctrl bits */
+#define DADAO_PMEM_DMA_CTRL_START   (1ULL << 0)   /* self-clearing */
+#define DADAO_PMEM_DMA_CTRL_DIR     (1ULL << 1)   /* 0=CFX->PA, 1=PA->CFX */
+#define DADAO_PMEM_DMA_CTRL_IRQ_EN  (1ULL << 2)
+/* Asynchronous, maskable completion/error interrupt (spec §4.9; ADR-0042 D7.4). */
+#define DADAO_CAUSE_PMEM_DMA    (1ULL << 8)
+
+/* ── TLB (DADAO-12 §2.2.1/§4.5; ADR-0041) ─────────────────────────────
+ * The TLB is part of cfx_ptw: there is no separate cfx_tlb, no tlb_enable /
+ * tlb_exist and no ASID-independent index.  Entries are matched by (virtual
+ * page AND ASID), with G=1 entries matching across ASIDs.  The array size and
+ * the replacement policy are implementation choices (ADR-0041 D8).
+ *
+ * A_local/D_local mirror the PTE A/D bits of the entry; A_dirty/D_dirty mark
+ * "the guest-visible PTE must be updated with A/D on the next write-back"
+ * (ADR-0041 D4): fill never sets dirty, a load/fetch sets A, a store sets A/D.
+ */
+#define DADAO_TLB_ENTRIES      64
+
+#define DADAO_TLB_FLAG_R       (1u << 0)
+#define DADAO_TLB_FLAG_W       (1u << 1)
+#define DADAO_TLB_FLAG_X       (1u << 2)
+#define DADAO_TLB_FLAG_G       (1u << 3)
+
+typedef struct DADAOTlbEntry {    uint64_t va;        /* virtual page base (aligned to the page size) */
+    uint64_t pa;        /* physical page base */
+    uint64_t pte_pa;    /* PA of the leaf PTE (A/D write-back target) */
+    uint8_t  hsju;      /* PTE[63:60] as a 4-bit value (H=3,S=2,J=1,U=0) */
+    uint8_t  frags;     /* SPF (superpage) or GPF (normal page) byte */
+    uint8_t  size_log2; /* page size: 29 (superpage) or 16 (normal page) */
+    uint8_t  flags;     /* DADAO_TLB_FLAG_{R,W,X,G} */
+    uint16_t asid;      /* ASID the entry was filled under (G ignores it) */
+    bool     a_local;
+    bool     d_local;
+    bool     a_dirty;
+    bool     d_dirty;
+    bool     valid;
+} DADAOTlbEntry;
+
+/* cfx_ptw_tlb_control command results (DADAO-12 §4.5; ADR-0041 D3/D6/D10). */
+enum {
+    DADAO_TLB_CMD_OK = 0,
+    DADAO_TLB_CMD_AD_WB_FAIL = -1,   /* A/D write-back failed -> CFXMEM (*err_pa = PTE PA) */
+    DADAO_TLB_CMD_CFXREG = -2,   /* illegal operand: scope=11 / range+size=0 */
+};
+
+/* cg0-cg3 shared ("共有") per-mode registers (DADAO-12 §3; ADR-0045 D2/D3).
+ * Four 64-bit source masks (rc0..rc3), the per-cfx interrupt source mask
+ * (rc4), and the mode-transfer/exception registers (rc8, rc10, rc12); rc9 and
+ * rc11 are reserved holes and keep no state (access => CFXREG).  The bit
+ * index of every source mask is the *source* cfxha; self access bypasses the
+ * cfx axis but still uses the current-mode register row (D1). */
+typedef struct DADAOCfxModeRegs {
+    uint64_t cfxtrap;          /* rc0  trap/escape control transfer */
+    uint64_t cfxmem;           /* rc1  direct ld/st into this cfx */
+    uint64_t cfxreg;           /* rc2  cfx2rd/cfx2rc */
+    uint64_t cfxexe;           /* rc3  direct execution/fetch into this cfx */
+    uint64_t cfx_intr_mask;    /* rc4  async interrupt source mask */
+    uint64_t switch_run_mode;  /* rc8  */
+    uint64_t excp_vector;      /* rc10 */
+    uint64_t cg_reg_deleg;     /* rc12 (cg3/hypv only, DADAO-13 §1) */
+} DADAOCfxModeRegs;
+
+/* Per-cfx cg4..cg6 (config / exception frame / scratch).  cg7 (internal
+ * space description) is a static read-only table, not per-cfx state
+ * (DADAO-12 §3.8). */
+typedef struct DADAOCfxRegs {
+    DADAOCfxModeRegs mode[4];   /* cg0..cg3 */
+    uint64_t global_cfx_intr_mask; /* cg8 rc1 (cfx0-3 only; ADR-0045 D3) */
+    /* Hidden single-frame state for D9: trap saves the entry-mode monitor's
+     * global_cfx_intr_mask here and sets the architectural register all-1;
+     * escape restores it.  Not software-visible (frame_active is out of scope). */
+    uint64_t saved_global_intr_mask;
+    uint8_t  saved_intr_monitor;   /* cfx0-3 whose global mask was saved */
+    bool     saved_intr_mask_valid; /* a live frame saved it (trap entry) */
+    uint64_t cfx_id;            /* cg4 rc0 (RO) */
+    uint64_t version;           /* cg4 rc1 (RO) */
+    uint64_t trap_num;          /* cg4 rc2 */
+    uint64_t excp_sync_num;     /* cg4 rc3 */
+    uint64_t excp_async_num;    /* cg4 rc4 */
+    uint64_t escape_num;        /* cg4 rc5 */
+    uint64_t scratch_regs_num;  /* cg4 rc6 (RO) */
+    uint64_t prev_run_mode;     /* cg5 rc0 */
+    uint64_t cause_id;          /* cg5 rc2 (RO) */
+    uint64_t cause_ip;          /* cg5 rc3 */
+    uint64_t cause_info;        /* cg5 rc4 (RO) */
+    uint64_t pending;           /* cg5 rc5 */
+    uint64_t scratch[4];        /* cg6 rc0..N-1 */
+} DADAOCfxRegs;
+
+/*
+ * DADAO CPU state.
+ * Register groups: rd[64], rb[64], rf[64], ra[64], pc.
+ * Field names are fixed; subsequent tasks (004t-008t) reference them directly.
+ */
+typedef struct CPUArchState {
+    uint64_t rd[64];    /* Data registers; rd0 hardwired to 0 */
+    uint64_t rb[64];    /* Base registers; rb0 = PC */
+    uint64_t rf[64];    /* Floating-point registers; rf0 = FCSR */
+    uint64_t ra[64];    /* Return address stack (ring buffer; ra0=metadata) */
+    uint64_t ras_base;  /* Ring-buffer base index (hidden, non-architectural) */
+    uint64_t ras_tmp;   /* Temp storage for ras_pop return value (hidden) */
+    uint64_t pc;        /* Program counter (alias for rb0 read) */
+
+    /* ── LR/SC reservation (QEMU-067t; SimRISC-11 §4.2, ADR-0034 D6) ──
+     * Per guest thread ("hart").  Granularity = the exact naturally aligned
+     * 8-byte word that contains the address observed by `lr`: `sc` succeeds
+     * only while the reservation is still held for that word AND the whole
+     * word still holds the value observed by `lr` (a single 8-byte host CAS).
+     * Cleared by: another `lr`, every `sc` (success or failure), a new guest
+     * thread, and exception/interrupt entry. */
+    uint64_t lock_addr;   /* 8-byte aligned word address (meaningful iff valid) */
+    uint64_t lock_val;    /* whole word observed by `lr` (target byte order) */
+    uint32_t lock_valid;  /* reservation held */
+
+    /* ── SEE/HEE state (QEMU-044t) ── */
+    uint8_t  inner_run_mode;             /* 0..3 (DADAO-12 §1) */
+    uint8_t  inner_cfx_code;             /* current cfxha 0..63 */
+    DADAOCfxRegs cfx[DADAO_NUM_CFX];     /* implemented cfx {0,1,2,3,4,15,17,18,63} */
+
+    /* Runtime machine profile (QEMU-079t; spec/Machine-v5 §1).  Set by the
+     * machine before qdev_realize() so reset can derive PC/geometry from it;
+     * NULL means the Vast profile (safe default for the linux-user build and
+     * for a CPU created without a machine). */
+    const DadaoProfile *prof;
+
+    /* ── Address-space Step 1 (ADR-0039 §8.5) ──
+     * Single PTBR (cfx_ptw cg9 rc0): PPN[55:16]; low 16 bits and [63:56] read
+     * as 0.  ptw_enable (cfx_ptw cg8 rc8): 0 => high6=0 accesses take CFXMEM,
+     * 1 => page-table walk (DADAO-12 §2.2.1/§2.2.2).  Reset values are
+     * both 0; writes are plain stores (no implicit TLB flush). */
+    uint64_t ptbr;
+    uint64_t ptw_enable;
+    /* Pending page-table fault (DADAO_EXCP_PTW_FAULT): monitor cause id
+     * (CFXMEM for missing/fragment/A-D, CFXPERM for HSJU/R/W/X) and the
+     * faulting virtual address (cause_info).  For an A/D write-back failure
+     * (ADR-0041 D10) cause_info is the failing PTE physical address. */
+    uint64_t ptw_fault_cause;
+    uint64_t ptw_fault_info;
+    /* Pending two-axis permission denial (DADAO_EXCP_CFXPERM): cause_info is
+     * the faulting address (ld/st/fetch) or the instruction encoding. */
+    uint64_t cfx_perm_info;
+    /* cause_info of a pending generic synchronous exception
+     * (DADAO_EXCP_{ILLI,UNDI,CFXMEM,MALIGN,IALIGN,RASOF,RASUF}): the
+     * instruction encoding, the faulting address or the IP value, per
+     * DADAO-12 §5.2(二) / Machine-v5 §4.4.  Set by raise_exception /
+     * tlb_fill / do_unaligned_access before the CPU exits the TB. */
+    uint64_t sync_fault_info;
+    /* ── TLB (cfx_ptw cg12; DADAO-12 §4.5, ADR-0041 D2/D3) ──
+     * tlb_asid stores [15:0]; tlb_start/tlb_size are the invalidate window
+     * operands (reset 0 -> a range operation needs an explicit size). */
+    DADAOTlbEntry tlb[DADAO_TLB_ENTRIES];
+    uint32_t tlb_next;      /* round-robin replacement cursor */
+    uint64_t tlb_asid;
+    uint64_t tlb_start;
+    uint64_t tlb_size;
+    uint64_t tlb_control;   /* write-only command latch (never read back) */
+
+    /* ── cfx_pmem SRAM/DMA (DADAO-12 §4.9; ADR-0042; single hart) ──
+     * cg15 registers plus the latched transfer description captured at START.
+     * The completion is asynchronous (QEMUTimer, virtual clock), so BUSY is
+     * observable; the DMA itself is a single memcpy of at most 64 KiB. */
+    uint64_t pmem_dma_src;
+    uint64_t pmem_dma_dst;
+    uint64_t pmem_dma_size;      /* 30-bit field */
+    uint64_t pmem_dma_ctrl;      /* START always reads 0 */
+    uint64_t pmem_dma_status;
+    uint8_t  pmem_dma_dir;       /* 0 = CFX->PA, 1 = PA->CFX (latched) */
+    uint8_t  pmem_dma_irq_en;    /* latched dma_ctrl.IRQ_EN */
+    uint64_t pmem_dma_cfx_off;   /* latched SRAM offset */
+    uint64_t pmem_dma_pa;        /* latched physical address */
+    uint64_t pmem_dma_len;       /* latched byte count */
+    QEMUTimer *pmem_dma_timer;
+
+    /* ── cfx_time + cfx_hart timer (DADAO-12 §4.7/§4.10; INTEG-050t) ──
+     * Single hart: time_base_ns is the reset epoch of the virtual clock and
+     * cfx_time_value/cycle read (now - base).  `hart_insn` counts instructions
+     * in dadao_tr_insn_start() (translate.c).  The timer is one-shot; a pending
+     * TIMER is recorded in the target cfx's cg5 rc5 (bit10) and is not a
+     * separate per-source flag (INTEG-051t: pending lives in the target cfx,
+     * cfx_hart only arbitrates). */
+    uint64_t time_base_ns;
+    uint64_t hart_insn;
+    uint64_t hart_timer_cmp;
+    uint8_t  hart_timer_ctrl;    /* bit0 ENABLE, bit1 IMASK */
+    QEMUTimer *hart_timer;
+} CPUDADAOState;
+
+/* Resolve the active profile; an unset pointer means the Vast profile (the
+ * linux-user build never has a machine to set one). */
+#define DADAO_PROFILE(env) \
+    ((env)->prof ? (env)->prof : &dadao_profile_vast)
+
+/**
+ * DadaoCPU:
+ * @env: #CPUDADAOState
+ *
+ * A DADAO CPU.
+ */
+struct ArchCPU {
+    CPUState parent_obj;
+
+    CPUDADAOState env;
+};
+
+/**
+ * DadaoCPUClass:
+ * @parent_realize: The parent class' realize handler.
+ * @parent_phases: The parent class' reset phase handlers.
+ *
+ * A DADAO CPU model.
+ */
+struct DadaoCPUClass {
+    CPUClass parent_class;
+
+    DeviceRealize parent_realize;
+    ResettablePhases parent_phases;
+};
+
+#ifndef CONFIG_USER_ONLY
+void dadao_cpu_do_interrupt(CPUState *cpu);
+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr);
+/* cfx_pmem DMA (DADAO-12 §4.9; ADR-0042) */
+void dadao_pmem_dma_init(CPUState *cs);
+void dadao_pmem_dma_reset(CPUDADAOState *env);
+/* cfx_time + single-hart cfx_hart timer (DADAO-12 §4.7/§4.10; INTEG-050t) */
+void dadao_hart_timer_init(CPUState *cs);
+void dadao_hart_timer_reset(CPUDADAOState *env);
+/* Unified async arbitration (INTEG-051t): every asynchronous source records
+ * its pending bit in the *target* cfx's cg5 rc5 (TIMER -> cfx_hart bit10,
+ * PMEM_DMA -> cfx_pmem bit8); this one function selects the lowest deliverable
+ * target cfxha and runs at most one cfx_enter(async) per call. */
+bool dadao_async_arbitrate(CPUState *cs);
+#endif
+
+void dadao_cpu_tcg_init(void);
+void dadao_cpu_translate_code(CPUState *cs, TranslationBlock *tb,
+                              int *max_insns, vaddr pc, void *host_pc);
+
+static inline int cpu_interrupts_enabled(CPUDADAOState *env)
+{
+    /* M1 has no interrupt model */
+    return 0;
+}
+
+#endif /* TARGET_DADAO_CPU_H */
