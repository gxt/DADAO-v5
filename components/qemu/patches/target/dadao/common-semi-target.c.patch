index 0000000..83c1a02
--- /dev/null
+++ b/target/dadao/common-semi-target.c
@@ -0,0 +1,200 @@
+/*
+ * Target-specific parts of semihosting/arm-compat-semi.c for the DADAO
+ * test machine (QEMU-046t).
+ *
+ * Spec sources (spec-first):
+ *   spec/Machine-01-测试机运行环境.md §5.2/§5.4 (semihosting calling
+ *     convention and return mechanism: service number rd16, argument-block
+ *     pointer rb16, scalar return rd8; pc += 4; full 25-service table,
+ *     SYS_EXIT).
+ *   .tao/contracts/contract-semihosting.md §2/§4 (return value -> rd8;
+ *     pc += 4 return).
+ *   .tao/adr/adr-0020-see-semihosting.md D4/D5/D6 (PC-step return, shared
+ *     responder reuse, always 64-bit big-endian); D2/D14 argument mapping
+ *     (service number -> rd16, argument-block pointer -> rb16).
+ *   .tao/contracts/contract-abi.md §2.1 (SP = rb1 / rbsp), §4.1/§4.4
+ *     (rd16-rd31 data args, rb16-rb31 address args, rd8 scalar return).
+ *
+ * v5 keeps the three DADAO register banks (rd/rb/rf) independent, each
+ * numbered from 16, whereas the shared layer's common_semi_arg(cs, n) assumes
+ * the "a0 + n, same bank" layout.  This hook therefore maps by argument
+ * number instead of by register offset:
+ *     common_semi_arg(cs, 0) -> rd16  (service number / scalar)
+ *     common_semi_arg(cs, 1) -> rb16  (argument-block pointer / address)
+ * and common_semi_set_ret() -> rd8 (Machine-01 §5.2: scalar return -> rd8).
+ *
+ * The shared responder (do_common_semihosting in semihosting/arm-compat-semi.c)
+ * is reused unmodified (ADR-0020 D5).
+ *
+ * Semihosting pointer arguments are **physical addresses** (spec/Kaiwu
+ * §5.2 / contract-semihosting §2, user ruling 2026-11-15), so this file also
+ * overrides the shared string hook `common_semi_strlen()` with a PA walk; the
+ * rest of the shared layer already reads pointers through the PA path
+ * (`semihosting/uaccess.h` -> `cpu_memory_rw_debug()`).  The same rule reaches
+ * the *internal* scratch slot of SYS_READC / SYS_FLEN, which the shared layer
+ * would otherwise derive from the stack pointer: that hook
+ * (`common_semi_scratch_addr()`) is overridden here too (ISS-452).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "semihosting/common-semi.h"
+
+/* Register roles fixed by Machine-01 §5.2 / ADR-0020 D2/D14. */
+#define DADAO_SEMI_NUM_REG  16   /* rd16: service number (scalar) */
+#define DADAO_SEMI_ARG_REG  16   /* rb16: argument-block pointer (address) */
+#define DADAO_SEMI_RET_REG   8   /* rd8: scalar return value */
+#define DADAO_SEMI_SP_REG    1   /* rb1 == rbsp (contract-abi.md §2.1) */
+
+#ifndef CONFIG_USER_ONLY
+/*
+ * Semihosting string arguments are **physical addresses**
+ * (spec/Kaiwu §5.2, contract-semihosting §2: "参数块指针与 SYS_WRITEC /
+ * SYS_WRITE0 的指针都是物理地址，不经页表翻译"; user ruling 2026-11-15).
+ *
+ * The shared layer's default hook measures a string by walking it through the
+ * current MMU context (`uaccess_strlen_user` -> `probe_access_flags`), which is
+ * wrong here twice over: on kaiwu-vast `ptw_enable` is 1 once the SEE enables
+ * the PTW (spec/Kaiwu §6.3), and the guest's VAs are biased by 2 TiB, so
+ * a PA is simply not a mapped VA.  A PA handed to SYS_WRITE0 therefore faulted
+ * (ISS-450).  This strong definition replaces the weak default at link time
+ * and reads physical memory instead — `cpu_memory_rw_debug()` here goes
+ * through `dadao_cpu_translate_for_debug()`, whose dadao implementation maps
+ * address == PA (RAM / BootROM / monitor SRAM) and never consults the page
+ * table.  That is the same path every other semihosting pointer already takes
+ * (`lock_user`/`unlock_user`, `get_user_u64`/`put_user_u64` in
+ * semihosting/uaccess.h), so after this hook the whole semihosting surface
+ * treats pointers as PAs.
+ */
+ssize_t common_semi_strlen(CPUState *cs, vaddr addr)
+{
+    char buf[256];
+    ssize_t len = 0;
+
+    for (;;) {
+        char *nul;
+
+        if (cpu_memory_rw_debug(cs, addr + len, buf, sizeof(buf), false)) {
+            /*
+             * The whole block is not readable (the string may end at the end
+             * of a memory region), so finish byte by byte: a short walk still
+             * measures correctly and a real fault is still reported.
+             */
+            for (;;) {
+                uint8_t c;
+
+                if (cpu_memory_rw_debug(cs, addr + len, &c, 1, false)) {
+                    return -1;
+                }
+                if (c == 0) {
+                    return len;
+                }
+                if (++len > INT32_MAX) {
+                    return -1;
+                }
+            }
+        }
+        nul = memchr(buf, 0, sizeof(buf));
+        if (nul) {
+            return len + (nul - buf);
+        }
+        len += sizeof(buf);
+        if (len > INT32_MAX) {
+            return -1;
+        }
+    }
+}
+
+/*
+ * Internal scratch slot of SYS_READC / SYS_FLEN (ISS-452).
+ *
+ * Upstream puts it just below the stack pointer, which is right when the
+ * stack pointer is expressed in the semihosting pointer space.  On DADAO that
+ * holds only while the machine runs on raw physical addresses; from the moment
+ * a page table is live (contract/linux-boot.yml §6.3: PTW on, VA = PA + 2 TiB)
+ * `rb1` is a **VA** while every semihosting pointer is a **PA**
+ * (spec/Kaiwu §5.2, contract-semihosting §2, user ruling 2026-11-15).  The
+ * responder then reads `VA - 1` as a PA: the address is 2 TiB beyond RAM, the
+ * read fails and SYS_READC returns EFAULT instead of a character (SYS_FLEN's
+ * gdb_stat block likewise).  The slot itself is the right place — it is the
+ * scratch area the guest's own ABI designates below SP — so convert it.
+ *
+ * Which conversion applies follows the machine's own address-space model
+ * (DADAO-12 §2.2, ADR-0039): only the cfxha==MEM window is translated by the
+ * PTW, every other partition is addressed physically — kaiwu-tiny keeps its
+ * RAM/ROM at 0xffff_ff00_0000 and has no PTW at all, and the hmon/smon SRAMs
+ * live in their own cfx windows.  That is the same partition test
+ * dadao_cpu_translate_for_debug() applies to semihosting pointers, so the slot
+ * ends up in exactly the address space the responder reads:
+ *   - cfxha != MEM, or ptw_enable == 0: the stack pointer is already physical
+ *     (tiny, or a Vast stage before smon turns the PTW on) -> use it as is;
+ *   - cfxha == MEM with the PTW on: the stack slot is a VA -> walk the page
+ *     table and hand the PA of the very same slot to the responder.
+ * A slot that is neither physical nor mapped-and-writable has no PA, and the
+ * service fails with EFAULT instead of writing somewhere else.
+ */
+int common_semi_scratch_addr(CPUState *cs, uint64_t size, uint64_t *addr)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    uint64_t slot = common_semi_stack_bottom(cs) - size;
+    hwaddr pa;
+
+    if (DADAO_ADDR_CFXHA(slot) != DADAO_CFXHA_MEM || !(env->ptw_enable & 1)) {
+        *addr = slot;
+        return 0;
+    }
+    if (!dadao_cpu_va_to_pa(env, slot, &pa)) {
+        return -1;
+    }
+    *addr = pa;
+    return 0;
+}
+#endif /* !CONFIG_USER_ONLY */
+
+uint64_t common_semi_arg(CPUState *cs, int argno)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    switch (argno) {
+    case 0:
+        return env->rd[DADAO_SEMI_NUM_REG];
+    case 1:
+        return env->rb[DADAO_SEMI_ARG_REG];
+    default:
+        /* The semihosting ABI only uses argument numbers 0 and 1. */
+        return 0;
+    }
+}
+
+void common_semi_set_ret(CPUState *cs, uint64_t ret)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->rd[DADAO_SEMI_RET_REG] = ret;
+}
+
+bool is_64bit_semihosting(CPUArchState *env)
+{
+    (void)env;
+    return true;   /* v5 is always 64-bit (ADR-0020 D6) */
+}
+
+bool common_semi_sys_exit_is_extended(CPUState *cs)
+{
+    return is_64bit_semihosting(cpu_env(cs));
+}
+
+uint64_t common_semi_stack_bottom(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    return env->rb[DADAO_SEMI_SP_REG];   /* rbsp (contract-abi.md §2.1) */
+}
+
+bool common_semi_has_synccache(CPUArchState *env)
+{
+    (void)env;
+    return true;   /* SYS_SYNCCACHE (0x19) is in the v5 service set */
+}
