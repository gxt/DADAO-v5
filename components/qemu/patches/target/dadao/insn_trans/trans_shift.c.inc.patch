+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 shamt = tcg_temp_new_i64();
+    tcg_gen_andi_i64(shamt, rdhd, 0x1F);
+    /* Sign-extend 32-bit source */
+    TCGv_i64 val = tcg_temp_new_i64();
+    tcg_gen_ext32s_i64(val, rdhc);
+    tcg_gen_sar_i64(val, val, shamt);
+    /* Keep rdhb[63:32] */
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_andi_i64(hi, rdhb, 0xFFFFFFFF00000000ULL);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    tcg_gen_andi_i64(lo, val, 0xFFFFFFFFULL);
+    tcg_gen_or_i64(rdhb, hi, lo);
+    store_rd(a->hb, rdhb);
+    return true;
+}
