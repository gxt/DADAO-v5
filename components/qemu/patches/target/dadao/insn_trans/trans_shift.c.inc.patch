+/* §3.4.1 shr.uo/shr.so/shl.uo (orrr, MISC-octa): shift
+ * shamt = rdhd[5:0] (mask to 6 bits for octa)
+ * ILLI: rdhb == 0, shamt > 63 (impossible after mask for octa)
+ * rdhb[63:0] = shifted result; high bits unchanged (N=63, all 64 bits) */
+static bool trans_shr_uo_orrr(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 shamt = tcg_temp_new_i64();
+    tcg_gen_andi_i64(shamt, rdhd, 0x3F); /* mask to 6 bits */
+    tcg_gen_shr_i64(rdhb, rdhc, shamt);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
