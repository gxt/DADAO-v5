+/* §4.2.2 rol.t (orrr, OPC-tetra): 32-bit logical rotate left
+ * amount = rdhd[4:0] (mod 32); rdhb[31:0] = rol(rdhc[31:0], amount),
+ * rdhb[63:32] = 0 (value semantics). */
+static bool trans_rol_t_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 shamt = tcg_temp_new_i64();
+    TCGv_i64 val = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    TCGv_i64 rshift = tcg_temp_new_i64();
+    tcg_gen_andi_i64(shamt, rdhd, 0x1F); /* amount mod 32 */
+    tcg_gen_andi_i64(val, rdhc, 0xFFFFFFFFULL);
+    tcg_gen_shl_i64(hi, val, shamt);
+    tcg_gen_subfi_i64(rshift, 32, shamt); /* 32 - amount (1..32) */
+    tcg_gen_shr_i64(val, val, rshift);
+    tcg_gen_or_i64(val, val, hi);
+    tcg_gen_andi_i64(val, val, 0xFFFFFFFFULL); /* zero-extend to 64 bits */
+    store_rd(a->hb, val);
+    return true;
+}
