+/* §3.4.1 shr.ut/shr.st/shl.ut (orrr, MISC-tetra): shift
+ * shamt = rdhd[4:0] (mask to 5 bits for tetra), ILLI if shamt > 31 */
+static bool trans_shr_ut_orrr(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 shamt = tcg_temp_new_i64();
+    tcg_gen_andi_i64(shamt, rdhd, 0x1F);
+    TCGv_i64 val = tcg_temp_new_i64();
+    /* Extract 32-bit source */
+    tcg_gen_andi_i64(val, rdhc, 0xFFFFFFFFULL);
+    tcg_gen_shr_i64(val, val, shamt);
+    /* Keep rdhb[63:32], insert shifted result */
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_andi_i64(hi, rdhb, 0xFFFFFFFF00000000ULL);
+    tcg_gen_or_i64(rdhb, hi, val);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_shr_st_orrr(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
