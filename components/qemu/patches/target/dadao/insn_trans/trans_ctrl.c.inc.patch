+/* ── §5.4 call-iiii: push ret_addr, PC = rb0 + (imms24 << 2) ───────── */
+/* ADR-0012 D8.3 model (乙): PC/rb0 = full 64-bit A (no truncation). */
+static bool trans_call_iiii_ra(DisasContext *ctx, arg_main *a)
+{
+    int32_t imm24 = (int32_t)((a->ha << 18) | (a->hb << 12) |
+                               (a->hc << 6) | a->hd);
+    if (imm24 & (1 << 23)) {
+        imm24 |= ~((1 << 24) - 1);
+    }
+    int64_t offset = (int64_t)imm24 << 2;
+
+    /* Push return address (next instruction) onto RegRAS */
+    TCGv_i64 ret_addr = tcg_constant_i64(ctx->base.pc_next + 4);
+    gen_ras_push(ctx, ret_addr);
+
+    /* Compute target and jump (64-bit) */
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    /* (乙): PC = full 64-bit A; rb0 = A */
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+}
+
+/* ── §5.4 call-rrii: push ret_addr, PC = rbha + rdhb + (imms12 << 2) ─ */
+/* ADR-0012 D8.3 model (乙): PC/rb0 = full 64-bit A (no truncation).
+ * rbHA only read (not modified). */
+static bool trans_call_rrii_ra(DisasContext *ctx, arg_main *a)
+{
+    int32_t imm12 = (int32_t)((a->hc << 6) | a->hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1);
+    }
+    int64_t offset = (int64_t)imm12 << 2;
+
+    /* Push return address (next instruction) onto RegRAS */
+    TCGv_i64 ret_addr = tcg_constant_i64(ctx->base.pc_next + 4);
+    gen_ras_push(ctx, ret_addr);
+
+    /* Compute target and jump (64-bit) */
+    TCGv_i64 rbha = load_rb(ctx, a->ha);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_add_i64(target, rbha, rdhb);
+    tcg_gen_addi_i64(target, target, offset);
+    /* (乙): PC = full 64-bit A; rb0 = A */
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+}
