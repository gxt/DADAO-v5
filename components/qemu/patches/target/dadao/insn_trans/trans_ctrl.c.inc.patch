+/* ── cfx/trap/escape (QEMU-044t): route into the SEE exception flow and the
+ * cfx register file (see helper.c helper_cfx_trap/escape/cfx2rd/cfx2rc).
+ * trap/escape/cfx2rd/cfx2rc now execute; cfxld/cfxst stay ILLI (scope:excluded,
+ * SimRISC-12 deferred).  These helpers always set env->pc (vector on exception
+ * entry, pc+4 otherwise), so the TB ends after the call. ── */
+
+static bool trans_cfx2rd_crrr_cfx(DisasContext *ctx, arg_main *a)
+{
+#ifdef CONFIG_USER_ONLY
+    /*
+     * User mode has no monitor context and no cfx register model (there is no
+     * test machine, ADR-0025 D2): an `escape` / cfx-register access can only
+     * be a guest bug, so it decodes to an explicit ILLI rather than running
+     * the SEE exception-exit flow against state that was never entered.
+     */
+    gen_exception_illegal(ctx);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+#else
+    gen_helper_cfx2rd(tcg_env, tcg_constant_i32(a->ha),
+                      tcg_constant_i32(a->hb), tcg_constant_i32(a->hc),
+                      tcg_constant_i32(a->hd),
+                      tcg_constant_i64(ctx->base.pc_next));
+    tcg_gen_exit_tb(NULL, 0);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+#endif /* CONFIG_USER_ONLY */
+}
