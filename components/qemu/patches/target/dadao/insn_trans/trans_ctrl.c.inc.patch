+/* ── Helper: RegRAS/MemRAS push/pop (ADR-0012 D7) ──────────────────── */
+/* Ring-buffer logic implemented in C helpers (helper.c).
+ * gen_ras_push/gen_ras_pop are thin TCG wrappers. */
+static void gen_ras_push(DisasContext *ctx, TCGv_i64 ret_addr)
+{
+    gen_helper_ras_push(tcg_env, ret_addr);
+}
+
+static TCGv_i64 gen_ras_pop(DisasContext *ctx)
+{
+    gen_helper_ras_pop(tcg_env);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_ld_i64(result, tcg_env, offsetof(CPUDADAOState, ras_tmp));
+    return result;
+}
+
+/* ── Helper: branch taken path ──────────────────────────────────────── */
+/* ADR-0012 D8.3 model (乙): PC/rb0 = full 64-bit A (no truncation).
+ * Memory EA still masked to 48 bits elsewhere (trans_mem.c.inc).
+ * QEMU TARGET_VIRT_ADDR_SPACE_BITS=48 ensures fetch/TLB use low 48. */
+static void gen_branch_taken(DisasContext *ctx, int ha, int hb, int hc, int hd)
+{
+    int32_t imm18 = (int32_t)((hb << 12) | (hc << 6) | hd);
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    int64_t offset = (int64_t)imm18 << 2;
+
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    /* (乙): PC = full 64-bit A; rb0 = A (via translation-time constant) */
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+/* ── Helper: branch taken path for rrii (br.eq/br.ne) ──────────────── */
+/* ADR-0012 D8.3 model (乙): PC/rb0 = full 64-bit A (no truncation). */
+static void gen_branch_taken_rrii(DisasContext *ctx, int hc, int hd)
+{
+    int32_t imm12 = (int32_t)((hc << 6) | hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1);
+    }
+    int64_t offset = (int64_t)imm12 << 2;
+
+    TCGv_i64 rb0 = tcg_constant_i64(ctx->base.pc_next);
+    TCGv_i64 target = tcg_temp_new_i64();
+    tcg_gen_addi_i64(target, rb0, offset);
+    /* (乙): PC = full 64-bit A; rb0 = A */
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, pc));
+    tcg_gen_st_i64(target, tcg_env, offsetof(CPUDADAOState, rb[0]));
+    tcg_gen_exit_tb(NULL, 0);
+}
+
+/* ── §5.2.2 Single-register conditional branch helpers (riii) ───────── */
+
+/* br.n rdha, imms18: if (rdha < 0) PC = rb0 + (imms18 << 2) */
+static bool trans_br_n_riii_rd(DisasContext *ctx, arg_main *a)
+{
+    TCGv_i64 rdha = load_rd(a->ha);
+    TCGLabel *label_taken = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+    tcg_gen_brcondi_i64(TCG_COND_LT, rdha, 0, label_taken);
+    tcg_gen_br(label_done);
+    gen_set_label(label_taken);
+    gen_branch_taken(ctx, a->ha, a->hb, a->hc, a->hd);
+    gen_set_label(label_done);
+    return true;
+}
+
+/* br.nn rdha, imms18: if (rdha >= 0) PC = rb0 + (imms18 << 2) */
+static bool trans_br_nn_riii_rd(DisasContext *ctx, arg_main *a)
+{
+    TCGv_i64 rdha = load_rd(a->ha);
+    TCGLabel *label_taken = gen_new_label();
+    TCGLabel *label_done = gen_new_label();
+    tcg_gen_brcondi_i64(TCG_COND_GE, rdha, 0, label_taken);
+    tcg_gen_br(label_done);
+    gen_set_label(label_taken);
+    gen_branch_taken(ctx, a->ha, a->hb, a->hc, a->hd);
+    gen_set_label(label_done);
+    return true;
+}
+
+/* br.z rdha, imms18: if (rdha == 0) PC = rb0 + (imms18 << 2)
+ * §5.2.2 special: rdha==rd0 → always taken (not ILLI) */
+static bool trans_br_z_riii_rd(DisasContext *ctx, arg_main *a)
+{
