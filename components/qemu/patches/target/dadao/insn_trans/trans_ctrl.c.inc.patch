+/* ── §5.2.1 Two-register conditional branch (rrii) ──────────────────── */
+
+/* br.eq rdha, rdhb, imms12: if (rdha == rdhb) PC = rb0 + (imms12 << 2) */
+static bool trans_br_eq_rrii_rd(DisasContext *ctx, arg_main *a)
