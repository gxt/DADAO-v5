+#else
+    uint32_t imms18 = ((uint32_t)a->hb << 12) | ((uint32_t)a->hc << 6) | a->hd;
+
+    gen_helper_cfx_escape(tcg_env, tcg_constant_i32(a->ha),
+                          tcg_constant_i32(imms18),
+                          tcg_constant_i64(ctx->base.pc_next));
