+
+static bool trans_trap_ciii_cfx(DisasContext *ctx, arg_main *a)
+{
+    uint32_t immu18 = ((uint32_t)a->hb << 12) | ((uint32_t)a->hc << 6) | a->hd;
+
+#ifdef CONFIG_USER_ONLY
+    /*
+     * linux-user (P3, ADR-0025 D2/D6): `trap cfx0, 0` is the umon syscall
+     * entry -- cfxha 0 (umon) with immu18 = SBI_UMON_SYSCALL = 0
+     * (contract-syscall.md §2).  There is no kernel and no cfx vector in this
+     * build, so the trap is handed to cpu_loop as a dedicated exception that
+     * forwards the call to the host and resumes at pc+4.
+     *
+     * Everything else is an explicit guest illegal instruction: jmon (cfx1)
+     * is the restricted-context peer entry and is not implemented here, the
+     * semihosting tag (immu18[17:16] == 2'b11) is a system-mode protocol that
+     * must not be mixed with the syscall path (contract-syscall.md §6), and
+     * the cfx register model does not exist without the test machine.  None of
+     * them may silently succeed.
+     */
+    if (a->ha == DADAO_CFXHA_UMON && immu18 == 0) {
+        gen_helper_raise_exception(tcg_env,
+                                   tcg_constant_i32(DADAO_EXCP_SYSCALL));
+        ctx->base.is_jmp = DISAS_NORETURN;
+        return true;
+    }
+    gen_exception_illegal(ctx);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+#else
+    /*
+     * Semihosting entry tag (ADR-0020 D1/D10, Machine-01 §5.1): when
+     * immu18[17:16] == 2'b11 the trap is a semihosting call, independent of
+     * cfxha.  Short-circuit at the decode layer and raise the internal
+     * DADAO_EXCP_SEMIHOST exception (same shape as RISCV_EXCP_SEMIHOST):
+     * dadao_cpu_do_interrupt then serves the call via do_common_semihosting()
+     * and steps PC past the trap -- it never enters a cfx vector.
+     */
+    if (((immu18 >> 16) & 0x3) == 0x3) {
+        gen_helper_raise_exception(tcg_env,
+                                   tcg_constant_i32(DADAO_EXCP_SEMIHOST));
+        ctx->base.is_jmp = DISAS_NORETURN;
+        return true;
+    }
+
+    gen_helper_cfx_trap(tcg_env, tcg_constant_i32(a->ha),
+                        tcg_constant_i32(immu18),
+                        tcg_constant_i64(ctx->base.pc_next));
+    tcg_gen_exit_tb(NULL, 0);
+    ctx->base.is_jmp = DISAS_NORETURN;
+    return true;
+#endif /* CONFIG_USER_ONLY */
+}
+
+/* ── §7.2 fence ─────────────────────────────────────────────────────── */
+/*
+ * fence immu18 (oiii, op=0x47, ha=0x20; SimRISC-11 §4.1, ADR-0034 D1/D2):
+ *   fm   = immu18[17:12]  (hb) — only 0 is defined (8 = TSO-reserved)
+ *   pred = immu18[11:6]   (hc) — bits [11:10] are SBZ
+ *   succ = immu18[5:0]    (hd) — bits [5:4]   are SBZ
+ * Within each 6-bit field the access classes are R=1<<0, W=1<<1, I=1<<2,
+ * O=1<<3, matching the assembly constants PRED_R=1<<6 … SUCC_O=1<<3.
+ *
+ * fm != 0 (incl. the TSO-reserved 8) or a non-zero SBZ => ILLI.
+ * pred = succ = 0 => no-op: NO barrier is emitted at all.
+ * Otherwise the (pred, succ) class pair is mapped onto the TCG ordering
+ * matrix (TCG_MO_{LD,ST}_{LD,ST}, "A before B in program order") and emitted
+ * as TCG_BAR_SC so the ordering is host-thread visible (qemu-user: one guest
+ * hart = one host thread).  I/O classes (I/O) have no device model here, so
+ * each of them contributes BOTH memory classes on its side: the resulting
+ * barrier is at least as strong as the architecture requires, never weaker
+ * (ADR-0034 D6; declared in the task's completion area).
+ */
+#define FENCE_SBZ_MASK  0x30        /* field bits [5:4] */
+#define FENCE_R         0x01
+#define FENCE_W         0x02
+#define FENCE_I         0x04
+#define FENCE_O         0x08
+
+static bool trans_fence_oiii_imm(DisasContext *ctx, arg_misc *a)
+{
+    int pred = a->hc;
+    int succ = a->hd;
+    bool pred_ld, pred_st, succ_ld, succ_st;
+    int bar = 0;
+
+    if (a->hb != 0 ||
+        (pred & FENCE_SBZ_MASK) || (succ & FENCE_SBZ_MASK)) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    if (pred == 0 && succ == 0) {
+        return true;            /* no-op: no ordering effect whatsoever */
+    }
+
+    pred_ld = (pred & (FENCE_R | FENCE_I | FENCE_O)) != 0;
+    pred_st = (pred & (FENCE_W | FENCE_I | FENCE_O)) != 0;
+    succ_ld = (succ & (FENCE_R | FENCE_I | FENCE_O)) != 0;
+    succ_st = (succ & (FENCE_W | FENCE_I | FENCE_O)) != 0;
+
+    if (pred_ld && succ_ld) {
+        bar |= TCG_MO_LD_LD;
+    }
+    if (pred_ld && succ_st) {
+        bar |= TCG_MO_LD_ST;
+    }
+    if (pred_st && succ_ld) {
+        bar |= TCG_MO_ST_LD;
+    }
+    if (pred_st && succ_st) {
+        bar |= TCG_MO_ST_ST;
+    }
+    tcg_gen_mb(bar | TCG_BAR_SC);
+    return true;
+}
