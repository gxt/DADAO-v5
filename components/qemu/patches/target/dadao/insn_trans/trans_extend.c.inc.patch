+
+/* §3.4.2 ext.uo/ext.so (orrr, MISC-octa): zero/sign extend
+ * pos = VALUE of rdhd register (masked to 6 bits), not register number
+ * rdhb[63:0] = zero/sign_extend(rdhc[pos:0])  (all 64 bits for octa) */
+static bool trans_ext_uo_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rdhd = load_rd(a->hd);
+    /* ILLI check BEFORE mask: hd > N (N=63 for octa) */
+    gen_runtime_illi_check(ctx, rdhd, 63);
+    TCGv_i64 pos = tcg_temp_new_i64();
+    tcg_gen_andi_i64(pos, rdhd, 0x3F); /* mask to 6 bits */
+    TCGv_i64 rdhc = load_rd(a->hc);
+    /* Zero extend: (rdhc << (63-pos)) >> (63-pos) logical */
+    TCGv_i64 shift = tcg_temp_new_i64();
+    TCGv_i64 c63 = tcg_constant_i64(63);
+    tcg_gen_sub_i64(shift, c63, pos);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_shl_i64(result, rdhc, shift);
+    tcg_gen_shr_i64(result, result, shift); /* zero-extended */
+    store_rd(a->hb, result);
+    return true;
+}
+
+static bool trans_ext_so_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rdhd = load_rd(a->hd);
+    /* ILLI check BEFORE mask: hd > N (N=63 for octa) */
+    gen_runtime_illi_check(ctx, rdhd, 63);
+    TCGv_i64 pos = tcg_temp_new_i64();
+    tcg_gen_andi_i64(pos, rdhd, 0x3F); /* mask to 6 bits */
+    TCGv_i64 rdhc = load_rd(a->hc);
+    /* Sign extend: (rdhc << (63-pos)) >> (63-pos) arithmetic */
+    TCGv_i64 shift = tcg_temp_new_i64();
+    TCGv_i64 c63 = tcg_constant_i64(63);
+    tcg_gen_sub_i64(shift, c63, pos);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_shl_i64(result, rdhc, shift);
+    tcg_gen_sar_i64(result, result, shift); /* sign-extended */
+    store_rd(a->hb, result);
+    return true;
+}
+
+/* §3.4.2 ext.uo/ext.so (orri, MISC-octa): immediate extend
+ * hd = immu6 (ext bit position), ILLI if immu6 > 63
+ * rdhb[63:0] = zero/sign_extend(rdhc[pos:0])  (all 64 bits for octa) */
+static bool trans_ext_uo_orri_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd > 63) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    int pos = a->hd;
+    int shift = 63 - pos;
+    if (shift == 0) {
+        store_rd(a->hb, rdhc);
+    } else {
+        TCGv_i64 ext = tcg_temp_new_i64();
+        tcg_gen_shli_i64(ext, rdhc, shift);
+        tcg_gen_shri_i64(ext, ext, shift); /* zero-extended */
+        store_rd(a->hb, ext);
+    }
+    return true;
+}
+
+static bool trans_ext_so_orri_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd > 63) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    int pos = a->hd;
+    int shift = 63 - pos;
+    if (shift == 0) {
+        store_rd(a->hb, rdhc);
+    } else {
+        TCGv_i64 ext = tcg_temp_new_i64();
+        tcg_gen_shli_i64(ext, rdhc, shift);
+        tcg_gen_sari_i64(ext, ext, shift); /* sign-extended */
+        store_rd(a->hb, ext);
+    }
+    return true;
+}
