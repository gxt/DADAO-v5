+/* §3.7 rd2rd (orri): block copy rd[rdhc..rdhc+immu6) → rd[rdhb..rdhb+immu6)
+ * ILLI: immu6==0, rdhb==0, rdhb+immu6>64, rdhc+immu6>64
+ * Overlap handled by ascending order read-before-write. */
+static bool trans_rd2rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hd == 0 || a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    if (a->hb + a->hd > 64 || a->hc + a->hd > 64) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    /* Ascending order: read each source, then write to dest */
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 tmp = load_rd(a->hc + i);
+        store_rd(a->hb + i, tmp);
+    }
+    return true;
+}
+
