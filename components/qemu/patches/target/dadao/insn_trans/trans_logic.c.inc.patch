+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_eqv_i64(result, rdhc, rdhd);
+    TCGv_i64 mask = tcg_constant_i64(0xFFFFFFFF00000000ULL);
+    tcg_gen_and_i64(rdhb, rdhb, mask);
+    TCGv_i64 low_mask = tcg_constant_i64(0xFFFFFFFFULL);
+    tcg_gen_and_i64(result, result, low_mask);
