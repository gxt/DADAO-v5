+/* §3.3 Logic (orrr, MISC-wyde): and/or/xor/xnor .w (N=15)
+ * ILLI: rdhb == 0 */
+static bool trans_and_w(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_and_i64(result, rdhc, rdhd);
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_andi_i64(hi, rdhb, ~0xFFFFULL);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    tcg_gen_andi_i64(lo, result, 0xFFFFULL);
+    tcg_gen_or_i64(rdhb, hi, lo);
+    store_rd(a->hb, rdhb);
+    return true;
+}
