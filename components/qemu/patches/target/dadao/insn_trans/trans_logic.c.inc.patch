+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* §3.3 Logic (orrr, MISC-octa): and/or/xor/xnor .o
+ * size=63 (octa, all 64 bits), high bits don't apply
+ * ILLI: rdhb == 0 */
+static bool trans_and_o_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    tcg_gen_and_i64(rdhb, rdhc, rdhd);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_or_o_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    tcg_gen_or_i64(rdhb, rdhc, rdhd);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_xor_o_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    tcg_gen_xor_i64(rdhb, rdhc, rdhd);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_xnor_o_orrr_rd(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    tcg_gen_eqv_i64(rdhb, rdhc, rdhd);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+/* SPEC-069t: narrow logic (and/or/xor/xnor .t/.w/.b) deleted; only .o remains */
