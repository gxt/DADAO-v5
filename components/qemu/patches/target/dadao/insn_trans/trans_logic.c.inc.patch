+/* §3.3 Logic (orrr, MISC-tetra): and/or/xor/xnor .t
+ * size=31 (tetra, 32 bits), bits[63:32] stay unchanged
+ * ILLI: rdhb == 0 */
+static bool trans_and_t(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_and_i64(result, rdhc, rdhd);
+    /* Keep rdhb[63:32], insert result[31:0] */
+    TCGv_i64 mask = tcg_constant_i64(0xFFFFFFFF00000000ULL);
+    tcg_gen_and_i64(rdhb, rdhb, mask);
+    TCGv_i64 low_mask = tcg_constant_i64(0xFFFFFFFFULL);
+    tcg_gen_and_i64(result, result, low_mask);
+    tcg_gen_or_i64(rdhb, rdhb, result);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_or_t(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_or_i64(result, rdhc, rdhd);
+    TCGv_i64 mask = tcg_constant_i64(0xFFFFFFFF00000000ULL);
+    tcg_gen_and_i64(rdhb, rdhb, mask);
+    TCGv_i64 low_mask = tcg_constant_i64(0xFFFFFFFFULL);
+    tcg_gen_and_i64(result, result, low_mask);
+    tcg_gen_or_i64(rdhb, rdhb, result);
+    store_rd(a->hb, rdhb);
+    return true;
+}
+
+static bool trans_xor_t(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhc = load_rd(a->hc);
+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 result = tcg_temp_new_i64();
+    tcg_gen_xor_i64(result, rdhc, rdhd);
+    TCGv_i64 mask = tcg_constant_i64(0xFFFFFFFF00000000ULL);
+    tcg_gen_and_i64(rdhb, rdhb, mask);
+    TCGv_i64 low_mask = tcg_constant_i64(0xFFFFFFFFULL);
+    tcg_gen_and_i64(result, result, low_mask);
+    tcg_gen_or_i64(rdhb, rdhb, result);
+    store_rd(a->hb, rdhb);
+    return true;
+}
