+/* §3.1.3 add.si (riii): rdha += sign_extend(imms18) */
+static bool trans_add_si_rd(DisasContext *ctx, arg_main *a)
+{
+    if (a->ha == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    /* Reconstruct 18-bit signed immediate from hb/hc/hd */
+    int32_t imm18 = (int32_t)((a->hb << 12) | (a->hc << 6) | a->hd);
+    /* Sign-extend from 18 bits */
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    TCGv_i64 rdha = load_rd(a->ha);
+    tcg_gen_addi_i64(rdha, rdha, (int64_t)imm18);
+    store_rd(a->ha, rdha);
+    return true;
+}
