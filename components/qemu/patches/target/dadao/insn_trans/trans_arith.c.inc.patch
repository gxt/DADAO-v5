+/* §4.5.2 add.si rbha, imms18 (riii): rbha = rbha + sign_extend(imms18)
+ * Full 64-bit arithmetic. ILLI: rbha == rb0 */
+static bool trans_add_si_rb(DisasContext *ctx, arg_main *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int32_t imm18 = (int32_t)((a->hb << 12) | (a->hc << 6) | a->hd);
+    if (imm18 & (1 << 17)) {
+        imm18 |= ~((1 << 18) - 1);
+    }
+    TCGv_i64 rbha = load_rb(ctx, a->ha);
+    tcg_gen_addi_i64(rbha, rbha, (int64_t)imm18);
+    store_rb(a->ha, rbha);
+    return true;
+}
