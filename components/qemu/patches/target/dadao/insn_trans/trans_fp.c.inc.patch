+/* compare */
+/* Unordered result constants (sign bit 0):
+ *   quiet compare     → qNaN  0x7FC00000 (ft) / 0x7FF8000000000000 (fo)
+ *   signaling compare → sNaN  0x7F800001 (ft) / 0x7FF0000000000001 (fo)
+ * The qNaN values match the FCSR qNaN(ft/fo) fields (SimRISC-00). */
+#define FP_FT_QNAN  0x000000007FC00000ULL
+#define FP_FT_SNAN  0x000000007F800001ULL
+#define FP_FO_QNAN  0x7FF8000000000000ULL
+#define FP_FO_SNAN  0x7FF0000000000001ULL
+
+static bool trans_ftqcmp_orrr_rf(DisasContext *ctx, arg_misc *a)
+{
+    if (!fp_check_dst_rd0(ctx, a->hb)) {   /* dest rdHB (SPEC-089t) */
+        return true;
+    }
+    gen_fp_cmp(a, false, FP_FT_QNAN);
+    return true;
+}
+
+static bool trans_ftscmp_orrr_rf(DisasContext *ctx, arg_misc *a)
+{
+    if (!fp_check_dst_rd0(ctx, a->hb)) {   /* dest rdHB (SPEC-089t) */
+        return true;
+    }
+    gen_fp_cmp(a, false, FP_FT_SNAN);
+    return true;
+}
+
+static bool trans_foqcmp_orrr_rf(DisasContext *ctx, arg_misc *a)
+{
+    if (!fp_check_dst_rd0(ctx, a->hb)) {   /* dest rdHB (SPEC-089t) */
+        return true;
+    }
+    gen_fp_cmp(a, true, FP_FO_QNAN);
+    return true;
+}
+
+static bool trans_foscmp_orrr_rf(DisasContext *ctx, arg_misc *a)
+{
