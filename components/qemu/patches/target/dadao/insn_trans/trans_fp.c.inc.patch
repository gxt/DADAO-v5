+        return true;
+    }
+    TCGv_i64 rdha = load_rd(a->ha);
+    TCGv_i64 rdhb = load_rd(a->hb);
+    TCGv_i64 rfhc = load_rf(a->hc);
+    TCGv_i64 rfhd = load_rf(a->hd);
+    TCGv_i64 res = tcg_temp_new_i64();
+    tcg_gen_movcond_i64(TCG_COND_EQ, res, rdha, rdhb, rfhd, rfhc);
+    store_rf(a->hc, res);
