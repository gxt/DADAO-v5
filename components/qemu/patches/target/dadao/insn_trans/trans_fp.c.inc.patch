+/* ── QEMU-036t: conversion family (softfloat) ────────────────────────── */
+/*
+ * All convert_* forms are `orri`: a destination start register in a->hb, a
+ * source start register in a->hc and a 1..63 element count in a->hd.  The
+ * per-element conversions themselves live in helper.c (softfloat); the
+ * helpers receive the FCSR-derived rounding mode and merge their flags back
+ * into rf0[4:0].  convert_ff additionally applies the shared
+ * mreg_range_overlap rule (source and destination ranges must be disjoint,
+ * complete coincidence included).
+ */
+
+/* convert_ff kind selectors (helper_fp_cvt_ff). */
+enum {
+    FP_FF_FT2FO = 0,
+    FP_FF_FO2FT = 1,
+};
+
+/* convert_f2i kind selectors (helper_fp_cvt_f2i). */
+enum {
+    FP_F2I_FT2IT = 0, FP_F2I_FT2IO, FP_F2I_FT2UT, FP_F2I_FT2UO,
+    FP_F2I_FO2IT,    FP_F2I_FO2IO, FP_F2I_FO2UT, FP_F2I_FO2UO,
+};
+
+/* convert_i2f kind selectors (helper_fp_cvt_i2f). */
+enum {
+    FP_I2F_IT2FT = 0, FP_I2F_IO2FT, FP_I2F_UT2FT, FP_I2F_UO2FT,
+    FP_I2F_IT2FO,    FP_I2F_IO2FO, FP_I2F_UT2FO, FP_I2F_UO2FO,
+};
+
+/* convert_ff: destination rf (a->hb), source rf (a->hc). `move` selects the
+ * same-format register move (ft2ft/fo2fo), which is a plain 64-bit move. */
+static bool gen_convert_ff(DisasContext *ctx, arg_misc *a,
+                           uint32_t kind, bool move)
+{
+    if (!fp_check_dst_rf0(ctx, a->hb)) {
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hb, a->hd)) {   /* dest rfHB */
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hc, a->hd)) {   /* src  rfHC */
+        return true;
+    }
+    if (!fp_check_mreg_overlap(ctx, a->hb, a->hc, a->hd)) {
+        return true;
+    }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 src = load_rf(a->hc + i);
+        TCGv_i64 res = tcg_temp_new_i64();
+        if (move) {
+            tcg_gen_mov_i64(res, src);
+        } else {
+            gen_helper_fp_cvt_ff(res, tcg_env, src,
+                                 tcg_constant_i32(kind));
+        }
+        store_rf(a->hb + i, res);
+    }
+    return true;
+}
+
+/* convert_f2i: destination rd (a->hb), source rf (a->hc). */
+static bool gen_convert_f2i(DisasContext *ctx, arg_misc *a, uint32_t kind)
+{
+    if (!fp_check_dst_rd0(ctx, a->hb)) {   /* dest rdHB (SPEC-089t) */
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hb, a->hd)) {   /* dest rdHB */
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hc, a->hd)) {   /* src  rfHC */
+        return true;
+    }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 src = load_rf(a->hc + i);
+        TCGv_i64 res = tcg_temp_new_i64();
+        gen_helper_fp_cvt_f2i(res, tcg_env, src, tcg_constant_i32(kind));
+        store_rd(a->hb + i, res);
+    }
+    return true;
+}
+
+/* convert_i2f: destination rf (a->hb), source rd (a->hc). */
+static bool gen_convert_i2f(DisasContext *ctx, arg_misc *a, uint32_t kind)
+{
+    if (!fp_check_dst_rf0(ctx, a->hb)) {
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hb, a->hd)) {   /* dest rfHB */
+        return true;
+    }
+    if (!fp_check_mreg(ctx, a->hc, a->hd)) {   /* src  rdHC */
+        return true;
+    }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 src = load_rd(a->hc + i);
+        TCGv_i64 res = tcg_temp_new_i64();
+        gen_helper_fp_cvt_i2f(res, tcg_env, src, tcg_constant_i32(kind));
+        store_rf(a->hb + i, res);
+    }
+    return true;
+}
+
+static bool trans_ft2ft_orri_rf(DisasContext *ctx, arg_misc *a)
+{
+    return gen_convert_ff(ctx, a, 0, true);
+}
