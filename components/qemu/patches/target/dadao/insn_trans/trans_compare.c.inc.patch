+    TCGv_i64 rdhd = load_rd(a->hd);
+    TCGv_i64 result = tcg_temp_new_i64();
+    /* Truncate to 32 bits for comparison */
+    TCGv_i64 src_a = tcg_temp_new_i64();
+    TCGv_i64 src_b = tcg_temp_new_i64();
+    tcg_gen_andi_i64(src_a, rdhc, 0xFFFFFFFFULL);
+    tcg_gen_andi_i64(src_b, rdhd, 0xFFFFFFFFULL);
+    gen_cmp_three_way(result, src_a, src_b, false);
+    store_rd(a->hb, result);
+    return true;
+}
