+/* §4.6 cmp.uo rdhb, rbhc, rbhd (orrr): unsigned 64-bit RB compare
+ * result = -1/0/1 for less/equal/greater, written to rdhb (full 64-bit)
+ * bits[63:48] don't affect comparison. ILLI: rdhb == 0 */
+static bool trans_cmp_uo_rb(DisasContext *ctx, arg_misc *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 rbhc = load_rb(ctx, a->hc);
+    TCGv_i64 rbhd = load_rb(ctx, a->hd);
+    TCGv_i64 result = tcg_temp_new_i64();
+    gen_cmp_three_way(result, rbhc, rbhd, false);
+    store_rd(a->hb, result);
+    return true;
+}
