+/* §3.2.1 cmp.ui/cmp.si (rrii): immediate compare */
+static bool trans_cmp_ui_rrii_rd(DisasContext *ctx, arg_main *a)
+{
+    if (a->ha == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhb = load_rd(a->hb);
+    /* Reconstruct 12-bit unsigned immediate from hc/hd */
+    uint64_t immu12 = ((uint64_t)a->hc << 6) | a->hd;
+    TCGv_i64 imm = tcg_constant_i64(immu12);
+    TCGv_i64 result = tcg_temp_new_i64();
+    gen_cmp_three_way(result, rdhb, imm, false);
+    store_rd(a->ha, result);
+    return true;
+}
+
+static bool trans_cmp_si_rrii_rd(DisasContext *ctx, arg_main *a)
+{
+    if (a->ha == 0) {
+        gen_exception_illegal(ctx);
+        return true;
+    }
+    TCGv_i64 rdhb = load_rd(a->hb);
+    /* Reconstruct 12-bit signed immediate from hc/hd */
+    int32_t imm12 = (int32_t)((a->hc << 6) | a->hd);
+    if (imm12 & (1 << 11)) {
+        imm12 |= ~((1 << 12) - 1);
+    }
+    TCGv_i64 imm = tcg_constant_i64((int64_t)imm12);
+    TCGv_i64 result = tcg_temp_new_i64();
+    gen_cmp_three_way(result, rdhb, imm, true);
+    store_rd(a->ha, result);
+    return true;
+}
