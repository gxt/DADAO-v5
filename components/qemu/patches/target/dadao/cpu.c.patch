+static void dadao_cpu_set_pc(CPUState *cs, vaddr value)
+{
+    DadaoCPU *cpu = DADAO_CPU(cs);
+
+    cpu->env.pc = value;
+    cpu->env.rb[0] = value;
+}
+
+static vaddr dadao_cpu_get_pc(CPUState *cs)
+{
+    DadaoCPU *cpu = DADAO_CPU(cs);
+
+    return cpu->env.pc;
+}
+
+static bool dadao_cpu_has_work(CPUState *cs)
+{
+    /* M1 always has work (no interrupt model, no WFI) */
+    return true;
+}
+
+static int dadao_cpu_mmu_index(CPUState *cs, bool ifetch)
+{
+    /* M1: no MMU, single index */
+    return 0;
+}
+
+static TCGTBCPUState dadao_get_tb_cpu_state(CPUState *cs)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    return (TCGTBCPUState){ .pc = env->pc, .flags = 0 };
+}
+
+static void dadao_cpu_synchronize_from_tb(CPUState *cs,
+                                          const TranslationBlock *tb)
+{
+    tcg_debug_assert(!tcg_cflags_has(cs, CF_PCREL));
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->pc = tb->pc;
+    env->rb[0] = tb->pc;
+}
+
+static void dadao_restore_state_to_opc(CPUState *cs,
+                                       const TranslationBlock *tb,
+                                       const uint64_t *data)
+{
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->pc = data[0];
+    env->rb[0] = data[0];
+}
+
+static void dadao_cpu_reset_hold(Object *obj, ResetType type)
+{
+    CPUState *cs = CPU(obj);
+    DadaoCPU *cpu = DADAO_CPU(cs);
+    DadaoCPUClass *mcc = DADAO_CPU_GET_CLASS(obj);
+    CPUDADAOState *env = &cpu->env;
+
+    if (mcc->parent_phases.hold) {
+        mcc->parent_phases.hold(obj, type);
+    }
+
+    /* Reset all registers to zero */
+    memset(env->rd, 0, sizeof(env->rd));
+    memset(env->rb, 0, sizeof(env->rb));
+    memset(env->rf, 0, sizeof(env->rf));
+    memset(env->ra, 0, sizeof(env->ra));
+
+    /* rd0 hardwired to 0 (already zero from memset) */
+
+    /* rb0 = reset vector = cfx_power_hypv_excp_vector = boot ROM base */
+    env->rb[0] = DADAO_RESET_PC;
+    env->pc = DADAO_RESET_PC;
+
+    /* rf0 = FCSR reset value (per ADR-0004 D2, derived from SimRISC-00 §浮点状态寄存器)
+     * Bits [63:51] = fo format Quiet NaN = 0xFFF (read-only)
+     * Bits [50:32] = SBZ = 0
+     * Bits [31:22] = ft format Quiet NaN = 0x1FF (read-only)
+     * Bits [21:18] = SBZ = 0
+     * Bits [17:16] = rounding mode = 0 (RNE, reset default)
+     * Bits [15:5]  = SBZ = 0
+     * Bits [4:0]   = exception status = 0 (reset)
+     *
+     * rf0 = (0xFFF << 51) | (0x1FF << 22) = 0x7FF8_0000_7FC0_0000
+     */
+    env->rf[0] = DADAO_RESET_RF0;
+
+    /* ra0-ra63 all zero (RegRAS empty at reset) */
+}
+
+static void dadao_cpu_realizefn(DeviceState *dev, Error **errp)
+{
+    CPUState *cs = CPU(dev);
+    DadaoCPUClass *mcc = DADAO_CPU_GET_CLASS(dev);
+    Error *local_err = NULL;
+
+    cpu_exec_realizefn(cs, &local_err);
+    if (local_err != NULL) {
+        error_propagate(errp, local_err);
+        return;
+    }
+    qemu_init_vcpu(cs);
+    cpu_reset(cs);
+
+    mcc->parent_realize(dev, errp);
+}
+
+static void dadao_cpu_initfn(Object *obj)
+{
+    /* No special initialization needed for skeleton */
+}
+
+static ObjectClass *dadao_cpu_class_by_name(const char *cpu_model)
+{
+    return object_class_by_name(cpu_model);
+}
+
+static void dadao_cpu_dump_state(CPUState *cs, FILE *f, int flags)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int i;
+
+    qemu_fprintf(f, "\n");
+    qemu_fprintf(f, "PC: %016" PRIx64 "\n", env->pc);
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RD[%02d]: %016" PRIx64 "  ", i, env->rd[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RB[%02d]: %016" PRIx64 "  ", i, env->rb[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RF[%02d]: %016" PRIx64 "  ", i, env->rf[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RA[%02d]: %016" PRIx64 "  ", i, env->ra[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+}
+
+#include "hw/core/sysemu-cpu-ops.h"
+
+static const struct SysemuCPUOps dadao_sysemu_ops = {
+    .has_work = dadao_cpu_has_work,
+};
+
+static void dadao_cpu_do_unaligned_access(CPUState *cs, vaddr addr,
+                                          MMUAccessType access_type,
+                                          int mmu_idx, uintptr_t retaddr)
+{
+    /* MALIGN precise exception: faulting PC preserved, no register/memory commit.
+     * Per ADR-0004 D4: exit code 0x8C. */
+    cs->exception_index = DADAO_EXCP_MALIGN;
+    cpu_loop_exit_restore(cs, retaddr);
+}
+
+static bool dadao_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
+{
+    /* M1: no interrupts */
+    return false;
+}
+
+static const TCGCPUOps dadao_tcg_ops = {
+    .guest_default_memory_order = 0,
+    .mttcg_supported = false,
+    .initialize = dadao_cpu_tcg_init,
+    .translate_code = dadao_cpu_translate_code,
+    .get_tb_cpu_state = dadao_get_tb_cpu_state,
+    .synchronize_from_tb = dadao_cpu_synchronize_from_tb,
+    .restore_state_to_opc = dadao_restore_state_to_opc,
+    .mmu_index = dadao_cpu_mmu_index,
+    .cpu_exec_interrupt = dadao_cpu_exec_interrupt,
+    .cpu_exec_halt = dadao_cpu_has_work,
+    .cpu_exec_reset = cpu_reset,
+    .tlb_fill = dadao_cpu_tlb_fill,
+    .do_interrupt = dadao_cpu_do_interrupt,
+    .do_unaligned_access = dadao_cpu_do_unaligned_access,
+    .pointer_wrap = cpu_pointer_wrap_notreached,
+};
+
+static void dadao_cpu_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    CPUClass *cc = CPU_CLASS(oc);
+    DadaoCPUClass *mcc = DADAO_CPU_CLASS(oc);
+    ResettableClass *rc = RESETTABLE_CLASS(oc);
+
+    device_class_set_parent_realize(dc, dadao_cpu_realizefn,
+                                    &mcc->parent_realize);
+
+    resettable_class_set_parent_phases(rc, NULL, dadao_cpu_reset_hold, NULL,
+                                       &mcc->parent_phases);
+
+    cc->class_by_name = dadao_cpu_class_by_name;
+    cc->dump_state = dadao_cpu_dump_state;
+    cc->set_pc = dadao_cpu_set_pc;
+    cc->get_pc = dadao_cpu_get_pc;
+    cc->sysemu_ops = &dadao_sysemu_ops;
+    cc->tcg_ops = &dadao_tcg_ops;
+}
+
+static const TypeInfo dadao_cpu_type_info[] = {
+    {
+        .name = TYPE_DADAO_CPU,
+        .parent = TYPE_CPU,
+        .instance_size = sizeof(DadaoCPU),
+        .instance_align = __alignof(DadaoCPU),
+        .instance_init = dadao_cpu_initfn,
+        .class_size = sizeof(DadaoCPUClass),
+        .class_init = dadao_cpu_class_init,
+        .abstract = true,
+    },
+    {
+        .name = DADAO_CPU_TYPE_NAME("any"),
+        .parent = TYPE_DADAO_CPU,
+    },
+};
+
+DEFINE_TYPES(dadao_cpu_type_info)
