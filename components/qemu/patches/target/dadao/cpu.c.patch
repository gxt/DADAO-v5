+static void dadao_cpu_reset_hold(Object *obj, ResetType type)
+{
+    CPUState *cs = CPU(obj);
+    DadaoCPU *cpu = DADAO_CPU(cs);
+    DadaoCPUClass *mcc = DADAO_CPU_GET_CLASS(obj);
+    CPUDADAOState *env = &cpu->env;
+
+    if (mcc->parent_phases.hold) {
+        mcc->parent_phases.hold(obj, type);
+    }
+
+    /* Reset all registers to zero */
+    memset(env->rd, 0, sizeof(env->rd));
+    memset(env->rb, 0, sizeof(env->rb));
+    memset(env->rf, 0, sizeof(env->rf));
+    memset(env->ra, 0, sizeof(env->ra));
+    env->ras_base = 0;
+
+    /* No reservation is held at reset (QEMU-067t). */
+    env->lock_addr = 0;
+    env->lock_val = 0;
+    env->lock_valid = 0;
+
+    /* Address-space Step 1 reset values (ADR-0039 §8.5 / DADAO-12 §2.2):
+     * PTBR = 0, ptw_enable = 0.  Step 3 (ADR-0041): ASID = 0, TLB empty,
+     * invalidation window start/size = 0. */
+    env->ptbr = 0;
+    env->ptw_enable = 0;
+    env->ptw_fault_cause = 0;
+    env->ptw_fault_info = 0;
+    env->sync_fault_info = 0;
+    env->tlb_asid = 0;
+    env->tlb_start = 0;
+    env->tlb_size = 0;
+    env->tlb_control = 0;
+    env->tlb_next = 0;
+    memset(env->tlb, 0, sizeof(env->tlb));
+
+    /* cfx_pmem SRAM/DMA reset values (DADAO-12 §4.9; ADR-0042): all zero,
+     * no transfer in flight.  The PMEM_DMA pending bit lives in the target
+     * cfx (cfx_pmem cg5 rc5) and is cleared by the per-cfx reset loop above. */
+#ifndef CONFIG_USER_ONLY
+    dadao_pmem_dma_reset(env);
+    /* cfx_time epoch + single-hart timer (DADAO-12 §4.7/§4.10). */
+    dadao_hart_timer_reset(env);
+#else
+    env->pmem_dma_src = 0;
+    env->pmem_dma_dst = 0;
+    env->pmem_dma_size = 0;
+    env->pmem_dma_ctrl = 0;
+    env->pmem_dma_status = 0;
+    env->pmem_dma_dir = 0;
+    env->pmem_dma_irq_en = 0;
+    env->pmem_dma_cfx_off = 0;
+    env->pmem_dma_pa = 0;
+    env->pmem_dma_len = 0;
+    env->time_base_ns = 0;
+    env->hart_insn = 0;
+    env->hart_timer_cmp = 0;
+    env->hart_timer_ctrl = 0;
+#endif
+
+    /* rd0 hardwired to 0 (already zero from memset) */
+
+    /* rb0 = reset vector = cfx_power_hypv_excp_vector = boot ROM base
+     * (profile-dependent: both profiles reset to 0xffff_ffff_0000, but the
+     * value now comes from the selected machine profile, QEMU-079t). */
+    {
+        const DadaoProfile *prof = DADAO_PROFILE(env);
+
+        env->rb[0] = prof->reset_pc;
+        env->pc = prof->reset_pc;
+        /* Tiny has no cfx4: ptw_enable is not writable and must stay 0 even
+         * if a (unreachable) register path ever wrote it. */
+        if (!prof->ptw_supported) {
+            env->ptw_enable = 0;
+        }
+    }
+
+    /* rf0 = FCSR reset value (per ADR-0004 D2, derived from SimRISC-00 §浮点状态寄存器)
+     * Bits [63:51] = fo format Quiet NaN = 0xFFF (read-only)
+     * Bits [50:34] = SBZ = 0
+     * Bits [33:32] = rounding mode = 0 (RNE, reset default)
+     * Bits [31:22] = ft format Quiet NaN = 0x1FF (read-only)
+     * Bits [21:5]  = SBZ = 0
+     * Bits [4:0]   = exception status = 0 (reset)
+     *
+     * rf0 = (0xFFF << 51) | (0x1FF << 22) = 0x7FF8_0000_7FC0_0000
+     */
+    env->rf[0] = DADAO_RESET_RF0;
+
+    /* ra0-ra63 all zero (RegRAS empty at reset) */
+
+    /* ── SEE/HEE reset state (QEMU-044t) ──
+     * Reset boots in hypv at cfx_power (DADAO-12 §2.1: reset vector is
+     * cfx_power_hypv_excp_vector).  There is no independent cfx-mask layer
+     * (DADAO-12 §5.2).  Register reset values follow
+     * DADAO-12 §3 (cg0-cg3) and DADAO-13 §1 (cg3/hypv). */
+    env->inner_run_mode = DADAO_MODE_HYPV;
+    env->inner_cfx_code = 63;
+
+    /* ADR-0045 D4: every cfx's four sync source masks default to
+     * 0xFFFF_FFFF_FFFF_FFF7 (only hmon / cfx3 may access); hmon itself uses
+     * 0x7FFF_FFFF_FFFF_FFF7 (hmon + power).  cfx_intr_mask (rc4) is all-1. */
+#define DADAO_CFX_MASK_DEFAULT  0xFFFFFFFFFFFFFFF7ULL
+#define DADAO_CFX_MASK_HMON     0x7FFFFFFFFFFFFFF7ULL
+
+    for (int i = 0; i < DADAO_NUM_CFX; i++) {
+        DADAOCfxRegs *r = &env->cfx[i];
+        uint64_t cfxha = (uint64_t)dadao_cfxha_map[i];
+        uint64_t mask_init = (cfxha == 3) ? DADAO_CFX_MASK_HMON
+                                          : DADAO_CFX_MASK_DEFAULT;
+
+        memset(r, 0, sizeof(*r));
+        for (int m = 0; m < 4; m++) {
+            DADAOCfxModeRegs *mr = &r->mode[m];
+
+            mr->cfxtrap = mask_init;          /* rc0 */
+            mr->cfxmem = mask_init;           /* rc1 */
+            mr->cfxreg = mask_init;           /* rc2 */
+            mr->cfxexe = mask_init;           /* rc3 */
+            mr->cfx_intr_mask = ~0ULL;        /* rc4 */
+            if (m == DADAO_MODE_HYPV) {
+                /* DADAO-13 §1 (cg3): switch_run_mode=3,
+                 * excp_vector = cfxha<<42 | 0x3ff_ffff_0000. */
+                mr->switch_run_mode = DADAO_MODE_HYPV;
+                mr->excp_vector = (cfxha << 42) + 0x3FFFFFF0000ULL;
+                mr->cg_reg_deleg = ~0ULL;
+            } else {
+                /* DADAO-12 §3 (cg0-cg2): switch_run_mode=2 (supv),
+                 * excp_vector 0. */
+                mr->switch_run_mode = DADAO_MODE_SUPV;
+                mr->excp_vector = 0;
+                mr->cg_reg_deleg = 0;
+            }
+        }
+        /* cg8 rc1 global_cfx_intr_mask: cfx0-3 only, all-1 at reset (D3). */
+        r->global_cfx_intr_mask = (cfxha < 4) ? ~0ULL : 0;
+        r->saved_global_intr_mask = 0;
+        r->saved_intr_monitor = 0;
+        r->cfx_id = cfxha;                    /* cg4 rc0 (HW) */
+        r->version = 0x00010000ULL;           /* cg4 rc1 (HW; test-machine value) */
+        r->trap_num = 0;                      /* cg4 rc2 */
+        r->excp_sync_num = 0;                 /* cg4 rc3 */
+        r->excp_async_num = 0;                /* cg4 rc4 */
+        r->escape_num = 0;                    /* cg4 rc5 */
+        r->scratch_regs_num = 4;              /* cg4 rc6 (HW; >=2,<=64) */
+        r->prev_run_mode = 0;                 /* cg5 rc0 */
+        r->cause_id = 0;                      /* cg5 rc2 */
+        r->cause_ip = 0;                      /* cg5 rc3 */
+        r->cause_info = 0;                    /* cg5 rc4 */
+        r->pending = 0;                       /* cg5 rc5 */
+        /* cg6 scratch[]/cg7 left 0 (scratch undefined at reset) */
+    }
+}
+
+static void dadao_cpu_realizefn(DeviceState *dev, Error **errp)
+{
+    CPUState *cs = CPU(dev);
+    DadaoCPUClass *mcc = DADAO_CPU_GET_CLASS(dev);
+    Error *local_err = NULL;
+
+    cpu_exec_realizefn(cs, &local_err);
+    if (local_err != NULL) {
+        error_propagate(errp, local_err);
+        return;
+    }
+#ifndef CONFIG_USER_ONLY
+    /* cfx_pmem DMA completion timer (DADAO-12 §4.9; ADR-0042). */
+    dadao_pmem_dma_init(cs);
+    /* cfx_time epoch + single-hart cfx_hart timer (DADAO-12 §4.7/§4.10). */
+    dadao_hart_timer_init(cs);
+#endif
+    qemu_init_vcpu(cs);
+    cpu_reset(cs);
+
+    mcc->parent_realize(dev, errp);
+}
