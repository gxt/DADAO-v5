+
+#ifndef CONFIG_USER_ONLY
+G_NORETURN static void dadao_cpu_do_unaligned_access(CPUState *cs, vaddr addr,
+                                                      MMUAccessType access_type,
+                                                      int mmu_idx, uintptr_t retaddr)
+{
+    /* MALIGN precise exception: faulting PC preserved, no register/memory commit.
+     * cause_info = the faulting address (DADAO-12 §5.2(二)); the exception
+     * enters the current run-mode monitor (hmon on both test machines). */
+    CPUDADAOState *env = cpu_env(cs);
+
+    env->sync_fault_info = addr;
+    cs->exception_index = DADAO_EXCP_MALIGN;
+    cpu_loop_exit_restore(cs, retaddr);
+}
+
+static bool dadao_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
+{
+    bool delivered;
+
+    if (!(interrupt_request & CPU_INTERRUPT_HARD)) {
+        return false;
+    }
+    /*
+     * One arbitration entry point (INTEG-051t).  The pending record of every
+     * asynchronous source lives in its *target* cfx's cg5 rc5 (TIMER ->
+     * cfx_hart bit10, PMEM_DMA -> cfx_pmem bit8); cfx_hart holds no cross-cfx
+     * pending bitmap.  The arbiter picks the lowest target cfxha that is
+     * deliverable, runs one cfx_enter(async) and consumes that pending bit.
+     * At most one source per call: while the frame is live the entry-mode
+     * monitor's global_cfx_intr_mask blocks the rest, and escape re-kicks.
+     * Clearing HARD unconditionally keeps the model from spinning; the
+     * pending bit is the only re-delivery record.
+     */
+    delivered = dadao_async_arbitrate(cs);
+    cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    return delivered;
+}
