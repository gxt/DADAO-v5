+static ObjectClass *dadao_cpu_class_by_name(const char *cpu_model)
+{
+    if (cpu_model == NULL) {
+        return NULL;
+    }
+
+    /*
+     * Both spellings reach this function: the internal type name
+     * ("any-dadao-cpu", what -cpu receives after parse_cpu_option() on other
+     * targets) and the short model name ("any", what linux-user's
+     * get_elf_cpu_model() returns and what a user types).  Resolve the short
+     * form through the type suffix so `qemu-dadao ./prog` works without a
+     * -cpu argument.
+     */
+    if (g_str_has_suffix(cpu_model, DADAO_CPU_TYPE_SUFFIX)) {
+        return object_class_by_name(cpu_model);
+    }
+
+    {
+        g_autofree char *type_name =
+            g_strdup_printf("%s%s", cpu_model, DADAO_CPU_TYPE_SUFFIX);
+        return object_class_by_name(type_name);
+    }
+}
