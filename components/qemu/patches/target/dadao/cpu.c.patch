+/*
+ * Debug/semihosting virtual-to-physical translation (QEMU-046t).
+ *
+ * The semihosting responder reads and writes guest memory through
+ * cpu_memory_rw_debug(); without a translation hook that helper would call a
+ * NULL get_phys_addr_debug pointer and crash.  DADAO has no MMU, so the
+ * mapping is identity (ADR-0004 D1: VA == PA); only the mapped regions are
+ * exposed, so an access outside them fails cleanly instead of reaching host
+ * memory.
+ */
+static bool dadao_cpu_translate_for_debug(CPUState *cs, vaddr addr,
+                                          TranslateForDebugResult *result)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    const DadaoProfile *prof = DADAO_PROFILE(env);
+
+    if ((addr >= prof->ram_base && addr < prof->ram_base + prof->ram_size) ||
+        (addr >= prof->rom_base && addr < prof->rom_base + prof->rom_size)) {
+        result->physaddr = addr;
+        result->attrs = MEMTXATTRS_UNSPECIFIED;
+        result->attrs.debug = 1;
+        result->lg_page_size = TARGET_PAGE_BITS;
+        return true;
+    }
+    /* hmon / smon SRAM live outside the 56-bit PA space, but semihosting runs
+     * in every boot stage and reads its argument block through this hook.
+     * Tiny implements only hmon (spec/Machine-v5 §1.1). */
+    if (prof->hmon_sram &&
+        addr >= DADAO_HMON_CFX_BASE &&
+        addr < DADAO_HMON_CFX_BASE + DADAO_MON_SRAM_SIZE) {
+        result->physaddr = DADAO_HMON_SRAM_HOST_BASE +
+                           (addr - DADAO_HMON_CFX_BASE);
+        result->attrs = MEMTXATTRS_UNSPECIFIED;
+        result->attrs.debug = 1;
+        result->lg_page_size = TARGET_PAGE_BITS;
+        return true;
+    }
+    if (prof->smon_sram &&
+        addr >= DADAO_SMON_CFX_BASE &&
+        addr < DADAO_SMON_CFX_BASE + DADAO_MON_SRAM_SIZE) {
+        result->physaddr = DADAO_SMON_SRAM_HOST_BASE +
+                           (addr - DADAO_SMON_CFX_BASE);
+        result->attrs = MEMTXATTRS_UNSPECIFIED;
+        result->attrs.debug = 1;
+        result->lg_page_size = TARGET_PAGE_BITS;
+        return true;
+    }
+    return false;
+}
+
+static const struct SysemuCPUOps dadao_sysemu_ops = {
