+/* ===================================================================
+ * Machine profiles (spec/Machine-v5 §1; QEMU-079t/080t)
+ *
+ * `vast` is Machine-v5-Vast: 4 MiB BootROM at 0xffff_ffc0_0000 (reset at its
+ * last 64 KiB start), 2 GiB PA RAM at PA 0 (reached through the PTW identity
+ * map), hmon/smon/pmem SRAM, full cfx register file + PTW, hypv/supv/user.
+ * It backs `-machine dadao-vast`; the canonical DADAO_* macros carry the same
+ * geometry.
+ *
+ * `tiny` is Machine-v5-Tiny: 64 KiB BootROM + 8 MiB SRAM, `cfx_power`
+ * (cfx63) + `cfx3 hmon` only (spec/Machine-v5 §1.1/§3, 0.4.2-rc), hmon SRAM
+ * at 0x0fff_0000_0000, no PTW, no smon, no pmem SRAM, no PA alias; the run
+ * mode is fixed at hypv and semihosting is the only host-I/O path.
+ * It backs `-machine dadao-tiny`.
+ * =================================================================== */
+
+/* Implemented cfx masks (spec/Machine-v5 §3).  Bit N => cfxN exists. */
+#define DADAO_CFX_IMPL_VAST  ((1ULL << 0) | (1ULL << 1) | (1ULL << 2) | \
+                              (1ULL << 3) | (1ULL << 4) | (1ULL << 15) | \
+                              (1ULL << 32) | (1ULL << 34) | (1ULL << 63))
+#define DADAO_CFX_IMPL_TINY  ((1ULL << 3) | (1ULL << 63))
+
+const DadaoProfile dadao_profile_vast = {
+    .name = "vast",
+    .ram_base = DADAO_VAST_RAM_BASE,
+    .ram_size = DADAO_VAST_RAM_SIZE,
+    .rom_base = DADAO_VAST_ROM_BASE,
+    .rom_size = DADAO_VAST_ROM_SIZE,
+    .reset_pc = DADAO_VAST_RESET_PC,
+    .bios_load_base = DADAO_BIOS_LOAD_BASE,
+    .bios_window_size = DADAO_BIOS_WINDOW_SIZE,
+    .kernel_base = DADAO_VAST_KERNEL_BASE,
+    .kernel_entry = DADAO_VAST_KERNEL_ENTRY,
+    .kernel_reserved = DADAO_VAST_KERNEL_RESERVED,
+    .ram_alias = false,         /* Vast RAM already lives at PA 0 */
+    .hmon_sram = true,
+    .smon_sram = true,
+    .pmem_sram = true,
+    .cfx_impl_mask = DADAO_CFX_IMPL_VAST,
+    .unimpl_cfx_trap_illi = false,  /* allocated-but-unimplemented => CFXREG */
+    .mon_elf_segments = false,      /* power loads hmon from the BootROM */
+    .ptw_supported = true,
+    .rom_elf_segments = false,  /* Vast test bodies load into PA RAM only */
+    .unmapped_is_cfxmem = false,
+    .sync_exc_monitor_entry = false,   /* staged direct-fault mapping */
+    .user_mode = true,
+    .semihosting = true,
+};
+
+const DadaoProfile dadao_profile_tiny = {
+    .name = "tiny",
+    .ram_base = DADAO_TINY_RAM_BASE,
+    .ram_size = DADAO_TINY_RAM_SIZE,
+    .rom_base = DADAO_TINY_ROM_BASE,
+    .rom_size = DADAO_TINY_ROM_SIZE,
+    .reset_pc = DADAO_TINY_RESET_PC,
+    .bios_load_base = DADAO_TINY_ROM_BASE,      /* the whole ROM is the window */
+    .bios_window_size = DADAO_TINY_ROM_SIZE,
+    .kernel_base = DADAO_TINY_KERNEL_BASE,
+    .kernel_entry = DADAO_TINY_KERNEL_ENTRY,
+    .kernel_reserved = DADAO_TINY_KERNEL_RESERVED,
+    .ram_alias = false,
+    .hmon_sram = true,          /* cfx3 hmon SRAM (spec/Machine-v5 §1.1) */
+    .smon_sram = false,         /* Tiny implements no smon */
+    .pmem_sram = false,
+    .cfx_impl_mask = DADAO_CFX_IMPL_TINY,
+    .unimpl_cfx_trap_illi = true,   /* spec/Machine-v5 §3 (Tiny) */
+    .mon_elf_segments = true,       /* host loader installs the hmon image */
+    .ptw_supported = false,
+    .rom_elf_segments = true,
+    .unmapped_is_cfxmem = true,
+    .sync_exc_monitor_entry = true,    /* hmon carries every sync exception */
+    .user_mode = false,
+    .semihosting = true,
+};
