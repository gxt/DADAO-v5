+static void dadao_cpu_dump_state(CPUState *cs, FILE *f, int flags)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int i;
+
+    qemu_fprintf(f, "\n");
+    qemu_fprintf(f, "PC: %016" PRIx64 "\n", env->pc);
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RD[%02d]: %016" PRIx64 "  ", i, env->rd[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RB[%02d]: %016" PRIx64 "  ", i, env->rb[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RF[%02d]: %016" PRIx64 "  ", i, env->rf[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        /* Ring-buffer view: logical i → physical via ras_base (ADR-0012 D7) */
+        int phys = (i == 0) ? 0 : (1 + (env->ras_base + i) % 63);
+        qemu_fprintf(f, "RA[%02d]: %016" PRIx64 "  ", i, env->ra[phys]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    /* ── SEE/HEE state (QEMU-044t) ── */
+    qemu_fprintf(f, "MODE: %u\n", env->inner_run_mode);
+    qemu_fprintf(f, "CFXCODE: %u\n", env->inner_cfx_code);
+    qemu_fprintf(f, "PTBR: %016" PRIx64 " PTW_ENABLE: %u\n",
+                 env->ptbr, env->ptw_enable);
+    qemu_fprintf(f, "TLBASID: %04" PRIx64 " TLBSTART: %016" PRIx64
+                 " TLBSIZE: %016" PRIx64 "\n",
+                 env->tlb_asid & 0xFFFFULL, env->tlb_start, env->tlb_size);
+    for (i = 0; i < DADAO_NUM_CFX; i++) {
+        DADAOCfxRegs *r = &env->cfx[i];
+        int j;
+
+        qemu_fprintf(f, "CFX%02d ID:%016" PRIx64 " VER:%016" PRIx64
+                     " TRAPN:%016" PRIx64 " SYNCN:%016" PRIx64
+                     " ASYNCN:%016" PRIx64 " ESCN:%016" PRIx64
+                     " SCRN:%016" PRIx64 " GIM:%016" PRIx64 "\n",
+                     dadao_cfxha_map[i], r->cfx_id, r->version, r->trap_num,
+                     r->excp_sync_num, r->excp_async_num, r->escape_num,
+                     r->scratch_regs_num, r->global_cfx_intr_mask);
+        qemu_fprintf(f, "CFX%02d PREVM:%016" PRIx64
+                     " CID:%016" PRIx64 " CIP:%016" PRIx64
+                     " CINFO:%016" PRIx64 " PEND:%016" PRIx64 "\n",
+                     dadao_cfxha_map[i], r->prev_run_mode,
+                     r->cause_id, r->cause_ip, r->cause_info, r->pending);
+        for (j = 0; j < 4; j++) {
+            qemu_fprintf(f, "CFX%02d M%d SWMODE:%016" PRIx64
+                         " VEC:%016" PRIx64
+                         " TRAPMASK:%016" PRIx64 " MEMMASK:%016" PRIx64
+                         " REGMASK:%016" PRIx64 " EXEMASK:%016" PRIx64
+                         " INTRMASK:%016" PRIx64 "\n",
+                         dadao_cfxha_map[i], j,
+                         r->mode[j].switch_run_mode,
+                         r->mode[j].excp_vector, r->mode[j].cfxtrap,
+                         r->mode[j].cfxmem, r->mode[j].cfxreg,
+                         r->mode[j].cfxexe, r->mode[j].cfx_intr_mask);
+        }
+        for (j = 0; j < 4; j++) {
+            qemu_fprintf(f, "CFX%02d SCR%d:%016" PRIx64 "\n",
+                         dadao_cfxha_map[i], j, r->scratch[j]);
+        }
+    }
+    qemu_fprintf(f, "\n");
+}
