+static void dadao_cpu_reset_hold(Object *obj, ResetType type)
+{
+    CPUState *cs = CPU(obj);
+    DadaoCPU *cpu = DADAO_CPU(cs);
+    DadaoCPUClass *mcc = DADAO_CPU_GET_CLASS(obj);
+    CPUDADAOState *env = &cpu->env;
+
+    if (mcc->parent_phases.hold) {
+        mcc->parent_phases.hold(obj, type);
+    }
+
+    /* Reset all registers to zero */
+    memset(env->rd, 0, sizeof(env->rd));
+    memset(env->rb, 0, sizeof(env->rb));
+    memset(env->rf, 0, sizeof(env->rf));
+    memset(env->ra, 0, sizeof(env->ra));
+    env->ras_base = 0;
+
+    /* rd0 hardwired to 0 (already zero from memset) */
+
+    /* rb0 = reset vector = cfx_power_hypv_excp_vector = boot ROM base */
+    env->rb[0] = DADAO_RESET_PC;
+    env->pc = DADAO_RESET_PC;
+
+    /* rf0 = FCSR reset value (per ADR-0004 D2, derived from SimRISC-00 §浮点状态寄存器)
+     * Bits [63:51] = fo format Quiet NaN = 0xFFF (read-only)
+     * Bits [50:34] = SBZ = 0
+     * Bits [33:32] = rounding mode = 0 (RNE, reset default)
+     * Bits [31:22] = ft format Quiet NaN = 0x1FF (read-only)
+     * Bits [21:5]  = SBZ = 0
+     * Bits [4:0]   = exception status = 0 (reset)
+     *
+     * rf0 = (0xFFF << 51) | (0x1FF << 22) = 0x7FF8_0000_7FC0_0000
+     */
+    env->rf[0] = DADAO_RESET_RF0;
+
+    /* ra0-ra63 all zero (RegRAS empty at reset) */
+
+    /* ── SEE/HEE reset state (QEMU-044t) ──
+     * Reset boots in hypv at cfx_power (DADAO-12 §2.1: reset vector is
+     * cfx_power_hypv_excp_vector); inner_cfx_mask = all-ones (ADR-0004 D2,
+     * reference DADAO-0628 scaffold).  Register reset values follow
+     * DADAO-12 §3 (cg0-cg3) and DADAO-13 §1 (cg3/hypv). */
+    env->inner_run_mode = DADAO_MODE_HYPV;
+    env->inner_cfx_code = 63;
+    env->inner_cfx_mask = ~0ULL;
+
+    env->cfx_global_version[0] = 0x00090002ULL;  /* AEE 0.9.2 */
+    env->cfx_global_version[1] = 0x00090002ULL;  /* jail == user (DADAO-12 §3) */
+    env->cfx_global_version[2] = 0x00070001ULL;  /* SEE 0.7.1 */
+    env->cfx_global_version[3] = 0x00010002ULL;  /* HEE 0.1.2 (DADAO-13 §1) */
+    env->global_cfx_mask[0] = ~0ULL;
+    env->global_cfx_mask[1] = ~0ULL;
+    env->global_cfx_mask[2] = ~0ULL;
+    env->global_cfx_mask[3] = 0;                 /* hypv all-0 (DADAO-13 §1) */
+
+    for (int i = 0; i < DADAO_NUM_CFX; i++) {
+        DADAOCfxRegs *r = &env->cfx[i];
+        uint64_t cfxha = (uint64_t)dadao_cfxha_map[i];
+
+        memset(r, 0, sizeof(*r));
+        for (int m = 0; m < 4; m++) {
+            DADAOCfxModeRegs *mr = &r->mode[m];
+
+            if (m == DADAO_MODE_HYPV) {
+                /* DADAO-13 §1 (cg3): masks all-0, switch_run_mode=3,
+                 * switch_cfx_mask all-1, excp_vector = cfxha<<42 | 0x3ff_ffff_0000. */
+                mr->cfx2rd_mask = 0;
+                mr->cfx2rc_mask = 0;
+                mr->cfxld_mask = 0;
+                mr->cfxst_mask = 0;
+                mr->trap_mask = 0;
+                mr->escape_mask = 0;
+                mr->switch_run_mode = DADAO_MODE_HYPV;
+                mr->switch_cfx_mask = ~0ULL;
+                mr->excp_vector = (cfxha << 42) + 0x3FFFFFF0000ULL;
+                mr->excp_cause_mask = ~0ULL;
+                mr->cg_reg_deleg = ~0ULL;
+            } else {
+                /* DADAO-12 §3 (cg0-cg2): masks all-1, switch_run_mode=2 (supv),
+                 * excp_vector 0, excp_cause_mask all-1. */
+                mr->cfx2rd_mask = ~0ULL;
+                mr->cfx2rc_mask = ~0ULL;
+                mr->cfxld_mask = ~0ULL;
+                mr->cfxst_mask = ~0ULL;
+                mr->trap_mask = ~0ULL;
+                mr->escape_mask = ~0ULL;
+                mr->switch_run_mode = DADAO_MODE_SUPV;
+                mr->switch_cfx_mask = ~0ULL;
+                mr->excp_vector = 0;
+                mr->excp_cause_mask = ~0ULL;
+                mr->cg_reg_deleg = 0;
+            }
+        }
+        r->cfx_id = cfxha;                    /* cg4 rc0 (HW) */
+        r->version = 0x00010000ULL;           /* cg4 rc1 (HW; test-machine value) */
+        r->trap_num = 0;                      /* cg4 rc2 */
+        r->excp_sync_num = 0;                 /* cg4 rc3 */
+        r->excp_async_num = 0;                /* cg4 rc4 */
+        r->escape_num = 0;                    /* cg4 rc5 */
+        r->scratch_regs_num = 4;              /* cg4 rc6 (HW; >=2,<=64) */
+        r->prev_run_mode = 0;                 /* cg5 rc0 */
+        r->prev_cfx_mask = 0;                 /* cg5 rc1 */
+        r->cause_id = 0;                      /* cg5 rc2 */
+        r->cause_ip = 0;                      /* cg5 rc3 */
+        r->cause_info = 0;                    /* cg5 rc4 */
+        r->pending = 0;                       /* cg5 rc5 */
+        /* cg5 rc63: non-maskable set from the monitor exception table
+         * (DADAO-12 §4: every listed monitor cause is "no"). */
+        r->cause_nonmaskable = DADAO_CAUSE_CFXTRAP | DADAO_CAUSE_CFXMEM |
+                               DADAO_CAUSE_CFXREG | DADAO_CAUSE_ILLI |
+                               DADAO_CAUSE_UNDI | DADAO_CAUSE_RASOF |
+                               DADAO_CAUSE_RASUF | DADAO_CAUSE_MALIGN |
+                               DADAO_CAUSE_IALIGN;
+        /* cg6 scratch[]/cg7 left 0 (scratch undefined at reset) */
+    }
+}
