+static void dadao_cpu_dump_state(CPUState *cs, FILE *f, int flags)
+{
+    CPUDADAOState *env = cpu_env(cs);
+    int i;
+
+    qemu_fprintf(f, "\n");
+    qemu_fprintf(f, "PC: %016" PRIx64 "\n", env->pc);
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RD[%02d]: %016" PRIx64 "  ", i, env->rd[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RB[%02d]: %016" PRIx64 "  ", i, env->rb[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        qemu_fprintf(f, "RF[%02d]: %016" PRIx64 "  ", i, env->rf[i]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    for (i = 0; i < 64; i++) {
+        /* Ring-buffer view: logical i → physical via ras_base (ADR-0012 D7) */
+        int phys = (i == 0) ? 0 : (1 + (env->ras_base + i) % 63);
+        qemu_fprintf(f, "RA[%02d]: %016" PRIx64 "  ", i, env->ra[phys]);
+        if ((i % 4) == 3) {
+            qemu_fprintf(f, "\n");
+        }
+    }
+    qemu_fprintf(f, "\n");
+
+    /* ── SEE/HEE state (QEMU-044t) ── */
+    qemu_fprintf(f, "MODE: %u\n", env->inner_run_mode);
+    qemu_fprintf(f, "CFXCODE: %u\n", env->inner_cfx_code);
+    qemu_fprintf(f, "CFXMASK: %016" PRIx64 "\n", env->inner_cfx_mask);
+    for (i = 0; i < 4; i++) {
+        qemu_fprintf(f, "GVER%d: %016" PRIx64 " GCM%d: %016" PRIx64 "\n",
+                     i, env->cfx_global_version[i], i, env->global_cfx_mask[i]);
+    }
+    for (i = 0; i < DADAO_NUM_CFX; i++) {
+        DADAOCfxRegs *r = &env->cfx[i];
+        int j;
+
+        qemu_fprintf(f, "CFX%02d ID:%016" PRIx64 " VER:%016" PRIx64
+                     " TRAPN:%016" PRIx64 " SYNCN:%016" PRIx64
+                     " ASYNCN:%016" PRIx64 " ESCN:%016" PRIx64
+                     " SCRN:%016" PRIx64 "\n",
+                     dadao_cfxha_map[i], r->cfx_id, r->version, r->trap_num,
+                     r->excp_sync_num, r->excp_async_num, r->escape_num,
+                     r->scratch_regs_num);
+        qemu_fprintf(f, "CFX%02d PREVM:%016" PRIx64 " PREVMASK:%016" PRIx64
+                     " CID:%016" PRIx64 " CIP:%016" PRIx64
+                     " CINFO:%016" PRIx64 " PEND:%016" PRIx64
+                     " NONMASK:%016" PRIx64 "\n",
+                     dadao_cfxha_map[i], r->prev_run_mode, r->prev_cfx_mask,
+                     r->cause_id, r->cause_ip, r->cause_info, r->pending,
+                     r->cause_nonmaskable);
+        for (j = 0; j < 4; j++) {
+            qemu_fprintf(f, "CFX%02d M%d SWMODE:%016" PRIx64
+                         " SWMASK:%016" PRIx64 " VEC:%016" PRIx64
+                         " TRAPMASK:%016" PRIx64 " CAUSEMASK:%016" PRIx64
+                         " CX2RMASK:%016" PRIx64 " CX2WMASK:%016" PRIx64
+                         " ESCMASK:%016" PRIx64 " GVER:%016" PRIx64 "\n",
+                         dadao_cfxha_map[i], j,
+                         r->mode[j].switch_run_mode, r->mode[j].switch_cfx_mask,
+                         r->mode[j].excp_vector, r->mode[j].trap_mask,
+                         r->mode[j].excp_cause_mask, r->mode[j].cfx2rd_mask,
+                         r->mode[j].cfx2rc_mask, r->mode[j].escape_mask,
+                         env->cfx_global_version[j]);
+        }
+        for (j = 0; j < 4; j++) {
+            qemu_fprintf(f, "CFX%02d SCR%d:%016" PRIx64 "\n",
+                         dadao_cfxha_map[i], j, r->scratch[j]);
+        }
+    }
+    qemu_fprintf(f, "\n");
+}
