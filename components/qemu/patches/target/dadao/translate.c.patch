+static void dadao_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+    uint32_t insn = translator_ldl_end(ctx->env, &ctx->base,
+                                        ctx->base.pc_next, MO_BE);
+    ctx->opcode = insn;
+    if (!decode_insn(ctx, insn)) {
+        gen_exception_undi(ctx);
+    }
+    ctx->base.pc_next += 4;
+}
+
+/* Update env->pc to the given value. Used before TB exit to ensure
+ * the next TB starts from the correct PC. */
+static void gen_update_pc(DisasContext *ctx, target_ulong dest)
+{
+    tcg_gen_st_i64(tcg_constant_i64(dest),
+                   tcg_env, offsetof(CPUDADAOState, pc));
+}
+
+static void dadao_tr_tb_stop(DisasContextBase *dcbase, CPUState *cs)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+    target_ulong dest;
+
+    switch (ctx->base.is_jmp) {
+    case DISAS_NORETURN:
+        break;
+    case DISAS_TOO_MANY:
+    case DISAS_NEXT:
+        dest = ctx->base.pc_next;
+        if (translator_use_goto_tb(&ctx->base, dest)) {
+            gen_update_pc(ctx, dest);
+            tcg_gen_goto_tb(0);
+            tcg_gen_exit_tb(NULL, 0);
+        } else {
+            gen_update_pc(ctx, dest);
+            tcg_gen_lookup_and_goto_ptr();
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static const TranslatorOps dadao_tr_ops = {
+    .init_disas_context = dadao_tr_init_disas_context,
+    .tb_start           = dadao_tr_tb_start,
+    .insn_start         = dadao_tr_insn_start,
+    .translate_insn     = dadao_tr_translate_insn,
+    .tb_stop            = dadao_tr_tb_stop,
+};
+
+void dadao_cpu_translate_code(CPUState *cs, TranslationBlock *tb,
+                              int *max_insns, vaddr pc, void *host_pc)
+{
+    DisasContext dc = { };
+    translator_loop(cs, tb, max_insns, pc, host_pc, &dadao_tr_ops, &dc.base,
+                    TCG_TYPE_I64);
+}
+
+void dadao_cpu_tcg_init(void) {}
