index 000000000..6ce5f39ff
--- /dev/null
+++ b/arch/dadao/Kconfig.debug
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: GPL-2.0
+# DADAO debug options.
+#
+# These are boot-progress boundaries, not features: each one stops the kernel at
+# the point the corresponding milestone proves, so a later milestone turns it
+# off.  They default to n — an image that needs one states it (the K1 gate
+# configures its own image with `CONFIG_DADAO_K1_EARLY_STOP=y`), which is what
+# keeps "which boundary am I booting" an explicit property of the image instead
+# of an inherited .config.
+
+config DADAO_K1_EARLY_STOP
+	bool "Stop at the first line of start_kernel() (K1 boundary)"
+	default n
+	help
+	  K1 (m14-linux-003/005) only proves that the kernel *reaches*
+	  start_kernel(): the first statement of start_kernel() reports the
+	  boot info handoff and exits through semihosting SYS_EXIT(0) before
+	  any subsystem, clock, timer or interrupt is initialised.
+
+	  K2 turns this off and lets setup_arch() run (see
+	  DADAO_K2_EARLY_STOP).  The K1 gate keeps its own image: it sets the
+	  symbol with the explicit config-slice entry point.
+
+config DADAO_K2_EARLY_STOP
+	bool "Stop at the end of setup_arch() (K2 boundary)"
+	default n
+	help
+	  K2 (m14-linux-006) makes the supv synchronous-exception channel real:
+	  the entry captures the whole register file, the C half dispatches by
+	  cause and unrecoverable exceptions stop with the spec/Kaiwu §7.1
+	  monitor exit code.  This boundary reports the channel and exits
+	  through semihosting SYS_EXIT(0) once setup_arch() has run — before
+	  any clock, timer or interrupt controller exists.
+
+	  m14-linux-007 (timer) and m14-linux-008 (interrupt mask) move the
+	  boundary further: the default K2 image now stops at
+	  DADAO_K2_TIME_STOP below instead.
+
+config DADAO_K2_TIME_STOP
+	bool "Attach the timer and stop after the ticks (K2 time boundary)"
+	default n
+	help
+	  m14-linux-007 attaches the clock: at the end of setup_arch() the
+	  kernel reads cfx_time, installs the cfx_hart supv vector, opens the two
+	  interrupt mask axes, arms the single-hart timer, waits for the
+	  configured number of TIMER ticks (jiffies advances on each) and stops
+	  the machine through semihosting SYS_EXIT(0).  This is the K2 boundary
+	  the default image carries; the exception gate pins the earlier
+	  DADAO_K2_EARLY_STOP for its own images.
+
+config DADAO_K2_TIME_CASE
+	int "K2 time self-test case (0 = production, 1 = IMASK, 2/3 = one axis)"
+	default 0
+	range 0 3
+	depends on DADAO_K2_TIME_STOP
+	help
+	  Selects what the K2 time boundary exercises, so each probe image pins
+	  its own case instead of inheriting it:
+
+	    0  production: both mask axes open, the ticks, then the stopped-timer
+	       control (this is the image the later milestones boot);
+	    1  + the IMASK case first: a masked expiry only sets the pending bit
+	       and releasing IMASK delivers that event exactly once;
+	    2  the source axis (the kernel's IE row) stays closed — no tick may
+	       be delivered even though the global axis is open;
+	    3  the global axis stays closed — no tick may be delivered even
+	       though the source axis is open.
+
+	  Cases 2/3 exist to show that the two axes are independently required
+	  (contract-see §3/§6.4); they are test scaffolding and never part of a
+	  milestone image.
+
+config DADAO_K2_IRQ_TEST
+	bool "Run the K2 interrupt-enable knob self-test at the K2 boundary"
+	default n
+	depends on DADAO_K2_TIME_STOP
+	help
+	  Exercise the software IE knob (asm/irqflags.h) from inside the kernel
+	  and print the physical mask register back after every step (see
+	  kernel/k2_irq_test.c): the save/restore round trip, two nested saves,
+	  arch_irqs_disabled() against the live register, a masked window that
+	  freezes the tick count, and an event made pending inside a live frame
+	  that must only be delivered after `escape`.
+
+	  The boot ends after the cases.  This is test scaffolding (the K2 gate
+	  builds a probe image with it); it is not part of the image the later
+	  milestones boot.
+
+config DADAO_K2_TRAP_SELFTEST
+	bool "Run the K2 supv-exception self-test at the K2 boundary"
+	default n
+	depends on DADAO_K2_EARLY_STOP
+	help
+	  Exercise the exception channel from inside the kernel (see
+	  kernel/k2_selftest.c): a registered CFXMEM probe that is resumed with
+	  both escape offsets, the frame's register-file integrity, and the
+	  named termination of an unregistered fault.
+
+	  This is test scaffolding (the K2 gate builds a probe image with it);
+	  it is not part of the K2 image the later milestones boot.
+
+config DADAO_K2_SELFTEST_REENTRY
+	bool "K2 self-test ends with a fault inside the handler"
+	default n
+	depends on DADAO_K2_TRAP_SELFTEST
+	help
+	  The self-test's last case faults *inside* the handler, so the entry
+	  re-enters with the channel busy: the re-entrancy guard must report it
+	  as a kernel self-check failure instead of dispatching it.  The boot
+	  ends there, hence it is selected per image.
+
+config DADAO_K2_SELFTEST_CFXTRAP
+	bool "K2 self-test ends with an unregistered CFXTRAP"
+	default n
+	depends on DADAO_K2_TRAP_SELFTEST
+	help
+	  The last case executes `trap cfx_smon` with no probe registered, so the
+	  exception is fatal: spec/Kaiwu §7.1 puts CFXTRAP in the "other
+	  cfx" segment (0x80 | cfxHA), which the image then exits with.
+
+config DADAO_K2_SELFTEST_CFXESC
+	bool "K2 self-test ends with a CFXESC"
+	default n
+	depends on DADAO_K2_TRAP_SELFTEST
+	help
+	  The last case escapes to a cfx that is not the current one, i.e. the
+	  frame/target error of spec/DADAO-12 §5.1 (§7.1: same "other cfx"
+	  segment as CFXTRAP).
+
+config DADAO_K2_SELFTEST_UNKNOWN
+	bool "Corrupt the dispatched cause id (K2 unknown-cause probe)"
+	default n
+	depends on DADAO_K2_TRAP_SELFTEST
+	help
+	  `cfx_smon.excp_cause_id` is hardware-read-only, so the only way to
+	  exercise the dispatcher's "not in the 11-item table" path is to alter
+	  the value the C half receives.  This symbol adds that hook to
+	  kernel/traps.c; it exists only for the K2 gate's P4 probe image and
+	  must never be set in an image that boots anything.
