diff --git a/arch/dadao/Kconfig b/arch/dadao/Kconfig
new file mode 100644
index 000000000..c734cf358
--- /dev/null
+++ b/arch/dadao/Kconfig
@@ -0,0 +1,129 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# DADAO (v5 test machine "Vast") architecture.
+#
+# K0 scope: a kernel that links.  No SMP, no device tree, no UART, no PCI;
+# the console is a semihosting stub and the boot ABI is the fixed boot info
+# block (spec/Kaiwu §6.3, contract-linux-boot).
+
+config DADAO
+	def_bool y
+	select 64BIT
+	select HAVE_PAGE_SIZE_64KB
+	select ARCH_HAS_DMA_PREP_COHERENT if DMA
+	select MMU_GATHER_NO_RANGE if MMU
+	# The generic interrupt-entry helpers (kernel/entry/common.o):
+	# `irqentry_enter`/`irqentry_exit` and the user-mode wrappers live behind
+	# this symbol (kernel/entry/Makefile:15).  The asynchronous vector already
+	# enters/leaves the hard-IRQ context through irq_enter_rcu()/irq_exit_rcu()
+	# (kernel/time.c), which is what makes in_hardirq() true; wiring the
+	# irqentry_* call sites is the entry/exit work loop (m14-linux-045).
+	select GENERIC_IRQ_ENTRY
+	# sched_clock_register() is an empty `static inline` without this symbol
+	# (include/linux/sched_clock.h:43-50), so registering the time base would
+	# silently do nothing; time_init() registers cfx_time as the source
+	# (m14-linux-044).  The tick chain stays with m14-linux-026.
+	select GENERIC_SCHED_CLOCK
+	# User copies are exception-table backed (lib/copy_user.S + mm/extable.c):
+	# a bad user pointer is fixed up to "bytes not copied" (-EFAULT).  The
+	# generic memcpy accessors cannot do that -- they have no __ex_table entry
+	# -- and upstream riscv selects them only `if !MMU` (arch/riscv/Kconfig:229).
+	# This port has an MMU, so it does not select UACCESS_MEMCPY (m14-linux-044).
+	# The page-fault entry uses the generic "lock, find (and maybe grow) the
+	# VMA" helper, which is what makes stack growth / the hole-vs-VMA verdict
+	# generic (m14-linux-035).
+	select LOCK_MM_AND_FIND_VMA
+	# The syscall ABI splits arguments by type; see asm/syscall_wrapper.h.
+	select ARCH_HAS_SYSCALL_WRAPPER
+	# clone(2) carries `tls` as its *4th* argument (flags, newsp, parent_tidptr,
+	# tls, child_tidptr) -- the order musl's `clone` stub sends and
+	# contract-syscall §10 describes; the generic table has both orders behind
+	# this symbol (m14-linux-024).
+	select CLONE_BACKWARDS
+	help
+	  DADAO is a 64-bit big-endian architecture with a 42-bit memory
+	  window (addr[41:0]) and 64 KiB pages.  The v5 test machine boots
+	  the kernel with a prebuilt page table and a fixed boot info block.
+
+config 64BIT
+	def_bool y
+
+config CPU_BIG_ENDIAN
+	def_bool y
+
+config MMU
+	def_bool y
+
+config NO_IOPORT_MAP
+	def_bool y
+	help
+	  K0 has no I/O port space: no UART, no PCI, no ISA.
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config GENERIC_CALIBRATE_DELAY
+	def_bool y
+
+config GENERIC_CSUM
+	def_bool y
+
+config NR_CPUS
+	int "Maximum number of CPUs"
+	default 1
+	range 1 1
+	help
+	  K0 is single-hart: only hart_id 0 is online and the boot ABI does
+	  not define SMP bring-up.
+
+config ARCH_FORCE_MAX_ORDER
+	int "Order of maximal physically contiguous allocations"
+	default 13
+	help
+	  The largest buddy order equals one superpage: 2^13 x 64 KiB = 512 MiB,
+	  the size of the `SPF` superpage (spec/DADAO-12 §2.2.2), so the
+	  allocator's biggest block and the machine's biggest leaf mapping are
+	  the same object (user ruling 2026-11-20, m14-linux-028).  arm64 makes
+	  the same choice for its 64 KiB pages.
+
+	  The cost is bounded by the zone size: `pageblock_order` follows this
+	  value, and a zone smaller than one pageblock clamps its `usemap_size`
+	  to a single bitmap word (m14-linux-028 measures the Tiny image).
+
+config PAGE_OFFSET
+	hex
+	default 0x20000000000
+	help
+	  Kernel VA window base: VA = PA + 2 TiB inside [2 TiB, 3 TiB).
+
+config PHYS_OFFSET
+	hex
+	default 0x0
+
+config ARCH_DMA_MINALIGN
+	int
+	default 128
+
+config ARCH_SEMIHOSTING_CONSOLE
+	bool "Semihosting console stub"
+	default y
+	help
+	  Register a printk console that writes through the semihosting
+	  SYS_WRITE0 trap.  K0 only needs this to link; no output is
+	  claimed until the K1 boot path runs.
+
+menu "Kernel features"
+source "kernel/Kconfig.hz"
+endmenu
+
+menu "Boot options"
+
+config CMDLINE
+	string "Default kernel command string"
+	default ""
+	help
+	  K0 has no command line: the boot info block carries
+	  cmdline_base/cmdline_size = 0.  Kept so the generic boot code has
+	  the symbol it references.
+
+endmenu
