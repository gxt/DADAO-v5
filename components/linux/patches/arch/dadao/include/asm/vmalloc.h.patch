diff --git a/arch/dadao/include/asm/vmalloc.h b/arch/dadao/include/asm/vmalloc.h
new file mode 100644
index 000000000..c0fd024d3
--- /dev/null
+++ b/arch/dadao/include/asm/vmalloc.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_VMALLOC_H
+#define __ASM_VMALLOC_H
+
+/*
+ * vmalloc area = the part of the kernel VA window above the **direct map**.
+ *
+ * The direct map is `PAGE_OFFSET + [0, RAM)` (VA = PA + 2 TiB), so the area
+ * must start past the largest machine's RAM window (`contracts/machine.yaml`:
+ * Vast, 2 GiB) - starting at the end of the image instead (2 TiB + 96 MiB)
+ * makes `is_vmalloc_addr()` claim every direct-mapped address above PA 96 MiB
+ * as a vmalloc address.  `kvfree()` then calls `vfree()` on a kmalloc object,
+ * and when that happens in a softirq (`kvfree_call_rcu`) the object is queued
+ * on the deferred-vfree list by writing a `next` pointer into it: the freeing
+ * worker walks that garbage forever (measured: m14-linux-028's probe image
+ * hung in `delayed_vfree_work` on `vfree()` of a kmalloc address).
+ *
+ * The value is `PAGE_OFFSET + 0x8000_0000` = 2 TiB + 2 GiB (spelled out
+ * because <asm/page.h> is not available here); the window still ends at
+ * 3 TiB (contract-linux-boot §2's kernel window), leaving 1 TiB - 2 GiB.
+ */
+#define VMALLOC_START		0x20080000000UL
+#define VMALLOC_END		0x30000000000UL
+
+#endif /* __ASM_VMALLOC_H */
