diff --git a/arch/dadao/include/asm/irqflags.h b/arch/dadao/include/asm/irqflags.h
new file mode 100644
index 000000000..c7a29f236
--- /dev/null
+++ b/arch/dadao/include/asm/irqflags.h
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_IRQFLAGS_H
+#define __ASM_IRQFLAGS_H
+
+#ifndef __ASSEMBLY__
+
+#include <asm/cfx.h>
+
+/*
+ * DADAO has no interrupt-enable state bit.  ADR-0064 leaves the per-mode gate
+ * in the **running mode monitor's** `cg15 rc3`
+ * (`cfx_<monitor>_async_intr_mask`, DADAO-12 §4.1-§4.4/§5.4).  The bit index is
+ * the *source cfxha* (`TIMER` = 15, `PMEM_DMA` = 32), `0 = allow`, `1 = mask`,
+ * and the reset value is all ones.
+ *
+ * The kernel runs in `supv`, so its software IE knob is `cfx_smon`'s
+ * `cg15 rc3`.  A user task runs against `cfx_umon`'s same row; whether a user
+ * context may be preempted is a scheduling policy, set at init and around the
+ * mode switch (kernel/process.c).  This header owns only the kernel row.
+ *
+ * `flags` is the whole 64-bit mask word: the mask register *is* the state,
+ * there is no separate IE bit to pack, and a whole-word save/restore is
+ * bit-identical.  Nesting is plain value passing.
+ */
+#define DADAO_IRQ_CG_SUPV		15	/* cfx_smon_async_intr_mask */
+#define DADAO_IRQ_RC_SUPV_CFX_INTR_MASK	3
+#define DADAO_IRQ_CG_USER		15	/* cfx_umon_async_intr_mask */
+#define DADAO_IRQ_RC_USER_CFX_INTR_MASK	3
+
+/*
+ * The sources this kernel owns: one mask bit per *source cfxha* (ADR-0061 D2).
+ * `TIMER` is cfx_hart (15), `PMEM_DMA` is cfx_pmem (32).  This is the single
+ * definition; no other site spells the bits out.
+ */
+#define DADAO_IRQ_SOURCE_BITS		((1UL << 15) | (1UL << 32))
+
+/* Physical row access: the probe images read these back with `cfx2rd`. */
+static inline unsigned long dadao_irq_mask_row_smon(void)
+{
+	return DADAO_CFX_READ(cfx_smon, DADAO_IRQ_CG_SUPV,
+			      DADAO_IRQ_RC_SUPV_CFX_INTR_MASK);
+}
+
+static inline unsigned long dadao_irq_mask_row_umon(void)
+{
+	return DADAO_CFX_READ(cfx_umon, DADAO_IRQ_CG_USER,
+			      DADAO_IRQ_RC_USER_CFX_INTR_MASK);
+}
+
+static inline void dadao_irq_mask_row_write(unsigned long value)
+{
+	DADAO_CFX_WRITE(cfx_smon, DADAO_IRQ_CG_SUPV,
+			DADAO_IRQ_RC_SUPV_CFX_INTR_MASK, value);
+}
+
+static inline unsigned long arch_local_save_flags(void)
+{
+	return dadao_irq_mask_row_smon();
+}
+
+static inline unsigned long arch_local_irq_save(void)
+{
+	unsigned long flags = dadao_irq_mask_row_smon();
+
+	dadao_irq_mask_row_write(flags | DADAO_IRQ_SOURCE_BITS);
+	return flags;
+}
+
+static inline void arch_local_irq_restore(unsigned long flags)
+{
+	dadao_irq_mask_row_write(flags);
+}
+
+static inline void arch_local_irq_disable(void)
+{
+	(void)arch_local_irq_save();
+}
+
+/*
+ * Enable: clear the kernel's source bits only, keeping every other bit the row
+ * already carried.  The row is a physical read-modify-write, so the result
+ * stays observable with `cfx2rd`.
+ */
+static inline void arch_local_irq_enable(void)
+{
+	DADAO_CFX_WRITE(cfx_smon, DADAO_IRQ_CG_SUPV,
+			DADAO_IRQ_RC_SUPV_CFX_INTR_MASK,
+			dadao_irq_mask_row_smon() & ~DADAO_IRQ_SOURCE_BITS);
+}
+
+static inline int arch_irqs_disabled_flags(unsigned long flags)
+{
+	return (flags & DADAO_IRQ_SOURCE_BITS) != 0;
+}
+
+static inline int arch_irqs_disabled(void)
+{
+	return arch_irqs_disabled_flags(arch_local_save_flags());
+}
+
+#define arch_local_irq_save	arch_local_irq_save
+#define arch_local_irq_restore	arch_local_irq_restore
+#define arch_local_irq_disable	arch_local_irq_disable
+#define arch_local_irq_enable	arch_local_irq_enable
+#define arch_local_save_flags	arch_local_save_flags
+#define arch_irqs_disabled	arch_irqs_disabled
+#define arch_irqs_disabled_flags arch_irqs_disabled_flags
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_IRQFLAGS_H */
