diff --git a/arch/dadao/include/asm/irqflags.h b/arch/dadao/include/asm/irqflags.h
new file mode 100644
index 000000000..957d91e0d
--- /dev/null
+++ b/arch/dadao/include/asm/irqflags.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_IRQFLAGS_H
+#define __ASM_IRQFLAGS_H
+
+#ifndef __ASSEMBLY__
+
+#include <asm/cfx.h>
+
+/*
+ * DADAO has no interrupt-enable state bit (spec/DADAO-12 §3.1/§3.3): the only
+ * gates in front of an asynchronous source are the two source-mask levels —
+ *
+ *   per-cfx   <mode>_cfx_intr_mask       `cg2 rc4` in supv (contract-see §3)
+ *   per-mode  global_cfx_intr_mask       `cg8 rc1` of the mode monitor (cfx0-3)
+ *
+ * both indexed by the *target cfxha* and both "0 = allow, 1 = mask".
+ *
+ * The knob is the **running mode monitor's** `<mode>_cfx_intr_mask` row
+ * (spec/DADAO-12 §5.2(三) step 3, user ruling ISS-455): the kernel runs in
+ * `supv`, so the row is `cfx_smon`'s `cg2 rc4`.  Which register the knob writes
+ * follows from the *run mode* alone — it is not derived from "which cfx is
+ * current".
+ *
+ * `global_cfx_intr_mask` is not usable as the software knob: the hardware saves
+ * it when a frame is established, sets it all-1, and restores it on `escape`
+ * (contract-see §6.3/§6.4, ADR-0045 D9), so a software write-back would collide
+ * with the frame's own save/restore.  It stays a one-time mode-level release
+ * owned by init_IRQ().
+ *
+ * m14-linux-008 also wrote `cfx_hart`'s row, justified by "after the first
+ * delivery the current cfx is cfx_hart".  ISS-454 retired that reason: `escape`
+ * restores only the run mode and never `inner_cfx_code` (spec/DADAO-12 §5.3),
+ * so the current cfx indeed stays at the target — but the run mode is still
+ * `supv`, so the monitor row is still the one the filter consults, and writing
+ * the delivered cfx's row only obscured the reading it was meant to support.
+ * The knob writes one row (m14-linux-010).
+ */
+#define DADAO_IRQ_CG_SUPV		2	/* supv row, spec/DADAO-12 §3.3 */
+#define DADAO_IRQ_RC_SUPV_CFX_INTR_MASK	4
+
+/*
+ * The sources this kernel cares about: one mask bit per *target cfxha*, not per
+ * cause id (contract-see §6.4 names the two numbering schemes explicitly).  K2
+ * enables exactly one source — `TIMER` (`1 << 10`) is delivered to `cfx_hart`,
+ * cfxha 15 (contracts/cfx-aliases.txt) — so the knob owns bit 15.  This is the
+ * single definition; no other site may spell the bit out.
+ */
+#define DADAO_IRQ_SOURCE_BITS		(1UL << 15)
+
+/* Raw row access.  Two one-liners so a probe image can read the physical
+ * registers back (`cfx2rd`) instead of trusting a recorded shadow.  Only the
+ * `smon` row is written below; the `hart` reader exists so the probe can show
+ * that the delivered cfx's row is not touched at all. */
+static inline unsigned long dadao_irq_mask_row_smon(void)
+{
+	return DADAO_CFX_READ(cfx_smon, DADAO_IRQ_CG_SUPV,
+			      DADAO_IRQ_RC_SUPV_CFX_INTR_MASK);
+}
+
+static inline unsigned long dadao_irq_mask_row_hart(void)
+{
+	return DADAO_CFX_READ(cfx_hart, DADAO_IRQ_CG_SUPV,
+			      DADAO_IRQ_RC_SUPV_CFX_INTR_MASK);
+}
+
+static inline void dadao_irq_mask_row_write(unsigned long value)
+{
+	DADAO_CFX_WRITE(cfx_smon, DADAO_IRQ_CG_SUPV,
+			DADAO_IRQ_RC_SUPV_CFX_INTR_MASK, value);
+}
+
+/*
+ * `flags` is the whole 64-bit `cg2 rc4` value (task m14-linux-008 ruling 1):
+ * the mask register IS the state, there is no separate IE bit to pack, and a
+ * whole-word save needs no field layout that would have to change when a
+ * second source (or a second mask register) appears.  The assumption to revisit
+ * then is stated here on purpose: `restore` writes this one word back to the
+ * one row the run mode selects.
+ */
+
+static inline unsigned long arch_local_save_flags(void)
+{
+	return dadao_irq_mask_row_smon();
+}
+
+/*
+ * Mask every source this kernel cares about and return the previous knob value.
+ *
+ * Round trip: `arch_local_irq_restore(arch_local_irq_save())` writes `flags`
+ * back to the same row, so afterwards it reads *bit-identically* what it read
+ * before — not merely "the same masked state".  Nesting is therefore plain
+ * value passing: an inner save records `flags | DADAO_IRQ_SOURCE_BITS`, and
+ * only the outer restore re-enables.
+ *
+ * A masked source is not lost: the event is still recorded in the *target*
+ * cfx's `cg5 rc5` pending bit and the hardware re-kicks it after a mask write /
+ * `escape` (contract-see §3/§6.4).  This header keeps no software pending
+ * bitmap, and it must not grow one.
+ */
+static inline unsigned long arch_local_irq_save(void)
+{
+	unsigned long flags = dadao_irq_mask_row_smon();
+
+	dadao_irq_mask_row_write(flags | DADAO_IRQ_SOURCE_BITS);
+	return flags;
+}
+
+static inline void arch_local_irq_restore(unsigned long flags)
+{
+	dadao_irq_mask_row_write(flags);
+}
+
+static inline void arch_local_irq_disable(void)
+{
+	(void)arch_local_irq_save();
+}
+
+/*
+ * Enable: clear the kernel's source bits only, keeping every other bit the row
+ * already carried (task ruling 2) — a blanket "write 0" would also discard a
+ * source policy this kernel does not own (firmware, later K4 source
+ * management).  The row is a physical read-modify-write, so the result stays
+ * observable with `cfx2rd`.
+ */
+static inline void arch_local_irq_enable(void)
+{
+	DADAO_CFX_WRITE(cfx_smon, DADAO_IRQ_CG_SUPV,
+			DADAO_IRQ_RC_SUPV_CFX_INTR_MASK,
+			dadao_irq_mask_row_smon() & ~DADAO_IRQ_SOURCE_BITS);
+}
+
+static inline int arch_irqs_disabled_flags(unsigned long flags)
+{
+	/* "does this knob value block a source the kernel cares about" — a bit
+	 * test, not `flags == 0` (the mask is all-1 at reset, so zero means
+	 * something else). */
+	return (flags & DADAO_IRQ_SOURCE_BITS) != 0;
+}
+
+static inline int arch_irqs_disabled(void)
+{
+	return arch_irqs_disabled_flags(arch_local_save_flags());
+}
+
+/*
+ * Boundary (task ruling 3): the frame rewrite that precedes `escape` is *not*
+ * wrapped in a critical section.  `escape` is a control transfer, not an
+ * interruptible point, and a live frame is already protected by the hardware's
+ * all-1 `global_cfx_intr_mask` (contract-see §6.3); masking around it would
+ * only describe a race that the frame itself excludes.
+ */
+
+#define arch_local_irq_save	arch_local_irq_save
+#define arch_local_irq_restore	arch_local_irq_restore
+#define arch_local_irq_disable	arch_local_irq_disable
+#define arch_local_irq_enable	arch_local_irq_enable
+#define arch_local_save_flags	arch_local_save_flags
+#define arch_irqs_disabled	arch_irqs_disabled
+#define arch_irqs_disabled_flags arch_irqs_disabled_flags
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_IRQFLAGS_H */
