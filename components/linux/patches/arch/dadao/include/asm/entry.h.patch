index 000000000..d75608e6d
--- /dev/null
+++ b/arch/dadao/include/asm/entry.h
@@ -0,0 +1,285 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO exception-entry register-file save/restore (assembly only).
+ *
+ * spec/DADAO-12 §3.6: the hardware saves **only** the cg5 frame fields — not a
+ * single general register — so every entry stub has to capture `rd1-rd63` and
+ * `rb1-rb63` itself (`rd0` is hardwired zero, `rb0` is the read-only IP; §3.6,
+ * contract-syscall §8).  spec/SimRISC-00 §2.4 adds the return-address bank:
+ * "异常进入和退出不改变 ra0–ra63 的内容，异常 handler 中可正常使用 call/ret",
+ * which only holds if the entry saves the whole RAS — the handler's own
+ * `call`/`ret` pairs push and pop entries and leave their *contents* behind —
+ * and restores it on the way out.  The floating-point bank goes with it: the
+ * user process owns `rf0-rf63` (rf0 = FCSR) and the handler may use it.
+ *
+ * Both stubs of the K2 channel (kernel/trap.S for supv synchronous exceptions,
+ * kernel/async_trap.S for the cfx_hart asynchronous vector) do exactly the same
+ * thing, so the sequence lives here once.
+ *
+ * Bootstrap order — why this shape:
+ *
+ *   Storing needs an RB base register, so exactly one RB register is borrowed
+ *   before the frame exists (`rb3` = rbtp, reserved by contract-abi §4.5/§8, so
+ *   the compiler never allocates it), and every register has to be captured
+ *   before it is used as scratch.  `rd2`/`rd3` (reserved debug registers) are
+ *   the staging set; their own pre-exception values are parked in the *target
+ *   cfx's* cg6 scratch registers (§3.7, `scratch_regs_num >= 2`) — the place
+ *   the architecture provides for exactly this.  The parameter `cfx` is the cfx
+ *   whose vector was entered: `cfx_smon` for the synchronous stub,
+ *   `cfx_hart` for the asynchronous one.
+ *
+ * The frame lives in `.bss`, not on the faulting stack: a synchronous exception
+ * can be raised by a broken SP, and §5.2 step 7 gives the guest no recovery for
+ * an unmapped vector page.  One static frame per entry kind is sound while one
+ * hart takes one exception at a time and the handler never sleeps; K4
+ * (preemption / re-entrancy) moves it to the kernel stack of the task it saves.
+ *
+ * Saving/restoring in blocks (spec/SimRISC-01 §1–§4):
+ *
+ *   `stm.o`/`ldm.o` move 1-63 consecutive registers at an 8-byte aligned
+ *   address.  `immu6 <= 63`, so a 64-slot bank needs two transfers: {x0:x62}
+ *   and {x63:x63}.  Nothing is transposed through `rd`: the RA and RF forms are
+ *   hardware transfers (spec/SimRISC-00 §2.4.3 says as much for `ra`, whose
+ *   ring-buffer base index has to be translated by the *hardware* for the
+ *   software-visible view to come out right), so a trap costs four block
+ *   transfers for the two banks rather than 128 single loads/stores.
+ *
+ *   Five blocks cover the file: {rd1:rd63} at PT_RD_BASE (index rd0 = 0),
+ *   {rb1:rb2} and {rb4:rb63} at their slots, {ra0:ra62} + {ra63:ra63} at
+ *   PT_RA_BASE, and {rf0:rf62} + {rf63:rf63} at PT_RF_BASE.  `ra0` is the
+ *   {RACNT, MRPTR} word (spec/SimRISC-00 §2.4): saving it with the entries and
+ *   writing it back on the way out is what makes the RAS state — not just the
+ *   63 entry slots — round-trip; `rf0` is the FCSR and the block form reads and
+ *   writes it whole (§2.3).  `rb3` — the base register — comes last, with a
+ *   single `ld.o rb3, [rb3, <slot>]` (the address is formed before the
+ *   destination is written, so this is the one load that can keep using the
+ *   base it destroys).  `ldm` must not have its base register inside the
+ *   transfer range (§1/§2), which is why {rb1:rb63} is split around rb3.  The
+ *   index register of every block is `rd2`, restored afterwards by the RD
+ *   block — order: RB blocks, RA/RF banks, RD block, then rb3.
+ *
+ * `rb0` is never used as a temporary: it is the read-only IP register
+ * (spec/SimRISC-00), and the stubs only ever *read* it through the branch and
+ * jump encodings.
+ */
+#ifndef __ASM_DADAO_ENTRY_H
+#define __ASM_DADAO_ENTRY_H
+
+#ifndef __ASSEMBLY__
+#error "asm/entry.h is assembly-only"
+#endif
+
+#include <asm/asm-offsets.h>
+#include <asm/trap.h>		/* DADAO_STATUS_USER (m14-linux-045) */
+
+/*
+ * Capture the complete register file into @frame (a `struct pt_regs`, 8-byte
+ * aligned) and leave `rb3` pointing at it with `rd2` free.
+ * @cfx is the cfx whose exception vector is running.
+ */
+	.macro	DADAO_GPR_SAVE cfx, frame
+	/*
+	 * `rb3` is rbtp, and the frame needs a base register before the capture
+	 * can run — so the two conflict: repurposing `rb3` used to store the
+	 * *frame address* into `frame.rb[3]` and the faulting context's rbtp was
+	 * lost (measured with the user round trip: the frame's `rb3` came back as
+	 * the frame address, not the caller's value).
+	 *
+	 * `rd2` is reserved (contract-abi §4.5: the compiler never allocates it),
+	 * so it holds the rbtp for the two instructions the store needs; its own
+	 * pre-exception value goes to the cfx's cg6 scratch first, which is what
+	 * the capture below does for it anyway.
+	 */
+	cfx2rc	\cfx, cg6, rc0, rd2		/* scratch[0] = the user's rd2 */
+	rb2rd	rd2, rb3, 1			/* rd2 = rbtp */
+	set.rb	rb3, \frame			/* base: the frame */
+	st.o	rd2, [rb3, PT_RB_BASE + 3 * 8]	/* frame.rb[3] = the real rbtp */
+	cfx2rd	\cfx, cg6, rc0, rd2		/* rd2 back (the capture re-reads it) */
+	DADAO_GPR_SAVE_AT \cfx
+	.endm
+
+	.macro	DADAO_GPR_SAVE_AT cfx
+	cfx2rc	\cfx, cg6, rc0, rd2		/* scratch[0] = rd2 */
+	cfx2rc	\cfx, cg6, rc1, rd3		/* scratch[1] = rd3 */
+
+	/* The two slots with no hardware register behind them; `rb3` (rbtp) was
+	 * already stored by DADAO_GPR_SAVE, before the base was repurposed.
+	 *
+	 * Since m14-linux-046 these two slots *are* the frame's `status` and
+	 * `ip` words (the union layout of asm/ptrace.h): the zero written here
+	 * is the placeholder the stub overwrites with the real values right
+	 * after the capture — `DADAO_SAVE_STATUS` for the mode, and the
+	 * `st.o rd17, [.., PT_IP]` of each stub for the cause ip.  Neither slot
+	 * is ever loaded back into a register (rd0/rb0 are the read-only ones);
+	 * DADAO_GPR_RESTORE stops before them. */
+	st.o	rd0, [rb3, PT_RD_BASE]		/* frame.status = 0 (filled below) */
+	st.o	rd0, [rb3, PT_RB_BASE]		/* frame.ip = 0 (filled by the stub) */
+
+	/* The staging registers and rd1, then the {rd4:rd63} block. */
+	cfx2rd	\cfx, cg6, rc0, rd2		/* the faulting context's rd2 */
+	st.o	rd2, [rb3, PT_RD_BASE + 2 * 8]
+	cfx2rd	\cfx, cg6, rc1, rd3		/* ... and rd3 */
+	st.o	rd3, [rb3, PT_RD_BASE + 3 * 8]
+	st.o	rd1, [rb3, PT_RD_BASE + 1 * 8]
+	set.rd	rd2, PT_RD_BASE + 4 * 8		/* &frame.rd[4] */
+	stm.o	{rd4:rd63}, [rb3, rd2]		/* frame.rd[4..63] */
+
+	set.rd	rd2, PT_RB_BASE + 1 * 8		/* &frame.rb[1] */
+	stm.o	{rb1:rb2}, [rb3, rd2]		/* SP, FP */
+	set.rd	rd2, PT_RB_BASE + 4 * 8		/* &frame.rb[4] */
+	stm.o	{rb4:rb63}, [rb3, rd2]		/* rest of the RB file */
+
+	/* The RA bank: ra0 ({RACNT, MRPTR}) with entries, then the top slot. */
+	set.rd	rd2, PT_RA_BASE			/* &frame.ra[0] */
+	stm.o	{ra0:ra62}, [rb3, rd2]
+	set.rd	rd2, PT_RA_LAST			/* &frame.ra[63] */
+	stm.o	{ra63:ra63}, [rb3, rd2]
+
+	/* The RF bank, rf0 = FCSR first. */
+	set.rd	rd2, PT_RF_BASE			/* &frame.rf[0] */
+	stm.o	{rf0:rf62}, [rb3, rd2]
+	set.rd	rd2, PT_RF_LAST			/* &frame.rf[63] */
+	stm.o	{rf63:rf63}, [rb3, rd2]
+	.endm
+
+/*
+ * Async entry variant: the stub has already staged the interrupted `rd2`,
+ * `rd3` (cg6 rc0/rc1) and `rb3` (cg6 rc2) so it could mask the source before
+ * the register file was touched (ADR-0061 R2 entry window).  Capture the rest
+ * without overwriting those staging slots.
+ */
+	.macro	DADAO_GPR_SAVE_STAGED cfx, frame
+	set.rb	rb3, \frame			/* base: the frame */
+	cfx2rd	\cfx, cg6, rc2, rd2		/* the interrupted rbtp */
+	st.o	rd2, [rb3, PT_RB_BASE + 3 * 8]
+	DADAO_GPR_SAVE_FROM_STAGE \cfx
+	.endm
+
+	.macro	DADAO_GPR_SAVE_FROM_STAGE cfx
+	st.o	rd0, [rb3, PT_RD_BASE]		/* frame.status = 0 */
+	st.o	rd0, [rb3, PT_RB_BASE]		/* frame.ip = 0 */
+	cfx2rd	\cfx, cg6, rc0, rd2
+	st.o	rd2, [rb3, PT_RD_BASE + 2 * 8]
+	cfx2rd	\cfx, cg6, rc1, rd3
+	st.o	rd3, [rb3, PT_RD_BASE + 3 * 8]
+	st.o	rd1, [rb3, PT_RD_BASE + 1 * 8]
+	set.rd	rd2, PT_RD_BASE + 4 * 8
+	stm.o	{rd4:rd63}, [rb3, rd2]
+	set.rd	rd2, PT_RB_BASE + 1 * 8
+	stm.o	{rb1:rb2}, [rb3, rd2]
+	set.rd	rd2, PT_RB_BASE + 4 * 8
+	stm.o	{rb4:rb63}, [rb3, rd2]
+	set.rd	rd2, PT_RA_BASE
+	stm.o	{ra0:ra62}, [rb3, rd2]
+	set.rd	rd2, PT_RA_LAST
+	stm.o	{ra63:ra63}, [rb3, rd2]
+	set.rd	rd2, PT_RF_BASE
+	stm.o	{rf0:rf62}, [rb3, rd2]
+	set.rd	rd2, PT_RF_LAST
+	stm.o	{rf63:rf63}, [rb3, rd2]
+	.endm
+
+/*
+ * Record the exception's pre-entry run mode in the frame (m14-linux-045).
+ *
+ * `@cfx` is the cfx whose cg5 frame the hardware filled (cfx_smon / cfx_umon /
+ * cfx_hart) and `@base` the RB register that points at the frame; `@tag` names
+ * the branch label (one per expansion, the assembler has no local-label form
+ * here).  `cg5 rc0` is `excp_prev_run_mode` (spec/DADAO-12 §3.6): 0 for a
+ * user-mode entry, 2 for a supv one.
+ *
+ * The stored value is `DADAO_STATUS_USER` for user and 0 otherwise — the shape
+ * `user_mode(regs) = (status & 0x3) != 0` reads; why the raw two-bit mode is not
+ * stored is in asm/ptrace.h.  `rd4`/`rd5` are caller-saved and already in the
+ * frame, so clobbering them here costs nothing (the restore puts them back).
+ */
+	.macro	DADAO_SAVE_STATUS cfx, base, tag
+	cfx2rd	\cfx, cg5, rc0, rd4		/* excp_prev_run_mode */
+	set.rd	rd5, DADAO_STATUS_USER
+	br.z	{rd4}?, [rb0, \tag]
+	set.rd	rd5, 0
+\tag:
+	st.o	rd5, [\base, PT_STATUS]
+	.endm
+
+/*
+ * Restore the whole register file from @frame.  The base is re-derived (the C
+ * half may use every reserved register); the base register itself is restored
+ * last, from itself.  The caller emits its `escape` next.
+ */
+	.macro	DADAO_GPR_RESTORE frame
+	set.rb	rb3, \frame
+	DADAO_GPR_RESTORE_AT
+	.endm
+
+/* Same restore with the frame's address already in `rb3` (see above). */
+	.macro	DADAO_GPR_RESTORE_AT
+	set.rd	rd2, PT_RB_BASE + 1 * 8
+	ldm.o	{rb1:rb2}, [rb3, rd2]
+	set.rd	rd2, PT_RB_BASE + 4 * 8
+	ldm.o	{rb4:rb63}, [rb3, rd2]
+	set.rd	rd2, PT_RF_BASE
+	ldm.o	{rf0:rf62}, [rb3, rd2]
+	set.rd	rd2, PT_RF_LAST
+	ldm.o	{rf63:rf63}, [rb3, rd2]
+	set.rd	rd2, PT_RA_BASE
+	ldm.o	{ra0:ra62}, [rb3, rd2]		/* ra0 = {RACNT, MRPTR} */
+	set.rd	rd2, PT_RA_LAST
+	ldm.o	{ra63:ra63}, [rb3, rd2]
+	ld.o	rd1, [rb3, PT_RD_BASE + 1 * 8]
+	set.rd	rd2, PT_RD_BASE + 4 * 8
+	ldm.o	{rd4:rd63}, [rb3, rd2]
+	ld.o	rd2, [rb3, PT_RD_BASE + 2 * 8]
+	ld.o	rd3, [rb3, PT_RD_BASE + 3 * 8]
+	ld.o	rb3, [rb3, PT_RB_BASE + 3 * 8]
+	.endm
+
+/*
+ * Restore everything but the software-return scratch pair.  `rd3` is left
+ * holding the async resume address and `rb3` is *not* restored: the caller
+ * writes it zero and jumps through `[rb3, rd3, 0]`.  Both registers are dead in
+ * a kernel context (`rd3` is ABI-reserved, `rb3` = rbtp is never allocated by
+ * the kernel compiler), which is exactly why they can carry the escape.
+ */
+
+	.macro	DADAO_GPR_RESTORE_AT_KEEP_RD23_RB345
+	set.rd	rd1, PT_RB_BASE + 1 * 8
+	ldm.o	{rb1:rb2}, [rb3, rd1]
+	set.rd	rd1, PT_RB_BASE + 6 * 8
+	ldm.o	{rb6:rb63}, [rb3, rd1]
+	set.rd	rd1, PT_RF_BASE
+	ldm.o	{rf0:rf62}, [rb3, rd1]
+	set.rd	rd1, PT_RF_LAST
+	ldm.o	{rf63:rf63}, [rb3, rd1]
+	set.rd	rd1, PT_RA_BASE
+	ldm.o	{ra0:ra62}, [rb3, rd1]
+	set.rd	rd1, PT_RA_LAST
+	ldm.o	{ra63:ra63}, [rb3, rd1]
+	set.rd	rd1, PT_RD_BASE + 4 * 8
+	ldm.o	{rd4:rd63}, [rb3, rd1]
+	ld.o	rd1, [rb3, PT_RD_BASE + 1 * 8]
+	/* rd2/rd3/rb3/rb4/rb5 are left to the caller. */
+	.endm
+
+	.macro	DADAO_GPR_RESTORE_AT_KEEP_RD3
+	set.rd	rd2, PT_RB_BASE + 1 * 8
+	ldm.o	{rb1:rb2}, [rb3, rd2]
+	set.rd	rd2, PT_RB_BASE + 4 * 8
+	ldm.o	{rb4:rb63}, [rb3, rd2]
+	set.rd	rd2, PT_RF_BASE
+	ldm.o	{rf0:rf62}, [rb3, rd2]
+	set.rd	rd2, PT_RF_LAST
+	ldm.o	{rf63:rf63}, [rb3, rd2]
+	set.rd	rd2, PT_RA_BASE
+	ldm.o	{ra0:ra62}, [rb3, rd2]
+	set.rd	rd2, PT_RA_LAST
+	ldm.o	{ra63:ra63}, [rb3, rd2]
+	ld.o	rd1, [rb3, PT_RD_BASE + 1 * 8]
+	set.rd	rd2, PT_RD_BASE + 4 * 8
+	ldm.o	{rd4:rd63}, [rb3, rd2]
+	ld.o	rd2, [rb3, PT_RD_BASE + 2 * 8]
+	ld.o	rb3, [rb3, PT_RB_BASE + 3 * 8]
+	/* rd3 is left free: the caller's resume target. */
+	.endm
+
+#endif /* __ASM_DADAO_ENTRY_H */
