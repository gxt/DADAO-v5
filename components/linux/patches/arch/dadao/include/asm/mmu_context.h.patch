diff --git a/arch/dadao/include/asm/mmu_context.h b/arch/dadao/include/asm/mmu_context.h
new file mode 100644
index 000000000..7eb662a72
--- /dev/null
+++ b/arch/dadao/include/asm/mmu_context.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_MMU_CONTEXT_H
+#define __ASM_MMU_CONTEXT_H
+
+#include <linux/mm_types.h>
+
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm/ptw.h>
+#include <asm/tlbflush.h>
+
+struct task_struct;
+
+/*
+ * switch_mm() — the four-step sequence of contract-tlb TLB-30
+ * (spec/DADAO-12 §2.2.5 "进程上下文切换"):
+ *
+ *   ① write the new ASID and the new PTBR
+ *   ② *explicitly* invalidate the TLB  (nothing in ① invalidates: TLB-29)
+ *   ③ set ptw_enable = 1
+ *   ④ save/restore the cfx cg6 scratch registers
+ *
+ * The body is mm/mmu.c (it needs the page-table and TLB helpers, and it is the
+ * only place that runs during a switch); this header keeps the interface the
+ * scheduler calls.  A kernel thread (`next == NULL`) keeps the last user ASID:
+ * its own accesses are all G = 1, which match any ASID (contract-tlb TLB-26), so
+ * there is nothing to switch — the lazy-TLB shape.
+ */
+void dadao_switch_mm(struct mm_struct *prev, struct mm_struct *next,
+		     struct task_struct *tsk);
+
+static inline void switch_mm(struct mm_struct *prev, struct mm_struct *next,
+			     struct task_struct *tsk)
+{
+	dadao_switch_mm(prev, next, tsk);
+}
+
+/*
+ * ASID allocation (mm/mmu.c): one monotonic counter over 1..DADAO_ASID_MASK
+ * (0 is the kernel's).  It wraps, and a wrap invalidates the whole TLB before
+ * ASID 1 is handed out again — single hart (contract-tlb TLB-38), so no
+ * cross-hart shootdown is involved.
+ */
+unsigned long dadao_asid_alloc(void);
+
+extern int init_new_context(struct task_struct *tsk, struct mm_struct *mm);
+extern void destroy_context(struct mm_struct *mm);
+/* Tell asm-generic/mmu_context.h not to install its no-op versions. */
+#define init_new_context	init_new_context
+#define destroy_context	destroy_context
+
+static inline void activate_mm(struct mm_struct *prev, struct mm_struct *next)
+{
+	switch_mm(prev, next, current);
+}
+#define activate_mm	activate_mm
+
+/*
+ * dup_mm() -> dup_mmap() -> arch_dup_mmap(): the arch half of a fork's address
+ * space clone.
+ *
+ * Nothing is left for the arch.  The *sharing* (write-protect both PTEs, point
+ * them at the same page, take the second reference) is generic
+ * `copy_page_range()`; the *write* half is generic `do_wp_page()`, reached
+ * through `handle_mm_fault()` (m14-linux-035, mm/fault.c); and the parent's
+ * stale writable translations are dropped by generic `dup_mmap()` itself, which
+ * ends with `flush_tlb_mm(oldmm)` (mm/mmap.c) — the one thing this port cannot
+ * leave implicit (contract-tlb TLB-07/-11: a TLB hit is not re-walked, so a
+ * write-protect that is not followed by an invalidation would let the parent
+ * keep writing through its old entry).
+ *
+ * m14-linux-018's `dadao_dup_mmap_cow()` hook is gone with the port-side COW.
+ */
+#include <asm-generic/mmu_context.h>
+
+/*
+ * The three mm hooks (asm-generic/mm_hooks.h is deliberately *not* included:
+ * this port replaces one of them, and the header defines all three as static
+ * inlines — same shape as arch/arm64's asm/mmu_context.h).
+ */
+static inline int arch_dup_mmap(struct mm_struct *oldmm, struct mm_struct *mm)
+{
+	(void)oldmm;
+	(void)mm;
+	return 0;
+}
+
+static inline void arch_exit_mmap(struct mm_struct *mm)
+{
+}
+
+static inline bool arch_vma_access_permitted(struct vm_area_struct *vma,
+					     bool write, bool execute,
+					     bool foreign)
+{
+	/*
+	 * No MPK/domains on this machine: the page-table bits are the whole
+	 * permission model (spec/DADAO-12 §2.2.5), so there is nothing to add
+	 * here and this hook answers "no extra denial".
+	 *
+	 * The *VMA* half of the model is not generic and must stay in the fault
+	 * entry: DADAO reports a write to a read-only PTE as CFXPERM + NWPERM
+	 * whatever the VMA says, and `handle_mm_fault()` alone would turn a
+	 * genuine violation of a read-only VMA into a copy (->
+	 * `do_wp_page()`/`maybe_mkwrite()` leaves the PTE read-only because the
+	 * VMA is not writable, so the store would fault forever).  mm/fault.c's
+	 * `dadao_pf_vma_perm_denied()` is that gate.
+	 */
+	return true;
+}
+
+#endif
