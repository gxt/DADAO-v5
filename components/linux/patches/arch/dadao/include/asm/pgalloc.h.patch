diff --git a/arch/dadao/include/asm/pgalloc.h b/arch/dadao/include/asm/pgalloc.h
new file mode 100644
index 000000000..41175abe1
--- /dev/null
+++ b/arch/dadao/include/asm/pgalloc.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_PGALLOC_H
+#define __ASM_PGALLOC_H
+
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm-generic/pgalloc.h>
+
+#include <linux/string.h>
+
+#ifndef __ASSEMBLY__
+
+extern pgd_t swapper_pg_dir[PTRS_PER_PGD];
+
+/*
+ * One page table is exactly one 64 KiB page: 8192 entries of 8 bytes
+ * (spec/DADAO-12 §2.2.2).  Page-table allocation/free comes from
+ * asm-generic/pgalloc.h (one page per level); only the "install the L2
+ * table into the L1 entry" step is arch specific.
+ *
+ * A user address space's table still has to reach the kernel: after
+ * `switch_mm()` writes this table into PTBR the kernel keeps executing, and its
+ * own mappings are the upper L1 slots of `swapper_pg_dir`.  Copying those
+ * entries (instead of mapping the kernel lazily on fault) is sound because they
+ * are `G = 1` and identical in every address space — contract-tlb TLB-26 makes
+ * that a requirement of the software, and it is what lets one L2 table be shared
+ * by all of them.
+ */
+static inline pgd_t *pgd_alloc(struct mm_struct *mm)
+{
+	pgd_t *pgd = __pgd_alloc(mm, 0);
+
+	if (!pgd)
+		return NULL;
+	memcpy(pgd + USER_PTRS_PER_PGD, swapper_pg_dir + USER_PTRS_PER_PGD,
+	       (PTRS_PER_PGD - USER_PTRS_PER_PGD) * sizeof(pgd_t));
+	return pgd;
+}
+
+/*
+ * The L1 entry that points at an L2 table (spec/DADAO-12 §2.2.3):
+ *
+ *   P = 1, SP = 0, PPN = PA[55:16]
+ *
+ * `table` is the *kernel virtual* address the kernel uses to fill the table;
+ * the hardware walks physical addresses, so the entry must carry `__pa(table)`.
+ * Writing the virtual address instead is off by PAGE_OFFSET (2 TiB) and points
+ * the walker at memory that does not exist — the reason this helper exists as
+ * the single place the conversion happens.
+ *
+ * Non-leaf entries use only P and SP: G and SPF are meaningless there and
+ * software writes 0 (contract-tlb TLB-27, §2.2.3).  S is set like on the leaf
+ * mappings (the kernel runs in supv); the walker does not check HSJU on a
+ * non-leaf entry, so this is documentation rather than a permission.
+ */
+static inline unsigned long __dadao_l1_entry(void *table)
+{
+	return __pa(table) | _PAGE_PRESENT | _PAGE_S;
+}
+
+static inline void pmd_populate(struct mm_struct *mm, pmd_t *pmd,
+				pgtable_t pte)
+{
+	set_pmd(pmd, __pmd(__dadao_l1_entry(page_to_virt(pte))));
+}
+
+static inline void pmd_populate_kernel(struct mm_struct *mm, pmd_t *pmd,
+				       pte_t *pte)
+{
+	set_pmd(pmd, __pmd(__dadao_l1_entry(pte)));
+}
+
+#define __pte_free_tlb(tlb, pte, addr)	pte_free((tlb)->mm, (pte))
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_PGALLOC_H */
