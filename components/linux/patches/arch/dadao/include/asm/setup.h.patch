diff --git a/arch/dadao/include/asm/setup.h b/arch/dadao/include/asm/setup.h
new file mode 100644
index 000000000..330dbd654
--- /dev/null
+++ b/arch/dadao/include/asm/setup.h
@@ -0,0 +1,262 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_SETUP_H
+#define __ASM_SETUP_H
+
+#include <uapi/asm/setup.h>
+
+#define COMMAND_LINE_SIZE	1024
+
+#ifndef __ASSEMBLY__
+/* Fixed boot info block (contract-linux-boot §4). */
+struct dadao_boot_info {
+	u32	magic;
+	u16	version;
+	u16	size;
+	u64	ram_base;
+	u64	ram_size;
+	u64	kernel_base;
+	u64	kernel_size;
+	u64	initramfs_base;
+	u64	initramfs_size;
+	u64	cmdline_base;
+	u64	cmdline_size;
+	u64	ptbr;
+	u32	page_size_log2;
+	u32	hart_id;
+	u64	flags;
+} __aligned(8);
+
+#define DADAO_BOOT_MAGIC	0x4442494e	/* "DBIN" */
+#define DADAO_BOOT_VERSION	1
+#define DADAO_BOOT_SIZE		0x60
+
+/* Boot hooks called by the generic init/main.c sequence. */
+void trap_init(void);
+void init_IRQ(void);
+void time_init(void);
+
+/* Memory init, called from setup_arch() after memblock_add(). */
+void paging_init(void);
+
+/* Kernel entry: head.S jumps here after validating magic/version/size. */
+void __noreturn dadao_start_kernel(void);
+/* Switch to @sp and enter @fn (head.S): leaves the static early stack. */
+void __noreturn dadao_jump_on_stack(void *sp, void (*fn)(void));
+
+/* Named boot-info rejection: prints and stops with a fixed semihosting code. */
+void __noreturn dadao_bootinfo_reject(unsigned int code, const char *what);
+
+/*
+ * K1 stop hook, called from the first statement of start_kernel() in
+ * init/main.c (CONFIG_DADAO_K1_EARLY_STOP): print the handoff and exit
+ * before any subsystem, clock or interrupt is initialised.
+ */
+void dadao_k1_early_stop(void);
+
+/*
+ * K2 boundary, called from the end of setup_arch() (CONFIG_DADAO_K2_EARLY_STOP):
+ * report the supv exception channel, run the optional K2 self-test and exit
+ * before anything that would need a clock.
+ */
+void dadao_k2_boundary(void);
+/* K2 self-test scaffolding (kernel/k2_selftest.c, probe images only). */
+void dadao_k2_selftest(void);
+
+/* Idempotent; `__init` because it must run once, from the boot path, after the
+ * buddy allocator exists (mm_core_init()): it allocates the shared zero page. */
+void __init dadao_pf_init(void);
+/* The VMA covering @addr, as the channel looks it up (`current->mm`'s tree);
+ * NULL when the task has no address space.  The K4 probes assert the mapping
+ * they built with it instead of taking a fault for every edge. */
+struct vm_area_struct *dadao_pf_find_vma(unsigned long addr);
+/* One zeroed page from the channel's page pool (same source the handler uses). */
+unsigned long dadao_pf_alloc_page(void);
+/* Counters every handler entry reports; the probe asserts their deltas. */
+unsigned long dadao_pf_entry_count(void);
+unsigned long dadao_pf_alloc_count(void);
+unsigned long dadao_pf_zero_page_pa(void);
+/* Stack-growth counter (VM_GROWSDOWN, m14-linux-019): how many times a fault
+ * below a growable VMA actually extended it. */
+unsigned long dadao_pf_grow_count(void);
+/* The result name of the last fault's reading (`die-perm`, `fill-zero`, …);
+ * m14-linux-027's S1 case asserts which reading produced the SIGSEGV. */
+const char *dadao_pf_last_result(void);
+
+/*
+ * K4 (m14-linux-016): the user-mode entry rows and the boundary the process
+ * model is exercised at.
+ */
+/* Writes the cfx_umon cg0/cg2 entry registers (contract-syscall §8). */
+void __init dadao_user_entry_install(void);
+/* Enter user mode at @regs (never returns). */
+void __noreturn dadao_enter_user(struct pt_regs *regs);
+/* Loads the static frame and `trap cfx_umon` (kernel/trap.S). */
+void __noreturn dadao_umon_enter(void);
+/*
+ * The return-to-user tail of the umon entry (m14-linux-045,
+ * kernel/entry_common.c): the C half of the stub, which runs the dispatch and
+ * then consumes `_TIF_WORK_MASK` on the way back to user mode.  `..._dispatch()`
+ * is the half that only decides what the trap was (kernel/process.c).
+ */
+unsigned long dadao_user_excp_handler(struct pt_regs *regs, unsigned long cause,
+				      unsigned long info);
+unsigned long dadao_user_excp_dispatch(struct pt_regs *regs, unsigned long cause,
+				       unsigned long info);
+/* The syscall-entry half of the same loop (kernel/entry_common.c). */
+void dadao_syscall_enter(struct pt_regs *regs);
+/*
+ * The arch half of signal delivery (kernel/signal.c, m14-linux-046): build the
+ * `rt_sigframe` and rewind the frame onto the handler.  Called by
+ * `arch_do_signal_or_restart()` once `get_signal()` picked a signal to handle.
+ */
+struct ksignal;
+void dadao_handle_signal(struct ksignal *ksig, struct pt_regs *regs);
+/* The umon entry's two frame helpers (kernel/process.c, called from trap.S):
+ * adopt the staged frame into the task's own `task_pt_regs()` slot, and
+ * re-derive it after the C half (which may sleep). */
+struct pt_regs *dadao_umon_adopt(void);
+/* The asynchronous entry's adopt (kernel/process.c, called from async_trap.S). */
+struct pt_regs *dadao_async_adopt(void);
+struct pt_regs *dadao_umon_frame(void);
+/* A task's first instruction after a context switch (kernel/process.c). */
+void __noreturn dadao_ret_from_fork(void);
+
+/*
+ * The umon entry's trap dispatch (m14-linux-023, kernel/syscalls.c + trap.S).
+ *
+ * `dadao_user_syscall()` decides what a `trap cfx_umon, immu18` means and
+ * returns the `sys_call_table` entry the entry stub has to call, or 0 when the
+ * answer is already in the frame's `rd8` (contract-syscall §2/§3/§9).
+ * `dadao_call_syscall()` is that call: it reloads the ABI's parameter registers
+ * from the frame and invokes the entry.  `dadao_user_syscall_post()` runs
+ * afterwards (internal restart codes, TIF hooks) and returns the stub's resume
+ * policy.
+ */
+unsigned long dadao_user_syscall(struct pt_regs *regs, unsigned long immu18);
+long dadao_call_syscall(struct pt_regs *regs, void *fn);
+unsigned long dadao_user_syscall_post(struct pt_regs *regs);
+
+#if defined(CONFIG_DADAO_K5_PAGESZ_SELFTEST)
+/* The user 64 KiB ABI probe image (kernel/k5_pagesz_selftest.c): runs from a
+ * late_initcall and ends the boot. */
+void __noreturn dadao_k5p_pagesz_selftest(void);
+/* The MAX_PAGE_ORDER-aligned RAM chunk setup_arch() kept out of the buddy
+ * allocator for that probe, 0 when there was none. */
+extern unsigned long dadao_pagesz_reserved_base;
+#endif
+
+#if defined(CONFIG_DADAO_K5_SYSCALL_SELFTEST)
+/* The syscall-probe image: runs from a late_initcall and ends the boot. */
+void __noreturn dadao_k5_syscall_selftest(void);
+/* Its view of every umon trap of the probe's user program.  Returns 1 when the
+ * probe claims the trap (its reporting trap), 0 to let the dispatcher run. */
+int dadao_k5_user_trap(struct pt_regs *regs, unsigned long immu18,
+		       unsigned long *policy);
+#endif
+
+#if defined(CONFIG_DADAO_K5_FUTEX_SELFTEST)
+/* The futex/atomic probe image: runs from a late_initcall and ends the boot. */
+void __noreturn dadao_k5_futex_selftest(void);
+/* Its view of every umon trap of the probe's user program and its threads.
+ * Returns 1 when the probe claims the trap, 0 to let the dispatcher run; it may
+ * block (the parent's hand-over traps park here), which is why the dispatcher
+ * calls it with the re-entrancy guard dropped. */
+int dadao_k5f_user_trap(struct pt_regs *regs, unsigned long immu18,
+			unsigned long *policy);
+#endif
+
+#if defined(CONFIG_DADAO_K5_CLONE_SELFTEST)
+/* The clone/thread probe image: runs from a late_initcall and ends the boot. */
+void __noreturn dadao_k5_clone_selftest(void);
+/* Its view of every umon trap of the probe's user tasks (parent and children).
+ * Returns 1 when the probe claims the trap, 0 to let the dispatcher run; it may
+ * block (the parent's "wait for my children" traps park here), which is why the
+ * dispatcher calls it with the re-entrancy guard dropped. */
+int dadao_k5c_user_trap(struct pt_regs *regs, unsigned long immu18,
+			unsigned long *policy);
+#endif
+/*
+ * Guest FAIL check points of the K4 user-mode entry (spec/Kaiwu §7.1 guest
+ * segment).  They live here because two files share them: the entry's
+ * installer/handler (kernel/process.c) and the probe that judges it
+ * (kernel/k4_selftest.c).
+ */
+#define K4_FAIL_UMON_NO_ZERO	0x30	/* user excp vector reads back 0 / frame */
+#define K4_FAIL_UMON_SWITCH	0x31	/* a run-mode row does not hold its value */
+#define K4_FAIL_UMON_RECURSE	0x32	/* a second umon entry while one is live */
+
+/*
+ * Probe image only: the user-mode syscall hook.  Each K4 probe image owns
+ * exactly one of them (kernel/k4_selftest.c for the process model,
+ * kernel/k4_switch_selftest.c for the context switch + the init run); the two
+ * configs are mutually exclusive in Kconfig.
+ */
+#if defined(CONFIG_DADAO_K4_SELFTEST) || defined(CONFIG_DADAO_K4_SWITCH_SELFTEST)
+int dadao_k4_user_syscall(struct pt_regs *regs, unsigned long nr,
+			  unsigned long *policy);
+#endif
+
+/*
+ * The K4 boundary: page-fault page source + the probe self-tests.
+ *
+ * It returns only for an image that is meant to keep going (the context-switch
+ * probe: the init run lives beyond `rest_init()`); every milestone image and
+ * the process-model probe end the boot here, by name.
+ */
+void __init dadao_k4_boundary(void);
+void __init dadao_k4_selftest(void);
+/* The user-stack growth probe image (CONFIG_DADAO_K4_STACK_SELFTEST: 1, 3, 4
+ * or 6 = one case per image; every case ends the boot). */
+void __noreturn dadao_k4_stack_selftest(void);
+/* The copy-on-write probe image (CONFIG_DADAO_K4_COW_SELFTEST: 1 or 3 = one
+ * case per image; every case ends the boot). */
+void __noreturn dadao_k4_cow_selftest(void);
+/* The context-switch probe image (CONFIG_DADAO_K4_SWITCH_SELFTEST). */
+void __init dadao_k4_switch_selftest(void);
+/* The kernel-thread probe image (CONFIG_DADAO_K4_KTHREAD_SELFTEST): runs
+ * inside kernel_init once kthreadd exists, and ends the boot. */
+void dadao_k4_kthread_selftest(void);
+
+/* Early console: semihosting SYS_WRITE0 / SYS_EXIT (contract-semihosting). */
+void dadao_early_write(const char *s);
+/* Frame-safe diagnostics (m14-linux-017): record numbers in a frame, print
+ * them from a frame-free context. */
+extern int dadao_in_frame;
+extern unsigned long dadao_flog_last[4];
+void dadao_flog_report(void);
+/* One byte at an explicit PA (the responder reads guest memory by PA). */
+void dadao_early_write_pa(unsigned long pa);
+void dadao_early_printf(const char *fmt, ...);
+void __noreturn dadao_early_exit(unsigned long code);
+
+/*
+ * K2 supv exception entry (kernel/trap.S): the kernel owns the vector from the
+ * moment it owns the page table (spec/DADAO-12 §5.2 step 7 gives no recovery
+ * for an unmapped vector page).
+ */
+void dadao_supv_vector_install(void);
+/* The vector entry point and the static frame it captures (kernel/trap.S). */
+extern char dadao_supv_excp[];
+extern char dadao_excp_save[];
+/* The C half of the entry: returns DADAO_TRAP_RESUME_{RETRY,SKIP}. */
+unsigned long dadao_trap_handler(struct pt_regs *regs, unsigned long cause,
+				 unsigned long info);
+/* Undefined resume policy: the stub names it instead of picking an offset. */
+void __noreturn dadao_trap_bad_policy(void);
+/* Print the dispatch table the handler really matches on (K2 gate reads it). */
+void dadao_cause_report(void);
+
+/* §5 entry state saved by head.S before it is used or overwritten. */
+extern unsigned long dadao_entry_va;		/* rb16: entry VA */
+extern unsigned long dadao_bootinfo_va;		/* rb17: boot info VA */
+
+/* Early stack head.S builds in .bss before the first push (K1: SP source). */
+extern char early_stack[];
+extern char early_stack_top[];
+
+/* RAM window in PA, filled from the boot info block by setup_arch(). */
+extern unsigned long dadao_ram_base;
+extern unsigned long dadao_ram_size;
+#endif
+
+#endif
