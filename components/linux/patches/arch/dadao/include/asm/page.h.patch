diff --git a/arch/dadao/include/asm/page.h b/arch/dadao/include/asm/page.h
new file mode 100644
index 000000000..d402bd99a
--- /dev/null
+++ b/arch/dadao/include/asm/page.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_PAGE_H
+#define __ASM_PAGE_H
+
+#include <linux/const.h>
+#include <vdso/page.h>
+
+/*
+ * Kernel VA window [2 TiB, 3 TiB); inside it VA = PA + 2 TiB
+ * (spec/Kaiwu §6.3, contract-linux-boot).
+ */
+#define PAGE_OFFSET		CONFIG_PAGE_OFFSET
+#define __pa(x)			((unsigned long)(x) - PAGE_OFFSET)
+#define __va(x)			((void *)((unsigned long)(x) + PAGE_OFFSET))
+
+#define __pa_symbol(x)		__pa(x)
+
+#define pfn_to_kaddr(pfn)	__va((pfn) << PAGE_SHIFT)
+#define virt_to_pfn(kaddr)	(__pa(kaddr) >> PAGE_SHIFT)
+#define pfn_to_virt(pfn)	__va((pfn) << PAGE_SHIFT)
+
+#define virt_to_page(kaddr)	pfn_to_page(virt_to_pfn(kaddr))
+#define page_to_virt(page)	pfn_to_virt(page_to_pfn(page))
+
+#define ARCH_PFN_OFFSET		0
+#define virt_addr_valid(kaddr)	((unsigned long)(kaddr) >= PAGE_OFFSET)
+
+/* User VA space is [0, 2 TiB): the kernel window starts where it ends. */
+#define TASK_SIZE		(_AC(1, UL) << 41)
+#define TASK_SIZE_MAX		TASK_SIZE
+
+#ifdef __KERNEL__
+#ifndef __ASSEMBLY__
+
+/*
+ * The page-table value types live here (not in pgtable.h) because
+ * <linux/mm_types.h> pulls them in through <asm/mmu.h> before pgtable.h.
+ */
+typedef struct { unsigned long pte; } pte_t;
+typedef struct { unsigned long pgd; } pgd_t;
+typedef struct { unsigned long pgprot; } pgprot_t;
+typedef struct page *pgtable_t;
+
+#define pte_val(x)	((x).pte)
+#define pgd_val(x)	((x).pgd)
+#define pgprot_val(x)	((x).pgprot)
+
+#define __pte(x)	((pte_t) { (x) })
+#define __pgd(x)	((pgd_t) { (x) })
+#define __pgprot(x)	((pgprot_t) { (x) })
+
+#include <asm-generic/memory_model.h>
+#include <asm-generic/getorder.h>
+
+/*
+ * K0 clears/copies pages with the generic C routines.  The C versions keep
+ * the arch headers free of assembly and are replaced by optimised versions
+ * once the port runs (K1+).
+ */
+#define clear_page(page)	memset((page), 0, PAGE_SIZE)
+#define copy_page(to, from)	memcpy((to), (from), PAGE_SIZE)
+#define copy_user_page(to, from, vaddr, pg)	copy_page(to, from)
+/* No cache aliasing: user and kernel page copies are plain copies. */
+#define copy_to_user_page(vma, page, vaddr, dst, src, len)		\
+	memcpy(dst, src, len)
+#define copy_from_user_page(vma, page, vaddr, dst, src, len)		\
+	memcpy(dst, src, len)
+
+#define __HAVE_ARCH_COPY_USER_HIGHPAGE
+#define copy_user_highpage(to, from, vaddr, vma)			\
+	copy_user_page(to, from, vaddr, vma)
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __KERNEL__ */
+
+#endif /* __ASM_PAGE_H */
