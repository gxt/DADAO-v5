diff --git a/arch/dadao/include/asm/thread_info.h b/arch/dadao/include/asm/thread_info.h
new file mode 100644
index 000000000..33cc33c2d
--- /dev/null
+++ b/arch/dadao/include/asm/thread_info.h
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_THREAD_INFO_H
+#define __ASM_THREAD_INFO_H
+
+#ifdef __KERNEL__
+
+#include <asm/page.h>
+
+#define THREAD_SIZE_ORDER	0
+#define THREAD_SIZE		(PAGE_SIZE << THREAD_SIZE_ORDER)
+#define THREAD_SHIFT		PAGE_SHIFT
+
+#ifndef __ASSEMBLY__
+
+struct task_struct;
+
+struct thread_info {
+	unsigned long		flags;
+	unsigned long		syscall_work;
+	u32			status;
+	int			preempt_count;
+	struct task_struct	*task;
+};
+
+#define INIT_THREAD_INFO(tsk)				\
+{							\
+	.flags		= 0,				\
+	.preempt_count	= INIT_PREEMPT_COUNT,		\
+	.task		= &tsk,				\
+}
+
+static inline unsigned long dadao_stack_pointer(void)
+{
+	unsigned long sp;
+
+	/* SP is rb1 on DADAO (DADAO-21 §参数寄存器). */
+	__asm__ __volatile__("rb2rd {%0}, {rb1}" : "=r"(sp));
+	return sp;
+}
+
+static inline struct thread_info *current_thread_info(void)
+{
+	return (struct thread_info *)(dadao_stack_pointer() &
+				      ~(THREAD_SIZE - 1));
+}
+
+#define TIF_SIGPENDING		0
+#define TIF_NEED_RESCHED	1
+#define TIF_NOTIFY_RESUME	2
+#define TIF_NOTIFY_SIGNAL	3
+#define TIF_RESTORE_SIGMASK	4
+#define TIF_MEMDIE		5
+#define TIF_PATCH_PENDING	6
+#define TIF_UPROBE		7
+#define TIF_RSEQ		8
+#define TIF_USER_RETURN_NOTIFY	9
+#define TIF_HRTIMER_REARM	10
+#define TIF_NOHZ		11
+#define TIF_POLLING_NRFLAG	12
+#define TIF_SYSCALL_TRACE	13
+#define TIF_SYSCALL_AUDIT	14
+#define TIF_SECCOMP		15
+#define TIF_SYSCALL_EMU		16
+
+#define _TIF_SIGPENDING		(1 << TIF_SIGPENDING)
+#define _TIF_NEED_RESCHED	(1 << TIF_NEED_RESCHED)
+#define _TIF_NOTIFY_RESUME	(1 << TIF_NOTIFY_RESUME)
+#define _TIF_NOTIFY_SIGNAL	(1 << TIF_NOTIFY_SIGNAL)
+#define _TIF_RESTORE_SIGMASK	(1 << TIF_RESTORE_SIGMASK)
+#define _TIF_MEMDIE		(1 << TIF_MEMDIE)
+#define _TIF_PATCH_PENDING	(1 << TIF_PATCH_PENDING)
+#define _TIF_UPROBE		(1 << TIF_UPROBE)
+#define _TIF_RSEQ		(1 << TIF_RSEQ)
+#define _TIF_USER_RETURN_NOTIFY	(1 << TIF_USER_RETURN_NOTIFY)
+#define _TIF_HRTIMER_REARM	(1 << TIF_HRTIMER_REARM)
+#define _TIF_NOHZ		(1 << TIF_NOHZ)
+#define _TIF_POLLING_NRFLAG	(1 << TIF_POLLING_NRFLAG)
+#define _TIF_SYSCALL_TRACE	(1 << TIF_SYSCALL_TRACE)
+#define _TIF_SYSCALL_AUDIT	(1 << TIF_SYSCALL_AUDIT)
+#define _TIF_SECCOMP		(1 << TIF_SECCOMP)
+#define _TIF_SYSCALL_EMU	(1 << TIF_SYSCALL_EMU)
+
+#define _TIF_WORK_SYSCALL_ENTRY	\
+	(_TIF_SYSCALL_TRACE | _TIF_SYSCALL_AUDIT | _TIF_SECCOMP | _TIF_SYSCALL_EMU)
+#define _TIF_WORK_MASK		\
+	(_TIF_NEED_RESCHED | _TIF_SIGPENDING | _TIF_NOTIFY_RESUME | \
+	 _TIF_NOTIFY_SIGNAL | _TIF_RESTORE_SIGMASK | _TIF_UPROBE)
+#define _TIF_SYSCALL_WORK	\
+	(_TIF_SYSCALL_TRACE | _TIF_SYSCALL_AUDIT | _TIF_SECCOMP | \
+	 _TIF_SYSCALL_EMU | _TIF_NOTIFY_RESUME | _TIF_NOTIFY_SIGNAL)
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __KERNEL__ */
+#endif /* __ASM_THREAD_INFO_H */
