+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_MMU_H
+#define __ASM_MMU_H
+
+/* mm_types.h pulls the page-table types through <asm/mmu.h>. */
+#include <asm/pgtable.h>
+
+#ifndef __ASSEMBLY__
+/*
+ * Per-address-space context.  `asid` is the 16-bit cfx_ptw ASID a G = 0
+ * mapping of this mm is tagged with (spec/DADAO-12 §4.5); the kernel itself
+ * runs as ASID 0 and its mappings are G = 1, so an mm never carries 0.
+ * Allocation/return lives in asm/mmu_context.h + mm/mmu.c.
+ */
+typedef struct {
+	unsigned long asid;
+} mm_context_t;
+#endif
+
+#endif
