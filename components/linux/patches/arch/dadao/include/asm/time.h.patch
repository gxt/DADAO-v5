index 000000000..ecd4532cc
--- /dev/null
+++ b/arch/dadao/include/asm/time.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO time base and single-hart timer.
+ *
+ * contract-see §3 freezes the register semantics (1 GHz, 1 count = 1 ns;
+ * `cfx_hart` one-shot absolute compare); §6.5 only adds the *kernel-side*
+ * gaps.  This header is the kernel's three-way split of that surface:
+ *
+ *   read     `dadao_time_freq()` / `dadao_read_time()`        (`cfx_time`)
+ *   program  `dadao_timer_arm()` / `dadao_timer_stop()`       (`cfx_hart` cg16)
+ *   confirm  `dadao_timer_pending()`                          (`cfx_hart` cg16 rc17)
+ *
+ * K5 (m14-linux-026) puts the generic time subsystem on top of it: the
+ * `clocksource`/`clockevent` pair below is what `time_init()` registers, and
+ * the asynchronous entry still calls `dadao_timer_interrupt()` — only what
+ * that function does changed (it forwards the delivery to the registered
+ * device instead of accounting by hand).
+ */
+#ifndef __ASM_DADAO_TIME_H
+#define __ASM_DADAO_TIME_H
+
+#ifndef __ASSEMBLY__
+
+#include <asm/cfx.h>
+
+/* cfx_time (cfxha 34) — spec/DADAO-12 §4.10, contract-see §3. */
+#define CFX_TIME_CG_FREQ		10
+#define CFX_TIME_RC_FREQ		0
+#define CFX_TIME_RC_VALUE		1
+
+/* cfx_hart (cfxha 15) — spec/DADAO-12 §4.7, contract-see §3. */
+#define CFX_HART_CG_TIMER		16	/* cg16: timer ctrl/cmp + source face */
+#define CFX_HART_RC_TIMER_CTRL		0	/* bit0 ENABLE only */
+#define CFX_HART_RC_TIMER_CMP		1
+
+/* The per-source interrupt face every source implements (ADR-0064 D1). */
+#define DADAO_SRC_CG			16
+#define DADAO_SRC_RC_MASK		16	/* 1 = mask, reset all ones */
+#define DADAO_SRC_RC_PENDING		17	/* RO, event sets, ack clears */
+#define DADAO_SRC_RC_ACK		18	/* W1C */
+
+#define DADAO_TIMER_ENABLE		(1UL << 0)
+#define DADAO_SRC_EVENT_BIT0		(1UL << 0)
+
+/* The asynchronous cause cfx_hart raises when the compare matches (§4.7). */
+#define DADAO_CAUSE_TIMER		(1UL << 10)
+
+/* `cfx_time`: frequency in Hz and the free-running 64-bit count. */
+unsigned long dadao_time_freq(void);
+unsigned long dadao_read_time(void);
+
+/* Program the one-shot deadline @delta_counts from now, IMASK open. */
+void dadao_timer_arm(unsigned long delta_counts);
+/* Cancel the deadline and ack a stale pending event. */
+void dadao_timer_stop(void);
+/* `cfx_hart cg16 rc17`: bit0 = the armed deadline expired. */
+unsigned long dadao_timer_pending(void);
+/* W1C the timer source's pending bits (ADR-0064: handler acks explicitly). */
+void dadao_timer_ack(unsigned long bits);
+
+/*
+ * One delivered `TIMER`: account the tick (jiffies) and re-arm.  Single point
+ * by design — K4 swaps what is inside, not who calls it.
+ */
+void dadao_timer_interrupt(void);
+
+/*
+ * The kernel's clock source and clock event device (m14-linux-026).
+ *
+ * `dadao_clocksource` reads `cfx_time` (1 count = 1 ns, contract-see §3) and
+ * drives `timekeeping`/`sched_clock`; `dadao_clock_event_device` programs
+ * `cfx_hart`'s absolute `timer_cmp` and is driven by the generic tick.  Both
+ * are registered by `time_init()`; the probe (kernel/k5_clock_selftest.c)
+ * reads them back, so they are not static.
+ */
+struct clocksource;
+struct clock_event_device;
+extern struct clocksource dadao_clocksource;
+extern struct clock_event_device dadao_clock_event_device;
+
+/*
+ * Start/stop the tick.  After registration these go through the clock event
+ * device's state machine; K2-boundary images (CONFIG_DADAO_K2_TIME_STOP) keep
+ * the raw compare-register arm, because `time_init()` runs there before the
+ * generic tick core exists.
+ */
+void dadao_clockevent_start(void);
+void dadao_clockevent_stop(void);
+/* Delivered ticks since reset (the counter the probe reads back). */
+unsigned long dadao_tick_count(void);
+
+/* The K2 tick target: printed by time_init(), parsed by tools/linux/k2_time_probe.py. */
+#define DADAO_K2_TIME_TICKS		3
+
+/* The K5 clock gate's consecutive-tick target (kernel/k5_clock_selftest.c). */
+#define DADAO_K5_CLOCK_TICKS		4
+
+/* Named boot verdicts (guest segment, spec/Kaiwu §7.1). */
+void __noreturn dadao_k2_fail(unsigned int checkpoint, const char *what);
+
+/*
+ * The K2 time boundary (CONFIG_DADAO_K2_TIME_STOP), called from the end of
+ * setup_arch(): time base -> asynchronous vector -> two mask axes -> ticks.
+ */
+void __noreturn dadao_k2_time_boundary(void);
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_DADAO_TIME_H */
