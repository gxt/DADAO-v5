index 000000000..1a02a4295
--- /dev/null
+++ b/arch/dadao/include/asm/ptrace.h
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_PTRACE_H
+#define __ASM_PTRACE_H
+
+#include <linux/stddef.h>
+
+#include <uapi/asm/ptrace.h>
+#include <asm/trap.h>
+
+#ifndef __ASSEMBLY__
+
+/*
+ * The complete saved context of a supv exception — synchronous (kernel/trap.S)
+ * or asynchronous (kernel/async_trap.S) — and the unit the signal frame
+ * carries (kernel/signal.c, m14-linux-046).
+ *
+ * spec/DADAO-12 §3.6: the hardware saves *no* general register, only the cg5
+ * frame fields, so the kernel entry saves the register file itself
+ * (contract-syscall §8).  The frame mirrors the file one slot per register, all
+ * four banks (§2.1/§2.4 of spec/SimRISC-00), **2048 bytes** in total (user
+ * ruling 2026-11-20):
+ *
+ *   rd[0..63]  rd[0] is **not** a register (`ld` to rd0 is ILLI) but the
+ *              software container for the frame's `status` word; rd[1..63] are
+ *              the real registers;
+ *   rb[0..63]  rb[0] is the read-only IP mirror: the hardware's `rb0` *is* the
+ *              IP, so the slot holds `ip`; rb[1..63] are the real registers;
+ *   ra[0..63]  the return-address stack, *including* ra0 — the {RACNT, MRPTR}
+ *              metadata word (spec/SimRISC-00 §2.4) — so that a round trip
+ *              through this frame leaves `ra0-ra63` bit-identical
+ *              (§2.4: "异常进入和退出不改变 ra0–ra63 的内容");
+ *   rf[0..63]  rf0 is the FCSR and is saved/restored as a whole; its write port
+ *              masks the non-writable fields (§2.3), so a value read back out
+ *              of this frame is the architectural one, not the raw input.
+ *
+ * Why the two fields ride in the banks (user ruling 2026-11-20): the frame is
+ * exactly four 64-slot banks, 2048 B, and the two words that have no register
+ * behind them take the two slots that have no register behind them.  The
+ * anonymous unions let C keep reading `regs->rd[i]`/`regs->rb[i]` — and
+ * `status`/`ip` — while `asm-offsets.c` derives `PT_IP`/`PT_STATUS` from the
+ * same members, so no assembly offset (and no C array reference) had to change:
+ * `rb` stays at 512, `ra` at 1024, `rf` at 1536, `PT_IP == 512 == PT_RB_BASE`,
+ * `PT_STATUS == 0 == PT_RD_BASE`.
+ *
+ * Neither slot is ever *loaded back into a register*: `DADAO_GPR_RESTORE`
+ * (asm/entry.h) writes rb1/rb2, rb4-rb63, rb3, rd1, rd4-rd63, rd2 and rd3 and
+ * stops there — writing `rd0`/`rb0` would be `ILLI` (they are the read-only
+ * ones).  So the two words are pure software state inside the frame.
+ *
+ * `ip` is `excp_cause_ip` (spec/DADAO-12 §3.6, the entry record's `cg5 rc2`)
+ * and is the software copy.  Since m14-linux-046 it is the frame's **resume
+ * address**: the umon entry writes `ip` (or `ip + 4` for a skip) into the exit
+ * intent `cg5 rc10` before the escape (kernel/process.c), so signal delivery
+ * can save one address.
+ *
+ * `status` carries no hardware state — there is no status register and no IE
+ * bit (contract-abi, contract-see §6.4).  Since m14-linux-045 it is the
+ * **software container for the exception's pre-entry run mode** (low 4 bits,
+ * user ruling 2026-11-20 in `discussing.md` N30): every entry stub writes it
+ * with `DADAO_SAVE_STATUS` (asm/entry.h), so `user_mode()` reads it from here
+ * instead of guessing.  It describes the context the frame came *from*; `escape`
+ * restores the same fact from the hardware (`excp_prev_run_mode`), so nothing
+ * has to write it back.
+ */
+struct pt_regs {
+	union {
+		unsigned long rd[64];
+		struct {
+			unsigned long status;
+			unsigned long rd_rest[63];
+		};
+	};
+	union {
+		unsigned long rb[64];
+		struct {
+			unsigned long ip;
+			unsigned long rb_rest[63];
+		};
+	};
+	unsigned long ra[64];
+	unsigned long rf[64];
+};
+
+/*
+ * The layout is pinned here once: every offset the assembly uses comes from
+ * asm-offsets (PT_* macros, derived from these very fields), so a mismatch
+ * between this struct and the stubs' expectations has to fail the build rather
+ * than corrupt a context at run time.  The numbers are the user ruling's:
+ * 2048 B, `rb` at 512, `ra` at 1024, `rf` at 1536 — and every offset the stubs
+ * reach with `st.o`'s immediate stays inside `imms12`'s 2048-byte window
+ * (spec/SimRISC-01 §1), which is why `status`/`ip` own slot 0 of their banks.
+ */
+_Static_assert(sizeof(struct pt_regs) == 4 * 64 * sizeof(unsigned long),
+	       "pt_regs: four 64-slot banks, 2048 bytes");
+_Static_assert(offsetof(struct pt_regs, status) == 0 &&
+		       offsetof(struct pt_regs, rd) == 0,
+	       "pt_regs: rd[0] is the status word");
+_Static_assert(offsetof(struct pt_regs, ip) == 512 &&
+		       offsetof(struct pt_regs, rb) == 512,
+	       "pt_regs: rb[0] is the ip word");
+_Static_assert(offsetof(struct pt_regs, ra) == 1024,
+	       "pt_regs: ra bank at 1024");
+_Static_assert(offsetof(struct pt_regs, rf) == 1536,
+	       "pt_regs: rf bank at 1536");
+_Static_assert(sizeof(((struct pt_regs *)0)->ra) == 64 * sizeof(unsigned long),
+	       "pt_regs: ra holds all 64 return-address slots");
+_Static_assert(sizeof(((struct pt_regs *)0)->rf) == 64 * sizeof(unsigned long),
+	       "pt_regs: rf holds all 64 floating-point slots");
+_Static_assert(offsetof(struct pt_regs, ra) % 8 == 0 &&
+		       offsetof(struct pt_regs, rf) % 8 == 0,
+	       "pt_regs: block-transferred banks must be 8-byte aligned");
+
+/*
+ * Mode of the context this frame was taken from (m14-linux-045).
+ *
+ * `status` low 4 bits are written by the entry stubs from the hardware's
+ * `excp_prev_run_mode` (`DADAO_SAVE_STATUS`, asm/entry.h); the verdict uses the
+ * user ruling's criterion `(status & 0x3) != 0` (2026-11-20, `discussing.md`
+ * N30).
+ *
+ * Encoding, and why it is not the raw two-bit mode: `spec/DADAO-12 §1` encodes
+ * run modes as 0b00 user / 0b01 jail / 0b10 supv / 0b11 hypv, so storing the
+ * hardware value verbatim would make the criterion true for supv (0b10) — the
+ * opposite of what it has to answer.  The stubs therefore write
+ * `DADAO_STATUS_USER` (0x1) for a user-mode entry and 0 for every privileged
+ * one; the criterion then means "came from user mode".  The difference against
+ * the spec that the ruling calls out is kept: jail (0b01) is **not** a user mode
+ * here — this port never enters jail, and supporting it later means re-deriving
+ * the encoding, not just widening this test.  Bits 4-63 stay 0.
+ */
+static inline int user_mode(struct pt_regs *regs)
+{
+	return (regs->status & 0x3) != 0;
+}
+
+/*
+ * Interrupt-enable state of the *interrupted* context (m14-linux-044/045).
+ *
+ * The frame cannot answer this — an interface limit, not an omission
+ * (user ruling B of 2026-11-20, `discussing.md` N30): `contract-see §6.4` keeps
+ * the enable state in the running mode's monitor row, the hardware saves the
+ * frame's `global_cfx_intr_mask` in an internal register
+ * (`saved_global_cfx_intr_mask`, `spec/DADAO-12 §3.6`) that software cannot
+ * read, and there is no IE bit in the saved cg5 fields to copy.  Adding a bit to
+ * `status` would therefore be a *software mirror* of a state the hardware
+ * already owns and restores on `escape`, which the ruling rejects.
+ *
+ * `irqs_disabled()` (asm/irqflags.h) keeps reading the hardware row and is
+ * deliberately true inside an exception — that is what lets `might_sleep()`
+ * catch a sleep in interrupt context.  This function answers the other
+ * question ("was the *interrupted* context masked"), and the honest answer for
+ * every frame this port produces is "unknown"; the generic entry code's use of
+ * it (deciding whether the return path may reschedule) is satisfied by
+ * reporting the ordinary case, because the kernel never returns to user mode
+ * with the source masked (the exit path restores the entry's word).
+ */
+static __always_inline bool regs_irqs_disabled(struct pt_regs *regs)
+{
+	return false;
+}
+
+/*
+ * The page-fault channel (mm/fault.c, m14-linux-012).  kernel/traps.c extracts
+ * the class (`cause_id[15:0]`) and the sub-reason (`[63:48]`/`[47:32]`,
+ * asm/cause-sub.h) and calls this for CFXMEM/CFXPERM only; the return value is
+ * a resume policy for the entry stub:
+ *
+ *   DADAO_PF_RETRY  re-execute the faulting instruction (rc10 = ip): the
+ *                   handler installed the mapping (or set the missing fragment
+ *                   bit) and invalidated the TLB;
+ *   DADAO_PF_FATAL  nothing was installed, and the fault belongs to the
+ *                   *kernel*: traps.c names the cause and stops with
+ *                   spec/Kaiwu §7.1's monitor code;
+ *   DADAO_PF_SEGV   nothing was installed, and the fault belongs to a *user*
+ *                   process: SIGSEGV was raised on it and is delivered on the
+ *                   way back to user mode (m14-linux-027, mm/fault.c).  The
+ *                   process's own default action or handler decides what
+ *                   happens; the kernel never names it.
+ *
+ * The handler never returns a "skip": a page fault either makes the access
+ * possible, hands the process its SIGSEGV, or ends the boot — the instruction
+ * it belongs to has no meaningful value to skip to.
+ */
+#define DADAO_PF_RETRY		0
+#define DADAO_PF_FATAL		1
+#define DADAO_PF_SEGV		2
+unsigned long dadao_do_page_fault(struct pt_regs *regs, unsigned long cause,
+				  unsigned long info, bool from_user);
+
+#define instruction_pointer(regs)	((regs)->ip)
+#define user_stack_pointer(regs)	((regs)->rb[1])
+#define regs_return_value(regs)		((regs)->rd[8])
+#define current_pt_regs()	((struct pt_regs *)((unsigned long)current_thread_info() + THREAD_SIZE) - 1)
+
+static inline void instruction_pointer_set(struct pt_regs *regs,
+					   unsigned long val)
+{
+	regs->ip = val;
+}
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_PTRACE_H */
