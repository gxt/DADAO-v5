diff --git a/arch/dadao/include/asm/ptrace.h b/arch/dadao/include/asm/ptrace.h
new file mode 100644
index 000000000..a2d6d5693
--- /dev/null
+++ b/arch/dadao/include/asm/ptrace.h
@@ -0,0 +1,134 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_PTRACE_H
+#define __ASM_PTRACE_H
+
+#include <linux/stddef.h>
+
+#include <uapi/asm/ptrace.h>
+#include <asm/trap.h>
+
+#ifndef __ASSEMBLY__
+
+/*
+ * The complete saved context of a supv exception — synchronous (kernel/trap.S)
+ * or asynchronous (kernel/async_trap.S), the two frames are the same shape.
+ *
+ * spec/DADAO-12 §3.6: the hardware saves *no* general register, only the cg5
+ * frame fields, so the kernel entry saves the register file itself
+ * (contract-syscall §8).  The frame mirrors the file one slot per register, all
+ * four banks (§2.1/§2.4 of spec/SimRISC-00):
+ *
+ *   rd[0..63]  rd0 stays 0 (it is not a register: `ld` to it is ILLI);
+ *   rb[0..63]  rb0 stays 0 (it is the read-only IP, mirrored into `ip`);
+ *   ra[0..63]  the return-address stack, *including* ra0 — the {RACNT, MRPTR}
+ *              metadata word (spec/SimRISC-00 §2.4) — so that a round trip
+ *              through this frame leaves `ra0-ra63` bit-identical
+ *              (§2.4: "异常进入和退出不改变 ra0–ra63 的内容");
+ *   rf[0..63]  rf0 is the FCSR and is saved/restored as a whole; its write port
+ *              masks the non-writable fields (§2.3), so a value read back out
+ *              of this frame is the architectural one, not the raw input.
+ *
+ * Field order is not free: `st.o`/`ld.o` form their address as
+ * `[rbHB, imms12]` (signed 12-bit ⇒ at most 2048 bytes from the base,
+ * spec/SimRISC-01 §1), while `stm.o`/`ldm.o` address their transfer with a
+ * *register* index (rdHC) and are therefore unlimited.  The two scalar slots
+ * the stub writes with a plain immediate (`ip`, `status`) sit inside that
+ * window; the two banks that need 64 slots each (`ra`, `rf`) follow it and are
+ * moved in block transfers (asm/entry.h).
+ *
+ * `ip` is `excp_cause_ip` (spec/DADAO-12 §3.6) and is the software copy: an
+ * `escape` returns to the *hardware* `cfx_smon.excp_cause_ip`, so a handler
+ * that wants to resume elsewhere writes that register, not this field
+ * (contract-see §6.2).
+ *
+ * `status` has no hardware source on this machine — there is no status
+ * register and no IE bit (contract-abi, contract-see §6.4) — so the entry
+ * writes 0.  The field is kept because the generic ptrace/ELF code expects a
+ * task's saved context to have one place for it.
+ */
+struct pt_regs {
+	unsigned long rd[64];
+	unsigned long rb[64];
+	unsigned long ip;
+	unsigned long status;
+	unsigned long ra[64];
+	unsigned long rf[64];
+};
+
+/*
+ * The layout is pinned here once: every offset the assembly uses comes from
+ * asm-offsets (PT_* macros, derived from these very fields), so a mismatch
+ * between this struct and the stubs' expectations has to fail the build rather
+ * than corrupt a context at run time.  The 2048 bound is `imms12`'s positive
+ * reach (spec/SimRISC-01 §1), the reason `ip`/`status` precede the two banks.
+ */
+_Static_assert(sizeof(struct pt_regs) ==
+		       (4 * 64 + 2) * sizeof(unsigned long),
+	       "pt_regs: four 64-slot banks plus ip/status");
+_Static_assert(sizeof(((struct pt_regs *)0)->ra) == 64 * sizeof(unsigned long),
+	       "pt_regs: ra holds all 64 return-address slots");
+_Static_assert(sizeof(((struct pt_regs *)0)->rf) == 64 * sizeof(unsigned long),
+	       "pt_regs: rf holds all 64 floating-point slots");
+_Static_assert(offsetof(struct pt_regs, ip) % 8 == 0 &&
+		       offsetof(struct pt_regs, status) % 8 == 0,
+	       "pt_regs: ip/status must be 8-byte aligned");
+_Static_assert(offsetof(struct pt_regs, status) + sizeof(unsigned long) <= 2048,
+	       "pt_regs: ip/status must stay inside st.o's imms12 window");
+_Static_assert(offsetof(struct pt_regs, ra) % 8 == 0 &&
+		       offsetof(struct pt_regs, rf) % 8 == 0,
+	       "pt_regs: block-transferred banks must be 8-byte aligned");
+
+static inline int user_mode(struct pt_regs *regs)
+{
+	/*
+	 * **The saved frame carries no mode bit** (m14-linux-042 P0): `ip` is
+	 * `excp_cause_ip`, `status` is written 0 because the machine has no
+	 * status register (contract-abi), and the hardware's own
+	 * `excp_prev_mode` (`cfx_smon cg5`) is not copied into `struct pt_regs`.
+	 * So this cannot answer, and it must not guess from an address range:
+	 * a `prev_mode` field has to be added to the frame and written by the
+	 * entry stubs — a frame-layout (contract) change, registered as 待用户裁定
+	 * in `m14-linux-035`'s task book.
+	 *
+	 * Everything that *needs* the mode on this port gets it from the
+	 * dispatch route instead, which knows the fact: `dadao_user_fault_from_umon()`
+	 * (the `cfx_umon` hand-over) is a user fault, the supv vector is not
+	 * (`dadao_do_page_fault(..., from_user)`).
+	 */
+	return 0;
+}
+
+/*
+ * The page-fault channel (mm/fault.c, m14-linux-012).  kernel/traps.c extracts
+ * the class (`cause_id[15:0]`) and the sub-reason (`[63:48]`/`[47:32]`,
+ * asm/cause-sub.h) and calls this for CFXMEM/CFXPERM only; the return value is
+ * a resume policy for the entry stub:
+ *
+ *   DADAO_PF_RETRY  re-execute the faulting instruction (`escape …, 0`): the
+ *                   handler installed the mapping (or set the missing fragment
+ *                   bit) and invalidated the TLB;
+ *   DADAO_PF_FATAL  nothing was installed; traps.c names the cause and stops
+ *                   with spec/Kaiwu §7.1's monitor code.
+ *
+ * The handler never returns a "skip": a page fault either makes the access
+ * possible or ends the boot — the instruction it belongs to has no meaningful
+ * value to skip to.
+ */
+#define DADAO_PF_RETRY		0
+#define DADAO_PF_FATAL		1
+unsigned long dadao_do_page_fault(struct pt_regs *regs, unsigned long cause,
+				  unsigned long info, bool from_user);
+
+#define instruction_pointer(regs)	((regs)->ip)
+#define user_stack_pointer(regs)	((regs)->rb[1])
+#define regs_return_value(regs)		((regs)->rd[8])
+#define current_pt_regs()	((struct pt_regs *)((unsigned long)current_thread_info() + THREAD_SIZE) - 1)
+
+static inline void instruction_pointer_set(struct pt_regs *regs,
+					   unsigned long val)
+{
+	regs->ip = val;
+}
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_PTRACE_H */
