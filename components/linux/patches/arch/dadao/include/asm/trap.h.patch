diff --git a/arch/dadao/include/asm/trap.h b/arch/dadao/include/asm/trap.h
new file mode 100644
index 000000000..d9494d1ea
--- /dev/null
+++ b/arch/dadao/include/asm/trap.h
@@ -0,0 +1,163 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO supv synchronous-exception entry: the contract between the assembly
+ * stub (kernel/trap.S) and its C half (kernel/traps.c).
+ *
+ * Included from both sides, so it may only carry preprocessor constants —
+ * no structs, no inline functions.
+ */
+#ifndef __ASM_DADAO_TRAP_H
+#define __ASM_DADAO_TRAP_H
+
+/*
+ * Resume policy returned by dadao_trap_handler().  `escape` accepts exactly
+ * two offsets (spec/DADAO-12 §5.3), so the policy is a two-value enum and the
+ * stub fails by name on anything else instead of guessing an offset.
+ */
+#define DADAO_TRAP_RESUME_RETRY	0	/* escape +0: re-execute the faulting insn */
+#define DADAO_TRAP_RESUME_SKIP	1	/* escape +4: continue after it */
+
+/* Every instruction is four bytes (spec/SimRISC-00 §3). */
+#define DADAO_INSN_BYTES	4
+
+/*
+ * Kernel self-check point the stub reports when the handler returns a policy
+ * that is neither of the two above (guest segment 0x01-0x7f, value = the check
+ * point; the numbering lives in kernel/traps.c).
+ */
+#define DADAO_TRAP_BAD_POLICY	0x0d
+
+/*
+ * K4 (m14-linux-016): the `immu18` the user-mode entry stub uses to hand a
+ * U-mode synchronous exception to the supv channel.  The hardware routes such an
+ * exception into `cfx_umon` (spec/DADAO-12 §3.1: "非 trap 的 U-mode 异常固定进入
+ * cfx_umon"), so the *cause* is lost on the way to `cfx_smon`; the stub therefore
+ * passes it in registers and selects the delegated path with this immediate
+ * (contract-syscall §8: the smon channel is the one that owns page-table
+ * causes).  It is a kernel-private selector, not a syscall number.
+ */
+#define DADAO_SMON_FROM_USER	0x2f5
+
+/*
+ * ADR-0061 R2: the asynchronous stub's handoff selectors.
+ *
+ * FROM_ASYNC: the user-context capture.  It is already in
+ * `task_pt_regs(current)`; this immediate tells the smon dispatcher to ack
+ * `async_src_frame`, run the return-to-user loop and leave through
+ * `dadao_enter_user()`.
+ *
+ * FROM_ASYNC_KERNEL: the kernel-context capture.  The handler has already run
+ * in place (kernel/time.c); the immediate asks the smon half to rebuild the
+ * interrupted run mode / current cfx from the capture and `escape` to the
+ * software-return trampoline.  The hardware switched the current cfx to
+ * `cfx_hart` on the asynchronous entry and there is no asynchronous `escape`
+ * (§5.4), so a direct jump back would leave it at `cfx_hart` and the next
+ * `escape cfx_<interrupted>` would raise `CFXESC` (§5.3 step 0); `cfx_hart`'s
+ * supv vector is 0, so that fault lands on address 0.  `cg5`'s
+ * `excp_prev_run_mode`/`excp_prev_cfx_code`/`excp_cause_ip` are software-
+ * writable (§3.6), which is what makes the rebuild possible.
+ */
+#define DADAO_SMON_FROM_ASYNC	0x2f6
+#define DADAO_SMON_FROM_ASYNC_KERNEL	0x2f7
+
+/*
+ * `struct pt_regs.status` low 4 bits: the exception's *pre-entry* run mode as
+ * the entry stubs record it (m14-linux-045).  `user_mode()` is
+ * `(status & 0x3) != 0`, so the stubs write this value for a user-mode entry and
+ * 0 for every privileged one; the raw `spec/DADAO-12 §1` encoding (0b00 user /
+ * 0b01 jail / 0b10 supv / 0b11 hypv) cannot be stored as-is (see the comment on
+ * `user_mode()` in asm/ptrace.h).  Bits 4-63 stay 0.
+ *
+ * Preprocessor-only, because kernel/trap.S and kernel/async_trap.S write it.
+ */
+#define DADAO_STATUS_USER	0x1
+
+/*
+ * Cause ids (spec/DADAO-13 §2, contract-see §6.1): one bit each, in `[15:0]`.
+ * A hardware `excp_cause_id` is a *flat bitmap* (ADR-0062): a page-table fault
+ * sets one bit in `[56:32]` and leaves `[15:0]` zero, so the low mask below
+ * separates "one of the 11 synchronous causes" from "a bitmap fault", and the
+ * bitmap is decoded by asm/cause-sub.h alone (m14-linux-012, m18-linux-023).
+ */
+#define DADAO_CAUSE_CFXTRAP	(1UL << 0)
+#define DADAO_CAUSE_CFXMEM	(1UL << 1)
+#define DADAO_CAUSE_CFXREG	(1UL << 2)
+#define DADAO_CAUSE_CFXESC	(1UL << 3)
+#define DADAO_CAUSE_CFXPERM	(1UL << 7)
+#define DADAO_CAUSE_ILLI	(1UL << 8)
+#define DADAO_CAUSE_UNDI	(1UL << 9)
+#define DADAO_CAUSE_RASOF	(1UL << 10)
+#define DADAO_CAUSE_RASUF	(1UL << 11)
+#define DADAO_CAUSE_MALIGN	(1UL << 12)
+#define DADAO_CAUSE_IALIGN	(1UL << 13)
+
+#define DADAO_CAUSE_MASK	0xffffUL
+#define DADAO_CAUSE_CLASS(id)	((id) & DADAO_CAUSE_MASK)
+
+#ifndef __ASSEMBLY__
+
+struct pt_regs;
+
+/*
+ * A registered, deliberate fault.
+ *
+ * Registering is the only way to make a synchronous exception resumable: the
+ * handler matches `cause` (and `info`, when non-zero) against the registered
+ * probe and resumes only then.  A fault that merely looks like a probe — the
+ * same address, the same magic — is fatal unless a probe is registered.
+ *
+ *   hits       times the handler matched this probe
+ *   retry      resume with `, 0` this many times before skipping: proves the
+ *              offset really re-executes the faulting instruction
+ *   max_hits   0 = unlimited; exceeding it is a kernel self-check failure
+ *   redirect   non-zero: resume at this address instead of at the fault.  The
+ *              handler writes it into `cfx_smon.excp_cause_ip` (cg5 rc3) and
+ *              returns RETRY, because `escape` only offers +0/+4 relative to
+ *              the hardware frame IP (contract-see §6.2).
+ *   report     optional; the probe owns its own diagnostic line
+ */
+struct dadao_fault_probe {
+	unsigned long cause;
+	unsigned long info;
+	unsigned long hits;
+	unsigned long retry;
+	unsigned long max_hits;
+	unsigned long redirect;
+	void (*report)(struct dadao_fault_probe *probe, struct pt_regs *regs,
+		       unsigned long info);
+};
+
+/* One probe at a time in K2: -EBUSY when another is registered. */
+int dadao_trap_probe_register(struct dadao_fault_probe *probe);
+void dadao_trap_probe_unregister(struct dadao_fault_probe *probe);
+/* Is @probe the registered one?  (Registration failures must be visible.) */
+bool dadao_trap_probe_active(const struct dadao_fault_probe *probe);
+
+/* Name of a cause id from the 11-item table (spec/DADAO-13 §2); NULL if none. */
+const char *dadao_cause_name(unsigned long cause);
+
+/*
+ * The asynchronous channel (contract-see §6.3): the cfx_hart supv vector
+ * (kernel/async_trap.S) and its C half.  A separate vector and a separate
+ * frame from the synchronous one above — the delivery targets cfx_hart, not
+ * cfx_smon.
+ */
+extern char dadao_async_excp[];		/* the entry (installed by init_IRQ) */
+extern char dadao_async_save[];		/* its static frame */
+/* Kernel-context handle; the asm stub resumes `async_cause_ip` afterwards. */
+void dadao_async_kernel_handler(struct pt_regs *regs);
+/* Ack the captured source bits (kernel/time.c). */
+void dadao_async_ack_sources(struct pt_regs *regs);
+/* A cause/source this kernel has no handler for: name it and stop. */
+void __noreturn dadao_async_die(unsigned long cause, unsigned long info);
+
+/*
+ * The exit code a fatal synchronous exception produces (spec/Kaiwu §7.1):
+ * "other cfx" for CFXTRAP/CFXESC, the monitor segment for everything else.
+ * Exposed so the K2 self-test can assert both branches without dying.
+ */
+unsigned long dadao_exit_code(unsigned long cause);
+
+#endif /* !__ASSEMBLY__ */
+
+#endif /* __ASM_DADAO_TRAP_H */
