diff --git a/arch/dadao/include/asm/cfx.h b/arch/dadao/include/asm/cfx.h
new file mode 100644
index 000000000..cff83e6da
--- /dev/null
+++ b/arch/dadao/include/asm/cfx.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO cfx register access (spec/DADAO-12 §3, §4): `cfx2rd` / `cfx2rc`.
+ *
+ * The (cfxha, cg, rc) triple is encoded in the instruction, so the cfx name
+ * must be a compile-time token the assembler can resolve against the runtime
+ * alias table (contracts/cfx-aliases.txt, Toolchain-01 §13), and cg/rc must be
+ * constants — they are stringified into the mnemonic operands.  The value
+ * register is a fixed `rd` operand, named explicitly so the result cannot be
+ * silently re-assigned by the compiler.
+ *
+ * Permission: the kernel runs in cfx_smon/supv (the SEE handover of
+ * contract-linux-boot §5), so a target cfx is reachable when its
+ * `supv_cfxreg` source mask allows cfxha 2 and its `hypv_cg_reg_deleg` bit for
+ * the accessed cg is 0 (DADAO-13 §1).  The boot SEE opens exactly cfx_pmem /
+ * cfx_ptw / cfx_smon (tests/shared/bootrom/k0/hmon.S).
+ */
+#ifndef __ASM_CFX_H
+#define __ASM_CFX_H
+
+/*
+ * Run modes (spec/DADAO-12 §1): the value a cfx's `<mode>_switch_run_mode` row
+ * carries, and the mode an exception frame records as `excp_prev_run_mode`.
+ */
+#define DADAO_MODE_USER		0
+#define DADAO_MODE_JAIL		1
+#define DADAO_MODE_SUPV		2
+#define DADAO_MODE_HYPV		3
+
+/*
+ * The two shared (`cg0`/`cg2`) rows of cfx_umon that make a user-mode entry
+ * work (spec/DADAO-12 §3.1/§3.3, contract-syscall §8):
+ *
+ *   user row (cg0):  where a user's `trap cfx_umon, 0` lands and the mode it
+ *                    lands in — the kernel's syscall entry;
+ *   supv row (cg2):  where a *kernel* `trap cfx_umon` lands and the mode it
+ *                    lands in — how a task is started in user mode.
+ *
+ * `rc14` is "switch run mode", `rc15` is "exception vector" (they moved from
+ * `rc8`/`rc10` in m18-spec-007; the old slots are reserved and trap CFXREG);
+ * both rows have the same shape, which is why the two macros below differ only
+ * in `cg`.
+ */
+#define UMON_CG_USER			0
+#define UMON_CG_SUPV			2
+#define UMON_RC_TRAP_MASK		0	/* supv cfxtrap source mask */
+#define UMON_RC_REG_MASK		2	/* supv cfxreg source mask */
+/*
+ * cg5 = the exception frame fields (spec/DADAO-12 §3.6), same layout in every
+ * cfx: `rc0`-`rc3` are the hardware-written entry record (software reads only),
+ * `rc4`/`rc5` are cause id/info and `rc8`-`rc11` are the escape exit intent.
+ * The umon return path owns `rc10` (`escape ip`): a task that slept inside the
+ * handler must put its *own* return address back before escaping — a cfx's cg5
+ * holds only the last entry, which may have been another task's (m14-linux-024,
+ * kernel/trap.S).
+ */
+/*
+ * cg6 = the per-cfx scratch registers (spec/DADAO-12 §3.7).  Its rc0/rc1 are
+ * the exception capture's staging slots for `rd2`/`rd3` (asm/entry.h), so they
+ * do NOT survive an entry: the umon entry's per-task stack top lives in
+ * `dadao_user_stack_top` (kernel/process.c), not here (m14-linux-024).
+ */
+/*
+ * The cfx that can be *current* inside the kernel: cfx_smon at boot,
+ * cfx_umon after a task has trapped (spec/DADAO-12 §5.2 step 6), cfx_hart after
+ * an interrupt.  The kernel opens these as sources in every cfx row it touches
+ * (m14-linux-017 S5: the mask rows are indexed by the source cfx, so a row open
+ * only for source 2 refuses the kernel's own access once a task is current).
+ */
+#define DADAO_CFX_SOURCES_OPEN						\
+	((1UL << DADAO_CFX_UMON) | (1UL << DADAO_CFX_SMON) |		\
+	 (1UL << 15 /* cfx_hart */))
+#define UMON_RC_SWITCH_RUN_MODE		14
+#define UMON_RC_EXCP_VECTOR		15
+
+/*
+ * cg5 exit intent (spec/DADAO-12 §3.6): hardware copies the entry record here
+ * on every entry; software may rewrite any of the four before `escape`, which
+ * returns exactly to `rc10` and whole-word restores `rc11` into the target
+ * mode monitor's `cg15 rc3` (ADR-0064 D6/D7).
+ */
+#define CFX_CG_FRAME			5
+#define CFX_RC_FRAME_PREV_RUN_MODE	0
+#define CFX_RC_FRAME_PREV_CFX_CODE	1
+#define CFX_RC_FRAME_PREV_IP		2
+#define CFX_RC_FRAME_PREV_INTR_MASK	3
+#define CFX_RC_FRAME_CAUSE_ID		4
+#define CFX_RC_FRAME_CAUSE_INFO		5
+#define CFX_RC_ESCAPE_RUN_MODE		8
+#define CFX_RC_ESCAPE_CFX_CODE		9
+#define CFX_RC_ESCAPE_IP		10
+#define CFX_RC_ESCAPE_INTR_MASK		11
+
+/*
+ * cfxha of the user / jail / supv / hypv monitors (spec/DADAO-12 §2.1 table):
+ * the value a source mask's bit index counts from.
+ */
+#define DADAO_CFX_UMON			0
+#define DADAO_CFX_SMON			2
+#define DADAO_CFX_HMON			3
+
+/* Two-level stringification: expand the constant, then quote it. */
+#define _DADAO_STRINGIFY(x)	#x
+#define DADAO_STRINGIFY(x)	_DADAO_STRINGIFY(x)
+
+#define DADAO_CFX_READ(cfxname, cg, rc)					\
+({									\
+	register unsigned long _cfx_v __asm__("rd8");			\
+	__asm__ __volatile__("cfx2rd " #cfxname ", cg" DADAO_STRINGIFY(cg) \
+			     ", rc" DADAO_STRINGIFY(rc) ", %0"		\
+			     : "=r"(_cfx_v));				\
+	_cfx_v;								\
+})
+
+#define DADAO_CFX_WRITE(cfxname, cg, rc, value)				\
+do {									\
+	register unsigned long _cfx_v __asm__("rd16") = (value);	\
+	__asm__ __volatile__("cfx2rc " #cfxname ", cg" DADAO_STRINGIFY(cg) \
+			     ", rc" DADAO_STRINGIFY(rc) ", %0"		\
+			     : : "r"(_cfx_v));				\
+} while (0)
+
+#endif /* __ASM_CFX_H */
