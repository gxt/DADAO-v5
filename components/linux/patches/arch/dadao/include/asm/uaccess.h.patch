diff --git a/arch/dadao/include/asm/uaccess.h b/arch/dadao/include/asm/uaccess.h
new file mode 100644
index 000000000..b2d89e1f3
--- /dev/null
+++ b/arch/dadao/include/asm/uaccess.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ASM_UACCESS_H
+#define __ASM_UACCESS_H
+
+/*
+ * User copies are exception-table backed (m14-linux-044).
+ *
+ * Every load/store that may fault has an entry in __ex_table; a kernel-mode
+ * fault the page-fault channel cannot serve is handed to fixup_exception()
+ * (mm/extable.c), which resumes at the fixup label and reports "bytes not
+ * copied" instead of ending the boot.  That is why CONFIG_UACCESS_MEMCPY is
+ * *not* selected: its accessors are a bare memcpy with no table entry.
+ *
+ * The byte-wise loops in lib/copy_user.S are deliberately simple: the user
+ * pointer need not be aligned (8-byte accesses require 8-byte alignment on
+ * this machine), and correctness, not throughput, is the criterion here.
+ */
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#include <asm/page.h>		/* TASK_SIZE for access_ok() */
+
+extern unsigned long __must_check raw_copy_from_user(void *to,
+		const void __user *from, unsigned long n);
+extern unsigned long __must_check raw_copy_to_user(void __user *to,
+		const void *from, unsigned long n);
+
+/* asm-generic/uaccess.h keeps its memset version only if this is not defined. */
+extern unsigned long __must_check __clear_user(void __user *to, unsigned long n);
+#define __clear_user __clear_user
+
+#include <asm-generic/uaccess.h>
+
+#endif
