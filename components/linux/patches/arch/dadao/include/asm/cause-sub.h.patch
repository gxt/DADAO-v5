diff --git a/arch/dadao/include/asm/cause-sub.h b/arch/dadao/include/asm/cause-sub.h
new file mode 100644
index 000000000..73de05148
--- /dev/null
+++ b/arch/dadao/include/asm/cause-sub.h
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Page-table fault bits of `excp_cause_id` (spec/DADAO-12 §3.6, ADR-0062 D1/D2,
+ * contract-see §6.1/§6.1.1).
+ *
+ * The id is a *flat bitmap*: one bit names one reason, and the number is the
+ * bit's absolute position in the 64-bit register (there is no "class + wyde"
+ * two-level form any more):
+ *
+ *   [15:0]   the 11 synchronous causes, one-hot (asm/trap.h);
+ *   [31:16]  reserved for future classes (must stay 0);
+ *   [38:32]  PTW permission class: NUPERM, NJPERM, NSPERM, NHPERM, NRPERM,
+ *            NWPERM, NXPERM;
+ *   [39]     deleted (always 0);
+ *   [47:40]  reserved (always 0);
+ *   [55:48]  PTW missing class: IGPTRAP, ISPTRAP, IGPFTRAP, ISPFTRAP, DGPTRAP,
+ *            DSPTRAP, DGPFTRAP, DSPFTRAP;
+ *   [56]     ADWBFAIL (A/D write-back failed);
+ *   [57]     deleted (always 0);
+ *   [63:58]  reserved (always 0).
+ *
+ * A PTW fault sets *only* its bitmap bit and leaves `[15:0]` zero; `CFXMEM`
+ * (non-PTW in-core access) and `CFXPERM` (cfx source-mask denial) each set only
+ * their low cause bit and leave `[63:32]` zero (ADR-0062 D2/D3).  The id is
+ * zero (no exception) or exactly one bit of the 64 is set.
+ *
+ * Every number below is a projection of `contract-see §6.1.1`; the gate
+ * `tests/unit/linux/k4_cow_probe.py` parses that table and refuses to run when
+ * this header disagrees with it, so the two can never drift apart silently.
+ * Adding a bit is a contract change first.
+ */
+#ifndef __ASM_DADAO_CAUSE_SUB_H
+#define __ASM_DADAO_CAUSE_SUB_H
+
+#include <asm/trap.h>
+
+/*
+ * Absolute bit numbers (contract-see §6.1.1).  `DADAO_SUB_NONE` is not a bit:
+ * it is "this id carries no bitmap bit" (a low synchronous cause, or an id the
+ * caller failed to validate) and stays 0 so it never collides with a real one
+ * (`1 << 0` is CFXTRAP, which never reports a page fault).
+ */
+#define DADAO_SUB_NONE		0
+
+/* [38:32] — PTW permission class (ADR-0062 D1) */
+#define DADAO_SUB_NUPERM	32	/* HSJU.U = 0, current mode = user */
+#define DADAO_SUB_NJPERM	33	/* HSJU.J = 0, current mode = jail */
+#define DADAO_SUB_NSPERM	34	/* HSJU.S = 0, current mode = supv */
+#define DADAO_SUB_NHPERM	35	/* HSJU.H = 0, current mode = hypv */
+#define DADAO_SUB_NRPERM	36	/* read of a page with R = 0 */
+#define DADAO_SUB_NWPERM	37	/* write of a page with W = 0 */
+#define DADAO_SUB_NXPERM	38	/* fetch of a page with X = 0 */
+#define DADAO_SUB_PERM_FIRST	DADAO_SUB_NUPERM
+#define DADAO_SUB_PERM_LAST	DADAO_SUB_NXPERM
+
+/* [55:48] — PTW missing class, [56] — A/D write-back failure (ADR-0062 D1) */
+#define DADAO_SUB_IGPTRAP	48	/* fetch: L1 P=0,SP=0 or L2 P=0 */
+#define DADAO_SUB_ISPTRAP	49	/* fetch: L1 P=0,SP=1 (superpage missing) */
+#define DADAO_SUB_IGPFTRAP	50	/* fetch: L2 P=1, GPF bit = 0 */
+#define DADAO_SUB_ISPFTRAP	51	/* fetch: L1 P=1,SP=1, SPF bit = 0 */
+#define DADAO_SUB_DGPTRAP	52	/* data: L1 P=0,SP=0 or L2 P=0 */
+#define DADAO_SUB_DSPTRAP	53	/* data: L1 P=0,SP=1 (superpage missing) */
+#define DADAO_SUB_DGPFTRAP	54	/* data: L2 P=1, GPF bit = 0 */
+#define DADAO_SUB_DSPFTRAP	55	/* data: L1 P=1,SP=1, SPF bit = 0 */
+#define DADAO_SUB_ADWBFAIL	56	/* A/D write-back failed (info = PTE PA) */
+#define DADAO_SUB_MEM_FIRST	DADAO_SUB_IGPTRAP
+#define DADAO_SUB_MEM_LAST	DADAO_SUB_ADWBFAIL
+
+/* Region masks: the two bitmaps, and every bit ADR-0062 D1 keeps at 0. */
+#define DADAO_SUB_PERM_MASK	(0x7fUL << DADAO_SUB_PERM_FIRST)
+#define DADAO_SUB_MEM_MASK	(0x1ffUL << DADAO_SUB_MEM_FIRST)
+#define DADAO_SUB_BITMAP_MASK	(DADAO_SUB_PERM_MASK | DADAO_SUB_MEM_MASK)
+#define DADAO_SUB_RESERVED_MASK	((1UL << 39) | (0xffUL << 40) | \
+				 (1UL << 57) | (0x3fUL << 58))
+
+/* The verdict of dadao_subcause_layout(): 0 = the id is well formed. */
+#define DADAO_SUB_LAYOUT_OK		0
+#define DADAO_SUB_LAYOUT_RESERVED	1  /* [39], [47:40], [57], [63:58] */
+#define DADAO_SUB_LAYOUT_FOREIGN	2  /* bitmap bit together with a low cause */
+#define DADAO_SUB_LAYOUT_SHAPE		3  /* several bitmap bits */
+
+#ifndef __ASSEMBLY__
+
+/*
+ * Absolute bit number of the id's single bitmap bit, or DADAO_SUB_NONE when it
+ * carries none (a low synchronous cause, several bits, or reserved bits).
+ * This is the decoding step of the page-fault path; a caller that must *refuse*
+ * a malformed id calls dadao_subcause_layout() first.
+ */
+static inline unsigned int dadao_subcause_pos(unsigned long cause_id)
+{
+	unsigned long bits = cause_id & DADAO_SUB_BITMAP_MASK;
+	unsigned int bit = 0;
+
+	if (!bits || (bits & (bits - 1)))
+		return DADAO_SUB_NONE;
+	while (!(bits & 1UL)) {
+		bits >>= 1;
+		bit++;
+	}
+	return bit;
+}
+
+/*
+ * The id is a PTW fault: exactly one bitmap bit, nothing in `[15:0]` and nothing
+ * in the reserved ranges.  This is the dispatcher's "hand this to the fault
+ * channel" predicate; it never guesses at a malformed id (that is
+ * dadao_subcause_layout()'s verdict, reported by name).
+ */
+static inline bool dadao_subcause_is_ptw(unsigned long cause_id)
+{
+	unsigned long bits = cause_id & DADAO_SUB_BITMAP_MASK;
+
+	if ((cause_id & DADAO_CAUSE_MASK) || (cause_id & DADAO_SUB_RESERVED_MASK))
+		return false;
+	return bits && !(bits & (bits - 1));
+}
+
+/* The 8 missing classes (`[55:48]`) — "the page is not there". */
+static inline bool dadao_subcause_is_missing(unsigned int pos)
+{
+	return pos >= DADAO_SUB_MEM_FIRST && pos <= DADAO_SUB_DSPFTRAP;
+}
+
+/* The 7 permission classes (`[38:32]`) — "the page is there, the access is not
+ * allowed" (HSJU or R/W/X).  A cfx source-mask denial is `CFXPERM` and never
+ * reaches the page-fault channel as a bitmap bit (ADR-0062 D2). */
+static inline bool dadao_subcause_is_perm(unsigned int pos)
+{
+	return pos >= DADAO_SUB_PERM_FIRST && pos <= DADAO_SUB_PERM_LAST;
+}
+
+/*
+ * The four fetch classes carry the "I" prefix of contract-see §6.1.1
+ * ("取指用 I 前缀、数据读写用 D 前缀"): the *only* place the kernel can learn
+ * that the faulting access was an instruction fetch, because the missing-page
+ * classes for data do not distinguish read from write (which is why the fill
+ * maps the read-only zero page first and lets a second, permission-class fault
+ * turn a write into a private page).
+ */
+static inline bool dadao_subcause_is_fetch(unsigned int pos)
+{
+	return pos == DADAO_SUB_IGPTRAP || pos == DADAO_SUB_ISPTRAP ||
+	       pos == DADAO_SUB_IGPFTRAP || pos == DADAO_SUB_ISPFTRAP;
+}
+
+/* Symbolic name of a bitmap bit (the gate parses it against the contract). */
+static inline const char *dadao_subcause_name(unsigned int pos)
+{
+	switch (pos) {
+	case DADAO_SUB_NUPERM:		return "NUPERM";
+	case DADAO_SUB_NJPERM:		return "NJPERM";
+	case DADAO_SUB_NSPERM:		return "NSPERM";
+	case DADAO_SUB_NHPERM:		return "NHPERM";
+	case DADAO_SUB_NRPERM:		return "NRPERM";
+	case DADAO_SUB_NWPERM:		return "NWPERM";
+	case DADAO_SUB_NXPERM:		return "NXPERM";
+	case DADAO_SUB_IGPTRAP:		return "IGPTRAP";
+	case DADAO_SUB_ISPTRAP:		return "ISPTRAP";
+	case DADAO_SUB_IGPFTRAP:	return "IGPFTRAP";
+	case DADAO_SUB_ISPFTRAP:	return "ISPFTRAP";
+	case DADAO_SUB_DGPTRAP:		return "DGPTRAP";
+	case DADAO_SUB_DSPTRAP:		return "DSPTRAP";
+	case DADAO_SUB_DGPFTRAP:	return "DGPFTRAP";
+	case DADAO_SUB_DSPFTRAP:	return "DSPFTRAP";
+	case DADAO_SUB_ADWBFAIL:	return "ADWBFAIL";
+	default:			return NULL;
+	}
+}
+
+/*
+ * The shape check of contract-see §6.1 / ADR-0062 D1, the kernel's own copy of
+ * what the machine model and the verifiers enforce: the id is 0 or exactly one
+ * bit of the 64; a bitmap bit never rides with a low cause bit, and the deleted
+ * / reserved positions stay 0.  A malformed id is terminated by name — it is
+ * never "assumed to be a page fault" (task rule).
+ */
+static inline int dadao_subcause_layout(unsigned long cause_id)
+{
+	unsigned long bits;
+
+	if (!cause_id)
+		return DADAO_SUB_LAYOUT_OK;	/* no exception */
+	if (cause_id & DADAO_SUB_RESERVED_MASK)
+		return DADAO_SUB_LAYOUT_RESERVED;
+
+	bits = cause_id & DADAO_SUB_BITMAP_MASK;
+	if (!bits) {
+		/* A low synchronous cause carries nothing above [15:0]. */
+		return (cause_id & ~DADAO_CAUSE_MASK)
+			? DADAO_SUB_LAYOUT_FOREIGN : DADAO_SUB_LAYOUT_OK;
+	}
+	/* A bitmap cause carries no low class bit (ADR-0062 D2). */
+	if (cause_id & DADAO_CAUSE_MASK)
+		return DADAO_SUB_LAYOUT_FOREIGN;
+	if (bits & (bits - 1))
+		return DADAO_SUB_LAYOUT_SHAPE;
+	return DADAO_SUB_LAYOUT_OK;
+}
+
+#endif /* !__ASSEMBLY__ */
+#endif /* __ASM_DADAO_CAUSE_SUB_H */
