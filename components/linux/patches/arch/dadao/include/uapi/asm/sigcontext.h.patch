diff --git a/arch/dadao/include/uapi/asm/sigcontext.h b/arch/dadao/include/uapi/asm/sigcontext.h
new file mode 100644
index 000000000..22385ea17
--- /dev/null
+++ b/arch/dadao/include/uapi/asm/sigcontext.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef __ASM_SIGCONTEXT_H
+#define __ASM_SIGCONTEXT_H
+
+#include <uapi/asm/ptrace.h>
+
+/*
+ * The machine context a signal frame carries (m14-linux-046): the whole
+ * register file, `user_regs_struct` (2048 bytes), plus four reserved words for
+ * a future extension (a pointer-sized hole keeps the size a multiple of 16 and
+ * leaves room for an extension header without moving `uc_sigmask`).
+ *
+ * Where it sits: `struct sigcontext` is the `uc_mcontext` member of
+ * `struct ucontext` (<asm-generic/ucontext.h>), so `uc->uc_mcontext.regs`
+ * names this register file.  It is the *same* image the kernel keeps in
+ * `struct pt_regs`, field for field — that is what lets `rt_sigreturn` restore
+ * the interrupted context bit-for-bit, `ra` stack and FCSR included.
+ */
+struct sigcontext {
+	struct user_regs_struct regs;
+	unsigned long __unused[4];
+};
+
+#endif
