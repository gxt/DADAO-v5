diff --git a/arch/dadao/kernel/head.S b/arch/dadao/kernel/head.S
new file mode 100644
index 000000000..5d9e1d998
--- /dev/null
+++ b/arch/dadao/kernel/head.S
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO kernel entry — K1: own stack, boot info validation, start_kernel().
+ *
+ * Entered with (contract-linux-boot §5): supv, PTW on with the single-superpage
+ * table smon built, rb16 = entry VA, rb17 = boot info VA, rb1 (SP) undefined,
+ * asynchronous interrupts masked, every other register undefined.
+ *
+ * Steps:
+ *   1. set rb1 (SP) to the top of `early_stack` *before the first push*;
+ *   2. keep rb16/rb17 in dadao_entry_va/dadao_bootinfo_va so the C entry can
+ *      report the §5 handoff values it actually received;
+ *   3. clear __bss_start..__bss_stop (a raw image carries no .bss, §3.1
+ *      RAW-BSS);
+ *   4. validate the fixed 15-field boot info block of §4 (magic, version,
+ *      size) and hand a wrong block to dadao_bootinfo_reject(), which names
+ *      the field and stops through semihosting SYS_EXIT with a fixed code
+ *      (§3.3 FAIL-KERNEL);
+ *   5. jump to the C entry dadao_start_kernel(), which prints the parsed
+ *      fields and calls start_kernel().
+ *
+ * Failure codes are the guest FAIL segment of spec/Machine-v5 §7.1: 0x01-0x7f,
+ * value = check point index (0x01 magic, 0x02 version, 0x03 size; setup.c
+ * continues at 0x04).  They are <= 0x7f because the semihosting SYS_EXIT
+ * subcode IS the host process exit status: 0x100 would wrap to 0 and read as
+ * success.
+ *
+ * Semihosting convention (contract-semihosting §1/§2): the trap's immu18 only
+ * carries the fixed tag 0x3FF00; the service number goes in rd16 and the
+ * argument-block pointer in rb16.  The pointer is a *PA* because the responder
+ * reads guest memory through QEMU's identity debug translation on Vast (the
+ * same rule tests/shared/bootrom/k0/probe_kernel.S records for its exit block).
+ */
+
+#define FAIL_MAGIC	0x01
+#define FAIL_VERSION	0x02
+#define FAIL_SIZE	0x03
+
+	.section .head.text,"ax"
+	.globl _start
+	.p2align 4
+_start:
+	/* 1. Early stack: rb1 (SP) is undefined on entry. */
+	set.rb rb1, early_stack_top
+
+	/* 2. Keep the entry-state registers the ABI promises (§5). */
+	set.rb rb4, dadao_entry_va
+	st.o rb16, [rb4, 0]
+	set.rb rb4, dadao_bootinfo_va
+	st.o rb17, [rb4, 0]
+
+	/*
+	 * 3. Clear .bss.  br.eq compares two *rd* registers (SimRISC-06 §1),
+	 * so mirror the cursor and the bound into rd2/rd3 and advance both.
+	 */
+	set.rb rb2, __bss_start
+	set.rb rb3, __bss_stop
+	set.rd rd2, rb2
+	set.rd rd3, rb3
+.Lbss_loop:
+	br.eq {rd2, rd3}?, [rb0, .Lbss_done]
+	st.o rd0, [rb2, 0]
+	add.si rb2, 8
+	add.si rd2, 8
+	jump [rb0, .Lbss_loop]
+.Lbss_done:
+
+	/* 4a. magic == 0x4442_494e (offset 0x00, 4 B). */
+	ld.ut rd4, [rb17, 0]
+	set.zw rd5, wp1, 0x4442
+	or.w rd5, wp0, 0x494e
+	br.ne {rd4, rd5}?, [rb0, .Lfail_magic]
+
+	/* 4b. version == 1 (offset 0x04, 2 B). */
+	ld.uw rd6, [rb17, 4]
+	set.rd rd5, 1
+	br.ne {rd6, rd5}?, [rb0, .Lfail_version]
+
+	/* 4c. size >= 0x60 (offset 0x06, 2 B): larger blocks are allowed. */
+	ld.uw rd7, [rb17, 6]
+	add.si rd7, -0x60		/* rd7 = size - 0x60 */
+	br.n {rd7}?, [rb0, .Lfail_size]
+
+	/* 5. Enter C: first data argument rd16 / first address argument rb16. */
+	set.rb rb5, dadao_start_kernel
+	jump [rb5, rd0, 0]
+	.size _start, .-_start
+
+	/* 4x. Named rejections: code -> rd16, field name -> rb16 (§3.3). */
+.Lfail_magic:
+	set.rd rd16, FAIL_MAGIC
+	set.rb rb16, .Lstr_magic
+	set.rb rb5, dadao_bootinfo_reject
+	jump [rb5, rd0, 0]
+
+.Lfail_version:
+	set.rd rd16, FAIL_VERSION
+	set.rb rb16, .Lstr_version
+	set.rb rb5, dadao_bootinfo_reject
+	jump [rb5, rd0, 0]
+
+.Lfail_size:
+	set.rd rd16, FAIL_SIZE
+	set.rb rb16, .Lstr_size
+	set.rb rb5, dadao_bootinfo_reject
+	jump [rb5, rd0, 0]
+
+	/*
+	 * void __noreturn dadao_jump_on_stack(void *sp, void (*fn)(void))
+	 *
+	 * Switch to @sp and enter @fn.  The kernel boots on the static
+	 * early_stack above, which carries no thread_info, while `current` is
+	 * derived from SP (asm/current.h: the thread_info sits at the base of
+	 * the stack region, arch/dadao/include/asm/thread_info.h).  Function
+	 * arguments are the ABI's: rb16 = first address argument (SP),
+	 * rb17 = second (entry).
+	 */
+	.globl	dadao_jump_on_stack
+	.p2align 2
+dadao_jump_on_stack:
+	set.rb	rb1, rb16
+	jump	[rb17, rd0, 0]
+
+	.section .rodata,"a"
+.Lstr_magic:
+	.asciz	"magic"
+.Lstr_version:
+	.asciz	"version"
+.Lstr_size:
+	.asciz	"size"
+
+	.section .data,"aw"
+	.p2align 3
+	.globl dadao_entry_va
+dadao_entry_va:
+	.dd.o64 0		/* §5 rb16: entry VA */
+	.globl dadao_bootinfo_va
+dadao_bootinfo_va:
+	.dd.o64 0		/* §5 rb17: boot info VA */
+
+	.section .bss,"aw",%nobits
+	.p2align 4
+	.globl early_stack
+early_stack:
+	.zero 16384
+	.globl early_stack_top
+early_stack_top:
