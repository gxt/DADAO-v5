diff --git a/arch/dadao/kernel/semihost_tty.c b/arch/dadao/kernel/semihost_tty.c
new file mode 100644
index 000000000..04b760d71
--- /dev/null
+++ b/arch/dadao/kernel/semihost_tty.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Semihosting console character device (m18-linux-001, K6).
+ *
+ * The K6 boot path hands PID 1 to busybox `sh`, which needs a character
+ * device for stdin/stdout/stderr.  There is no UART and no VT on this
+ * machine: the console *is* the semihosting channel (contract-semihosting
+ * §2/§4), so `/dev/console` is a plain char device whose read/write are the
+ * SYS_READC / SYS_WRITEC traps.
+ *
+ * Why not a `struct tty_driver`?  TTY input is push-based: a driver feeds
+ * `tty_insert_flip_char()` from an interrupt or a kthread.  SYS_READC blocks
+ * the vCPU until a byte arrives (QEMU's semihosting console halts the CPU),
+ * so a polling kthread would freeze the very command the shell is running.
+ * Reading on demand -- inside the reader's `read(2)` -- keeps the machine
+ * runnable while a child (`ls`, ...) executes: the shell only calls read()
+ * when it is waiting for the next command line.
+ *
+ * Canonical-mode behaviour (the only mode this device implements) is done
+ * here: echo input, translate CR to NL, handle backspace/Ctrl-D, and return
+ * at the first newline.  The line discipline is deliberately not involved
+ * (`isatty(0)` is still true: TCGETS succeeds with a sane termios).
+ *
+ * Device node: `/dev/console` in the initramfs is `c 240 0`; the initramfs
+ * generator (`tools/linux/make_initramfs.py`) writes that node.
+ */
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/sched/signal.h>
+#include <linux/signal.h>
+#include <linux/termios.h>
+#include <linux/tty.h>
+#include <linux/uaccess.h>
+
+#include <asm/setup.h>
+
+#define SEMIHOST_CONSOLE_MAJOR	240
+#define SEMIHOST_CONSOLE_MINOR	0
+#define SEMIHOST_CONSOLE_NAME	"semihost-console"
+
+/* Ctrl-C has no line discipline to interpret it, so read() does. */
+#define CH_CTRL_C	0x03
+#define CH_CTRL_D	0x04
+#define CH_BS		0x08
+#define CH_DEL		0x7f
+
+static DEFINE_MUTEX(semihost_console_lock);
+
+/*
+ * One semihosting write.  `dadao_early_write()` walks a NUL-terminated kernel
+ * string and converts each byte's VA to a PA for the responder, so callers
+ * hand it a bounded, terminated chunk.
+ */
+static void emit(const char *s, size_t len)
+{
+	char buf[128];
+
+	while (len) {
+		size_t chunk = min(len, sizeof(buf) - 1);
+
+		memcpy(buf, s, chunk);
+		buf[chunk] = '\0';
+		dadao_early_write(buf);
+		s += chunk;
+		len -= chunk;
+	}
+}
+
+static void emit_char(char c)
+{
+	emit(&c, 1);
+}
+
+/*
+ * The line being assembled (m18-linux-004, ISS-497).
+ *
+ * Canonical mode means read() delivers at *least* one line and at most what
+ * the caller asked for: the driver keeps the unconsumed tail, so a caller with
+ * a one-byte buffer (`read_key`, a tty line editor) still gets one byte per
+ * call while the shell's 1 KiB `read()` gets the whole line.
+ *
+ * Why the driver and not the caller: `sh` reads its script with a 1 KiB
+ * `read()`; delivering the input one byte at a time made every command line a
+ * sequence of hundreds of separate read() returns, and that interleaving drove
+ * busybox's `_`-variable update into a mallocng double free (measured:
+ * `die-no-vma` inside `free()` after ~180 characters; the same command
+ * sequence read from a script file or a pipe — i.e. in line-sized returns —
+ * runs clean).  A tty never delivers a line that way, so the driver assembles
+ * it and hands it over whole.
+ */
+#define SEMIHOST_LINE_MAX	256
+
+static char semihost_line[SEMIHOST_LINE_MAX];
+static size_t semihost_line_len;
+static bool semihost_eof;
+
+static ssize_t semihost_console_read(struct file *file, char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	size_t n;
+	int c;
+	ssize_t ret;
+
+	if (!count)
+		return 0;
+	if (mutex_lock_interruptible(&semihost_console_lock))
+		return -ERESTARTSYS;
+
+	/* Assemble one line unless a previous read left part of one behind. */
+	if (!semihost_line_len) {
+		while (!semihost_eof) {
+			c = dadao_semihost_readc();
+			if (c < 0) {
+				ret = -EIO;
+				goto out;
+			}
+			if (c == CH_CTRL_D) {
+				/* End of input: deliver what is pending, then EOF. */
+				semihost_eof = true;
+				break;
+			}
+			if (c == CH_CTRL_C) {
+				/* ^C discards the pending line, exactly like a tty. */
+				semihost_line_len = 0;
+				emit("^C\n", 3);
+				kill_pgrp(task_pgrp(current), SIGINT, 1);
+				ret = -ERESTARTSYS;
+				goto out;
+			}
+			if (c == CH_BS || c == CH_DEL) {
+				/* Editing is the line discipline's job here, not the
+				 * reader's: erase the last byte and echo the erase. */
+				if (semihost_line_len) {
+					semihost_line_len--;
+					emit("\b \b", 3);
+				}
+				continue;
+			}
+			if (c == '\r')
+				c = '\n';
+			emit_char((char)c);
+			semihost_line[semihost_line_len++] = (char)c;
+			if (c == '\n' || semihost_line_len == sizeof(semihost_line))
+				break;
+		}
+	}
+
+	if (!semihost_line_len) {
+		ret = 0;			/* EOF (or a bare ^C/^D) */
+		goto out;
+	}
+	n = min(count, semihost_line_len);
+	if (copy_to_user(ubuf, semihost_line, n)) {
+		ret = -EFAULT;
+		goto out;
+	}
+	if (n < semihost_line_len)
+		memmove(semihost_line, semihost_line + n,
+			semihost_line_len - n);
+	semihost_line_len -= n;
+	ret = (ssize_t)n;
+out:
+	mutex_unlock(&semihost_console_lock);
+	return ret;
+}
+
+static ssize_t semihost_console_write(struct file *file,
+				      const char __user *ubuf, size_t count,
+				      loff_t *ppos)
+{
+	char buf[128];
+	size_t done = 0;
+
+	while (done < count) {
+		size_t chunk = min(count - done, sizeof(buf) - 1);
+
+		if (copy_from_user(buf, ubuf + done, chunk))
+			return done ? (ssize_t)done : -EFAULT;
+		buf[chunk] = '\0';
+		dadao_early_write(buf);
+		done += chunk;
+	}
+	return done;
+}
+
+static long semihost_console_ioctl(struct file *file, unsigned int cmd,
+				   unsigned long arg)
+{
+	struct termios t;
+	struct winsize ws;
+	int pgrp;
+
+	switch (cmd) {
+	case TCGETS:
+		memset(&t, 0, sizeof(t));
+		t.c_iflag = ICRNL | IXON;
+		t.c_oflag = OPOST | ONLCR;
+		t.c_cflag = CS8 | CREAD | B9600;
+		t.c_lflag = ISIG | ICANON | ECHO | ECHOE | ECHOK |
+			    ECHOCTL | ECHOKE | IEXTEN;
+		t.c_cc[VMIN] = 1;
+		t.c_cc[VTIME] = 0;
+		if (copy_to_user((void __user *)arg, &t, sizeof(t)))
+			return -EFAULT;
+		return 0;
+	case TCSETS:
+	case TCSETSW:
+	case TCSETSF:
+		/* One fixed mode; accept the user's copy silently. */
+		return 0;
+	case TIOCGWINSZ:
+		ws.ws_row = 24;
+		ws.ws_col = 80;
+		ws.ws_xpixel = 0;
+		ws.ws_ypixel = 0;
+		if (copy_to_user((void __user *)arg, &ws, sizeof(ws)))
+			return -EFAULT;
+		return 0;
+	case TIOCGPGRP:
+		pgrp = pid_vnr(task_pgrp(current));
+		if (put_user(pgrp, (int __user *)arg))
+			return -EFAULT;
+		return 0;
+	case TIOCSPGRP:
+		/* No job control: accept and ignore (K6 is foreground-only). */
+		return 0;
+	case FIONREAD:
+		if (put_user(0, (int __user *)arg))
+			return -EFAULT;
+		return 0;
+	case TCFLSH:
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static int semihost_console_open(struct inode *inode, struct file *file)
+{
+	return 0;
+}
+
+static int semihost_console_release(struct inode *inode, struct file *file)
+{
+	return 0;
+}
+
+static const struct file_operations semihost_console_fops = {
+	.owner		= THIS_MODULE,
+	.llseek		= noop_llseek,
+	.read		= semihost_console_read,
+	.write		= semihost_console_write,
+	.unlocked_ioctl	= semihost_console_ioctl,
+	.open		= semihost_console_open,
+	.release	= semihost_console_release,
+};
+
+static int __init semihost_console_dev_init(void)
+{
+	int ret = register_chrdev(SEMIHOST_CONSOLE_MAJOR, SEMIHOST_CONSOLE_NAME,
+				  &semihost_console_fops);
+
+	if (ret < 0) {
+		pr_err("semihost-console: register_chrdev(%d) failed: %d\n",
+		       SEMIHOST_CONSOLE_MAJOR, ret);
+		return ret;
+	}
+	return 0;
+}
+device_initcall(semihost_console_dev_init);
