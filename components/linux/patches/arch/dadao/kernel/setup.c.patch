--- /dev/null
+++ b/arch/dadao/kernel/setup.c
@@ -0,0 +1,476 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO kernel setup — K1: parse the fixed boot info block and enter
+ * start_kernel().
+ *
+ * The boot ABI is the fixed 15-field boot info block of contract-linux-boot
+ * §4 and the M1 entry state of §5.  head.S has already validated magic,
+ * version and size; this file reads the whole block (the 15 fields are
+ * reported below), checks the values K1 depends on, prints the handoff and
+ * calls start_kernel().
+ *
+ * K1 stops *inside* start_kernel(), before any subsystem, clock, timer or
+ * interrupt is initialised: init/main.c calls dadao_k1_early_stop() as the
+ * first statement of start_kernel() (CONFIG_DADAO_K1_EARLY_STOP), which
+ * reports the marker and exits through semihosting SYS_EXIT(0).  That is the
+ * K1 boundary (user ruling 2026-11-14); K2 turns the option off and
+ * setup_arch() below takes over.
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/start_kernel.h>
+#include <linux/string.h>
+#include <linux/console.h>
+#include <linux/seq_file.h>
+#include <linux/types.h>
+
+#include <asm/setup.h>
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm/ptw.h>
+#include <asm/processor.h>
+#include <asm/ptrace.h>
+#include <asm/switch_to.h>
+#include <asm/thread_info.h>
+#include <asm/time.h>
+
+/*
+ * Self-check codes for the fields only this file can judge: the guest FAIL
+ * segment of spec/Kaiwu §7.1 (0x01-0x7f, value = check point index).
+ * head.S carries 0x01/0x02/0x03 for magic/version/size, so this file starts
+ * at 0x04.  The values also stay <= 0x7f because the semihosting SYS_EXIT
+ * subcode is the host process exit status (0x100 would wrap to 0 and read as
+ * PASS).
+ */
+#define FAIL_HART_ID		0x04	/* hart_id != 0 (single hart) */
+#define FAIL_PAGE_SHIFT		0x05	/* page_size_log2 != PAGE_SHIFT */
+#define FAIL_KERNEL_BASE	0x06	/* kernel_base != the linked entry */
+#define FAIL_IMAGE_RANGE	0x07	/* [kernel_base, +kernel_size) outside RAM */
+#define FAIL_NOT_START_KERNEL	0x08	/* the marker is not inside start_kernel() */
+
+/* Linker-provided: the entry point head.S is linked at (contract §3.1), and
+ * the image ends at `_end` (vmlinux.lds.S). */
+extern char _start[];
+extern char _end[];
+
+/*
+ * Return address of the current function.  DADAO keeps it on the RAS, not in
+ * a link register (SimRISC-06 §3: `call` pushes the return address onto
+ * ra63), and clang's __builtin_return_address() is not implemented for this
+ * target -- it folds to 0.  Read the RAS top before this function makes any
+ * call of its own.
+ */
+static inline unsigned long dadao_return_address(void)
+{
+	unsigned long ra;
+
+	__asm__ __volatile__("ra2rd {%0}, {ra63}" : "=r"(ra));
+	return ra & 0x0000ffffffffffffUL;	/* [47:0]; [63:48] is the RAS depth */
+}
+
+static struct dadao_boot_info boot_info;
+static unsigned long boot_info_va;
+
+/* RAM window base/size in PA (the boot info carries VAs). */
+unsigned long dadao_ram_base;
+unsigned long dadao_ram_size;
+
+/*
+ * The boot info parse itself: copy the 15 fields out of the block (a VA) and
+ * reject the values K1 relies on when they disagree with the build.  It has no
+ * output of its own so setup_arch() can call it again after K2 resumes.
+ */
+static void __init dadao_parse_boot_info(void)
+{
+	const struct dadao_boot_info *bi =
+		(const struct dadao_boot_info *)boot_info_va;
+
+	memcpy(&boot_info, bi, sizeof(boot_info));
+
+	if (boot_info.hart_id != 0)
+		dadao_bootinfo_reject(FAIL_HART_ID, "hart_id");
+	if (boot_info.page_size_log2 != PAGE_SHIFT)
+		dadao_bootinfo_reject(FAIL_PAGE_SHIFT, "page_size_log2");
+	if (boot_info.kernel_base != (unsigned long)_start)
+		dadao_bootinfo_reject(FAIL_KERNEL_BASE, "kernel_base");
+	if (boot_info.kernel_size > boot_info.ram_size ||
+	    boot_info.kernel_base < boot_info.ram_base ||
+	    boot_info.kernel_base + boot_info.kernel_size >
+		    boot_info.ram_base + boot_info.ram_size)
+		dadao_bootinfo_reject(FAIL_IMAGE_RANGE, "kernel_size");
+
+	dadao_ram_base = (unsigned long)__pa(boot_info.ram_base);
+	dadao_ram_size = boot_info.ram_size;
+}
+
+/* The 15 fields, as the kernel read them (independently of the host's view). */
+static void __init dadao_report_boot_info(void)
+{
+	dadao_early_printf("K1 bootinfo magic=%#x version=%#x size=%#x hart=%lu\n",
+			   boot_info.magic, boot_info.version,
+			   boot_info.size, (unsigned long)boot_info.hart_id);
+	dadao_early_printf("K1 bootinfo kernel_base=%#lx kernel_size=%#lx ram_base=%#lx ram_size=%#lx\n",
+			   (unsigned long)boot_info.kernel_base,
+			   (unsigned long)boot_info.kernel_size,
+			   (unsigned long)boot_info.ram_base,
+			   (unsigned long)boot_info.ram_size);
+	dadao_early_printf("K1 bootinfo initramfs=%#lx+%#lx cmdline=%#lx+%#lx ptbr=%#lx page_size_log2=%#x flags=%#lx\n",
+			   (unsigned long)boot_info.initramfs_base,
+			   (unsigned long)boot_info.initramfs_size,
+			   (unsigned long)boot_info.cmdline_base,
+			   (unsigned long)boot_info.cmdline_size,
+			   (unsigned long)boot_info.ptbr,
+			   boot_info.page_size_log2,
+			   (unsigned long)boot_info.flags);
+}
+
+/* C entry from head.S (rb16/rb17 saved in dadao_entry_va/dadao_bootinfo_va). */
+void __init __noreturn dadao_start_kernel(void)
+{
+	unsigned long sp = dadao_stack_pointer();
+
+	boot_info_va = dadao_bootinfo_va;
+
+	dadao_parse_boot_info();
+	dadao_report_boot_info();
+
+	/*
+	 * Stack evidence: rb1 (SP) was undefined on entry; it now points into
+	 * the early stack head.S built in .bss, and the §5 entry VA (rb16) is
+	 * still readable.
+	 */
+	dadao_early_printf("K1 stack sp=%#lx early_stack=%#lx..%#lx entry_va=%#lx\n",
+			   sp, (unsigned long)early_stack,
+			   (unsigned long)early_stack_top, dadao_entry_va);
+
+	/*
+	 * K1 page-table ownership: install the supv exception vector first (a
+	 * fault during the switch must be reportable), then build and install
+	 * the kernel's own L1 table.  From here on both the instruction stream
+	 * and every data access go through it.
+	 */
+	dadao_supv_vector_install();
+	dadao_k1_pt_init();
+
+	/*
+	 * Leave the static early stack for the init task's stack.  `current` is
+	 * derived from SP (asm/current.h: thread_info at the base of the stack
+	 * region), so anything that reads `current` — printk's caller id, the
+	 * scheduler — needs SP inside a task stack.  The init stack's base
+	 * carries `init_thread_info` (include/asm-generic/vmlinux.lds.h
+	 * INIT_TASK_DATA), i.e. exactly the thread_info this port expects.
+	 */
+	/*
+	 * K4 keeps the top `sizeof(struct pt_regs)` of the init task's stack
+	 * free: that is where a task's saved context lives (task_pt_regs()) and
+	 * where `current_pt_regs()` reads it, and a kernel stack that starts at
+	 * the very top would let the first call frame overwrite the saved
+	 * context of the task it belongs to.  K1-K3 never looked at a saved
+	 * frame, so the difference is invisible until fork.
+	 */
+	dadao_jump_on_stack((char *)init_stack + THREAD_SIZE -
+				    sizeof(struct pt_regs),
+			    start_kernel);
+}
+
+/*
+ * K1 boundary (CONFIG_DADAO_K1_EARLY_STOP): the first statement of
+ * start_kernel().  Being here *is* the proof that the kernel reached
+ * start_kernel(); the return address is the call site inside it, so it is
+ * reported and checked against the start_kernel() symbol.  Nothing has been
+ * initialised at this point: no clock, no timer, no interrupt.
+ */
+void __init __noreturn dadao_k1_early_stop(void)
+{
+	unsigned long ra = dadao_return_address();
+	unsigned long base = (unsigned long)start_kernel;
+	unsigned long sp = dadao_stack_pointer();
+	/*
+	 * 4 KiB slack: start_kernel() is far smaller than that; the evidence
+	 * harness independently bounds @ra by the next System.map symbol.
+	 */
+	bool inside = ra >= base && ra < base + 0x1000;
+
+	dadao_early_printf("start_kernel\n");
+	dadao_early_printf("K1 start_kernel ra=%#lx base=%#lx off=%#lx sp=%#lx inside=%s\n",
+			   ra, base, ra - base, sp, inside ? "yes" : "no");
+	if (!inside)
+		dadao_bootinfo_reject(FAIL_NOT_START_KERNEL, "start_kernel");
+
+	dadao_early_printf("K1 done: semihosting SYS_EXIT(0) before any clock/interrupt init\n");
+	dadao_early_exit(0);
+}
+
+void __init setup_arch(char **cmdline_p)
+{
+	/* start_kernel() calls this after K1's stop; the parse is idempotent. */
+	dadao_parse_boot_info();
+
+	memblock_add(dadao_ram_base, dadao_ram_size);
+	/*
+	 * Reserve the kernel image.  K1-K3 never allocated from RAM (the page
+	 * fault channel took pages off the top and nothing else asked), so the
+	 * omission was invisible; the first `alloc_page()` after mm_core_init()
+	 * hands out live text otherwise -- K4 allocated PA 0x100000 (`_text`)
+	 * for a data page and the next function call executed the overwrite.
+	 * The early stack, page tables and boot info live inside this span too
+	 * (the image's .bss and the smon-built tables start above `_end`); the
+	 * tables are covered by the reserve below.
+	 */
+	memblock_reserve((unsigned long)__pa(_start),
+			 (unsigned long)(__pa(_end) - __pa(_start)));
+
+	/*
+	 * Hand the same window to the generic page allocator: memblock knows the
+	 * memory, but `memblock_free_all()` only frees [0, max_low_pfn), so the
+	 * arch has to publish the range (K4).  K3 never got past setup_arch(),
+	 * so nothing below ever asked -- without these the buddy allocator owns
+	 * no page and the first slab cache panics.
+	 */
+	max_pfn = PFN_DOWN(dadao_ram_base + dadao_ram_size);
+	max_low_pfn = max_pfn;
+	min_low_pfn = PFN_UP(dadao_ram_base);
+
+	/* No DTB, no command line (contract-linux-boot §4). */
+	*cmdline_p = boot_command_line;
+
+	paging_init();
+
+	dadao_early_printf("K2 setup_arch: memblock_add ram=%#lx size=%#lx cmdline=%#lx\n",
+			   dadao_ram_base, dadao_ram_size,
+			   (unsigned long)*cmdline_p);
+
+#ifdef CONFIG_DADAO_K3_PT_SELFTEST
+	/* K3 page-table/TLB self-test: builds an L2 table through the primitives,
+	 * runs the TLB command matrix and ends the boot (probe image only). */
+	dadao_k3_pt_selftest();
+#endif
+
+/*
+ * The K3 page-fault cases moved to dadao_k4_boundary(): their page source is
+ * the buddy allocator now (m14-linux-016), which does not exist yet here.  The
+ * cases themselves did not change.
+ */
+
+#ifdef CONFIG_DADAO_K2_EARLY_STOP
+	dadao_k2_boundary();
+#endif
+#ifdef CONFIG_DADAO_K2_TIME_STOP
+	dadao_k2_time_boundary();
+#endif
+}
+
+/*
+ * The K4 boundary: the point where the generic kernel has an allocator, a
+ * scheduler data structure and a task model, but has not started a second task
+ * (that needs the context switch of m14-linux-017) and has no initramfs yet
+ * (that needs kernel_init, i.e. the same switch).
+ *
+ * K4's job here: bring up the page-fault channel's *real* page source — the
+ * shared zero page has to come from the buddy allocator once, and the fault
+ * handler then allocates from it — and, in a probe image, run the K4 self-test
+ * (kernel/k4_selftest.c) and the K3 channel cases, which can only run once the
+ * allocator exists.
+ *
+ * The milestone image ends here for now and says so by name; continuing to a
+ * user-mode `init` is the K4 tail that needs m14-linux-017 (switch_mm /
+ * __switch_to) and m14-linux-021 (clockevent tick), see the task book.
+ */
+void __init dadao_k4_boundary(void)
+{
+	dadao_pf_init();
+	/*
+	 * K4: the user-mode entry rows (contract-syscall §8).  Installed here —
+	 * not in `trap_init()`, whose weak body in init/main.c is inlined away,
+	 * and not next to the supv vector, where the kernel still runs on the
+	 * prebuilt table.  The firmware (m14-testcases-006) hands every cfx's
+	 * supv four-axis permission to smon, which is what makes the kernel's
+	 * `cfx_umon` accesses legal; the kernel opens its own source bit in
+	 * `cfx_smon` for the U-mode page-fault hand-over.
+	 */
+	dadao_user_entry_install();
+	dadao_early_printf("K4 boundary: alloc=%lu zero=%#lx mm=%#lx\n",
+			   dadao_pf_alloc_count(), dadao_pf_zero_page_pa(),
+			   (unsigned long)(current->mm ? 1 : 0));
+
+#if CONFIG_DADAO_K3_PF_SELFTEST
+	/* The channel's cases, now with the allocator behind them. */
+	dadao_k3_pf_selftest();
+#endif
+#ifdef CONFIG_DADAO_K4_SELFTEST
+	dadao_k4_selftest();
+#endif
+#if CONFIG_DADAO_K4_STACK_SELFTEST
+	/* User-stack growth cases (m14-linux-019's S1-S6): every case ends the
+	 * boot, because "did not grow" is a named termination. */
+	dadao_k4_stack_selftest();
+#endif
+#if CONFIG_DADAO_K4_COW_SELFTEST
+	/* Copy-on-write cases (m14-linux-018's W1-W5): the recoverable ones run
+	 * one boot and exit 0; W3 ends the boot by name. */
+	dadao_k4_cow_selftest();
+#endif
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	/*
+	 * The context-switch probe does not stop here: F3 is the initramfs
+	 * `/init` run, which only happens when the boot continues through
+	 * `rest_init()` -> `kernel_init()` -> `execve("/init")`.  The probe's
+	 * syscall hook owns the verdict and the final SYS_EXIT.
+	 */
+	dadao_k4_switch_selftest();
+	return;
+#endif
+#ifdef CONFIG_DADAO_K4_KTHREAD_SELFTEST
+	/*
+	 * The kernel-thread probe (m14-linux-020) does not stop here either:
+	 * `kthreadd` and the threads it creates only exist after `rest_init()`,
+	 * so the probe runs inside `kernel_init` (init/main.c) and owns the
+	 * final SYS_EXIT there.
+	 */
+	return;
+#endif
+#ifdef CONFIG_DADAO_K5_SYSCALL_SELFTEST
+	/*
+	 * The syscall probe (m14-linux-023) is the same shape: its user
+	 * program needs the initramfs and the VFS, so it runs from a
+	 * `late_initcall` inside `kernel_init` (kernel/k5_syscall_selftest.c)
+	 * and owns the final SYS_EXIT there.
+	 */
+	return;
+#endif
+#ifdef CONFIG_DADAO_K5_FUTEX_SELFTEST
+	/*
+	 * The futex/atomic probe (m14-linux-025) runs where the clone probe
+	 * does — from a `late_initcall` inside `kernel_init`, once the futex
+	 * hash and the initramfs exist (kernel/k5_futex_selftest.c) — and owns
+	 * the final SYS_EXIT.
+	 */
+	return;
+#endif
+#ifdef CONFIG_DADAO_K5_CLONE_SELFTEST
+	/*
+	 * The clone/thread probe (m14-linux-024) is that shape too, and for one
+	 * more reason: its `clone()` calls need the futex hash, which only
+	 * exists after the initcalls.  It runs from a `late_initcall` inside
+	 * `kernel_init` (kernel/k5_clone_selftest.c) and owns the final SYS_EXIT.
+	 */
+	return;
+#endif
+#ifdef CONFIG_DADAO_M45_ENTRY_SELFTEST
+	/*
+	 * The entry/exit work-loop probe (m14-linux-045) needs the same things
+	 * the K5 probes do — a task model that can switch and an address space
+	 * of its own — and it starts the periodic tick itself, so it also runs
+	 * from a `late_initcall` inside `kernel_init`
+	 * (kernel/m45_entry_selftest.c) and owns the final SYS_EXIT.
+	 */
+	return;
+#endif
+#ifdef CONFIG_DADAO_K5_SIGNAL_SELFTEST
+	/*
+	 * The signal-frame probe (m14-linux-046) is the same shape: its user
+	 * program needs a task, an address space and the umon entry, so it runs
+	 * from a `late_initcall` inside `kernel_init`
+	 * (kernel/k5_signal_selftest.c) and owns the final SYS_EXIT.
+	 */
+	return;
+#endif
+	dadao_early_printf("K4 done: semihosting SYS_EXIT(0) at the K4 boundary "
+			   "(process model + fault channel page source; no scheduler, "
+			   "no initramfs)\n");
+	dadao_early_exit(0);
+}
+
+/*
+ * The K2 boundary (CONFIG_DADAO_K2_EARLY_STOP): the kernel has run setup_arch()
+ * — the boot info was parsed, RAM handed to memblock, the page table adopted —
+ * and the supv synchronous-exception channel is installed and (optionally)
+ * exercised.  Nothing that needs a clock, a timer or an interrupt controller
+ * has run yet, which is exactly the K2 boundary: m14-linux-007 attaches the
+ * timer (kernel/time.c + kernel/irq.c, reached through CONFIG_DADAO_K2_TIME_STOP
+ * below), m14-linux-008 the interrupt enable/mask path.
+ */
+void __init __noreturn dadao_k2_boundary(void)
+{
+	dadao_cause_report();
+#ifdef CONFIG_DADAO_K2_TRAP_SELFTEST
+	dadao_k2_selftest();
+#endif
+	dadao_early_printf("K2 done: semihosting SYS_EXIT(0) at the K2 boundary "
+			   "(no clock/timer/IRQ)\n");
+	dadao_early_exit(0);
+}
+
+/* /proc/cpuinfo: one line describing the hart (K1: hart 0 only). */
+static void *cpuinfo_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos ? NULL : SEQ_START_TOKEN;
+}
+
+static void *cpuinfo_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return NULL;
+}
+
+static void cpuinfo_stop(struct seq_file *m, void *v)
+{
+}
+
+static int cpuinfo_show(struct seq_file *m, void *v)
+{
+	seq_printf(m, "processor\t: 0\n"
+		   "hart\t\t: 0\n"
+		   "mmu\t\t: 64 KiB pages, 2-level table\n");
+	return 0;
+}
+
+const struct seq_operations cpuinfo_op = {
+	.start	= cpuinfo_start,
+	.next	= cpuinfo_next,
+	.stop	= cpuinfo_stop,
+	.show	= cpuinfo_show,
+};
+
+void __init trap_init(void)
+{
+	/*
+	 * The supv vector is installed in dadao_start_kernel(), before the kernel
+	 * switches to its own page table (a fault during the switch has to be
+	 * reportable).  K4 adds the *other* direction: the rows a user-mode entry
+	 * uses (contract-syscall §8 — the firmware only opens the source masks,
+	 * the kernel writes the entry registers itself).
+	 */
+	/*
+	 * Nothing here: `trap_init()` is `__weak` and empty in init/main.c — the
+	 * same translation unit as start_kernel() — so the compiler inlines the
+	 * empty body there and the call site disappears even when this file
+	 * supplies a strong definition (verified on this toolchain: start_kernel
+	 * carries no call to `trap_init`).  K4's user-mode entry rows are
+	 * therefore installed next to the supv vector, in dadao_start_kernel().
+	 */
+}
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp)
+{
+	memset(regs, 0, sizeof(*regs));
+	regs->ip = pc;
+	regs->rb[1] = sp;
+	regs->rb[3] = 0;
+	/* m14-linux-045: the frame describes a *user* context; the entry stubs
+	 * refresh it from the hardware on every exception. */
+	regs->status = DADAO_STATUS_USER;
+}
+
+void flush_thread(void)
+{
+}
+
+void release_thread(struct task_struct *dead_task)
+{
+}
