+.Lk5c_fork_child:
+	rb2rd	rd23, rb3, 1		/* rbtp inherited from the parent */
+	trap	cfx_umon, K5C_TRAP_FORKCHILD_REPORT
+	set.rd	rd16, 0
+	set.rd	rd15, 93		/* __NR_exit */
+	trap	cfx_umon, 0
+.Lk5c_park:
+	jump	[rb0, .Lk5c_park]	/* no path returns here */
+dadao_k5c_user_stub_end:
+#endif
