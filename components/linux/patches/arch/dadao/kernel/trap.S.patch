+	st.t	rd0, [rb10, K5F_W_F5A]
+	st.t	rd0, [rb10, K5F_W_F5B]
+	set.rd	rd12, K5F_DATA_VA + K5F_W_F5A
+	set.rd	rd16, K5F_CLONE_FLAGS
+	set.rd	rd17, K5F_STACK_TOP(7)
+	set.rd	rd18, K5F_SCRIPT_REQUEUE
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1
+	rd2rb	rb17, rd14, 1
+	set.rd	rd15, K5F_SYS_CLONE
+	trap	cfx_umon, 0
+	br.z	{rd8}?, [rb0, .Lk5f_child]
+	rd2rd	rd21, rd8, 1
+	set.rd	rd22, K5F_SCRIPT_REQUEUE
+	trap	cfx_umon, K5F_TRAP_REG
+	trap	cfx_umon, K5F_TRAP_ARM
+	/* FUTEX_REQUEUE(F5A, nr_wake=0, F5B, nr_requeue=1).
+	 *
+	 * `nr_requeue` travels in the **4th** argument: for the commands that
+	 * take no timespec that slot is `val2`, an integer the kernel casts out
+	 * of the pointer (futex(2): "avoid using this operation" — but musl and
+	 * glibc both pass it this way, e.g. `(void *)INT_MAX`).  The slot is an
+	 * address argument (rb17) by the syscall's argmask, so the integer is
+	 * loaded into the RB bank. */
+	set.rb	rb16, K5F_DATA_VA + K5F_W_F5A
+	set.rd	rd16, K5F_OP_REQUEUE_PRIVATE
+	set.rd	rd17, 0
+	set.rb	rb17, 1
+	set.rb	rb18, K5F_DATA_VA + K5F_W_F5B
+	set.rd	rd18, 0
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_F5A
+	set.rb	rb16, K5F_DATA_VA + K5F_W_F5B
+	set.rd	rd16, K5F_OP_WAKE_PRIVATE
+	set.rd	rd17, 1
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, 0
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd22, rd8, 1
+	trap	cfx_umon, K5F_TRAP_F5B
+
+	/* ---- F6: the bitset decides the match ------------------------------ */
+	st.t	rd0, [rb10, K5F_W_F6]
+	set.rd	rd12, K5F_DATA_VA + K5F_W_F6
+	set.rd	rd16, K5F_CLONE_FLAGS
+	set.rd	rd17, K5F_STACK_TOP(8)
+	set.rd	rd18, K5F_SCRIPT_BITSET
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1
+	rd2rb	rb17, rd14, 1
+	set.rd	rd15, K5F_SYS_CLONE
+	trap	cfx_umon, 0
+	br.z	{rd8}?, [rb0, .Lk5f_child]
+	rd2rd	rd21, rd8, 1
+	set.rd	rd22, K5F_SCRIPT_BITSET
+	trap	cfx_umon, K5F_TRAP_REG
+	trap	cfx_umon, K5F_TRAP_ARM
+	/* FUTEX_WAKE_BITSET(F6, 1, a bitset that shares no bit) */
+	set.rb	rb16, K5F_DATA_VA + K5F_W_F6
+	set.rd	rd16, K5F_OP_WAKE_BITSET_PRIV
+	set.rd	rd17, 1
+	set.rd	rd14, 0
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, K5F_F6_OTHER
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_F6A
+	/* ... and the matching one */
+	set.rb	rb16, K5F_DATA_VA + K5F_W_F6
+	set.rd	rd16, K5F_OP_WAKE_BITSET_PRIV
+	set.rd	rd17, 1
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, K5F_F6_BITS
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd22, rd8, 1
+	trap	cfx_umon, K5F_TRAP_F6B
+
+	/* ---- F8: WAKE_OP — the arch atomic RMW (lr/sc) end to end --------- */
+	st.t	rd0, [rb10, K5F_W_WAKEOP_A]
+	set.rd	rd6, 0x10
+	st.t	rd6, [rb10, K5F_W_WAKEOP_B]
+	set.rd	rd12, K5F_DATA_VA + K5F_W_WAKEOP_A
+	set.rd	rd16, K5F_CLONE_FLAGS
+	set.rd	rd17, K5F_STACK_TOP(9)
+	set.rd	rd18, K5F_SCRIPT_WAIT_F1
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1
+	rd2rb	rb17, rd14, 1
+	set.rd	rd15, K5F_SYS_CLONE
+	trap	cfx_umon, 0
+	br.z	{rd8}?, [rb0, .Lk5f_child]
+	rd2rd	rd21, rd8, 1
+	set.rd	rd22, K5F_SCRIPT_WAIT_F1
+	trap	cfx_umon, K5F_TRAP_REG
+	trap	cfx_umon, K5F_TRAP_ARM
+	/* FUTEX_WAKE_OP(A, nr_wake=1, nr_wake2=0, B, encoded op) */
+	set.rb	rb16, K5F_DATA_VA + K5F_W_WAKEOP_A
+	set.rd	rd16, K5F_OP_WAKE_OP_PRIV
+	set.rd	rd17, 1
+	set.rb	rb17, 0			/* nr_wake2 (4th-argument integer) */
+	set.rb	rb18, K5F_DATA_VA + K5F_W_WAKEOP_B
+	set.rd	rd18, K5F_WAKEOP_ARG
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1		/* waiters woken */
+	ld.ut	rd4, [rb10, K5F_W_WAKEOP_B]
+	rd2rd	rd22, rd4, 1		/* the RMW: 0x10 + 1 */
+	trap	cfx_umon, K5F_TRAP_F8
+
+	/* ---- F7: CLONE_CHILD_CLEARTID clears the exiting thread's tid ----- */
+	st.t	rd0, [rb10, K5F_W_F7]
+	set.rd	rd16, K5F_CLONE_FLAGS + K5F_CLONE_CHILD_CLEARTID
+	set.rd	rd17, K5F_STACK_TOP(9)
+	set.rd	rd18, K5F_SCRIPT_EXITNOW
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1
+	set.rb	rb17, K5F_DATA_VA + K5F_W_F7	/* child_tidptr (2nd address arg) */
+	set.rd	rd15, K5F_SYS_CLONE
+	trap	cfx_umon, 0
+	br.z	{rd8}?, [rb0, .Lk5f_child]
+	rd2rd	rd21, rd8, 1			/* the child's tid */
+	set.rd	rd22, K5F_SCRIPT_EXITNOW
+	trap	cfx_umon, K5F_TRAP_REG
+	st.t	rd21, [rb10, K5F_W_F7]		/* the word holds the tid */
+	trap	cfx_umon, K5F_TRAP_F7		/* park till that child exits */
+	trap	cfx_umon, K5F_TRAP_DONE
+	jump	[rb0, .Lk5f_park]
+
+	/* ---- the children ------------------------------------------------- */
+.Lk5f_child:
+	rb2rd	rd5, rb3, 1		/* CLONE_SETTLS put the script here */
+	set.rd	rd9, K5F_SCRIPT_WAIT_F1
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_wait]
+	set.rd	rd9, K5F_SCRIPT_ATOMIC
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_atomic]
+	set.rd	rd9, K5F_SCRIPT_REQUEUE
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_requeue]
+	set.rd	rd9, K5F_SCRIPT_BITSET
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_bitset]
+	set.rd	rd9, K5F_SCRIPT_CMPXCHG
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_cmpxchg]
+	set.rd	rd9, K5F_SCRIPT_EXITNOW
+	br.eq	{rd5, rd9}?, [rb0, .Lk5f_s_exitnow]
+	jump	[rb0, .Lk5f_park]
+
+	/* FUTEX_WAIT(word, 0) — the expected value is the zero the parent
+	 * stored before creating the thread. */
+.Lk5f_s_wait:
+	rd2rb	rb16, rd12, 1
+	set.rd	rd16, K5F_OP_WAIT_PRIVATE
+	set.rd	rd17, 0
+	set.rd	rd14, 0
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, 0
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+	/* read the word, let the hook change it, then WAIT for the value read */
+.Lk5f_s_atomic:
+	rd2rb	rb5, rd12, 1
+	ld.ut	rd5, [rb5, 0]
+	trap	cfx_umon, K5F_TRAP_PRE_WAIT
+	rd2rb	rb16, rd12, 1
+	set.rd	rd16, K5F_OP_WAIT_PRIVATE
+	rd2rd	rd17, rd5, 1
+	set.rd	rd14, 0
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, 0
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+	/* FUTEX_WAIT on the first word; the parent requeues it to the second */
+.Lk5f_s_requeue:
+	rd2rb	rb16, rd12, 1
+	set.rd	rd16, K5F_OP_WAIT_PRIVATE
+	set.rd	rd17, 0
+	set.rd	rd14, 0
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, 0
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+	/* FUTEX_WAIT_BITSET with a bitset the first wake does not match */
+.Lk5f_s_bitset:
+	rd2rb	rb16, rd12, 1
+	set.rd	rd16, K5F_OP_WAIT_BITSET_PRIV
+	set.rd	rd17, 0
+	set.rd	rd14, 0
+	rd2rb	rb17, rd14, 1
+	rd2rb	rb18, rd14, 1
+	set.rd	rd18, K5F_F6_BITS
+	set.rd	rd24, K5F_F6_BITS	/* what it sent, for the report */
+	set.rd	rd15, K5F_SYS_FUTEX
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+	/* the F3 peer: one cmpxchg of the word from 0 to its own value */
+.Lk5f_s_cmpxchg:
+	rd2rb	rb5, rd12, 1
+	lr.t.nn	rd2, [rb5]
+	rd2rd	rd21, rd2, 1		/* the value it saw */
+	set.rd	rd9, 0
+	cmp.uo	rd8, rd2, rd9
+	br.ne	{rd8, rd9}?, [rb0, .Lk5f_cx_skip]
+	set.rd	rd3, K5F_F3_TVAL
+	sc.t.nn	rd7, rd3, [rb5]
+	rd2rd	rd22, rd7, 1		/* 0 = stored */
+	jump	[rb0, .Lk5f_cx_done]
+.Lk5f_cx_skip:
+	set.rd	rd22, 2			/* no store: the compare failed */
+.Lk5f_cx_done:
+	ld.ut	rd4, [rb10, K5F_W_F3]
+	rd2rd	rd23, rd4, 1
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+	/* F7's child: report, then exit.  The exit is what runs mm_release(). */
+.Lk5f_s_exitnow:
+	trap	cfx_umon, K5F_TRAP_REPORT
+	jump	[rb0, .Lk5f_child_exit]
+
+.Lk5f_child_exit:
+	set.rd	rd16, 0
+	set.rd	rd15, K5F_SYS_EXIT
+	trap	cfx_umon, 0		/* does not return */
+.Lk5f_park:
+	jump	[rb0, .Lk5f_park]	/* no path returns here */
+dadao_k5f_user_stub_end:
+#endif
