+#define K5F_F4_MARK		0x5a5a5a5a
+#define K5F_F4_STORE		0x77777777
+#define K5F_F3_PVAL		0x3333cafe
+#define K5F_F3_TVAL		0x33330f0f
+#define K5F_F2_WAKE		2
+#define K5F_F6_BITS		0x2
+#define K5F_F6_OTHER		0x1
