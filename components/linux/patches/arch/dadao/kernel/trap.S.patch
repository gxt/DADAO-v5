diff --git a/arch/dadao/kernel/trap.S b/arch/dadao/kernel/trap.S
new file mode 100644
index 000000000..077a20963
--- /dev/null
+++ b/arch/dadao/kernel/trap.S
@@ -0,0 +1,1680 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO supv synchronous-exception vector (K2).
+ *
+ * Every synchronous exception taken in supv mode enters cfx_smon — the supv
+ * monitor — as its first handler (spec/DADAO-12 §5.2) and is dispatched to
+ * `cfx_smon.supv_excp_vector` (§5.2 step 7).  This stub is that vector's first
+ * half: it captures the complete faulting context, hands it to
+ * dadao_trap_handler() and turns the handler's resume policy back into the
+ * `escape` that leaves the frame.
+ *
+ * Frame (arch/dadao/include/asm/ptrace.h, `struct pt_regs`):
+ *
+ *   PT_RD_BASE                 frame.rd[0..63]   rd0 unused (reads as zero)
+ *   PT_RB_BASE                 frame.rb[0..63]   rb0 unused (read-only IP)
+ *   PT_IP                      excp_cause_ip
+ *   PT_STATUS                  0 (no status register on this machine)
+ *   PT_RA_BASE                 frame.ra[0..63]   ra0 = {RACNT, MRPTR}
+ *   PT_RF_BASE                 frame.rf[0..63]   rf0 = FCSR
+ *
+ * The hardware saves **only** the cg5 frame fields — no general register at
+ * all (§3.6, contract-syscall §8) — so every register the faulting context may
+ * be using has to be captured here, *before* this stub touches anything:
+ * rd1-rd63 and rb1-rb63 (rd0 is hardwired zero and rb0 is the read-only IP, so
+ * neither is part of the frame), and both special banks — the return-address
+ * stack (spec/SimRISC-00 §2.4: entering and leaving an exception must not
+ * change ra0-ra63, yet the handler legitimately uses call/ret — k2_selftest.c's
+ * P12 measures both the captured frame and the restored bank, four passes with
+ * different feature values) and the floating-point file with its FCSR at rf0
+ * (§2.3).
+ *
+ * The capture/restore sequence itself — where the frame lives and why it cannot
+ * be the faulting stack, the `rb3`/`rd2`/`rd3` bootstrap through the cfx_smon
+ * cg6 scratch registers (§3.7) and the `stm.o`/`ldm.o` block layout
+ * (spec/SimRISC-01 §1/§2) — is `DADAO_GPR_SAVE`/`DADAO_GPR_RESTORE` in
+ * asm/entry.h, shared with the cfx_hart asynchronous stub (kernel/async_trap.S)
+ * which needs exactly the same sequence.
+ */
+#include <asm/asm-offsets.h>
+#include <asm/cfx.h>
+#include <asm/entry.h>
+#include <asm/trap.h>
+
+/*
+ * Restore the whole register file from the static frame and escape by @offset.
+ * The save/restore sequence itself is asm/entry.h's (shared with the
+ * asynchronous stub of kernel/async_trap.S).
+ */
+	.macro	DADAO_TRAP_RESTORE_AND_ESCAPE offset
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	/*
+	 * Diagnostic (m14-linux-017 only): record the cg5 frame the escape is
+	 * about to use.  rd30/rb31 are dead here (the restore below reloads
+	 * them from the frame), so recording costs nothing but two stores.
+	 * `dadao_supv_diag` = {cause_id, cause_ip, prev_run_mode, returns+1}.
+	 */
+	cfx2rd	cfx_smon, cg5, rc2, rd30
+	set.rb	rb31, dadao_supv_diag
+	st.o	rd30, [rb31, 0]
+	cfx2rd	cfx_smon, cg5, rc3, rd30
+	st.o	rd30, [rb31, 8]
+	cfx2rd	cfx_smon, cg5, rc0, rd30
+	st.o	rd30, [rb31, 16]
+	ld.o	rd30, [rb31, 24]
+	add.si	rd30, 1
+	st.o	rd30, [rb31, 24]
+#endif
+	DADAO_GPR_RESTORE dadao_excp_save
+	escape	cfx_smon, [excp_cause_ip, \offset]
+	.endm
+
+	.section .text,"ax"
+	.globl	dadao_supv_excp
+	.p2align 2
+dadao_supv_excp:
+	/* 1.-3. Capture the register file (asm/entry.h, cfx_smon's scratch). */
+	DADAO_GPR_SAVE cfx_smon, dadao_excp_save
+
+	/*
+	 * 4. The frame fields the cg5 holds, then the C half.  The argument
+	 *    registers are the ABI's: rb16 = &frame (first address argument),
+	 *    rd16 = cause, rd17 = info (contract-abi §4.1: data arguments count
+	 *    from rd16 in declaration order).
+	 */
+	cfx2rd	cfx_smon, cg5, rc2, rd16	/* excp_cause_id */
+	cfx2rd	cfx_smon, cg5, rc3, rd17	/* excp_cause_ip */
+	st.o	rd17, [rb3, PT_IP]		/* frame.ip = cause_ip */
+	DADAO_SAVE_STATUS cfx_smon, rb3, .Lstatus_supv	/* frame.status = mode */
+	cfx2rd	cfx_smon, cg5, rc4, rd17	/* excp_cause_info -> 2nd argument */
+	set.rb	rb16, dadao_excp_save
+	set.rb	rb5, dadao_trap_handler
+	call	[rb5, rd0, 0]			/* policy -> rd8 */
+
+	/*
+	 * 5. Resume policy (rd8): 0 = retry the faulting instruction, 1 = skip
+	 *    it.  Anything else is a kernel bug: name it instead of picking an
+	 *    offset.
+	 */
+	br.z	{rd8}?, [rb0, .Lresume_retry]
+	set.rd	rd3, DADAO_TRAP_RESUME_SKIP
+	br.eq	{rd8, rd3}?, [rb0, .Lresume_skip]
+	set.rd	rd16, DADAO_TRAP_BAD_POLICY
+	set.rb	rb5, dadao_trap_bad_policy
+	jump	[rb5, rd0, 0]			/* never returns */
+
+	/*
+	 * 6. Restore and leave the frame.  The two offsets are the only ones
+	 *    `escape` accepts (§5.3): +0 re-executes the faulting instruction
+	 *    (§3.6 `excp_cause_ip` unchanged), +4 continues after it.
+	 */
+.Lresume_retry:
+	DADAO_TRAP_RESTORE_AND_ESCAPE 0
+.Lresume_skip:
+	DADAO_TRAP_RESTORE_AND_ESCAPE 4
+
+.Lstuck:
+	jump	[rb0, .Lstuck]			/* unreachable: escape never returns */
+
+	/*
+	 * The frame: one `struct pt_regs`, 8-byte aligned for the block
+	 * transfers.  Static because the faulting SP may be unusable (above); a
+	 * single hart takes one exception at a time, so one frame is enough
+	 * until K4 needs re-entrancy.
+	 */
+	.section .bss,"aw",%nobits
+	.p2align 3
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	.globl	dadao_supv_diag
+dadao_supv_diag:
+	.zero	32
+#endif
+	.p2align 3
+	.globl	dadao_excp_save
+dadao_excp_save:
+	.zero	PT_REGS_SIZE
+
+/*
+ * ---- K4: the user-mode entry (m14-linux-016, contract-syscall §8) ----------
+ *
+ * Entering user mode is a `trap cfx_umon` from supv: the hardware takes the
+ * target and the new run mode from cfx_umon's *supv* row (cg2) and jumps to
+ * `cfx_umon_supv_excp_vector`, which `dadao_enter_user()` points at the user
+ * IP.  Coming back is the user's own `trap cfx_umon, 0`, which lands here with
+ * the run mode already switched to supv (cfx_umon's *user* row, cg0).
+ *
+ * Single frame (user ruling 2026-11-17, option C): the user entry saves into
+ * `dadao_umon_save` and the handler always escapes back to user; a nested umon
+ * entry is refused by name in process.c, and the cg5->cg6 save that would make
+ * it re-entrant is K5.
+ */
+	.section .text,"ax"
+	.globl	dadao_umon_excp
+	.p2align 2
+dadao_umon_excp:
+	/* 1.-3. Capture the user's register file (asm/entry.h, cfx_umon's scratch). */
+	DADAO_GPR_SAVE cfx_umon, dadao_umon_save
+
+	/*
+	 * 3b. Leave the user's stack.  The hardware does not switch stacks on an
+	 * exception (spec/DADAO-12 §5.2 saves the cg5 fields only), so the C
+	 * half would run on the *user* SP — which may be unmapped, and always
+	 * belongs to the process.  K4 enters a dedicated kernel entry stack
+	 * here; the user's SP is already in the frame and comes back with
+	 * DADAO_GPR_RESTORE.  The stack carries a `struct thread_info` at its
+	 * base (kernel/process.c keeps its `task` pointing at `current`), because
+	 * this port derives `current` from SP.
+	 *
+	 * A task's *own* kernel stack needs a per-task pointer the entry cannot
+	 * read (it would come from `current`, i.e. from SP): that is
+	 * m14-linux-017/020's switch_to/thread work, not single-frame K4.
+	 */
+	/*
+	 * The stack this task's handler runs on: the top of its own kernel stack,
+	 * parked in `dadao_user_stack_top` by `__switch_to()` (and again by
+	 * `dadao_enter_user()`).  A cfx scratch slot cannot carry it — the
+	 * capture below stages `rd2`/`rd3` through cg6 rc0/rc1 and would
+	 * overwrite it (m14-linux-024).  A zero means no switch has run yet
+	 * (early boot): fall back to the static entry stack, which is what the
+	 * boot path used before K4 had tasks.
+	 *
+	 * rd2/rd3 are the reserved debug registers (contract-abi §4.5: the
+	 * compiler never allocates them), so they are safe as the transition.
+	 */
+	rb2rd	rd2, rb1, 1			/* rd2 = user SP */
+	set.rb	rb3, dadao_user_stack_top	/* rb3 = &the parked value */
+	ld.o	rd3, [rb3, 0]			/* rd3 = task kernel-stack top */
+	br.z	{rd3}?, [rb0, .Lumon_boot_stack]
+	rd2rb	rb1, rd3, 1			/* rb1 = task stack top */
+	jump	[rb0, .Lumon_stack_done]
+.Lumon_boot_stack:
+	set.rb	rb1, dadao_umon_stack_top
+.Lumon_stack_done:
+
+	/*
+	 * Adopt the task's own frame: copy the staged register file (captured
+	 * above, while SP was still the user's) into `task_pt_regs(current)` and
+	 * use that from here on, so A's frame lives on A's stack and B's on B's.
+	 */
+	add.si	rb1, -PT_REGS_SIZE		/* SP = &task_pt_regs(current) */
+	set.rb	rb5, dadao_umon_adopt
+	call	[rb5, rd0, 0]			/* rb8 = &task frame (copied) */
+	rb2rb	{rb16}, {rb8}			/* frame argument from here on */
+
+	/*
+	 * 4. cg5 fields + the C half.  The same argument shape as the supv stub:
+	 *    rb16 = &frame, rd16 = cause id, rd17 = cause info (the cause ip
+	 *    lands in the frame's `ip`).
+	 */
+	cfx2rd	cfx_umon, cg5, rc2, rd16	/* excp_cause_id */
+	cfx2rd	cfx_umon, cg5, rc3, rd17	/* excp_cause_ip */
+	st.o	rd17, [rb16, PT_IP]		/* into the *task's* frame (rb16) */
+	DADAO_SAVE_STATUS cfx_umon, rb16, .Lstatus_umon	/* frame.status = mode */
+
+	/*
+	 * 4a. A user *syscall* (`trap cfx_umon, 0`) is handled here, in the umon
+	 *     context: the C half dispatches it and the escape offsets are the
+	 *     contract's (+4 continues after the trap, contract-syscall §8).
+	 */
+	set.rd	rd4, DADAO_CAUSE_CFXTRAP
+	br.ne	{rd16, rd4}?, [rb0, .Lumon_delegate]
+
+	cfx2rd	cfx_umon, cg5, rc4, rd17	/* excp_cause_info -> 3rd argument */
+	set.rb	rb5, dadao_user_excp_handler
+	call	[rb5, rd0, 0]			/* policy -> rd8 */
+
+	/*
+	 * 5. Resume: retry the trapping instruction, or continue after it.
+	 *
+	 * cfx_umon's cg5 holds **one** frame, and it is the last entry's — this
+	 * task may have slept in the C half (a blocking syscall, the clone
+	 * probe's wait) while another task took its own umon entry and
+	 * overwrote `excp_cause_ip`.  `escape` takes its address from there, so
+	 * the field is rewritten from *this* task's frame first: the frame's
+	 * `ip` is the trap instruction it entered at (the stub wrote it from cg5
+	 * before any C code ran, and it is per-task because the frame lives on
+	 * this task's kernel stack).  Only `cause_ip` needs restoring — the
+	 * other cg5 fields the escape reads (`excp_prev_run_mode`,
+	 * `excp_prev_cfx_code`) are the same for every user trap.
+	 */
+	br.z	{rd8}?, [rb0, .Lumon_retry]
+	set.rb	rb5, dadao_umon_frame
+	call	[rb5, rd0, 0]			/* rb8 = &task_pt_regs(current) */
+	rb2rb	{rb3}, {rb8}
+	ld.o	rd4, [rb3, PT_IP]		/* this task's trap instruction */
+	cfx2rc	cfx_umon, cg5, rc3, rd4		/* cg5 rc3 = excp_cause_ip */
+	DADAO_GPR_RESTORE_AT
+	escape	cfx_umon, [excp_cause_ip, 4]
+.Lumon_retry:
+	set.rb	rb5, dadao_umon_frame
+	call	[rb5, rd0, 0]
+	rb2rb	{rb3}, {rb8}
+	ld.o	rd4, [rb3, PT_IP]
+	cfx2rc	cfx_umon, cg5, rc3, rd4		/* cg5 rc3 = excp_cause_ip */
+	DADAO_GPR_RESTORE_AT
+	escape	cfx_umon, [excp_cause_ip, 0]
+
+	/*
+	 * 4b. Any *other* U-mode synchronous exception (page table, alignment,
+	 *     illegal instruction…) is a kernel matter and belongs to the supv
+	 *     channel (contract-syscall §8).  The hardware routes it here
+	 *     (spec/DADAO-12 §3.1: non-trap U-mode exceptions enter cfx_umon),
+	 *     so the entry hands it over explicitly:
+	 *
+	 *       trap cfx_smon, DADAO_SMON_FROM_USER  with
+	 *         rb16 = &umon frame, rd16 = cause id, rd17 = cause ip,
+	 *         rd18 = cause info
+	 *
+	 *     The supv vector saves *its own* frame (the two frames never
+	 *     alias), its C half recognises the selector, handles the cause
+	 *     through the page-fault channel with the umon frame as the task's
+	 *     context, and returns RESUME_SKIP, which lands back here.
+	 */
+.Lumon_delegate:
+	cfx2rd	cfx_umon, cg5, rc4, rd18	/* excp_cause_info */
+	set.rb	rb5, dadao_umon_frame
+	call	[rb5, rd0, 0]
+	rb2rb	{rb16}, {rb8}			/* rb16 = &umon frame */
+	trap	cfx_smon, DADAO_SMON_FROM_USER
+	/*
+	 * Back from the supv channel: either the mapping is installed and
+	 * `cfx_umon`'s supv row points at the instruction to resume, or the
+	 * channel raised SIGSEGV on this process and the frame now says where
+	 * to go (m14-linux-027).  Both cases need the return-to-user work loop
+	 * *before* the registers are restored — it is where a fatal signal ends
+	 * the task and where a handler rewinds this frame — and this hand-over
+	 * path has no other tail (kernel/entry_common.c:
+	 * `dadao_user_fault_return()`).
+	 */
+	set.rb	rb5, dadao_umon_frame
+	call	[rb5, rd0, 0]
+	rb2rb	{rb3}, {rb8}
+	set.rb	rb5, dadao_user_fault_return
+	rb2rb	{rb16}, {rb3}
+	call	[rb5, rd0, 0]
+	DADAO_GPR_RESTORE_AT
+	trap	cfx_umon, 0
+	jump	[rb0, .Lumon_stuck]
+
+	/*
+	 * Load the static frame `dadao_enter_user()` filled and hand control to
+	 * user mode.  `trap cfx_umon, 0` is the only instruction after the
+	 * restore, so every register the restore wrote is the user's.
+	 */
+	.globl	dadao_umon_enter
+	.p2align 2
+dadao_umon_enter:
+	DADAO_GPR_RESTORE dadao_user_frame
+	trap	cfx_umon, 0
+	/* The trap returns here only if the user row's switch value is not a
+	 * lower mode; the kernel must not silently continue in supv. */
+	jump	[rb0, .Lumon_stuck]
+.Lumon_stuck:
+	jump	[rb0, .Lumon_stuck]		/* park: the trap must not return */
+
+	/*
+	 * ---- the syscall body of the umon entry (m14-linux-023) --------------
+	 *
+	 * long dadao_call_syscall(struct pt_regs *regs, void *fn)
+	 *
+	 * A `sys_call_table` entry is a `SYSCALL_DEFINE` wrapper that takes the
+	 * frame (`asm/syscall_wrapper.h`: the generic `__SC_LONG` chain, with the
+	 * positional arguments rebuilt from the frame by the syscall's argmask).
+	 * Its only parameter is a pointer, i.e. address argument 1, which the C
+	 * caller already passes in `rb16` — so this is a plain indirect call:
+	 * nothing of the user's register file has to be loaded into the machine
+	 * (the wrapper reads the frame, not the registers), and the entry's own
+	 * `DADAO_GPR_RESTORE` puts the user's file back afterwards.
+	 *
+	 * `rb3` (`rbtp`) is set to 0 for the duration: the kernel keeps it 0 in
+	 * its own contexts (asm/entry.h) and the user's value is in the frame
+	 * (contract-syscall §10).  `rb5` is a caller-saved scratch, and a `call`
+	 * target must be an RB register (spec/SimRISC-00 §4, `call_rrii_ra`).
+	 */
+	.globl	dadao_call_syscall
+	.p2align 2
+dadao_call_syscall:
+	rb2rb	{rb5}, {rb17}			/* rb5 = the table entry */
+	set.rb	rb3, 0				/* rbtp stays the kernel's */
+	call	[rb5, rd0, 0]			/* rd8 = sys_<name>(rb16 = &frame) */
+	ret	rd0, 0
+
+	/*
+	 * ---- K5 probe: the user program (m14-linux-023) ---------------------
+	 *
+	 * Copied into a user-accessible code page and entered at its first
+	 * instruction (kernel/k5_syscall_selftest.c), so it must be
+	 * position-independent and register-only.  Its argument layout is the
+	 * **user** side of the ABI (contract-syscall §3 + the syscall's argmask,
+	 * the same table the kernel entry reads):
+	 *
+	 *   - the kernel fills the frame with the first call's arguments (the
+	 *     ramfs fd in `rd16`, the buffer in `rb16`, the count in `rd17`, the
+	 *     number in `rd15`), the TLS sentinel in `rb3`, the `rd1` sentinel and
+	 *     the break value U8 asks for in `rd13` — so `trap #0` is the
+	 *     `write()` round trip;
+	 *   - `mmap`'s mask is 0x01: its address argument goes to `rb16` and the
+	 *     five data arguments to `rd16`-`rd20` (this is exactly the "kernel
+	 *     prototype says `unsigned long`" case the argmask exists for);
+	 *   - `brk`'s mask is 0x01 too: the break is an *address*, so U8 passes it
+	 *     in `rb16` (the fixed init does `syscall(SYS_brk, (void *)addr)`);
+	 *     it reads the break, grows it by one page and reads it back;
+	 *   - each result is copied into a callee-saved register (`rd21`-`rd31`)
+	 *     so the kernel's syscall hook can read it at the next trap: the frame
+	 *     is what survives the round trip, and `rd1` is copied too (nothing
+	 *     may write the errno there, contract-syscall §9);
+	 *   - `rb3` is copied after the first round trip: whatever the escape
+	 *     restored is what user mode sees;
+	 *   - the two SBI traps (`immu18 = 1` and an undefined `0x2AAA`) make the
+	 *     immediate parse observable; the reporting trap (`immu18 = 0x2AAB`)
+	 *     is claimed by the kernel and judged there, and the program then ends
+	 *     in `exit(0)`, whose status the boot task observes.
+	 */
+#ifdef CONFIG_DADAO_K5_SYSCALL_SELFTEST
+	.section .rodata,"a"
+	.p2align 2
+	.globl	dadao_k5_user_stub
+	.globl	dadao_k5_user_stub_end
+dadao_k5_user_stub:
+	/*  0 */ trap	cfx_umon, 0		/* U1 write(fd, buf, 12) */
+	/*  4 */ rd2rd	rd24, rd8, 1
+	/*  8 */ rb2rd	rd25, rb3, 1
+	/*  c */ set.rd	rd15, 18		/* an in-range slot = sys_ni_syscall */
+	/* 10 */ trap	cfx_umon, 0		/* U3a */
+	/* 14 */ rd2rd	rd26, rd8, 1
+	/* 18 */ set.rd	rd15, 0x1f00		/* past __NR_syscalls */
+	/* 1c */ trap	cfx_umon, 0		/* U3b */
+	/* 20 */ rd2rd	rd27, rd8, 1
+	/* 24 */ set.rd	rd14, 0			/* mmap: addr (mask 0x01) -> rb16 */
+	/* 28 */ rd2rb	rb16, rd14, 1
+	/* 2c */ set.rd	rd16, 0x1000		/*       len */
+	/* 30 */ set.rd	rd17, 3			/*       prot = RW */
+	/* 34 */ set.rd	rd18, 0x22		/*       flags = PRIVATE|ANON */
+	/* 38 */ set.rd	rd19, 0			/*       fd */
+	/* 3c */ set.rd	rd20, 1			/*       off = 1 (unaligned) */
+	/* 40 */ set.rd	rd15, 222		/* __NR_mmap */
+	/* 44 */ trap	cfx_umon, 0		/* U3c: the arch hook's -EINVAL */
+	/* 48 */ rd2rd	rd28, rd8, 1
+	/* 4c */ trap	cfx_umon, 1		/* U5a SBI_UMON_GET_VERSION */
+	/* 50 */ rd2rd	rd29, rd8, 1
+	/* 54 */ trap	cfx_umon, 0x2aaa	/* U5b: undefined umon function */
+	/* 58 */ rd2rd	rd30, rd8, 1
+	/* 5c */ set.rd	rd15, 214		/* U8: brk (mask 0x01) */
+	/* 60 */ set.rd	rd14, 0			/*       brk(0): read the break */
+	/* 64 */ rd2rb	rb16, rd14, 1
+	/* 68 */ trap	cfx_umon, 0
+	/* 6c */ rd2rd	rd21, rd8, 1
+	/* 70 */ rd2rb	rb16, rd13, 1		/*       brk(want), want = frame rd13 */
+	/* 74 */ trap	cfx_umon, 0
+	/* 78 */ rd2rd	rd22, rd8, 1
+	/* 7c */ set.rd	rd14, 0			/*       brk(0): re-read it */
+	/* 80 */ rd2rb	rb16, rd14, 1
+	/* 84 */ trap	cfx_umon, 0
+	/* 88 */ rd2rd	rd23, rd8, 1
+	/* 8c */ rd2rd	rd31, rd1, 1		/* rd1 must still be the sentinel */
+	/* 90 */ trap	cfx_umon, 0x2aab	/* U5c: the probe's report trap */
+	/* 94 */ set.rd	rd16, 0			/* exit(0) */
+	/* 98 */ set.rd	rd15, 93		/* __NR_exit */
+	/* 9c */ trap	cfx_umon, 0		/* U2: does not return */
+	/* a0 */ jump	[rb0, 0]		/* park */
+dadao_k5_user_stub_end:
+#endif
+
+	/*
+	 * ---- K5 probe: the user program for clone/thread (m14-linux-024) ----
+	 *
+	 * Copied into a user-accessible code page and entered at its first
+	 * instruction (kernel/k5_clone_selftest.c), so it must be
+	 * position-independent (labels only) and register-only.
+	 *
+	 * The kernel hands it three values in the initial frame:
+	 *   rd11 = the page `lr`/`sc` work on (the probe's stack page),
+	 *   rd13 = the child's stack top (`newsp` of the thread clone),
+	 * and the parent's `rb3` = `rbtp` sentinel.
+	 *
+	 * Flow (every result goes to a callee-saved rd (21-31) so the kernel's
+	 * trap hook reads what user mode saw; the two `clone`s return in both
+	 * parent and child and the rd8 = 0 test is the wrapper's half of the
+	 * "double return", contract-syscall §10):
+	 *
+	 *   1. `lr` ; `sc` with nothing in between -> sc must succeed (0)
+	 *   2. `lr` ; getpid ; `sc` -> the exception entry cleared the
+	 *      reservation, so sc must fail (1) (SimRISC-12 §1, §11)
+	 *   3. clone(CLONE_VM|FS|FILES|SIGHAND|THREAD|SETTLS, new stack, tls)
+	 *        parent: tid in rd8 -> wait trap -> fork case
+	 *        child : rd8 = 0, rb3 = tls -> getpid, report, exit(0)
+	 *   4. clone(SIGCHLD, no stack) -- the fork contrast
+	 *        parent: tid in rd8 -> wait trap -> done trap
+	 *        child : rd8 = 0 -> report, exit(0)
