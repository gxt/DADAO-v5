+#define K5F_TRAP_ARM		0x2c02
+#define K5F_TRAP_F4		0x2c03
+#define K5F_TRAP_F3_YIELD	0x2c04
+#define K5F_TRAP_F3		0x2c05
+#define K5F_TRAP_F1		0x2c06
+#define K5F_TRAP_F1A		0x2c07
+#define K5F_TRAP_F2		0x2c08
+#define K5F_TRAP_F2B		0x2c09
+#define K5F_TRAP_F5A		0x2c0a
+#define K5F_TRAP_F5B		0x2c0b
