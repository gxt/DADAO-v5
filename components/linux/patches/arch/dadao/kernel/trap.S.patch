+#define K5F_W_F4		0
+#define K5F_W_F3		8
+#define K5F_W_F1		16
+#define K5F_W_F1B		20
+#define K5F_W_F2		24
+#define K5F_W_F5A		28
+#define K5F_W_F5B		32
+#define K5F_W_F6		36
+#define K5F_W_F7		40
+#define K5F_W_WAKEOP_A	44
+#define K5F_W_WAKEOP_B	48
