+#ifdef CONFIG_DADAO_K5_CLONE_SELFTEST
+/*
+ * The probe's own constants, kept next to the program that uses them: the
+ * kernel half (kernel/k5_clone_selftest.c) reads the flags and the tls value
+ * back *out of the frame* instead of repeating them, and the gate cross-checks
+ * what the console reports against `include/uapi/linux/sched.h` and against
+ * this file, so a drift is a FAIL rather than a silent agreement.
