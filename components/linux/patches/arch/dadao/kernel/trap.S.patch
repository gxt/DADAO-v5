+	/*
+	 * ---- K5 probe: the user program for futex and user atomics ---------
+	 *      (m14-linux-025) ---------------------------------------------------
+	 *
+	 * Copied into a user-accessible code page and entered at its first
+	 * instruction (kernel/k5_futex_selftest.c), so it must be assembled for
+	 * the probe's fixed window — the addresses below are the same block the
+	 * kernel half defines and the gate compares the two copies:
+	 *
+	 *   data page: the u32 words the futex calls and the lr/sc pairs use;
+	 *   stack i  : one page per user thread (0 = the parent program's own).
+	 *
+	 * The kernel hands the parent nothing but `ip` and `sp`; every other
+	 * value below is either a constant of the program or read from the data
+	 * page, and each result goes to a callee-saved `rd` (21-28) so the
+	 * kernel's trap hook reads what user mode really saw.
+	 *
+	 * Flow (the futex hand-overs are serialized from the kernel side: the
+	 * probe's umon hook parks the parent until a child reached its wait, so
+	 * no case depends on winning a race):
+	 *
+	 *   F4  lr;sc with nothing in between (0), then lr;getpid;sc (1, no
+	 *       store) — a syscall entry clears the reservation
+	 *       (spec/SimRISC-12 §1, contract-syscall §11).
+	 *   F3  parent holds an `lr` and yields; the peer's cmpxchg stores; the
+	 *       parent's `sc` fails and its retry sees the peer's value and
+	 *       stores nothing — exactly one of the two exchanges wins.
+	 *   F1  a waiter sleeps in FUTEX_WAIT and WAKE(1) returns 1 and wakes it.
+	 *   F1A the program reads the word, the hook changes it, and the wait
+	 *       must return -EAGAIN (the recheck is what makes the pair atomic).
+	 *   F2  three waiters; WAKE(2) returns 2, then WAKE(1) takes the third.
+	 *   F5  REQUEUE moves a waiter without waking it; WAKE on the
+	 *       destination reaches it.
+	 *   F6  WAIT_BITSET/WAKE_BITSET match on the bitset.
+	 */
+#ifdef CONFIG_DADAO_K5_FUTEX_SELFTEST
+/* The window (kernel/k5_futex_selftest.c has the same block). */
+#define K5F_PAGE		0x10000
+#define K5F_VA_BASE		0x10000000000
+#define K5F_CODE_VA		(K5F_VA_BASE + 64 * K5F_PAGE)
+#define K5F_DATA_VA		(K5F_VA_BASE + 65 * K5F_PAGE)
+#define K5F_STACK_TOP(i)	(K5F_VA_BASE + (67 + (i)) * K5F_PAGE)
+
