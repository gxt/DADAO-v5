+ * The `0x2b00` immediates are probe-only umon functions (the contract defines
+ * 0 and 1, spec/DADAO-22 §2); the kernel's hook claims them.
+ */
+#define K5C_CLONE_FLAGS		0x90f00
+#define K5C_TLS			0x4b3543544c530001
+/* The frame-copy sentinel: a value only the *copy* of the frame can explain. */
+#define K5C_FRAME_SENTINEL	0x5c5c5c5c5c5c5c5c
+#define K5C_TRAP_WAIT_THREAD	0x2b01
+#define K5C_TRAP_CHILD_REPORT	0x2b02
+#define K5C_TRAP_WAIT_FORK	0x2b03
+#define K5C_TRAP_FORKCHILD_REPORT 0x2b04
+#define K5C_TRAP_DONE		0x2b05
