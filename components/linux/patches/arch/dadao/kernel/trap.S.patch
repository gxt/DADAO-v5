+	/*
+	 * 1. lr ; sc with *nothing* in between: the reservation is still held.
+	 *
+	 * The page is touched first with a plain store: the first access to an
+	 * anonymous page is a fault, and a fault clears the reservation
+	 * (SimRISC-12 §1) — without this the case would measure the fault
+	 * handler instead of the reservation.
+	 */
+	rd2rb	rb5, rd11, 1		/* rb5 = the page the probe reserved on */
+	st.o	rd0, [rb5, 0]		/* first touch: private + writable */
+	lr.o.nn	rd2, [rb5]
+	sc.o.nn	rd3, rd2, [rb5]
+	rd2rd	rd24, rd3, 1		/* rd24 = 0 (success) */
+	/* 2. lr ; syscall ; sc: the entry cleared it, so sc must fail */
+	lr.o.nn	rd2, [rb5]
+	set.rd	rd15, 172		/* __NR_getpid */
+	trap	cfx_umon, 0
+	sc.o.nn	rd6, rd2, [rb5]
+	rd2rd	rd26, rd6, 1		/* rd26 = 1 (failure) */
