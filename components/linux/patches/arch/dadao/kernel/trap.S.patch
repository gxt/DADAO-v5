+	/*
+	 * ---- m14-linux-045 probe: the user program (work loop) --------------
+	 *
+	 * Copied into a user-accessible code page and entered at its first
+	 * instruction (kernel/m45_entry_selftest.c), so it must be
+	 * position-independent (labels only) and register-only.  The kernel
+	 * hands it two values in the initial frame: `rd9` = the inner
+	 * (user-only) spin count and `rd11` = the outer iteration count.
+	 *
+	 *   trap cfx_umon, 0x2aac   a probe-only umon function: claimed by the
+	 *                           probe's trap hook, so the entry takes the
+	 *                           non-syscall (`irqentry_*`) return tail
+	 *   loop:                   inner user-only spin (rd10), then one real
+	 *                           syscall (`getpid`) per outer iteration
+	 *   exit(0)                 only reached if the signal case does *not*
+	 *                           end the task — which is the FAIL it reports
+	 */
+#ifdef CONFIG_DADAO_M45_ENTRY_SELFTEST
+	.section .rodata,"a"
+	.p2align 2
+	.globl	dadao_m45_user_stub
+	.globl	dadao_m45_user_stub_end
+dadao_m45_user_stub:
+	/*  0 */ trap	cfx_umon, 0x2aac	/* the probe's own umon function */
+.Lm45_loop:
+	/*  4 */ rd2rd	rd10, rd9, 1		/* rd10 = the inner spin count */
+.Lm45_inner:
+	/*  8 */ add.si	rd10, -1
+	/*  c */ br.z	{rd10}?, [rb0, .Lm45_next]
+	/* 10 */ jump	[rb0, .Lm45_inner]
+.Lm45_next:
+	/* 14 */ set.rd	rd15, 172		/* __NR_getpid */
+	/* 18 */ trap	cfx_umon, 0		/* the iteration the kernel counts */
+	/* 1c */ add.si	rd11, -1
+	/* 20 */ br.z	{rd11}?, [rb0, .Lm45_done]
+	/* 24 */ jump	[rb0, .Lm45_loop]
+.Lm45_done:
+	/* 28 */ set.rd	rd16, 0
+	/* 2c */ set.rd	rd15, 93		/* __NR_exit */
+	/* 30 */ trap	cfx_umon, 0		/* does not return */
+.Lm45_park:
+	/* 34 */ jump	[rb0, .Lm45_park]
+dadao_m45_user_stub_end:
+#endif
+
+	/*
+	 * ---- K5 signal probe: the user program (m14-linux-046) --------------
+	 *
+	 * Copied into a user-accessible code page and entered at its first
+	 * instruction (kernel/k5_signal_selftest.c), so it is position-independent
+	 * (labels only) and register-only.  Three scripts, selected by the kernel
+	 * in `rd11`, share the same prologue and the same trigger:
+	 *
+	 *   0  install a handler with `rt_sigaction` (no SA_ONSTACK), raise
+	 *      SIGUSR1, and after `rt_sigreturn` report the restored frame;
+	 *   1  raise SIGTERM with no handler: the default action must end the
+	 *      task (it never reaches the report);
+	 *   2  the same as 0 on an alternate stack (`sigaltstack` +
+	 *      SA_ONSTACK), so the handler reports where its frame really is.
+	 *
+	 * The kernel hands the program:
+	 *   rd11 = the script        rd12 = the handler     rd13 = the restorer
+	 *   rd14 = the trigger helper rd10 = a no-op callee  rb32 = the data page
+	 * and seeds the *callee-saved* banks (`rd32`-`rd63`, `rb32`-`rb63`,
+	 * `rf32`-`rf63`), `rd1` (rdernno) and `ra0` (`MRPTR` != 0, so the frame
+	 * carries a real MemRAS pointer — spec/SimRISC-00 §2.4).  The handler
+	 * deliberately scribbles over all of those, so "the handler saw what the
+	 * interrupted context had" and "the kernel put it back" are two separate
+	 * observations.
+	 *
+	 * The program's own checks that need the kernel's view of the frame are
+	 * the two probe-only umon functions the helper traps with: `0x2d01`
+	 * (raise: the kernel snapshots the frame and sends the signal) and
+	 * `0x2d02` (verify: the kernel compares the frame `rt_sigreturn` restored
+	 * with the snapshot).  Both are 4 bytes apart on purpose: the raise's
+	 * resume address is the verify itself, which is what makes "the restored
+	 * `ip` is where the task continues" observable.
+	 *
+	 * Data page layout (`M46_K_*` in kernel/k5_signal_selftest.c; the gate
+	 * cross-checks the two copies of every offset).
+	 */
+#ifdef CONFIG_DADAO_K5_SIGNAL_SELFTEST
+/* The three mapped windows the program touches (kernel C has the same set). */
+#define M46_CODE_VA		0x2000000000	/* 1 << 37 */
+#define M46_DATA_VA		0x8000000000	/* 1 << 39 */
+
+/* Data page: the objects the kernel pre-fills, the reports it reads back. */
+#define M46_K_ACT		0		/* struct sigaction, SA_RESTORER */
+#define M46_K_ACT_ALT		32		/* ... with SA_ONSTACK */
+#define M46_K_SS		64		/* stack_t for sigaltstack */
+#define M46_K_RF0		128		/* the FCSR word to write */
+#define M46_K_RF32		136
+#define M46_K_RF33		144
+#define M46_K_RF34		152
+#define M46_K_CLOBBER		160		/* what the handler scribbles */
+#define M46_K_CLOBBER_FCSR	168
+#define M46_K_FCSR_ARCH		176		/* user's read-back of rf0 */
+#define M46_K_EXP_RD33		184		/* expectations for the handler */
+#define M46_K_EXP_RD34		192
+#define M46_K_EXP_RD35		200
+#define M46_K_EXP_RB33		208
+#define M46_K_EXP_RB34		216
+#define M46_K_EXP_RB35		224
+#define M46_K_EXP_RA0		232
+#define M46_K_SAVED_SP		240
+#define M46_K_H_RUNS		248		/* the handler's reports */
+#define M46_K_H_SIG		256
+#define M46_K_H_INFO		264
+#define M46_K_H_UC		272
+#define M46_K_H_SP		280
+#define M46_K_H_UC_OFF		288		/* &uc - the frame */
+#define M46_K_H_INFO_OFF	296		/* &siginfo - the frame */
+#define M46_K_H_MISMATCH	304
+#define M46_K_SETUP_RET		312		/* rt_sigaction's answer */
+#define M46_K_SS_RET		320		/* sigaltstack's answer */
+#define M46_K_H_RAS		328		/* the entry below the pushed one */
+#define M46_K_H_RA62		336		/* ... and what the handler read there */
+/* 027's slots (mirrored in kernel/k5_signal_selftest.c; the gate compares). */
+#define M46_K_S5_TID		344		/* the leader's clone return */
+#define M46_K_S5_HB		352		/* the sibling's heartbeat */
+#define M46_K_S5_SIB_ENTER	360		/* did the sibling take its arm */
+#define M46_K_S6_SET_RET	368		/* setrlimit's answer */
+#define M46_K_S6_GET_RET	376		/* getrlimit's answer */
+#define M46_K_S6_GET_CUR	384
+#define M46_K_S6_GET_MAX	392
+#define M46_K_S6_FORK_RET	400		/* the fork child's pid */
+#define M46_K_S6_CHILD_RET	408		/* the child's getrlimit answer */
+#define M46_K_S6_CHILD_CUR	416
+#define M46_K_S6_CHILD_MAX	424
+#define M46_K_S6_GROW_OK	432		/* the in-limit page read was 0 */
+#define M46_K_S6_WAIT_RET	440		/* wait4's answer */
+#define M46_K_S6_WAIT_STATUS	448		/* ... and the status it wrote */
+#define M46_K_S6_REQ		456		/* struct rlimit to install */
+#define M46_K_S6_GET		472		/* struct rlimit the parent read */
+#define M46_K_S6_CHILD_GET	488		/* ... and the child's own read */
+#define M46_K_RAS_ADDR		512		/* the MemRAS buffer */
+
+/*
+ * `struct ucontext` member offsets, derived from uapi/asm/ucontext.h:
+ * uc_flags 8 + uc_link 8 + stack_t 24 + the 1024-bit mask area 128 = 168.
+ * kernel/signal.c pins the same number with a _Static_assert.
+ */
+#define M46_UC_MC		168
+#define M46_UC_RD(n)		(M46_UC_MC + (n) * 8)
+#define M46_UC_RB(n)		(M46_UC_MC + 512 + (n) * 8)
+#define M46_UC_RA(n)		(M46_UC_MC + 1024 + (n) * 8)
+#define M46_UC_RF(n)		(M46_UC_MC + 1536 + (n) * 8)
+
+/* uapi numbers (asm-generic table) and the probe's own umon functions. */
+#define M46_SIG			10		/* SIGUSR1 */
+#define M46_SYS_EXIT		93
+#define M46_SYS_SIGALTSTACK	132
+#define M46_SYS_RT_SIGACTION	134
+#define M46_SYS_RT_SIGRETURN	139
+#define M46_TRAP_RAISE		0x2d01
+#define M46_TRAP_VERIFY		0x2d02
+
+/* 027: the behaviour cases' uapi numbers and their own two services. */
+#define M46_SYS_EXIT_GROUP	94
+#define M46_SYS_GETRLIMIT	163
+#define M46_SYS_SETRLIMIT	164
+#define M46_SYS_CLONE		220
+#define M46_SYS_WAIT4		260
+#define M46_RLIMIT_STACK	3
+/* CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD|CLONE_SYSVSEM */
+#define M46_CLONE_THREAD_FLAGS	0x50f00
+#define M46_TRAP_HB		0x2d03		/* the sibling's heartbeat */
+#define M46_TRAP_WAIT_SIB	0x2d04		/* the leader parks until it ran */
+
+/* The growable stack the s6 case presses on, and the limit it installs. */
+#define M46_STACK2_VA		0x3000000000	/* (1 << 37) + (1 << 36) */
+#define M46_ST_LIMIT		0x50000		/* five 64 KiB pages */
+
+	.section .rodata,"a"
+	.p2align 2
+	.globl	dadao_m46_user_stub
+	.globl	dadao_m46_user_stub_end
+	.globl	dadao_m46_user_helper
