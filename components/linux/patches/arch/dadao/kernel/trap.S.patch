+
+	/*
+	 * ---- K4 probe: the user program (m14-linux-016) ---------------------
+	 *
+	 * The F5 case copies these instructions into a user-accessible page and
+	 * enters user mode at its first instruction.  Kept in assembly so the
+	 * program is assembled, not hand-encoded, and register-only so it can be
+	 * copied anywhere:
+	 *
+	 *   0  trap cfx_umon, 0     syscall #0: the kernel verifies the frame
+	 *   4  ld.o rd20, [rb10,0]  read a demand-paged user page (CFXMEM, user)
+	 *   8  trap cfx_umon, 1     syscall #1: verify the second frame, stop
+	 *  12  jump [rb0, 0]        park (never reached)
+	 */
+	.section .rodata,"a"
+	.p2align 2
+	.globl	dadao_k4_user_stub
+	.globl	dadao_k4_user_stub_end
+dadao_k4_user_stub:
+	trap	cfx_umon, 0
+	ld.o	rd20, [rb10, 0]
+	trap	cfx_umon, 1
+dadao_k4_user_park:
+	jump	[rb0, 0]
+dadao_k4_user_stub_end:
+
+	.section .bss,"aw",%nobits
+	/*
+	 * The kernel entry stack the user entry runs on (THREAD_SIZE, 64 KiB
+	 * aligned so that `SP & ~(THREAD_SIZE-1)` finds the `thread_info` at its
+	 * base).  Single, non-reentrant: one hart, no nesting in K4.
+	 */
+	.p2align 16
+	.globl	dadao_umon_stack
+dadao_umon_stack:
+	.zero	65536
+	.globl	dadao_umon_stack_top
+dadao_umon_stack_top:
+	.p2align 3
+	/* The frame the user entry saved (single, non-reentrant: see above). */
+	.globl	dadao_umon_save
+dadao_umon_save:
+	.zero	PT_REGS_SIZE
+	.p2align 3
+	/* The frame `dadao_umon_enter` loads: the user's register file. */
+	.globl	dadao_user_frame
+dadao_user_frame:
+	.zero	PT_REGS_SIZE
