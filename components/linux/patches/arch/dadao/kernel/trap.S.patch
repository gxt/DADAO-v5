+	set.rd	rd16, K5C_CLONE_FLAGS
+	rd2rd	rd17, rd13, 1		/* newsp = the child's stack top */
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1		/* parent_tidptr = NULL */
+	set.rd	rd18, K5C_TLS		/* tls */
+	rd2rb	rb17, rd14, 1		/* child_tidptr = NULL */
+	set.rd	rd15, 220		/* __NR_clone */
+	trap	cfx_umon, 0
+	rd2rd	rd27, rd8, 1		/* parent: tid; child: 0 */
+	rb2rd	rd28, rb3, 1		/* parent: sentinel; child: tls */
+	br.z	{rd8}?, [rb0, .Lk5c_child]
+	/* ---- parent: let the thread child and then the fork child run ---- */
+	trap	cfx_umon, K5C_TRAP_WAIT_THREAD
+	set.rd	rd16, 17		/* SIGCHLD: a real fork, no stack */
+	set.rd	rd17, 0
+	set.rd	rd14, 0
+	rd2rb	rb16, rd14, 1
+	rd2rb	rb17, rd14, 1
+	set.rd	rd15, 220		/* __NR_clone */
+	trap	cfx_umon, 0
+	rd2rd	rd21, rd8, 1
+	rb2rd	rd22, rb3, 1
+	br.z	{rd8}?, [rb0, .Lk5c_fork_child]
+	trap	cfx_umon, K5C_TRAP_WAIT_FORK
+	trap	cfx_umon, K5C_TRAP_DONE
+	jump	[rb0, .Lk5c_park]
+	/* ---- the thread child: rd8 = 0, rb3 = tls ---- */
+.Lk5c_child:
+	set.rd	rd15, 172		/* __NR_getpid: a second syscall */
+	trap	cfx_umon, 0
+	rd2rd	rd29, rd8, 1		/* the thread's getpid = the group's tgid */
+	rb2rd	rd30, rb3, 1		/* rbtp after a completed syscall */
