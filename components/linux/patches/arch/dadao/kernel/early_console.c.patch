index 000000000..df9ec7df2
--- /dev/null
+++ b/arch/dadao/kernel/early_console.c
@@ -0,0 +1,229 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO semihosting console — K1 early console (contract-semihosting §1-§4).
+ *
+ * `trap cfx0, 0x3FF00` is the fixed semihosting tag: immu18 only carries
+ * 0x3FF00, the **service number goes in rd16** and the argument-block pointer
+ * in **rb16** (§2); the scalar result comes back in rd8 and the IP is stepped
+ * past the trap by the responder (§4).
+ *
+ * The pointer handed to the responder must be a **PA**: on Vast the responder
+ * reads guest memory through QEMU's debug/identity translation, which does not
+ * consult the page table (`tests/shared/bootrom/k0/probe_kernel.S` records the
+ * same rule for its exit block).  The kernel itself runs on VAs, so every
+ * pointer below is converted with __pa().
+ *
+ * Output uses SYS_WRITEC (0x03), one byte per call; see dadao_early_write()
+ * for why SYS_WRITE0/SYS_WRITE cannot be used here.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/sprintf.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/page.h>
+#include <asm/setup.h>
+
+#define SEMIHOST_TAG		0x3ff00
+#define SEMIHOST_SYS_WRITEC	0x03
+#define SEMIHOST_SYS_EXIT	0x18
+#define ADP_STOPPED_APP_EXIT	0x20026
+
+/*: One semihosting call; @nr -> rd16, @arg -> rb16, result <- rd8. */
+static unsigned long semihost_call(unsigned long nr, const void *arg)
+{
+	register unsigned long n __asm__("rd16") = nr;
+	register const void *p __asm__("rb16") = arg;
+	register unsigned long ret __asm__("rd8");
+
+	__asm__ __volatile__("trap cfx0, %1"
+			     : "=r"(ret)
+			     : "i"(SEMIHOST_TAG), "r"(n), "r"(p)
+			     : "memory");
+	return ret;
+}
+
+/*
+ * Physical address of a kernel pointer, as the semihosting responder sees it.
+ * __pa() is a 64-bit subtraction; the ABI address is 48 bits wide
+ * (contract-abi §1.7), so the carry-out has to be dropped *before* the value
+ * is handed over: the responder reads the register raw, it does not truncate
+ * the way an instruction operand is truncated.
+ */
+#define DADAO_SEMIHOST_PA(x)	\
+	((const void *)((unsigned long)__pa(x) & 0x0000ffffffffffffUL))
+
+/*
+ * Early console = semihosting SYS_WRITEC (0x03), one byte per call.
+ *
+ * SYS_WRITE0 (0x04) cannot be used on Vast with the PTW on: its length probe
+ * (uaccess_strlen_user -> probe_access_flags) translates a *VA* through the
+ * page table while the following copy (lock_user -> cpu_memory_rw_debug) goes
+ * through QEMU's debug/identity translation, so no single address satisfies
+ * both.  SYS_WRITEC only takes the copy path, which is the PA path.  SYS_WRITE
+ * (0x05) would first need a SYS_OPEN'd guest fd.
+ */
+void dadao_early_write(const char *s)
+{
+	while (*s)
+		semihost_call(SEMIHOST_SYS_WRITEC, DADAO_SEMIHOST_PA(s++));
+}
+
+/*
+ * One byte from an explicit physical address: the responder reads the byte at
+ * @pa through QEMU's debug identity translation, so this prints what is at that
+ * PA whether or not any mapping points there.  That is the PA side of the K1
+ * VA -> PA check (mm/k1_pt.c): the kernel writes through a VA, then prints back
+ * by PA, and the two must agree.
+ */
+void dadao_early_write_pa(unsigned long pa)
+{
+	semihost_call(SEMIHOST_SYS_WRITEC,
+		      (const void *)(pa & 0x0000ffffffffffffUL));
+}
+
+/*
+ * Printing from inside an exception frame is illegal on this machine: the
+ * console is `trap cfx0, 0x3FF00`, and a `trap` sets `inner_cfx_code` to its
+ * target (spec/DADAO-12 §5.2 step 6), so the frame's own `escape <cfx>` would
+ * then fail with CFXESC (§5.3 step 0).  The exception handlers therefore raise
+ * `dadao_in_frame` while they run, and messages produced there are **queued**
+ * instead of written; the queue is flushed by the first print from outside a
+ * frame (which, in the kernel's control flow, is the first point where the
+ * semihosting trap is legal again).
+ *
+ * This is m14-linux-017's pilot (user ruling: option C of 待裁定 4); K2-K4's
+ * probes still print from frames and are to be migrated separately.
+ */
+int dadao_in_frame;
+
+/*
+ * What a frame may still do: *record numbers* (scalars only — no array, the
+ * text buffer would need a relocation this port's code model cannot express).
+ * Outside a frame, `dadao_flog_report()` prints them.
+ */
+unsigned long dadao_flog_last[4];
+
+void dadao_flog_report(void)
+{
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	if (!dadao_flog_last[0])
+		return;
+	dadao_early_printf("K4 flog: n=%lu a=%#lx b=%#lx c=%#lx\n",
+			   dadao_flog_last[0], dadao_flog_last[1],
+			   dadao_flog_last[2], dadao_flog_last[3]);
+	dadao_flog_last[0] = 0;
+	{
+		extern unsigned long dadao_supv_diag[4];
+
+		dadao_early_printf("K4 supv: returns=%lu last_id=%#lx "
+				   "last_ip=%#lx last_prev_mode=%lu\n",
+				   dadao_supv_diag[3], dadao_supv_diag[0],
+				   dadao_supv_diag[1], dadao_supv_diag[2]);
+		{
+			extern unsigned long dadao_pf_last[8];
+			extern unsigned long dadao_pf_last_res;
+
+			dadao_early_printf("K4 pf last: res=%lu sub=%#lx "
+					   "policy=%lu ip=%#lx vma=%#lx-%#lx "
+					   "pte=%#lx flags=%#lx priv=%#lx\n",
+					   dadao_pf_last_res, dadao_pf_last[0],
+					   dadao_pf_last[1], dadao_pf_last[2],
+					   dadao_pf_last[3], dadao_pf_last[4],
+					   dadao_pf_last[5], dadao_pf_last[6],
+					   dadao_pf_last[7]);
+		}
+	}
+#endif
+}
+
+/*
+ * Printing from inside an exception frame is illegal here: the console is
+ * `trap cfx0, 0x3FF00`, and a `trap` sets `inner_cfx_code` to its target
+ * (spec/DADAO-12 §5.2 step 6), so the frame's own `escape <cfx>` would fail
+ * with CFXESC (§5.3 step 0).  While `dadao_in_frame` is set, messages are
+ * dropped; the exception handlers record numbers instead and
+ * `dadao_flog_report()` prints them from a frame-free context.
+ *
+ * m14-linux-017 pilot (user ruling: option C of 待裁定 4); K2-K4's probes still
+ * print from frames and are to be migrated separately.
+ */
+void dadao_early_printf(const char *fmt, ...)
+{
+	char buf[256];
+	va_list args;
+
+	/*
+	 * In-frame printing is legal again: `m14-spec-009` makes `escape` restore
+	 * `inner_cfx_code`, so the `trap cfx0` this console issues no longer
+	 * strands the frame's own `escape <cfx>` (the mechanism F33/F36 found
+	 * and 方案 C worked around).  `dadao_in_frame` stays as the flag the
+	 * fault channel records with.
+	 */
+	va_start(args, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, args);
+	va_end(args);
+	dadao_early_write(buf);
+}
+
+/*
+ * Stop the machine.  SYS_EXIT takes the 64-bit block {reason, subcode}; the
+ * subcode becomes the host process exit status (§5), so K1 uses it to carry
+ * the kernel's own result.
+ */
+void __noreturn dadao_early_exit(unsigned long code)
+{
+	unsigned long block[2] = { ADP_STOPPED_APP_EXIT, code };
+
+	/* The machine is ending: the frame's inner-cfx drift no longer matters. */
+	dadao_in_frame = 0;
+	dadao_flog_report();
+
+	semihost_call(SEMIHOST_SYS_EXIT, DADAO_SEMIHOST_PA(block));
+	for (;;)
+		;
+}
+
+void __init __noreturn dadao_bootinfo_reject(unsigned int code,
+					     const char *what)
+{
+	dadao_early_printf("K1 bootinfo invalid: %s code=%#x\n", what, code);
+	dadao_early_exit(code);
+}
+
+/*
+ * printk console (used once console_init() runs in a later milestone).  It
+ * shares the semihosting primitives above; CON_PRINTBUFFER replays messages
+ * queued before registration.
+ */
+static void dadao_console_write(struct console *con, const char *s,
+				unsigned int count)
+{
+	char buf[128];
+	unsigned int chunk;
+
+	while (count) {
+		chunk = count < sizeof(buf) - 1 ? count : sizeof(buf) - 1;
+		memcpy(buf, s, chunk);
+		buf[chunk] = '\0';
+		dadao_early_write(buf);
+		s += chunk;
+		count -= chunk;
+	}
+}
+
+static struct console dadao_console = {
+	.name	= "semihost",
+	.write	= dadao_console_write,
+	.flags	= CON_PRINTBUFFER,
+	.index	= -1,
+};
+
+static int __init dadao_console_init(void)
+{
+	register_console(&dadao_console);
+	return 0;
+}
+console_initcall(dadao_console_init);
