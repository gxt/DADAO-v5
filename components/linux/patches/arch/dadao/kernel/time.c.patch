diff --git a/arch/dadao/kernel/time.c b/arch/dadao/kernel/time.c
new file mode 100644
index 000000000..a0573c08c
--- /dev/null
+++ b/arch/dadao/kernel/time.c
@@ -0,0 +1,921 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO time base and single-hart timer.
+ *
+ * Register semantics are frozen by contract-see §3 (from spec/DADAO-12 §4.7 and
+ * §4.10); §6.5 only adds the kernel-side gaps:
+ *
+ *   - the kernel may touch `cfx_time` and `cfx_hart` because the boot SEE
+ *     opened them (tests/shared/bootrom/k0/hmon.S) — without that the first
+ *     `cfx2rd` is CFXPERM, which is exactly why the K2 gate runs a firmware
+ *     variant that does not open them;
+ *   - after a delivery the hardware re-kicks pending events itself (mask
+ *     write / escape / new event), so the kernel keeps no software bitmap.
+ *
+ * The K2 gate (m14-linux-007) measured a minimal clock: `cfx_time` read as a
+ * free-running count, `cfx_hart`'s compare register re-armed by hand and
+ * `jiffies_64 += 1` written by the arch handler.  This file keeps that surface
+ * (the five accessor functions plus `dadao_timer_interrupt()`) and now feeds
+ * the generic time subsystem through it (m14-linux-026):
+ *
+ *   clocksource  `dadao_clocksource` over `cfx_time` (rating 300: above the
+ *                HZ-resolution jiffies fallback, below the architected
+ *                per-CPU cycle counters such as RISC-V's 400 — `cfx_time` is a
+ *                shared system-register counter, not a per-hart cycle clock).
+ *                Registering it is what makes `timekeeping` leave the 10 ms
+ *                jiffies clock and what makes `update_wall_time()` advance.
+ *   clockevent   `dadao_clock_event_device` over the `cfx_hart` one-shot
+ *                compare register: `set_next_event(delta)` writes the
+ *                *absolute* deadline `cfx_time + delta` (contract-see §3),
+ *                `set_state_*` writes `timer_ctrl` (ENABLE/IMASK).  Only
+ *                ONESHOT is advertised: the compare register has no periodic
+ *                reload, so the tick's oneshot loop re-programs every delivery.
+ *
+ * `time_init()` registers both; the generic tick then owns `jiffies_64`
+ * (`do_timer(1)` inside `tick_periodic`), the wall clock
+ * (`update_wall_time()`), the timer wheel and `sched_tick()`.  The arch
+ * handler only forwards the delivery.
+ *
+ * K2-boundary images (`CONFIG_DADAO_K2_TIME_STOP`) are the one exception: the
+ * K2 gate calls `time_init()` from `setup_arch()`, before the generic tick core
+ * exists and before `init_IRQ()` installs the asynchronous vector, so those
+ * images keep the raw arming/hand accounting that K2 measured.  The legacy
+ * half is compiled out everywhere else — no milestone image runs it.
+ */
+#include <linux/bitops.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/cpumask.h>
+#include <linux/init.h>
+#include <linux/hardirq.h>
+#include <linux/irqflags.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/sched_clock.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/cfx.h>
+#include <asm/ptrace.h>
+#include <asm/setup.h>
+#include <asm/time.h>
+#include <asm/trap.h>
+
+/*
+ * Named boot verdicts.  Guest FAIL segment of spec/Kaiwu §7.1 (0x01-0x7f,
+ * value = check point index); head.S owns 0x01-0x03, setup.c 0x04-0x08,
+ * mm/k1_pt.c 0x09-0x0c, trap.S 0x0d, traps.c 0x0e/0x0f, so this task starts at
+ * 0x10.  They stay <= 0x7f because the semihosting SYS_EXIT subcode IS the host
+ * exit status (0x100 would wrap to 0 and read as PASS).
+ */
+#define K2_FAIL_TIME_GEOMETRY	0x10	/* freq == 0 or freq / HZ == 0 */
+#define K2_FAIL_NO_TICK		0x13	/* the expected ticks did not arrive */
+
+#define K2_TIME_SLOTS		8	/* samples kept for the report; >= ticks */
+
+/* cfx_hart cg15: the entrance record (prev mode / prev ip); §4.7. */
+#define CFX_HART_CG_ASYNC		15
+#define CFX_HART_RC_ASYNC_PREV_MODE	0
+#define CFX_HART_RC_ASYNC_CAUSE_IP	2
+
+#if CONFIG_DADAO_K2_IRQ_TEST
+/*
+ * Probe-image half (kernel/k2_irq_test.c, CONFIG_DADAO_K2_IRQ_TEST): the
+ * interrupt-enable knob cases, plus the hook the tick calls after it restored
+ * the knob inside a live frame.  Never part of a milestone image.
+ */
+void __noreturn dadao_k2_irq_test(void);
+void dadao_k2_irq_inframe(void);
+#endif
+
+#if CONFIG_DADAO_M45_ENTRY_SELFTEST
+/* The entry/exit probe's view of one delivery (kernel/m45_entry_selftest.c). */
+void m45_note_irq(struct pt_regs *regs);
+#endif
+
+/*
+ * The period and the tick bookkeeping.  `period` is derived once in
+ * time_init() from the *live* frequency and the configured HZ — never from a
+ * hardcoded count.  Both the K2 raw path and the generic clock event device
+ * program deadlines from it.
+ */
+static unsigned long dadao_period;
+
+/* Delivered ticks since reset (volatile: the waiting context polls it).  The
+ * generic path increments it as the probe's observation counter; it takes no
+ * part in the accounting (that is `do_timer()`'s job). */
+static volatile unsigned int dadao_ticks;
+
+#ifdef CONFIG_DADAO_K2_TIME_STOP
+/*
+ * K2-boundary images only (file comment): `dadao_tick_on` says whether the raw
+ * periodic clock has been started, which is also the only condition under which
+ * the handler calls into the scheduler.
+ */
+static int dadao_tick_on;
+#endif
+
+/* Per-tick samples, printed after the series (printing inside the handler
+ * would push the next deadline and distort the very intervals it reports).
+ * The K2 boundary cases stay compiled (they are the gate's case switch), so the
+ * arrays exist in every image. */
+static int dadao_sample_on;
+static unsigned int dadao_sample_n;
+static unsigned long dadao_sample_time[K2_TIME_SLOTS];
+static unsigned long dadao_sample_jiffies[K2_TIME_SLOTS];
+
+static void dadao_timer_mask_bit0(int masked)
+{
+	unsigned long mask = DADAO_CFX_READ(cfx_hart, DADAO_SRC_CG,
+					    DADAO_SRC_RC_MASK);
+
+	if (masked)
+		mask |= DADAO_SRC_EVENT_BIT0;
+	else
+		mask &= ~DADAO_SRC_EVENT_BIT0;
+	DADAO_CFX_WRITE(cfx_hart, DADAO_SRC_CG, DADAO_SRC_RC_MASK, mask);
+}
+
+/* -------------------------------------------------------------------------
+ * clocksource: cfx_time (contract-see §3: 1 GHz, 1 count = 1 ns, 64-bit)
+ * ------------------------------------------------------------------------- */
+
+/*
+ * `cfx2rd` returns the whole 64-bit count in one instruction (§4.10), so the
+ * clocksource read has no high/low tear and needs no seqcount of its own.  The
+ * counter is continuous (monotone since reset), hence CLOCK_SOURCE_IS_CONTINUOUS
+ * and no wrap handling.
+ */
+static u64 notrace dadao_clocksource_read(struct clocksource *cs)
+{
+	return dadao_read_time();
+}
+
+/*
+ * Rating: 300.  It has to beat the jiffies fallback (kernel/time/jiffies.c,
+ * rating 1, HZ-resolution steps), which is what makes `timekeeping` switch to
+ * this clock in `clocksource_select()`.  It deliberately does not reach the
+ * 400+ band: those are architected per-CPU cycle counters (arch/riscv's is 400)
+ * read from a CPU register, while `cfx_time` is a shared system-register
+ * counter read with `cfx2rd` — good enough for timekeeping, not a hart-local
+ * cycle clock.
+ */
+struct clocksource dadao_clocksource = {
+	.name	= "dadao_cfx_time",
+	.rating	= 300,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+	.read	= dadao_clocksource_read,
+};
+
+/* -------------------------------------------------------------------------
+ * clockevent: cfx_hart's one-shot compare register (contract-see §3)
+ * ------------------------------------------------------------------------- */
+
+/*
+ * `set_next_event()` takes a *delta* in counts; the hardware `timer_cmp` is an
+ * absolute `cfx_time` value, so the conversion happens here.  Writing `cmp`
+ * cancels the previous deadline and clears the pending bit (§3), which is what
+ * lets the tick replace a deadline that has not fired yet.
+ */
+static int dadao_clockevent_next_event(unsigned long delta,
+				       struct clock_event_device *dev)
+{
+	unsigned long deadline = dadao_read_time() + delta;
+
+	dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			deadline);
+	dadao_timer_mask_bit0(0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+	return 0;
+}
+
+/* Cancel the deadline: ENABLE off (no new event, §4.7), then the "never"
+ * compare value and an ack of whatever pending bit the last expiry left. */
+static int dadao_clockevent_shutdown(struct clock_event_device *dev)
+{
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL, 0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			~0UL);
+	dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+	return 0;
+}
+
+/* Oneshot state: the deadline is programmed by `set_next_event()`; just make
+ * sure the source is enabled with its interrupt mask open. */
+static int dadao_clockevent_set_oneshot(struct clock_event_device *dev)
+{
+	dadao_timer_mask_bit0(0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+	return 0;
+}
+
+/* Parked: keep ENABLE but mask the timer source (cg16 rc16 bit0), so an
+ * expiry stays pending in hardware until the handler acks it. */
+static int dadao_clockevent_set_oneshot_stopped(struct clock_event_device *dev)
+{
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+	dadao_timer_mask_bit0(1);
+	return 0;
+}
+
+/*
+ * Not advertised (`CLOCK_EVT_FEAT_PERIODIC` is absent): `cfx_hart` has no
+ * periodic reload — it delivers once per programmed compare value.  The state
+ * callback exists because the clockevents API defines it; it arms exactly one
+ * period, which is what a periodic caller would have to keep doing anyway.
+ */
+static int dadao_clockevent_set_periodic(struct clock_event_device *dev)
+{
+	dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			dadao_read_time() + dadao_period);
+	dadao_timer_mask_bit0(0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+	return 0;
+}
+
+struct clock_event_device dadao_clock_event_device = {
+	.name			= "dadao_cfx_hart_timer",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_next_event		= dadao_clockevent_next_event,
+	.set_state_shutdown	= dadao_clockevent_shutdown,
+	.set_state_oneshot	= dadao_clockevent_set_oneshot,
+	.set_state_oneshot_stopped = dadao_clockevent_set_oneshot_stopped,
+	.set_state_periodic	= dadao_clockevent_set_periodic,
+};
+
+void dadao_clockevent_start(void)
+{
+#ifdef CONFIG_DADAO_K2_TIME_STOP
+	/* K2-boundary image: no registered device; the raw path is the tick. */
+	dadao_tick_on = 1;
+	dadao_timer_arm(dadao_period);
+#else
+	struct clock_event_device *dev = &dadao_clock_event_device;
+
+	/*
+	 * Restart the generic tick after `dadao_clockevent_stop()`.  The tick
+	 * framework's own re-arm entry is private to kernel/time, so restart
+	 * through the device callbacks: put the state predicate back to ONESHOT,
+	 * publish the deadline the tick's oneshot loop will continue from
+	 * (`next_event`) and program it.  The delivery then reaches
+	 * `tick_handle_periodic()` again and the loop takes over.
+	 */
+	dev->state_use_accessors = CLOCK_EVT_STATE_ONESHOT;
+	dev->next_event = ktime_get() + TICK_NSEC;
+	dev->set_next_event(TICK_NSEC, dev);
+#endif
+}
+
+void dadao_clockevent_stop(void)
+{
+#ifdef CONFIG_DADAO_K2_TIME_STOP
+	dadao_tick_on = 0;
+	dadao_timer_stop();
+#else
+	struct clock_event_device *dev = &dadao_clock_event_device;
+
+	/*
+	 * Cancel the hardware deadline and move the core state out of ONESHOT:
+	 * `tick_handle_periodic()` re-arms whenever the device is in ONESHOT,
+	 * and a caller may stop the clock from *inside* the handler (the m45
+	 * entry/exit probe does).  The clockevents core's own switch entry is
+	 * private to kernel/time, so set the state its predicates read;
+	 * ONESHOT_STOPPED is exactly "programmed but not running" and is what
+	 * `dadao_clockevent_start()` leaves again.
+	 */
+	dev->set_state_shutdown(dev);
+	dev->state_use_accessors = CLOCK_EVT_STATE_ONESHOT_STOPPED;
+#endif
+}
+
+unsigned long dadao_tick_count(void)
+{
+	return dadao_ticks;
+}
+
+void __noreturn dadao_k2_fail(unsigned int checkpoint, const char *what)
+{
+	dadao_early_printf("K2 fail: %s code=%#x\n", what, checkpoint);
+	dadao_early_exit(checkpoint);
+}
+
+/*
+ * A delivered source this kernel has no handler for (IPI is not implemented at
+ * K2, contract-see §3).  It is an *abnormal termination*, not a self-check
+ * verdict, so it takes the §7.1 monitor segment with the frame's entry mode and
+ * the cause's bit index — the same encoding dadao_die() uses for synchronous
+ * causes.
+ */
+void __noreturn dadao_async_die(unsigned long cause, unsigned long info)
+{
+	extern unsigned long dadao_async_prev_mode;
+	unsigned long mode = READ_ONCE(dadao_async_prev_mode) & 0x3;
+	/* spec/Kaiwu §7.1: 0xc0 | mode << 4 | bit index of the cause id.
+	 * A zero cause id has no bit index; it is not an event this entry can
+	 * classify, so it keeps 0 instead of calling __ffs(0). */
+	unsigned long index = cause ? ((unsigned long)__ffs(cause) & 0xf) : 0UL;
+	unsigned long code = 0xc0UL | (mode << 4) | index;
+
+	/*
+	 * No semihosting here (待裁定 4 / C): record, and let `dadao_early_exit`
+	 * print it once the frame is gone.
+	 */
+	dadao_flog_last[0] = 0xa5a5000000000000UL | (cause & 0xffff);
+	dadao_flog_last[1] = info;
+	dadao_flog_last[2] = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_ASYNC,
+				       CFX_HART_RC_ASYNC_CAUSE_IP);
+	dadao_flog_last[3] = mode;
+	dadao_early_exit(code);
+}
+
+/* -------------------------------------------------------------------------
+ * Read (cfx_time, cfxha 34)
+ * ------------------------------------------------------------------------- */
+
+unsigned long dadao_time_freq(void)
+{
+	return DADAO_CFX_READ(cfx_time, CFX_TIME_CG_FREQ, CFX_TIME_RC_FREQ);
+}
+
+/*
+ * The whole 64-bit `cfx_time_value` comes back in one `cfx2rd` (the register is
+ * 64-bit wide, spec/DADAO-12 §4.10), so there is no high/low pair to be torn by
+ * an interrupt — the invariant this port relies on when it samples the time
+ * from inside the asynchronous handler.
+ */
+unsigned long dadao_read_time(void)
+{
+	return DADAO_CFX_READ(cfx_time, CFX_TIME_CG_FREQ, CFX_TIME_RC_VALUE);
+}
+
+/* -------------------------------------------------------------------------
+ * Program / confirm (cfx_hart cg16, cfxha 15)
+ * ------------------------------------------------------------------------- */
+
+void dadao_timer_arm(unsigned long delta_counts)
+{
+	unsigned long deadline = dadao_read_time() + delta_counts;
+
+	/*
+	 * Clear any pending bit from a previous deadline first (ADR-0064: only
+	 * an ack clears it), then program the new absolute deadline and enable
+	 * the counter.  Writing `cmp` only re-arms; it does not clear pending.
+	 */
+	dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			deadline);
+	dadao_timer_mask_bit0(0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+}
+
+void dadao_timer_stop(void)
+{
+	/* Stop issuing events and drop the stale pending bit the last expiry
+	 * left; ENABLE=0 also makes the source fail the entry predicate. */
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL, 0);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			~0UL);
+	dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+}
+
+unsigned long dadao_timer_pending(void)
+{
+	return DADAO_CFX_READ(cfx_hart, DADAO_SRC_CG, DADAO_SRC_RC_PENDING);
+}
+
+void dadao_timer_ack(unsigned long bits)
+{
+	DADAO_CFX_WRITE(cfx_hart, DADAO_SRC_CG, DADAO_SRC_RC_ACK, bits);
+}
+
+/* -------------------------------------------------------------------------
+ * The tick
+ * ------------------------------------------------------------------------- */
+
+/*
+ * One delivered TIMER.  `cause_info` is 0 for this source (§4.7), checked by
+ * the caller.
+ *
+ * Two implementations, selected at compile time by the image, never at run
+ * time: K2-boundary images keep the raw accounting they measured (the K2 gate
+ * calls `time_init()` from `setup_arch()`, before the generic tick core and
+ * before `init_IRQ()`), every other image forwards the delivery to the
+ * registered clock event device.
+ */
+void dadao_timer_interrupt(void)
+{
+#ifdef CONFIG_DADAO_K2_TIME_STOP
+	unsigned long flags;
+	unsigned long now;
+	unsigned int slot;
+
+	/*
+	 * "Read the counter -> update it -> write the compare/ctrl pair" is one
+	 * unit (task m14-linux-008 §2): with the source masked, no tick can
+	 * observe the bookkeeping half-done and no re-arm can race the previous
+	 * one.  Inside an asynchronous frame the stub has already closed the
+	 * running mode monitor's row (kernel/async_trap.S), so nesting is
+	 * blocked by the same gate; the save/restore here is what keeps the
+	 * invariant when the same code runs outside a frame, and it is cheap
+	 * enough to state unconditionally.
+	 */
+	local_irq_save(flags);
+
+	now = dadao_read_time();
+	slot = dadao_ticks;
+	dadao_ticks = slot + 1;
+
+	/*
+	 * The jiffies half of do_timer(1) (kernel/time/timekeeping.c): the
+	 * 64-bit counter is the kernel's tick count on this 64-bit port, so one
+	 * delivered tick is one jiffy.  The load-average half needs the
+	 * scheduler's per-CPU run queues, which K2 does not have yet.
+	 */
+	jiffies_64 += 1;
+
+	if (dadao_sample_on && slot < K2_TIME_SLOTS) {
+		dadao_sample_time[slot] = now;
+		dadao_sample_jiffies[slot] = jiffies_64;
+		dadao_sample_n = slot + 1;
+	}
+
+	/*
+	 * The scheduler's half of the tick, but only once something has asked for
+	 * a periodic clock (m14-linux-017's clockevent): the K2 boundary delivers
+	 * isolated ticks from `setup_arch()` — before `sched_init()` — and must
+	 * not enter the scheduler.
+	 *
+	 * The call is `sched_tick()` and not the generic "one tick has passed"
+	 * entry (`update_process_times()`, which has no prototype and is private
+	 * to kernel/time/timer.c in this tree): what K4 needs from a tick is the
+	 * scheduler's clock and the reschedule decision, while expired-timer
+	 * processing and user/system time accounting are part of the tick
+	 * framework that K5 (m14-linux-021) brings up.
+	 */
+	if (dadao_tick_on) {
+		sched_tick();
+		/*
+		 * The idle loop has to be *told* that a tick passed: without the
+		 * generic tick/clockevents framework (K5) there is no
+		 * `tick_nohz` hand-over, and `do_idle()`'s poll loop only leaves
+		 * on `TIF_NEED_RESCHED`.  Setting it for the idle task is the
+		 * minimal stand-in and is what lets `rest_init()`'s
+		 * `cpu_startup_entry()` hand the CPU to `kernel_init`.
+		 */
+		if (is_idle_task(current) && !test_tsk_need_resched(current))
+			set_tsk_need_resched(current);
+	}
+
+	/* Re-arm from *this* sample, so the next deadline is one period away from
+	 * the tick that was just accounted (not from the end of this handler). */
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CMP,
+			now + dadao_period);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_TIMER, CFX_HART_RC_TIMER_CTRL,
+			DADAO_TIMER_ENABLE);
+
+	local_irq_restore(flags);
+
+#if CONFIG_DADAO_K2_IRQ_TEST
+	/*
+	 * Probe image only (kernel/k2_irq_test.c): the handler restored the row
+	 * it inherited (the one the async stub closed), so this is the place to
+	 * show that a source made pending here is *not* delivered until `escape`
+	 * restores the interrupted word.
+	 */
+	dadao_k2_irq_inframe();
+#endif
+#else
+	struct clock_event_device *dev = &dadao_clock_event_device;
+	unsigned long flags;
+
+	/*
+	 * The generic tick runs in hardirq context: `update_process_times()`
+	 * calls `irq_work_tick()`, whose `irq_work_run_list()` asserts
+	 * `irqs_disabled()`.  Other architectures get that from the exception
+	 * entry; here the IE state is the monitor row, so the handler closes the
+	 * knob for its body and restores the state it inherited afterwards (what
+	 * `irqentry_enter()`/`irq_exit()` do elsewhere).  That inherited state
+	 * is the row the async stub closed (kernel/async_trap.S), so nested
+	 * delivery stays impossible while the frame is live (contract-see §6.3).
+	 */
+	flags = arch_local_save_flags();
+	arch_local_irq_disable();
+
+	/*
+	 * The generic tick owns the accounting: `tick_handle_periodic()` (the
+	 * handler `tick_setup_device()` installs at registration) runs
+	 * `do_timer(1)` — i.e. `jiffies_64 += 1` — then `update_wall_time()`,
+	 * and `update_process_times()` drives the timer wheel, `sched_tick()`
+	 * and POSIX CPU timers.  The arch neither writes `jiffies_64` nor
+	 * re-arms: the handler's oneshot loop programs the next deadline through
+	 * `set_next_event()`.
+	 *
+	 * A delivery without a handler would mean `clockevents_config_and_register()`
+	 * failed in `time_init()`; there is no valid hand-accounting fallback in
+	 * this configuration, so report it instead of inventing one.
+	 */
+	if (WARN_ON_ONCE(!dev->event_handler)) {
+		arch_local_irq_restore(flags);
+		return;
+	}
+	dadao_ticks++;
+	dev->event_handler(dev);
+	arch_local_irq_restore(flags);
+#endif
+}
+
+/*
+ * The C half of the asynchronous entry (kernel/async_trap.S, ADR-0061 R2).
+ *
+ * The stub closed `cfx_smon cg15 rc3` before reading `cg15`; the capture fields
+ * are in the globals below, the register file is in @regs (the task frame for a
+ * user delivery, the static async frame for a kernel one).  One capture may
+ * carry several sources; the bit index is the source cfxha (TIMER 15,
+ * PMEM_DMA 32, DADAO-12 §5.4).
+ */
+extern unsigned long dadao_async_prev_mode;
+extern unsigned long dadao_async_prev_cfx;
+extern unsigned long dadao_async_cause_ip;
+extern unsigned long dadao_async_src_frame;
+extern unsigned long dadao_async_saved_mask;
+
+#define DADAO_ASYNC_SRC_TIMER		(1UL << 15)
+#define DADAO_ASYNC_SRC_PMEM		(1UL << 32)
+
+/* cfx_pmem cg15 rc4: dma_status (bit1 DONE W1C, bit2 ERROR W1C). */
+#define CFX_PMEM_CG_DMA			15
+#define CFX_PMEM_RC_DMA_STATUS		4
+
+static void dadao_dma_interrupt(void)
+{
+	/*
+	 * ADR-0064: `cg16 rc18` is the only interrupt ack; it clears the
+	 * source pending bit, not `dma_status` (which the kernel has no
+	 * consumer for yet).  DONE/ERROR stay for a later owner to W1C.
+	 */
+	DADAO_CFX_WRITE(cfx_pmem, DADAO_SRC_CG, DADAO_SRC_RC_ACK,
+			DADAO_SRC_EVENT_BIT0);
+}
+
+/*
+ * The source pending bits seen when this frame's C half started, before the
+ * per-source ack.  ADR-0064 D3 makes them an invariant of the entry: the
+ * hardware sets pending when the event happens and the async entry does not
+ * clear it, so a source named in `cg15 rc4` must still read as pending here.
+ * The K2 IRQ probe reads this to prove the entry did not clear it.
+ */
+unsigned long dadao_async_seen_pending;
+
+/* Ack every source carried by the capture; called with IRQs disabled. */
+void dadao_async_ack_sources(struct pt_regs *regs)
+{
+	unsigned long frame = READ_ONCE(dadao_async_src_frame);
+	unsigned long unknown = frame & ~(DADAO_ASYNC_SRC_TIMER |
+					  DADAO_ASYNC_SRC_PMEM);
+
+	if (!frame || unknown)
+		dadao_async_die(frame ? unknown : 0, dadao_async_cause_ip);
+
+	if (frame & DADAO_ASYNC_SRC_TIMER) {
+		dadao_async_seen_pending = dadao_timer_pending();
+		/* ADR-0064: ack the source explicitly before the handler runs;
+		 * the handler only re-arms the next deadline. */
+		dadao_timer_ack(DADAO_SRC_EVENT_BIT0);
+		dadao_timer_interrupt();
+	}
+	if (frame & DADAO_ASYNC_SRC_PMEM)
+		dadao_dma_interrupt();
+}
+
+/*
+ * A delivery taken in kernel context: the interrupted context is a kernel
+ * stack, so process in place and set `need_resched`; the asm stub resumes the
+ * next instruction itself.
+ */
+void dadao_async_kernel_handler(struct pt_regs *regs)
+{
+	extern int dadao_in_frame;
+	struct pt_regs *old_regs;
+
+	/*
+	 * The stub masked the sources before reading cg15.  They stay masked
+	 * through the ack and through the register restore; the asm tail
+	 * `escape`s with the saved word, so a source that arrives in that
+	 * window cannot nest in this frame.
+	 */
+	arch_local_irq_disable();
+	dadao_in_frame = 1;
+	irq_enter_rcu();
+	old_regs = set_irq_regs(regs);
+#ifdef CONFIG_DADAO_M45_ENTRY_SELFTEST
+	m45_note_irq(regs);
+#endif
+	dadao_async_ack_sources(regs);
+	set_irq_regs(old_regs);
+	irq_exit_rcu();
+	dadao_in_frame = 0;
+
+	/* Kernel async does not switch tasks here; it only makes the request. */
+	if (!test_tsk_need_resched(current))
+		set_tsk_need_resched(current);
+
+}
+
+/* -------------------------------------------------------------------------
+ * The K2 boundary
+ * ------------------------------------------------------------------------- */
+
+/*
+ * The source registered with sched_clock (m14-linux-044): cfx_time, which
+ * counts nanoseconds directly (contract-see §3).
+ */
+static u64 dadao_sched_clock_read(void)
+{
+	return dadao_read_time();
+}
+
+void __init time_init(void)
+{
+	unsigned long freq = dadao_time_freq();
+	unsigned long first = dadao_read_time();
+
+	if (!freq)
+		dadao_k2_fail(K2_FAIL_TIME_GEOMETRY, "cfx_time frequency");
+
+	dadao_period = freq / HZ;
+	if (!dadao_period)
+		dadao_k2_fail(K2_FAIL_TIME_GEOMETRY, "period = freq / HZ");
+
+	/*
+	 * sched_clock() gets a real source (m14-linux-044).  Without
+	 * CONFIG_GENERIC_SCHED_CLOCK the call is an empty static inline
+	 * (include/linux/sched_clock.h:43-50) and the function silently keeps
+	 * jiffies resolution; with it, `bits = 64` and `rate = freq` make the
+	 * generic scaling 1 count = 1 ns, so sched_clock() and cfx_time are the
+	 * same clock — which is what m14-linux-026 requires of the clocksource
+	 * pair (T1 of the K5 clock gate compares the two).
+	 */
+	sched_clock_register(dadao_sched_clock_read, 64, freq);
+
+	/*
+	 * The delay loop needs no measurement: the frequency is known exactly,
+	 * so the per-jiffy loop count follows from it (the arm64/riscv pattern
+	 * — `lpj_fine` makes calibrate_delay() skip the jiffies-polling guess,
+	 * which is what a machine without a running tick must not do).
+	 */
+	lpj_fine = freq / HZ;
+
+	dadao_early_printf("K2 time_init: freq=%lu hz=%u period=%lu n_ticks=%u "
+			   "first=%lu\n", freq, (unsigned int)HZ, dadao_period,
+			   (unsigned int)DADAO_K2_TIME_TICKS, first);
+
+#ifndef CONFIG_DADAO_K2_TIME_STOP
+	/*
+	 * K5 (m14-linux-026): hand the same two registers to the generic time
+	 * subsystem.  `timekeeping_init()` ran just before this arch hook and is
+	 * still on the jiffies fallback; a better rated clocksource switches it
+	 * in `clocksource_select()` -> `timekeeping_notify()`, after which every
+	 * ktime/wall-clock read is `cfx_time`.  The clock event device then
+	 * takes the tick over: `clockevents_config_and_register()` runs
+	 * `tick_setup_device()`, which installs `tick_handle_periodic()` as the
+	 * handler and arms the first period — this is what replaces the K2
+	 * `dadao_timer_arm(dadao_period)` call.
+	 *
+	 * min_delta = 100 counts (100 ns at 1 GHz): comfortably above the
+	 * `cfx2rd` read cost and the delivery granularity of the machine
+	 * (`spec/DADAO-12 §5` checks delivery at instruction boundaries), while
+	 * far below one period.  max_delta is the whole 64-bit range: the
+	 * compare register is 64-bit and absolute.
+	 */
+	{
+		int rc = clocksource_register_hz(&dadao_clocksource, freq);
+
+		if (rc)
+			dadao_early_printf("K5 time: clocksource register rc=%d\n",
+					   rc);
+	}
+	dadao_clock_event_device.cpumask = cpumask_of(smp_processor_id());
+	clockevents_config_and_register(&dadao_clock_event_device, freq, 100,
+					~0UL);
+	dadao_early_printf("K5 time: cs=%s rating=%d mask=%#lx freq=%lu hz=%u "
+			   "period=%lu\n", dadao_clocksource.name,
+			   dadao_clocksource.rating,
+			   (unsigned long)dadao_clocksource.mask, freq,
+			   (unsigned int)HZ, dadao_period);
+	dadao_early_printf("K5 time: ce=%s rating=%d features=%#lx handler=%d "
+			   "min_delta=%lu\n", dadao_clock_event_device.name,
+			   dadao_clock_event_device.rating,
+			   (unsigned long)dadao_clock_event_device.features,
+			   dadao_clock_event_device.event_handler != NULL,
+			   dadao_clock_event_device.min_delta_ticks);
+#endif
+}
+
+/* Wait until @want ticks have been delivered or @window counts have passed. */
+static int __init dadao_wait_ticks(unsigned int want, unsigned long window)
+{
+	unsigned long start = dadao_read_time();
+
+	while (dadao_ticks < want) {
+		if (dadao_read_time() - start > window)
+			return -1;
+	}
+	return 0;
+}
+
+/* Burn @counts of the time base without delivering a tick. */
+static void __init dadao_wait_counts(unsigned long counts)
+{
+	unsigned long start = dadao_read_time();
+
+	while (dadao_read_time() - start <= counts)
+		;
+}
+
+/*
+ * Case 1: the source gate (`cfx_hart cg16 rc16` bit0) parked with the monitor
+ * row open.  The deadline expires (pending bit0 set) but no entry happens;
+ * opening the source gate must enter that same event exactly once, and the
+ * handler acks it before re-arming (ADR-0064).
+ */
+static void __init __maybe_unused dadao_time_case_imask(void)
+{
+	unsigned long window = 2 * dadao_period;
+	unsigned long ticks_before = dadao_ticks;
+	unsigned long pending;
+
+	dadao_timer_arm(dadao_period);
+	dadao_timer_mask_bit0(1);		/* source gate closed */
+
+	dadao_wait_counts(window);
+	pending = dadao_timer_pending();
+	dadao_early_printf("K2 imask: pending=%#lx ticks=%lu\n", pending,
+			   (unsigned long)(dadao_ticks - ticks_before));
+
+	/*
+	 * Release: open the source gate; the parked pending event enters at the
+	 * next boundary.  The half-period window makes "exactly one" a real
+	 * assertion: the handler re-arms from the current time, so a second
+	 * deadline is still half a period away.
+	 */
+	dadao_timer_mask_bit0(0);
+	dadao_wait_counts(dadao_period / 2);
+	dadao_early_printf("K2 imask: released pending=%#lx ticks=%lu\n",
+			   dadao_timer_pending(),
+			   (unsigned long)(dadao_ticks - ticks_before));
+
+	dadao_timer_stop();
+}
+
+/*
+ * The normal path: N consecutive ticks, then the stopped-timer control.
+ *
+ * The wait window is (N + 4) periods — a multiple of the period, never a
+ * wall-clock constant — so host scheduling jitter cannot fail a healthy run,
+ * while a timer that never fires still ends the boot through K2_FAIL_NO_TICK.
+ */
+static void __init __noreturn __maybe_unused dadao_time_run(void)
+{
+	unsigned long jiffies_start = jiffies_64;
+	unsigned long stop_ticks;
+	unsigned long window = (DADAO_K2_TIME_TICKS + 4) * dadao_period;
+	unsigned int i;
+	int no_tick;
+
+	/*
+	 * Count this series from zero: a probe image may have run the IMASK case
+	 * first, and its ticks must not satisfy this wait.  The timer is stopped
+	 * here, so no delivery is in flight while the counters are reset.
+	 */
+	dadao_timer_stop();
+	dadao_ticks = 0;
+	dadao_sample_n = 0;
+
+	dadao_timer_arm(dadao_period);
+	dadao_early_printf("K2 time: arm period=%lu cmp=%#lx pending=%#lx\n",
+			   dadao_period,
+			   DADAO_CFX_READ(cfx_hart, CFX_HART_CG_TIMER,
+					  CFX_HART_RC_TIMER_CMP),
+			   dadao_timer_pending());
+	dadao_sample_on = 1;
+	dadao_sample_n = 0;
+	no_tick = dadao_wait_ticks(DADAO_K2_TIME_TICKS, window);
+	dadao_sample_on = 0;
+	/*
+	 * Freeze the series before reporting it: the timer is stopped here so no
+	 * tick can arrive between the report and the exit (task §5), and so the
+	 * printed count is exactly the series that was waited for.
+	 */
+	dadao_timer_stop();
+	if (no_tick)
+		dadao_k2_fail(K2_FAIL_NO_TICK, "timer delivered no tick");
+
+	for (i = 0; i < dadao_sample_n; i++)
+		dadao_early_printf("K2 tick %u: time=%lu jiffies=%lu\n", i + 1,
+				   dadao_sample_time[i], dadao_sample_jiffies[i]);
+	dadao_early_printf("K2 time: ticks=%u jiffies_delta=%lu\n", dadao_ticks,
+			   (unsigned long)jiffies_64 - jiffies_start);
+
+	/*
+	 * Stopped-timer control: a cancelled deadline must deliver nothing, so
+	 * waiting out two more periods leaves the tick count untouched.
+	 */
+	stop_ticks = dadao_ticks;
+	dadao_wait_counts(2 * dadao_period);
+	dadao_early_printf("K2 time: after stop ticks=%lu window=%lu\n",
+			   (unsigned long)(dadao_ticks - stop_ticks),
+			   2 * dadao_period);
+
+	/*
+	 * The exit sequence runs with the knob closed (task m14-linux-008 §2):
+	 * `stop` cancels the deadline and nothing may be delivered between that
+	 * write and SYS_EXIT, so the boot cannot be perturbed while it reports and
+	 * leaves.  The mask is deliberately never restored — there is no code
+	 * after the exit.
+	 */
+	local_irq_disable();
+	dadao_timer_stop();
+	dadao_early_printf("K2 time: done ticks=%u mask=%#lx\n", dadao_ticks,
+			   dadao_irq_mask_row_smon());
+	dadao_early_exit(0);
+}
+
+/*
+ * Cases 2/3: the source gate and the running-mode monitor gate are independent
+ * and both required.  One image closes exactly one of them; the other stays
+ * open, so no tick may be entered (ADR-0064 D4).
+ */
+static void __init __noreturn __maybe_unused dadao_time_case_axis(const char *axis)
+{
+	unsigned long window = (DADAO_K2_TIME_TICKS + 2) * dadao_period;
+
+	/*
+	 * Arm first, then close the axis under test.  `dadao_timer_arm()` opens
+	 * the timer source gate; the monitor rows are left as init_IRQ set them.
+	 */
+	dadao_timer_arm(dadao_period);
+	if (strcmp(axis, "source") == 0)
+		dadao_timer_mask_bit0(1);
+	else
+		DADAO_CFX_WRITE(cfx_smon, DADAO_IRQ_CG_SUPV,
+				DADAO_IRQ_RC_SUPV_CFX_INTR_MASK,
+				dadao_irq_mask_row_smon() | DADAO_IRQ_SOURCE_BITS);
+	dadao_early_printf("K2 axisclose: axis=%s smon=%#lx umon=%#lx "
+			   "srcmask=%#lx\n", axis,
+			   dadao_irq_mask_row_smon(), dadao_irq_mask_row_umon(),
+			   DADAO_CFX_READ(cfx_hart, DADAO_SRC_CG,
+					  DADAO_SRC_RC_MASK));
+
+	dadao_wait_counts(window);
+	dadao_timer_stop();
+	dadao_early_printf("K2 axistest: axis=%s ticks=%u window=%lu\n", axis,
+			   dadao_ticks, window);
+	dadao_early_exit(0);
+}
+
+/*
+ * The K2 boundary (CONFIG_DADAO_K2_TIME_STOP), from the end of setup_arch():
+ * time base, then the asynchronous vector, then the two mask axes, then the
+ * ticks.  The order is the one spec/DADAO-12 §5.2 step 7 requires — a delivered
+ * interrupt must never land on an uninstalled vector.
+ */
+void __init __noreturn dadao_k2_time_boundary(void)
+{
+	time_init();
+	init_IRQ();
+
+#if CONFIG_DADAO_K2_IRQ_TEST
+	/* Probe image: the IE knob cases own the rest of the boot. */
+	dadao_k2_irq_test();
+#endif
+
+#if CONFIG_DADAO_K2_TIME_CASE == 1
+	dadao_time_case_imask();
+	dadao_time_run();
+#elif CONFIG_DADAO_K2_TIME_CASE == 2
+	dadao_time_case_axis("source");
+#elif CONFIG_DADAO_K2_TIME_CASE == 3
+	/* Only the (irrelevant) umon monitor row is closed: the supv monitor
+	 * row and the source gate still allow a kernel entry. */
+	DADAO_CFX_WRITE(cfx_umon, DADAO_IRQ_CG_USER,
+			DADAO_IRQ_RC_USER_CFX_INTR_MASK,
+			dadao_irq_mask_row_umon() | DADAO_IRQ_SOURCE_BITS);
+	dadao_early_printf("K2 axisclose: axis=umon smon=%#lx umon=%#lx\n",
+			   dadao_irq_mask_row_smon(),
+			   dadao_irq_mask_row_umon());
+	dadao_time_run();
+#else
+	dadao_time_run();
+#endif
+}
