diff --git a/arch/dadao/kernel/async_trap.S b/arch/dadao/kernel/async_trap.S
new file mode 100644
index 000000000..82daa1be4
--- /dev/null
+++ b/arch/dadao/kernel/async_trap.S
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO cfx_hart supv asynchronous-interrupt vector (K2).
+ *
+ * contract-see §6.3: an asynchronous source is delivered straight to its target
+ * cfx (no monitor hop), so `TIMER` (1 << 10, target `cfx_hart` = cfxha 15) in
+ * supv mode enters `cfx_hart`'s **own** `supv_excp_vector` — `cg2 rc10`, reset
+ * 0, which is why irq.c writes it before any mask is opened — with the entry
+ * mode taken from `cfx_hart_supv_switch_run_mode` (`cg2 rc8`, reset 2 = supv)
+ * and the frame dropped in `cfx_hart`'s `cg5`.  This is a different vector and
+ * a different frame from the synchronous one (kernel/trap.S, cfx_smon).
+ *
+ * The register file: the hardware saves no general register (§3.6), so the
+ * capture is asm/entry.h's `DADAO_GPR_SAVE` with the *cfx_hart* cg6 scratch
+ * registers — the stub runs with `inner_cfx_code` = cfx_hart, and cfx_smon's
+ * scratch registers are not reachable from there without a permission the
+ * kernel does not need.  That macro covers all four banks (rd/rb/ra/rf) plus
+ * the cg5-derived `ip`/`status` slots, so an interrupt taken in the middle of
+ * a *user* RA/RF sequence leaves ra0-ra63 (spec/SimRISC-00 §2.4: the handler's
+ * call/ret must not disturb them) and rf0-rf63 bit-identical — the asynchronous
+ * half of k2_selftest.c's P10 / k2_irq_test.c's P6.
+ *
+ * The escape offset is **0**, not +4: for an asynchronous frame
+ * `excp_cause_ip` is already the *next* instruction (§5.2), so `+4` would skip
+ * one instruction of the interrupted context (contract-see §6.3).
+ *
+ * Stack switch (m14-linux-045): the hardware does not switch stacks, so a
+ * delivery taken in *user* mode would run this handler on the user's stack —
+ * and a kernel store to a user page is refused (`CFXPERM`: the page's HSJU has
+ * the U bit, not the S one), which turns the first tick of a user task into a
+ * fault inside a frame.  The user-mode path therefore moves to the task's own
+ * kernel stack and adopts the captured frame into its `task_pt_regs()` slot,
+ * exactly like the umon entry (kernel/trap.S); a delivery taken in supv mode
+ * already has a kernel stack and keeps the static frame.  The distinguishing
+ * fact is the hardware's `excp_prev_run_mode` (`cg5 rc0`, spec/DADAO-12 §3.6),
+ * read before anything can overwrite it — and it is also what `status` records
+ * for `user_mode()` (asm/entry.h::DADAO_SAVE_STATUS).
+ *
+ * `escape` restores the `global_cfx_intr_mask` the delivery saved (§6.3) and
+ * the hardware re-kicks anything that accumulated while the frame was live —
+ * the kernel neither has nor needs a software pending bitmap (§6.5 gap 2).
+ *
+ * The frame base travels through `rb40` across the C call: it is a callee-saved
+ * address register (contract-abi §4.5), so the handler preserves it, and the
+ * restore below overwrites it from the frame anyway.
+ */
+#include <asm/asm-offsets.h>
+#include <asm/entry.h>
+#include <asm/trap.h>
+
+	.section .text,"ax"
+	.globl	dadao_async_excp
+	.p2align 2
+dadao_async_excp:
+	/* 1. Capture the register file (static .bss frame, cfx_hart scratch). */
+	DADAO_GPR_SAVE cfx_hart, dadao_async_save
+
+	/*
+	 * 2. Which context was interrupted?  `cg5 rc0` = `excp_prev_run_mode`,
+	 *    0 for user (spec/DADAO-12 §1).  `status` is written here, into the
+	 *    staging frame, so the adopt below carries it along.
+	 */
+	cfx2rd	cfx_hart, cg5, rc0, rd16	/* excp_prev_run_mode */
+	DADAO_SAVE_STATUS cfx_hart, rb3, .Lstatus_async	/* frame.status = mode */
+	br.z	{rd16}?, [rb0, .Lasync_from_user]
+
+	/* 3. From the kernel: SP already is a kernel stack; use the static frame. */
+	set.rb	rb16, dadao_async_save
+	jump	[rb0, .Lasync_fields]
+
+	/*
+	 * 3b. From user mode: move to this task's kernel stack (the top
+	 *     `__switch_to()` / `dadao_enter_user()` parked) and adopt the
+	 *     captured frame into `task_pt_regs(current)`.  A zero means no task
+	 *     has run yet (early boot): fall back to the static frame, which is
+	 *     sound there because no user context exists to be interrupted.
+	 */
+.Lasync_from_user:
+	set.rb	rb4, dadao_user_stack_top
+	ld.o	rb4, [rb4, 0]
+	br.z	{rb4}?, [rb0, .Lasync_static]
+	rb2rb	{rb1}, {rb4}			/* SP = the kernel-stack top */
+	add.si	rb1, -PT_REGS_SIZE		/* SP = &task_pt_regs(current) */
+	set.rb	rb5, dadao_async_adopt
+	call	[rb5, rd0, 0]			/* rb8 = &task frame (copied) */
+	rb2rb	{rb16}, {rb8}			/* frame argument from here on */
+	jump	[rb0, .Lasync_fields]
+
+.Lasync_static:
+	set.rb	rb16, dadao_async_save
+
+	/*
+	 * 4. The cg5 fields and the C half.  Arguments are the ABI's:
+	 *    rb16 = &frame (first address argument), rd16 = cause, rd17 = info
+	 *    (contract-abi §4.1: data arguments count from rd16 in declaration
+	 *    order).
+	 */
+.Lasync_fields:
+	cfx2rd	cfx_hart, cg5, rc2, rd16	/* excp_cause_id */
+	cfx2rd	cfx_hart, cg5, rc3, rd17	/* excp_cause_ip */
+	st.o	rd17, [rb16, PT_IP]		/* frame.ip = next instruction */
+	cfx2rd	cfx_hart, cg5, rc4, rd17	/* excp_cause_info -> 2nd argument */
+	rb2rb	{rb40}, {rb16}			/* frame base across the call */
+	set.rb	rb5, dadao_async_handler
+	call	[rb5, rd0, 0]			/* returns only on a handled tick */
+
+	/*
+	 * 5. Resume the interrupted context where it was: `, 0` (see the header).
+	 */
+	rb2rb	{rb3}, {rb40}
+	DADAO_GPR_RESTORE_AT
+	escape	cfx_hart, [excp_cause_ip, 0]
+
+.Lstuck:
+	jump	[rb0, .Lstuck]			/* unreachable: escape never returns */
+
+	/*
+	 * The frame: one `struct pt_regs`, 8-byte aligned for the block
+	 * transfers.   Separate from the synchronous frame: the two entries belong
+	 * to different cfx and their frames may both be live in a nested
+	 * sequence (a supv fault taken while an async frame is being handled).
+	 */
+	.section .bss,"aw",%nobits
+	.p2align 3
+	.globl	dadao_async_save
+dadao_async_save:
+	.zero	PT_REGS_SIZE
