diff --git a/arch/dadao/kernel/async_trap.S b/arch/dadao/kernel/async_trap.S
new file mode 100644
index 000000000..5d3e76df8
--- /dev/null
+++ b/arch/dadao/kernel/async_trap.S
@@ -0,0 +1,253 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO cfx_hart supv asynchronous-interrupt vector (ADR-0061 R3).
+ *
+ * The hardware delivers every asynchronous source to `cfx_hart` (cfxha 15) and
+ * overwrites the capture buffer `cg15`: `rc0` prev run mode, `rc1` prev cfx,
+ * `rc2` prev ip (the address of the next instruction; the interrupted one is
+ * already committed), `rc3` prev intr mask, `rc4` the captured source set
+ * (bit = source cfxha) and `rc5` the pending set.  The vector itself is
+ * `cg15 rc15` and the entry mode `cg15 rc14`; `init_IRQ()` installs both before
+ * any source mask is opened.
+ *
+ * A second, independent copy of the return intent is written by the hardware
+ * into the hart's own `cg5 rc8`-`rc11` (escape run mode / cfx code / ip /
+ * intr mask).  Those are the only fields `escape cfx_hart` consumes, and they
+ * are software-writable, so they are the async frame's exit intent.
+ *
+ * The capture window: `cg15` and the hart `cg5` exit intent are overwritten by
+ * the *next* asynchronous entry, so the first thing this stub does is close the
+ * running mode monitor's async mask (`cfx_smon cg15 rc3`, because the entry
+ * switched the run mode to supv).  It cannot stage `rd2`/`rd3`/`rb3` in
+ * `cfx_hart`'s cg6 scratch first: any `cfx2rc` write re-kicks a deliverable
+ * source (ADR-0064 D4), and the pending set of the capture being entered is
+ * still there, so that write would immediately re-enter and overwrite the
+ * capture.  `rd2`/`rd3` are parked in a PC-relative `.text` slot for the mask
+ * write (the interrupted SP may be a user stack this supv-mode stub must not
+ * touch) and then staged in cg6 once the mask is closed; only then does the
+ * stub read `cg15` and the exit intent, and capture the register file.  The closed mask is
+ * never re-opened by software: the final `escape cfx_hart` restores the saved
+ * word from `rc11` atomically with the mode/cfx switch and the jump.  That is
+ * why the `restore -> escape` window of the old R2/jmon design no longer
+ * exists.
+ *
+ * User context: switch to the task's kernel stack and copy the captured frame
+ * into `task_pt_regs(current)` (the umon entry's own slot), then hand the
+ * capture to `cfx_smon` with `trap cfx_smon, DADAO_SMON_FROM_ASYNC`.  The smon
+ * half acks the source(s), runs the return-to-user work loop and enters user
+ * mode through `dadao_enter_user()`; it never returns here.
+ *
+ * Kernel context: handle the capture on the current kernel stack, then write
+ * the saved exit intent back into the hart's `cg5 rc8`-`rc11`, restore the
+ * whole register file and `escape cfx_hart`.  `escape` uses no register at all
+ * and returns exactly to `rc10` (the committed instruction's successor), so
+ * there is no replay, no "+4", and no register left behind in the resumed
+ * context (the m18-linux-024 `va=0x208` failure mode).
+ *
+ * `cg15` is an entrance record, not a return frame (ADR-0061 R3 / DADAO-12
+ * §4.7): `escape` is deliberately never used with it.
+ *
+ * All GPR capture/restore is asm/entry.h's, the same sequence the synchronous
+ * stubs use (four banks rd/rb/ra/rf; spec/SimRISC-00 §2.3/§2.4).
+ */
+#include <asm/asm-offsets.h>
+#include <asm/cfx.h>
+#include <asm/entry.h>
+#include <asm/trap.h>
+
+	.section .text,"ax"
+	.globl	dadao_async_excp
+	.p2align 2
+dadao_async_excp:
+	/*
+	 * 0. Freeze the capture: `cg15` and the hart `cg5` exit intent are
+	 *    overwritten by the next entry, so the first generic cfx write in
+	 *    this stub must be the one that closes the running mode monitor's
+	 *    async mask (`cfx_smon cg15 rc3`, because the entry switched the
+	 *    run mode to supv).  A cfx2rc write re-kicks a deliverable source
+	 *    (ADR-0064 D4), so staging rd2/rd3 in the cfx scratch *before*
+	 *    this write would re-enter and overwrite the capture.  They are
+	 *    parked in a PC-relative `.text` slot instead: the interrupted SP
+	 *    may be a *user* stack, and this stub still runs on it (the stack
+	 *    switch happens only in the user arm), which a supv-mode store
+	 *    cannot touch.  The whole sequence is one translation block, and
+	 *    the first `cfx2rc` closes the mask, so no entry can interleave.
+	 *    Source pending is deliberately left set: only the C half's
+	 *    per-source ack clears it (D3).
+	 */
+	st.o	rd2, [rb0, .Lasync_spill]
+	st.o	rd3, [rb0, .Lasync_spill + 8]
+	cfx2rd	cfx_smon, cg15, rc3, rd2	/* the inherited supv mask word */
+	st.o	rd2, [rb0, .Lasync_spill + 16]	/* keep it for the frame/return */
+	set.rd	rd3, (1 << 15) | (1 << 32)	/* TIMER | PMEM_DMA */
+	or.o	rd2, rd2, rd3
+	cfx2rc	cfx_smon, cg15, rc3, rd2	/* masked: capture is stable */
+	ld.o	rd2, [rb0, .Lasync_spill]
+	ld.o	rd3, [rb0, .Lasync_spill + 8]
+
+	/*
+	 * 1. Stage the three registers the generic save borrows in cfx_hart's
+	 *    cg6 scratch.  The mask is closed, so these writes cannot be
+	 *    interleaved by another entry.  `cg15` and the hart `cg5` exit
+	 *    intent cannot change again until the escape at the end restores
+	 *    the saved word.
+	 */
+	cfx2rc	cfx_hart, cg6, rc0, rd2		/* scratch[0] = interrupted rd2 */
+	cfx2rc	cfx_hart, cg6, rc1, rd3		/* scratch[1] = interrupted rd3 */
+	rb2rd	rd2, rb3, 1			/* rd2 = interrupted rbtp */
+	cfx2rc	cfx_hart, cg6, rc2, rd2		/* scratch[2] = interrupted rb3 */
+	ld.o	rd2, [rb0, .Lasync_spill + 16]	/* the word read before masking */
+	cfx2rc	cfx_hart, cg6, rc3, rd2		/* scratch[3] = saved mask */
+
+	/*
+	 * 2. Read the entrance record (`cg15 rc0`-`rc4`) into globals the C half
+	 *    consumes, and the exit intent (`cg5 rc8`-`rc11`) into its own
+	 *    globals; a nested entry cannot interleave before the escape below.
+	 */
+	set.rb	rb3, dadao_async_prev_mode
+	cfx2rd	cfx_hart, cg15, rc0, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_prev_cfx
+	cfx2rd	cfx_hart, cg15, rc1, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_cause_ip
+	cfx2rd	cfx_hart, cg15, rc2, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_src_frame
+	cfx2rd	cfx_hart, cg15, rc4, rd2		/* rc3 is prev mask, rc4 src set */
+	st.o	rd2, [rb3, 0]
+
+	set.rb	rb3, dadao_async_esc_mode
+	cfx2rd	cfx_hart, cg5, rc8, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_esc_cfx
+	cfx2rd	cfx_hart, cg5, rc9, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_esc_ip
+	cfx2rd	cfx_hart, cg5, rc10, rd2
+	st.o	rd2, [rb3, 0]
+	/* rc11 is both the exit intent's mask and this entry's saved word. */
+	set.rb	rb3, dadao_async_esc_mask
+	cfx2rd	cfx_hart, cg5, rc11, rd2
+	st.o	rd2, [rb3, 0]
+	set.rb	rb3, dadao_async_saved_mask
+	cfx2rd	cfx_hart, cg6, rc3, rd2
+	st.o	rd2, [rb3, 0]
+
+	/* 3. Capture the complete register file (rd2/rd3/rb3 already staged). */
+	DADAO_GPR_SAVE_STAGED cfx_hart, dadao_async_save
+
+	/* frame.ip = async_cause_ip, frame.status = prev_run_mode == user */
+	set.rb	rb4, dadao_async_cause_ip
+	ld.o	rd2, [rb4, 0]
+	st.o	rd2, [rb3, PT_IP]
+	set.rb	rb4, dadao_async_prev_mode
+	ld.o	rd2, [rb4, 0]
+	set.rd	rd3, DADAO_STATUS_USER
+	br.z	{rd2}?, [rb0, .Lasync_status_done]
+	set.rd	rd3, 0
+.Lasync_status_done:
+	st.o	rd3, [rb3, PT_STATUS]
+
+	br.z	{rd2}?, [rb0, .Lasync_from_user]
+
+	/*
+	 * 4. Kernel context: handle here, then return through the hart's own
+	 *    exit intent.  The async entry left the hardware's current cfx at
+	 *    `cfx_hart` (DADAO-12 §5.4), which is exactly the cfx `escape
+	 *    cfx_hart` requires; no second monitor is involved.
+	 */
+	set.rb	rb16, dadao_async_save
+	set.rb	rb5, dadao_async_kernel_handler
+	call	[rb5, rd0, 0]
+
+	/* 5. Write the saved exit intent back (`rc10` = the committed ip). */
+	set.rb	rb4, dadao_async_esc_mode
+	ld.o	rd2, [rb4, 0]
+	cfx2rc	cfx_hart, cg5, rc8, rd2
+	set.rb	rb4, dadao_async_esc_cfx
+	ld.o	rd2, [rb4, 0]
+	cfx2rc	cfx_hart, cg5, rc9, rd2
+	set.rb	rb4, dadao_async_esc_ip
+	ld.o	rd2, [rb4, 0]
+	cfx2rc	cfx_hart, cg5, rc10, rd2
+	set.rb	rb4, dadao_async_esc_mask
+	ld.o	rd2, [rb4, 0]
+	cfx2rc	cfx_hart, cg5, rc11, rd2
+
+	/* 6. Restore the whole register file and return to the exact ip.
+	 *    The escape also whole-word restores the saved async mask, with
+	 *    the switch and the jump, so no software re-open window exists. */
+	DADAO_GPR_RESTORE dadao_async_save
+	escape	cfx_hart
+	jump	[rb0, .Lstuck]			/* escape never returns */
+
+	/*
+	 * 7. User context: move to the task's kernel stack, adopt the capture
+	 *    into task_pt_regs(current) and hand it to cfx_smon.
+	 */
+.Lasync_from_user:
+	set.rb	rb4, dadao_user_stack_top
+	ld.o	rb4, [rb4, 0]
+	br.z	{rb4}?, [rb0, .Lasync_static]
+	rb2rb	{rb1}, {rb4}
+	add.si	rb1, -PT_REGS_SIZE
+	set.rb	rb5, dadao_async_adopt
+	call	[rb5, rd0, 0]			/* rb8 = &task frame */
+	jump	[rb0, .Lasync_handoff]
+
+.Lasync_static:
+	set.rb	rb8, dadao_async_save
+
+.Lasync_handoff:
+	/* The C half reads the globals above; the mode is already supv. */
+	trap	cfx_smon, DADAO_SMON_FROM_ASYNC
+.Lstuck:
+	jump	[rb0, .Lstuck]			/* the smon half never returns */
+
+	/*
+	 * PC-relative parking for the two staging registers and the inherited
+	 * mask word (step 0).  It lives in the same section as this stub so the
+	 * `[rb0, disp]` displacement is short; it is never executed.  One hart
+	 * and the closed mask make a single slot sound (the whole step runs in
+	 * one translation block).
+	 */
+	.p2align 3
+.Lasync_spill:
+	.zero	24
+
+	/* Capture metadata shared with kernel/time.c (no struct offsets needed). */
+	.section .bss,"aw",%nobits
+	.p2align 3
+	.globl	dadao_async_prev_mode
+dadao_async_prev_mode:
+	.zero	8
+	.globl	dadao_async_prev_cfx
+dadao_async_prev_cfx:
+	.zero	8
+	.globl	dadao_async_cause_ip
+dadao_async_cause_ip:
+	.zero	8
+	.globl	dadao_async_src_frame
+dadao_async_src_frame:
+	.zero	8
+	.globl	dadao_async_saved_mask
+dadao_async_saved_mask:
+	.zero	8
+	.globl	dadao_async_esc_mode
+dadao_async_esc_mode:
+	.zero	8
+	.globl	dadao_async_esc_cfx
+dadao_async_esc_cfx:
+	.zero	8
+	.globl	dadao_async_esc_ip
+dadao_async_esc_ip:
+	.zero	8
+	.globl	dadao_async_esc_mask
+dadao_async_esc_mask:
+	.zero	8
+
+	.p2align 3
+	.globl	dadao_async_save
+dadao_async_save:
+	.zero	PT_REGS_SIZE
