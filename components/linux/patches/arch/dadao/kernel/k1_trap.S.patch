diff --git a/arch/dadao/kernel/k1_trap.S b/arch/dadao/kernel/k1_trap.S
new file mode 100644
index 000000000..a84cfc2c8
--- /dev/null
+++ b/arch/dadao/kernel/k1_trap.S
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * DADAO supv synchronous-exception vector (K1).
+ *
+ * Every synchronous exception taken in supv mode enters cfx_smon — the supv
+ * monitor — as its first handler (spec/DADAO-12 §5.2) and is dispatched to
+ * `cfx_smon.supv_excp_vector` (§5.2 step 7).  K1 is the first milestone that
+ * runs on a table the kernel owns, so it is also the first one that must own
+ * this vector: the reset value is 0 and the hardware offers no recovery for an
+ * unmapped vector page (§5.2 step 7), which would turn a page-table fault into
+ * an endless CFXMEM recursion instead of a reportable failure.
+ *
+ * An exception saves the frame but **not** the general registers (§5.2), so the
+ * vector has to save whatever the C handler may clobber before calling it: the
+ * caller-saved set `rd4-rd31` / `rb4-rb31` (contract-abi §4.5).  That is what
+ * makes resumption sound for *any* faulting instruction, not only for the
+ * deliberate probe in mm/k1_pt.c.  The save area is static because a single
+ * hart runs one exception at a time; nested exceptions are not supported yet
+ * (K1 stops on the first real fault).
+ *
+ * Scratch registers: `rd2`/`rd3` and `rb3` are reserved (contract-abi §4.5:
+ * the compiler never allocates them), so the entry may use them without
+ * spilling — `rb3` holds the save-area base, `rd2` the byte offset of the RD
+ * half.  `rb0` is the IP and `rd0` reads as zero.
+ *
+ * After the call the registers are restored and `escape cfx_smon, [excp_cause_ip,
+ * 4]` resumes at the instruction after the faulting one (§5.3; +4 is the only
+ * non-zero legal offset).  The C handler only returns for a *deliberate* probe
+ * fault — everything else is fatal and it exits by name.
+ *
+ * The handler runs on the faulting context's stack.  K1 has a single kernel
+ * stack and only inspects its own mappings, so that is sufficient; a fault
+ * taken with a corrupt SP cannot be reported (the same limit the spec sets for
+ * the vector page itself).
+ */
+	.section .text,"ax"
+	.globl	dadao_supv_excp
+	.p2align 2
+dadao_supv_excp:
+	/*
+	 * Save the caller-saved banks the C handler may clobber *first*: the
+	 * faulting context's values are still live here, and rd16-rd18 are
+	 * about to be overwritten with the frame.
+	 */
+	set.rb	rb3, dadao_k1_excp_save
+	stm.o	{rb4:rb31}, [rb3, rd0]		/* +0 */
+	set.rd	rd2, 224
+	stm.o	{rd4:rd31}, [rb3, rd2]		/* +224 */
+
+	/*
+	 * Frame next, straight into the argument registers: the next exception
+	 * overwrites the frame, and the C handler must judge the cause/ip/info
+	 * of *this* fault (rd16/rd17/rd18 = the ABI's first three data
+	 * arguments).
+	 */
+	cfx2rd	cfx_smon, cg5, rc2, rd16	/* excp_cause_id */
+	cfx2rd	cfx_smon, cg5, rc3, rd17	/* excp_cause_ip */
+	cfx2rd	cfx_smon, cg5, rc4, rd18	/* excp_cause_info */
+
+	set.rb	rb5, dadao_k1_excp_handle
+	call	[rb5, rd0, 0]
+
+	/* Restore them, then resume after the faulting instruction. */
+	set.rb	rb3, dadao_k1_excp_save
+	set.rd	rd2, 224
+	ldm.o	{rd4:rd31}, [rb3, rd2]
+	ldm.o	{rb4:rb31}, [rb3, rd0]
+	escape	cfx_smon, [excp_cause_ip, 4]
+	swym	0
+.Lstuck:
+	jump	[rb0, .Lstuck]			/* unreachable: escape never returns */
+
+	/*
+	 * `rb4-rb31` then `rd4-rd31` = 28 + 28 * 8 bytes, 8-byte aligned so the
+	 * `stm.o`/`ldm.o` pairs stay legal (SimRISC-01 §1).
+	 */
+	.section .bss,"aw",%nobits
+	.p2align 3
+	.globl	dadao_k1_excp_save
+dadao_k1_excp_save:
+	.zero	448
