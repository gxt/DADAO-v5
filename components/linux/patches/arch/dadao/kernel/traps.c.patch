+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO traps — the supv synchronous-exception channel (K2).
+ *
+ * kernel/trap.S captures the frame and calls dadao_trap_handler(); everything
+ * that decides *what* an exception means lives here:
+ *
+ *   - the cause table (11 items, spec/DADAO-13 §2, contract-see §6.1);
+ *   - the dispatch: a registered probe may resume, anything else is fatal;
+ *   - dadao_die(): name the cause, dump the frame, stop through semihosting
+ *     SYS_EXIT with the code the exit-code segmentation requires;
+ *   - the exit-code segmentation (spec/Kaiwu §7.1, user ruling
+ *     2026-11-15 "A'"): the kernel's own self-check failures use the guest
+ *     segment 0x01-0x7f (value = check point), unrecoverable exceptions use
+ *     the monitor segment 0xc0 | (mode << 4) | bit index.
+ *
+ * There is no "assume it is the probe" default: a fault resumes only when a
+ * probe was registered for exactly that cause and faulting address by
+ * dadao_trap_probe_register().  That is what makes K1's page-table probe an
+ * ordinary client of the channel instead of a special case in the dispatcher.
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/bitops.h>
+#include <linux/hardirq.h>
+#include <linux/irq.h>
+#include <linux/extable.h>
+#include <linux/ptrace.h>
+#include <linux/interrupt.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/task_stack.h>
+#include <linux/seq_file.h>
+
+#include <linux/elfcore.h>
+
+#include <asm/cfx.h>
+#include <asm/cause-sub.h>
+#include <asm/elf.h>
+#include <asm/page.h>
+#include <asm/processor.h>
+#include <asm/ptrace.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/irqflags.h>
+
+/* m14-linux-017: no semihosting while a frame is live (待裁定 4 / C). */
+extern int dadao_in_frame;
+
+
+/* ADR-0061 R2 async handoff (kernel/time.c, kernel/entry_common.c). */
+void dadao_async_ack_sources(struct pt_regs *regs);
+#ifdef CONFIG_DADAO_M45_ENTRY_SELFTEST
+void m45_note_irq(struct pt_regs *regs);
+#endif
+#include <asm/trap.h>
+
+/* Semihosting SYS_EXIT: contract-semihosting §1/§2/§5 (rd16 = service,
+ * rb16 = argument block, and the block pointer is a PA: the responder reads
+ * guest memory through QEMU's identity debug translation). */
+#define SEMIHOST_SYS_EXIT	0x18
+#define SEMIHOST_TAG		0x3ff00
+#define ADP_STOPPED_APP_EXIT	0x20026
+
+static void __noreturn semihost_exit(unsigned long reason, unsigned long code)
+{
+	unsigned long block[2] = { reason, code };
+	register unsigned long nr __asm__("rd16") = SEMIHOST_SYS_EXIT;
+	register const void *addr __asm__("rb16") =
+		(const void *)((unsigned long)__pa(block) & 0x0000ffffffffffffUL);
+
+	__asm__ __volatile__("trap cfx0, %0" : : "i"(SEMIHOST_TAG),
+			     "r"(nr), "r"(addr) : "memory");
+
+	for (;;)
+		;
+}
+
+void machine_restart(char *cmd)
+{
+	semihost_exit(ADP_STOPPED_APP_EXIT, 0);
+}
+
+void machine_halt(void)
+{
+	semihost_exit(ADP_STOPPED_APP_EXIT, 0);
+}
+
+void machine_power_off(void)
+{
+	semihost_exit(ADP_STOPPED_APP_EXIT, 0);
+}
+
+/* -------------------------------------------------------------------------
+ * Exit codes (spec/Kaiwu §7.1, user ruling 2026-11-15 "A'")
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Guest segment: the kernel's own self-check failed.  The value is the check
+ * point number, so the host sees *which* verdict the kernel rejected without
+ * parsing the console.  The numbering is per source file, in boot order:
+ *
+ *   head.S    0x01 magic   0x02 version   0x03 size
+ *   setup.c   0x04 hart_id 0x05 page_size_log2 0x06 kernel_base
+ *             0x07 image_range 0x08 start_kernel return address
+ *   k1_pt.c   0x09 PT base 0x0a PT entry   0x0b ptw disabled
+ *             0x0c probe registration refused
+ *   trap.S    0x0d undefined resume policy
+ *   traps.c   0x0e re-entered handler  0x0f probe matched too often
+ *
+ * They stay <= 0x7f: the guest FAIL segment (and the semihosting SYS_EXIT
+ * subcode is the host exit status, so 0x100 would wrap to 0 and read as PASS).
+ */
+#define DADAO_EXIT_SELFCHECK(code)	((unsigned long)(code))
+
+/* The check points traps.c itself owns. */
+#define K2_FAIL_RECURSIVE	0x0e	/* a second exception inside the handler */
+#define K2_FAIL_HIT_BUDGET	0x0f	/* a probe matched more often than allowed */
+
+/*
+ * Monitor segment: an exception the kernel cannot recover from.  `bit5:4` is
+ * the run mode of the frame (user 00 / jail 01 / supv 10 / hypv 11) and
+ * `bit3:0` the DADAO exception bit index, i.e. the exponent of the one-hot
+ * cause id (CFXMEM = 1 << 1 => 1, ILLI = 1 << 8 => 8).
+ *
+ * The mode is *read from the frame* (`cfx_smon.excp_prev_run_mode`, §3.6)
+ * rather than assumed: the kernel runs in supv today, and the same expression
+ * keeps working when K4/K5 take the code from another mode.
+ */
+#define DADAO_EXIT_MONITOR(mode, index) \
+	(0xc0UL | (((mode) & 0x3) << 4) | ((index) & 0xf))
+
+/*
+ * "Other cfx" segment: §7.1 encodes CFXTRAP and CFXESC as `0x80 | cfxHA`, not
+ * as monitor bit indices (the two causes are cfx-to-cfx control transfers, so
+ * what identifies them is the cfx that received them, not the frame's mode).
+ *
+ * The kernel's supv vector runs inside the cfx that took the exception —
+ * cfx_smon (cfxHA 2) for supv synchronous exceptions — so the value is read
+ * from that cfx's identity register (cg4 rc0, §3.5) instead of being hardcoded.
+ * K4 (user-mode cfx: umon/jmon) must take the cfxHA from the exception path and
+ * keep the same expression.
+ */
+#define DADAO_EXIT_OTHER_CFX(cfxha)	(0x80UL | ((cfxha) & 0x3fUL))
+
+/* The 11 causes of spec/DADAO-13 §2 (contract-see §6.1) live in asm/trap.h so
+ * the self-tests and the dispatcher share one definition; the table below is
+ * in bit order.  A page-table fault is *not* in this table: since ADR-0062 it
+ * carries no low cause bit at all, only its bitmap bit in `[56:32]`, and
+ * dadao_cause_name() names that region so a diagnostic line never calls the
+ * machine's own page faults "unknown". */
+static const struct {
+	unsigned long id;
+	const char *name;
+} dadao_cause_table[] = {
+	{ DADAO_CAUSE_CFXTRAP,	"CFXTRAP" },
+	{ DADAO_CAUSE_CFXMEM,	"CFXMEM" },
+	{ DADAO_CAUSE_CFXREG,	"CFXREG" },
+	{ DADAO_CAUSE_CFXESC,	"CFXESC" },
+	{ DADAO_CAUSE_CFXPERM,	"CFXPERM" },
+	{ DADAO_CAUSE_ILLI,	"ILLI" },
+	{ DADAO_CAUSE_UNDI,	"UNDI" },
+	{ DADAO_CAUSE_RASOF,	"RASOF" },
+	{ DADAO_CAUSE_RASUF,	"RASUF" },
+	{ DADAO_CAUSE_MALIGN,	"MALIGN" },
+	{ DADAO_CAUSE_IALIGN,	"IALIGN" },
+};
+
+#define DADAO_CAUSE_COUNT	ARRAY_SIZE(dadao_cause_table)
+
+/* The name of @cause for the one-line diagnostics, or NULL when the id is not
+ * one of the 11 synchronous causes and not a bitmap page-table fault.
+ *
+ * The low cause is `excp_cause_id[15:0]`; a flat-bitmap fault (ADR-0062) has
+ * that field zero and one bit in `[56:32]`.  The two regions are mutually
+ * exclusive by the ADR's invariant, so the order below never has to guess. */
+const char *dadao_cause_name(unsigned long cause)
+{
+	unsigned long cls = DADAO_CAUSE_CLASS(cause);
+	unsigned long bits = cause & DADAO_SUB_BITMAP_MASK;
+	unsigned int i;
+
+	if (!cls && bits)
+		return (bits & DADAO_SUB_PERM_MASK) ? "PTWPERM" : "PTWMEM";
+
+	for (i = 0; i < DADAO_CAUSE_COUNT; i++)
+		if (dadao_cause_table[i].id == cls)
+			return dadao_cause_table[i].name;
+	return NULL;
+}
+
+/*
+ * Bit index of a one-hot cause id (spec/Kaiwu §7.1 takes the DADAO
+ * exception bit index).  For a table cause the result is one of
+ * 0/1/2/3/7/8/9/10/11/12/13; for a bitmap fault (ADR-0062, no §7.1 index —
+ * that table is Tiny-only, D6) it is the bitmap bit's low nibble, which keeps
+ * the code deterministic and derived from the id itself.
+ */
+static unsigned int dadao_cause_index(unsigned long cause)
+{
+	/*
+	 * __ffs() is already the 0-based index (CFXMEM = 1 << 1 => 1); the
+	 * 4-bit mask is the field width of §7.1 (`bit3:0`).  A cause outside
+	 * the 11-item table therefore still lands on a real bit index instead
+	 * of needing a new convention.  `__ffs(0)` is undefined, so an empty id
+	 * is given index 0 explicitly.
+	 */
+	if (!cause)
+		return 0;
+	return (unsigned int)__ffs(cause) & 0xf;
+}
+
+/* -------------------------------------------------------------------------
+ * Registered fault probes
+ * ------------------------------------------------------------------------- */
+
+static struct dadao_fault_probe *dadao_probe;
+
+int dadao_trap_probe_register(struct dadao_fault_probe *probe)
+{
+	if (!probe || probe->cause == 0)
+		return -EINVAL;
+	if (dadao_probe && dadao_probe != probe)
+		return -EBUSY;
+	dadao_probe = probe;
+	return 0;
+}
+
+void dadao_trap_probe_unregister(struct dadao_fault_probe *probe)
+{
+	if (dadao_probe == probe)
+		dadao_probe = NULL;
+}
+
+bool dadao_trap_probe_active(const struct dadao_fault_probe *probe)
+{
+	return probe && dadao_probe == probe;
+}
+
+static struct dadao_fault_probe *dadao_probe_match(unsigned long cause,
+						   unsigned long info)
+{
+	if (!dadao_probe || dadao_probe->cause != cause)
+		return NULL;
+	if (dadao_probe->info && dadao_probe->info != info)
+		return NULL;
+	return dadao_probe;
+}
+
+/* -------------------------------------------------------------------------
+ * Fatal path
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Re-entrancy guard: a second *synchronous* exception taken inside the handler
+ * by the same task is a kernel bug and is refused by name.
+ *
+ * The depth is **per task** (ISS-m18-012).  It used to be one per-hart `int`
+ * (`static volatile int dadao_trap_busy`), but the user-fault hand-over keeps
+ * the channel live while it sleeps: a page fault takes `mmap_read_lock()` and
+ * allocates with `GFP_KERNEL`, and the entry may be preempted, so the handler
+ * can be off the hart with its frame on its own kernel stack.  Another task
+ * then runs `trap cfx_smon, DADAO_SMON_FROM_USER` for *its* user fault, saw
+ * the hart-wide flag still set and `dadao_die()` ended the boot with
+ * `K2_FAIL_RECURSIVE` (measured 1/20 busy-wait boots: `ip=dadao_umon_excp
+ * +0x224`, `info=0x7f0802f5`, the previous line the sleeping task's
+ * `K4 umon->smon`).  A task that is inside the channel now only excludes
+ * itself; kernel/trap.S keeps the frame per task as well, so the second task
+ * can be served without touching the first one's frame.
+ *
+ * `copy_thread()` `memset()`s `struct thread_struct`, so a new task starts at
+ * 0; a nested entry by the same task sees 1 and dies exactly as before
+ * (K2 probe P9, `K2_FAIL_RECURSIVE` = 0x0e).  The acquire/release pair is in
+ * `dadao_trap_handler()` below, after the self-check it reports through.
+ *
+ * Before the first task switch there is a single boot context (`current` is
+ * not even derivable from the early stack), so that channel keeps this one
+ * per-hart flag; it is the only hart-wide state left, and no second context
+ * exists to race with it.
+ */
+static volatile int dadao_trap_busy;
+
+/*
+ * The frame, printed through the *early* console.  `show_regs()` below is the
+ * printk twin: its output sits in the ring buffer until console_init() runs,
+ * which is after the K2 boundary, so a fatal exception in K2 must not depend
+ * on it.
+ */
+static void __noreturn dadao_dump_and_exit(const char *why, struct pt_regs *regs,
+					   unsigned long cause, unsigned long info,
+					   unsigned long code)
+{
+	const char *name = dadao_cause_name(cause);
+	unsigned long mode = DADAO_CFX_READ(cfx_smon, SMON_CG_FRAME,
+					    SMON_RC_FRAME_PREV_MODE) & 0x3;
+	int i;
+
+	dadao_early_printf("dadao: %s cause=%s(%#lx) ip=%#lx info=%#lx ptbr=%#lx sp=%#lx\n",
+			   why, name ? name : "unknown", cause, regs->ip, info,
+			   dadao_ptbr_read(), regs->rb[1]);
+	if (!name)
+		dadao_early_printf("dadao: unknown cause=%#lx (not in the 11-item table)\n",
+				   cause);
+
+	for (i = 0; i < 64; i += 4)
+		dadao_early_printf("dadao: rd%02d: %016lx %016lx %016lx %016lx\n", i,
+				   regs->rd[i], regs->rd[i + 1], regs->rd[i + 2],
+				   regs->rd[i + 3]);
+	for (i = 0; i < 64; i += 4)
+		dadao_early_printf("dadao: rb%02d: %016lx %016lx %016lx %016lx\n", i,
+				   regs->rb[i], regs->rb[i + 1], regs->rb[i + 2],
+				   regs->rb[i + 3]);
+
+	dadao_early_printf("dadao: die mode=%lu code=%#lx\n", mode, code);
+	dadao_early_exit(code);
+}
+
+/*
+ * The exit code of a fatal synchronous exception (spec/Kaiwu §7.1):
+ *
+ *   CFXTRAP / CFXESC  "other cfx" segment, 0x80 | cfxHA            (0x82 here)
+ *   everything else   monitor segment, 0xc0 | (mode << 4) | index
+ *
+ * `index` is derived mechanically from the one-hot cause id (`__ffs`), so a
+ * cause outside the 11-item table still gets a code without a new convention
+ * (the console keeps printing the raw id).  `mode` is read from the frame
+ * (`cfx_smon.excp_prev_run_mode`, §3.6) rather than assumed.
+ */
+unsigned long dadao_exit_code(unsigned long cause)
+{
+	/*
+	 * A flat-bitmap fault (ADR-0062) has no low cause to segment on; §7.1's
+	 * index table is Tiny-only and Vast tests read `cause_id` directly (D6),
+	 * so this code only ever serves the kernel's own diagnostic exit.  Keep it
+	 * deterministic: the bitmap bit's low nibble, the same mechanical
+	 * derivation the table causes use.
+	 */
+	if (!DADAO_CAUSE_CLASS(cause))
+		return DADAO_EXIT_MONITOR(
+			DADAO_CFX_READ(cfx_smon, SMON_CG_FRAME,
+				       SMON_RC_FRAME_PREV_MODE),
+			dadao_cause_index(cause));
+
+	cause = DADAO_CAUSE_CLASS(cause);
+	if (cause == DADAO_CAUSE_CFXTRAP || cause == DADAO_CAUSE_CFXESC)
+		return DADAO_EXIT_OTHER_CFX(
+			DADAO_CFX_READ(cfx_smon, CFX_CG_ID, CFX_RC_ID));
+
+	return DADAO_EXIT_MONITOR(
+		DADAO_CFX_READ(cfx_smon, SMON_CG_FRAME, SMON_RC_FRAME_PREV_MODE),
+		dadao_cause_index(cause));
+}
+
+/* An unrecoverable synchronous exception: name it, dump the frame, stop. */
+static void __noreturn dadao_die(struct pt_regs *regs, unsigned long cause,
+				 unsigned long info)
+{
+	/* No semihosting inside the frame (待裁定 4 / C): record and let
+	 * dadao_early_exit print it. */
+	dadao_flog_last[0] = 0xd1e0000000000000UL | (cause & 0xffff);
+	dadao_flog_last[1] = info;
+	dadao_flog_last[2] = regs ? regs->ip : 0UL;
+	dadao_flog_last[3] = regs ? regs->rb[1] : 0UL;
+	dadao_dump_and_exit("unrecoverable supv exception", regs, cause, info,
+			    dadao_exit_code(cause));
+}
+
+/* The kernel's own verdict failed (guest segment, §7.1). */
+static void __noreturn dadao_selfcheck(unsigned int checkpoint, const char *why,
+				       struct pt_regs *regs, unsigned long cause,
+				       unsigned long info)
+{
+	dadao_dump_and_exit(why, regs, cause, info,
+			    DADAO_EXIT_SELFCHECK(checkpoint));
+}
+
+void __noreturn dadao_trap_bad_policy(void)
+{
+	dadao_early_printf("dadao: trap entry got an undefined resume policy, code=%#x\n",
+			   DADAO_TRAP_BAD_POLICY);
+	dadao_early_exit(DADAO_EXIT_SELFCHECK(DADAO_TRAP_BAD_POLICY));
+}
+
+/* -------------------------------------------------------------------------
+ * The C half of the entry
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Called from kernel/trap.S with the captured frame, `excp_cause_id` and
+ * `excp_cause_info`.  Returns one of DADAO_TRAP_RESUME_{RETRY,SKIP} — the only
+ * two offsets `escape` accepts (spec/DADAO-12 §5.3) — or never returns.
+ *
+ * The frame's `ip` is the read-only register `rb0` mirrored into the slot rb0
+ * would otherwise occupy (the union layout of asm/ptrace.h, m14-linux-046), so
+ * nothing has to copy it here.
+ */
+/*
+ * A U-mode synchronous exception handed over by the user entry
+ * (kernel/trap.S: `trap cfx_smon, DADAO_SMON_FROM_USER`).
+ *
+ * The cause is carried in registers because the hardware's own reason for this
+ * trap is CFXTRAP (the stub's `trap`) — the U-mode cause would otherwise be
+ * lost.  @frame is the *user* frame the umon entry saved; the smon frame
+ * (@smon_regs) stays a frame of its own, so the two never alias ("不串 umon
+ * 帧"), and the page-fault channel works on the user's register file, which is
+ * what its `ip`/`sp` reporting and its zero-page replacement need.
+ *
+ * Returns the supv vector's resume policy: SKIP, i.e. "continue after the
+ * trap", which lands back in the user entry stub.  A fault of the *user*
+ * process that the channel cannot serve raises SIGSEGV (mm/fault.c) and comes
+ * back here all the same: the umon stub's hand-over return runs the
+ * return-to-user tail, and *that* is where the signal is delivered (and where
+ * a fatal one may sleep in `do_exit()`).  Only a fault the channel could not
+ * even turn into a signal — a non-page-table cause, or a policy the channel
+ * does not define — still ends the boot by name.
+ */
+static unsigned long dadao_user_fault_from_umon(struct pt_regs *smon_regs,
+						struct pt_regs *frame,
+						unsigned long cause,
+						unsigned long info)
+{
+	unsigned long policy;
+
+	dadao_early_printf("K4 umon->smon: frame_umon=%#lx frame_smon=%#lx "
+			   "cause=%#lx ip=%#lx info=%#lx\n",
+			   (unsigned long)frame, (unsigned long)smon_regs,
+			   cause, frame->ip, info);
+
+	/* The carried id is a flat bitmap (ADR-0062): a page-table fault has no
+	 * low cause bit at all, so the channel's two forms (bitmap bit, and the
+	 * two non-PTW low causes it also reports) are both accepted here. */
+	if (DADAO_CAUSE_CLASS(cause) != DADAO_CAUSE_CFXMEM &&
+	    DADAO_CAUSE_CLASS(cause) != DADAO_CAUSE_CFXPERM &&
+	    !dadao_subcause_is_ptw(cause)) {
+		dadao_early_printf("K4 umon->smon: cause %#lx is not a page-table "
+				   "cause; the supv channel has no verdict for it\n",
+				   cause);
+		dadao_early_exit(0xc0UL | ((DADAO_MODE_USER & 0x3) << 4) | 0x0);
+	}
+
+	policy = dadao_do_page_fault(frame, cause, info, true);
+	if (policy == DADAO_PF_SEGV) {
+		/*
+		 * The process has been sent SIGSEGV.  Delivering it here would
+		 * call `do_exit()` inside the supv channel, whose frame
+		 * (`dadao_excp_save`) is static and may not be live across a
+		 * sleep; the umon stub's hand-over return runs the generic
+		 * work loop instead (kernel/entry_common.c:
+		 * `dadao_user_fault_return()`), where sleeping is legal.
+		 */
+		dadao_in_frame = 0;
+		return DADAO_TRAP_RESUME_SKIP;
+	}
+	if (policy != DADAO_PF_RETRY) {
+		dadao_early_printf("K4 umon->smon: the channel did not install a "
+				   "mapping (policy=%lu)\n", policy);
+		dadao_early_exit(0xc0UL | ((DADAO_MODE_USER & 0x3) << 4) | 0x1);
+	}
+
+	/*
+	 * The user resumes where its frame says: the instruction that faulted
+	 * for a served fault, the handler for a delivered signal.  The vector is
+	 * published by `dadao_user_fault_return()` after the work loop — a
+	 * signal frame rewinds `frame->ip` there, and `trap cfx_umon, 0` takes
+	 * its target from this row.
+	 */
+	dadao_in_frame = 0;
+	return DADAO_TRAP_RESUME_SKIP;
+}
+
+static unsigned long dadao_trap_dispatch(struct pt_regs *regs,
+					 unsigned long cause,
+					 unsigned long info)
+{
+	struct dadao_fault_probe *probe;
+	unsigned long raw_cause;
+
+	/*
+	 * `regs->ip` *is* the frame's `rb[0]` slot since m14-linux-046 (the union
+	 * layout: rb0 is the read-only IP register and has no slot of its own), so
+	 * the copy this line used to make is now the field itself.
+	 */
+
+#ifdef CONFIG_DADAO_K2_SELFTEST_UNKNOWN
+	/*
+	 * Probe-build hook (K2 gate case P4): `cfx_smon.excp_cause_id` is
+	 * hardware-read-only (spec/DADAO-12 §3.6, "HW"), so the only way to
+	 * show the unknown-cause path is to corrupt the value the dispatcher
+	 * receives.  Bit 5 is one of the reserved bits (§3.6: 1<<4..1<<6), so
+	 * the result is not in the 11-item table (and the dispatcher derives its
+	 * monitor bit index mechanically: __ffs(1 << 5) & 0xf == 5).  Only a probe
+	 * image sets this symbol; the K2 image never does.
+	 */
+	cause = 1UL << 5;
+#endif
+
+	/*
+	 * `cause` (the class mask) decides the control-flow branches below; the
+	 * raw id is what the name lookup, the probe match, the page-fault channel
+	 * and every diagnostic use, because a flat-bitmap fault (ADR-0062) has no
+	 * class bit at all.
+	 */
+	raw_cause = cause;
+	cause = DADAO_CAUSE_CLASS(cause);
+
+	/*
+	 * K4: the user entry's hand-over (kernel/trap.S, `.Lumon_delegate`).
+	 * Checked before the cause table because the *carried* cause is what
+	 * decides, not the CFXTRAP the hardware raised for the trampoline.
+	 */
+	if (cause == DADAO_CAUSE_CFXTRAP &&
+	    (info & 0x3ffffUL) == DADAO_SMON_FROM_USER) {
+		unsigned long policy =
+			dadao_user_fault_from_umon(regs,
+						   (struct pt_regs *)regs->rb[16],
+						   regs->rd[16], regs->rd[18]);
+
+		dadao_in_frame = 0;
+		return policy;
+	}
+
+	/*
+	 * A cause outside the 11-item table is still an *abnormal termination*,
+	 * not a self-check verdict: it must not be encoded as a guest FAIL check
+	 * point (the two would be indistinguishable in `$?`).  dadao_die() derives
+	 * the monitor bit index mechanically and keeps printing the raw id.
+	 */
+	if (!dadao_cause_name(raw_cause))
+		dadao_die(regs, raw_cause, info);
+
+	/*
+	 * The flat-bitmap shape of ADR-0062 D1 (asm/cause-sub.h): the id is 0 or
+	 * exactly one bit; a bitmap bit never rides with a low cause bit, and the
+	 * deleted / reserved positions stay 0.  An id that does not have this
+	 * shape is terminated by name *before* any decoder runs, so a malformed id
+	 * can never be read as a page fault.
+	 */
+	if (dadao_subcause_layout(raw_cause) != DADAO_SUB_LAYOUT_OK)
+		dadao_die(regs, raw_cause, info);
+
+	/* Probes register the id they serve verbatim — a bitmap bit for a page
+	 * fault (ADR-0062), a low cause for everything else — so the match below
+	 * compares the raw value; the class is only used for dispatch. */
+	probe = dadao_probe_match(raw_cause, info);
+	if (probe) {
+		unsigned long policy = DADAO_TRAP_RESUME_SKIP;
+
+		probe->hits++;
+		if (probe->max_hits && probe->hits > probe->max_hits)
+			dadao_selfcheck(K2_FAIL_HIT_BUDGET,
+					"fault probe hit too often", regs,
+					raw_cause, info);
+		if (probe->retry) {
+			probe->retry--;
+			policy = DADAO_TRAP_RESUME_RETRY;
+		}
+		if (probe->redirect) {
+			/*
+			 * `escape` returns to the exit intent `cg5 rc10`, so a
+			 * handler that wants to resume somewhere else writes it
+			 * there first and then returns RETRY (the exit intent is
+			 * the only software-writable return address).
+			 */
+			DADAO_CFX_WRITE(cfx_smon, SMON_CG_FRAME,
+					SMON_RC_ESCAPE_IP, probe->redirect);
+			regs->ip = probe->redirect;
+			policy = DADAO_TRAP_RESUME_RETRY;
+		}
+		if (probe->report)
+			probe->report(probe, regs, info);
+		dadao_in_frame = 0;
+		return policy;
+	}
+
+	/*
+	 * The page-fault channel (K3, mm/fault.c): a flat-bitmap fault carries the
+	 * page-table reason and only it can be demand-filled; the two low causes
+	 * that reach this handler (`CFXMEM` = non-PTW in-core access, `CFXPERM` =
+	 * cfx source-mask denial) are named verdicts, not page faults.  The
+	 * registered-probe channel above keeps its priority — K1's "is this VA
+	 * mapped yet?" probe, K2's self-tests and the K3 page-table self-test are
+	 * ordinary clients that must still be able to resume their own faults.
+	 *
+	 * A RETRY here re-executes the faulting instruction (`escape …, 0`); the
+	 * handler has already installed the mapping and invalidated the
+	 * translation.  Anything else is FATAL and falls through to dadao_die(),
+	 * which keeps the K2 exit-code segmentation and the one-line report.
+	 */
+	if (cause == DADAO_CAUSE_CFXMEM || cause == DADAO_CAUSE_CFXPERM ||
+	    dadao_subcause_is_ptw(raw_cause)) {
+		unsigned long policy = dadao_do_page_fault(regs, raw_cause,
+							  info, false);
+
+		if (policy == DADAO_PF_RETRY)
+			return DADAO_TRAP_RESUME_RETRY;
+
+		/*
+		 * The access came from the kernel: a user's own page fault was
+		 * handed over by kernel/trap.S `.Lumon_delegate` and never
+		 * reaches here (dadao_user_fault_from_umon() ends the boot by
+		 * name).  So this is a kernel access -- get_user/copy_from_user
+		 * and friends -- and a fault the channel cannot serve may still
+		 * be one the exception table knows how to recover.  This is the
+		 * DADAO counterpart of riscv's `no_context()` ->
+		 * fixup_exception() (arch/riscv/mm/fault.c:93-99): the fixup
+		 * label leaves "bytes not copied" in the return register, which
+		 * the uaccess caller turns into -EFAULT (m14-linux-044).
+		 */
+		if (fixup_exception(regs)) {
+			/*
+			 * `escape cfx_smon` resumes at the exit intent
+			 * `cg5 rc10`; the frame's ip field is only a memory
+			 * copy.  Publish the fixup address the same way the
+			 * probe redirect does above, then return RETRY.
+			 */
+			DADAO_CFX_WRITE(cfx_smon, SMON_CG_FRAME,
+					SMON_RC_ESCAPE_IP, regs->ip);
+			return DADAO_TRAP_RESUME_RETRY;
+		}
+	}
+
+	/* Name the machine's own id, not the masked class: a bitmap page fault
+	 * has no class bit, and the diagnostic must print what the hardware
+	 * actually raised (`raw_cause`). */
+	dadao_die(regs, raw_cause, info);
+}
+
+/*
+ * The C half of the supv channel.  m14-linux-017 briefly masked the kernel's
+ * async source around it: `escape` used to leave `inner_cfx_code` at the last
+ * delivered cfx (ISS-454), so a tick inside a frame made the frame's own
+ * `escape cfx_smon` fail with CFXESC.  `m14-spec-009` fixed that in the
+ * architecture (trap saves `excp_prev_cfx_code`, escape restores
+ * `inner_cfx_code`), so the workaround is gone and a frame may be interrupted.
+ */
+unsigned long dadao_trap_handler(struct pt_regs *regs, unsigned long cause,
+				 unsigned long info)
+{
+	unsigned long policy;
+	bool boot;
+
+	dadao_in_frame = 1;
+	/*
+	 * Re-entrancy guard (see the comment at the top of the fatal path).
+	 *
+	 * The frame tells the context apart without reading `current`: the boot
+	 * channel's frame is `dadao_excp_save`, and before the first task switch
+	 * `current` is not even derivable (the early stack is not a task stack,
+	 * `asm/thread_info.h`), which is why the pre-task channel keeps the old
+	 * one-context flag.  Any other frame is this task's own, below its kernel
+	 * SP: a second entry by *this* task is refused by name, another task's
+	 * entry is not recursion, and the counter — released after a possible
+	 * sleep in the page-fault channel — belongs to the task's own
+	 * `thread_struct`, not to the hart.
+	 */
+	boot = regs == (struct pt_regs *)dadao_excp_save;
+	if (boot) {
+		if (dadao_trap_busy)
+			dadao_selfcheck(K2_FAIL_RECURSIVE,
+					"recursive supv exception",
+					regs, cause, info);
+		dadao_trap_busy = 1;
+	} else if (current->thread.trap_depth++) {
+		dadao_selfcheck(K2_FAIL_RECURSIVE, "recursive supv exception",
+				regs, cause, info);
+	}
+	policy = dadao_trap_dispatch(regs, cause, info);
+	if (boot)
+		dadao_trap_busy = 0;
+	else
+		current->thread.trap_depth--;
+	dadao_in_frame = 0;
+	return policy;
+}
+
+/*
+ * Install the vector.  The kernel runs as cfx_smon/supv (the SEE handover sets
+ * the run mode; the cfx stays smon), so this is a write to its own cfx: the cfx
+ * axis is bypassed for self access and the cg2 row is delegated to supv by the
+ * boot SEE's hypv_cg_reg_deleg (DADAO-13 §1).
+ */
+void __init dadao_supv_vector_install(void)
+{
+	unsigned long vec = (unsigned long)dadao_supv_excp;
+
+	DADAO_CFX_WRITE(cfx_smon, SMON_CG_SUPV, SMON_RC_SUPV_EXCP_VECTOR, vec);
+	dadao_early_printf("K1 ptw vec  supv_excp_vector=%#lx handler=%#lx\n",
+			   DADAO_CFX_READ(cfx_smon, SMON_CG_SUPV,
+					  SMON_RC_SUPV_EXCP_VECTOR), vec);
+}
+
+/*
+ * The dispatch table, as the kernel will use it.  The K2 gate derives the
+ * expected table from spec/DADAO-13 §2 and compares it with this line, so the
+ * printed names/ids are the ones the dispatcher really matches on.
+ */
+void __init dadao_cause_report(void)
+{
+	unsigned int i;
+
+	dadao_early_printf("K2 trap causes: n=%u", (unsigned int)DADAO_CAUSE_COUNT);
+	for (i = 0; i < DADAO_CAUSE_COUNT; i++)
+		dadao_early_printf(" %s=%#lx", dadao_cause_table[i].name,
+				   dadao_cause_table[i].id);
+	dadao_early_printf("\nK2 trap: entry=dadao_supv_excp frame=%#lx frame_bytes=%u "
+			   "banks=rd,rb,ra,rf "
+			   "escape={cfxHA,ip=rc10} segments={self 0x01-0x7f,monitor 0xc0|mode<<4|bit}\n",
+			   (unsigned long)dadao_excp_save,
+			   (unsigned int)sizeof(struct pt_regs));
+}
+
+/* -------------------------------------------------------------------------
+ * Generic kernel helpers the port links against
+ * ------------------------------------------------------------------------- */
+
+void show_regs(struct pt_regs *regs)
+{
+	int i;
+
+	pr_info("IP: %016lx STATUS: %016lx\n", regs->ip, regs->status);
+	for (i = 0; i < 64; i += 4)
+		pr_info("rd%02d: %016lx %016lx %016lx %016lx\n", i,
+			regs->rd[i], regs->rd[i + 1], regs->rd[i + 2],
+			regs->rd[i + 3]);
+	for (i = 0; i < 64; i += 4)
+		pr_info("rb%02d: %016lx %016lx %016lx %016lx\n", i,
+			regs->rb[i], regs->rb[i + 1], regs->rb[i + 2],
+			regs->rb[i + 3]);
+}
+
+void show_stack(struct task_struct *task, unsigned long *sp, const char *loglvl)
+{
+	/*
+	 * No unwinder in K0 (frame layout and CFI land with m14-llvm-004).
+	 * Print the stack pointer so a crash still tells where we were.
+	 */
+	if (!task)
+		task = current;
+
+	printk("%sCPU: %d PID: %d Comm: %.20s\n", loglvl,
+	       raw_smp_processor_id(), task_pid_nr(task), task->comm);
+	printk("%sStack pointer: %p\n", loglvl, sp ? sp : (unsigned long *)KSTK_ESP(task));
+}
+
+int show_interrupts(struct seq_file *p, void *v)
+{
+	/* No interrupt controller exists in K0. */
+	return 0;
+}
