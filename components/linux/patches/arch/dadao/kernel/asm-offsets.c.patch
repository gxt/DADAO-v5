diff --git a/arch/dadao/kernel/asm-offsets.c b/arch/dadao/kernel/asm-offsets.c
new file mode 100644
index 000000000..ae51708d4
--- /dev/null
+++ b/arch/dadao/kernel/asm-offsets.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Generate the assembler offsets used by head.S / entry code.
+ */
+#define COMPILE_OFFSETS
+
+#include <linux/stddef.h>
+#include <linux/sched.h>
+#include <linux/kbuild.h>
+
+#include <asm/ptrace.h>
+#include <asm/thread_info.h>
+
+int main(void)
+{
+	DEFINE(THREAD_SIZE_ASM, THREAD_SIZE);
+	DEFINE(PT_REGS_SIZE, sizeof(struct pt_regs));
+	/*
+	 * `ip`/`status` are the two words with no hardware register behind them:
+	 * since m14-linux-046 they are members of the anonymous unions over the
+	 * `rb`/`rd` banks (the user ruling's 2048-byte layout), so `PT_IP ==
+	 * PT_RB_BASE` and `PT_STATUS == PT_RD_BASE`.  Taking the offsets from
+	 * these very members is what keeps every `st.o`/`ld.o` in kernel/trap.S,
+	 * kernel/async_trap.S and asm/entry.h unchanged.
+	 */
+	DEFINE(PT_IP, offsetof(struct pt_regs, ip));
+	DEFINE(PT_STATUS, offsetof(struct pt_regs, status));
+	DEFINE(PT_RD_BASE, offsetof(struct pt_regs, rd));
+	DEFINE(PT_RB_BASE, offsetof(struct pt_regs, rb));
+	DEFINE(PT_RA_BASE, offsetof(struct pt_regs, ra));
+	DEFINE(PT_RF_BASE, offsetof(struct pt_regs, rf));
+	DEFINE(PT_RA_LAST, offsetof(struct pt_regs, ra) + 63 * sizeof(unsigned long));
+	DEFINE(PT_RF_LAST, offsetof(struct pt_regs, rf) + 63 * sizeof(unsigned long));
+	DEFINE(PT_SP, offsetof(struct pt_regs, rb) + 1 * sizeof(unsigned long));
+	DEFINE(PT_RET, offsetof(struct pt_regs, rd) + 8 * sizeof(unsigned long));
+	BLANK();
+	DEFINE(TASK_STACK, offsetof(struct task_struct, stack));
+	DEFINE(TASK_THREAD, offsetof(struct task_struct, thread));
+	DEFINE(TASK_THREAD_SP, offsetof(struct task_struct, thread.sp));
+	DEFINE(TASK_THREAD_RA, offsetof(struct task_struct, thread.ra));
+	BLANK();
+	/*
+	 * The same fields relative to `struct thread_struct` itself: the switch
+	 * helper (kernel/entry.S) is handed `&task->thread`, so it addresses
+	 * `[prev_thread, THREAD_*]`.  (The TASK_THREAD_* pair above is a
+	 * task-struct offset and would be off by the `thread` member's position.)
+	 */
+	DEFINE(THREAD_SP, offsetof(struct thread_struct, sp));
+	DEFINE(THREAD_RA, offsetof(struct thread_struct, ra));
+	DEFINE(THREAD_TP, offsetof(struct thread_struct, tp));
+	DEFINE(THREAD_FP, offsetof(struct thread_struct, fp));
+	DEFINE(THREAD_RD, offsetof(struct thread_struct, rd));
+	DEFINE(THREAD_RB, offsetof(struct thread_struct, rb));
+	DEFINE(THREAD_RAS, offsetof(struct thread_struct, ras));
+	DEFINE(THREAD_RAS_LAST,
+	       offsetof(struct thread_struct, ras) + 63 * sizeof(unsigned long));
+	BLANK();
+	return 0;
+}
