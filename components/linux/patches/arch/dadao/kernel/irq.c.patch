diff --git a/arch/dadao/kernel/irq.c b/arch/dadao/kernel/irq.c
new file mode 100644
index 000000000..1bae4300f
--- /dev/null
+++ b/arch/dadao/kernel/irq.c
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO async vector installation and the per-mode source masks
+ * (ADR-0064; DADAO-12 §4.7/§5.4).
+ *
+ * Two independent gates exist: the running mode monitor's `cg15 rc3`
+ * (`cfx_<monitor>_async_intr_mask`, bit = source cfxha, 0 = allow, reset all
+ * ones) and each source's own `cg16 rc16` mask.  The async entry target is
+ * always `cfx_hart`; its supv vector lives in
+ * `cg15 rc15` and the entry mode in `cg15 rc14` (fixed supv).  The vector is
+ * written and read back before any source is opened: a delivery that landed on
+ * the reset value 0 would execute at address 0 (DADAO-12 §5.4).
+ *
+ * The kernel runs in supv, so `cfx_smon cg15 rc3` is its own gate.  A user task
+ * runs against `cfx_umon cg15 rc3`; the kernel opens the same source bits there
+ * so that a user-only spin loop is preemptible (the mode switch itself is
+ * covered by the supv row, kernel/process.c).  Nothing else is written:
+ * source masks (`cg16 rc16`) are opened once for TIMER and PMEM_DMA, then
+ * source events drive the per-source pending/ack face (ADR-0064).
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+#include <asm/cfx.h>
+#include <asm/irqflags.h>
+#include <asm/ptw.h>		/* CFX_CG_ID / CFX_RC_ID: cfx_id == cfxha */
+#include <asm/setup.h>
+#include <asm/time.h>		/* dadao_k2_fail() */
+#include <asm/trap.h>		/* dadao_async_excp[] */
+
+#define DADAO_MODE_SUPV		2
+
+#define CFX_HART_CG_ASYNC		15
+#define CFX_HART_RC_ASYNC_VECTOR	15
+#define CFX_HART_RC_ASYNC_SWITCH_MODE	14
+
+#define CFX_MON_CG_ASYNC_MASK		15
+#define CFX_MON_RC_ASYNC_MASK		3
+
+/*
+ * The supv row (`cg2`) of a monitor is no longer touched by this file: the
+ * kernel-context return uses the hart's own exit intent (ADR-0061 R3).
+ */
+
+/* Boot verdicts, guest segment of spec/Kaiwu §7.1 (time.c continues). */
+#define K2_FAIL_ASYNC_VECTOR		0x11
+#define K2_FAIL_ASYNC_MODE		0x12
+#define K2_FAIL_RESUME_VECTOR		0x16
+#define K2_FAIL_RESUME_MODE		0x17
+
+static unsigned long smon_mask(void)
+{
+	return DADAO_CFX_READ(cfx_smon, CFX_MON_CG_ASYNC_MASK,
+			      CFX_MON_RC_ASYNC_MASK);
+}
+
+static unsigned long umon_mask(void)
+{
+	return DADAO_CFX_READ(cfx_umon, CFX_MON_CG_ASYNC_MASK,
+			      CFX_MON_RC_ASYNC_MASK);
+}
+
+void __init init_IRQ(void)
+{
+	unsigned long vec = (unsigned long)dadao_async_excp;
+	unsigned long vread, mode, cfxha, bits;
+
+	/* ---- 1. the capture-buffer vector, before anything is deliverable -- */
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_ASYNC,
+			CFX_HART_RC_ASYNC_SWITCH_MODE, DADAO_MODE_SUPV);
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_ASYNC,
+			CFX_HART_RC_ASYNC_VECTOR, vec);
+	vread = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_ASYNC,
+			       CFX_HART_RC_ASYNC_VECTOR);
+	mode = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_ASYNC,
+			      CFX_HART_RC_ASYNC_SWITCH_MODE) & 0x3;
+
+	dadao_early_printf("K2 irq: vec cfx_hart_async_excp_vector=%#lx "
+			   "want=%#lx mode=%lu\n", vread, vec, mode);
+	if (vread != vec)
+		dadao_k2_fail(K2_FAIL_ASYNC_VECTOR,
+			      "cfx_hart async vector read-back");
+	if (mode != DADAO_MODE_SUPV)
+		dadao_k2_fail(K2_FAIL_ASYNC_MODE,
+			      "cfx_hart async switch_run_mode");
+
+	/*
+	 * ---- 1b. the async exit intent, before anything is deliverable ----
+	 *
+	 * `escape cfx_hart` (kernel/async_trap.S) returns through the hart's own
+	 * `cg5 rc8`-`rc11`, which the hardware copies from the entrance record
+	 * on every async entry.  There is no second monitor any more
+	 * (ADR-0061 R3), but the vector/mode pair and the writability of the
+	 * four exit-intent fields are still checked before a mask opens: a
+	 * delivery that landed on vector 0 would execute at address 0.
+	 *
+	 * 0x16 covers `cg15 rc15` (vector) and a write/read-back of
+	 * `cg5 rc8`-`rc11`; 0x17 covers `cg15 rc14` (entry run mode).
+	 */
+	vread = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_ASYNC,
+			       CFX_HART_RC_ASYNC_VECTOR);
+	mode = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_ASYNC,
+			      CFX_HART_RC_ASYNC_SWITCH_MODE) & 0x3;
+	if (vread != vec)
+		dadao_k2_fail(K2_FAIL_RESUME_VECTOR,
+			      "cfx_hart async vector read-back");
+	if (mode != DADAO_MODE_SUPV)
+		dadao_k2_fail(K2_FAIL_RESUME_MODE,
+			      "cfx_hart async switch_run_mode");
+	{
+		unsigned long v;
+
+#define DADAO_ESC_PROBE(rc, val)					\
+	do {								\
+		DADAO_CFX_WRITE(cfx_hart, CFX_CG_FRAME, rc, (val));	\
+		v = DADAO_CFX_READ(cfx_hart, CFX_CG_FRAME, rc);	\
+		if (v != (val))						\
+			dadao_k2_fail(K2_FAIL_RESUME_VECTOR,		\
+				      "cfx_hart cg5 " #rc " not writable"); \
+	} while (0)
+
+		DADAO_ESC_PROBE(CFX_RC_ESCAPE_RUN_MODE, 3);
+		DADAO_ESC_PROBE(CFX_RC_ESCAPE_CFX_CODE, 15);
+		DADAO_ESC_PROBE(CFX_RC_ESCAPE_IP, 0x1234);
+		DADAO_ESC_PROBE(CFX_RC_ESCAPE_INTR_MASK, ~0UL);
+#undef DADAO_ESC_PROBE
+		/* No frame is live at init: leave the reset fail-safe values. */
+		DADAO_CFX_WRITE(cfx_hart, CFX_CG_FRAME,
+				CFX_RC_ESCAPE_RUN_MODE, 0);
+		DADAO_CFX_WRITE(cfx_hart, CFX_CG_FRAME,
+				CFX_RC_ESCAPE_CFX_CODE, 0);
+		DADAO_CFX_WRITE(cfx_hart, CFX_CG_FRAME,
+				CFX_RC_ESCAPE_IP, 0);
+		DADAO_CFX_WRITE(cfx_hart, CFX_CG_FRAME,
+				CFX_RC_ESCAPE_INTR_MASK, ~0UL);
+	}
+
+	/*
+	 * ---- 2. the gates -------------------------------------------------
+	 * The bit index is the *source cfxha* (TIMER 15, PMEM_DMA 32).  First
+	 * ack any event left over from the firmware/boot staging, then open
+	 * the two per-source masks (`cg16 rc16`, 1 = mask, reset all ones;
+	 * only bit0 exists, reserved write bits are ignored).  The monitor
+	 * rows (`cg15 rc3`) are opened last: until then no async entry can
+	 * happen while init_IRQ is still writing its own gates.
+	 */
+	cfxha = DADAO_CFX_READ(cfx_hart, CFX_CG_ID, CFX_RC_ID) & 0x3f;
+	bits = DADAO_IRQ_SOURCE_BITS;
+	DADAO_CFX_WRITE(cfx_hart, DADAO_SRC_CG, DADAO_SRC_RC_ACK,
+			DADAO_SRC_EVENT_BIT0);
+	DADAO_CFX_WRITE(cfx_pmem, DADAO_SRC_CG, DADAO_SRC_RC_ACK,
+			DADAO_SRC_EVENT_BIT0);
+	DADAO_CFX_WRITE(cfx_hart, DADAO_SRC_CG, DADAO_SRC_RC_MASK, 0);
+	DADAO_CFX_WRITE(cfx_pmem, DADAO_SRC_CG, DADAO_SRC_RC_MASK, 0);
+
+	/* Open both monitor rows last (supv = kernel gate, umon = user
+	 * preemption policy); probes close one again at run time. */
+	DADAO_CFX_WRITE(cfx_smon, CFX_MON_CG_ASYNC_MASK,
+			CFX_MON_RC_ASYNC_MASK, smon_mask() & ~bits);
+	DADAO_CFX_WRITE(cfx_umon, CFX_MON_CG_ASYNC_MASK,
+			CFX_MON_RC_ASYNC_MASK, umon_mask() & ~bits);
+
+	dadao_early_printf("K2 irq: mask cfx_smon_async_intr_mask=%#lx "
+			   "cfx_umon_async_intr_mask=%#lx "
+			   "cfxha=%lu bits=%#lx\n", smon_mask(), umon_mask(),
+			   cfxha, bits);
+}
