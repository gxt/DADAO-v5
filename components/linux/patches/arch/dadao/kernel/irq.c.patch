diff --git a/arch/dadao/kernel/irq.c b/arch/dadao/kernel/irq.c
new file mode 100644
index 000000000..311217c30
--- /dev/null
+++ b/arch/dadao/kernel/irq.c
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO supv asynchronous-interrupt entry installation and the two mask axes
+ * (K2).
+ *
+ * Two facts decide the shape of this file (contract-see §6.3/§6.4):
+ *
+ * 1. The asynchronous entry is **not** the synchronous one.  A `TIMER` expiry
+ *    (1 << 10, target `cfx_hart` = cfxha 15) is delivered straight to its
+ *    target cfx, so the vector read is `cfx_hart_supv_excp_vector`
+ *    (`cg2 rc10`, reset 0) and the entry mode is
+ *    `cfx_hart_supv_switch_run_mode` (`cg2 rc8`, reset 2 = supv).  The vector
+ *    is written and read back **before** any mask is opened: a delivery that
+ *    lands on the reset value 0 executes at address 0 instead of at the kernel
+ *    (spec/DADAO-12 §5.2 step 7 gives no recovery for that), and the write/read
+ *    -back pair doubles as the 4-byte alignment check — the hardware ignores
+ *    the low two bits, so an unaligned entry would not read back.
+ *
+ * 2. Delivery needs **two** axes: the running mode monitor's supv
+ *    `cfx_intr_mask` row (bit index = target cfxha) *and* that monitor's
+ *    `global_cfx_intr_mask` (same bit index).  The global one is a one-time
+ *    mode-level release — the hardware saves it on frame entry and restores it
+ *    on `escape` (§6.3), so the kernel must not treat it as its IE knob; the
+ *    per-source row is the knob (contract-see §6.4).
+ *
+ * Which cfx owns that per-source row follows from the **run mode**, not from
+ * `inner_cfx_code` (spec/DADAO-12 §5.2(三) step 3, user ruling ISS-455): the
+ * kernel runs in `supv`, so the row is `cfx_smon`'s `cg2 rc4`.  It stays that
+ * row after the first delivery even though `escape` leaves `inner_cfx_code` at
+ * the target cfx (spec/DADAO-12 §5.3, contract-see §6.2) — the run mode is
+ * unchanged, so the filter keeps consulting the same monitor row (ISS-454).
+ * `cfx_hart`'s row is therefore left at its reset value; it is only *read back*
+ * below, as the witness that no kernel path writes it (m14-linux-010).
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+
+#include <asm/cfx.h>
+#include <asm/ptw.h>		/* CFX_CG_ID / CFX_RC_ID: cfx_id == cfxha (§3.5) */
+#include <asm/setup.h>
+#include <asm/time.h>		/* dadao_k2_fail() */
+#include <asm/trap.h>		/* dadao_async_excp[] */
+
+/* cfx_hart (cfxha 15): the supv row the TIMER is delivered through (§6.3). */
+#define CFX_HART_CG_SUPV		2
+#define CFX_HART_RC_SUPV_SWITCH_MODE	8
+#define CFX_HART_RC_SUPV_EXCP_VECTOR	10
+
+/* cfx_smon (cfxha 2): the kernel's own cfx — IE knob row and global row. */
+#define CFX_SMON_CG_SUPV		2
+#define CFX_SMON_RC_SUPV_CFX_INTR_MASK	4
+#define CFX_SMON_CG_GLOBAL		8
+#define CFX_SMON_RC_GLOBAL_CFX_INTR_MASK	1
+
+#define DADAO_MODE_SUPV			2
+
+/* Boot verdicts, guest segment of spec/Kaiwu §7.1 (time.c continues). */
+#define K2_FAIL_ASYNC_VECTOR		0x11
+#define K2_FAIL_ASYNC_MODE		0x12
+
+/*
+ * Which axes this image opens.  The production image (case 0) opens both; the K2
+ * gate closes exactly one of them in cases 2/3 to show that each is required on
+ * its own (task §6 P4).  The symbols are per-image config, never a runtime knob.
+ */
+#define K2_AXIS_SOURCE_OPEN	(CONFIG_DADAO_K2_TIME_CASE != 2)
+#define K2_AXIS_GLOBAL_OPEN	(CONFIG_DADAO_K2_TIME_CASE != 3)
+
+static unsigned long smon_supv_intr_mask(void)
+{
+	return DADAO_CFX_READ(cfx_smon, CFX_SMON_CG_SUPV,
+			      CFX_SMON_RC_SUPV_CFX_INTR_MASK);
+}
+
+static unsigned long hart_supv_intr_mask(void)
+{
+	return DADAO_CFX_READ(cfx_hart, CFX_HART_CG_SUPV,
+			      CFX_SMON_RC_SUPV_CFX_INTR_MASK);
+}
+
+static unsigned long smon_global_intr_mask(void)
+{
+	return DADAO_CFX_READ(cfx_smon, CFX_SMON_CG_GLOBAL,
+			      CFX_SMON_RC_GLOBAL_CFX_INTR_MASK);
+}
+
+void __init init_IRQ(void)
+{
+	unsigned long vec = (unsigned long)dadao_async_excp;
+	unsigned long vread;
+	unsigned long mode;
+	unsigned long cfxha;
+	unsigned long bit;
+	unsigned long mask;
+
+	/* ---- 1. the vector, before anything can be delivered ------------------ */
+	DADAO_CFX_WRITE(cfx_hart, CFX_HART_CG_SUPV,
+			CFX_HART_RC_SUPV_EXCP_VECTOR, vec);
+	vread = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_SUPV,
+			       CFX_HART_RC_SUPV_EXCP_VECTOR);
+	mode = DADAO_CFX_READ(cfx_hart, CFX_HART_CG_SUPV,
+			      CFX_HART_RC_SUPV_SWITCH_MODE) & 0x3;
+
+	dadao_early_printf("K2 irq: vec cfx_hart_supv_excp_vector=%#lx want=%#lx "
+			   "mode=%lu\n", vread, vec, mode);
+	if (vread != vec)
+		dadao_k2_fail(K2_FAIL_ASYNC_VECTOR,
+			      "cfx_hart supv vector read-back");
+	if (mode != DADAO_MODE_SUPV)
+		dadao_k2_fail(K2_FAIL_ASYNC_MODE,
+			      "cfx_hart supv switch_run_mode");
+
+	/*
+	 * ---- 2. the two axes ------------------------------------------------
+	 * The mask bit index is the *target cfxha* (cfx_hart), not the cause id
+	 * (TIMER = 1 << 10): §6.4 calls out the two numbering schemes explicitly.
+	 * The index is read from cfx_hart's own identity register (§3.5) instead
+	 * of hardcoding 15.
+	 */
+	cfxha = DADAO_CFX_READ(cfx_hart, CFX_CG_ID, CFX_RC_ID) & 0x3f;
+	bit = 1UL << cfxha;
+
+#if K2_AXIS_GLOBAL_OPEN
+	mask = smon_global_intr_mask() & ~bit;
+	DADAO_CFX_WRITE(cfx_smon, CFX_SMON_CG_GLOBAL,
+			CFX_SMON_RC_GLOBAL_CFX_INTR_MASK, mask);
+#endif
+
+#if K2_AXIS_SOURCE_OPEN
+	mask = smon_supv_intr_mask() & ~bit;
+	DADAO_CFX_WRITE(cfx_smon, CFX_SMON_CG_SUPV,
+			CFX_SMON_RC_SUPV_CFX_INTR_MASK, mask);
+#endif
+
+	/*
+	 * cfx_hart's row is deliberately *not* written (m14-linux-010): the
+	 * filter consults the running mode monitor's row, and the read-back in
+	 * the line below shows that this row is still the reset value.
+	 */
+	dadao_early_printf("K2 irq: mask cfx_smon_supv_cfx_intr_mask=%#lx "
+			   "cfx_hart_supv_cfx_intr_mask=%#lx "
+			   "cfx_smon_global_cfx_intr_mask=%#lx cfxha=%lu "
+			   "bit=%#lx\n", smon_supv_intr_mask(),
+			   hart_supv_intr_mask(), smon_global_intr_mask(), cfxha,
+			   bit);
+}
