+++ b/arch/dadao/kernel/process.c
@@ -0,0 +1,834 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO process model (K4, m14-linux-016).
+ *
+ * `copy_process()` / `dup_mm()` / `copy_page_range()` are generic code: this
+ * file only supplies the arch hooks they call, plus the user-mode entry the
+ * machine needs and no other arch does.
+ *
+ *  - `copy_thread()`: a child task starts either at the parent's saved user
+ *    context (fork/clone: `pt_regs` copied to the top of the child's stack,
+ *    `rd8 = 0`) or at a kernel function (kernel_thread: `args->fn`), and in
+ *    both cases with a *zeroed* callee-saved bank — the ABI makes no promise
+ *    about them across the creation of a task (contract-abi §4.5), and the
+ *    child's first resume goes through `dadao_ret_from_fork`, not through a
+ *    `ret` that would need the parent's RAS.  The one register that must not be
+ *    zeroed is `rbtp` (rb3): `start_thread()` clears it for a new *image*, but
+ *    a forked task keeps the parent's thread pointer (contract-syscall §10 —
+ *    the parent's TLS block is shared until execve).  A kernel thread has no
+ *    user address space at all (m14-linux-020): the reference `copy_mm()` took
+ *    for `kernel_thread()`'s CLONE_VM is dropped here and `rb3` stays 0.
+ *
+ *  - `start_thread()` (kernel/setup.c): the execve side — clear every register,
+ *    user entry IP and SP, `rbtp = 0`, `status = 0`.
+ *
+ *  - the user-mode entry (`dadao_user_entry_install()`,
+ *    `dadao_enter_user()`, `dadao_user_excp_handler()`): the two cfx_umon rows
+ *    of contract-syscall §8.  Entering user mode is a `trap cfx_umon` from
+ *    supv, whose target comes from `cfx_umon_supv_excp_vector` and whose new run
+ *    mode comes from `cfx_umon_supv_switch_run_mode` (0 = user); coming back is
+ *    the user's own `trap cfx_umon, 0`, whose vector is
+ *    `cfx_umon_user_excp_vector` (this file's entry stub) and whose new run mode
+ *    is `cfx_umon_user_switch_run_mode` (2 = supv).
+ *
+ *    This is the **single-frame** K4 shape (user ruling 2026-11-17, option C):
+ *    the umon cg5 frame is saved into one static `.bss` frame per entry and the
+ *    handler always returns to user; a *nested* umon entry (the handler taking
+ *    another umon exception) is not supported and is named as such.  Saving cg5
+ *    to cg6 and re-entering belongs to K5 (contract-syscall §8 嵌套).
+ *
+ * Frame handling follows m14-linux-022: the hardware stores **no** general
+ * register (§3.6), so the stub saves all four banks with asm/entry.h's
+ * `DADAO_GPR_SAVE`/`DADAO_GPR_RESTORE`, exactly like the supv stub of
+ * kernel/trap.S.
+ */
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/irq-entry-common.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/cfx.h>
+#include <asm/irqflags.h>
+#include <asm/page.h>
+#include <asm/processor.h>
+#include <asm/ptrace.h>
+#include <asm/setup.h>
+#include <asm/switch_to.h>
+#include <asm/syscall.h>
+#include <asm/thread_info.h>
+#include <asm/time.h>
+#include <asm/trap.h>
+
+/* The user-mode entry stub and the frame it saves (kernel/trap.S). */
+void dadao_umon_excp(void);
+
+/* The frame `dadao_enter_user()` loads into the register file (kernel/trap.S). */
+extern struct pt_regs dadao_user_frame;
+
+/* The kernel entry stack the user entry switches to (kernel/trap.S). */
+extern char dadao_umon_stack[];
+
+/*
+ * The kernel-stack top of the task that is about to run in user mode.
+ *
+ * The umon entry needs a stack of its own *before* it can know which task it
+ * belongs to (the hardware saves no register and SP still points at the user's
+ * stack), and it must be the trapping task's stack rather than one shared entry
+ * stack: the C half may sleep (a blocking syscall, a wait) while another task
+ * takes its own umon entry.
+ *
+ * It used to be parked in `cfx_umon cg6 rc1`, which does not survive the
+ * capture: `DADAO_GPR_SAVE` stages the user's `rd2`/`rd3` through exactly those
+ * two scratch registers, so the entry read the user's `rd3` and used it as a
+ * stack pointer (measured with this probe: a user program whose `rd3` held an
+ * `sc` result took its next trap at SP=1).  A plain per-hart variable is what
+ * the single-hart K5 shape needs: `__switch_to()` writes it before the stack
+ * moves, `dadao_enter_user()` writes it again for a task that enters user mode
+ * without a switch, and the entry reads it with SP still unknown.
+ */
+unsigned long dadao_user_stack_top;
+
+/* The staging frame the umon entry captures into (kernel/trap.S). */
+extern struct pt_regs dadao_umon_save;
+
+/*
+ * Copy the staged user frame into *this task's* `pt_regs` slot and return it
+ * (a pointer return travels in `rb8`, contract-abi §4.4).  Called by the umon
+ * entry right after it moved to the task's own kernel stack.
+ */
+struct pt_regs *dadao_umon_adopt(void)
+{
+	struct pt_regs *frame = task_pt_regs(current);
+
+	*frame = dadao_umon_save;
+	return frame;
+}
+
+/*
+ * The same adopt for the asynchronous entry (m14-linux-045): a delivery taken in
+ * user mode runs on the task's kernel stack, so its frame can live in the same
+ * `task_pt_regs()` slot the umon entry uses.
+ */
+struct pt_regs *dadao_async_adopt(void)
+{
+	struct pt_regs *frame = task_pt_regs(current);
+
+
+	*frame = *(struct pt_regs *)dadao_async_save;
+	return frame;
+}
+
+/* This task's user frame; re-derived after every C call (the C half may sleep). */
+struct pt_regs *dadao_umon_frame(void)
+{
+	return task_pt_regs(current);
+}
+
+/*
+ * The one service a K4 probe uses through a user `trap cfx_umon, 0`: report the
+ * frame and end the boot with the user's exit code.  The number is probe-only
+ * scaffolding (the real table is K5's), and it is spelled here rather than being
+ * an `-ENOSYS` that would make the probe unable to stop cleanly.
+ */
+#define DADAO_K4_SYS_EXIT	0xffff
+
+/* The guest FAIL check points of this file live in asm/setup.h (shared with
+ * the probe that judges them). */
+
+/* The context-switch probe's S5 hook (kernel/k4_switch_selftest.c). */
+int dadao_k4_s5_syscall(struct pt_regs *regs, unsigned long nr,
+			unsigned long *policy);
+
+/* The entry/exit probe's trap hook (kernel/m45_entry_selftest.c, m14-linux-045):
+ * counts the loop's syscalls and pokes the scheduler; never claims a trap. */
+int dadao_m45_user_trap(struct pt_regs *regs, unsigned long immu18,
+			unsigned long *policy);
+
+/* The signal-frame probe's trap hook (kernel/k5_signal_selftest.c,
+ * m14-linux-046): snapshots the frame at the raise, compares it after
+ * `rt_sigreturn`; claims only its own two umon functions. */
+int dadao_m46_user_trap(struct pt_regs *regs, unsigned long immu18,
+			unsigned long *policy);
+
+/* The user 64 KiB ABI probe's trap hook (kernel/k5_pagesz_selftest.c,
+ * m14-linux-028): records every trap's immediate and claims its report trap. */
+int dadao_k5p_user_trap(struct pt_regs *regs, unsigned long immu18,
+			unsigned long *policy);
+
+
+/*
+ * One instruction, in bytes: the only step `escape` offers past a `trap`
+ * (`[excp_cause_ip, +4]`, spec/DADAO-12 §5.3).  The constant itself lives in
+ * asm/trap.h, next to the resume policies it belongs to (m14-linux-046, where
+ * the umon entry turns "skip" into `ip += DADAO_INSN_BYTES`).
+ */
+
+/*
+ * A second umon entry while one is live is a kernel bug in the K4 shape (one
+ * static frame, no cg6 save): report it by name instead of silently corrupting
+ * the live frame.
+ */
+volatile int dadao_umon_busy;
+
+/* -------------------------------------------------------------------------
+ * copy_thread(): the fork/clone/kernel_thread hook
+ * ------------------------------------------------------------------------- */
+
+int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
+{
+	struct pt_regs *childregs = task_pt_regs(p);
+	struct pt_regs *regs = current_pt_regs();
+	struct thread_struct *t = &p->thread;
+
+	/*
+	 * The callee-saved banks are *not* inherited: the child starts in
+	 * `dadao_ret_from_fork` (or in its kernel function), never in the middle
+	 * of the parent's expression, so nothing of the parent's callee-saved
+	 * state may leak into it (contract-abi §4.5 says which registers a call
+	 * preserves, not that a new task starts with them).
+	 */
+	memset(t, 0, sizeof(*t));
+	t->ra = (unsigned long)dadao_ret_from_fork;
+
+	if (unlikely(args->fn)) {
+		/*
+		 * kernel_thread(): the child runs @fn(@arg) on its own kernel
+		 * stack.  rd16/rd17 are the ABI's first two data arguments
+		 * (contract-abi §4.1); the frame's IP is the entry stub, which
+		 * `dadao_ret_from_fork` reads back out of the frame.
+		 *
+		 * A kernel thread owns no user address space.  `kernel_thread()`
+		 * forces CLONE_VM, so the generic `copy_mm()` *shares* the
+		 * parent's mm rather than duplicating it — and when the parent
+		 * has none (the boot task, `kthreadd`) that already leaves the
+		 * child with `mm == NULL`.  The reference it took on a parent
+		 * that *does* have one is dropped here: a kernel thread runs on
+		 * the kernel's own mappings and inherits an `active_mm` from the
+		 * switch (`context_switch()`'s lazy-TLB arm), never a user mm of
+		 * its own (m14-linux-020; the mm-less shape is what the K4
+		 * kernel-thread probe asserts against 016's fork).
+		 */
+		if (args->kthread && p->mm) {
+			struct mm_struct *mm = p->mm;
+
+			p->mm = NULL;
+			p->active_mm = NULL;
+			mmput(mm);
+		}
+		memset(childregs, 0, sizeof(*childregs));
+		childregs->rd[16] = (unsigned long)args->fn;
+		childregs->rd[17] = (unsigned long)args->fn_arg;
+		childregs->ip = (unsigned long)dadao_ret_from_fork;
+		/* The kernel stack grows down from the frame: rb1 is the frame
+		 * itself, which `ret_from_fork` pops before calling @fn. */
+		childregs->rb[1] = (unsigned long)childregs;
+		childregs->rb[2] = 0;			/* FP: no caller frame */
+		childregs->rb[3] = 0;			/* kernel thread: no TP */
+		t->sp = (unsigned long)childregs;
+		return 0;
+	}
+
+	/*
+	 * fork()/clone(): the child returns from the same syscall the parent is
+	 * in, with the same registers — except the return value, which must be
+	 * 0 in the child (contract-syscall §9: rd8 carries it) and `rbtp`,
+	 * which `CLONE_SETTLS` replaces.
+	 *
+	 * The frame's `ip` is the *resume* address, not the trapping
+	 * instruction: the umon dispatcher advances it past the `trap` before
+	 * the syscall body runs (the parent's own return takes its address from
+	 * cg5, so only a child ever reads this field).  See
+	 * `dadao_user_excp_dispatch()`.
+	 */
+	*childregs = *regs;
+	childregs->rd[8] = 0;
+	childregs->ip = regs->ip;
+
+	/*
+	 * `rb3` = `rbtp` (contract-syscall §10).  Without `CLONE_SETTLS` the
+	 * thread pointer is inherited — a forked task shares its parent's TLS
+	 * block until execve clears it — and the parent's own frame is never
+	 * touched either way: the `tls` argument is drawn into the *child's*
+	 * frame only, which is the "parent unchanged" half of the rule.
+	 *
+	 * The argument is the syscall's 4th one (`CONFIG_CLONE_BACKWARDS`:
+	 * flags, newsp, parent_tidptr, tls, child_tidptr), so it arrives in
+	 * `rd18` by the argmask table; a `tls` value without the flag means
+	 * nothing and is ignored, as in every other port.
+	 */
+	if (args->flags & CLONE_SETTLS)
+		childregs->rb[3] = args->tls;
+	else
+		childregs->rb[3] = regs->rb[3];
+
+	/*
+	 * A new user stack only for `clone(CLONE_VM)`-style children, where the
+	 * caller passed one (args->stack); a fork keeps the parent's SP so the
+	 * child continues in the same frame.
+	 */
+	if (args->stack)
+		childregs->rb[1] = args->stack;
+	t->sp = (unsigned long)childregs;
+	t->tp = childregs->rb[3];
+	return 0;
+}
+
+/*
+ * ---- The context switch (m14-linux-017) ---------------------------------
+ */
+
+/* The register half: kernel/entry.S (why each part moves is documented there). */
+void dadao_switch_to_asm(struct thread_struct *prev, struct thread_struct *next);
+
+__visible struct task_struct *__switch_to(struct task_struct *prev,
+					  struct task_struct *next)
+{
+	/*
+	 * Park the next task's kernel-stack top where the user entry can read it
+	 * *before* it has a kernel SP of its own (`dadao_user_stack_top`, see its
+	 * definition for why it is not a cfx scratch slot).  Written before the
+	 * stack moves, so the entry can never observe the previous task's value;
+	 * the entry treats 0 as "no switch yet" and falls back to the boot entry
+	 * stack.
+	 */
+	dadao_user_stack_top = (unsigned long)task_stack_page(next) + THREAD_SIZE;
+	dadao_switch_to_asm(&prev->thread, &next->thread);
+	return prev;
+}
+
+/*
+ * A task created by copy_thread() starts here: the switch restores its
+ * `thread.sp` and jumps to `thread.ra` with an empty RAS (kernel/entry.S), so
+ * this function is entered with the new task's kernel stack and RACNT = 0 —
+ * exactly the state a `call`-free entry needs (spec/SimRISC-00 §2.4).  For a
+ * user task the frame on the task stack is the user context `start_thread()` or
+ * the parent built, and entering user mode is the same `trap cfx_umon` the boot
+ * path uses; for a kernel thread it is `fn(arg)`.
+ */
+void __noreturn dadao_ret_from_fork(void)
+{
+	struct pt_regs *regs = current_pt_regs();
+
+	/*
+	 * This function is reached by a **jump**, not a call: `__switch_to_asm`
+	 * only jumps here for a task that has never run (`thread.ra != 0`), and
+	 * a task that was switched out resumes through its own
+	 * `call __switch_to_asm` entry instead (`ret`).  So `thread.ra` must be
+	 * cleared *here*: otherwise every later resume of this task would take
+	 * the fresh-task path again, re-enter this function and run `fn` from
+	 * the top a second time (measured: `kernel_init` re-ran and blocked on
+	 * an already-consumed completion).
+	 */
+	current->thread.ra = 0;
+
+	schedule_tail(current);
+	if (regs->rb[3] == 0 && regs->ip == (unsigned long)dadao_ret_from_fork) {
+		/* kernel thread: rd16 = fn, rd17 = arg */
+		int (*fn)(void *) = (int (*)(void *))regs->rd[16];
+
+		fn((void *)regs->rd[17]);
+		/*
+		 * A kernel thread whose function returns is `kernel_init` after a
+		 * successful `kernel_execve()`: that call ran `start_thread()` on
+		 * *this* task's frame, so the frame no longer says "kernel thread"
+		 * — it holds the new program's entry IP and stack, and the task
+		 * has to continue in user mode (this is the same shape the other
+		 * ports get from `ret_from_fork` falling into `ret_to_user`).
+		 *
+		 * Anything else that returns here really is a broken kernel
+		 * thread, and is named as such instead of being sent to user mode
+		 * with a frame nobody prepared.
+		 */
+		if (regs->ip == (unsigned long)dadao_ret_from_fork ||
+		    regs->rb[1] == 0) {
+			dadao_early_printf("K4: kernel thread returned to "
+					   "ret_from_fork ip=%#lx sp=%#lx\n",
+					   regs->ip, regs->rb[1]);
+			dadao_early_exit(0x33);
+		}
+		dadao_flog_report();
+		dadao_early_printf("K4 fork: kernel thread exec'd ip=%#lx sp=%#lx "
+				   "rb3=%#lx\n", regs->ip, regs->rb[1], regs->rb[3]);
+	} else {
+		/*
+		 * A fork/clone child of a *user* task: its frame is the parent's
+		 * syscall frame, whose `ip` is the trapping instruction (the umon
+		 * entry wrote `excp_cause_ip` into it).  The child starts at the
+		 * syscall's *return* address, one instruction on — the parent's
+		 * own `escape` adds the same 4 (contract-syscall §10: 子线程从
+		 * syscall 返回处开始执行；`copy_thread()` copies the frame, this
+		 * is the one field whose value is "past" rather than "at").
+		 *
+		 * Doing it here rather than in `copy_thread()` keeps that hook a
+		 * pure copy of the parent's context, which is what m14-linux-016's
+		 * F1 asserts, and it cannot touch the kernel-thread path above
+		 * (whose frame was rewritten by `start_thread()` at execve).
+		 */
+		regs->ip += DADAO_INSN_BYTES;
+	}
+
+	dadao_enter_user(regs);
+}
+
+/* -------------------------------------------------------------------------
+ * The cfx_umon rows (contract-syscall §8)
+ * ------------------------------------------------------------------------- */
+
+void __init dadao_user_entry_install(void)
+{
+	unsigned long vec = (unsigned long)dadao_umon_excp;
+	unsigned long smon_trap, smon_reg;
+
+	/*
+	 * user row (cg0): where a *user* `trap cfx_umon, 0` lands, and the run
+	 * mode it lands in.  The reset value of the switch is already 2 (supv),
+	 * but the kernel writes both rows anyway: the entry registers are the
+	 * kernel's responsibility (contract-syscall §8), and a boot SEE that
+	 * leaves a stale row must not be able to change what a syscall does.
+	 */
+	DADAO_CFX_WRITE(cfx_umon, UMON_CG_USER, UMON_RC_SWITCH_RUN_MODE,
+			DADAO_MODE_SUPV);
+	DADAO_CFX_WRITE(cfx_umon, UMON_CG_USER, UMON_RC_EXCP_VECTOR, vec);
+
+	/*
+	 * supv row (cg2): how the *kernel* hands control to user mode.  The
+	 * vector is filled per entry by `dadao_enter_user()` (it is the user IP
+	 * of the task being started); the run mode is user.
+	 */
+	DADAO_CFX_WRITE(cfx_umon, UMON_CG_SUPV, UMON_RC_SWITCH_RUN_MODE,
+			DADAO_MODE_USER);
+
+	/*
+	 * The user mode source mask (ADR-0061 R2): while a task runs in user
+	 * mode the running mode monitor is `cfx_umon`, so its `cg8 rc1` word is
+	 * the preemption policy.  Open the sources this kernel owns; the mode
+	 * switch below is covered by the supv row, which `arch_local_irq_disable`
+	 * masks right before the trap.
+	 */
+	{
+		unsigned long mask = DADAO_CFX_READ(cfx_umon, DADAO_IRQ_CG_USER,
+						    DADAO_IRQ_RC_USER_CFX_INTR_MASK);
+
+		DADAO_CFX_WRITE(cfx_umon, DADAO_IRQ_CG_USER,
+				DADAO_IRQ_RC_USER_CFX_INTR_MASK,
+				mask & ~DADAO_IRQ_SOURCE_BITS);
+		dadao_early_printf("K4 umon irq: user_mask=%#lx bits=%#lx\n",
+				   DADAO_CFX_READ(cfx_umon, DADAO_IRQ_CG_USER,
+						  DADAO_IRQ_RC_USER_CFX_INTR_MASK),
+				   DADAO_IRQ_SOURCE_BITS);
+	}
+
+	/*
+	 * The kernel's own source bit in cfx_smon's supv row.
+	 *
+	 * Once a task is running in user mode the hardware's current cfx is
+	 * `cfx_umon` (spec/DADAO-12 §5.2 step 6 sets it on entry and `escape`
+	 * does not restore it, contract-syscall §8 嵌套 / ISS-454).  The U-mode
+	 * page-fault hand-over (`trap cfx_smon, DADAO_SMON_FROM_USER`) therefore
+	 * arrives with source cfx = 0, and the entry has to allow it: the
+	 * firmware opens source bits {2,15} only, and contract-syscall §8 puts
+	 * the "open what the kernel itself needs" half on the kernel ("不得依赖
+	 * 固件默认掩码长期放行宽于需要的来源").
+	 *
+	 * Only the two axes the hand-over actually uses are opened: `cfxtrap`
+	 * (the trampoline itself) and `cfxreg` (the supv channel reads its own
+	 * cg5 frame and the exit-code segmentation).  cfxmem/cfxexe stay masked:
+	 * the kernel never touches cfx_smon's SRAM or fetches into it.
+	 */
+	smon_trap = DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV, UMON_RC_TRAP_MASK);
+	smon_reg = DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV, UMON_RC_REG_MASK);
+	DADAO_CFX_WRITE(cfx_smon, UMON_CG_SUPV, UMON_RC_TRAP_MASK,
+			smon_trap & ~(1UL << DADAO_CFX_UMON));
+	DADAO_CFX_WRITE(cfx_smon, UMON_CG_SUPV, UMON_RC_REG_MASK,
+			smon_reg & ~(1UL << DADAO_CFX_UMON));
+
+	/*
+	 * The other half of the same rule: the cfx the kernel *reaches*, not the
+	 * one it is entered through.  Every cfx's supv mask rows are indexed by
+	 * the *source* cfx (spec/DADAO-12 §3.3), and after a task has trapped the
+	 * current cfx is `cfx_umon` (0) — so the kernel's own accesses
+	 * (`cfx2rc`/`cfx2rd` on `cfx_ptw` and `cfx_hart`'s timer, `trap cfx0` for
+	 * the console) are refused with CFXPERM unless source 0 is open.  The
+	 * firmware opens {2, 15} only; contract-syscall §8 puts the "open what the
+	 * kernel itself needs" half on the kernel.
+	 *
+	 * Measured before the fix: `dadao_ptbr_read()`/`switch_mm()` from inside
+	 * the umon handler, and the timer arming after an S5 run, all died as
+	 * `CFXPERM` (ADR-0062 D3: the only form a cfx source-mask denial has).
+	 */
+	/*
+	 * The cfx names are compile-time tokens (`cfx2rd`'s cfxha is an immediate),
+	 * so the opening is one small macro per cfx the kernel touches.
+	 */
+#define DADAO_OPEN_SUPV(cfxname)						\
+	do {									\
+		unsigned long r0 = DADAO_CFX_READ(cfxname, UMON_CG_SUPV, 0);	\
+		unsigned long r2 = DADAO_CFX_READ(cfxname, UMON_CG_SUPV, 2);	\
+										\
+		r0 &= ~DADAO_CFX_SOURCES_OPEN;					\
+		r2 &= ~DADAO_CFX_SOURCES_OPEN;					\
+		DADAO_CFX_WRITE(cfxname, UMON_CG_SUPV, 0, r0);			\
+		DADAO_CFX_WRITE(cfxname, UMON_CG_SUPV, 2, r2);			\
+	} while (0)
+
+	DADAO_OPEN_SUPV(cfx_umon);
+	DADAO_OPEN_SUPV(cfx_smon);
+	DADAO_OPEN_SUPV(cfx_ptw);
+	DADAO_OPEN_SUPV(cfx_hart);
+	DADAO_OPEN_SUPV(cfx_time);
+#undef DADAO_OPEN_SUPV
+
+	/*
+	 * The entry stack only ever runs the first few instructions of the user
+	 * entry (it moves to the task's own stack before any `call`), so its
+	 * `thread_info` is seeded once with the boot task and never read as
+	 * `current`; the cell that matters is this stack's `thread_info.task`,
+	 * refreshed by every path back to user mode.
+	 */
+	{
+		struct thread_info *ti = (struct thread_info *)dadao_umon_stack;
+
+		ti->flags = 0;
+		ti->syscall_work = 0;
+		ti->status = 0;
+		ti->preempt_count = 0;
+		ti->task = current;
+	}
+
+	dadao_early_printf("K4 umon vec user_mode=%#lx user_vector=%#lx "
+			   "supv_mode=%#lx smon_trap=%#lx smon_reg=%#lx\n",
+			   DADAO_CFX_READ(cfx_umon, UMON_CG_USER,
+					  UMON_RC_SWITCH_RUN_MODE),
+			   DADAO_CFX_READ(cfx_umon, UMON_CG_USER,
+					  UMON_RC_EXCP_VECTOR),
+			   DADAO_CFX_READ(cfx_umon, UMON_CG_SUPV,
+					  UMON_RC_SWITCH_RUN_MODE),
+			   DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV,
+					  UMON_RC_TRAP_MASK),
+			   DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV,
+					  UMON_RC_REG_MASK));
+
+	if (!DADAO_CFX_READ(cfx_umon, UMON_CG_USER, UMON_RC_EXCP_VECTOR))
+		dadao_early_exit(K4_FAIL_UMON_NO_ZERO);
+	if ((DADAO_CFX_READ(cfx_umon, UMON_CG_USER,
+			    UMON_RC_SWITCH_RUN_MODE) & 0x3) != DADAO_MODE_SUPV)
+		dadao_early_exit(K4_FAIL_UMON_SWITCH);
+	if ((DADAO_CFX_READ(cfx_umon, UMON_CG_SUPV,
+			    UMON_RC_SWITCH_RUN_MODE) & 0x3) != DADAO_MODE_USER)
+		dadao_early_exit(K4_FAIL_UMON_SWITCH);
+	if ((DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV, UMON_RC_TRAP_MASK) |
+	     DADAO_CFX_READ(cfx_smon, UMON_CG_SUPV, UMON_RC_REG_MASK)) &
+	    (1UL << DADAO_CFX_UMON))
+		dadao_early_exit(K4_FAIL_UMON_SWITCH);
+}
+
+/*
+ * Enter user mode at @regs: fill the static frame `dadao_enter_user()` restores
+ * and point the supv row at the user IP.  Never returns: the user program either
+ * traps back into `dadao_user_excp_handler()` or dies.
+ */
+void __noreturn dadao_enter_user(struct pt_regs *regs)
+{
+	/*
+	 * The user entry's C half runs on the per-hart entry stack, and this port
+	 * derives `current` from SP — so that stack's `thread_info.task` must name
+	 * the task that is about to be in user mode, on *every* entry (F28).  016's
+	 * F5 ran in the boot task; from 017 the user task is `kernel_init` or any
+	 * task after execve, and a stale cell makes `current->mm` NULL inside the
+	 * fault handler (measured).
+	 */
+	((struct thread_info *)dadao_umon_stack)->task = current;
+	dadao_user_stack_top = (unsigned long)task_stack_page(current) +
+			       THREAD_SIZE;
+	/*
+	 * The whole frame is the register file.  `rd[0]`/`rb[0]` are the two
+	 * words with no hardware register behind them (`status` and `ip`, the
+	 * union layout of asm/ptrace.h since m14-linux-046) — and they are *not*
+	 * zeroed here any more: `ip` is this task's entry address, and `status`
+	 * is the mode the frame describes, both of which the caller set.
+	 */
+	dadao_user_frame = *regs;
+	DADAO_CFX_WRITE(cfx_umon, UMON_CG_SUPV, UMON_RC_EXCP_VECTOR,
+			regs->ip);
+	/*
+	 * Mask the async source across the mode switch (m18-linux-004, ISS-498).
+	 *
+	 * `dadao_umon_enter()` restores the user's register file — including SP —
+	 * and only then executes the `trap`, so the last few instructions of the
+	 * entry run *in supv mode on the user's stack*.  A delivery taken there is
+	 * not survivable: the supv-mode arm of kernel/async_trap.S keeps the
+	 * interrupted SP (switching stacks is the user-mode arm's job), so the
+	 * handler, its console output and its `escape` all run on a user stack
+	 * (measured: `die-no-vma` from a garbled `dadao_async_die()`, and boots
+	 * that stop right after `K4 fork: kernel thread exec'd`).
+	 *
+	 * Both rows have to be closed, because they gate different deliveries:
+	 * the supv one (`cfx_smon` cg2 rc4) filters what is taken in the window
+	 * above, and `cfx_umon`'s own (cg0 rc4) filters what is taken *while the
+	 * task is in user mode* — also unsurvivable here (measured: 6/200 boots
+	 * lost with only the supv row masked, 0/200 with both).
+	 *
+	 * Nothing is lost: an event that arrives while masked stays pending in
+	 * its source and the hardware re-kicks it as soon as a kernel entry opens
+	 * the supv row (`dadao_syscall_enter()`, `dadao_trap_enter()`,
+	 * `dadao_user_fault_return()`, `dadao_async_handler()` all re-open it).
+	 * That is the preemption model kernel/entry_common.c's header already
+	 * states — a user-mode context is preempted at its next trap, never by
+	 * the tick itself.
+	 */
+	arch_local_irq_disable();
+	dadao_umon_busy = 0;
+	dadao_umon_enter();
+}
+
+/*
+ * The C half of the umon entry (kernel/trap.S `dadao_umon_excp`): the frame is
+ * the user's register file, @cause/@ip/@info are cfx_umon's cg5 after the
+ * hardware switched to supv.
+ *
+ * Return value is the entry stub's resume policy, as in kernel/trap.S:
+ * `DADAO_TRAP_RESUME_RETRY` (0) re-executes `excp_cause_ip`, `RESUME_SKIP` (1)
+ * continues after it.  Everything that cannot be resumed ends the boot by name.
+ */
+static unsigned long dadao_user_excp_dispatch_body(struct pt_regs *regs,
+						   unsigned long cause,
+						   unsigned long info)
+{
+	unsigned long cls = DADAO_CAUSE_CLASS(cause);
+	unsigned long immu18;
+
+	if (dadao_umon_busy)
+		dadao_early_exit(K4_FAIL_UMON_RECURSE);
+	dadao_umon_busy = 1;
+
+	if (cls != DADAO_CAUSE_CFXTRAP) {
+		/*
+		 * The entry stub hands every non-trap U-mode exception to the
+		 * supv channel (kernel/trap.S `.Lumon_delegate`), so reaching
+		 * this point with one of them means the stub's decision and this
+		 * handler disagree.  Name it instead of guessing a resume.
+		 */
+		dadao_early_printf("K4 user excp: cause=%#lx reached the syscall "
+				   "handler instead of the supv channel\n", cause);
+		dadao_early_exit(0xc0UL | ((DADAO_MODE_USER & 0x3) << 4) | 0x2);
+	}
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	{
+		unsigned long policy;
+
+		if (dadao_k4_s5_syscall(regs, regs->rd[15], &policy)) {
+			dadao_umon_busy = 0;
+			dadao_in_frame = 0;
+			return policy;
+		}
+	}
+#endif
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	/*
+	 * Bounded trace of the first user syscalls (probe image only): the number
+	 * lives in `rd15` (contract-syscall §1), and seeing the first few is what
+	 * tells a missing dispatch from a wrong register.  Eight lines, then off;
+	 * in-frame printing is legal again since `escape` restores
+	 * `inner_cfx_code` (m14-spec-009).
+	 */
+	{
+		static unsigned int n;
+
+		if (n++ < 8)
+			dadao_early_printf("K4 syscall: nr=rd15=%#lx rd16=%#lx "
+					   "rb16=%#lx rd17=%#lx rb17=%#lx "
+					   "ip=%#lx\n", regs->rd[15], regs->rd[16],
+					   regs->rb[16], regs->rd[17], regs->rb[17],
+					   regs->ip);
+	}
+#endif
+
+#if defined(CONFIG_DADAO_K4_SELFTEST) || defined(CONFIG_DADAO_K4_SWITCH_SELFTEST)
+	{
+		unsigned long policy;
+
+		/* The probe image's own services (kernel/k4_selftest.c or
+		 * kernel/k4_switch_selftest.c).  A milestone image does not
+		 * compile this hook at all. */
+		if (dadao_k4_user_syscall(regs, regs->rd[15], &policy)) {
+			dadao_umon_busy = 0;
+			dadao_in_frame = 0;
+			return policy;
+		}
+	}
+#endif
+
+	/*
+	 * The umon function number, parsed once: `immu18` is the low 18 bits of
+	 * the trap instruction the hardware reported (contract-syscall §8), and
+	 * both the probe's observer and the dispatcher below must see the same
+	 * value.
+	 */
+	immu18 = info & DADAO_IMMU18_MASK;
+
+#if defined(CONFIG_DADAO_K5_SYSCALL_SELFTEST)
+	{
+		unsigned long policy;
+
+		/*
+		 * The syscall probe's view of the same trap (m14-linux-023,
+		 * kernel/k5_syscall_selftest.c).  It claims only its own
+		 * reporting trap; everything else is a real syscall it wants to
+		 * see dispatched, so it observes and returns 0.
+		 */
+		if (dadao_k5_user_trap(regs, immu18, &policy)) {
+			dadao_umon_busy = 0;
+			dadao_in_frame = 0;
+			return policy;
+		}
+	}
+#endif
+
+#if defined(CONFIG_DADAO_K5_PAGESZ_SELFTEST)
+	{
+		unsigned long policy;
+
+		/*
+		 * The user 64 KiB ABI probe's view of the same trap
+		 * (m14-linux-028, kernel/k5_pagesz_selftest.c).  It claims only
+		 * its own report trap; the `mmap`/`munmap`/`mprotect`/`brk`
+		 * traps are real syscalls it wants dispatched.
+		 */
+		if (dadao_k5p_user_trap(regs, immu18, &policy)) {
+			dadao_umon_busy = 0;
+			dadao_in_frame = 0;
+			return policy;
+		}
+	}
+#endif
+
+	/*
+	 * The syscall itself (m14-linux-023, kernel/syscalls.c): the SBI
+	 * function in `immu18`, the Linux number in `rd15`, the arguments and
+	 * the result in the ABI's registers (contract-syscall §2/§3).  The C
+	 * half decides; the entry stub makes the call with the frame's
+	 * parameter registers, because that is where the ABI expects them
+	 * (`dadao_call_syscall()`, kernel/trap.S).
+	 *
+	 * The entry's re-entrancy guard covers the dispatch only: from here on
+	 * this is an ordinary kernel call on the task's own stack, and it may
+	 * sleep and let another task take its own umon entry (`dadao_umon_busy`
+	 * is what a *nested* entry into the not-yet-adopted state would trip).
+	 */
+	{
+		unsigned long fn;
+
+		dadao_umon_busy = 0;
+#ifdef CONFIG_DADAO_K5_CLONE_SELFTEST
+		{
+			unsigned long policy;
+
+			/*
+			 * The clone probe's hook (kernel/k5_clone_selftest.c)
+			 * runs *after* the guard is dropped because it blocks:
+			 * the parent's "wait for my children" trap parks here
+			 * until a child has exited, and that child's own umon
+			 * entry must not be mistaken for a nested one.  The
+			 * guard is re-armed for the dispatch below — nothing
+			 * sleeps between the two.
+			 */
+			if (dadao_k5c_user_trap(regs, immu18, &policy))
+				return policy;
+			dadao_umon_busy = 1;
+		}
+#endif
+#ifdef CONFIG_DADAO_K5_FUTEX_SELFTEST
+		{
+			unsigned long policy;
+
+			/*
+			 * The futex probe's hook (kernel/k5_futex_selftest.c)
+			 * runs after the guard is dropped for the same reason as
+			 * the clone probe's: its parent parks here waiting for a
+			 * waiter, and that waiter's own umon entry must not look
+			 * nested.
+			 */
+			if (dadao_k5f_user_trap(regs, immu18, &policy))
+				return policy;
+		}
+#endif
+#ifdef CONFIG_DADAO_M45_ENTRY_SELFTEST
+		{
+			unsigned long policy;
+
+			/*
+			 * The entry/exit probe's hook (kernel/m45_entry_selftest.c,
+			 * m14-linux-045).  It runs before the dispatch because
+			 * that is where the loop's own syscall counter lives; it
+			 * never claims a trap (returns 0), so the syscall still
+			 * goes through the table below.
+			 */
+			if (dadao_m45_user_trap(regs, immu18, &policy))
+				return policy;
+		}
+#endif
+#ifdef CONFIG_DADAO_K5_SIGNAL_SELFTEST
+		{
+			unsigned long policy;
+
+			/*
+			 * The signal-frame probe's hook
+			 * (kernel/k5_signal_selftest.c, m14-linux-046).  It
+			 * claims only its two probe-only umon functions.
+			 */
+			if (dadao_m46_user_trap(regs, immu18, &policy))
+				return policy;
+		}
+#endif
+		fn = dadao_user_syscall(regs, immu18);
+		dadao_umon_busy = 0;
+		if (fn && syscall_get_nr(current, regs) == __NR_rt_sigreturn) {
+			/*
+			 * The frame-restoring syscall (kernel/signal.c,
+			 * m14-linux-046) is the one entry whose answer is the
+			 * frame itself: `regs` already holds the interrupted
+			 * context again, so there is no return value to write
+			 * back into `rd8` (that would clobber the user's), and
+			 * the resume address it restored is where the task must
+			 * continue — `RESUME_RETRY`, not the usual "+4 after the
+			 * trap" (kernel/entry_common.c's normalisation leaves a
+			 * RETRY untouched).
+			 */
+			return (unsigned long)dadao_call_syscall(regs,
+								 (void *)fn);
+		}
+		if (fn)
+			regs->rd[8] = (unsigned long)dadao_call_syscall(regs,
+								       (void *)fn);
+	}
+
+	return dadao_user_syscall_post(regs);
+}
+
+/*
+ * Same shape as the supv channel: the F37 masking is gone with
+ * `m14-spec-009`'s `escape` semantics (see kernel/traps.c).
+ *
+ * This is only the *dispatch* half; the return-to-user tail (the generic
+ * `_TIF_WORK_MASK` work of m14-linux-045) wraps it in kernel/entry_common.c,
+ * next to the very tail it calls.
+ */
+unsigned long dadao_user_excp_dispatch(struct pt_regs *regs, unsigned long cause,
+				       unsigned long info)
+{
+	unsigned long policy;
+
+	dadao_in_frame = 1;
+	policy = dadao_user_excp_dispatch_body(regs, cause, info);
+	dadao_in_frame = 0;
+	return policy;
+}
