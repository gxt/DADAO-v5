+/*
+ * The i-th positional argument of the syscall described by @regs.
+ *
+ * The number is `rd15` (contract-syscall §3) and the frame's `rd16+`/`rb16+`
+ * are the two parameter banks; `rd8` (the result) and `rb3` (`rbtp`, §10) are
+ * never part of the argument list, and the banks start at 16 (§3).
+ */
+long dadao_syscall_arg(const struct pt_regs *regs, unsigned int i)
+{
+	unsigned long nr = regs->rd[15];
+	unsigned int mask, addr_before, data_before;
+
+	if (i >= DADAO_SYSCALL_ARGMASK_BITS)
+		return 0;
+
+	mask = (nr < __NR_syscalls) ? dadao_syscall_argmask[nr] : 0;
+	addr_before = hweight32(mask & ((1u << i) - 1));
+	data_before = i - addr_before;
+
+	if (mask & (1u << i))
+		return regs->rb[16 + addr_before];
+
+	return regs->rd[16 + data_before];
+}
