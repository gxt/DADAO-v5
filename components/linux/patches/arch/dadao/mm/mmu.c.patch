diff --git a/arch/dadao/mm/mmu.c b/arch/dadao/mm/mmu.c
new file mode 100644
index 000000000..c142abf2a
--- /dev/null
+++ b/arch/dadao/mm/mmu.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO MMU context (K3, m14-linux-011): ASID allocation.
+ *
+ * A G = 0 mapping is only reachable when `cfx_ptw_tlb_asid` equals the ASID the
+ * entry was filled with (spec/DADAO-12 §4.5, contract-tlb TLB-05/TLB-26).  The
+ * kernel runs as ASID 0 with G = 1 mappings, so a user address space gets an
+ * ASID from 1 upwards; 0 is never handed out.
+ *
+ * Allocation is a monotonic counter with wraparound — the simplest scheme that
+ * gives distinct address spaces distinct ASIDs for as long as the 16-bit space
+ * lasts.  Exhaustion is not a failure here: a single hart (contract-tlb TLB-38)
+ * can simply drop every entry before ASID 1 is reused, which is exactly what
+ * the wrap path does.  A bitmap/free-list would only postpone that, at the cost
+ * of state that has to be kept right across mm lifetimes.
+ *
+ * `destroy_context()` is the "return" side: the hardware has no per-mm state to
+ * free (the ASID register belongs to the hart), so the mm's ASID is dropped and
+ * the monotonic counter is left alone.
+ */
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+
+#include <asm/mmu_context.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/tlbflush.h>
+
+/* The next ASID to hand out; 0 keeps the kernel's identity out of circulation. */
+static unsigned long dadao_asid_next = DADAO_ASID_KERNEL + 1;
+
+unsigned long dadao_asid_alloc(void)
+{
+	unsigned long asid = dadao_asid_next;
+
+	if (asid == DADAO_ASID_KERNEL || asid > DADAO_ASID_MASK)
+		asid = DADAO_ASID_KERNEL + 1;
+
+	dadao_asid_next = asid + 1;
+	if (dadao_asid_next > DADAO_ASID_MASK) {
+		/*
+		 * The ASID space is exhausted: the next allocation reuses ASID
+		 * 1, whose stale TLB entries would otherwise alias the new
+		 * address space.  One hart, no shootdown (TLB-38): dropping all
+		 * entries is enough and is what the wrap costs.
+		 */
+		dadao_tlb_invalidate_all();
+		dadao_asid_next = DADAO_ASID_KERNEL + 1;
+	}
+
+	return asid;
+}
+
+int init_new_context(struct task_struct *tsk, struct mm_struct *mm)
+{
+	mm->context.asid = dadao_asid_alloc();
+	return 0;
+}
+
+void destroy_context(struct mm_struct *mm)
+{
+	/*
+	 * Nothing to free on the hardware side; drop the software identity and
+	 * leave the counter alone (the ASID may still be referenced by a
+	 * finished-but-not-yet-reaped context, and reusing the number early is
+	 * what the monotonic scheme avoids).
+	 */
+	mm->context.asid = DADAO_ASID_KERNEL;
+}
+
+/* -------------------------------------------------------------------------
+ * switch_mm(): the four-step address-space switch (contract-tlb TLB-30)
+ * ------------------------------------------------------------------------- */
+
+/*
+ * spec/DADAO-12 §2.2.5 "进程上下文切换" and contract-tlb TLB-30 give the four
+ * steps; TLB-29 says why they cannot be shortened: writing the ASID, writing
+ * the PTBR and enabling the walker all leave the TLB untouched, so only the
+ * explicit command makes the new address space visible.
+ *
+ * Which entries the invalidation has to reach: the new address space's `G = 0`
+ * ones, selected by writing its ASID and issuing `invalid|all` with
+ * `ASID_ANY = 0` (contract-tlb TLB-19/-23/-26).  `ASID_ANY = 1` would also drop
+ * the kernel's `G = 1` mappings, which every address space shares and which no
+ * switch can invalidate, and it would make the kernel re-walk its own text and
+ * data after every task switch.
+ *
+ * A kernel thread (`next == NULL`) keeps the running user ASID: all of its
+ * accesses are `G = 1`, which match under any ASID (TLB-26), so switching the
+ * ASID would buy nothing and cost a re-walk.
+ *
+ * The scratch registers of `cfx_ptw` (cg6) are bracketed by the sequence (step
+ * ④).  Nothing in steps ①–③ uses them — the entry stubs borrow cg6 of the cfx
+ * whose vector they entered, not of the walker — but the step is explicitly
+ * part of the contract, and it is what keeps the sequence composable with a
+ * future step that does use them.
+ */
+void dadao_switch_mm(struct mm_struct *prev, struct mm_struct *next,
+		     struct task_struct *tsk)
+{
+	unsigned long asid;
+	unsigned long scratch0, scratch1;
+
+	(void)prev;
+	(void)tsk;
+
+	if (!next)
+		return;
+
+	scratch0 = DADAO_CFX_READ(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH0);
+	scratch1 = DADAO_CFX_READ(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH1);
+
+	/* ① new ASID + new PTBR (either alone would not be visible: TLB-29). */
+	asid = next->context.asid;
+	dadao_asid_write(asid);
+	dadao_ptbr_write(__pa(next->pgd));
+
+	/* ② explicit invalidation of the new space's G = 0 entries. */
+	__dadao_tlb_flush(DADAO_TLB_INVALID, DADAO_TLB_SCOPE_ALL, 0, 0, asid,
+			  false);
+
+	/* ③ the walker is on (it is also what makes ①..② reachable at all). */
+	if (!dadao_ptw_enabled())
+		DADAO_CFX_WRITE(cfx_ptw, PTW_CG_ENABLE, PTW_RC_ENABLE,
+				DADAO_PTW_ENABLE_ON);
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	{
+		static int n;
+
+		if (n++ < 10)
+			dadao_early_printf("K4 mm switch: mm=%#lx asid=%lu "
+					   "pgd=%#lx pa=%#lx read_back asid=%lu "
+					   "ptbr=%#lx\n", (unsigned long)next,
+					   asid, (unsigned long)next->pgd,
+					   __pa(next->pgd), dadao_asid_read(),
+					   dadao_ptbr_read());
+	}
+#endif
+
+	/* ④ restore the walker's staging registers. */
+	DADAO_CFX_WRITE(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH0, scratch0);
+	DADAO_CFX_WRITE(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH1, scratch1);
+}
+
+/* -------------------------------------------------------------------------
+ * The arch half of dup_mm(): the COW hook
+ * ------------------------------------------------------------------------- */
+
+/*
+ * The arch half of dup_mm() (K4, m14-linux-018: the COW hook).
+ *
+ * A fork's address space is *shared*, not copied: both processes keep pointing
+ * at the same physical pages and both PTEs are made read-only, so the first
+ * write on either side is what makes a private copy (mm/cow.c's
+ * `dadao_do_wp_page()`).  Two things have to happen for that, and only one of
+ * them is generic:
+ *
+ *  - **the sharing**, per present PTE of a private writable VMA
+ *    (`is_cow_mapping()`): install the parent's PTE in the child with W clear,
+ *    clear W in the parent's, and take the reference the second mapping owns.
+ *    Generic `copy_page_range()` does exactly that *when* `vma_needs_copy()`
+ *    lets it run — and it does not for this port's pages: that test asks for an
+ *    `anon_vma` (a page table "which naturally cannot be reconstituted on page
+ *    fault"), and the fault channel's pages are not anonymous-folio pages with
+ *    an anon_vma behind them — they are ordinary pages the channel mapped
+ *    itself (mm/fault.c), with nothing to reconstitute them from.  A VMA that
+ *    says `VM_MIXEDMAP`/`VM_PFNMAP` takes the other arm and *is* copied by the
+ *    generic code, so the walk below finds the child's PTE already present and
+ *    leaves it alone (no second reference, no second write-protect).
+ *
+ *  - **the invalidation** (nobody else can do it): the parent's PTE was
+ *    rewritten while its address space is the one the walker is using, and a
+ *    TLB hit is not re-walked (contract-tlb TLB-07/-11) — without a flush the
+ *    parent would keep writing through its stale writable entry and silently
+ *    modify the child's page.  `local_flush_tlb_mm()` issues `invalid | all`
+ *    for this mm's ASID with `ASID_ANY = 0`, which drops exactly the G = 0
+ *    entries the rewrite affects and leaves the kernel's G = 1 mappings alone
+ *    (contract-tlb TLB-19/-25).  The child has never run, so it has no entries
+ *    of its own to drop.
+ *
+ * The shared zero page stays *shared*: every anonymous mapping points at it,
+ * it is read-only by construction, and no reference is taken for it (generic
+ * `copy_present_pte()` does not take one either: it is a special mapping, not a
+ * page the address spaces own).
+ */
+static int dadao_dup_one_pte(struct vm_area_struct *src,
+			     struct vm_area_struct *dst, unsigned long addr)
+{
+	struct mm_struct *src_mm = src->vm_mm;
+	pmd_t *src_pmd = pmd_off(src_mm, addr);
+	pmd_t *dst_pmd = pmd_off(dst->vm_mm, addr);
+	pte_t entry, child;
+	pte_t *src_pte, *dst_pte;
+
+	if (pmd_none(*src_pmd) || (pmd_val(*src_pmd) & _PAGE_SUPER))
+		return 0;
+	src_pte = pte_offset_kernel(src_pmd, addr);
+	entry = ptep_get(src_pte);
+	if (!pte_present(entry))
+		return 0;
+
+	if (pmd_none(*dst_pmd)) {
+		pte_t *tbl = (pte_t *)__get_free_page(GFP_KERNEL | __GFP_ZERO);
+
+		if (!tbl)
+			return -ENOMEM;
+		pmd_populate_kernel(dst->vm_mm, dst_pmd, tbl);
+	}
+	dst_pte = pte_offset_kernel(dst_pmd, addr);
+	if (pte_present(ptep_get(dst_pte))) {
+		/*
+		 * The generic path shared this one already (a VM_MIXEDMAP VMA):
+		 * its write-protect and its reference are in place.
+		 */
+		dadao_cow_dup_pages++;
+		if (pte_write(ptep_get(dst_pte)))
+			dadao_cow_dup_writable++;
+		return 0;
+	}
+
+	child = pte_wrprotect(entry);
+	if (!is_zero_pfn(pte_pfn(entry))) {
+		/*
+		 * The second mapping owns a reference: without it the last
+		 * unmap on either side would free a page the other still maps.
+		 */
+		get_page(pte_page(entry));
+		/* The parent's side becomes read-only too: its stale writable
+		 * translation is dropped by the flush below. */
+		ptep_set_wrprotect(src_mm, addr, src_pte);
+	}
+	set_pte(dst_pte, child);
+	dadao_cow_dup_pages++;
+	if (pte_write(child))
+		dadao_cow_dup_writable++;
+	return 0;
+}
+
+int dadao_dup_mmap_cow(struct mm_struct *oldmm, struct mm_struct *mm)
+{
+	struct vm_area_struct *dst;
+	VMA_ITERATOR(vmi, mm, 0);
+	unsigned long addr;
+	int ret = 0;
+
+	if (!mm || !oldmm)
+		return -EINVAL;
+
+	/*
+	 * The child's VMA tree is a copy of the parent's (dup_mmap() built it
+	 * with the same edges and the same order), so the parent's VMA for each
+	 * child VMA is the one covering its start address.
+	 */
+	for_each_vma(vmi, dst) {
+		struct vm_area_struct *src;
+
+		if (!is_cow_mapping(dst->vm_flags))
+			continue;
+		/*
+		 * `VM_PFNMAP` PTEs are raw device/IO physical addresses with no
+		 * `struct page` behind them (`vm_normal_page()` answers NULL for
+		 * them, and generic `copy_present_pte()` takes no reference):
+		 * sharing them would mean calling `get_page()` on a pfn that
+		 * names no page, so they are left to the generic path, which
+		 * copies the entries without accounting.
+		 */
+		if (dst->vm_flags & VM_PFNMAP)
+			continue;
+		src = find_vma(oldmm, dst->vm_start);
+		if (!src || src->vm_start != dst->vm_start ||
+		    src->vm_end != dst->vm_end)
+			continue;
+		for (addr = dst->vm_start; addr < dst->vm_end; addr += PAGE_SIZE) {
+			ret = dadao_dup_one_pte(src, dst, addr);
+			if (ret)
+				return ret;
+		}
+	}
+
+	/*
+	 * Drop the forking hart's stale translations for this address space: the
+	 * parent's PTEs were just write-protected while its table is the one the
+	 * walker uses (contract-tlb TLB-07/-11, TLB-19).
+	 */
+	if (dadao_cow_dup_pages)
+		local_flush_tlb_mm(oldmm);
+
+	return dadao_cow_dup_writable ? -EBUSY : 0;
+}
