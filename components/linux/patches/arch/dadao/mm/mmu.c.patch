diff --git a/arch/dadao/mm/mmu.c b/arch/dadao/mm/mmu.c
new file mode 100644
index 000000000..4101c4730
--- /dev/null
+++ b/arch/dadao/mm/mmu.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO MMU context (K3, m14-linux-011): ASID allocation.
+ *
+ * A G = 0 mapping is only reachable when `cfx_ptw_tlb_asid` equals the ASID the
+ * entry was filled with (spec/DADAO-12 §4.5, contract-tlb TLB-05/TLB-26).  The
+ * kernel runs as ASID 0 with G = 1 mappings, so a user address space gets an
+ * ASID from 1 upwards; 0 is never handed out.
+ *
+ * Allocation is a monotonic counter with wraparound — the simplest scheme that
+ * gives distinct address spaces distinct ASIDs for as long as the 16-bit space
+ * lasts.  Exhaustion is not a failure here: a single hart (contract-tlb TLB-38)
+ * can simply drop every entry before ASID 1 is reused, which is exactly what
+ * the wrap path does.  A bitmap/free-list would only postpone that, at the cost
+ * of state that has to be kept right across mm lifetimes.
+ *
+ * `destroy_context()` is the "return" side: the hardware has no per-mm state to
+ * free (the ASID register belongs to the hart), so the mm's ASID is dropped and
+ * the monotonic counter is left alone.
+ */
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+
+#include <asm/mmu_context.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/tlbflush.h>
+
+/* The next ASID to hand out; 0 keeps the kernel's identity out of circulation. */
+static unsigned long dadao_asid_next = DADAO_ASID_KERNEL + 1;
+
+unsigned long dadao_asid_alloc(void)
+{
+	unsigned long asid = dadao_asid_next;
+
+	if (asid == DADAO_ASID_KERNEL || asid > DADAO_ASID_MASK)
+		asid = DADAO_ASID_KERNEL + 1;
+
+	dadao_asid_next = asid + 1;
+	if (dadao_asid_next > DADAO_ASID_MASK) {
+		/*
+		 * The ASID space is exhausted: the next allocation reuses ASID
+		 * 1, whose stale TLB entries would otherwise alias the new
+		 * address space.  One hart, no shootdown (TLB-38): dropping all
+		 * entries is enough and is what the wrap costs.
+		 */
+		dadao_tlb_invalidate_all();
+		dadao_asid_next = DADAO_ASID_KERNEL + 1;
+	}
+
+	return asid;
+}
+
+int init_new_context(struct task_struct *tsk, struct mm_struct *mm)
+{
+	mm->context.asid = dadao_asid_alloc();
+	return 0;
+}
+
+void destroy_context(struct mm_struct *mm)
+{
+	/*
+	 * Nothing to free on the hardware side; drop the software identity and
+	 * leave the counter alone (the ASID may still be referenced by a
+	 * finished-but-not-yet-reaped context, and reusing the number early is
+	 * what the monotonic scheme avoids).
+	 */
+	mm->context.asid = DADAO_ASID_KERNEL;
+}
+
+/* -------------------------------------------------------------------------
+ * switch_mm(): the four-step address-space switch (contract-tlb TLB-30)
+ * ------------------------------------------------------------------------- */
+
+/*
+ * spec/DADAO-12 §2.2.5 "进程上下文切换" and contract-tlb TLB-30 give the four
+ * steps; TLB-29 says why they cannot be shortened: writing the ASID, writing
+ * the PTBR and enabling the walker all leave the TLB untouched, so only the
+ * explicit command makes the new address space visible.
+ *
+ * Which entries the invalidation has to reach: the new address space's `G = 0`
+ * ones, selected by writing its ASID and issuing `invalid|all` with
+ * `ASID_ANY = 0` (contract-tlb TLB-19/-23/-26).  `ASID_ANY = 1` would also drop
+ * the kernel's `G = 1` mappings, which every address space shares and which no
+ * switch can invalidate, and it would make the kernel re-walk its own text and
+ * data after every task switch.
+ *
+ * A kernel thread (`next == NULL`) keeps the running user ASID: all of its
+ * accesses are `G = 1`, which match under any ASID (TLB-26), so switching the
+ * ASID would buy nothing and cost a re-walk.
+ *
+ * The scratch registers of `cfx_ptw` (cg6) are bracketed by the sequence (step
+ * ④).  Nothing in steps ①–③ uses them — the entry stubs borrow cg6 of the cfx
+ * whose vector they entered, not of the walker — but the step is explicitly
+ * part of the contract, and it is what keeps the sequence composable with a
+ * future step that does use them.
+ */
+void dadao_switch_mm(struct mm_struct *prev, struct mm_struct *next,
+		     struct task_struct *tsk)
+{
+	unsigned long asid;
+	unsigned long scratch0, scratch1;
+
+	(void)prev;
+	(void)tsk;
+
+	if (!next)
+		return;
+
+	scratch0 = DADAO_CFX_READ(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH0);
+	scratch1 = DADAO_CFX_READ(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH1);
+
+	/* ① new ASID + new PTBR (either alone would not be visible: TLB-29). */
+	asid = next->context.asid;
+	dadao_asid_write(asid);
+	dadao_ptbr_write(__pa(next->pgd));
+
+	/* ② explicit invalidation of the new space's G = 0 entries. */
+	__dadao_tlb_flush(DADAO_TLB_INVALID, DADAO_TLB_SCOPE_ALL, 0, 0, asid,
+			  false);
+
+	/* ③ the walker is on (it is also what makes ①..② reachable at all). */
+	if (!dadao_ptw_enabled())
+		DADAO_CFX_WRITE(cfx_ptw, PTW_CG_ENABLE, PTW_RC_ENABLE,
+				DADAO_PTW_ENABLE_ON);
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	{
+		static int n;
+
+		if (n++ < 10)
+			dadao_early_printf("K4 mm switch: mm=%#lx asid=%lu "
+					   "pgd=%#lx pa=%#lx read_back asid=%lu "
+					   "ptbr=%#lx\n", (unsigned long)next,
+					   asid, (unsigned long)next->pgd,
+					   __pa(next->pgd), dadao_asid_read(),
+					   dadao_ptbr_read());
+	}
+#endif
+
+	/* ④ restore the walker's staging registers. */
+	DADAO_CFX_WRITE(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH0, scratch0);
+	DADAO_CFX_WRITE(cfx_ptw, PTW_CG_SCRATCH, PTW_RC_SCRATCH1, scratch1);
+}
+
+/* -------------------------------------------------------------------------
+ * A/D write-back (m14-linux-035)
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Write the walker's *pending* A/D bits for @addr back into its PTE, keeping
+ * the translation (spec/DADAO-12 §2.2.5, contract-tlb TLB-17: `clean` writes
+ * back and keeps the entry).
+ *
+ * Why it is needed at all: A/D live in the TLB entry, not in the PTE, so the
+ * PTE only learns "this page was read/written" when something CLEANs, FLUSHes or
+ * replaces the entry (TLB-12).  Generic `mm/` reads the PTE immediately before
+ * clearing it to decide whether the page was dirty (`try_to_unmap_one()`) or
+ * referenced (`folio_referenced_one()`); issuing the CLEAN *before* that read is
+ * what makes those decisions see the truth (asm/pgtable.h's
+ * `ptep_get_and_clear()`/`ptep_test_and_clear_young()`).
+ *
+ * `invalid` must NOT be used for this: it drops the pending bits (TLB-17), and
+ * it is the right command for `flush_tlb_*()` precisely because those run after
+ * software has written a *new* PTE — writing A/D back over it would resurrect
+ * bits in an entry that was just repurposed.
+ *
+ * A kernel address (or no mm) is mapped `G = 1` in every address space, so it
+ * is CLEANed with ASID_ANY (contract-tlb TLB-25/-26).
+ */
+void dadao_tlb_clean_addr(struct mm_struct *mm, unsigned long addr)
+{
+	if (dadao_addr_is_kernel(addr) || !mm)
+		__dadao_tlb_flush(DADAO_TLB_CLEAN, DADAO_TLB_SCOPE_VA, addr, 0,
+				  0, true);
+	else
+		__dadao_tlb_flush(DADAO_TLB_CLEAN, DADAO_TLB_SCOPE_VA, addr, 0,
+				  mm->context.asid, false);
+}
+
+/*
+ * Clear the access bit, but only after the walker's pending A/D bits have been
+ * written back: `folio_referenced_one()` reads this answer to decide whether a
+ * page was used, and an `invalid`-style clear would throw the "yes" away
+ * (spec/DADAO-12 §2.2.5; contract-tlb TLB-17).  The caller
+ * (`ptep_clear_flush_young()`) invalidates the entry when the answer was "yes".
+ */
+int dadao_ptep_test_and_clear_young(struct vm_area_struct *vma,
+				    unsigned long addr, pte_t *ptep)
+{
+	pte_t pte;
+
+	dadao_tlb_clean_addr(vma->vm_mm, addr);
+	pte = *ptep;
+	if (!pte_young(pte))
+		return 0;
+	*ptep = pte_mkold(pte);
+	return 1;
+}
