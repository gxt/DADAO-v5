diff --git a/arch/dadao/mm/k3_pf_selftest.c b/arch/dadao/mm/k3_pf_selftest.c
new file mode 100644
index 000000000..c7f5f8b59
--- /dev/null
+++ b/arch/dadao/mm/k3_pf_selftest.c
@@ -0,0 +1,897 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * K3 page-fault channel self-test (CONFIG_DADAO_K3_PF_SELFTEST).
+ *
+ * K3 has no user mode, so the only way to exercise demand paging is from the
+ * kernel itself: build an address window, touch an address in it, and let the
+ * *hardware* raise CFXMEM/CFXPERM through the real supv entry, which dispatches
+ * into dadao_do_page_fault() (mm/fault.c).  This file is that client; it is
+ * compiled only into a probe image and ends the boot from the end of
+ * setup_arch(), where memblock has the RAM window and paging_init() has adopted
+ * the kernel table.
+ *
+ * One case per image (`CONFIG_DADAO_K3_PF_SELFTEST` = the case number) because
+ * the terminating verdicts really end the boot — the gate boots one image per
+ * verdict instead of faking a recovery:
+ *
+ *   1  the recoverable cases: demand fill, the shared zero page (read maps it,
+ *      write replaces it, the page itself stays untouched), every missing
+ *      sub-reason including the fetch side, a code window that only becomes
+ *      executable after the handler installs its page, the sub-reason shape
+ *      check and the window-edge lookups.  Ends with SYS_EXIT(0).
+ *   2  a read of an R = 0 page: CFXPERM + NRPERM, named termination.
+ *   3  a wild jump outside every window: CFXMEM + IGPTRAP, named termination.
+ *   4  a data access one page outside a window edge: named termination.
+ *   5  a synthetic ADWBFAIL dispatch: no fill, no retry, PTE address printed,
+ *      named termination.
+ *
+ * The windows live in the first 512 MiB-aligned slots past RAM: those L1
+ * entries are empty (K1 maps exactly the RAM superpages), so a fault there is a
+ * genuine walk result and not a leftover mapping.
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/pgtable.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/cause-sub.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+#include <asm/pgtable.h>
+#include <asm/ptrace.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/tlbflush.h>
+#include <asm/trap.h>
+
+/* Guest FAIL segment (spec/Kaiwu §7.1): setup.c carries 0x04-0x08, k1_pt.c
+ * 0x09-0x0c, trap.S 0x0d, traps.c 0x0e-0x0f, k3_pt_selftest.c 0x10-0x1e; this
+ * file continues at 0x1f.  Values stay <= 0x7f because the semihosting SYS_EXIT
+ * subcode is the host exit status. */
+#define K3_PF_FAIL_POOL		0x1f	/* no pages / the test VA is unusable */
+#define K3_PF_FAIL_WINDOW	0x20	/* window registration refused */
+#define K3_PF_FAIL_P1		0x21	/* first read did not demand-fill */
+#define K3_PF_FAIL_P8		0x22	/* the read mapping is not the zero page */
+#define K3_PF_FAIL_P10		0x23	/* the zero page was written / shared */
+#define K3_PF_FAIL_P9		0x24	/* the write did not replace the zero page */
+#define K3_PF_FAIL_P2		0x25	/* a second access re-entered the handler */
+#define K3_PF_FAIL_P3		0x26	/* a missing branch did not fill */
+#define K3_PF_FAIL_P4A		0x27	/* the code page did not execute */
+#define K3_PF_FAIL_LAYOUT	0x28	/* the sub-reason shape check disagrees */
+#define K3_PF_FAIL_VMA		0x29	/* window edge lookup disagrees */
+#define K3_PF_FAIL_CODE		0x2a	/* the stub crosses its page */
+#define K3_PF_FAIL_P6		0x2b	/* the ADWBFAIL dispatch returned */
+#define K3_PF_FAIL_EXIT		0x2c	/* the exit-code segmentation masks */
+#define K3_PF_FAIL_DISPATCH	0x2d	/* a malformed id was not refused by
+					 * the dispatcher */
+
+/* Written by the stub page the code-window cases execute (observable side
+ * effect: the magic is there *only* if the retried instruction really ran). */
+#define K3_PF_MAGIC		0x4b33504600000001UL
+
+/* Pages of one superpage the data/code scratch pages live on: 128 MiB into the
+ * superpage, well past the kernel image (< 64 MiB) and well below the channel's
+ * page pool (top of RAM). */
+#define K3_PF_SUPER_DATA_OFF	0x08000000UL
+#define K3_PF_SUPER_CODE_OFF	0x08010000UL
+
+/* Ten 512 MiB slots past RAM: one window family each (see the case list). */
+#define K3_PF_SLOTS		10
+
+extern char _end[];
+
+static unsigned long k3_pf_base;	/* slot 0 */
+static unsigned long k3_pf_data_pa;	/* page the superpage data cases read */
+static unsigned long k3_pf_code_pa;	/* the channel's own code page (pool) */
+static unsigned long k3_pf_code_off;	/* the stub's offset inside its page */
+static unsigned long k3_pf_magic;	/* the stub's store target */
+static unsigned long k3_pf_super_pa;	/* superpage base the super cases map */
+
+static struct vm_area_struct *k3_win_a;
+static struct vm_area_struct *k3_win_b;
+static struct vm_area_struct *k3_win_c;
+static struct vm_area_struct *k3_win_d;
+static struct vm_area_struct *k3_win_e;
+static struct vm_area_struct *k3_win_f;
+static struct vm_area_struct *k3_win_g;
+static struct vm_area_struct *k3_win_h;
+static struct vm_area_struct *k3_win_i;
+static struct vm_area_struct *k3_win_j;
+static struct vm_area_struct *k3_win_k;
+static struct vm_area_struct *k3_win_l;
+
+static void __noreturn k3_pf_fail_case(unsigned int code, const char *what,
+				       unsigned long value)
+{
+	dadao_early_printf("K3 pf FAIL: %s=%#lx code=%#x\n", what, value, code);
+	dadao_early_exit(code);
+}
+
+static void k3_pf_expect(const char *what, unsigned long expected,
+			 unsigned long actual, unsigned int code)
+{
+	if (expected != actual) {
+		dadao_early_printf("K3 pf FAIL: %s expected=%#lx actual=%#lx "
+				   "code=%#x\n", what, expected, actual, code);
+		dadao_early_exit(code);
+	}
+}
+
+static unsigned long k3_pf_ld(unsigned long va)
+{
+	return *(volatile unsigned long *)va;
+}
+
+static void k3_pf_st(unsigned long va, unsigned long value)
+{
+	*(volatile unsigned long *)va = value;
+	barrier();
+}
+
+/* -------------------------------------------------------------------------
+ * The code page: a stub with no reference outside its own page
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Store @value at @dst and return through the RAS.  The test copies the page
+ * holding this function to a different PA and calls it at a different VA, so the
+ * body must not name anything outside its own page (no literal pool, no call):
+ * the argument registers carry everything it needs.
+ */
+static noinline void k3_pf_stub(unsigned long value, unsigned long *dst)
+{
+	*(volatile unsigned long *)dst = value;
+}
+
+static void __init k3_pf_code_page(void)
+{
+	unsigned long va = (unsigned long)k3_pf_stub;
+	unsigned long off = va & (PAGE_SIZE - 1);
+
+	/* A stub that crossed its page boundary would run into a page this test
+	 * never maps, i.e. it would fail for a reason that is not under test. */
+	if (off > PAGE_SIZE - 128)
+		k3_pf_fail_case(K3_PF_FAIL_CODE, "stub_offset", off);
+
+	k3_pf_code_pa = dadao_pf_alloc_page();
+	if (!k3_pf_code_pa)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "code_page", 0);
+	memcpy(__va(k3_pf_code_pa), (void *)(va & PAGE_MASK), PAGE_SIZE);
+	k3_pf_code_off = off;
+
+	/* The superpage cases get their physical pages from the superpage base,
+	 * so the stub copy has to sit at the PA the VA offset selects. */
+	memcpy(__va(k3_pf_super_pa + K3_PF_SUPER_CODE_OFF),
+	       (void *)(va & PAGE_MASK), PAGE_SIZE);
+}
+
+/* -------------------------------------------------------------------------
+ * Page tables the probe builds by hand (the states the walker must report)
+ * ------------------------------------------------------------------------- */
+
+static pte_t *k3_pf_walk(unsigned long va)
+{
+	return pte_offset_kernel(pmd_off_k(va), va);
+}
+
+/* Install a fresh, zeroed L2 table for @va (P = 1, SP = 0) and return its slot
+ * for @va.  The page is zeroed, so every PTE in it starts out absent. */
+static pte_t *k3_pf_table(unsigned long va)
+{
+	pmd_t *pmd = pmd_off_k(va);
+	unsigned long pa = dadao_pf_alloc_page();
+
+	if (!pa)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "l2_table", va);
+	pmd_populate_kernel(&init_mm, pmd, (pte_t *)__va(pa));
+	local_flush_tlb_all();
+	return pte_offset_kernel(pmd, va);
+}
+
+/* Kernel-window leaf with an explicit fragment mask and no A/D (the walker
+ * maintains those; keeping them 0 keeps the state readable). */
+static unsigned long k3_pf_leaf(unsigned long pa, unsigned long prot,
+				unsigned long frags)
+{
+	return (pa & _PAGE_PFN_MASK) | prot | (frags << _PAGE_FRAG_SHIFT);
+}
+
+#define K3_PF_DATA_PROT	(_PAGE_PRESENT | _PAGE_S | _PAGE_GLOBAL | _PAGE_READ)
+#define K3_PF_RWX_PROT	(K3_PF_DATA_PROT | _PAGE_WRITE | _PAGE_EXEC)
+
+/* -------------------------------------------------------------------------
+ * Setup: pages, windows, the pre-built table states
+ * ------------------------------------------------------------------------- */
+
+static unsigned long k3_pf_slot(unsigned int n)
+{
+	return k3_pf_base + (unsigned long)n * SUPERPAGE_SIZE;
+}
+
+static struct vm_area_struct *k3_pf_window(unsigned long start,
+					   unsigned long end,
+					   unsigned long flags,
+					   unsigned long backing_pa,
+					   unsigned long superpage_pa)
+{
+	struct vm_area_struct *vma = dadao_pf_window_add(start, end, flags,
+							 backing_pa,
+							 superpage_pa);
+
+	if (!vma)
+		k3_pf_fail_case(K3_PF_FAIL_WINDOW, "window", start);
+	return vma;
+}
+
+static void __init k3_pf_pages(void)
+{
+	unsigned long data_va;
+
+	dadao_pf_init();
+	if (!dadao_pf_zero_page_pa())
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "zero_page", 0);
+
+	/* The RAM window's first 512 MiB-aligned slot past RAM: L1 entry empty. */
+	k3_pf_base = PAGE_OFFSET + round_up(dadao_ram_size, SUPERPAGE_SIZE);
+	if (k3_pf_base + (unsigned long)K3_PF_SLOTS * SUPERPAGE_SIZE >=
+	    _AC(1, UL) << 42)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "test_base", k3_pf_base);
+	if (pgd_index(k3_pf_base) <
+	    pgd_index(PAGE_OFFSET) +
+	    DIV_ROUND_UP(dadao_ram_size, SUPERPAGE_SIZE))
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "test_base_inside_ram",
+				k3_pf_base);
+
+	k3_pf_super_pa = dadao_ram_base & SUPERPAGE_MASK;
+	if (k3_pf_super_pa + K3_PF_SUPER_CODE_OFF + PAGE_SIZE >
+	    dadao_ram_base + dadao_ram_size)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "super_scratch", k3_pf_super_pa);
+
+	k3_pf_code_page();
+
+	/* The page the superpage data cases read: content = the magic. */
+	k3_pf_data_pa = k3_pf_super_pa + K3_PF_SUPER_DATA_OFF;
+	k3_pf_st((unsigned long)__va(k3_pf_data_pa), K3_PF_MAGIC);
+	data_va = k3_pf_slot(4) + K3_PF_SUPER_DATA_OFF;
+
+	dadao_early_printf("K3 pf init zero_pa=%#lx pool=%lu ram=%#lx+%#lx "
+			   "base=%#lx super=%#lx code_pa=%#lx code_off=%#lx "
+			   "data_pa=%#lx data_va=%#lx\n",
+			   dadao_pf_zero_page_pa(), dadao_pf_alloc_count(),
+			   dadao_ram_base, dadao_ram_size, k3_pf_base,
+			   k3_pf_super_pa, k3_pf_code_pa, k3_pf_code_off,
+			   k3_pf_data_pa, data_va);
+}
+
+/* Windows and the table states of the recoverable image (case 1). */
+static void __init k3_pf_setup_recoverable(void)
+{
+	unsigned long slot;
+	pte_t *ptep;
+	unsigned long frag;
+	unsigned long page;
+
+	/* A and B share one L1 slot (two L2 indices): the first touch of A
+	 * installs the table, B's fault is then a second-level one. */
+	k3_win_a = k3_pf_window(k3_pf_slot(0), k3_pf_slot(0) + PAGE_SIZE,
+				VM_READ | VM_WRITE, 0, DADAO_PF_NO_SUPERPAGE);
+	k3_win_b = k3_pf_window(k3_pf_slot(0) + PAGE_SIZE,
+				k3_pf_slot(0) + 2 * PAGE_SIZE,
+				VM_READ | VM_WRITE, 0, DADAO_PF_NO_SUPERPAGE);
+	k3_win_l = k3_pf_window(k3_pf_slot(0) + 2 * PAGE_SIZE,
+				k3_pf_slot(0) + 3 * PAGE_SIZE,
+				VM_READ | VM_WRITE, 0, DADAO_PF_NO_SUPERPAGE);
+
+	/* C: L1 P = 0 (the walk stops at the first level). */
+	k3_win_c = k3_pf_window(k3_pf_slot(1), k3_pf_slot(1) + PAGE_SIZE,
+				VM_READ | VM_WRITE, 0, DADAO_PF_NO_SUPERPAGE);
+
+	/* D: L1 points at an all-zero L2 table (L2 P = 0). */
+	slot = k3_pf_slot(2);
+	k3_win_d = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+				DADAO_PF_NO_SUPERPAGE);
+	(void)k3_pf_table(slot);
+
+	/* E: the page is present but the VA's GPF fragment bit is 0. */
+	slot = k3_pf_slot(3);
+	k3_win_e = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+				DADAO_PF_NO_SUPERPAGE);
+	ptep = k3_pf_table(slot);
+	page = dadao_pf_alloc_page();
+	if (!page)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "gpf_page", slot);
+	k3_pf_st((unsigned long)__va(page), K3_PF_MAGIC);
+	frag = 0xffUL & ~(1UL << ((slot >> 13) & 0x7));
+	set_pte(ptep, __pte(k3_pf_leaf(page, K3_PF_RWX_PROT, frag)));
+	local_flush_tlb_all();
+
+	/* F: a superpage whose SPF lacks the VA's fragment (data side). */
+	slot = k3_pf_slot(4) + K3_PF_SUPER_DATA_OFF;
+	k3_win_f = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+				k3_pf_super_pa);
+	frag = 0xffUL & ~(1UL << ((slot >> 26) & 0x7));
+	set_pmd(pmd_off_k(slot),
+		__pmd(k3_pf_leaf(k3_pf_super_pa, K3_PF_RWX_PROT | _PAGE_SUPER,
+				 frag)));
+	local_flush_tlb_all();
+
+	/* G: a code window whose L1 entry is absent (fetch -> IGPTRAP). */
+	slot = k3_pf_slot(5) + k3_pf_code_off;
+	k3_win_g = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_EXEC,
+				k3_pf_code_pa, DADAO_PF_NO_SUPERPAGE);
+
+	/* H: the same, one level lower (L2 P = 0). */
+	slot = k3_pf_slot(6) + k3_pf_code_off;
+	k3_win_h = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_EXEC,
+				k3_pf_code_pa, DADAO_PF_NO_SUPERPAGE);
+	(void)k3_pf_table(k3_pf_slot(6));
+
+	/* I: a code window on a superpage with SPF missing its fragment
+	 * (fetch -> ISPFTRAP); its content is the stub copied at that PA. */
+	slot = k3_pf_slot(7) + K3_PF_SUPER_CODE_OFF + k3_pf_code_off;
+	k3_win_i = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_EXEC, 0,
+				k3_pf_super_pa);
+	frag = 0xffUL & ~(1UL << ((slot >> 26) & 0x7));
+	set_pmd(pmd_off_k(slot),
+		__pmd(k3_pf_leaf(k3_pf_super_pa, K3_PF_RWX_PROT | _PAGE_SUPER,
+				 frag)));
+	local_flush_tlb_all();
+
+	/* J: a code window on a missing superpage (L1 P = 0, SP = 1 -> ISPTRAP);
+	 * the handler maps the superpage the window names. */
+	slot = k3_pf_slot(8) + K3_PF_SUPER_CODE_OFF + k3_pf_code_off;
+	k3_win_j = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_EXEC, 0,
+				k3_pf_super_pa);
+	set_pmd(pmd_off_k(slot), __pmd(k3_pf_super_pa | _PAGE_SUPER));
+	local_flush_tlb_all();
+
+	/* K: the data-side spelling of J (DSPTRAP). */
+	slot = k3_pf_slot(9) + K3_PF_SUPER_DATA_OFF;
+	k3_win_k = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+				k3_pf_super_pa);
+	set_pmd(pmd_off_k(slot), __pmd(k3_pf_super_pa | _PAGE_SUPER));
+	local_flush_tlb_all();
+}
+
+/* -------------------------------------------------------------------------
+ * The cases of image 1
+ * ------------------------------------------------------------------------- */
+
+/*
+ * The exit code and the cause name must ignore the sub-reason wyde for *every*
+ * class, not only for the two that own one (m14-linux-011's F1 addendum): for
+ * CFXMEM the mask is a no-op on the index (`__ffs` takes the lowest bit, and
+ * CFXMEM's bit 1 *is* below the sub-reason), so only a class whose sub-reason
+ * sits above a *lower* big-class bit can show the mask at all.  CFXTRAP is bit
+ * 0 and cannot be raised with a sub-reason by this machine, so the id is
+ * synthetic — the point is the decoder, not the raise site.
+ */
+static void __init k3_pf_exit_codes(void)
+{
+	unsigned long bare = DADAO_CAUSE_CFXTRAP;
+	unsigned long dirty = DADAO_CAUSE_CFXTRAP | (1UL << DADAO_SUB_DGPTRAP);
+	const char *bare_name = dadao_cause_name(bare);
+	const char *dirty_name = dadao_cause_name(dirty);
+	unsigned long bare_code = dadao_exit_code(bare);
+	unsigned long dirty_code = dadao_exit_code(dirty);
+
+	dadao_early_printf("K3 pf exit bare_name=%s bare_code=%#lx "
+			   "dirty_name=%s dirty_code=%#lx id=%#lx ok=%d\n",
+			   bare_name ?: "unknown", bare_code,
+			   dirty_name ?: "unknown", dirty_code, dirty,
+			   bare_name && dirty_name && !strcmp(bare_name, dirty_name) &&
+			   bare_code == dirty_code);
+	k3_pf_expect("exit: the name of a dirty CFXTRAP", 1,
+		     (bare_name && dirty_name && !strcmp(bare_name, dirty_name)) ?
+		     1 : 0, K3_PF_FAIL_EXIT);
+	k3_pf_expect("exit: the code of a dirty CFXTRAP", bare_code, dirty_code,
+		     K3_PF_FAIL_EXIT);
+}
+
+/*
+ * The sub-reason shape check (asm/cause-sub.h) on synthetic ids, and the
+ * kernel's own consistency verdict on its table: the well-formed ids must be
+ * accepted and the malformed ones refused.  The gate re-derives the same
+ * verdicts from contract-see §6.1/§6.1.1 independently, so a table that only
+ * agrees with itself still cannot pass.
+ */
+static void __init k3_pf_layout(void)
+{
+	static const struct {
+		const char *name;
+		unsigned long id;
+		bool ok;
+	} ids[] = {
+		{ "mem_ok",	 DADAO_CAUSE_CFXMEM | (1UL << DADAO_SUB_DGPTRAP), true },
+		{ "mem_two",	 DADAO_CAUSE_CFXMEM | (1UL << DADAO_SUB_DGPTRAP) |
+				 (1UL << DADAO_SUB_IGPTRAP), false },
+		{ "mem_foreign", DADAO_CAUSE_CFXMEM | (1UL << DADAO_SUB_NRPERM), false },
+		{ "mem_reserved", DADAO_CAUSE_CFXMEM | (1UL << 58), false },
+		{ "perm_ok",	 DADAO_CAUSE_CFXPERM | (1UL << DADAO_SUB_NWPERM), true },
+		{ "perm_foreign", DADAO_CAUSE_CFXPERM | (1UL << DADAO_SUB_DGPTRAP), false },
+		{ "perm_reserved", DADAO_CAUSE_CFXPERM | (1UL << 40), false },
+		{ "other_clean", DADAO_CAUSE_CFXTRAP, true },
+		{ "other_dirty", DADAO_CAUSE_CFXTRAP | (1UL << DADAO_SUB_DGPTRAP), false },
+		{ "bits16",	 DADAO_CAUSE_CFXMEM | (1UL << 16), false },
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		int verdict = dadao_subcause_layout(ids[i].id);
+
+		dadao_early_printf("K3 pf layout %s=%d id=%#lx\n", ids[i].name,
+				   verdict, ids[i].id);
+		if ((verdict == DADAO_SUB_LAYOUT_OK) != ids[i].ok)
+			k3_pf_fail_case(K3_PF_FAIL_LAYOUT, ids[i].name,
+					ids[i].id);
+	}
+}
+
+/* Does the channel's own lookup cover @addr?  The same question the handler
+ * asks, answered without taking a fault. */
+static bool k3_pf_covered(unsigned long addr)
+{
+	return dadao_pf_find_vma(addr) != NULL;
+}
+
+/* The window edges: only [vm_start, vm_end) is covered (P7's first half). */
+static void __init k3_pf_vma_edges(struct vm_area_struct *vma)
+{
+	unsigned long start = vma->vm_start;
+	unsigned long end = vma->vm_end;
+
+	dadao_early_printf("K3 pf vma start=%#lx end=%#lx before1=%d "
+			   "before_page=%d inside=%d last=%d at_end=%d\n",
+			   start, end,
+			   k3_pf_covered(start - 1),
+			   k3_pf_covered(start - PAGE_SIZE),
+			   k3_pf_covered(start),
+			   k3_pf_covered(end - 1),
+			   k3_pf_covered(end));
+}
+
+static void __init k3_pf_p1_p8_p10_p9_p2(void)
+{
+	unsigned long entries;
+	unsigned long pool;
+	unsigned long za = dadao_pf_zero_page_pa();
+	unsigned long word;
+	pte_t *pa_ptep;
+	pte_t *pb_ptep;
+	unsigned long pte_a;
+	unsigned long pte_b;
+	unsigned long pa;
+	unsigned long dirty = 0;
+	unsigned int i;
+
+	entries = dadao_pf_entry_count();
+	pool = dadao_pf_alloc_count();
+
+	/* P1: the very first read of window A has to go through the channel and
+	 * come back with the zero the zero page holds. */
+	word = k3_pf_ld(k3_win_a->vm_start);
+	dadao_early_printf("K3 pfc P1 win=%#lx word=%#lx entries=%lu pool=%lu "
+			   "ok=%d\n", k3_win_a->vm_start, word,
+			   dadao_pf_entry_count(), dadao_pf_alloc_count(),
+			   word == 0 && dadao_pf_entry_count() == entries + 1);
+	k3_pf_expect("P1: first read", 0, word, K3_PF_FAIL_P1);
+	k3_pf_expect("P1: one channel entry", entries + 1,
+		     dadao_pf_entry_count(), K3_PF_FAIL_P1);
+
+	/* P8: the mapping the fill installed is the shared zero page, read-only
+	 * (contract-see §6.1.1: the missing classes do not say read or write,
+	 * so the fill maps the read-only zero page and lets a store fault). */
+	pa_ptep = k3_pf_walk(k3_win_a->vm_start);
+	pte_a = pte_val(*pa_ptep);
+	dadao_early_printf("K3 pfc P8 win=%#lx pte=%#lx pte_pa=%#lx zero_pa=%#lx "
+			   "w=%d r=%d x=%d ok=%d\n", k3_win_a->vm_start, pte_a,
+			   (pte_a & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+			   za, pte_write(*pa_ptep), !!(pte_a & _PAGE_READ),
+			   !!(pte_a & _PAGE_EXEC),
+			   (pte_a & _PAGE_PFN_MASK) == (za & _PAGE_PFN_MASK) &&
+			   !pte_write(*pa_ptep) && (pte_a & _PAGE_READ) &&
+			   !(pte_a & _PAGE_EXEC));
+	k3_pf_expect("P8: PTE points at the zero page",
+		     (za & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+		     (pte_a & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT, K3_PF_FAIL_P8);
+	k3_pf_expect("P8: W", 0, pte_write(*pa_ptep), K3_PF_FAIL_P8);
+
+	/* P10: a second window reads the *same* page, and the page is still all
+	 * zero — the fill never wrote it. */
+	word = k3_pf_ld(k3_win_b->vm_start);
+	pb_ptep = k3_pf_walk(k3_win_b->vm_start);
+	pte_b = pte_val(*pb_ptep);
+	for (i = 0; i < PAGE_SIZE / sizeof(unsigned long); i++)
+		dirty |= k3_pf_ld((unsigned long)__va(za) + i * sizeof(unsigned long));
+	dadao_early_printf("K3 pfc P10 win=%#lx pte_a=%#lx pte_b=%#lx "
+			   "zero_dirty=%#lx word_b=%#lx ok=%d\n",
+			   k3_win_b->vm_start, pte_a, pte_b, dirty, word,
+			   word == 0 && dirty == 0 &&
+			   (pte_a & _PAGE_PFN_MASK) == (pte_b & _PAGE_PFN_MASK) &&
+			   !pte_write(*pb_ptep));
+	k3_pf_expect("P10: second window reads 0", 0, word, K3_PF_FAIL_P10);
+	k3_pf_expect("P10: zero page untouched", 0, dirty, K3_PF_FAIL_P10);
+	k3_pf_expect("P10: both mappings are the zero page",
+		     (pte_a & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+		     (pte_b & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+		     K3_PF_FAIL_P10);
+
+	/* P9: a store to the zero-page mapping is a permission fault
+	 * (CFXPERM + NWPERM) that the channel answers with a private, zeroed
+	 * page — not with a copy of the zero page. */
+	pool = dadao_pf_alloc_count();
+	entries = dadao_pf_entry_count();
+	k3_pf_magic = 0;
+	k3_pf_st(k3_win_a->vm_start, K3_PF_MAGIC);
+	pa = pte_val(*pa_ptep) & _PAGE_PFN_MASK;
+	word = k3_pf_ld(k3_win_a->vm_start);
+	dadao_early_printf("K3 pfc P9 win=%#lx pte=%#lx pte_pa=%#lx zero_pa=%#lx "
+			   "w=%d word=%#lx allocs=%lu allocs_before=%lu "
+			   "entries=%lu entries_before=%lu ok=%d\n",
+			   k3_win_a->vm_start, pte_val(*pa_ptep),
+			   pa >> _PAGE_PFN_SHIFT, za, pte_write(*pa_ptep),
+			   word, dadao_pf_alloc_count(), pool,
+			   dadao_pf_entry_count(), entries,
+			   word == K3_PF_MAGIC && pa != (za & _PAGE_PFN_MASK) &&
+			   pte_write(*pa_ptep) &&
+			   dadao_pf_alloc_count() == pool + 1 &&
+			   dadao_pf_entry_count() == entries + 1);
+	k3_pf_expect("P9: the write landed", K3_PF_MAGIC, word, K3_PF_FAIL_P9);
+	k3_pf_expect("P9: private page, not the zero page",
+		     (za & _PAGE_PFN_MASK) == pa ? 0 : 1, 1, K3_PF_FAIL_P9);
+	k3_pf_expect("P9: W", 1, pte_write(*pa_ptep), K3_PF_FAIL_P9);
+	k3_pf_expect("P9: one page allocated", pool + 1,
+		     dadao_pf_alloc_count(), K3_PF_FAIL_P9);
+
+	/* The other window keeps its read-only zero-page mapping, and the page
+	 * itself is still zero: replacing A's mapping did not touch it. */
+	k3_pf_expect("P10: the other window still reads 0", 0,
+		     k3_pf_ld(k3_win_b->vm_start), K3_PF_FAIL_P10);
+	k3_pf_expect("P10: the other mapping is still read-only", 0,
+		     pte_write(*pb_ptep), K3_PF_FAIL_P10);
+
+	/* P2: a second access to the now-private page must not enter the
+	 * channel at all, and read/write agree. */
+	entries = dadao_pf_entry_count();
+	word = k3_pf_ld(k3_win_a->vm_start);
+	k3_pf_st(k3_win_a->vm_start, K3_PF_MAGIC + 1);
+	dadao_early_printf("K3 pfc P2 win=%#lx word=%#lx word2=%#lx "
+			   "entries=%lu entries_before=%lu ok=%d\n",
+			   k3_win_a->vm_start, word,
+			   k3_pf_ld(k3_win_a->vm_start),
+			   dadao_pf_entry_count(), entries,
+			   dadao_pf_entry_count() == entries &&
+			   word == K3_PF_MAGIC &&
+			   k3_pf_ld(k3_win_a->vm_start) == K3_PF_MAGIC + 1);
+	k3_pf_expect("P2: no channel entry", entries,
+		     dadao_pf_entry_count(), K3_PF_FAIL_P2);
+	k3_pf_expect("P2: write/read agree", K3_PF_MAGIC + 1,
+		     k3_pf_ld(k3_win_a->vm_start), K3_PF_FAIL_P2);
+
+	/*
+	 * P9b: a store to a window that was never read still ends in a private
+	 * page.  The missing classes cannot say "this is a store" (contract-see
+	 * §6.1.1), so the fill maps the read-only zero page first and the NWPERM
+	 * that the store then raises is what turns it private: two channel
+	 * entries, one page, and the zero page itself untouched.
+	 */
+	pool = dadao_pf_alloc_count();
+	entries = dadao_pf_entry_count();
+	dirty = 0;
+	k3_pf_st(k3_win_l->vm_start, K3_PF_MAGIC + 2);
+	pa_ptep = k3_pf_walk(k3_win_l->vm_start);
+	pa = pte_val(*pa_ptep) & _PAGE_PFN_MASK;
+	for (i = 0; i < PAGE_SIZE / sizeof(unsigned long); i++)
+		dirty |= k3_pf_ld((unsigned long)__va(za) + i * sizeof(unsigned long));
+	dadao_early_printf("K3 pfc P9b win=%#lx pte_pa=%#lx zero_pa=%#lx w=%d "
+			   "word=%#lx zero_dirty=%#lx allocs_delta=%lu "
+			   "entries_delta=%lu ok=%d\n",
+			   k3_win_l->vm_start, pa >> _PAGE_PFN_SHIFT, za,
+			   pte_write(*pa_ptep),
+			   k3_pf_ld(k3_win_l->vm_start), dirty,
+			   dadao_pf_alloc_count() - pool,
+			   dadao_pf_entry_count() - entries,
+			   k3_pf_ld(k3_win_l->vm_start) == K3_PF_MAGIC + 2 &&
+			   pa != (za & _PAGE_PFN_MASK) && pte_write(*pa_ptep) &&
+			   dirty == 0 &&
+			   dadao_pf_alloc_count() == pool + 1 &&
+			   dadao_pf_entry_count() == entries + 2);
+	k3_pf_expect("P9b: the cold store landed", K3_PF_MAGIC + 2,
+		     k3_pf_ld(k3_win_l->vm_start), K3_PF_FAIL_P9);
+	k3_pf_expect("P9b: private page, not the zero page", 1,
+		     (pte_val(*pa_ptep) & _PAGE_PFN_MASK) !=
+		     (za & _PAGE_PFN_MASK), K3_PF_FAIL_P9);
+	k3_pf_expect("P9b: two entries (fill, then replace)", entries + 2,
+		     dadao_pf_entry_count(), K3_PF_FAIL_P9);
+}
+
+/* P3: one line per missing-class branch, with the value the fill made
+ * readable.  The gate asserts *which* branch ran from the channel's own line. */
+static void __init k3_pf_p3(unsigned long va, const char *tag,
+			    unsigned long expected)
+{
+	unsigned long entries = dadao_pf_entry_count();
+	unsigned long word = k3_pf_ld(va);
+
+	dadao_early_printf("K3 pfc %s va=%#lx word=%#lx expect=%#lx entries=%lu "
+			   "ok=%d\n", tag, va, word, expected,
+			   dadao_pf_entry_count(),
+			   word == expected &&
+			   dadao_pf_entry_count() == entries + 1);
+	k3_pf_expect(tag, expected, word, K3_PF_FAIL_P3);
+	k3_pf_expect("P3: one channel entry", entries + 1,
+		     dadao_pf_entry_count(), K3_PF_FAIL_P3);
+}
+
+/* P4a: the page is absent, the window names its content, and the retried
+ * instruction really runs (the magic is the side effect). */
+static void __init k3_pf_p4a(struct vm_area_struct *vma, const char *tag)
+{
+	unsigned long target = vma->vm_start;
+	unsigned long entries = dadao_pf_entry_count();
+	void (*fn)(unsigned long, unsigned long *) =
+		(void (*)(unsigned long, unsigned long *))target;
+
+	k3_pf_magic = 0;
+	barrier();
+	fn(K3_PF_MAGIC, &k3_pf_magic);
+	barrier();
+
+	dadao_early_printf("K3 pfc %s target=%#lx magic=%#lx expect=%#lx "
+			   "entries=%lu ok=%d\n", tag, target, k3_pf_magic,
+			   K3_PF_MAGIC, dadao_pf_entry_count(),
+			   k3_pf_magic == K3_PF_MAGIC &&
+			   dadao_pf_entry_count() == entries + 1);
+	k3_pf_expect("P4a: the code ran", K3_PF_MAGIC, k3_pf_magic,
+		     K3_PF_FAIL_P4A);
+	k3_pf_expect("P4a: one channel entry", entries + 1,
+		     dadao_pf_entry_count(), K3_PF_FAIL_P4A);
+}
+
+static void __init k3_pf_recoverable(void)
+{
+	k3_pf_setup_recoverable();
+
+	k3_pf_layout();
+	k3_pf_exit_codes();
+	/* The edge lookups use an isolated window: A's end is B's start, so the
+	 * "one past the end" probe would legitimately hit B. */
+	k3_pf_vma_edges(k3_win_c);
+
+	k3_pf_p1_p8_p10_p9_p2();
+
+	/* Every missing class the contract defines, both fetch and data. */
+	k3_pf_p3(k3_win_c->vm_start, "P3a", 0);		/* L1 P=0  DGPTRAP */
+	k3_pf_p3(k3_win_d->vm_start, "P3b", 0);		/* L2 P=0  DGPTRAP */
+	k3_pf_p3(k3_win_e->vm_start, "P3c", K3_PF_MAGIC); /* GPF=0  DGPFTRAP */
+	k3_pf_p3(k3_win_f->vm_start, "P3d", K3_PF_MAGIC); /* SPF=0  DSPFTRAP */
+	k3_pf_p3(k3_win_k->vm_start, "P3e", K3_PF_MAGIC); /* P=0 SP=1 DSPTRAP */
+
+	k3_pf_p4a(k3_win_g, "P4a");		/* L1 P=0  IGPTRAP  */
+	k3_pf_p4a(k3_win_h, "P4a2");		/* L2 P=0  IGPTRAP  */
+	k3_pf_p4a(k3_win_i, "P4a3");		/* SPF=0   ISPFTRAP */
+	k3_pf_p4a(k3_win_j, "P4a4");		/* P=0 SP=1 ISPTRAP */
+}
+
+/* -------------------------------------------------------------------------
+ * The terminating images
+ * ------------------------------------------------------------------------- */
+
+/* Case 2: a read of a page whose R bit is 0 (CFXPERM + NRPERM). */
+static void __init k3_pf_perm(void)
+{
+	unsigned long slot = k3_pf_slot(1);
+	struct vm_area_struct *vma;
+	pte_t *ptep;
+	unsigned long page;
+
+	dadao_pf_init();
+	vma = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+			   DADAO_PF_NO_SUPERPAGE);
+	ptep = k3_pf_table(slot);
+	page = dadao_pf_alloc_page();
+	if (!page)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "perm_page", slot);
+	k3_pf_st((unsigned long)__va(page), K3_PF_MAGIC);
+	/* Present, every fragment, W and X but *no R*. */
+	set_pte(ptep, __pte(k3_pf_leaf(page, _PAGE_PRESENT | _PAGE_S |
+				       _PAGE_GLOBAL | _PAGE_WRITE | _PAGE_EXEC,
+				       0xff)));
+	local_flush_tlb_all();
+
+	dadao_early_printf("K3 pfc P5 va=%#lx pte=%#lx pool=%lu entries=%lu\n",
+			   vma->vm_start, pte_val(*ptep),
+			   dadao_pf_alloc_count(), dadao_pf_entry_count());
+	(void)k3_pf_ld(vma->vm_start);	/* CFXPERM + NRPERM: terminates */
+	k3_pf_fail_case(K3_PF_FAIL_P3, "perm_read_returned", vma->vm_start);
+}
+
+/* Case 3: a fetch outside every window (CFXMEM + IGPTRAP). */
+static void __init k3_pf_wild_jump(void)
+{
+	unsigned long target = k3_pf_slot(5) + k3_pf_code_off;
+	void (*fn)(unsigned long, unsigned long *) =
+		(void (*)(unsigned long, unsigned long *))target;
+
+	dadao_early_printf("K3 pfc P4b target=%#lx pool=%lu entries=%lu\n",
+			   target, dadao_pf_alloc_count(),
+			   dadao_pf_entry_count());
+	k3_pf_magic = 0;
+	fn(K3_PF_MAGIC, &k3_pf_magic);	/* IGPTRAP, no window: terminates */
+	k3_pf_fail_case(K3_PF_FAIL_P4A, "wild_jump_returned", target);
+}
+
+/* Case 4: one page either side of a window edge (the boundary lookups are
+ * printed first, so both edges are evidenced before the termination). */
+static void __init k3_pf_no_vma(void)
+{
+	unsigned long slot = k3_pf_slot(1);
+	struct vm_area_struct *vma;
+
+	vma = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+			   DADAO_PF_NO_SUPERPAGE);
+	k3_pf_vma_edges(vma);
+
+	dadao_early_printf("K3 pfc P7 va=%#lx pool=%lu entries=%lu\n",
+			   vma->vm_start - PAGE_SIZE,
+			   dadao_pf_alloc_count(), dadao_pf_entry_count());
+	(void)k3_pf_ld(vma->vm_start - PAGE_SIZE);	/* no window: terminates */
+	k3_pf_fail_case(K3_PF_FAIL_VMA, "outside_access_returned", slot);
+}
+
+/*
+ * Case 5: ADWBFAIL.  The machine only raises it when a page-table write-back
+ * fails, which a test cannot provoke on demand, so the *dispatch input* is what
+ * this case changes: the real dispatcher (kernel/traps.c) is entered with the
+ * cause id a write-back failure carries, and the PTE's physical address as
+ * `cause_info` (contract-see §6.1).  The verdict under test is the handler's:
+ * no fill, no retry, the address printed, the monitor-segment exit code.
+ */
+static void __init k3_pf_adwbfail(void)
+{
+	unsigned long slot = k3_pf_slot(1);
+	struct pt_regs regs;
+	pte_t *ptep;
+	unsigned long page;
+	unsigned long cause;
+
+	dadao_pf_init();
+	(void)k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+			   DADAO_PF_NO_SUPERPAGE);
+	ptep = k3_pf_table(slot);
+	page = dadao_pf_alloc_page();
+	if (!page)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "adwb_page", slot);
+	set_pte(ptep, __pte(k3_pf_leaf(page, K3_PF_DATA_PROT, 0xff)));
+	local_flush_tlb_all();
+
+	memset(&regs, 0, sizeof(regs));
+	regs.ip = (unsigned long)k3_pf_adwbfail;
+	cause = DADAO_CAUSE_CFXMEM | (1UL << DADAO_SUB_ADWBFAIL);
+
+	dadao_early_printf("K3 pfc P6 cause=%#lx pte_pa=%#lx pool=%lu "
+			   "entries=%lu\n", cause, __pa(ptep),
+			   dadao_pf_alloc_count(), dadao_pf_entry_count());
+	(void)dadao_trap_handler(&regs, cause, __pa(ptep));
+	k3_pf_fail_case(K3_PF_FAIL_P6, "adwbfail_returned", cause);
+}
+
+/* Case 6: the page is present and R/W/X all allow the read, but its HSJU.S bit
+ * is 0 — the supv mode the kernel runs in has no permission on it
+ * (CFXPERM + NSPERM).  K3 cannot run user/jail/hypv, so this is the only
+ * HSJU-class sub-reason the kernel side can raise; the other three are covered
+ * by the arch probes. */
+static void __init k3_pf_nsperm(void)
+{
+	unsigned long slot = k3_pf_slot(1);
+	struct vm_area_struct *vma;
+	pte_t *ptep;
+	unsigned long page;
+
+	dadao_pf_init();
+	vma = k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+			   DADAO_PF_NO_SUPERPAGE);
+	ptep = k3_pf_table(slot);
+	page = dadao_pf_alloc_page();
+	if (!page)
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "nsperm_page", slot);
+	k3_pf_st((unsigned long)__va(page), K3_PF_MAGIC);
+	/* Present, every fragment, R/W/X — and only the U bit of HSJU (§2.2.5). */
+	set_pte(ptep, __pte(k3_pf_leaf(page, _PAGE_PRESENT | _PAGE_GLOBAL |
+				       _PAGE_READ | _PAGE_WRITE | _PAGE_EXEC |
+				       _PAGE_U, 0xff)));
+	local_flush_tlb_all();
+
+	dadao_early_printf("K3 pfc P5b va=%#lx pte=%#lx pool=%lu entries=%lu\n",
+			   vma->vm_start, pte_val(*ptep),
+			   dadao_pf_alloc_count(), dadao_pf_entry_count());
+	(void)k3_pf_ld(vma->vm_start);	/* CFXPERM + NSPERM: terminates */
+	k3_pf_fail_case(K3_PF_FAIL_P3, "nsperm_read_returned", vma->vm_start);
+}
+
+/*
+ * Cases 7-9: a *malformed* sub-reason must be refused by the dispatcher, never
+ * decoded as a page fault (task rule "未知/多位置 1 的子原因 ⇒ 具名终止，不得默认
+ * 按缺页处理").  The machine model checks the shape at every raise site, so no
+ * access can produce such an id: like P6's ADWBFAIL this injects the *dispatch
+ * input* — the real dispatcher (kernel/traps.c) is entered with the id and an
+ * address that **is** inside a registered window, so a dispatcher that let the
+ * id through would fill that page and print a `fill-*` line.  The verdict is
+ * that it does not: the id reaches dadao_die() untouched (the die line carries
+ * the raw 64-bit id) and the exit code keeps spec/Kaiwu §7.1's monitor segment.
+ */
+static void __init k3_pf_malformed(const char *tag, unsigned long cause)
+{
+	unsigned long slot = k3_pf_slot(1);
+	struct pt_regs regs;
+
+	dadao_pf_init();
+	(void)k3_pf_window(slot, slot + PAGE_SIZE, VM_READ | VM_WRITE, 0,
+			   DADAO_PF_NO_SUPERPAGE);
+
+	memset(&regs, 0, sizeof(regs));
+	regs.ip = (unsigned long)k3_pf_malformed;
+
+	dadao_early_printf("K3 pfc %s va=%#lx id=%#lx pool=%lu entries=%lu\n",
+			   tag, slot, cause, dadao_pf_alloc_count(),
+			   dadao_pf_entry_count());
+	(void)dadao_trap_handler(&regs, cause, slot);
+	k3_pf_fail_case(K3_PF_FAIL_DISPATCH, tag, cause);
+}
+
+/* -------------------------------------------------------------------------
+ * Entry
+ * ------------------------------------------------------------------------- */
+
+void __init __noreturn dadao_k3_pf_selftest(void)
+{
+	k3_pf_pages();
+
+	switch (CONFIG_DADAO_K3_PF_SELFTEST) {
+	case 1:
+		k3_pf_recoverable();
+		break;
+	case 2:
+		k3_pf_perm();
+		break;
+	case 3:
+		k3_pf_wild_jump();
+		break;
+	case 4:
+		k3_pf_no_vma();
+		break;
+	case 5:
+		k3_pf_adwbfail();
+		break;
+	case 6:
+		k3_pf_nsperm();
+		break;
+	case 7:
+		/* reserved [31:16] set, and a valid own-wyde bit (DGPTRAP) so a
+		 * dispatcher that let it through would *fill* the window. */
+		k3_pf_malformed("P7", DADAO_CAUSE_CFXMEM | (1UL << 16) |
+				(1UL << DADAO_SUB_DGPTRAP));
+		break;
+	case 8:
+		/* two bits in the class's own wyde (not one-hot). */
+		k3_pf_malformed("P8", DADAO_CAUSE_CFXMEM |
+				(1UL << DADAO_SUB_IGPTRAP) |
+				(1UL << DADAO_SUB_DGPTRAP));
+		break;
+	case 9:
+		/* the *other* class's wyde: no CFXMEM sub-reason at all. */
+		k3_pf_malformed("P9", DADAO_CAUSE_CFXMEM |
+				(1UL << DADAO_SUB_NRPERM));
+		break;
+	default:
+		k3_pf_fail_case(K3_PF_FAIL_POOL, "case",
+				CONFIG_DADAO_K3_PF_SELFTEST);
+	}
+
+	dadao_early_printf("K3 pf done: case=%d slots=%d zero_pa=%#lx\n",
+			   CONFIG_DADAO_K3_PF_SELFTEST, K3_PF_SLOTS,
+			   dadao_pf_zero_page_pa());
+	dadao_early_exit(0);
+}
