diff --git a/arch/dadao/mm/k3_pt_selftest.c b/arch/dadao/mm/k3_pt_selftest.c
new file mode 100644
index 000000000..3b21c03e7
--- /dev/null
+++ b/arch/dadao/mm/k3_pt_selftest.c
@@ -0,0 +1,698 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * K3 page-table / TLB self-test (CONFIG_DADAO_K3_PT_SELFTEST).
+ *
+ * The K3 gate (`tools/linux/k3_pt_probe.py`) has to see that the primitives
+ * this milestone adds actually work on the machine, not only that they compile:
+ *
+ *   - the L1 entry `pmd_populate[_kernel]()` writes points at the L2 table by
+ *     *physical* address, with P = 1, SP = 0 and the non-leaf G/SPF bits 0
+ *     (spec/DADAO-12 §2.2.3, contract-tlb TLB-27);
+ *   - a fresh L2 PTE maps and is writable, and a changed PTE is only visible
+ *     after an explicit invalidation (`clean`/`invalid`/`flush` × `all`/`VA`/
+ *     `range`, contract-tlb §5);
+ *   - `clean` writes A back and keeps the entry, `flush` writes A/D back and
+ *     drops it, `invalid` drops it without writing back (TLB-17);
+ *   - `ASID_ANY = 0` leaves the G = 1 entries alone, `ASID_ANY = 1` reaches
+ *     them (TLB-25/TLB-26);
+ *   - writing PTBR does not invalidate (TLB-29);
+ *   - a P = 0 entry produced by these primitives faults through the real supv
+ *     entry and is recovered by the K2 registered-probe channel (TLB-31) —
+ *     i.e. the table the primitives build is the table the hardware walks.
+ *
+ * It is compiled only into a probe image (the Kconfig symbol is off in
+ * defconfig) and is called from the end of setup_arch(), where memblock has the
+ * RAM window and paging_init() has adopted the kernel table.  It ends the boot.
+ *
+ * Two pages at the top of RAM are used as raw memory (an L2 table and the two
+ * data pages behind the test mapping); they are checked against the kernel
+ * image extent, not assumed free.
+ *
+ * The test mapping lives in the first 512 MiB superpage *past* RAM: that L1
+ * entry is empty (K1 maps exactly the RAM superpages) and it is still inside
+ * the 42-bit window (VA[47:42] = 0), so the walker applies PTW to it.
+ */
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/pgtable.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/mmu_context.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+#include <asm/pgtable.h>
+#include <asm/ptrace.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/tlbflush.h>
+#include <asm/trap.h>
+
+/* Guest FAIL segment (spec/Kaiwu §7.1): setup.c carries 0x04-0x08, k1_pt.c
+ * 0x09-0x0c, trap.S 0x0d, traps.c 0x0e-0x0f; this file continues at 0x10. */
+#define K3_FAIL_GEOM	0x10	/* the build's page geometry is not §2.2.2 */
+#define K3_FAIL_PAGE	0x11	/* no usable scratch pages / test VA */
+#define K3_FAIL_ALLOC	0x12	/* the L1 entry pmd_populate built is wrong */
+#define K3_FAIL_MAP	0x13	/* the new L2 PTE does not map correctly */
+#define K3_FAIL_PROBE	0x14	/* the fault probe could not be registered */
+#define K3_FAIL_STALE	0x15	/* a changed PTE was visible without invalidation */
+#define K3_FAIL_INVAL	0x16	/* invalid did not drop the entry */
+#define K3_FAIL_CLEAN	0x17	/* clean did not write A back / dropped the entry */
+#define K3_FAIL_FLUSH	0x18	/* flush did not write A/D back / kept the entry */
+#define K3_FAIL_MATRIX	0x19	/* one (op, scope) combination is wrong */
+#define K3_FAIL_ASID	0x1a	/* ASID register width / allocation is wrong */
+#define K3_FAIL_ASID_G	0x1b	/* ASID_ANY and G are not independent */
+#define K3_FAIL_PTBR	0x1c	/* writing PTBR invalidated the TLB */
+#define K3_FAIL_CAUSE	0x1d	/* cause & 0xffff masking is wrong */
+#define K3_FAIL_NEG	0x1e	/* the built table's P = 0 path did not fault */
+
+/* Data-page markers: distinguished by value, so "old"/"new" is unambiguous. */
+#define K3_MARK_X	0x4b3300000000000aUL
+#define K3_MARK_Y	0x4b3300000000000bUL
+
+/* Leaf protection this file builds: supervisor, R/W/X, all 8 fragments of the
+ * 64 KiB page resident, no A/D (so the fill/write-back state is visible) and
+ * optionally G (kernel-style). */
+#define K3_LEAF_BASE	(_PAGE_S | _PAGE_READ | _PAGE_WRITE | _PAGE_EXEC | \
+			 _PAGE_PRESENT | _PAGE_FRAG_ALL)
+#define K3_LEAF_GLOBAL	(K3_LEAF_BASE | _PAGE_GLOBAL)
+
+extern char _end[];
+
+static unsigned long k3_l2_pa;		/* the L2 table (one 64 KiB page) */
+static unsigned long k3_x_pa;		/* data page "old" */
+static unsigned long k3_y_pa;		/* data page "new" */
+static unsigned long k3_va;		/* primary test VA (G = 1 mapping) */
+static unsigned long k3_va2;		/* second L2 slot (G = 0 mapping) */
+static pte_t *k3_ptep;
+
+static unsigned long k3_probe_hits;
+static unsigned long k3_probe_cause;
+static unsigned long k3_probe_va;
+
+static void __noreturn k3_fail(unsigned int code, const char *what,
+			       unsigned long value)
+{
+	dadao_early_printf("K3 pt FAIL: %s=%#lx code=%#x\n", what, value, code);
+	dadao_early_exit(code);
+}
+
+static void k3_expect(const char *what, unsigned long expected,
+		      unsigned long actual, unsigned int code)
+{
+	if (expected != actual)
+		k3_fail(code, what, actual);
+}
+
+static void k3_expect_true(const char *what, bool ok, unsigned int code,
+			   unsigned long actual)
+{
+	if (!ok)
+		k3_fail(code, what, actual);
+}
+
+/* The L2 PTE for @va, built from K3_LEAF_BASE. */
+static pte_t k3_leaf(unsigned long pa, unsigned long prot)
+{
+	return pfn_pte(pa >> PAGE_SHIFT, __pgprot(prot));
+}
+
+/* Replace the physical page a PTE points at, keeping every other bit. */
+static void k3_retarget(pte_t *ptep, unsigned long pa)
+{
+	unsigned long val = pte_val(*ptep) & ~_PAGE_PFN_MASK;
+
+	set_pte(ptep, __pte(val | (pa & _PAGE_PFN_MASK)));
+}
+
+static unsigned long k3_read_pte(pte_t *ptep)
+{
+	return pte_val(*(volatile pte_t *)ptep);
+}
+
+static unsigned long k3_ld(unsigned long va)
+{
+	return *(volatile unsigned long *)va;
+}
+
+static void k3_st(unsigned long va, unsigned long value)
+{
+	*(volatile unsigned long *)va = value;
+	barrier();
+}
+
+static void k3_probe_report(struct dadao_fault_probe *probe,
+			    struct pt_regs *regs, unsigned long info)
+{
+	k3_probe_hits++;
+	k3_probe_cause = probe->cause;
+	k3_probe_va = info;
+}
+
+/* Register the CFXMEM probe, dereference @va once, report what the channel saw. */
+static void k3_expect_fault(unsigned long va, const char *tag)
+{
+	struct dadao_fault_probe probe = {
+		.cause = DADAO_CAUSE_CLASS(1UL << 1),	/* CFXMEM */
+		.info = va,
+		.max_hits = 1,
+		.report = k3_probe_report,
+	};
+	unsigned long hits = k3_probe_hits;
+	unsigned long word = 0;
+
+	if (dadao_trap_probe_register(&probe))
+		k3_fail(K3_FAIL_PROBE, "probe_register", va);
+	barrier();
+	word = k3_ld(va);	/* faults; the channel skips the load */
+	barrier();
+	dadao_trap_probe_unregister(&probe);
+	if (k3_probe_hits != hits + 1)
+		k3_fail(K3_FAIL_NEG, tag, k3_probe_hits - hits);
+	dadao_early_printf("K3 pt %s va=%#lx hits=%lu cause=%s resumed=1 word=%#lx\n",
+			   tag, va, k3_probe_hits - hits,
+			   dadao_cause_name(k3_probe_cause) ?: "unknown", word);
+}
+
+/* -------------------------------------------------------------------------
+ * geometry: the page size the build really has (spec/DADAO-12 §2.2.2)
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_geometry(void)
+{
+	/*
+	 * Compile-time assertions of the same facts the runtime line reports:
+	 * a build whose PAGE_SHIFT is not 16 cannot satisfy §2.2.2 (the page
+	 * offset is VA[15:0]), and the two levels must each be one page.
+	 */
+	BUILD_BUG_ON(PAGE_SHIFT != 16);
+	BUILD_BUG_ON(PTRS_PER_PTE * sizeof(pte_t) != PAGE_SIZE);
+	BUILD_BUG_ON(PTRS_PER_PGD * sizeof(pgd_t) != PAGE_SIZE);
+	BUILD_BUG_ON(PGDIR_SHIFT != PAGE_SHIFT + 13);
+
+	dadao_early_printf("K3 pt geom PAGE_SHIFT=%d PAGE_SIZE=%#lx PTRS_PER_PTE=%lu "
+			   "PTRS_PER_PGD=%lu PGDIR_SHIFT=%d PGDIR_SIZE=%#lx PTE_BYTES=%lu\n",
+			   PAGE_SHIFT, (unsigned long)PAGE_SIZE,
+			   (unsigned long)PTRS_PER_PTE,
+			   (unsigned long)PTRS_PER_PGD, PGDIR_SHIFT,
+			   (unsigned long)PGDIR_SIZE,
+			   (unsigned long)sizeof(pte_t));
+}
+
+/* -------------------------------------------------------------------------
+ * scratch pages and the test VA
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_pages(void)
+{
+	unsigned long top = dadao_ram_base + dadao_ram_size;
+	unsigned long pa;
+
+	/* 3 pages straight below the top of RAM: L2 table, page X, page Y. */
+	top &= ~(PAGE_SIZE - 1);
+	if (top < dadao_ram_base + 4 * PAGE_SIZE)
+		k3_fail(K3_FAIL_PAGE, "ram_size", dadao_ram_size);
+	k3_y_pa = top - PAGE_SIZE;
+	k3_x_pa = top - 2 * PAGE_SIZE;
+	k3_l2_pa = top - 3 * PAGE_SIZE;
+	pa = k3_l2_pa;
+	if (pa < __pa(_end))
+		k3_fail(K3_FAIL_PAGE, "scratch_overlaps_image", pa);
+
+	/* The test VAs live in the first superpage past RAM (L1 entry empty). */
+	k3_va = PAGE_OFFSET + round_up(dadao_ram_size, SUPERPAGE_SIZE);
+	k3_va2 = k3_va + PAGE_SIZE;
+	if (pgd_index(k3_va) < pgd_index(PAGE_OFFSET) +
+			     DIV_ROUND_UP(dadao_ram_size, SUPERPAGE_SIZE))
+		k3_fail(K3_FAIL_PAGE, "test_va_inside_ram", k3_va);
+
+	memset(__va(k3_l2_pa), 0, PAGE_SIZE);
+	memset(__va(k3_x_pa), 0, PAGE_SIZE);
+	memset(__va(k3_y_pa), 0, PAGE_SIZE);
+	k3_st((unsigned long)__va(k3_x_pa), K3_MARK_X);
+	k3_st((unsigned long)__va(k3_y_pa), K3_MARK_Y);
+
+	dadao_early_printf("K3 pt pages l2_pa=%#lx x_pa=%#lx y_pa=%#lx va=%#lx va2=%#lx "
+			   "l1_index=%lu\n", k3_l2_pa, k3_x_pa, k3_y_pa, k3_va,
+			   k3_va2, pgd_index(k3_va));
+	k3_expect("pte_slot", pte_index(k3_va) + 1, pte_index(k3_va2),
+		  K3_FAIL_PAGE);
+}
+
+/* -------------------------------------------------------------------------
+ * alloc: the L1 entry the primitives build (the defect under test)
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_alloc(void)
+{
+	pmd_t *pmd = pmd_off_k(k3_va);
+	unsigned long entry;
+	unsigned long expected;
+	unsigned long pte_pa;
+
+	/* Install the L2 table through pmd_populate_kernel(): P = 1, SP = 0,
+	 * PPN = the table's PA, G/SPF = 0.  (pmd_populate() is the same helper
+	 * with a struct page argument; the struct page array does not exist
+	 * before mm_init(), which is why the probe uses this entry point.) */
+	pmd_populate_kernel(&init_mm, pmd, (pte_t *)__va(k3_l2_pa));
+
+	entry = pgd_val(swapper_pg_dir[pgd_index(k3_va)]);
+	expected = __pa((void *)__va(k3_l2_pa));
+
+	dadao_early_printf("K3 pt alloc va=%#lx l1=%lu pte=%#lx P=%d SP=%d S=%d G=%d "
+			   "SPF=%#lx R=%d W=%d X=%d A=%d D=%d ppn=%#lx l2_pa=%#lx\n",
+			   k3_va, pgd_index(k3_va), entry,
+			   !!(entry & _PAGE_PRESENT), !!(entry & _PAGE_SUPER),
+			   !!(entry & _PAGE_S), !!(entry & _PAGE_GLOBAL),
+			   (entry >> _PAGE_FRAG_SHIFT) & 0xff,
+			   !!(entry & _PAGE_READ), !!(entry & _PAGE_WRITE),
+			   !!(entry & _PAGE_EXEC), !!(entry & _PAGE_ACCESSED),
+			   !!(entry & _PAGE_DIRTY),
+			   (entry & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT, k3_l2_pa);
+
+	k3_expect_true("l1_P", entry & _PAGE_PRESENT, K3_FAIL_ALLOC, entry);
+	k3_expect("l1_SP", 0, !!(entry & _PAGE_SUPER), K3_FAIL_ALLOC);
+	k3_expect("l1_S", 1, !!(entry & _PAGE_S), K3_FAIL_ALLOC);
+	k3_expect("l1_G", 0, !!(entry & _PAGE_GLOBAL), K3_FAIL_ALLOC);
+	k3_expect("l1_SPF", 0, (entry >> _PAGE_FRAG_SHIFT) & 0xff, K3_FAIL_ALLOC);
+	k3_expect("l1_RWXAD", 0,
+		  !!(entry & (_PAGE_READ | _PAGE_WRITE | _PAGE_EXEC |
+			      _PAGE_ACCESSED | _PAGE_DIRTY)), K3_FAIL_ALLOC);
+	k3_expect("l1_ppn", expected >> _PAGE_PFN_SHIFT,
+		  (entry & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT, K3_FAIL_ALLOC);
+
+	/* Walking the entry (pmd_page_vaddr + pte_index) must land on the L2
+	 * table page the kernel just filled. */
+	k3_ptep = pte_offset_kernel(pmd, k3_va);
+	pte_pa = __pa(k3_ptep);
+	k3_expect("l2_walk_pa", k3_l2_pa + pte_index(k3_va) * sizeof(pte_t),
+		  pte_pa, K3_FAIL_ALLOC);
+	dadao_early_printf("K3 pt alloc-walk ptep_pa=%#lx expect=%#lx ok=%d\n",
+			   pte_pa, k3_l2_pa + pte_index(k3_va) * sizeof(pte_t),
+			   pte_pa == k3_l2_pa + pte_index(k3_va) * sizeof(pte_t));
+
+	local_flush_tlb_all();
+}
+
+/* -------------------------------------------------------------------------
+ * map / stale / inval / clean / flush
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_map(void)
+{
+	set_pte(k3_ptep, k3_leaf(k3_x_pa, K3_LEAF_GLOBAL));
+	local_flush_tlb_all();
+
+	k3_st(k3_va, K3_MARK_X);
+	k3_expect("map_read", K3_MARK_X, k3_ld(k3_va), K3_FAIL_MAP);
+	k3_expect("map_pte_ppn", k3_x_pa >> PAGE_SHIFT,
+		  (k3_read_pte(k3_ptep) & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+		  K3_FAIL_MAP);
+	dadao_early_printf("K3 pt map va=%#lx pa=%#lx pte=%#lx word=%#lx ok=1\n",
+			   k3_va, k3_x_pa, k3_read_pte(k3_ptep), k3_ld(k3_va));
+}
+
+static void k3_pt_stale(void)
+{
+	/* Point the PTE at Y without invalidating: the TLB entry was filled with
+	 * X and must keep serving it (TLB-07: a hit does not re-read the PTE). */
+	k3_retarget(k3_ptep, k3_y_pa);
+	k3_expect("stale_reads_old", K3_MARK_X, k3_ld(k3_va), K3_FAIL_STALE);
+	dadao_early_printf("K3 pt stale va=%#lx pte_ppn=%#lx word=%#lx old=%d\n",
+			   k3_va,
+			   (k3_read_pte(k3_ptep) & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT,
+			   k3_ld(k3_va), k3_ld(k3_va) == K3_MARK_X);
+}
+
+static void k3_pt_inval_va(void)
+{
+	/* invalid over scope VA, ASID_ANY = 1 (the mapping is G = 1): the entry
+	 * is dropped without a write-back, so the next access walks the new PTE. */
+	local_flush_tlb_page(NULL, k3_va);
+	k3_expect("inval_va_reads_new", K3_MARK_Y, k3_ld(k3_va), K3_FAIL_INVAL);
+	dadao_early_printf("K3 pt inval_va va=%#lx cmd=%#lx word=%#lx new=%d\n",
+			   k3_va,
+			   dadao_tlb_control_value(DADAO_TLB_INVALID,
+						   DADAO_TLB_SCOPE_VA, true),
+			   k3_ld(k3_va), k3_ld(k3_va) == K3_MARK_Y);
+}
+
+static void k3_pt_ad_clean(void)
+{
+	unsigned long before;
+	unsigned long after;
+
+	/* Re-fill with A = D = 0 in the PTE: the walk copies them into the
+	 * entry, and touching the entry only sets its local bits. */
+	k3_retarget(k3_ptep, k3_y_pa);
+	set_pte(k3_ptep, __pte(pte_val(*k3_ptep) &
+			       ~(_PAGE_ACCESSED | _PAGE_DIRTY)));
+	local_flush_tlb_all();
+
+	k3_expect("clean_fill_read", K3_MARK_Y, k3_ld(k3_va), K3_FAIL_CLEAN);
+	before = k3_read_pte(k3_ptep) & _PAGE_ACCESSED;
+	k3_expect("clean_a_before", 0, before, K3_FAIL_CLEAN);
+
+	/* clean: write the pending A back and keep the entry (TLB-17). */
+	dadao_tlb_control(DADAO_TLB_CLEAN, DADAO_TLB_SCOPE_VA, true);
+	after = k3_read_pte(k3_ptep);
+	k3_expect("clean_a_after", 1, !!(after & _PAGE_ACCESSED), K3_FAIL_CLEAN);
+	k3_expect("clean_d_after", 0, !!(after & _PAGE_DIRTY), K3_FAIL_CLEAN);
+
+	/* The entry survived: retargeting the PTE must still serve the old page. */
+	k3_retarget(k3_ptep, k3_x_pa);
+	k3_expect("clean_keeps_entry", K3_MARK_Y, k3_ld(k3_va), K3_FAIL_CLEAN);
+	dadao_early_printf("K3 pt ad_clean va=%#lx a_before=%lu a_after=%lu d_after=%lu "
+			   "kept_old=%d cmd=%#lx\n", k3_va, before,
+			   !!(after & _PAGE_ACCESSED), !!(after & _PAGE_DIRTY),
+			   k3_ld(k3_va) == K3_MARK_Y,
+			   dadao_tlb_control_value(DADAO_TLB_CLEAN,
+						   DADAO_TLB_SCOPE_VA, true));
+}
+
+static void k3_pt_flush(void)
+{
+	unsigned long after;
+
+	/* A store to the still-live entry sets the local D bit (TLB-14); flush
+	 * then writes A/D back and drops the entry. */
+	k3_st(k3_va + sizeof(unsigned long), K3_MARK_X);
+	dadao_tlb_control(DADAO_TLB_FLUSH, DADAO_TLB_SCOPE_ALL, true);
+	after = k3_read_pte(k3_ptep);
+	k3_expect("flush_a", 1, !!(after & _PAGE_ACCESSED), K3_FAIL_FLUSH);
+	k3_expect("flush_d", 1, !!(after & _PAGE_DIRTY), K3_FAIL_FLUSH);
+
+	/* Entry gone: the retargeted PTE must now be read by a fresh walk. */
+	k3_retarget(k3_ptep, k3_x_pa);
+	k3_expect("flush_refills", K3_MARK_X, k3_ld(k3_va), K3_FAIL_FLUSH);
+	dadao_early_printf("K3 pt flush va=%#lx a=%d d=%d refill_new=%d cmd=%#lx\n",
+			   k3_va, !!(after & _PAGE_ACCESSED),
+			   !!(after & _PAGE_DIRTY), k3_ld(k3_va) == K3_MARK_X,
+			   dadao_tlb_control_value(DADAO_TLB_FLUSH,
+						   DADAO_TLB_SCOPE_ALL, true));
+}
+
+/* -------------------------------------------------------------------------
+ * the (op, scope) matrix: every combination, one line each
+ * ------------------------------------------------------------------------- */
+
+struct k3_cmd {
+	const char *name;
+	unsigned int op;
+	unsigned int scope;
+};
+
+static const struct k3_cmd k3_cmds[] = {
+	{ "m_none_all",    DADAO_TLB_NONE,    DADAO_TLB_SCOPE_ALL },
+	{ "m_none_va",     DADAO_TLB_NONE,    DADAO_TLB_SCOPE_VA },
+	{ "m_none_range",  DADAO_TLB_NONE,    DADAO_TLB_SCOPE_RANGE },
+	{ "m_clean_all",   DADAO_TLB_CLEAN,   DADAO_TLB_SCOPE_ALL },
+	{ "m_clean_va",    DADAO_TLB_CLEAN,   DADAO_TLB_SCOPE_VA },
+	{ "m_clean_range", DADAO_TLB_CLEAN,   DADAO_TLB_SCOPE_RANGE },
+	{ "m_invalid_all",   DADAO_TLB_INVALID, DADAO_TLB_SCOPE_ALL },
+	{ "m_invalid_va",    DADAO_TLB_INVALID, DADAO_TLB_SCOPE_VA },
+	{ "m_invalid_range", DADAO_TLB_INVALID, DADAO_TLB_SCOPE_RANGE },
+	{ "m_flush_all",   DADAO_TLB_FLUSH,   DADAO_TLB_SCOPE_ALL },
+	{ "m_flush_va",    DADAO_TLB_FLUSH,   DADAO_TLB_SCOPE_VA },
+	{ "m_flush_range", DADAO_TLB_FLUSH,   DADAO_TLB_SCOPE_RANGE },
+};
+
+static void k3_pt_matrix(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(k3_cmds); i++) {
+		const struct k3_cmd *cmd = &k3_cmds[i];
+		bool deletes = cmd->op == DADAO_TLB_INVALID ||
+			       cmd->op == DADAO_TLB_FLUSH;
+		bool writes_ad = cmd->op == DADAO_TLB_CLEAN ||
+				 cmd->op == DADAO_TLB_FLUSH;
+		unsigned long expected = deletes ? K3_MARK_Y : K3_MARK_X;
+		unsigned long pte;
+		unsigned long word;
+		bool ok;
+
+		/* Fresh entry: PTE -> X with A/D clear, refilled by a read. */
+		set_pte(k3_ptep, k3_leaf(k3_x_pa, K3_LEAF_GLOBAL));
+		local_flush_tlb_all();
+		(void)k3_ld(k3_va);
+
+		/* Retarget to Y; only the command may make that visible. */
+		k3_retarget(k3_ptep, k3_y_pa);
+		if (cmd->scope == DADAO_TLB_SCOPE_ALL) {
+			dadao_tlb_control(cmd->op, cmd->scope, true);
+		} else if (cmd->scope == DADAO_TLB_SCOPE_VA) {
+			dadao_tlb_addr_start_write(k3_va);
+			dadao_tlb_control(cmd->op, cmd->scope, true);
+		} else {
+			dadao_tlb_addr_start_write(k3_va);
+			dadao_tlb_addr_size_write(PAGE_SIZE);
+			dadao_tlb_control(cmd->op, cmd->scope, true);
+		}
+
+		word = k3_ld(k3_va);
+		pte = k3_read_pte(k3_ptep);
+		/* none/invalid leave the PTE A bit alone; clean/flush write the
+		 * pending A back.  The delete dimension is separate: clean keeps
+		 * the entry (old data), invalid/flush drop it (new data). */
+		ok = word == expected &&
+		     !!(pte & _PAGE_ACCESSED) == writes_ad;
+
+		dadao_early_printf("K3 pt %s word=%#lx old=%d a=%d cmd=%#lx ok=%d\n",
+				   cmd->name, word, word == K3_MARK_X,
+				   !!(pte & _PAGE_ACCESSED),
+				   dadao_tlb_control_value(cmd->op, cmd->scope,
+							   true), ok);
+		k3_expect_true(cmd->name, ok, K3_FAIL_MATRIX, word);
+	}
+
+	/* Leave the entry out of the way for the next cases. */
+	local_flush_tlb_all();
+}
+
+/* -------------------------------------------------------------------------
+ * the flush_tlb_* helpers: every scope maps to its command
+ * ------------------------------------------------------------------------- */
+
+/* Map @pa into k3_va through a fresh entry (PTE A/D clear), then fill it. */
+static void k3_fill(unsigned long pa)
+{
+	set_pte(k3_ptep, k3_leaf(pa, K3_LEAF_GLOBAL));
+	local_flush_tlb_all();
+	(void)k3_ld(k3_va);
+}
+
+static void k3_pt_ranges(void)
+{
+	unsigned long krq;
+	unsigned long vma;
+	unsigned long empty;
+	unsigned long mm;
+
+	/* invalid over scope `range` (kernel_range helper): entry dropped. */
+	k3_fill(k3_x_pa);
+	k3_retarget(k3_ptep, k3_y_pa);
+	local_flush_tlb_kernel_range(k3_va, k3_va + PAGE_SIZE);
+	krq = k3_ld(k3_va);
+	k3_expect("kernel_range_new", K3_MARK_Y, krq, K3_FAIL_MATRIX);
+
+	/* invalid over scope `range` through the vma spelling, kernel address:
+	 * same command, ASID_ANY = 1 (the mapping is G = 1). */
+	k3_fill(k3_x_pa);
+	k3_retarget(k3_ptep, k3_y_pa);
+	local_flush_tlb_range(NULL, k3_va, k3_va + PAGE_SIZE);
+	vma = k3_ld(k3_va);
+	k3_expect("flush_range_new", K3_MARK_Y, vma, K3_FAIL_MATRIX);
+
+	/* An empty range must not reach the hardware: `range` with size 0 is
+	 * CFXREG (TLB-24), so the helpers return without issuing anything and
+	 * the entry keeps serving the old page. */
+	k3_fill(k3_x_pa);
+	k3_retarget(k3_ptep, k3_y_pa);
+	local_flush_tlb_kernel_range(k3_va, k3_va);
+	local_flush_tlb_range(NULL, k3_va, k3_va);
+	empty = k3_ld(k3_va);
+	k3_expect("empty_range_kept", K3_MARK_X, empty, K3_FAIL_MATRIX);
+
+	/* local_flush_tlb_mm(&init_mm) is the full, ASID_ANY invalidation. */
+	k3_fill(k3_x_pa);
+	k3_retarget(k3_ptep, k3_y_pa);
+	local_flush_tlb_mm(&init_mm);
+	mm = k3_ld(k3_va);
+	k3_expect("flush_mm_new", K3_MARK_Y, mm, K3_FAIL_MATRIX);
+
+	dadao_early_printf("K3 pt ranges krq_new=%d vma_new=%d empty_old=%d mm_new=%d\n",
+			   krq == K3_MARK_Y, vma == K3_MARK_Y, empty == K3_MARK_X,
+			   mm == K3_MARK_Y);
+	local_flush_tlb_all();
+}
+
+/* -------------------------------------------------------------------------
+ * ASID: register width, allocation, and ASID_ANY vs G
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_asid(void)
+{
+	unsigned long raw;
+	unsigned long read;
+	unsigned long first;
+	unsigned long second;
+	struct mm_struct probe_mm;
+
+	/* 16-bit register: a wider write is truncated, [63:16] reads 0. */
+	dadao_asid_write(DADAO_ASID_MASK | (1UL << 24));
+	raw = DADAO_CFX_READ(cfx_ptw, PTW_CG_TLB, PTW_RC_TLB_ASID);
+	read = dadao_asid_read();
+	dadao_asid_write(DADAO_ASID_KERNEL);
+	k3_expect("asid_raw_width", DADAO_ASID_MASK, raw, K3_FAIL_ASID);
+	k3_expect("asid_read", DADAO_ASID_MASK, read, K3_FAIL_ASID);
+
+	/* Allocation: never 0, and two mms do not share one. */
+	first = dadao_asid_alloc();
+	second = dadao_asid_alloc();
+	memset(&probe_mm, 0, sizeof(probe_mm));
+	if (init_new_context(NULL, &probe_mm))
+		k3_fail(K3_FAIL_ASID, "init_new_context", 0);
+	k3_expect("asid_first_nonzero", 1, first != DADAO_ASID_KERNEL,
+		  K3_FAIL_ASID);
+	k3_expect("asid_distinct", 1, first != second, K3_FAIL_ASID);
+	k3_expect("asid_mm_assigned", 1,
+		  probe_mm.context.asid != DADAO_ASID_KERNEL, K3_FAIL_ASID);
+	dadao_early_printf("K3 pt asid raw=%#lx read=%#lx alloc=%lu,%lu mm_asid=%lu "
+			   "cmd0=%#lx\n", raw, read, first, second,
+			   probe_mm.context.asid,
+			   dadao_tlb_control_value(DADAO_TLB_INVALID,
+						   DADAO_TLB_SCOPE_ALL, false));
+}
+
+static void k3_pt_asid_g(void)
+{
+	unsigned long g_word;
+	unsigned long n_word;
+
+	/* k3_va: G = 1 (kernel-style); k3_va2: G = 0 (user-style). */
+	set_pte(k3_ptep, k3_leaf(k3_x_pa, K3_LEAF_GLOBAL));
+	set_pte(k3_ptep + 1, k3_leaf(k3_x_pa, K3_LEAF_BASE));
+	local_flush_tlb_all();
+	k3_expect("asid_g_fill_g", K3_MARK_X, k3_ld(k3_va), K3_FAIL_ASID_G);
+	k3_expect("asid_g_fill_n", K3_MARK_X, k3_ld(k3_va2), K3_FAIL_ASID_G);
+
+	k3_retarget(k3_ptep, k3_y_pa);
+	k3_retarget(k3_ptep + 1, k3_y_pa);
+
+	/* ASID_ANY = 0 with the kernel ASID (0): the G = 0 entry matches and is
+	 * dropped, the G = 1 entry is not touched (TLB-26). */
+	dadao_asid_write(DADAO_ASID_KERNEL);
+	dadao_tlb_control(DADAO_TLB_INVALID, DADAO_TLB_SCOPE_ALL, false);
+	n_word = k3_ld(k3_va2);
+	g_word = k3_ld(k3_va);
+
+	/* ASID_ANY = 1 reaches the G = 1 entry as well (TLB-25). */
+	dadao_tlb_control(DADAO_TLB_INVALID, DADAO_TLB_SCOPE_ALL, true);
+	k3_expect("asid_g_any0_global_kept", K3_MARK_X, g_word, K3_FAIL_ASID_G);
+	k3_expect("asid_g_any0_local_dropped", K3_MARK_Y, n_word, K3_FAIL_ASID_G);
+	k3_expect("asid_g_any1_global_dropped", K3_MARK_Y, k3_ld(k3_va),
+		  K3_FAIL_ASID_G);
+	dadao_early_printf("K3 pt asid_g any0_global_old=%d any0_local_new=%d "
+			   "any1_global_new=%d cmd0=%#lx cmd1=%#lx\n",
+			   g_word == K3_MARK_X, n_word == K3_MARK_Y,
+			   k3_ld(k3_va) == K3_MARK_Y,
+			   dadao_tlb_control_value(DADAO_TLB_INVALID,
+						   DADAO_TLB_SCOPE_ALL, false),
+			   dadao_tlb_control_value(DADAO_TLB_INVALID,
+						   DADAO_TLB_SCOPE_ALL, true));
+	local_flush_tlb_all();
+}
+
+static void k3_pt_ptbr(void)
+{
+	unsigned long ptbr = dadao_ptbr_read();
+
+	set_pte(k3_ptep, k3_leaf(k3_x_pa, K3_LEAF_GLOBAL));
+	local_flush_tlb_all();
+	k3_expect("ptbr_fill", K3_MARK_X, k3_ld(k3_va), K3_FAIL_PTBR);
+
+	k3_retarget(k3_ptep, k3_y_pa);
+	dadao_ptbr_write(ptbr);		/* same value: still no invalidation */
+	k3_expect("ptbr_keeps_entry", K3_MARK_X, k3_ld(k3_va), K3_FAIL_PTBR);
+	dadao_early_printf("K3 pt ptbr_no_inval ptbr=%#lx old=%d ppn=%#lx\n",
+			   ptbr, k3_ld(k3_va) == K3_MARK_X,
+			   (k3_read_pte(k3_ptep) & _PAGE_PFN_MASK) >>
+			   _PAGE_PFN_SHIFT);
+	local_flush_tlb_all();
+}
+
+/* -------------------------------------------------------------------------
+ * cause id masking: [15:0] is the class, [63:32] the sub-reason (ADR-0056)
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_cause(void)
+{
+	unsigned long bare = DADAO_CAUSE_CFXMEM;
+	unsigned long sub = (1UL << 52) | (1UL << 40);	/* wyde3 + wyde2 */
+	unsigned long mixed = bare | sub;
+	const char *bare_name = dadao_cause_name(bare);
+	const char *mixed_name = dadao_cause_name(mixed);
+	unsigned long bare_code = dadao_exit_code(bare);
+	unsigned long mixed_code = dadao_exit_code(mixed);
+
+	/* Report first: the evidence for a *failing* build is this line as much
+	 * as the verdict below it. */
+	dadao_early_printf("K3 pt cause bare=%s sub=%#lx masked=%s exit_bare=%#lx "
+			   "exit_masked=%#lx class=%#lx\n",
+			   bare_name ?: "unknown", sub, mixed_name ?: "unknown",
+			   bare_code, mixed_code, DADAO_CAUSE_CLASS(mixed));
+
+	k3_expect_true("cause_bare_name", bare_name != NULL, K3_FAIL_CAUSE, 0);
+	k3_expect_true("cause_masked_name", mixed_name != NULL, K3_FAIL_CAUSE,
+		       mixed);
+	k3_expect_true("cause_masked_same_name",
+		       bare_name && mixed_name && !strcmp(bare_name, mixed_name),
+		       K3_FAIL_CAUSE, mixed);
+	k3_expect("cause_masked_exit_code", bare_code, mixed_code, K3_FAIL_CAUSE);
+	k3_expect("cause_masked_class", bare, DADAO_CAUSE_CLASS(mixed),
+		  K3_FAIL_CAUSE);
+}
+
+/* -------------------------------------------------------------------------
+ * negative: P = 0 entries built by these primitives fault for real
+ * ------------------------------------------------------------------------- */
+
+static void k3_pt_negative(void)
+{
+	/* L2 P = 0: the page was installed, then cleared — the walk must stop at
+	 * the L2 entry and raise CFXMEM through the supv entry (TLB-32). */
+	set_pte(k3_ptep, __pte(0));
+	local_flush_tlb_all();
+	k3_expect_fault(k3_va, "neg_l2");
+
+	/* L1 P = 0: the whole L2 table is detached.  This is the walk's first
+	 * missing-entry stop, reached without any second-level read. */
+	pmd_clear(pmd_off_k(k3_va2));
+	local_flush_tlb_all();
+	k3_expect_fault(k3_va2, "neg_l1");
+}
+
+void __init __noreturn dadao_k3_pt_selftest(void)
+{
+	k3_pt_geometry();
+	k3_pt_pages();
+	k3_pt_alloc();
+	k3_pt_map();
+	k3_pt_stale();
+	k3_pt_inval_va();
+	k3_pt_ad_clean();
+	k3_pt_flush();
+	k3_pt_matrix();
+	k3_pt_ranges();
+	k3_pt_asid();
+	k3_pt_asid_g();
+	k3_pt_ptbr();
+	k3_pt_cause();
+	k3_pt_negative();
+
+	dadao_early_printf("K3 pt done: cases=8 matrix=%lu asid=1 neg=2 fail=0\n",
+			   (unsigned long)ARRAY_SIZE(k3_cmds));
+	dadao_early_exit(0);
+}
