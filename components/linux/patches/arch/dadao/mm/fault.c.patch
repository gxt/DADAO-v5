diff --git a/arch/dadao/mm/fault.c b/arch/dadao/mm/fault.c
new file mode 100644
index 000000000..d68777ee7
--- /dev/null
+++ b/arch/dadao/mm/fault.c
@@ -0,0 +1,1094 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DADAO demand paging: the CFXMEM / CFXPERM fault channel (K3, m14-linux-012).
+ *
+ * The hardware reports a page-table failure as a *class* in
+ * `excp_cause_id[15:0]` plus one sub-reason bit in the wyde ADR-0056 assigns to
+ * that class (asm/cause-sub.h, contract-see §6.1.1), and `excp_cause_info` as an
+ * address.  It does not know "page fault", "COW" or "wild access" — those are
+ * operating-system readings and this file is where the reading happens
+ * (user ruling 2026-11-16):
+ *
+ *   missing class, inside an anonymous window  -> demand fill and re-execute;
+ *   missing class, outside every window        -> named termination;
+ *   R/W/X permission class                     -> named termination, *except* a
+ *                                                 write to a read-only private
+ *                                                 page: the shared zero page
+ *                                                 becomes a private zeroed page
+ *                                                 (m14-linux-012) and any other
+ *                                                 read-only page is resolved by
+ *                                                 mm/cow.c — copied when it is
+ *                                                 shared, upgraded in place when
+ *                                                 the writer is the only user
+ *                                                 (m14-linux-018);
+ *   HSJU / cfx-mask permission class           -> named termination;
+ *   ADWBFAIL                                   -> named termination (a retry
+ *                                                 would loop: nothing about the
+ *                                                 access can change);
+ *   NONPTW                                     -> named termination (the fault
+ *                                                 is not a page-table one).
+ *
+ * Two properties of this machine shape the code:
+ *
+ *  - **The page source is the buddy allocator (K4).**  K3 had neither a slab nor
+ *    a buddy allocator (it stopped before mm_core_init()), so it took pages off
+ *    the top of RAM; K4's `dadao_pf_alloc_page()` is `alloc_page(GFP_KERNEL |
+ *    __GFP_ZERO)` and the shared zero page comes from the same allocator
+ *    (`dadao_pf_init()`, called once mm_core_init() has run).  K4 also replaces
+ *    the window lookup: a task with an address space goes through
+ *    `find_vma(current->mm, addr)`.  The static window array stays as the
+ *    probe-image path (K3's cases run with `current->mm == NULL`, and a K4 probe
+ *    can point at it deliberately) - it is a *test* registry, not a page
+ *    source.
+ *
+ *  - **The missing classes do not say read or write.**  DGPTRAP covers a load
+ *    and a store alike (contract-see §6.1.1), so a missing fill maps the
+ *    read-only shared zero page; a store then faults again with CFXPERM +
+ *    NWPERM, and *that* is the point where the handler learns the access was a
+ *    write and gives it a private, zeroed page.  No instruction decoding, no
+ *    tentative writable mapping, and the zero page is never written: the write
+ *    replaces the mapping instead of copying (user ruling 2026-11-16).
+ *
+ * Every entry prints exactly one line (the gate parses it, and the task forbids
+ * per-instruction logging from a handler), and every "retry" has a budget: an
+ * injected handler that returns RETRY without making progress must end the boot
+ * by name instead of spinning (task rule).
+ */
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/pgtable.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include <asm/cause-sub.h>
+#include <asm/mmu_context.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+#include <asm/pgtable.h>
+#include <asm/ptrace.h>
+#include <asm/ptw.h>
+#include <asm/setup.h>
+#include <asm/tlbflush.h>
+#include <asm/trap.h>
+
+/* How many windows a probe may register (static storage, see below). */
+#define DADAO_PF_WINDOWS	12
+/*
+ * Retry budget: the same (address, cause id) may come back this many times
+ * before the handler decides it is not making progress.  A correct sequence
+ * needs at most two entries for one address (missing fill -> NWPERM replace),
+ * so 4 leaves room for a legitimate second visit and still catches a loop.
+ */
+#define DADAO_PF_RETRY_BUDGET	4
+
+/* -------------------------------------------------------------------------
+ * Page source and the shared zero page
+ * ------------------------------------------------------------------------- */
+
+static unsigned long dadao_pf_pages;	/* pages handed out so far */
+static unsigned long dadao_zero_pa;	/* the one shared zero page */
+
+/*
+ * One zeroed page the caller owns — `alloc_page(GFP_KERNEL | __GFP_ZERO)`.
+ *
+ * The handler runs with the buddy allocator up (it is only reachable from a
+ * task, and tasks exist only after mm_core_init()), so this is an ordinary
+ * allocation; 0 still means "no page", which the caller reports by name.
+ *
+ * Not `__GFP_HIGHMEM`/`GFP_ATOMIC`: a fault is allowed to sleep — taking the
+ * mmap read lock and the page fault itself are sleepable contexts — and there is
+ * no highmem on this machine (single 42-bit VA window, flat RAM).
+ */
+unsigned long dadao_pf_alloc_page(void)
+{
+	struct page *page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+
+	if (!page)
+		return 0;
+	dadao_pf_pages++;
+	return page_to_phys(page);
+}
+
+/*
+ * The shared zero page (user ruling 2026-11-16): allocated once, zeroed, never
+ * freed and never written again — every anonymous read mapping points at it, so
+ * a write must replace the mapping instead of touching the page.
+ *
+ * It has to exist before the first fault, so this is called from the K4 boot
+ * path once the allocator is up (kernel/setup.c: dadao_k4_boundary()), not from
+ * the fault path itself: `alloc_page()` there would grow the allocator's state
+ * from inside a fault, and the zero page must never be re-allocated.
+ */
+void __init dadao_pf_init(void)
+{
+	if (dadao_zero_pa)
+		return;
+	/*
+	 * The *canonical* zero page — the one `is_zero_pfn()` answers true for
+	 * (mm_init.c's `init_zero_page_pfn()` pins `zero_pfn` from
+	 * `ZERO_PAGE(0)`, i.e. this very page).  A privately allocated page
+	 * would look like ordinary data to the generic code, so `dup_mm()`
+	 * would copy it and COW would not know it may be shared (m14-linux-018).
+	 */
+	dadao_zero_pa = page_to_phys(ZERO_PAGE(0));
+}
+
+/* -------------------------------------------------------------------------
+ * Windows: the K3 stand-in for the VMA tree
+ * ------------------------------------------------------------------------- */
+
+static struct vm_area_struct dadao_pf_window[DADAO_PF_WINDOWS];
+static bool dadao_pf_window_used[DADAO_PF_WINDOWS];
+
+/*
+ * One anonymous window.  @backing_pa is what a *fetch* fault installs (the
+ * window's code page: demand paging of text needs a page whose content is
+ * already there), @superpage_pa the 512 MiB base a superpage-missing fault maps
+ * (`ISPTRAP`/`DSPTRAP` cannot be served page by page — the walker stopped at the
+ * first level).  Both are K3 backing choices; a file/anonymous mapping supplies
+ * the same information through vm_ops->fault in K4.
+ */
+struct vm_area_struct *dadao_pf_window_add(unsigned long start,
+					   unsigned long end,
+					   unsigned long vm_flags,
+					   unsigned long backing_pa,
+					   unsigned long superpage_pa)
+{
+	unsigned int i;
+
+	/* A window may start anywhere (a text mapping starts at the function, not
+	 * at a page boundary); only the order has to be sane. */
+	if (start >= end)
+		return NULL;
+	for (i = 0; i < DADAO_PF_WINDOWS; i++) {
+		struct vm_area_struct *vma = &dadao_pf_window[i];
+
+		if (dadao_pf_window_used[i])
+			continue;
+		memset(vma, 0, sizeof(*vma));
+		vm_flags_init(vma, vm_flags);
+		vma->vm_start = start;
+		vma->vm_end = end;
+		/* A probe window belongs to no mm: the probe path is the only
+		 * one that looks these up (see dadao_pf_find_vma()). */
+		vma->vm_mm = NULL;
+		vma->vm_page_prot = vm_get_page_prot(vm_flags);
+		vma->vm_private_data = (void *)backing_pa;
+		/* `vm_pgoff` is the superpage base for an `ISPTRAP`/`DSPTRAP`
+		 * fill; +1 so that base 0 (RAM starts at PA 0 on this machine)
+		 * stays distinguishable from "this window has no superpage". */
+		vma->vm_pgoff = superpage_pa == DADAO_PF_NO_SUPERPAGE ? 0 :
+				(superpage_pa >> PAGE_SHIFT) + 1;
+		dadao_pf_window_used[i] = true;
+		return vma;
+	}
+	return NULL;
+}
+
+/*
+ * The VMA covering @addr, or NULL.
+ *
+ * With an address space (K4: every task that has one) this is the generic
+ * `find_vma()` on `current->mm` — the handler's only source of "is this address
+ * part of something the process owns".  Without one (init_task, and the K3 probe
+ * images whose cases run before any process exists) the registered probe
+ * windows are the whole "address space"; that arm is test scaffolding, never a
+ * production path: it answers from a static array, exactly what a real task must
+ * not do.
+ *
+ * Exposed (asm/setup.h) so the probe can assert the window edges — the same
+ * question the handler asks, answered without taking a fault.
+ */
+struct vm_area_struct *dadao_pf_find_vma(unsigned long addr)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned int i;
+
+	if (mm) {
+		struct vm_area_struct *vma;
+
+		mmap_read_lock(mm);
+		vma = find_vma(mm, addr);
+		/* find_vma() returns the *next* VMA when @addr sits in a hole. */
+		if (vma && addr < vma->vm_start)
+			vma = NULL;
+		mmap_read_unlock(mm);
+		return vma;
+	}
+
+	for (i = 0; i < DADAO_PF_WINDOWS; i++) {
+		struct vm_area_struct *vma = &dadao_pf_window[i];
+
+		if (dadao_pf_window_used[i] && addr >= vma->vm_start &&
+		    addr < vma->vm_end)
+			return vma;
+	}
+	return NULL;
+}
+
+/* -------------------------------------------------------------------------
+ * Stack growth (VM_GROWSDOWN, m14-linux-019's S1-S6)
+ * ------------------------------------------------------------------------- */
+
+static unsigned long dadao_pf_grows;
+
+unsigned long dadao_pf_grow_count(void)
+{
+	return dadao_pf_grows;
+}
+
+/*
+ * A *missing*-class fault below a growable VMA: extend that VMA down to the
+ * faulting page and report it, or NULL when nothing may grow.
+ *
+ * The rules are Linux's own and are enforced inside `expand_downwards()`:
+ * `stack_guard_gap` against the previous VMA and `RLIMIT_STACK` through
+ * `acct_stack_growth()`.  This function only decides *whether* that is the right
+ * reading of the fault — a VMA with VM_GROWSDOWN, a hole below it, and an
+ * address space of its own (the K3 probe windows have none and never grow).
+ *
+ * Called for the missing class only: a permission fault must never become a new
+ * mapping (019 S5), which is why the caller tests the class before asking.
+ */
+static struct vm_area_struct *dadao_pf_grow_stack(unsigned long addr, bool count)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	int ret;
+
+	if (!mm)
+		return NULL;
+
+	mmap_write_lock(mm);
+	vma = find_vma(mm, addr);
+	if (!vma || addr >= vma->vm_start ||
+	    !(vma->vm_flags & VM_GROWSDOWN)) {
+		mmap_write_unlock(mm);
+		return NULL;
+	}
+	/*
+	 * `expand_stack_locked()` is the generic entry point (include/linux/mm.h);
+	 * on this port it is `expand_downwards()`, which enforces both rules and
+	 * asserts the mmap lock is held for writing — hence the lock above.
+	 */
+	ret = expand_stack_locked(vma, addr);
+	mmap_write_unlock(mm);
+	if (ret)
+		return NULL;
+	if (count)
+		dadao_pf_grows++;
+	return vma;
+}
+
+/* -------------------------------------------------------------------------
+ * Counters the probe asserts on
+ * ------------------------------------------------------------------------- */
+
+static unsigned long dadao_pf_entries;
+
+unsigned long dadao_pf_entry_count(void)
+{
+	return dadao_pf_entries;
+}
+
+unsigned long dadao_pf_alloc_count(void)
+{
+	return dadao_pf_pages;
+}
+
+unsigned long dadao_pf_zero_page_pa(void)
+{
+	return dadao_zero_pa;
+}
+
+/* -------------------------------------------------------------------------
+ * PTE construction (spec/DADAO-12 §2.2.3/§2.2.4, contract-tlb)
+ * ------------------------------------------------------------------------- */
+
+/* The fragment bit of @addr: SPF for a superpage (index VA[28:26]), GPF for a
+ * normal page (index VA[15:13]) — both live in the PTE's [15:8]. */
+static unsigned long dadao_pf_frag(unsigned long addr, bool superpage)
+{
+	unsigned int idx = superpage ? ((addr >> 26) & 0x7) : ((addr >> 13) & 0x7);
+
+	return 1UL << (_PAGE_FRAG_SHIFT + idx);
+}
+
+/*
+ * Kernel-window leaf: supervisor, global (single PTBR, the kernel's own
+ * mappings are reachable from every ASID), every fragment resident, and the
+ * permission the *fill* grants — not the VMA's whole set.  R/W/X are orthogonal
+ * on this machine (§2.2.5), so a private data page is R|W (never X) and a code
+ * page is R|X (never W).
+ */
+static unsigned long dadao_pf_mode_bits(struct vm_area_struct *vma)
+{
+	/*
+	 * Which run mode may reach the mapping (spec/DADAO-12 §2.2.6: the walker
+	 * checks the HSJU bit of the *accessing* mode; the hardware never lets
+	 * S override U — §2.2.5 "用户页/内核页的组合策略由操作系统决定").
+	 *
+	 * A VMA that belongs to an address space is a user task's mapping, and it
+	 * needs **both** bits from K4 on: U for the task itself, S for the kernel
+	 * servicing it — `write(2)` and `brk(2)` must read the user's buffer and
+	 * `copy_from_user()` walks the user VA, so a U-only page would turn every
+	 * syscall that takes a pointer into CFXPERM/NSPERM.  A probe window has no
+	 * mm and stays a kernel-only mapping (S).
+	 */
+	return vma && vma->vm_mm ? (_PAGE_U | _PAGE_S) : _PAGE_S;
+}
+
+static unsigned long dadao_pf_pte(struct vm_area_struct *vma, unsigned long pa,
+				  bool write, bool exec)
+{
+	unsigned long prot = _PAGE_PRESENT | dadao_pf_mode_bits(vma) |
+			     _PAGE_FRAG_ALL | _PAGE_READ;
+
+	if (write)
+		prot |= _PAGE_WRITE;
+	if (exec)
+		prot |= _PAGE_EXEC;
+	return (pa & _PAGE_PFN_MASK) | prot;
+}
+
+/* The shared zero page is read-only and non-executable: a write must fault.  It
+ * takes the VMA's mode bits for the same reason a data page does: a user read
+ * of an untouched anonymous page maps it for user mode. */
+static unsigned long dadao_pf_zero_pte(struct vm_area_struct *vma)
+{
+	return (dadao_zero_pa & _PAGE_PFN_MASK) | _PAGE_PRESENT |
+	       dadao_pf_mode_bits(vma) | _PAGE_FRAG_ALL | _PAGE_READ;
+}
+
+/* Do the mapping change and drop the stale translation.  A PTE store alone is
+ * not visible: the walker only fills on a miss and a hit does not re-read the
+ * PTE (contract-tlb TLB-11/TLB-07), and `invalid` is the one command that never
+ * writes A/D back over the PTE the handler just built (§4.5). */
+static void dadao_pf_publish(struct vm_area_struct *vma, unsigned long addr,
+			     pte_t *ptep)
+{
+	update_mmu_cache(vma, addr, ptep);
+	local_flush_tlb_page(vma, addr);
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	{
+		static int n;
+
+		if (n++ < 8)
+			dadao_early_printf("K4 pf pub: va=%#lx mm=%#lx mm_pgd=%#lx "
+					   "ptbr=%#lx asid=%lu mm_asid=%lu "
+					   "pte=%#lx\n", addr,
+					   (unsigned long)vma->vm_mm,
+					   __pa(vma->vm_mm->pgd),
+					   dadao_ptbr_read(),
+					   dadao_asid_read(),
+					   (unsigned long)vma->vm_mm->context.asid,
+					   pte_val(*ptep));
+	}
+#endif
+}
+
+/* -------------------------------------------------------------------------
+ * The channel
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Fill a missing page and report which branch did it.  Returns the result name,
+ * or NULL when the fault cannot be served (the caller then terminates by name).
+ */
+/*
+ * The table the walker reads for @addr: once `switch_mm()` has put the faulting
+ * task's own table in PTBR, that is where a fill has to land; before that (the
+ * K1-K4 shape, where PTBR is the kernel's table) and for a VMA that is not the
+ * running task's, the kernel table is the right one.
+ */
+static pmd_t *dadao_pf_table(struct mm_struct *mm, unsigned long addr)
+{
+	if (mm && mm == current->mm && mm->pgd &&
+	    __pa(mm->pgd) == dadao_ptbr_read())
+		return pmd_off(mm, addr);
+	return pmd_off_k(addr);
+}
+
+static const char *dadao_pf_fill(struct vm_area_struct *vma, unsigned long addr,
+				 unsigned int pos)
+{
+	bool fetch = dadao_subcause_is_fetch(pos);
+
+	/*
+	 * Which table this fault belongs to: the *VMA's* address space.  A user
+	 * VMA lives in the process's own table, which is also what PTBR points
+	 * at once `switch_mm()` has run — writing the L2/PTE into the kernel's
+	 * table instead would leave the walker looking at an empty slot forever
+	 * (measured: `fill-zero` then the same fault again, `l1 = 0` through
+	 * PTBR while the channel's own `pmd_off_k` copy was present).  A probe
+	 * window (`vm_mm == NULL`) is a kernel window and keeps the kernel
+	 * table, which is the K1-K4 shape this channel was built on.
+	 */
+	struct mm_struct *mm = vma->vm_mm;
+	pmd_t *pmd = dadao_pf_table(mm, addr);
+	unsigned long entry = pmd_val(*pmd);
+	pte_t *ptep;
+	unsigned long pa;
+
+	/*
+	 * A superpage state is decided by the L1 entry alone: present with a
+	 * fragment bit clear (SPF, §2.2.3), or absent as a superpage
+	 * (`ISPTRAP`/`DSPTRAP`, §2.2.6 step 2).
+	 */
+	if (entry & _PAGE_SUPER) {
+		if (!(entry & _PAGE_PRESENT)) {
+			unsigned long base;
+
+			if (!vma->vm_pgoff)
+				return NULL;
+			base = (vma->vm_pgoff - 1) << PAGE_SHIFT;
+			if (base & ~SUPERPAGE_MASK)
+				return NULL;
+			entry = (base & SUPERPAGE_PA_MASK) | _PAGE_SUPER |
+				_PAGE_PRESENT | _PAGE_S | _PAGE_GLOBAL |
+				_PAGE_FRAG_ALL | _PAGE_READ;
+			/* A superpage is coarse: the VMA's own rights decide. */
+			if (vma->vm_flags & VM_WRITE)
+				entry |= _PAGE_WRITE;
+			if (vma->vm_flags & VM_EXEC)
+				entry |= _PAGE_EXEC;
+			set_pmd(pmd, __pmd(entry));
+			dadao_pf_publish(vma, addr, NULL);
+			return "fill-super";
+		}
+		if (!(entry & dadao_pf_frag(addr, true))) {
+			set_pmd(pmd, __pmd(entry | dadao_pf_frag(addr, true)));
+			dadao_pf_publish(vma, addr, NULL);
+			return "frag-set";
+		}
+		/* Present and complete, yet reported missing: not this channel. */
+		return NULL;
+	}
+
+	if (pmd_none(*pmd)) {
+		/* IGPTRAP/DGPTRAP at the first level: the page's second-level
+		 * table does not exist yet (§2.2.2 step 3: L1 P = 0, SP = 0). */
+		pa = dadao_pf_alloc_page();
+		if (!pa)
+			return NULL;
+		pmd_populate_kernel(mm ? mm : &init_mm, pmd,
+				    (pte_t *)__va(pa));
+	}
+
+	ptep = pte_offset_kernel(pmd, addr);
+	entry = pte_val(*ptep);
+	if (entry & _PAGE_PRESENT) {
+		if (!(entry & dadao_pf_frag(addr, false))) {
+			set_pte(ptep, __pte(entry | dadao_pf_frag(addr, false)));
+			dadao_pf_publish(vma, addr, ptep);
+			return "frag-set";
+		}
+		return NULL;
+	}
+
+	if (fetch) {
+		/* The faulting access was an instruction fetch ("I" prefix):
+		 * the page must become executable and its content has to be the
+		 * window's code page.
+		 *
+		 * A *file-backed* text VMA (what `execve` builds: `elf_map()` maps
+		 * the ELF segment with `vm_file` + `vm_pgoff`) has no
+		 * `vm_private_data`; its content is read from the file on demand —
+		 * the same page the loader would have brought in, without a page
+		 * cache.  A probe window keeps the single-page `vm_private_data`
+		 * form. */
+		/*
+		 * Content for a probe window comes from `vm_private_data`; a
+		 * *process* VMA never comes through here any more (its pages are
+		 * the page cache's, m14-linux-035).  With no page there is
+		 * nothing to install — refuse instead of mapping PA 0.
+		 */
+		pa = (unsigned long)vma->vm_private_data;
+		if (!pa)
+			return NULL;
+		set_pte(ptep, __pte(dadao_pf_pte(vma, pa, false, true)));
+		dadao_pf_publish(vma, addr, ptep);
+		return "fill-code";
+	}
+
+	/* Data (read or write): map the shared zero page read-only.  A store
+	 * faults again with CFXPERM + NWPERM and is turned private there. */
+	if (!dadao_zero_pa)
+		return NULL;
+	set_pte(ptep, __pte(dadao_pf_zero_pte(vma)));
+	dadao_pf_publish(vma, addr, ptep);
+	return "fill-zero";
+}
+
+/* The leaf PTE for @addr, or NULL when no second-level table exists. */
+/* The PTE of @addr (the kernel table; see the note in dadao_pf_fill()). */
+static pte_t *dadao_pf_ptep(struct vm_area_struct *vma, unsigned long addr)
+{
+	pmd_t *pmd = dadao_pf_table(vma->vm_mm, addr);
+
+	if (pmd_none(*pmd) || (pmd_val(*pmd) & _PAGE_SUPER))
+		return NULL;
+	return pte_offset_kernel(pmd, addr);
+}
+
+/*
+ * A write to a *probe window* that points at the shared zero page: give it a
+ * private zeroed page.  This is *not* a copy-on-write of the zero page — the
+ * source is all zero, so copying a page would be pure waste (user ruling
+ * 2026-11-16).  A process VMA never comes here: the generic arm's
+ * `do_wp_page()` already knows the zero page (m14-linux-035).
+ */
+static bool dadao_pf_unshare_zero(struct vm_area_struct *vma, unsigned long addr)
+{
+	pte_t *ptep = dadao_pf_ptep(vma, addr);
+	unsigned long pa;
+
+	if (!ptep || !dadao_zero_pa || !(vma->vm_flags & VM_WRITE)) {
+#if CONFIG_DADAO_K4_STACK_SELFTEST
+		dadao_early_printf("K4 stack unshare: refuse ptep=%#lx zero=%#lx "
+				   "flags=%#lx va=%#lx\n",
+				   (unsigned long)ptep, dadao_zero_pa,
+				   vma->vm_flags, addr);
+#endif
+		return false;
+	}
+	if ((pte_val(*ptep) & _PAGE_PFN_MASK) == (dadao_zero_pa & _PAGE_PFN_MASK)) {
+		/* The zero page: nothing to copy (user ruling 2026-11-16). */
+		pa = dadao_pf_alloc_page();
+		if (!pa)
+			return false;
+		set_pte(ptep, __pte(dadao_pf_pte(vma, pa, true, false)));
+		dadao_pf_publish(vma, addr, ptep);
+		return true;
+	}
+
+	/* Any other read-only page has content, so it is not this window helper's
+	 * business: there is no folio here to copy or to account for. */
+	return false;
+}
+
+/* -------------------------------------------------------------------------
+ * Entry
+ * ------------------------------------------------------------------------- */
+
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+/* The last page fault's verdict, in numbers (see the entry below). */
+unsigned long dadao_pf_last[8];
+unsigned long dadao_pf_last_res;
+
+/*
+ * F27 probe: read the table the *walker* uses (through PTBR) and the table the
+ * channel uses (`current->mm->pgd`), as raw 64-bit words, for one user VA.
+ */
+static void k4s_pf_dump(unsigned long va)
+{
+	static int n;
+	unsigned long ptbr = dadao_ptbr_read();
+	unsigned long mm_pgd = current->mm ? __pa(current->mm->pgd) : 0;
+	unsigned long l1, l1m, l2pa, l2pam, l2e = 0, l2em = 0;
+	unsigned long l1i = ((va >> 29) & (PTRS_PER_PGD - 1)) * 8;
+	unsigned long l2i = ((va >> PAGE_SHIFT) & (PTRS_PER_PTE - 1)) * 8;
+
+	if (n++ >= 6)
+		return;
+
+	l1 = ptbr ? *(unsigned long *)__va(ptbr + l1i) : 0;
+	l1m = mm_pgd ? *(unsigned long *)__va(mm_pgd + l1i) : 0;
+	l2pa = l1 & _PAGE_PFN_MASK;
+	l2pam = l1m & _PAGE_PFN_MASK;
+	if (l2pa && (l1 & _PAGE_PRESENT))
+		l2e = *(unsigned long *)__va(l2pa + l2i);
+	if (l2pam && (l1m & _PAGE_PRESENT))
+		l2em = *(unsigned long *)__va(l2pam + l2i);
+
+	dadao_early_printf("K4 pf raw: va=%#lx ptbr=%#lx l1=%#lx l2pa=%#lx "
+			   "l2e=%#lx | mm_pgd=%#lx l1m=%#lx l2pam=%#lx l2em=%#lx "
+			   "l1i=%#lx l2i=%#lx\n", va, ptbr, l1, l2pa, l2e, mm_pgd,
+			   l1m, l2pam, l2em, l1i, l2i);
+}
+#else
+static inline void k4s_pf_dump(unsigned long va) { }
+#endif
+
+/* Same (address, id) this many times in a row: the handler is not making
+ * progress.  Reported, not ignored — an injected "retry without installing"
+ * must end the boot instead of spinning (task rule). */
+static unsigned long dadao_pf_last_va;
+static unsigned long dadao_pf_last_cause;
+static unsigned long dadao_pf_streak;
+
+/* The leaf value the walker would see for @addr (the L2 PTE when it exists,
+ * otherwise the L1 entry itself), for the one-line report only. */
+static unsigned long dadao_pf_show_pte(unsigned long addr)
+{
+	pmd_t *pmd = pmd_off_k(addr);
+
+	if (pmd_none(*pmd) || (pmd_val(*pmd) & _PAGE_SUPER))
+		return pmd_val(*pmd);
+	return pte_val(*pte_offset_kernel(pmd, addr));
+}
+
+/* -------------------------------------------------------------------------
+ * The generic arm (m14-linux-035): a fault on the running processes's own
+ * address space is resolved by mm/, like any other architecture
+ * ------------------------------------------------------------------------- */
+
+/*
+ * Copy-on-write reporting (the probe surface of m14-linux-018, kept when the
+ * write half moved to the generic `do_wp_page()`).
+ *
+ * The values are *measurements* of what the generic path did: the PTE before
+ * and after the fault, and the page's reference count around it.  Nothing here
+ * decides anything — a wrong PTE or a wrong count is what the probe then fails
+ * on.
+ */
+unsigned long dadao_cow_stats[DADAO_COW_NR_STATS];
+unsigned long dadao_cow_last_flush[4];
+unsigned long dadao_cow_last_page[4];
+
+/* The leaf PTE of @addr in @mm, or 0 when there is no table / no entry. */
+static unsigned long dadao_pf_peek(struct mm_struct *mm, unsigned long addr)
+{
+	pmd_t *pmd;
+
+	if (!mm || !mm->pgd)
+		return 0;
+	pmd = pmd_off(mm, addr);
+	if (pmd_none(*pmd) || (pmd_val(*pmd) & _PAGE_SUPER))
+		return 0;
+	return pte_val(*pte_offset_kernel(pmd, addr));
+}
+
+/*
+ * The VMA's own verdict on a *permission*-class fault — the check that must not
+ * be left to `handle_mm_fault()`.
+ *
+ * DADAO reports "write of a page with W = 0" as CFXPERM + NWPERM whether the
+ * mapping is meant to be writable or not (spec/DADAO-12 §2.2.6), so the class
+ * alone does not say "copy-on-write"; only the VMA does.  Letting a genuine
+ * violation through would not even fail loudly: `do_wp_page()` would copy,
+ * `maybe_mkwrite()` would leave the PTE read-only because the VMA is not
+ * writable (mm/memory.c), and the retried store would fault again for ever.
+ *
+ * Missing-class faults are not checked here: whether the page may be mapped at
+ * all is the generic code's decision (`vma_is_accessible()` + `vm_flags`).
+ */
+static bool dadao_pf_vma_perm_denied(unsigned int pos, struct vm_area_struct *vma)
+{
+	if (!dadao_subcause_is_perm(pos))
+		return false;
+	if (!vma_is_accessible(vma))
+		return true;
+	switch (pos) {
+	case DADAO_SUB_NWPERM:
+		return !(vma->vm_flags & VM_WRITE);
+	case DADAO_SUB_NXPERM:
+		return !(vma->vm_flags & VM_EXEC);
+	default:
+		/* NUPERM/NJPERM/NSPERM/NHPERM/NRPERM/NCFXPERM: no generic
+		 * reading can make a page reachable here. */
+		return true;
+	}
+}
+
+/* Fault flags from the sub-reason (contract-see §6.1.1: the class does not say
+ * read or write, the sub-reason does). */
+static unsigned int dadao_pf_flags(unsigned int pos, bool from_user)
+{
+	unsigned int flags = FAULT_FLAG_ALLOW_RETRY | FAULT_FLAG_KILLABLE;
+
+	if (from_user)
+		flags |= FAULT_FLAG_USER;
+	if (pos == DADAO_SUB_NWPERM)
+		flags |= FAULT_FLAG_WRITE;
+	if (dadao_subcause_is_fetch(pos))
+		flags |= FAULT_FLAG_INSTRUCTION;
+	return flags;
+}
+
+/*
+ * Serve one fault of the running process through the generic page-fault path.
+ * Returns the name of what was done (`fill-*`, `replace-zero`, `cow-*` — the
+ * caller re-executes the instruction for those) or the named verdict
+ * (`die-*`) when it cannot be served.
+ *
+ * The mmap lock, the VMA lookup, stack growth, the page source (anonymous
+ * pages with rmap + LRU, file pages through the page cache) and COW are all
+ * generic now; what stays here is the machine's half of the interface: which
+ * sub-reason means what, the VMA permission gate above, and the one-line report.
+ */
+/*
+ * Is @mm the address space the *walker* is using?  A fault on a process VMA is
+ * only resolved through mm/ when it is (m14-linux-035): `handle_mm_fault()`
+ * fills `mm->pgd`, and a fill into a table the walker is not using would be
+ * invisible — the K1-K4 probe shape runs user code on the kernel's table with
+ * `current->mm` merely attached, and `dadao_pf_table()` (the window arm) is what
+ * selects the table there.
+ */
+static bool dadao_pf_mm_active(struct mm_struct *mm)
+{
+	return mm && mm->pgd && __pa(mm->pgd) == dadao_ptbr_read();
+}
+
+static const char *dadao_pf_generic(struct pt_regs *regs, unsigned int pos,
+				    unsigned long addr, bool from_user,
+				    unsigned long *rep_start,
+				    unsigned long *rep_end, unsigned long *rep_pte)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	vm_fault_t fault;
+	unsigned int flags = dadao_pf_flags(pos, from_user);
+	const bool is_write = (pos == DADAO_SUB_NWPERM);
+	unsigned long old_pte, new_pte = 0, old_pa = 0, new_pa = 0;
+	unsigned int refs_before = 0, refs_after = 0;
+	struct page *old_page = NULL, *new_page = NULL;
+	bool will_grow = false;
+	int attempt;
+
+	/*
+	 * A user superpage has no generic representation: generic code reads the
+	 * L1 entry as a page-table pointer (`pmd_page_vaddr()`), which is only
+	 * right for the non-leaf form (spec/DADAO-12 §2.2.3).  This port never
+	 * creates one for a process, so it is a named refusal rather than a
+	 * silent misinterpretation.
+	 */
+	if (pmd_leaf(*pmd_off(mm, addr)))
+		return "die-super";
+
+	for (attempt = 0; attempt < 3; attempt++) {
+#if CONFIG_DADAO_K4_STACK_SELFTEST
+		/*
+		 * The probe reads "did this fault grow the stack" as a counter
+		 * (S1/S2/S5/S6).  The growth itself is generic; the counter is
+		 * derived here, and only for the probe image: the condition is
+		 * the same one the growth path uses ("the VMA found for @addr
+		 * starts above it and is growable"), and it is accounted as a
+		 * growth only if the fault was then served.
+		 */
+		{
+			struct vm_area_struct *gv;
+
+			mmap_read_lock(mm);
+			gv = find_vma(mm, addr);
+			will_grow |= gv && addr < gv->vm_start &&
+				    (gv->vm_flags & VM_GROWSDOWN);
+			mmap_read_unlock(mm);
+		}
+#endif
+
+		/*
+		 * `lock_mm_and_find_vma()` takes the mmap lock (read, upgraded
+		 * for a stack expansion) and drops it again when it fails; on
+		 * success the lock is held and must be released here.
+		 */
+		vma = lock_mm_and_find_vma(mm, addr, regs);
+		if (!vma) {
+			/*
+			 * Two reasons the helper can fail although a process VMA
+			 * exists, both from this port's gaps and neither a
+			 * verdict:
+			 *
+			 *  - a stack expansion: our uaccess has no exception
+			 *    tables (CONFIG_UACCESS_MEMCPY) and `user_mode()`
+			 *    has no frame bit yet, so the helper's upgrade path
+			 *    cannot be used.  Do the expansion with the same
+			 *    generic call it would have made, then let the
+			 *    helper find the (now covering) VMA.
+			 *  - mmap-lock contention: the helper reports "no VMA"
+			 *    when it cannot take the lock.  Re-do the lookup
+			 *    under a plain read lock, which is what it would
+			 *    have done with the lock free.
+			 */
+			if (dadao_subcause_is_missing(pos) &&
+			    dadao_pf_grow_stack(addr, false))
+				continue;
+			mmap_read_lock(mm);
+			vma = find_vma(mm, addr);
+			if (vma && addr < vma->vm_start)
+				vma = NULL;
+			if (!vma) {
+				mmap_read_unlock(mm);
+				return "die-no-vma";
+			}
+			/* the lock is held from here, exactly like the
+			 * helper's success path */
+		}
+
+		*rep_start = vma->vm_start;
+		*rep_end = vma->vm_end;
+
+		if (dadao_pf_vma_perm_denied(pos, vma)) {
+			if (is_write)
+				dadao_cow_stats[DADAO_COW_REFUSED]++;
+			mmap_read_unlock(mm);
+			return "die-perm";
+		}
+
+			old_pte = dadao_pf_peek(mm, addr);
+		if (pte_present(__pte(old_pte))) {
+			old_pa = old_pte & _PAGE_PFN_MASK;
+			if (!is_zero_pfn(old_pa >> PAGE_SHIFT)) {
+				old_page = pfn_to_page(old_pa >> PAGE_SHIFT);
+				refs_before = page_count(old_page);
+			}
+		}
+
+		fault = handle_mm_fault(vma, addr, flags, regs);
+
+		if (fault & VM_FAULT_RETRY) {
+			/* The lock was dropped for us; redo the lookup. */
+			flags |= FAULT_FLAG_TRIED;
+			continue;
+		}
+		if (fault & VM_FAULT_ERROR) {
+			mmap_read_unlock(mm);
+			return (fault & VM_FAULT_OOM) ? "die-oom" : "die-fault";
+		}
+		if (fault & VM_FAULT_NOPAGE) {
+			/* "Present but I made no progress": never retried here —
+			 * the fault would come back for ever (mm/gup.c's retry
+			 * loop is the same trap). */
+			mmap_read_unlock(mm);
+			return "die-nopage";
+		}
+
+		new_pte = dadao_pf_peek(mm, addr);
+		mmap_read_unlock(mm);
+		*rep_pte = new_pte;
+#if CONFIG_DADAO_K4_STACK_SELFTEST
+		if (will_grow)
+			dadao_pf_grows++;
+#endif
+		break;
+	}
+	if (attempt == 3)
+		return "die-retry";
+
+	if (!pte_present(__pte(new_pte)))
+		return "die-no-pte";
+	new_pa = new_pte & _PAGE_PFN_MASK;
+	if (is_zero_pfn(new_pa >> PAGE_SHIFT))
+		new_page = NULL;
+	else
+		new_page = pfn_to_page(new_pa >> PAGE_SHIFT);
+
+	/* ---- what just happened (reporting + the probe's counters) -------- */
+	if (is_write) {
+		if (old_pa && is_zero_pfn(old_pa >> PAGE_SHIFT)) {
+			/* the shared zero page: nothing to copy, a private
+			 * zeroed page replaces it (m14-linux-012's rule) */
+			return "replace-zero";
+		}
+		if (new_pa == old_pa) {
+			dadao_cow_stats[DADAO_COW_INPLACE]++;
+			dadao_cow_last_page[0] = old_pa;
+			dadao_cow_last_page[1] = new_pa;
+			dadao_cow_last_page[2] = refs_before;
+			dadao_cow_last_page[3] = refs_before;
+#if CONFIG_DADAO_K4_COW_SELFTEST
+			dadao_early_printf("K4 cow: kind=in-place va=%#lx "
+					   "page=%lu old_pa=%#lx new_pa=%#lx "
+					   "count=%lu after=%lu ctrl=%#lx "
+					   "asid=%lu any=%lu copies=%lu "
+					   "inplace=%lu puts=%lu\n", addr,
+					   (unsigned long)PAGE_SIZE, old_pa,
+					   new_pa, refs_before, refs_before,
+					   dadao_cow_last_flush[0],
+					   dadao_cow_last_flush[1],
+					   dadao_cow_last_flush[2],
+					   dadao_cow_stats[DADAO_COW_COPY],
+					   dadao_cow_stats[DADAO_COW_INPLACE],
+					   dadao_cow_stats[DADAO_COW_PUT]);
+#endif
+			return "cow-write";
+		}
+		refs_after = new_page ? page_count(new_page) : 0;
+		if (old_page)
+			refs_after = page_count(old_page);
+		dadao_cow_stats[DADAO_COW_COPY]++;
+		dadao_cow_stats[DADAO_COW_PUT]++;
+		dadao_cow_last_page[0] = old_pa;
+		dadao_cow_last_page[1] = new_pa;
+		dadao_cow_last_page[2] = refs_before;
+		dadao_cow_last_page[3] = refs_after;
+#if CONFIG_DADAO_K4_COW_SELFTEST
+		dadao_early_printf("K4 cow: kind=copy va=%#lx page=%lu old_pa=%#lx "
+				   "new_pa=%#lx count=%lu after=%lu ctrl=%#lx "
+				   "asid=%lu any=%lu copies=%lu inplace=%lu "
+				   "puts=%lu\n", addr, (unsigned long)PAGE_SIZE,
+				   old_pa, new_pa, refs_before, refs_after,
+				   dadao_cow_last_flush[0],
+				   dadao_cow_last_flush[1],
+				   dadao_cow_last_flush[2],
+				   dadao_cow_stats[DADAO_COW_COPY],
+				   dadao_cow_stats[DADAO_COW_INPLACE],
+				   dadao_cow_stats[DADAO_COW_PUT]);
+#endif
+		return "cow-copy";
+	}
+
+	if (dadao_subcause_is_fetch(pos))
+		return "fill-code";
+	if (is_zero_pfn(new_pa >> PAGE_SHIFT))
+		return "fill-zero";
+	if (vma->vm_file)
+		return "fill-file";
+	return "fill-anon";
+}
+
+/*
+ * One page-fault entry.  kernel/traps.c calls this for CFXMEM and CFXPERM only,
+ * after the class has been named and the sub-reason shape checked; the id is
+ * passed raw so this file owns the sub-reason decoding (asm/cause-sub.h).
+ */
+unsigned long dadao_do_page_fault(struct pt_regs *regs, unsigned long cause,
+				  unsigned long info, bool from_user)
+{
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	k4s_pf_dump(info);
+#endif
+
+	unsigned int pos = dadao_subcause_pos(cause);
+	struct vm_area_struct *vma = NULL;
+	const char *result = NULL;
+	unsigned long policy = DADAO_PF_FATAL;
+	/* What the one-line report prints (`vma` is not valid after the mmap
+	 * lock is dropped, so the generic arm hands the numbers over). */
+	unsigned long rep_start = 0, rep_end = 0, rep_pte = 0;
+
+	dadao_pf_entries++;
+
+	if (info == dadao_pf_last_va && cause == dadao_pf_last_cause) {
+		dadao_pf_streak++;
+	} else {
+		dadao_pf_last_va = info;
+		dadao_pf_last_cause = cause;
+		dadao_pf_streak = 1;
+	}
+
+	/*
+	 * ADWBFAIL and NONPTW are checked *before* the window lookup: their
+	 * `cause_info` is not a virtual address the walker rejected but the PTE's
+	 * physical address (contract-see §6.1) or a cfx-space address, so there is
+	 * no window to look up and nothing a fill could make accessible.
+	 *
+	 * A fault of the running process goes to the generic arm (m14-linux-035);
+	 * the window arm below is what is left for an address space that is not a
+	 * task's — the K3 probe images run with `current->mm == NULL` (they are
+	 * registered windows + hand-built tables, spec/DADAO-12 §2.2.3/§2.2.4).
+	 */
+	if (dadao_pf_streak > DADAO_PF_RETRY_BUDGET) {
+		result = "die-budget";
+	} else if (pos == DADAO_SUB_ADWBFAIL) {
+		result = "die-adwb";
+	} else if (pos == DADAO_SUB_NONPTW) {
+		result = "die-nonptw";
+	} else if (dadao_pf_mm_active(current->mm)) {
+		result = dadao_pf_generic(regs, pos, info, from_user, &rep_start,
+					  &rep_end, &rep_pte);
+	} else if (!(vma = dadao_pf_find_vma(info))) {
+		/*
+		 * The one way a hole becomes a window: a missing-class fault
+		 * below a VM_GROWSDOWN VMA grows the stack (m14-linux-019).
+		 */
+		if (dadao_subcause_is_missing(pos) &&
+		    (vma = dadao_pf_grow_stack(info, true)))
+			result = dadao_pf_fill(vma, info, pos);
+		else
+			result = "die-no-vma";
+		if (!result)
+			result = "die-missing";
+	} else if (!dadao_zero_pa) {
+		result = "die-uninit";	/* dadao_pf_init() never ran */
+	} else if (dadao_subcause_is_perm(pos)) {
+		/*
+		 * A write to the shared zero page is the one permission-class fault
+		 * that is not a verdict: the PTE is read-only *because* the mapping
+		 * is shared, so the handler gives the writer its own page.
+		 *
+		 * A *process* VMA never reaches this arm any more: its writes are
+		 * resolved by the generic `do_wp_page()` through the generic arm
+		 * above (copy when shared, upgrade in place when it is the only
+		 * reference).  A probe window has no address space and no folio
+		 * behind it, so a non-zero read-only page there is a verdict.
+		 */
+		if (pos == DADAO_SUB_NWPERM && dadao_pf_unshare_zero(vma, info))
+			result = "replace-zero";
+		else
+			result = "die-perm";
+	} else if (dadao_subcause_is_missing(pos)) {
+		result = dadao_pf_fill(vma, info, pos);
+		if (!result)
+			result = "die-missing";
+	} else {
+		result = "die-sub";
+	}
+	if (!current->mm) {
+		rep_start = vma ? vma->vm_start : 0UL;
+		rep_end = vma ? vma->vm_end : 0UL;
+		rep_pte = vma ? dadao_pf_show_pte(info) : 0UL;
+	}
+
+	/*
+	 * The names that mean "a mapping was installed, re-execute": the window
+	 * arm's and the generic arm's (`fill-anon`/`cow-*` are the generic
+	 * path's; the window arm has no folio to copy, so it cannot spell those).
+	 */
+	if (!strcmp(result, "fill-zero") || !strcmp(result, "fill-code") ||
+	    !strcmp(result, "fill-file") || !strcmp(result, "fill-anon") ||
+	    !strcmp(result, "fill-super") || !strcmp(result, "frag-set") ||
+	    !strcmp(result, "replace-zero") || !strcmp(result, "cow-copy") ||
+	    !strcmp(result, "cow-write"))
+		policy = DADAO_PF_RETRY;
+
+#ifdef CONFIG_DADAO_K4_SWITCH_SELFTEST
+	dadao_flog_last[0] = dadao_pf_entries;
+	dadao_flog_last[1] = cause;
+	dadao_flog_last[2] = info;
+	dadao_flog_last[3] = dadao_ptbr_read();
+	/*
+	 * The verdict in numbers (probe image only): the textual "K3 pf:" line
+	 * cannot be printed from inside the frame, and the strings are what the
+	 * next diagnosis needs.  Codes follow the order of the result chain.
+	 */
+	{
+		static const char *const res[] = {
+			"none", "fill-zero", "fill-code", "fill-super",
+			"frag-set", "replace-zero", "die-perm",
+			"die-missing", "die-sub", "cow-copy", "cow-write",
+		};
+		unsigned long i;
+
+		dadao_pf_last[0] = pos;
+		dadao_pf_last[1] = policy;
+		dadao_pf_last[2] = regs ? regs->ip : 0UL;
+		dadao_pf_last[3] = vma ? vma->vm_start : 0UL;
+		dadao_pf_last[4] = vma ? vma->vm_end : 0UL;
+		dadao_pf_last[5] = vma ? dadao_pf_show_pte(info) : 0UL;
+		dadao_pf_last[6] = vma ? vma->vm_flags : 0UL;
+		dadao_pf_last[7] = vma ? (unsigned long)vma->vm_private_data : 0UL;
+		extern unsigned long dadao_pf_last_res;
+		dadao_pf_last_res = 0;
+		for (i = 1; i < ARRAY_SIZE(res); i++) {
+			if (!strcmp(result, res[i])) {
+				dadao_pf_last_res = i;
+				break;
+			}
+		}
+	}
+#endif
+	dadao_early_printf("K3 pf: n=%lu id=%#lx cause=%s sub=%s ip=%#lx va=%#lx "
+			   "vma=%#lx-%#lx pte=%#lx pool=%lu try=%lu result=%s\n",
+			   dadao_pf_entries, cause,
+			   dadao_cause_name(cause) ?: "unknown",
+			   dadao_subcause_name(pos) ?: "none",
+			   regs ? regs->ip : 0UL, info, rep_start, rep_end,
+			   rep_pte,
+			   dadao_pf_pages,
+			   dadao_pf_streak, result);
+	return policy;
+}
