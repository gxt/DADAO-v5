diff --git a/arch/dadao/kstat.h b/arch/dadao/kstat.h
new file mode 100644
index 0000000..ad61251
--- /dev/null
+++ b/arch/dadao/kstat.h
@@ -0,0 +1,38 @@
+/*
+ * DADAO kernel `struct kstat`.
+ *
+ * This is the asm-generic 64-bit kernel stat layout, byte for byte the same as
+ * arch/riscv64/kstat.h.  That is not an arbitrary choice of a "similar arch":
+ * v5's syscall numbers are the RISC-V/asm-generic ones (ADR-0025 D1,
+ * .tao/contracts/contract-syscall.md §1.1/§1.2), so the kernel objects that
+ * those numbers exchange are the asm-generic ones too.  The userspace
+ * <sys/stat.h> mirror of this layout is arch/generic/bits/stat.h, which is why
+ * arch/dadao/bits/alltypes.h.in narrows blksize_t/nlink_t to int/unsigned int
+ * exactly as riscv64 does (32-bit st_blksize / st_nlink in the object).
+ *
+ * Consumed by src/stat/*.c and src/mman/*.c to translate between the kernel
+ * object and struct stat.  P1 adds no stat service; this file exists so those
+ * sources compile and so a future service has one agreed layout to write.
+ */
+
+struct kstat {
+	dev_t st_dev;
+	ino_t st_ino;
+	mode_t st_mode;
+	nlink_t st_nlink;
+	uid_t st_uid;
+	gid_t st_gid;
+	dev_t st_rdev;
+	unsigned long __pad;
+	off_t st_size;
+	blksize_t st_blksize;
+	int __pad2;
+	blkcnt_t st_blocks;
+	long st_atime_sec;
+	long st_atime_nsec;
+	long st_mtime_sec;
+	long st_mtime_nsec;
+	long st_ctime_sec;
+	long st_ctime_nsec;
+	unsigned __unused[2];
+};
