+	case SYS_ioctl:  /* ioctl(int, int, ...): the variadic arg is a pointer for every pointer-taking command (TIOCGWINSZ, FIONREAD, ...) */	/*  unsigned int,  fd,  unsigned int,  cmd,  unsigned long,  arg */
