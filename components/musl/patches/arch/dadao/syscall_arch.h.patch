diff --git a/arch/dadao/syscall_arch.h b/arch/dadao/syscall_arch.h
new file mode 100644
index 0000000..3b7b353
--- /dev/null
+++ b/arch/dadao/syscall_arch.h
@@ -0,0 +1,179 @@
+/*
+ * DADAO syscall entry/driver for musl.
+ *
+ * ---------------------------------------------------------------------------
+ * The contract this implements (quoting, not paraphrasing)
+ * ---------------------------------------------------------------------------
+ * .tao/contracts/contract-syscall.md:
+ *   §1.1  "syscall 号存放在 rd15，沿用 RISC-V Linux 编号"  (ADR-0025 D1)
+ *   §2    "trap cfxha, immu18 发起"; dispatch entry umon (cfx0) with
+ *         immu18 = 0 (SBI_UMON_SYSCALL); "入参 rd15 = nr、出参 rd8 = result";
+ *         the callee resumes on the instruction after the trap.
+ *   §3    "返回值 = rd8"; argument registers "rd16-rd31 (data), rb16-rb31
+ *         (address), rf16-rf31 (float); 三组各自独立计数、自 16 起，参数按类型
+ *         分配到对应组"; worked example: read(int fd, void *buf, size_t count)
+ *         => fd -> rd16, buf -> rb16, count -> rd17.
+ *   §4    errno = negative rd8 ("A：rd8 负值（推荐）", user ruling 2026-10-14)
+ *         so musl's __syscall_ret() needs no change at all (it already
+ *         interprets `r > -4096UL` as an error).
+ *
+ * The assembler form is `trap cfx_umon, 0` (immu18[17:16] != 2'b11, so it is
+ * NOT the semihosting tag) -- the same spelling tests/scripts/bootrom.S uses
+ * for the hypv->user hand-off; QEMU's dadao-m1 machine serves it for user mode
+ * (INFRA-082t stage A1) and resumes at pc+4.
+ *
+ * All six integer/pointer argument positions are filled for every width so no
+ * register is left holding a stale value from an earlier call; slots a syscall
+ * does not use are simply never read by the service.
+ *
+ * ---------------------------------------------------------------------------
+ * The one non-obvious part: WHERE the arguments go
+ * ---------------------------------------------------------------------------
+ * §3 assigns arguments to banks BY TYPE, and musl hands this stub plain
+ * `long`s (syscall_arg_t) -- by the time __syscallN() runs, the pointer-ness
+ * of an argument is gone.  It is therefore recovered from the syscall NUMBER by
+ * __dadao_argmask() below, and the values are routed to rd16+n / rb16+n exactly
+ * as the example in §3 requires (the two banks are counted independently).
+ *
+ * This table is NOT a free choice.  It must agree slot-for-slot with whoever
+ * consumes the call -- QEMU's dadao-m1 umon handler today, a linux-user target
+ * later.  Its entries come from the Linux prototypes whose numbers v5 adopts
+ * (§1), and every entry is listed with its prototype so a reviewer can check
+ * it:
+ *
+ * INVARIANT (registered in the INFRA-082t task book): adding a service on the
+ * service side REQUIRES adding its number here in the same change, and vice
+ * versa.  A number that is absent gets mask 0 (all arguments in the RD bank).
+ * Today that is provably harmless -- the service side answers every number it
+ * does not implement with -ENOSYS (stage A1), so an unlisted number can never
+ * be acted upon with wrongly-placed arguments; the moment a number IS served,
+ * the pair must be updated together.
+ */
+
+#include <sys/syscall.h>
+
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+/*
+ * Pointer-argument mask: bit i set <=> argument i is a pointer (and therefore
+ * belongs in the RB bank).  Only the patterns the P1 static set and the stage
+ * A1 service set need are enumerated; see the invariant above.
+ */
+static inline int __dadao_argmask(long nr)
+{
+	switch (nr) {
+	/* (int, <ptr>, ...) -- the second argument is the only pointer */
+	case SYS_read:			/* read(int, void *, size_t)        */
+	case SYS_write:			/* write(int, const void *, size_t) */
+	case SYS_readv:			/* readv(int, const struct iovec *, int) */
+	case SYS_writev:		/* writev(int, const struct iovec *, int) */
+		return 0x02;
+
+	/* (<ptr>, ...) -- the first argument is the only pointer */
+	case SYS_brk:			/* brk(void *)                      */
+	case SYS_munmap:		/* munmap(void *, size_t)           */
+	case SYS_mmap:			/* mmap(void *, size_t, int, int, int, off_t) */
+	case SYS_set_tid_address:	/* set_tid_address(int *)           */
+	case SYS_set_robust_list:	/* set_robust_list(void *, size_t)  */
+	case SYS_futex:			/* futex(uint32_t *, int, uint32_t, ...) */
+	case SYS_getrandom:		/* getrandom(void *, size_t, unsigned) */
+		return 0x01;
+
+	/* (int, int, <ptr>) -- ioctl(int fd, unsigned long, void *arg) */
+	case SYS_ioctl:
+		return 0x04;
+
+	default:
+		return 0x00;
+	}
+}
+
+/*
+ * Route the arguments into the ABI's banks, then trap.
+ *
+ * The `register ... __asm__("rdNN")` declarations are the ordinary musl/GCC
+ * local-register-variable idiom: clang materialises each value into the named
+ * physical register immediately before the asm block, which is exactly the
+ * per-bank placement §3 asks for (verified by disassembling the emitted code:
+ * rd2rd/rd2rb with the expected source and destination registers).
+ */
+static inline long __dadao_trap(long nr, long a0, long a1, long a2, long a3,
+				long a4, long a5, int mask)
+{
+	long d0, d1, d2, d3, d4, p0;
+
+	switch (mask) {
+	case 0x04:	/* pointer in slot 2 */
+		d0 = a0; d1 = a1; d2 = a3; d3 = a4; d4 = a5; p0 = a2;
+		break;
+	case 0x02:	/* pointer in slot 1 */
+		d0 = a0; d1 = a2; d2 = a3; d3 = a4; d4 = a5; p0 = a1;
+		break;
+	case 0x01:	/* pointer in slot 0 */
+		d0 = a1; d1 = a2; d2 = a3; d3 = a4; d4 = a5; p0 = a0;
+		break;
+	default:	/* no pointer argument */
+		d0 = a0; d1 = a1; d2 = a2; d3 = a3; d4 = a4; p0 = 0;
+		break;
+	}
+
+	{
+		register long nr_reg __asm__("rd15") = nr;
+		register long rd16 __asm__("rd16") = d0;
+		register long rd17 __asm__("rd17") = d1;
+		register long rd18 __asm__("rd18") = d2;
+		register long rd19 __asm__("rd19") = d3;
+		register long rd20 __asm__("rd20") = d4;
+		register long rb16 __asm__("rb16") = p0;
+		register long ret __asm__("rd8");
+
+		__asm__ __volatile__("trap cfx_umon, 0\n\t"
+			: "=r"(ret)
+			: "r"(nr_reg), "r"(rd16), "r"(rd17), "r"(rd18), "r"(rd19),
+			  "r"(rd20), "r"(rb16)
+			: "memory");
+		return ret;
+	}
+}
+
+static inline long __syscall0(long n)
+{
+	return __dadao_trap(n, 0, 0, 0, 0, 0, 0, 0);
+}
+
+static inline long __syscall1(long n, long a)
+{
+	return __dadao_trap(n, a, 0, 0, 0, 0, 0, __dadao_argmask(n));
+}
+
+static inline long __syscall2(long n, long a, long b)
+{
+	return __dadao_trap(n, a, b, 0, 0, 0, 0, __dadao_argmask(n));
+}
+
+static inline long __syscall3(long n, long a, long b, long c)
+{
+	return __dadao_trap(n, a, b, c, 0, 0, 0, __dadao_argmask(n));
+}
+
+static inline long __syscall4(long n, long a, long b, long c, long d)
+{
+	return __dadao_trap(n, a, b, c, d, 0, 0, __dadao_argmask(n));
+}
+
+static inline long __syscall5(long n, long a, long b, long c, long d, long e)
+{
+	return __dadao_trap(n, a, b, c, d, e, 0, __dadao_argmask(n));
+}
+
+static inline long __syscall6(long n, long a, long b, long c, long d, long e,
+			      long f)
+{
+	return __dadao_trap(n, a, b, c, d, e, f, __dadao_argmask(n));
+}
+
+/* No vDSO: the machine has no kernel and no dynamic vector to consult
+ * (contract-syscall.md §6; the umon service is the whole syscall surface). */
+
+#define IPC_64 0
