+	case SYS_mmap:  /* sys/mman.h: void *mmap(void *, size_t, int, int, int, off_t) */	/*  unsigned long,  addr,  unsigned long,  len,  unsigned long,  prot,  unsigned long,  flags,  unsigned long,  fd,  unsigned long,  offset */
+	case SYS_mprotect:  /* sys/mman.h: int mprotect(void *, size_t, int) */	/*  unsigned long,  start,  size_t,  len,  unsigned long,  prot */
+	case SYS_mq_unlink:	/*  const char __user *,  u_name */
+	case SYS_msync:  /* sys/mman.h: int msync(void *, size_t, int) */	/*  unsigned long,  start,  size_t,  len,  int,  flags */
+	case SYS_munlock:  /* sys/mman.h: int munlock(const void *, size_t) */	/*  unsigned long,  start,  size_t,  len */
+	case SYS_munmap:  /* sys/mman.h: int munmap(void *, size_t) */	/*  unsigned long,  addr,  size_t,  len */
+	case SYS_pipe2:	/*  int __user *,  fildes,  int,  flags */
+	case SYS_remap_file_pages:  /* sys/mman.h: int remap_file_pages(void *, size_t, int, size_t, int) */	/*  unsigned long,  start,  unsigned long,  size,  unsigned long,  prot,  unsigned long,  pgoff,  unsigned long,  flags */
+	case SYS_rt_sigpending:	/*  sigset_t __user *,  uset,  size_t,  sigsetsize */
+	case SYS_rt_sigsuspend:	/*  sigset_t __user *,  unewset,  size_t,  sigsetsize */
+	case SYS_set_robust_list:	/*  struct robust_list_head __user *,  head,  size_t,  len */
