+	case SYS_madvise:  /* sys/mman.h: int madvise(void *, size_t, int) */	/*  unsigned long,  start,  size_t,  len_in,  int,  behavior */
+	case SYS_memfd_create:	/*  const char __user *,  uname,  unsigned int,  flags */
