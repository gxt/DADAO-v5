+	case SYS_ftruncate:	/*  unsigned int,  fd,  off_t,  length */
+	case SYS_getegid:	/*  */
+	case SYS_geteuid:	/*  */
+	case SYS_getgid:	/*  */
+	case SYS_getpgid:	/*  pid_t,  pid */
+	case SYS_getpid:	/*  */
+	case SYS_getppid:	/*  */
+	case SYS_getpriority:	/*  int,  which,  int,  who */
+	case SYS_getsid:	/*  pid_t,  pid */
+	case SYS_gettid:	/*  */
+	case SYS_getuid:	/*  */
+	case SYS_inotify_init1:	/*  int,  flags */
+	case SYS_inotify_rm_watch:	/*  int,  fd,  __s32,  wd */
