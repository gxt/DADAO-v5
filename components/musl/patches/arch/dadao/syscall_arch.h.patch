+	case SYS_prctl:	/*  int,  option,  unsigned long,  arg2,  unsigned long,  arg3,  unsigned long,  arg4,  unsigned long,  arg5 */
+	case SYS_readahead:	/*  int,  fd,  loff_t,  offset,  size_t,  count */
+	case SYS_rt_sigreturn:	/*  */
