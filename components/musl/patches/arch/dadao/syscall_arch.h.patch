+/*
+ * DADAO syscall entry/driver for musl.
+ *
+ * ---------------------------------------------------------------------------
+ * The contract this implements (quoting, not paraphrasing)
+ * ---------------------------------------------------------------------------
+ * .tao/contracts/contract-syscall.md:
+ *   §1.1  "syscall 号存放在 rd15，沿用 RISC-V Linux 编号"  (ADR-0025 D1)
+ *   §2    "trap cfxha, immu18 发起"; dispatch entry umon (cfx0) with
+ *         immu18 = 0 (SBI_UMON_SYSCALL); "入参 rd15 = nr、出参 rd8 = result";
+ *         the callee resumes on the instruction after the trap.
+ *   §3    "返回值 = rd8"; argument registers "rd16-rd31 (data), rb16-rb31
+ *         (address), rf16-rf31 (float); 三组各自独立计数、自 16 起，参数按类型
+ *         分配到对应组"; worked example: read(int fd, void *buf, size_t count)
+ *         => fd -> rd16, buf -> rb16, count -> rd17.
+ *   §4    errno = negative rd8 ("A：rd8 负值（推荐）", user ruling 2026-10-14)
+ *         so musl's __syscall_ret() needs no change at all (it already
+ *         interprets `r > -4096UL` as an error).
+ *
+ * The assembler form is `trap cfx_umon, 0` (immu18 < 0x3FF00, so it is
+ * NOT the semihosting tag) -- the same spelling the boot ROM uses for the
+ * hypv->user hand-off; QEMU's dadao-m1 machine serves it for user mode
+ * (INFRA-082t stage A1) and resumes at pc+4.
+ *
+ * All six integer/pointer argument positions are filled for every width so no
+ * register is left holding a stale value from an earlier call; slots a syscall
+ * does not use are simply never read by the service.
+ *
+ * ---------------------------------------------------------------------------
+ * The one non-obvious part: WHERE the arguments go
+ * ---------------------------------------------------------------------------
+ * §3 assigns arguments to banks BY TYPE, and musl hands this stub plain
+ * `long`s (syscall_arg_t): by the time __syscallN() runs, the pointer-ness of
+ * an argument is gone.  It is therefore recovered from the syscall NUMBER by
+ * __dadao_argmask() below, which is the single table the three carriers of
+ * this protocol share:
+ *
+ *   1. this file (the C stub every syscall goes through),
+ *   2. QEMU's linux-user/dadao/cpu_loop.c:dadao_argmask(), which rebuilds the
+ *      positional argument list on the host side, and
+ *   3. src/thread/dadao/syscall_cp.s, the cancellable-call stub.
+ *
+ * tools/qemu/check_syscall_abi.py checks (1) and (2) for exact equality and
+ * (3) for equality on the cancellable subset it dispatches, so a number added
+ * to one carrier only fails a gate instead of reading the wrong register bank.
+ *
+ * A number that is absent gets mask 0 (everything in the RD bank).  That is no
+ * longer an acceptable default: before ISS-249 the table listed only the
+ * twelve numbers of the P1 static set, and every other call silently lost its
+ * sixth argument (the stub had five data slots plus one address slot) -- that
+ * is what broke sendto/recvfrom.  The table below therefore covers every
+ * syscall name this libc can issue, mask 0x00 entries included.
+ */
+
+#include <sys/syscall.h>
+
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+/*
+ * Big-endian `ipc_perm.mode` placement (SysV IPC).
+ *
+ * musl's struct ipc_perm (arch/generic/bits/ipc.h) carries `mode_t mode`, a
+ * 32-bit object at offset 20, while the object the kernel (and QEMU's
+ * linux-user target_ipc_perm, linux-user/generic/target_structs.h) reports has
+ * a 16-bit mode followed by 16 bits of padding.  On a little-endian target
+ * both readings coincide; on this big-endian target the 16-bit value lands in
+ * the *high* half of musl's 32-bit field (measured: mode 0666 arrives as
+ * 0x01b60000, so `mode & 0x1ff` is 0 -- that is the ipc_msg/ipc_shm failure
+ * registered as ISS-249).
+ *
+ * musl ships exactly this compensation for its big-endian ports (arm, sh,
+ * m68k, microblaze define it; src/ipc/*ctl.c multiplies by 0x10000 before
+ * IPC_SET and shifts back after IPC_STAT), so the port uses the same switch
+ * rather than inventing a private layout.
+ */
+#define SYSCALL_IPC_BROKEN_MODE
+
+/*
+ * Pointer-argument mask: bit i set <=> positional argument i is an address
+ * and therefore goes to the RB bank; the rest are data (RD bank).  Both banks
+ * are counted independently (contract-syscall.md §3), so the n-th address
+ * argument lands in rb(16+n) and the n-th data argument in rd(16+n).
+ *
+ * The mask is not a naming convention: it is derived from each syscall's own
+ * prototype -- the Linux SYSCALL_DEFINE signature behind the number in the
+ * locked table (contract-syscall.md §1.2), except where the kernel declares an
+ * address as an integer or hides it behind a pointer typedef.  Those entries
+ * follow the userspace prototype instead and say so in their comment (brk,
+ * mmap, munmap, mprotect, mremap, mlock, munlock, mlock2, madvise, msync,
+ * mincore, remap_file_pages, ioctl, capget, capset, riscv_flush_icache,
+ * ptrace, semctl).
+ *
+ * COVERAGE: one entry per syscall name this libc can issue -- every SYS_* name
+ * used anywhere in musl's sources, mapped onto the locked asm-generic number
+ * table -- mask 0x00 entries included.  An absent number would silently get
+ * "everything in RD", which is exactly the defect this table closes (ISS-249).
+ *
+ * INVARIANT (three carriers, gated by tools/qemu/check_syscall_abi.py): this
+ * table, QEMU's linux-user/dadao/cpu_loop.c:dadao_argmask() and the dispatch
+ * in src/thread/dadao/syscall_cp.s must agree number for number; adding a
+ * number on one side only fails that gate instead of reading garbage.
+ */
+static inline int __dadao_argmask(long nr)
+{
+	switch (nr) {
+	/* mask 0x00 (72): no address argument */
