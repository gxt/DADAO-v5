+	case SYS_sched_get_priority_min:	/*  int,  policy */
+	case SYS_sched_getscheduler:	/*  pid_t,  pid */
+	case SYS_sched_yield:	/*  */
+	case SYS_semget:	/*  key_t,  key,  int,  nsems,  int,  semflg */
+	case SYS_setfsgid:	/*  gid_t,  gid */
+	case SYS_setfsuid:	/*  uid_t,  uid */
+	case SYS_setgid:	/*  gid_t,  gid */
+	case SYS_setns:	/*  int,  fd,  int,  flags */
+	case SYS_setpgid:	/*  pid_t,  pid,  pid_t,  pgid */
+	case SYS_setpriority:	/*  int,  which,  int,  who,  int,  niceval */
+	case SYS_setregid:	/*  gid_t,  rgid,  gid_t,  egid */
+	case SYS_setresgid:	/*  gid_t,  rgid,  gid_t,  egid,  gid_t,  sgid */
+	case SYS_setresuid:	/*  uid_t,  ruid,  uid_t,  euid,  uid_t,  suid */
+	case SYS_setreuid:	/*  uid_t,  ruid,  uid_t,  euid */
+	case SYS_setsid:	/*  */
+	case SYS_setuid:	/*  uid_t,  uid */
+	case SYS_shmget:	/*  key_t,  key,  size_t,  size,  int,  shmflg */
+	case SYS_shutdown:	/*  int,  fd,  int,  how */
+	case SYS_socket:	/*  int,  family,  int,  type,  int,  protocol */
+	case SYS_sync:	/*  */
+	case SYS_sync_file_range:	/*  int,  fd,  loff_t,  offset,  loff_t,  nbytes,  unsigned int,  flags */
+	case SYS_syncfs:	/*  int,  fd */
+	case SYS_tee:	/*  int,  fdin,  int,  fdout,  size_t,  len,  unsigned int,  flags */
+	case SYS_timer_delete:	/*  timer_t,  timer_id */
+	case SYS_timer_getoverrun:	/*  timer_t,  timer_id */
+	case SYS_timerfd_create:	/*  int,  clockid,  int,  flags */
+	case SYS_tkill:	/*  pid_t,  pid,  int,  sig */
+	case SYS_umask:	/*  int,  mask */
+	case SYS_unshare:	/*  unsigned long,  unshare_flags */
+	case SYS_vhangup:	/*  */
