+	case SYS_acct:	/*  const char __user *,  name */
+	case SYS_adjtimex:	/*  struct __kernel_timex __user *,  txc_p */
+	case SYS_brk:  /* unistd.h: int brk(void *) */	/*  unsigned long,  brk */
+	case SYS_chdir:	/*  const char __user *,  filename */
+	case SYS_chroot:	/*  const char __user *,  filename */
+	case SYS_delete_module:	/*  const char __user *,  name_user,  unsigned int,  flags */
+	case SYS_getcwd:	/*  char __user *,  buf,  unsigned long,  size */
