+	case SYS_setdomainname:	/*  char __user *,  name,  int,  len */
+	case SYS_sethostname:	/*  char __user *,  name,  int,  len */
+	case SYS_shmdt:	/*  char __user *,  shmaddr */
+	case SYS_swapoff:	/*  const char __user *,  specialfile */
+	case SYS_swapon:	/*  const char __user *,  specialfile,  int,  swap_flags */
+	case SYS_sysinfo:	/*  struct sysinfo __user *,  info */
