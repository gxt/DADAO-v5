diff --git a/arch/dadao/arch.mak b/arch/dadao/arch.mak
new file mode 100644
index 0000000..10d7265
--- /dev/null
+++ b/arch/dadao/arch.mak
@@ -0,0 +1,32 @@
+# DADAO per-arch build overrides.
+#
+# The musl Makefile includes this file (`-include $(srcdir)/arch/$(ARCH)/arch.mak`,
+# Makefile line 79) after `BASE_SRCS` is set up, which is the upstream-blessed
+# place for an arch to adjust the source list (several arches use it for
+# COMPAT_SRC_DIRS).
+#
+# ---------------------------------------------------------------------------
+# Backend-blocked sources
+# ---------------------------------------------------------------------------
+# The list is EMPTY: every source in BASE_SRCS compiles for dadao-unknown-elf
+# with the installed toolchain and musl's own obj/src/%.lo flags.
+#
+# History (kept so an entry is never re-added without re-checking):
+#   * `rotl`/`rotr`  (rotate) -- `src/crypt/crypt_sha512.c`,
+#     `src/signal/sigdelset.c`.  Excluded while the instruction selector
+#     aborted with "Cannot select: i64 = rotl".  LLVM-099t (2026-10-17) expands
+#     i64 ROTL/ROTR, and both sources now build at -O0 / -O2 / -O2 -fPIC and
+#     link into libc.a / libc.so -- dropped (INFRA-085t stage A1).
+#   * `bswap` (LLVM-096t/097t) and VLA/alloca (LLVM-097t) -- the 11 sources
+#     under those two headings were dropped earlier (INFRA-085t stage C) after
+#     being re-checked one by one.
+#
+# The empty list is kept (rather than deleting the mechanism) so that a future
+# backend gap can be recorded here in one line, and the report below stays as
+# the "no silent exclusion" tripwire.
+
+DADAO_BACKEND_BLOCKED_SRCS =
+
+BASE_SRCS := $(filter-out $(addprefix $(srcdir)/,$(DADAO_BACKEND_BLOCKED_SRCS)),$(BASE_SRCS))
+
+$(info dadao: excluding $(words $(DADAO_BACKEND_BLOCKED_SRCS)) backend-blocked source(s) (see arch/dadao/arch.mak))
