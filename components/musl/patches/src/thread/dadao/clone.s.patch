diff --git a/src/thread/dadao/clone.s b/src/thread/dadao/clone.s
new file mode 100644
index 0000000..88b90be
--- /dev/null
+++ b/src/thread/dadao/clone.s
@@ -0,0 +1,116 @@
+@@ DADAO __clone: create a thread and install its thread pointer.
+@@
+@@ int __clone(int (*func)(void *), void *stack, int flags, void *arg,
+@@             void *ptid, void *tls, void *ctid);
+@@
+@@ ## C ABI -> syscall ABI (contract-syscall.md §1.1/§3/§4)
+@@
+@@ The seven C arguments are routed by TYPE into the two parameter banks,
+@@ each bank counting independently from 16 (contract-abi.md §4.1,
+@@ contract-syscall.md §3):
+@@
+@@   func  pointer -> rb16          stack pointer -> rb17
+@@   flags int     -> rd16          arg   pointer -> rb18
+@@   ptid  pointer -> rb19          tls   pointer -> rb20
+@@   ctid  pointer -> rb21
+@@
+@@ (__clone is declared variadic, but that does not change where the
+@@ arguments travel: a variadic callee only has to save the register bank
+@@ windows it later reads with va_arg -- ADR-0031 D1/D2.  This stub reads
+@@ the registers directly.  musl's only caller, pthread_create(), passes
+@@ &new->tid, TP_ADJ(new) and &__thread_list_lock, all pointers, so ptid,
+@@ tls and ctid continue in the RB bank as shown above.)
+@@
+@@ SYS_clone = 220 (arch/dadao/bits/syscall.h.in:220; same number as the
+@@ RISC-V table the v5 syscall contract locks, §1.1/§1.2) takes
+@@ (flags, newsp, parent_tidptr, tls, child_tidptr).  qemu's
+@@ linux-user/dadao/cpu_loop.c dadao_argmask() gives that number mask 0x14:
+@@ address arguments in slots 2 and 4 only, so the syscall registers are
+@@
+@@   rd15 = 220 | rd16 = flags | rd17 = newsp
+@@   rb16 = parent_tidptr | rd18 = tls | rb17 = child_tidptr
+@@
+@@ Result in rd8; errors are a negative rd8 (contract-syscall.md §4), which
+@@ the parent returns as-is -- musl's pthread_create() translates any
+@@ negative __clone() result to EAGAIN.
+@@
+@@ The trap preserves every register except the one carrying the result
+@@ (qemu's cpu_loop writes only rd8; a syscall ABI does the same), so the
+@@ child still sees the tls argument in rb20.
+@@
+@@ ## Child side: rb3 (rbtp) is installed only for CLONE_SETTLS
+@@
+@@ TP = rb3 (contract-abi.md §1.3, rbtp; arch/dadao/pthread_arch.h).  The
+@@ kernel installs the tls argument only when CLONE_SETTLS
+@@ (0x00080000; include/sched.h:64) is in flags -- qemu does the same
+@@ (`if (flags & CLONE_SETTLS) cpu_set_tls(...)` in do_fork).  This stub
+@@ mirrors that condition exactly: with CLONE_SETTLS set the child writes
+@@ the tls argument into rb3 itself (so TP does not depend on the clone
+@@ provider); with the flag clear it must NOT touch rb3 and the child keeps
+@@ the parent's TP, which is the kernel behaviour.
+@@
+@@ The conditional matters: posix_spawn() calls
+@@ __clone(child, stack, CLONE_VM|CLONE_VFORK|SIGCHLD, &args) with only four
+@@ arguments, so ptid/tls/ctid are simply not passed (rb20 is leftover
+@@ garbage).  Writing that garbage into rb3 gave the vfork child an invalid
+@@ TP and __execvpe()'s first errno write faulted (ISS-295).  Writing rb3
+@@ unconditionally is therefore wrong even though pthread_create() always
+@@ sets CLONE_SETTLS.
+@@
+@@ ## Layout of the child stack
+@@
+@@ The incoming stack pointer is aligned down to 16 B and 16 B are reserved
+@@ for func/arg; that adjusted pointer is the newsp passed to SYS_clone and
+@@ becomes rb1 in the child (cpu_clone_regs_child).  func and arg are read
+@@ back from [rb1+0] and [rb1+8] after the clone returns 0.  The child then
+@@ calls func(arg) with arg in rb16 (the pointer argument register) and
+@@ exits through SYS_exit if func ever returns; SYS_exit = 93
+@@ (arch/dadao/bits/syscall.h.in:93) with status 0 in rd16.
+@@
+@@ Assembly syntax: `@@` starts a comment ('#' is reserved for cpp,
+@@ Toolchain-01 §2.2); `.s` is assembled without the preprocessor, so the
+@@ syscall numbers are literals with their header line cited above.
+
+	.text
+	.global __clone
+	.hidden __clone
+	.type __clone, %function
+__clone:
+	@@ newsp = (stack & ~15) - 16; keep func/arg there for the child.
+	andn.w	rb17, wp0, 15
+	set.zw	rd9, wp0, 16
+	sub.o	rb17, rb17, rd9
+	st.o	rb16, [rb17, 0]
+	st.o	rb18, [rb17, 8]
+
+	@@ SYS_clone(flags, newsp, parent_tidptr, tls, child_tidptr).
+	@@ func/arg are already saved, so rb16/rb17 are free to be reused.
+	rb2rd	{rd17}, {rb17}
+	rb2rb	{rb16}, {rb19}
+	rb2rd	{rd18}, {rb20}
+	rb2rb	{rb17}, {rb21}
+	set.zw	rd15, wp0, 220
+	trap	cfx_umon, 0
+
+	br.nz	{rd8}?, [rb0, .Lparent]
+
+	@@ Child: rb1 = newsp, rd8 = 0.  Install TP only when CLONE_SETTLS
+	@@ (0x00080000) was requested; otherwise leave the inherited rb3 alone.
+	set.zw	rd9, wp1, 8
+	and.o	rd9, rd16, rd9
+	br.z	{rd9}?, [rb0, .Lno_tls]
+	rb2rb	{rb3}, {rb20}
+.Lno_tls:
+	ld.o	rb17, [rb1, 0]
+	ld.o	rb16, [rb1, 8]
+	call	[rb17, rd0, 0]
+
+	@@ func returned: exit this thread with status 0.
+	set.zw	rd16, wp0, 0
+	set.zw	rd15, wp0, 93
+	trap	cfx_umon, 0
+
+.Lparent:
+	@@ rd8 already holds the syscall result (tid or -errno); rd0 keeps it.
+	ret	rd0, 0
+	.size __clone, . - __clone
