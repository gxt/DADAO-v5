diff --git a/src/setjmp/dadao/longjmp.S b/src/setjmp/dadao/longjmp.S
new file mode 100644
index 0000000..4b37789
--- /dev/null
+++ b/src/setjmp/dadao/longjmp.S
@@ -0,0 +1,46 @@
+/* DADAO longjmp.
+ *
+ * void longjmp(jmp_buf env, int val);  -- two arguments, in the ABI's banks:
+ *      env is a pointer  -> rb16   (contract-abi.md §4.1)
+ *      val is an integer -> rd16
+ *
+ * Restores exactly what setjmp.S saved (same frame layout, documented in
+ * arch/dadao/bits/setjmp.h), then performs *setjmp's* return via `ret`, which
+ * pops the return address setjmp pushed onto the RegRAS.  Because the saved
+ * ra0 (RACNT/MRPTR) is restored first, the RegRAS is exactly as deep as it was
+ * inside setjmp, so the `ret` lands in setjmp's caller.
+ *
+ * C semantics (C11 7.13.2.1): longjmp(env, 0) must make setjmp return 1.
+ * `cs.z {cond}?, dst, src1, src2` is "if (cond == 0) dst = src1 else dst =
+ * src2" (contract-isa.md §6.5), so with rd18 holding the constant 1:
+ *
+ *     cs.z {rd16}?, rd8, rd18, rd16     ; rd8 = (val == 0) ? 1 : val
+ *
+ * and `ret rd0, 0` returns it (rd0 as the ret destination is the architected
+ * "no value change" form, contract-isa §8.5).
+ */
+
+	.text
+	.global __longjmp
+	.global _longjmp
+	.global longjmp
+	.type __longjmp, %function
+	.type _longjmp, %function
+	.type longjmp, %function
+__longjmp:
+_longjmp:
+longjmp:
+	set.zw	rd17, wp0, 520
+	ldm.o	{rd32:rd63}, [rb16, rd17]
+	set.zw	rd17, wp0, 776
+	ldm.o	{rb32:rb63}, [rb16, rd17]
+	set.zw	rd17, wp0, 1032
+	ldm.o	{rf32:rf63}, [rb16, rd17]
+	ld.o	rb1, [rb16, 512]
+	set.zw	rd18, wp0, 1
+	cs.z	{rd16}?, rd8, rd18, rd16
+	ld.o	ra0, [rb16, 0]
+	set.zw	rd19, wp0, 8
+	ldm.o	{ra1:ra63}, [rb16, rd19]
+	ret	rd0, 0
+	.size longjmp, . - longjmp
