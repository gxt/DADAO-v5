+NodeTLB::NodeTLB(const Params &p) :
+    BaseTLB(p), romBase(p.rom_base), romSize(p.rom_size),
+    ramBase(p.ram_base), ramSize(p.ram_size), hmonBase(p.hmon_base),
+    hmonSize(p.hmon_size), smonBase(p.smon_base), smonSize(p.smon_size),
+    pmemBase(p.pmem_base), pmemSize(p.pmem_size), stats(*this)
+{
+    // Structural assertion, printed once per side at start-up (derived from
+    // the NodeTlb* geometry constants, never hand-written counts).
+    const bool dataSide = (p.entry_type == TypeTLB::data);
+    inform("DADAO Node TLB (%s): groups=%u ways=%u super_entries=%u "
+           "set_index=VA[%u] replacement=LRU dirty_bit=%u\n",
+           dataSide ? "D" : "I", NodeTlbSets, NodeTlbWays,
+           NodeTlbSuperEntries, NodeTlbSetShift, dataSide ? 1 : 0);
+}
+
+NodeTLB::TlbStats::TlbStats(NodeTLB &parent) :
+    statistics::Group(&parent),
+    ADD_STAT(hits, statistics::units::Count::get(),
+             "guest TLB lookups that hit an entry"),
+    ADD_STAT(misses, statistics::units::Count::get(),
+             "guest TLB lookups that missed and started a page-table walk")
+{}
