+
+/** A page-table/TLB-hit fault: delivered to the current run-mode monitor
+ *  (spec/DADAO-12 §2.2.6/§5.2).  `cause` is the whole `excp_cause_id` value:
+ *  one bit of the flat [38:32]/[56:48] bitmap, low cause zero (ADR-0062). */
+class NodePtwFault : public FaultBase
+{
+  private:
+    const uint64_t cause;
+    const uint64_t info;
+    const Addr faultPc;
+
+  public:
+    NodePtwFault(uint64_t cause, uint64_t info, Addr faultPc) :
+        cause(cause), info(info), faultPc(faultPc)
+    {}
+
+    FaultName name() const override { return "DADAO page-table fault"; }
+
+    void
+    invoke(ThreadContext *tc, const StaticInstPtr &) override
+    {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        panic_if(isa == nullptr, "DADAO Node: PTW fault without an ISA");
+        NodeState &s = isa->nodeState();
+        nodeSyncEnter(tc, s, cause, s.runMode, faultPc, info);
+    }
+};
+
+/** A two-axis cfx permission denial (ADR-0045 D6): to the current monitor. */
+class NodePermFault : public FaultBase
+{
+  private:
+    const Addr addr;
+    const Addr faultPc;
+
+  public:
+    NodePermFault(Addr addr, Addr faultPc) : addr(addr), faultPc(faultPc) {}
+
+    FaultName name() const override { return "DADAO cfx permission"; }
+
+    void
+    invoke(ThreadContext *tc, const StaticInstPtr &) override
+    {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        panic_if(isa == nullptr, "DADAO Node: CFXPERM without an ISA");
+        NodeState &s = isa->nodeState();
+        nodeSyncEnter(tc, s, CauseCfxPerm, s.runMode, faultPc,
+                      addr);
+    }
+};
+
+constexpr uint64_t kPmemCfxOffset = 0x3FF00000000ULL;
+
+bool
+inRegion(Addr base, Addr size, Addr addr, Addr len)
+{
+    if (len == 0 || addr < base)
+        return false;
+    const Addr off = addr - base;
+    if (off >= size)
+        return false;
+    return len <= size - off;
+}
+
+uint64_t
+readPte(System *system, Addr pa)
+{
+    uint8_t bytes[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    system->physProxy.readBlobPhys(pa, 0, bytes, 8);
+    uint64_t pte = 0;
+    for (uint8_t b : bytes)
+        pte = (pte << 8) | b;
+    return pte;
+}
+
+void
+writePteOr(System *system, Addr pa, uint64_t bits)
+{
+    uint64_t pte = readPte(system, pa) | bits;
+    uint8_t bytes[8];
+    for (unsigned i = 0; i < 8; ++i)
+        bytes[i] = (pte >> (56 - 8 * i)) & 0xFF;
+    system->physProxy.writeBlobPhys(pa, 0, bytes, 8);
+}
+
+bool
+writablePte(Addr ramBase, Addr ramSize, Addr pa)
+{
+    return inRegion(ramBase, ramSize, pa, 8);
+}
+
+/** Missing-page class for the access kind (contract-see §6.1.1 [48..55]):
+ *  fetch names `I*`, data the matching `D*`; a superpage entry names the SPF
+ *  pair, a normal page the GPF pair. */
+uint64_t
+missingPageSub(bool fetch, bool superpage)
+{
+    if (superpage)
+        return fetch ? SubIspTrap : SubDspTrap;
+    return fetch ? SubIgpTrap : SubDgpTrap;
+}
+
+/** Missing fragment class on the same split (§6.1.1 [50][51][54][55]). */
+uint64_t
+missingFragSub(bool fetch, bool superpage)
+{
+    if (superpage)
+        return fetch ? SubIspfTrap : SubDspfTrap;
+    return fetch ? SubIgpfTrap : SubDgpfTrap;
+}
+
+/** HSJU denial names the run mode whose bit was clear (§6.1.1 [32..35]). */
+uint64_t
+hsjuSub(uint8_t runMode)
+{
+    return SubNuPerm << (runMode & 0x3);
+}
+
+/** Set (group) index of a normal page: VA[16] (user ruling 2026-11-19). */
+unsigned
+tlbSetOf(uint64_t va)
+{
+    return (va >> NodeTlbSetShift) & (NodeTlbSets - 1);
+}
+
+/** Promote `way` to MRU in an N-way LRU age column (0 = MRU, N-1 = victim). */
+template <unsigned N>
+void
+lruTouch(uint8_t (&age)[N], unsigned way)
+{
+    const uint8_t old = age[way];
+    for (unsigned i = 0; i < N; ++i) {
+        if (i != way && age[i] < old)
+            ++age[i];
+    }
+    age[way] = 0;
+}
+
+/** Replacement choice: an invalid entry if the table still has one, else the
+ *  LRU way. */
+template <class Entry, unsigned N>
+unsigned
+lruVictim(Entry (&entries)[N], const uint8_t (&age)[N])
+{
+    for (unsigned i = 0; i < N; ++i) {
+        if (!entries[i].valid)
+            return i;
+    }
+    unsigned victim = 0;
+    for (unsigned i = 1; i < N; ++i) {
+        if (age[i] > age[victim])
+            victim = i;
+    }
+    return victim;
+}
+
+/** Guest TLB lookup (TLB-05/TLB-06): the group x way array of the matching
+ *  set first, then the fully-associative superpage array.  A hit is promoted
+ *  to MRU and returned; a miss returns nullptr and the caller walks. */
+template <class Entry>
+Entry *
+tlbProbe(Entry (&sets)[NodeTlbSets][NodeTlbWays],
+         uint8_t (&setLru)[NodeTlbSets][NodeTlbWays],
+         Entry (&super)[NodeTlbSuperEntries],
+         uint8_t (&superLru)[NodeTlbSuperEntries], uint64_t va, uint16_t asid)
+{
+    const unsigned set = tlbSetOf(va);
+    auto matches = [va, asid](const Entry &e) {
+        if (!e.valid)
+            return false;
+        const uint64_t mask = (1ULL << e.sizeLog2) - 1;
+        if ((va & ~mask) != e.va)
+            return false;
+        return e.g || e.asid == asid;
+    };
+    for (unsigned way = 0; way < NodeTlbWays; ++way) {
+        if (matches(sets[set][way])) {
+            lruTouch<NodeTlbWays>(setLru[set], way);
+            return &sets[set][way];
+        }
+    }
+    for (unsigned way = 0; way < NodeTlbSuperEntries; ++way) {
+        if (matches(super[way])) {
+            lruTouch<NodeTlbSuperEntries>(superLru, way);
+            return &super[way];
+        }
+    }
+    return nullptr;
+}
+
+/** Hit path (TLB-09/TLB-10/TLB-14): fragment -> HSJU -> R/W/X in spec order,
+ *  then update the local A/D state and form the physical address.  The I
+ *  side tracks A only (its entry has no D state). */
+template <class Entry>
+Fault
+tlbHit(Entry &e, uint64_t va, bool fetch, bool write, const NodeState &s,
+       const RequestPtr &req, Addr faultPc)
+{
+    const bool super = (e.sizeLog2 == NodeSuperShift);
+    const unsigned frag = super ? ((va >> 26) & 0x7) : ((va >> 13) & 0x7);
+    if (!(e.frags & (1u << frag))) {
+        return std::make_shared<NodePtwFault>(
+            missingFragSub(fetch, super), va, faultPc);
+    }
+    if (!(e.hsju & (1ULL << (s.runMode & 0x3)))) {
+        return std::make_shared<NodePtwFault>(
+            hsjuSub(s.runMode), va, faultPc);
+    }
+    if (fetch && !e.x) {
+        return std::make_shared<NodePtwFault>(
+            SubNxPerm, va, faultPc);
+    }
+    if (write && !e.w) {
+        return std::make_shared<NodePtwFault>(
+            SubNwPerm, va, faultPc);
+    }
+    if (!fetch && !write && !e.r) {
+        return std::make_shared<NodePtwFault>(
+            SubNrPerm, va, faultPc);
+    }
+
+    nodeTlbTouch(e, write);
+    const uint64_t mask = (1ULL << e.sizeLog2) - 1;
+    req->setPaddr(e.pa | (va & mask));
+    return NoFault;
+}
+
+/** Fill after a successful walk (TLB-08/TLB-11/TLB-12/TLB-13): choose the
+ *  victim (invalid-first, else LRU), write back its dirty A/D, then install.
+ *  A write-back failure keeps the victim untouched and reports
+ *  CFXMEM[56] with the PTE physical address (ADR-0041 D7/D10). */
+template <class Entry>
+Fault
+tlbInstall(NodeState &s, Entry (&sets)[NodeTlbSets][NodeTlbWays],
+           uint8_t (&setLru)[NodeTlbSets][NodeTlbWays],
+           Entry (&super)[NodeTlbSuperEntries],
+           uint8_t (&superLru)[NodeTlbSuperEntries], bool superpage,
+           uint64_t va, uint64_t pte, Addr leafPa, bool write,
+           const RequestPtr &req, Addr faultPc, Addr ramBase, Addr ramSize)
+{
+    const unsigned set = tlbSetOf(va);
+    unsigned way;
+    Entry *victim;
+    if (superpage) {
+        way = lruVictim(super, superLru);
+        victim = &super[way];
+    } else {
+        way = lruVictim(sets[set], setLru[set]);
+        victim = &sets[set][way];
+    }
+
+    if (victim->valid && nodeTlbDirty(*victim)) {
+        if (!writablePte(ramBase, ramSize, victim->ptePa)) {
+            // A/D write-back failure: `cause_info` is the PTE physical
+            // address, not the accessed address (ADR-0062 D4).
+            return std::make_shared<NodePtwFault>(
+                SubAdwbFail, victim->ptePa, faultPc);
+        }
+        // Atomic OR keeps any bits another table already wrote back.
+        writePteOr(s.tc->getSystemPtr(), victim->ptePa,
+                   nodeTlbDirtyBits(*victim));
+    }
+
+    Entry &e = *victim;
+    e = Entry();
+    e.valid = true;
+    e.sizeLog2 = superpage ? NodeSuperShift : NodeNormalShift;
+    e.va = va & ~((1ULL << e.sizeLog2) - 1);
+    e.pa = superpage ? (pte & NodeSuperPpnMask) : (pte & NodePpnMask);
+    e.ptePa = leafPa;
+    e.hsju = (pte >> 60) & 0xF;
+    e.frags = (pte >> NodeFragShift) & 0xFF;
+    e.r = (pte & PteR) != 0;
+    e.w = (pte & PteW) != 0;
+    e.x = (pte & PteX) != 0;
+    e.g = (pte & PteG) != 0;
+    e.asid = static_cast<uint16_t>(s.tlbAsid);
+    e.aLocal = (pte & PteA) != 0;
+    e.aDirty = false;
+    nodeTlbSetDLocal(e, pte);
+
+    // The fill access is itself an access (§2.2.5): load/fetch set A, store
+    // sets A/D.
+    nodeTlbTouch(e, write);
+
+    if (superpage)
+        lruTouch<NodeTlbSuperEntries>(superLru, way);
+    else
+        lruTouch<NodeTlbWays>(setLru[set], way);
+
+    const uint64_t mask = (1ULL << e.sizeLog2) - 1;
+    req->setPaddr(e.pa | (va & mask));
+    return NoFault;
+}
+
+} // anonymous namespace
+
+Fault
+NodeTLB::translate(const RequestPtr &req, ThreadContext *tc,
+                   BaseMMU::Mode mode, bool enterOnFault) const
+{
+    (void)enterOnFault;
+    auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+    panic_if(isa == nullptr, "DADAO Node TLB: thread has no DADAO ISA");
+    NodeState &s = isa->nodeState();
+    panic_if(!s.active, "DADAO Node TLB used outside the Node profile");
+
+    const Addr va = req->getVaddr() & NodeAddrMask;
+    const Addr size = req->getSize();
+    const unsigned cfxha = (va >> 42) & 0x3F;
+    const bool fetch = (mode == BaseMMU::Execute);
+    const bool write = (mode == BaseMMU::Write);
+    const Addr faultPc =
+        (fetch && req->hasPC()) ? req->getPC() : tc->pcState().instAddr();
+    System *system = tc->getSystemPtr();
+
+    // Two-axis cfx permission for direct internal-space accesses
+    // (ADR-0045 D1/D2/D6).  The memory window is not a cfx.
+    if (cfxha != 0 && nodePermDenied(s, cfxha, fetch ? 3 : 1))
+        return std::make_shared<NodePermFault>(va, faultPc);
+
+    if (cfxha == 0) {
+        // Address-space Step 1: no silent pmem pass-through without PTW.
+        // The fault enters the current run-mode monitor as CFXMEM with
+        // `excp_cause_info` = the accessed address (DADAO-12 §5.2(一)).
+        if (!(s.ptwEnable & 1))
+            return machineFaultAt(FaultCFXMEM, faultPc, va);
+
+        // Step 2: guest TLB lookup.  Fetch and data use separate first-level
+        // tables (a design split, not an implementation detail); a hit never
+        // re-reads the PTE.
+        const uint16_t asid = static_cast<uint16_t>(s.tlbAsid);
+        if (fetch) {
+            NodeTlbEntry *e = tlbProbe(s.itlb, s.itlbLru, s.itlbSp,
+                                       s.itlbSpLru, va, asid);
+            if (e != nullptr) {
+                stats.hits++;
+                return tlbHit(*e, va, fetch, write, s, req, faultPc);
+            }
+        } else {
+            NodeTlbDataEntry *e = tlbProbe(s.dtlb, s.dtlbLru, s.dtlbSp,
+                                           s.dtlbSpLru, va, asid);
+            if (e != nullptr) {
+                stats.hits++;
+                return tlbHit(*e, va, fetch, write, s, req, faultPc);
+            }
+        }
+        stats.misses++;
+
+        // Step 3: two-level walk on a miss.
+        const Addr l1pa =
+            (s.ptbr & NodePtbrMask) + (((va >> 29) & 0x1FFF) << 3);
+        if (!inRegion(ramBase, ramSize, l1pa, 8) &&
+            !inRegion(romBase, romSize, l1pa, 8)) {
+            fatal("DADAO Node: page-table access outside physical memory "
+                  "(VA=%#llx, PTBR=%#llx)", va, s.ptbr);
+        }
+        uint64_t pte = readPte(system, l1pa);
+        uint64_t leafPa = l1pa;
+        bool superpage = false;
+
+        if (!(pte & PteP)) {
+            return std::make_shared<NodePtwFault>(
+                missingPageSub(fetch, (pte & PteSp) != 0), va,
+                faultPc);
+        }
+
+        if (pte & PteSp) {
+            superpage = true;
+            const unsigned frag = (va >> 26) & 0x7;
+            if (!(pte & (1ULL << (NodeFragShift + frag)))) {
+                return std::make_shared<NodePtwFault>(
+                    missingFragSub(fetch, true), va, faultPc);
+            }
+        } else {
+            const Addr l2pa =
+                (pte & NodePpnMask) + (((va >> 16) & 0x1FFF) << 3);
+            if (!inRegion(ramBase, ramSize, l2pa, 8) &&
+                !inRegion(romBase, romSize, l2pa, 8)) {
+                fatal("DADAO Node: page-table access outside physical memory "
+                      "(VA=%#llx, PTBR=%#llx)", va, s.ptbr);
+            }
+            pte = readPte(system, l2pa);
+            leafPa = l2pa;
+            if (!(pte & PteP)) {
+                return std::make_shared<NodePtwFault>(
+                    missingPageSub(fetch, false), va, faultPc);
+            }
+            const unsigned frag = (va >> 13) & 0x7;
+            if (!(pte & (1ULL << (NodeFragShift + frag)))) {
+                return std::make_shared<NodePtwFault>(
+                    missingFragSub(fetch, false), va, faultPc);
+            }
+        }
+
+        const uint64_t hsju = (pte >> 60) & 0xF;
+        if (!(hsju & (1ULL << (s.runMode & 0x3)))) {
+            return std::make_shared<NodePtwFault>(
+                hsjuSub(s.runMode), va, faultPc);
+        }
+        if (fetch && !(pte & PteX)) {
+            return std::make_shared<NodePtwFault>(
+                SubNxPerm, va, faultPc);
+        }
+        if (write && !(pte & PteW)) {
+            return std::make_shared<NodePtwFault>(
+                SubNwPerm, va, faultPc);
+        }
+        if (!fetch && !write && !(pte & PteR)) {
+            return std::make_shared<NodePtwFault>(
+                SubNrPerm, va, faultPc);
+        }
+
+        // Fill the table of the side that missed: invalid-first/LRU victim,
+        // dirty write-back before replacement (ADR-0041 D4/D8).
+        if (fetch) {
+            return tlbInstall(s, s.itlb, s.itlbLru, s.itlbSp, s.itlbSpLru,
+                              superpage, va, pte, leafPa, write, req, faultPc,
+                              ramBase, ramSize);
+        }
+        return tlbInstall(s, s.dtlb, s.dtlbLru, s.dtlbSp, s.dtlbSpLru,
+                          superpage, va, pte, leafPa, write, req, faultPc,
+                          ramBase, ramSize);
+    }
+
+    // cfx_pmem SRAM (cfxha 32, internal offset 0x3ff_0000_0000).
+    const Addr off = va & NodeVaMask;
+    if (cfxha == CfxhaPmem) {
+        if (inRegion(kPmemCfxOffset, pmemSize, off, size)) {
+            req->setPaddr(pmemBase + (off - kPmemCfxOffset));
+            return NoFault;
+        }
+        // Out of the SRAM window ⇒ illegal internal-space access (CFXMEM),
+        // `cause_info` = the accessed internal address (DADAO-12 §4.1).
+        return machineFaultAt(FaultCFXMEM, faultPc, va);
+    }
+    // hmon / smon SRAM (cfxha 3 / 2, same internal offset).
+    if (cfxha == 3 || cfxha == 2) {
+        const Addr base = (cfxha == 3) ? hmonBase : smonBase;
+        const Addr len = (cfxha == 3) ? hmonSize : smonSize;
+        if (inRegion(kPmemCfxOffset, len, off, size)) {
+            req->setPaddr(base + (off - kPmemCfxOffset));
+            return NoFault;
+        }
+        return machineFaultAt(FaultCFXMEM, faultPc, va);
+    }
+    // BootROM: read/execute only; a store is ILLI (ADR-0004 D5.6) with
+    // `cause_info` = the instruction encoding (DADAO-12 §4.1) -- the word of
+    // the faulting instruction, recorded by DadaoInst::execute().
+    if (inRegion(romBase, romSize, va, size)) {
+        if (write)
+            return machineFaultAt(FaultILLI, faultPc, s.curInstWord);
+        req->setPaddr(va);
+        return NoFault;
+    }
+    // PA RAM (Node addresses it through PTW; kept for a direct profile).
+    if (inRegion(ramBase, ramSize, va, size)) {
+        req->setPaddr(va);
+        return NoFault;
+    }
+
+    if (nodeCfxReserved(cfxha))
+        return machineFaultAt(FaultCFXMEM, faultPc, va);
+    return machineFaultAt(FaultCFXMEM, faultPc, va);
+}
+
+void
+NodeTLB::demapPage(Addr vaddr, uint64_t asn)
+{
+    (void)vaddr;
+    (void)asn;
+}
+
+Fault
+NodeTLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
+                         BaseMMU::Mode mode)
+{
+    return translate(req, tc, mode, true);
+}
+
+void
+NodeTLB::translateTiming(const RequestPtr &req, ThreadContext *tc,
+                         BaseMMU::Translation *translation,
+                         BaseMMU::Mode mode)
+{
+    // Timed access (instruction fetch under a TimingSimpleCPU).  The TLB
+    // lookup and, on a miss, the two-level walk run inline: the walk costs
+    // **0 cycles** (m16-gem5-015 declares that explicitly in
+    // configs/dadao/fs.py, --cpu-type timing).  This call is the insert point
+    // for a walk latency: schedule `translation->finish(...)` after the walk
+    // cost instead of calling it inline, with the cost taken from the RTL.
+    translation->finish(translate(req, tc, mode, true), req, tc, mode);
+}
+
+Fault
+NodeTLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
+                             BaseMMU::Mode mode)
+{
+    return translate(req, tc, mode, false);
+}
+
+Fault
+NodeTLB::finalizePhysical(const RequestPtr &req, ThreadContext *tc,
+                          BaseMMU::Mode mode) const
+{
+    (void)req;
+    (void)tc;
+    (void)mode;
+    return NoFault;
+}
