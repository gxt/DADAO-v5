+// SE address-space convention (48-bit guest VA, ADR-0048 D1).  Not a spec
+// assertion and not shared with the FS memory window.  The mmap window top is
+// shared with the syscall layer (DadaoISA::MmapWindowEnd).
+constexpr Addr StackBase = 0x0000FFFFFFFF0000ULL;
+
+// MemRAS backing store: 1 MiB of guest-readable/writable pages.  Placed above
+// the mmap region and well below the stack so it cannot collide with either.
+constexpr Addr MemRasBase = 0x0000500000000000ULL;
+constexpr Addr MemRasSize = 1ULL << 20;
+
+// FCSR reset value (rf0): read-only quiet-NaN payload plus reset rounding mode
+// (ADR-0004 D2.1, contract-isa §1.3.3).
+constexpr uint64_t FcsrReset = 0x7FF800007FC00000ULL;
+
+// AT_RANDOM contents are a fixed pattern: SE has no security boundary and a
+// reproducible run is more useful than entropy.
+constexpr uint8_t AtRandomBytes[16] = {
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+    0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+};
+
+// ELF64 program header access for the image's per-segment permissions.  The
+// loader keeps the guest VA of the header table (e_phoff inside the first
+// PT_LOAD); the table has already been written when initState() runs.
+constexpr uint32_t PtLoad = 1;
+constexpr uint32_t PfExec = 1;
+constexpr uint32_t PfWrite = 2;
+constexpr uint32_t PfRead = 4;
+constexpr unsigned Elf64PhdrSize = 56;
+
+uint32_t
+readBe32(const uint8_t *p)
+{
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+           (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+uint64_t
+readBe64(const uint8_t *p)
+{
+    return (uint64_t(readBe32(p)) << 32) | readBe32(p + 4);
+}
+
+} // anonymous namespace
+
+DadaoISA::Process::Process(const ProcessParams &params, loader::ObjectFile *objFile) :
+    gem5::Process(params,
+                  new EmulationPageTable(params.name, params.pid, PageBytes),
+                  objFile)
+{
+    fatal_if(params.useArchPT,
+             "DADAO SE: architecture page tables are not supported");
+
+    // Tids are allocated after the pid so a thread's tid never collides with
+    // the main thread's (Linux allocates both from one space).
+    nextThreadTid = params.pid + 1;
+
+    const Addr max_stack_size = params.maxStackSize;
+    const Addr next_thread_stack_base = StackBase - max_stack_size;
+    const Addr brk_point = roundUp(image.maxAddr(), PageBytes);
+
+    memState = std::make_shared<MemState>(this, brk_point, StackBase,
+                                          max_stack_size,
+                                          next_thread_stack_base,
+                                          MmapWindowEnd);
+
+    // Resource limits (prlimit64): every resource starts unlimited except
+    // RLIMIT_NOFILE, which is the size of the emulated fd table -- that is
+    // the only fd space the guest can actually get, so reporting more would
+    // be a lie (Linux reports the kernel's own limit).
+    for (auto &limit : limits) {
+        limit.cur = RlimInfinity;
+        limit.max = RlimInfinity;
+    }
+    limits[RlimitNofile].cur = fds->getSize();
+    limits[RlimitNofile].max = fds->getSize();
+
+    validateStaticElf();
+}
+
+void
+DadaoISA::Process::validateStaticElf()
+{
+    fatal_if(objFile->getArch() != loader::Dadao,
+             "DADAO SE: object file is not DADAO (%s)",
+             loader::archToString(objFile->getArch()));
+    fatal_if(objFile->getByteOrder() != ByteOrder::big,
+             "DADAO SE: object file is not big-endian");
+
+    auto *elf = dynamic_cast<loader::ElfObject *>(objFile);
+    fatal_if(elf == nullptr, "DADAO SE: object file is not an ELF file");
+
+    // contract-elf §1/§1.3: ET_EXEC only, e_flags[7:0] == 1, e_flags[31:8] == 0.
+    fatal_if(elf->elfType() != ET_EXEC,
+             "DADAO SE: only ET_EXEC is supported (e_type=%u; ET_DYN/static "
+             "PIE is a later milestone)", elf->elfType());
+    fatal_if((elf->elfFlags() & 0xff) != 1,
+             "DADAO SE: unsupported object/ABI version e_flags[7:0]=%u",
+             elf->elfFlags() & 0xff);
+    fatal_if((elf->elfFlags() >> 8) != 0,
+             "DADAO SE: reserved e_flags[31:8] must be zero (0x%08x)",
+             elf->elfFlags());
+
+    // Dynamic linking is out of scope for G1: reject rather than ignore.
+    fatal_if(objFile->getInterpreter() != nullptr,
+             "DADAO SE: PT_INTERP (dynamic linking) is not supported");
+
+    const Addr stack_limit =
+        memState->getStackBase() - memState->getMaxStackSize();
+    const Addr entry = objFile->entryPoint();
+    bool entry_covered = false;
+
+    for (const auto &seg : image.segments()) {
+        fatal_if(seg.size == 0, "DADAO SE: empty loadable segment '%s'",
+                 seg.name);
+        // lld packs PT_LOAD segments back to back (only p_offset is aligned
+        // to p_align), so a segment base is 4-byte aligned, not 64 KiB.  The
+        // architectural requirement is instruction/word alignment; 8-byte
+        // object alignment is the linker's business inside the section.
+        fatal_if((seg.base & 3) != 0,
+                 "DADAO SE: segment '%s' base %#x is not 4-byte aligned",
+                 seg.name, seg.base);
+        fatal_if(seg.base + seg.size < seg.base,
+                 "DADAO SE: segment '%s' at %#x overflows the address space",
+                 seg.name, seg.base);
+        fatal_if(seg.base + seg.size > stack_limit,
+                 "DADAO SE: segment '%s' [%#x, %#x) intrudes into the stack "
+                 "reservation [%#x, %#x)", seg.name, seg.base,
+                 seg.base + seg.size, stack_limit,
+                 memState->getStackBase());
+        if (entry >= seg.base && entry < seg.base + seg.size)
+            entry_covered = true;
+    }
+
+    fatal_if((entry & 3) != 0,
+             "DADAO SE: entry point %#x is not 4-byte aligned", entry);
+    fatal_if(!entry_covered,
+             "DADAO SE: entry point %#x is outside every loadable segment",
+             entry);
+
+    const auto opsys = objFile->getOpSys();
+    fatal_if(opsys != loader::Linux && opsys != loader::UnknownOpSys,
+             "DADAO SE: unsupported operating system %d", opsys);
+}
