+void
+DadaoISA::Process::registerImageProtection(loader::ElfObject *elf)
+{
+    const Addr page = pTable->pageSize();
+    const unsigned count = elf->programHeaderCount();
+    const unsigned size = elf->programHeaderSize();
+    std::map<Addr, uint8_t> pages;
+
+    if (count != 0 && size >= Elf64PhdrSize) {
+        std::vector<uint8_t> raw(count * size);
+        if (initVirtMem->tryReadBlob(elf->programHeaderTable(), raw.data(),
+                                     raw.size())) {
+            for (unsigned i = 0; i < count; ++i) {
+                const uint8_t *ph = raw.data() + i * size;
+                if (readBe32(ph) != PtLoad)
+                    continue;
+                const uint32_t flags = readBe32(ph + 4);
+                const Addr vaddr = readBe64(ph + 16);
+                const Addr memsz = readBe64(ph + 40);
+                if (memsz == 0 || vaddr + memsz < vaddr)
+                    continue;
+                const uint8_t prot =
+                    ((flags & PfRead) ? ProtRead : 0) |
+                    ((flags & PfWrite) ? ProtWrite : 0) |
+                    ((flags & PfExec) ? ProtExec : 0);
+                for (Addr a = roundDown(vaddr, page);
+                     a < roundUp(vaddr + memsz, page); a += page)
+                    pages[a] |= prot;
+            }
+        }
+    }
+
+    // The PT_LOAD view is authoritative; also register any image section it
+    // did not cover (the legacy loader view), so the accounting sees every
+    // loaded page.  Such pages keep the pre-GEM5-030t RWX behaviour.
+    for (const auto &seg : image.segments()) {
+        if (seg.size == 0)
+            continue;
+        for (Addr a = roundDown(seg.base, page);
+             a < roundUp(seg.base + seg.size, page); a += page) {
+            if (pages.find(a) == pages.end())
+                pages[a] = ProtRead | ProtWrite | ProtExec;
+        }
+    }
+
+    // Install the page map as few ranges as possible.
+    for (auto it = pages.begin(); it != pages.end();) {
+        const Addr start = it->first;
+        const uint8_t prot = it->second;
+        Addr end = start + page;
+        auto next = std::next(it);
+        while (next != pages.end() && next->first == end &&
+               next->second == prot) {
+            end += page;
+            ++next;
+        }
+        setProtection(start, end, prot);
+        it = next;
+    }
+}
