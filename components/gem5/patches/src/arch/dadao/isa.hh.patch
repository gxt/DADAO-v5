diff --git a/src/arch/dadao/isa.hh b/src/arch/dadao/isa.hh
new file mode 100644
index 0000000..20a7495
--- /dev/null
+++ b/src/arch/dadao/isa.hh
@@ -0,0 +1,209 @@
+// DADAO ISA object (B0 skeleton + B6 LR/SC reservation state).
+#ifndef __ARCH_DADAO_ISA_HH__
+#define __ARCH_DADAO_ISA_HH__
+
+#include <cstdio>
+#include <vector>
+#include <string>
+
+#include "arch/dadao/node_cfx.hh"
+#include "arch/dadao/tiny_cfx.hh"
+#include "arch/dadao/pcstate.hh"
+#include "arch/dadao/regs/misc.hh"
+#include "arch/generic/isa.hh"
+#include "base/statistics.hh"
+
+namespace gem5
+{
+
+struct DadaoISAParams;
+class TimingExpr;
+class BaseTags;
+
+namespace DadaoISA
+{
+
+class ISA : public BaseISA
+{
+  public:
+    using Params = DadaoISAParams;
+
+    explicit ISA(const Params &p);
+    ~ISA() override;
+
+    PCStateBase *
+    newPCState(Addr addr = 0) const override
+    {
+        return new PCState(addr);
+    }
+
+    void clear() override;
+
+    // The architectural cfx/misc-register model (mode/cfx/trap state) and the
+    // privilege model are still not implemented: every access panics
+    // explicitly instead of returning a made-up value.  B6 implements the ISA
+    // side of the cfx instructions; the cfx register file itself is a platform
+    // model (see the B6 open questions).
+    RegVal readMiscRegNoEffect(RegIndex idx) const override;
+    RegVal readMiscReg(RegIndex idx) override;
+    void setMiscRegNoEffect(RegIndex idx, RegVal val) override;
+    void setMiscReg(RegIndex idx, RegVal val) override;
+
+    bool inUserMode() const override;
+
+    /** Extra cycles the timing CPU adds after ``inst`` before fetching the next
+     *  instruction (M16 wuming cycle model).  Zero unless the ISA was
+     *  configured with ``enable_wuming_cycles``; see wuming_latency.hh for the
+     *  row policy (static classes only, table value minus the one cycle the
+     *  TimingSimpleCPU already spends in execute()). */
+    Cycles extraExecLatency(const StaticInst *inst) const override;
+
+    /** Node architectural state (cfx register file, PTW, DMA, counters).
+     *  Only meaningful when nodeActive(); the SE and Tiny paths never read it. */
+    NodeState &nodeState() { return node; }
+    const NodeState &nodeState() const { return node; }
+
+    /** Tiny architectural state (cfx_power + cfx3 hmon).  Only meaningful
+     *  when tinyActive(); the SE and Vast paths never read it. */
+    TinyState &tinyState() { return tiny; }
+    const TinyState &tinyState() const { return tiny; }
+
+    /** Hidden RegRAS ring base (ADR-0012 D7.5): 0..62, reset 0, not
+     *  architecturally visible.  ra_i lives in physical slot
+     *  `1 + (rasBase + i) % 63`; ra0 is the header at slot 0.  `call`/`ret`
+     *  move this base instead of copying entries (exec/common.hh ras::phys()).
+     *  It is thread state, so it is serialized with the ISA object. */
+    unsigned rasBase() const { return rasBaseIdx; }
+    void
+    setRasBase(unsigned base)
+    {
+        panic_if(base >= 63,
+                 "DADAO ISA: RegRAS ring base %u is outside 0..62", base);
+        rasBaseIdx = base;
+    }
+
+    void serialize(CheckpointOut &cp) const override;
+    void unserialize(CheckpointIn &cp) override;
+
+    /** cfx_cache (cfx5) maintenance targets (m16-gem5-021).
+     *
+     *  The tag stores of the classic L1 I/D caches this hart drives, or
+     *  nullptr when `cache-model` is off (fs.py wires them only together
+     *  with `--caches`).  Non-null stores make `cfx_cache_exist` = 0b11 and
+     *  are the line directory that `all`/`PA 区间` maintenance selects from.
+     *  A null store means there is nothing to maintain: cfx5 still exists
+     *  and its registers stay accessible, but a command has no effect
+     *  (CACHE-27 `cache-model` dimension; m16-gem5-023). */
+    BaseTags *cfxItags() const { return cfxITagsStore; }
+    BaseTags *cfxDtags() const { return cfxDTagsStore; }
+
+    /** QEMU `-d cpu`-compatible trace channel (`--trace-cpu`).  A dump is
+     *  emitted at QEMU translation-block boundaries: the first instruction,
+     *  the instruction after a control transfer, a non-sequential PC, or a
+     *  forced exception boundary. */
+    bool tracing() const { return traceFile != nullptr; }
+    void traceInstruction(Addr pc, unsigned mode, bool control);
+
+    /** FS reset: Tiny architectural register values and PC = workload entry.
+     *  SE never calls this (the Process sets its own initial state). */
+    void resetThread() override;
+
+    // LR/SC reservation (B6): one slot per hart, keyed by the exact address and
+    // the access width (contract-isa §14.2, SPEC-181t F8.1).  No checkpoint
+    // state: after a restore an sc simply fails (spurious failure is allowed).
+    void setReservation(Addr addr, unsigned width);
+    bool hasReservation(Addr addr, unsigned width) const;
+    void clearReservations();
+
+    /** True while any hart of this system holds a reservation.  The store
+     *  path uses it to skip the per-store scan in the common case. */
+    static bool anyReservationHeld();
+
+    /** Every hart that currently holds a reservation.  The store path walks
+     *  this instead of every thread context of the system, which keeps the
+     *  single-threaded cost at zero extra iterations (only a hart that did an
+     *  `lr` and has not consumed it appears here). */
+    static const std::vector<ISA *> &reservationHolders();
+
+    /** Per-thread "a queued signal is not blocked" hint.  The SE instruction
+     *  loop tests it once per instruction, so a thread that is cancelled
+     *  while spinning in user code (no syscall in sight) still takes the
+     *  signal (GEM5-026t, musl's asynchronous cancellation). */
+    bool hasPendingSignal() const { return pendingSignal; }
+    void setPendingSignal(bool pending) { pendingSignal = pending; }
+
+    /** Guest data-memory accesses retired by the exec cores (m16-gem5-006).
+     *
+     *  Counted on every CPU model, so an Atomic-vs-Timing run of the same
+     *  corpus must report the same numbers: the two models differ in the
+     *  timing of a load/store, not in whether it happened. */
+    void noteDataAccess(bool write)
+    {
+        if (write)
+            dataMemWrites++;
+        else
+            dataMemReads++;
+    }
+
+    /** Address of the instruction entering `execute()` (m16-gem5-018).
+     *
+     *  The latency hook runs from `advanceInst()`, after `advancePC()`, so the
+     *  thread's pc state no longer names the executed instruction.  A block
+     *  transfer may use `rb0` (= current IP) as its base, and only the
+     *  instruction address can reconstruct that operand; `DadaoInst::execute`
+     *  records it before the instruction can move any register. */
+    void noteWumingInstAddr(Addr addr) { wumingInstAddr = addr; }
+
+  private:
+    /** Guest data-memory accesses retired by the exec cores (m16-gem5-006). */
+    statistics::Scalar dataMemReads;
+    statistics::Scalar dataMemWrites;
+
+    bool reservationValid = false;
+    Addr reservationAddr = 0;
+    unsigned reservationWidth = 0;
+
+    /** Hidden RegRAS ring base (0..62, reset 0); see rasBase(). */
+    unsigned rasBaseIdx = 0;
+
+    /** Wuming per-instruction cycle table switch (M16, off by default). */
+    bool wumingCycles = false;
+
+    /** Optional gem5 TimingExpr for the B1/B2 multiplier latency (m16-gem5-004;
+     *  NULL keeps the generated table default). */
+    TimingExpr *wumingMulExpr = nullptr;
+
+    /** MRPTR of the previous completed instruction (m16-gem5-004 RAS kind:
+     *  a call that pushed to MemRAS lowers MRPTR, a ret that popped from it
+     *  raises MRPTR; unchanged MRPTR means the RegRAS path). */
+    mutable uint64_t wumingLastMrptr = 0;
+    mutable bool wumingRasSeen = false;
+
+    /** Address of the instruction that entered `execute()` (m16-gem5-018). */
+    Addr wumingInstAddr = 0;
+
+    /** Harts that currently hold a reservation (store-side invalidation). */
+    static std::vector<ISA *> holders;
+
+    bool pendingSignal = false;
+
+    /** cfx_cache (cfx5) maintenance targets; null = no L1 wired (m16-gem5-021). */
+    BaseTags *cfxITagsStore = nullptr;
+    BaseTags *cfxDTagsStore = nullptr;
+
+    NodeState node;
+    TinyState tiny;
+    std::FILE *traceFile = nullptr;
+    Addr tracePrevPc = 0;
+    bool tracePrevControl = false;
+    bool traceStarted = false;
+
+  public:
+
+    void copyRegsFrom(ThreadContext *src) override;
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_ISA_HH__
