+
+/** clock_gettime(2). */
+RegVal
+doClockGettime(ThreadContext *tc, int clock_id, Addr tp_addr)
+{
+    int64_t sec = 0;
+    int64_t nsec = 0;
+
+    switch (clock_id) {
+      case CLOCK_REALTIME: {
+        // Wall-clock time stays host-backed (QEMU user mode passes it
+        // through too); the guest compares it against host file timestamps.
+        struct timespec now;
+        if (::clock_gettime(CLOCK_REALTIME, &now) < 0)
+            return static_cast<RegVal>(-errno);
+        sec = now.tv_sec;
+        nsec = now.tv_nsec;
+        break;
+      }
+      case CLOCK_MONOTONIC:
+      case CLOCK_PROCESS_CPUTIME_ID:
+      case CLOCK_THREAD_CPUTIME_ID: {
+        // Simulated nanoseconds, derived from curTick() at the GEM5-019t
+        // 1e9-ticks/s baseline.  SE is single-threaded, so thread CPU time
+        // and process CPU time are the same simulated-time counter.
+        const uint64_t elapsed = simulatedNanoseconds();
+        sec = elapsed / 1000000000ULL;
+        nsec = elapsed % 1000000000ULL;
+        break;
+      }
+      default:
+        return static_cast<RegVal>(-EINVAL);
+    }
+
+    uint8_t raw[GuestTimespecSize];
+    packGuestTimespec(raw, sec, nsec);
+    if (!writeGuestBlob(tc, tp_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** clock_getres(2). */
+RegVal
+doClockGetres(ThreadContext *tc, int clock_id, Addr tp_addr)
+{
+    switch (clock_id) {
+      case CLOCK_REALTIME:
+      case CLOCK_MONOTONIC:
+      case CLOCK_PROCESS_CPUTIME_ID:
+      case CLOCK_THREAD_CPUTIME_ID:
+        break;
+      default:
+        return static_cast<RegVal>(-EINVAL);
+    }
+
+    if (tp_addr != 0) {
+        uint8_t raw[GuestTimespecSize];
+        packGuestTimespec(raw, 0, 1);
+        if (!writeGuestBlob(tc, tp_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** gettimeofday(2). */
+RegVal
+doGettimeofday(ThreadContext *tc, Addr tv_addr, Addr tz_addr)
+{
+    struct timeval now;
+    if (::gettimeofday(&now, nullptr) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestTimevalSize];
+    writeBigEndian64(raw, now.tv_sec);
+    writeBigEndian64(raw + 8, now.tv_usec);
+    if (!writeGuestBlob(tc, tv_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+
+    if (tz_addr != 0) {
+        uint8_t tz[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+        if (!writeGuestBlob(tc, tz_addr, tz, sizeof(tz)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** nanosleep(2).
+ *
+ * SE has no other runnable work, so actually sleeping would only stall the
+ * host process; the request is validated (Linux EINVAL rules) and succeeds
+ * immediately, which is gem5's existing SE convention.  The limitation is
+ * recorded in README.
+ */
+RegVal
+doNanosleep(ThreadContext *tc, Addr req_addr)
+{
+    uint8_t raw[GuestTimespecSize];
+    if (!readGuestBlob(tc, req_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+
+    const int64_t sec = readBigEndian64(raw);
+    const int64_t nsec = readBigEndian64(raw + 8);
+    if (sec < 0 || nsec < 0 || nsec >= 1000000000LL)
+        return static_cast<RegVal>(-EINVAL);
+    return 0;
+}
+
+/** time(2). */
+RegVal
+doTime(ThreadContext *tc, Addr tloc_addr)
+{
+    const time_t now = ::time(nullptr);
+    if (now == static_cast<time_t>(-1))
+        return static_cast<RegVal>(-errno);
+    if (tloc_addr != 0) {
+        uint8_t raw[8];
+        writeBigEndian64(raw, now);
+        if (!writeGuestBlob(tc, tloc_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return static_cast<RegVal>(now);
+}
+
+/** First page of the heap: the heap must never unmap the loaded image. */
+Addr
+heapFloor(DadaoISA::Process *process)
+{
+    return roundUp(process->image.maxAddr(), process->pTable->pageSize());
+}
+
+/** brk(2): move the program break (the anonymous heap).
+ *
+ * Linux semantics (the reference for numbers, flags and errno is the locked
+ * upstream table, contract-syscall §1.2/§5): brk(0) queries and returns the
+ * current break; a successful move returns the new break; a failed one
+ * returns the *old* break and never -ENOMEM.  The heap may neither unmap the
+ * loaded image nor grow past the SE mmap window (the two share [image end,
+ * MmapWindowEnd) and grow towards each other, as they do on Linux).  Pages
+ * are mapped lazily: the VMA is registered here and the physical page is
+ * allocated on first touch by MemState::fixupFault(), the same path the stack
+ * uses.
+ */
+RegVal
+doBrk(DadaoISA::Process *process, Addr new_brk)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr old_brk = mem_state->getBrkPoint();
+    const Addr heap_limit =
+        std::min<Addr>(mem_state->getStackMin(), DadaoISA::MmapWindowEnd);
+
+    if (new_brk == 0 || new_brk == old_brk)
+        return old_brk;
+
+    if (new_brk < heapFloor(process) || new_brk > heap_limit)
+        return old_brk;
+
+    mem_state->updateBrkRegion(old_brk, new_brk);
+    return mem_state->getBrkPoint();
+}
+
+/** Place an anonymous mapping of `length` bytes in the SE mmap window.
+ *
+ * The window grows downwards from its top (MmapWindowEnd); 0 means the window
+ * is exhausted.  The scan is bounded by the image end so an address-space
+ * fill cannot walk into the loaded image (whose pages have no VMA).
+ */
+Addr
+extendMmap(DadaoISA::Process *process, Addr length)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr floor = heapFloor(process);
+    Addr start = mem_state->getMmapEnd();
+
+    while (start >= floor && start - floor >= length) {
+        start -= length;
+        if (mem_state->isUnmapped(start, length)) {
+            mem_state->setMmapEnd(start);
+            return start;
+        }
+        start -= page_bytes;
+    }
+    return 0;
+}
+
+/** mmap(2) for anonymous memory (MAP_PRIVATE|MAP_SHARED, MAP_FIXED). */
+RegVal
+doMmap(DadaoISA::Process *process, Addr hint, uint64_t length, uint64_t prot,
+       uint64_t flags, int fd, uint64_t offset)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (length == 0)
+        return static_cast<RegVal>(-EINVAL);
+    if (offset & (page_bytes - 1))
+        return static_cast<RegVal>(-EINVAL);
+    if (prot & ~(ProtRead | ProtWrite | ProtExec))
+        return static_cast<RegVal>(-EINVAL);
+
+    const bool is_private = flags & MapPrivate;
+    const bool is_shared = flags & MapShared;
+    if (is_private == is_shared)  // exactly one of the two is required
+        return static_cast<RegVal>(-EINVAL);
+
+    if (length > max_addr - page_bytes)
+        return static_cast<RegVal>(-ENOMEM);
+    length = roundUp(length, page_bytes);
+    if (length > max_addr - hint)
+        return static_cast<RegVal>(-ENOMEM);
+
+    if (!(flags & MapAnonymous)) {
+        // A descriptor is only valid when it is actually open.  A valid but
+        // non-mappable descriptor (stdin/stdout/stderr here) gets ENODEV,
+        // which is what Linux reports for fds without an mmap method.
+        if (fd < 0 || fd >= process->fds->getSize() ||
+            !(*process->fds)[fd])
+            return static_cast<RegVal>(-EBADF);
+        return static_cast<RegVal>(-ENODEV);
+    }
+
+    const Addr floor = heapFloor(process);
+    const bool fixed = flags & (MapFixed | MapFixedNoreplace);
+
+    if (fixed) {
+        // MAP_FIXED requires an aligned address (Linux: EINVAL otherwise).
+        if (hint & (page_bytes - 1))
+            return static_cast<RegVal>(-EINVAL);
+        // The SE guest VA convention bounds anonymous mappings to the mmap
+        // window; outside of it there is no guest memory to map.
+        if (hint < floor || hint + length > DadaoISA::MmapWindowEnd)
+            return static_cast<RegVal>(-ENOMEM);
+        if (flags & MapFixedNoreplace) {
+            if (!mem_state->isUnmapped(hint, length))
+                return static_cast<RegVal>(-EEXIST);
+        } else {
+            // Linux replaces whatever is mapped in the range (VMAs and any
+            // allocated pages), which is also how the heap guard page of
+            // mallocng is installed below the current break.
+            mem_state->unmapRegion(hint, length);
+        }
+    } else {
+        // Without MAP_FIXED the address is only a hint: Linux rounds it down
+        // to a page boundary and falls back to its own placement if taken.
+        hint &= ~(page_bytes - 1);
+        const bool use_hint = hint != 0 && hint >= floor &&
+                              hint + length <= DadaoISA::MmapWindowEnd &&
+                              mem_state->isUnmapped(hint, length);
+        if (!use_hint) {
+            hint = extendMmap(process, length);
+            if (hint == 0)
+                return static_cast<RegVal>(-ENOMEM);
+        }
+    }
+
+    mem_state->mapRegion(hint, length, "anon");
+    return hint;
+}
+
+/** munmap(2): drop the VMA and the physical pages of the range. */
+RegVal
+doMunmap(DadaoISA::Process *process, Addr start, uint64_t length)
+{
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (!length || (start & (page_bytes - 1)) || length > max_addr - start)
+        return static_cast<RegVal>(-EINVAL);
+
+    const Addr mapped = roundUp(length, page_bytes);
+
+    // unmapRegion() also flushes the TLB and deallocates the pages, so a
+    // later access faults (SE has no protection bits, but it does have the
+    // host page table: an unmapped page is a real fault).
+    process->memState->unmapRegion(start, mapped);
+
+    // Let the next anonymous mapping reuse the freed top of the window.  The
+    // kernel does this; without it a probe/fill sequence such as libc-test's
+    // t_vmfill() (mmap a candidate size, munmap it, then mmap the accepted
+    // size) leaks every probe range above MemState's mmap end.
+    if (start + mapped > process->memState->getMmapEnd() &&
+        start + mapped <= DadaoISA::MmapWindowEnd)
+        process->memState->setMmapEnd(start + mapped);
+    return 0;
+}
+
+/** mremap(2): resize/move an existing mapping (mallocng realloc path).
+ *
+ * The kernel rounds both lengths up to the page size before doing anything,
+ * which is also how a guest page size of 64 KiB is honoured (mallocng works
+ * in 4096-byte granules internally).
+ */
+RegVal
+doMremap(DadaoISA::Process *process, Addr old_addr, uint64_t old_size,
+         uint64_t new_size, uint64_t flags, Addr new_addr)
+{
+    constexpr uint64_t MremapMaymove = 0x1;
+    constexpr uint64_t MremapFixed = 0x2;
+    constexpr uint64_t MremapDontunmap = 0x4;
+
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (!old_size || !new_size || (old_addr & (page_bytes - 1)))
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & ~(MremapMaymove | MremapFixed | MremapDontunmap))
+        return static_cast<RegVal>(-EINVAL);
+    if ((flags & MremapFixed) && !(flags & MremapMaymove))
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & MremapDontunmap)
+        return static_cast<RegVal>(-EINVAL);  // not modelled
+    if (old_size > max_addr - old_addr || new_size > max_addr - page_bytes)
+        return static_cast<RegVal>(-EINVAL);
+
+    old_size = roundUp(old_size, page_bytes);
+    new_size = roundUp(new_size, page_bytes);
+
+    // mremap only moves memory that is actually mapped.
+    if (mem_state->isUnmapped(old_addr, old_size))
+        return static_cast<RegVal>(-EFAULT);
+
+    const bool fixed = flags & MremapFixed;
+
+    if (!fixed && new_size <= old_size) {
+        if (new_size < old_size)
+            mem_state->unmapRegion(old_addr + new_size, old_size - new_size);
+        return old_addr;
+    }
+
+    // Plain growth may extend in place when the window has room.  A fixed
+    // request always moves to the requested address.
+    const Addr grow = new_size > old_size ? new_size - old_size : 0;
+    const Addr old_end = old_addr + old_size;
+    if (!fixed && grow > 0 && old_end <= DadaoISA::MmapWindowEnd &&
+        grow <= DadaoISA::MmapWindowEnd - old_end &&
+        mem_state->isUnmapped(old_end, grow)) {
+        mem_state->mapRegion(old_end, grow, "anon");
+        return old_addr;
+    }
+    if (!(flags & MremapMaymove))
+        return static_cast<RegVal>(-ENOMEM);
+
+    Addr dest;
+    if (fixed) {
+        if ((new_addr & (page_bytes - 1)) ||
+            new_addr < heapFloor(process) ||
+            new_addr > max_addr - new_size ||
+            new_addr + new_size > DadaoISA::MmapWindowEnd)
+            return static_cast<RegVal>(-EINVAL);
+        // Linux rejects a MREMAP_FIXED target that overlaps the old range
+        // (including the same start), so the old pages are never both the
+        // source and the destination of the move.
+        if (new_addr < old_end && old_addr < new_addr + new_size)
+            return static_cast<RegVal>(-EINVAL);
+        dest = new_addr;
+    } else {
+        dest = extendMmap(process, new_size);
+        if (dest == 0)
+            return static_cast<RegVal>(-ENOMEM);
+    }
+
+    // remapRegion() moves both the VMA slices and the existing page table
+    // entries; the pages that were never touched stay lazy at the new
+    // address.  The grown tail is a fresh VMA and a shrunk tail is dropped.
+    const Addr move_len = std::min(old_size, new_size);
+    mem_state->remapRegion(old_addr, dest, move_len);
+    if (new_size > move_len)
+        mem_state->mapRegion(dest + move_len, new_size - move_len, "anon");
+    if (old_size > move_len)
+        mem_state->unmapRegion(old_addr + move_len, old_size - move_len);
+    return dest;
+}
+
+/** mprotect(2).
+ *
+ * SE keeps no per-page permission state (the DADAO SE TLB translates straight
+ * through the host page table; gem5's RISC-V SE maps mprotect to ignoreFunc).
+ * The request is validated and accepted, but PROT_NONE is not enforced: this
+ * is a recorded SE limitation, not a silent success of an unimplemented call.
+ */
+RegVal
+doMprotect(DadaoISA::Process *process, Addr start, uint64_t length,
+           uint64_t prot)
+{
+    const Addr page_bytes = process->pTable->pageSize();
+
+    if (length == 0)
+        return 0;
+    if (start & (page_bytes - 1))
+        return static_cast<RegVal>(-EINVAL);
+    if (prot & ~(ProtRead | ProtWrite | ProtExec))
+        return static_cast<RegVal>(-EINVAL);
+    return 0;
+}
+
+class DadaoLoader : public Process::Loader
+{
+  public:
+    Process *
+    load(const ProcessParams &params, loader::ObjectFile *obj) override
+    {
+        if (obj->getArch() != loader::Dadao)
+            return nullptr;
+
+        loader::OpSys opsys = obj->getOpSys();
+        if (opsys == loader::UnknownOpSys) {
+            warn("Unknown operating system; assuming Linux.");
+            opsys = loader::Linux;
+        }
+        if (opsys != loader::Linux)
+            return nullptr;
+
+        return new DadaoISA::Process(params, obj);
+    }
+};
+
+DadaoLoader dadaoLoader;
+
+} // anonymous namespace
+
+namespace DadaoISA
+{
+
+void
+SEWorkload::syscall(ThreadContext *tc)
+{
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    fatal_if(process == nullptr, "DADAO SE: syscall on a non-DADAO process");
+
+    // Statistics only; the base implementation does no dispatch.
+    process->gem5::Process::syscall(tc);
+
+    const uint64_t nr = tc->getReg(rd(15));
+    const Addr pc = tc->pcState().instAddr();
+    RegVal result = 0;
+
+    switch (nr) {
+      case SysExit:
+      case SysExitGroup: {
+        // contract-syscall §6: process exit is a syscall, not an exit port.
+        // The status is truncated to 8 bits, exactly like exitImpl.
+        const int status = static_cast<int>(tc->getReg(rd(16)));
+        tc->halt();
+        exitSimLoop("exiting with last active thread context", status & 0xff);
+        return; // not reached
+      }
+
+      case SysIoctl: {
+        // musl's __stdout_write() probes TIOCGWINSZ once before printf's first
+        // flush; a non-tty returns -ENOTTY and musl falls back to full
+        // buffering.  Only the two terminal probes of the static-musl startup
+        // surface are answered; any other request is an explicit failure.
+        const uint64_t req = tc->getReg(rd(17));
+        if (req == 0x5413 /* TIOCGWINSZ */ || req == 0x5401 /* TCGETS */) {
+            result = static_cast<RegVal>(-ENOTTY);
+            break;
+        }
+        fatal("DADAO SE: ioctl request %#x not implemented (pc=%#x)", req, pc);
+      }
+
+      case SysSetTidAddress: {
+        // musl __init_tp calls this unconditionally before main().
+        process->childClearTID = tc->getReg(rb(16));
+        result = process->pid();
+        break;
+      }
+
+      // Guest memory management (contract-syscall §3: pointers in rb, scalars
+      // in rd, both banks counted from 16).
+      case SysBrk: {
+        result = doBrk(process, tc->getReg(rb(16)));
+        break;
+      }
+
+      case SysMmap: {
+        const Addr hint = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        const uint64_t prot = tc->getReg(rd(17));
+        const uint64_t flags = tc->getReg(rd(18));
+        const int fd = static_cast<int>(tc->getReg(rd(19)));
+        const uint64_t offset = tc->getReg(rd(20));
+        result = doMmap(process, hint, length, prot, flags, fd, offset);
+        break;
+      }
+
+      case SysMunmap: {
+        const Addr start = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        result = doMunmap(process, start, length);
+        break;
+      }
+
+      case SysMremap: {
+        // contract-syscall §3 type-based banks: old_addr and new_addr are
+        // pointers (rb16/rb17), the three sizes/flags are data (rd16-rd18).
+        const Addr old_addr = tc->getReg(rb(16));
+        const uint64_t old_size = tc->getReg(rd(16));
+        const uint64_t new_size = tc->getReg(rd(17));
+        const uint64_t flags = tc->getReg(rd(18));
+        const Addr new_addr = tc->getReg(rb(17));
+        result = doMremap(process, old_addr, old_size, new_size, flags,
+                          new_addr);
+        break;
+      }
+
+      case SysMprotect: {
+        const Addr start = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        const uint64_t prot = tc->getReg(rd(17));
+        result = doMprotect(process, start, length, prot);
+        break;
+      }
+
+      // File descriptor and file I/O surface (GEM5-023t).  Argument banks:
+      // scalars in rd16.. and pointers in rb16.. (contract-syscall §3).
+      case SysDup: {
+        result = doDup(process, static_cast<int>(tc->getReg(rd(16))));
+        break;
+      }
+
+      case SysDup3: {
+        const int old_fd = static_cast<int>(tc->getReg(rd(16)));
+        const int new_fd = static_cast<int>(tc->getReg(rd(17)));
+        const uint64_t flags = tc->getReg(rd(18));
+        result = doDup3(process, old_fd, new_fd, flags);
+        break;
+      }
+
+      case SysFcntl: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const int cmd = static_cast<int>(tc->getReg(rd(17)));
+        // fcntl's kernel prototype is (fd, cmd, unsigned long arg), so musl's
+        // argmask keeps all three in the RD bank -- a lock pointer arrives as
+        // the integer value in rd18, not as an RB pointer (contract-syscall
+        // §3 assigns banks by the *syscall* prototype; arch/dadao/
+        // syscall_arch.h lists SYS_fcntl in the mask-0 set).
+        const uint64_t arg = tc->getReg(rd(18));
+        result = doFcntl(tc, process, fd, cmd, arg);
+        break;
+      }
+
+      case SysOpenat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const uint64_t flags = tc->getReg(rd(17));
+        const uint32_t mode = tc->getReg(rd(18));
+        result = doOpenat(tc, process, dirfd, path, flags, mode);
+        break;
+      }
+
+      case SysClose: {
+        result = doClose(process, static_cast<int>(tc->getReg(rd(16))));
+        break;
+      }
+
+      case SysRead: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doRead(tc, process, fd, buf, count);
+        break;
+      }
+
+      case SysReadv: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr iov = tc->getReg(rb(16));
+        const uint64_t iovcnt = tc->getReg(rd(17));
+        result = doReadv(tc, process, fd, iov, iovcnt);
+        break;
+      }
+
+      case SysPread64: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        const int64_t offset = static_cast<int64_t>(tc->getReg(rd(18)));
+        result = doPread64(tc, process, fd, buf, count, offset);
+        break;
+      }
+
+      case SysLseek: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const int64_t offset = static_cast<int64_t>(tc->getReg(rd(17)));
+        const int whence = static_cast<int>(tc->getReg(rd(18)));
+        result = doLseek(process, fd, offset, whence);
+        break;
+      }
+
+      case SysFstat: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr stat_addr = tc->getReg(rb(16));
+        result = doFstat(tc, process, fd, stat_addr);
+        break;
+      }
+
+      case SysNewfstatat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr stat_addr = tc->getReg(rb(17));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doNewfstatat(tc, process, dirfd, path, stat_addr, flags);
+        break;
+      }
+
+      case SysStatfs: {
+        const Addr path = tc->getReg(rb(16));
+        const Addr buf = tc->getReg(rb(17));
+        result = doStatfs(tc, process, path, buf);
+        break;
+      }
+
+      case SysFaccessat:
+      case SysFaccessat2: {
+        // faccessat2 is the flag-carrying form musl tries first when the
+        // caller passes AT_EACCESS/AT_SYMLINK_NOFOLLOW; both share one body.
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const int mode = static_cast<int>(tc->getReg(rd(17)));
+        const int flags = static_cast<int>(tc->getReg(rd(18)));
+        result = doFaccessat(tc, process, dirfd, path, mode, flags);
+        break;
+      }
+
+      case SysGetdents64: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr dir_addr = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doGetdents64(tc, process, fd, dir_addr, count);
+        break;
+      }
+
+      case SysUtimensat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr times = tc->getReg(rb(17));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doUtimensat(tc, process, dirfd, path, times, flags);
+        break;
+      }
+
+      case SysReadlinkat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr buf = tc->getReg(rb(17));
+        const uint64_t bufsiz = tc->getReg(rd(17));
+        result = doReadlinkat(tc, process, dirfd, path, buf, bufsiz);
+        break;
+      }
+
+      case SysUnlinkat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doUnlinkat(tc, process, dirfd, path, flags);
+        break;
+      }
+
+      case SysMkdirat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const uint32_t mode = tc->getReg(rd(17));
+        result = doMkdirat(tc, process, dirfd, path, mode);
+        break;
+      }
+
+      // Clock surface (GEM5-023t): the monotonic/CPU clocks are simulated
+      // time at the GEM5-019t 1e9-ticks/s baseline; REALTIME/gettimeofday/
+      // time stay host-backed like QEMU user mode so file timestamps compare
+      // correctly.
+      case SysClockGettime: {
+        const int clock_id = static_cast<int>(tc->getReg(rd(16)));
+        const Addr tp = tc->getReg(rb(16));
+        result = doClockGettime(tc, clock_id, tp);
+        break;
+      }
+
+      case SysClockGetres: {
+        const int clock_id = static_cast<int>(tc->getReg(rd(16)));
+        const Addr tp = tc->getReg(rb(16));
+        result = doClockGetres(tc, clock_id, tp);
+        break;
+      }
+
+      case SysGettimeofday: {
+        const Addr tv = tc->getReg(rb(16));
+        const Addr tz = tc->getReg(rb(17));
+        result = doGettimeofday(tc, tv, tz);
+        break;
+      }
+
+      case SysNanosleep: {
+        const Addr req = tc->getReg(rb(16));
+        result = doNanosleep(tc, req);
+        break;
+      }
+
+      case SysTimeLegacy: {
+        const Addr tloc = tc->getReg(rb(16));
+        result = doTime(tc, tloc);
+        break;
+      }
+
+      case SysWrite: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doWrite(tc, process, fd, buf, count);
+        break;
+      }
+
+      case SysWritev: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr iov = tc->getReg(rb(16));
+        const uint64_t iovcnt = tc->getReg(rd(17));
+
+        if (iovcnt > 1024) {
+            result = static_cast<RegVal>(-EINVAL);
+            break;
+        }
+
+        std::vector<uint8_t> raw(iovcnt * 16);
+        if (iovcnt > 0) {
+            SETranslatingPortProxy proxy(tc, SETranslatingPortProxy::Never);
+            if (!proxy.tryReadBlob(iov, raw.data(), raw.size())) {
+                result = static_cast<RegVal>(-EFAULT);
+                break;
+            }
+        }
+
+        RegVal total = 0;
+        bool failed = false;
+        for (uint64_t i = 0; i < iovcnt; ++i) {
+            // struct iovec (contract-abi §1.7): {base, len}, 8 bytes each, BE.
+            const uint64_t base = readBigEndian64(&raw[i * 16]);
+            const uint64_t len = readBigEndian64(&raw[i * 16 + 8]);
+            const int64_t written =
+                static_cast<int64_t>(doWrite(tc, process, fd, base, len));
+            if (written < 0) {
+                result = total > 0 ? total : static_cast<RegVal>(written);
+                failed = true;
+                break;
+            }
+            total += static_cast<RegVal>(written);
+        }
+        if (!failed)
+            result = total;
+        break;
+      }
+
+      default:
+        // 2026-11-02 decision: an unsupported syscall is a hard, explicit
+        // failure with the number and the trapping pc -- never a silent
+        // -ENOSYS/0 continuation.
+        fatal("DADAO SE: syscall %d not implemented (pc=%#x)",
+              static_cast<int>(nr), pc);
+    }
+
+    tc->setReg(rd(8), result);
+}
+
+} // namespace DadaoISA
+} // namespace gem5
