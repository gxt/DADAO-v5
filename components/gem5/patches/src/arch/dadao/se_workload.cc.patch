+namespace DadaoISA
+{
+
+void
+Process::memoryFault(ThreadContext *tc, Addr vaddr, int siCode)
+{
+    if (hasExited)
+        return;
+    const Addr resumePc = tc->pcState().instAddr();
+    // A fault is delivered "on the way to user mode", like a self-raised
+    // signal: build the frame, redirect the PC and return.  sigreturn resumes
+    // at the faulting instruction, which faults again -- the same loop Linux
+    // has for a handler that returns.
+    if (!deliverSignal(tc, this, SigSegv, resumePc, siCode, vaddr)) {
+        // SIG_DFL already terminated inside deliverSignal(); SIG_IGN is
+        // undefined for SIGSEGV on Linux, so fail closed rather than let the
+        // instruction silently retry forever.
+        if (!hasExited)
+            terminateWithSignal(tc, SigSegv);
+    }
+}
+
+bool
+SEWorkload::deliverPendingSignal(ThreadContext *tc)
+{
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    if (process == nullptr || process->hasExited)
+        return false;
+    DadaoISA::ThreadState *thread = process->findThread(tc->contextId());
+    if (thread == nullptr)
+        return false;
+    if ((thread->pending & ~thread->blocked) == 0) {
+        syncPendingSignal(process, *thread);
+        return false;
+    }
+
+    const Addr resumePc = tc->pcState().instAddr();
+    maybeDeliverSignals(tc, process, resumePc);
+    syncPendingSignal(process, *thread);
+    // Only a handler entry moves the PC; an ignored signal must let the
+    // interrupted instruction run normally.
+    return process->hasExited || tc->pcState().instAddr() != resumePc;
+}
+
+void
+SEWorkload::syscall(ThreadContext *tc)
+{
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    fatal_if(process == nullptr, "DADAO SE: syscall on a non-DADAO process");
+
+    // Statistics only; the base implementation does no dispatch.
+    process->gem5::Process::syscall(tc);
+
+    const uint64_t nr = tc->getReg(rd(15));
+    const Addr pc = tc->pcState().instAddr();
+    RegVal result = 0;
+    // Set by a syscall that cannot make progress yet: the CPU re-executes the
+    // trap instead of seeing a (wrong) result (see inst.cc, SyscallRetryFault).
+    bool retry = false;
+    bool suspendSelf = false;
+    bool futexParked = false;
+    bool sleepParked = false;
+    syscallRetry = false;
+
+    switch (nr) {
+      case SysExit:
+      case SysExitGroup: {
+        // contract-syscall §6: process exit is a syscall, not an exit port.
+        // The status is truncated to 8 bits, exactly like exitImpl.
+        const int status = static_cast<int>(tc->getReg(rd(16)));
+        doExit(tc, process, status, 0, nr == SysExitGroup);
+        return; // not reached
+      }
+
+      case SysIoctl: {
+        // musl's __stdout_write() probes TIOCGWINSZ once before printf's first
+        // flush; a non-tty returns -ENOTTY and musl falls back to full
+        // buffering.  Only the two terminal probes of the static-musl startup
+        // surface are answered; any other request is an explicit failure.
+        const uint64_t req = tc->getReg(rd(17));
+        if (req == 0x5413 /* TIOCGWINSZ */ || req == 0x5401 /* TCGETS */) {
+            result = static_cast<RegVal>(-ENOTTY);
+            break;
+        }
+        fatal("DADAO SE: ioctl request %#x not implemented (pc=%#x)", req, pc);
+      }
+
+      case SysSetTidAddress: {
+        // musl __init_tp calls this unconditionally in every thread; the
+        // address is per thread and is cleared (with a futex wake) on exit.
+        DadaoISA::ThreadState &thread = threadOf(process, tc);
+        thread.clearTid = tc->getReg(rb(16));
+        result = thread.tid;
+        break;
+      }
+
+      // Threads and futexes (GEM5-026t).  The futex argument banks follow
+      // musl's __dadao_argmask mask 0x19: address arguments sit in slots 0, 3
+      // and 4, so uaddr -> rb16, utime -> rb17, uaddr2 -> rb18; op/val/val3
+      // are integers in rd16/rd17/rd18.
+      case SysFutex: {
+        result = doFutex(tc, process, tc->getReg(rb(16)),
+                         tc->getReg(rd(16)),
+                         static_cast<uint32_t>(tc->getReg(rd(17))),
+                         tc->getReg(rb(17)), tc->getReg(rb(18)),
+                         static_cast<uint32_t>(tc->getReg(rd(18))),
+                         futexParked);
+        if (futexParked)
+            return; // the result is written when the wait is completed
+        break;
+      }
+
+      case SysSetRobustList: {
+        const Addr head = tc->getReg(rb(16));
+        const uint64_t len = tc->getReg(rd(16));
+        // The kernel only accepts sizeof(struct robust_list_head) on 64-bit
+        // (three 8-byte fields); musl passes exactly that.
+        if (len != 24)
+            result = static_cast<RegVal>(-EINVAL);
+        else {
+            DadaoISA::ThreadState &thread = threadOf(process, tc);
+            thread.robustList = head;
+            thread.robustLen = len;
+            result = 0;
+        }
+        break;
+      }
+
+      case SysGetRobustList: {
+        const int pid = static_cast<int>(tc->getReg(rd(16)));
+        const Addr headPtr = tc->getReg(rb(16));
+        const Addr lenPtr = tc->getReg(rb(17));
+        DadaoISA::ThreadState *thread = &threadOf(process, tc);
+        if (pid != 0 && pid != thread->tid)
+            thread = process->findThreadByTid(pid);
+        if (thread == nullptr)
+            result = static_cast<RegVal>(-ESRCH);
+        else {
+            // Linux reports the registered head (NULL until set_robust_list)
+            // and always sizeof(struct robust_list_head) as the length.
+            uint8_t raw[8];
+            writeBigEndian64(raw, thread->robustList);
+            bool ok = writeGuestBlob(tc, headPtr, raw, sizeof(raw));
+            writeBigEndian64(raw, sizeof(uint64_t) * 3);
+            ok = writeGuestBlob(tc, lenPtr, raw, sizeof(raw)) && ok;
+            result = ok ? 0 : static_cast<RegVal>(-EFAULT);
+        }
+        break;
+      }
+
+      // Signals (GEM5-024t).  Argument banks follow contract-syscall §3 and
+      // musl's __dadao_argmask (arch/dadao/syscall_arch.h).
+      case SysKill: {
+        result = doKill(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                        static_cast<int>(tc->getReg(rd(17))), SiUser);
+        break;
+      }
+
+      case SysTkill: {
+        // tkill(tid, sig) names a thread of the calling process.
+        result = doThreadKill(process, static_cast<int>(tc->getReg(rd(16))),
+                              static_cast<int>(tc->getReg(rd(17))), SiTkill);
+        break;
+      }
+
+      case SysTgkill: {
+        const int tgid = static_cast<int>(tc->getReg(rd(16)));
+        const int tid = static_cast<int>(tc->getReg(rd(17)));
+        result = doTgkill(process, tgid, tid,
+                          static_cast<int>(tc->getReg(rd(18))));
+        break;
+      }
+
+      case SysSigaltstack: {
+        result = doSigaltstack(tc, process, tc->getReg(rb(16)),
+                               tc->getReg(rb(17)));
+        break;
+      }
+
+      case SysRtSigaction: {
+        result = doSigaction(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                             tc->getReg(rb(16)), tc->getReg(rb(17)),
+                             tc->getReg(rd(17)));
+        break;
+      }
+
+      case SysRtSigprocmask: {
+        result = doSigprocmask(tc, process,
+                               static_cast<int>(tc->getReg(rd(16))),
+                               tc->getReg(rb(16)), tc->getReg(rb(17)),
+                               tc->getReg(rd(17)));
+        break;
+      }
+
+      case SysRtSigpending: {
+        result = doSigpending(tc, process, tc->getReg(rb(16)),
+                              tc->getReg(rd(16)));
+        break;
+      }
+
+      case SysRtSigreturn: {
+        // No return value: sigreturn restores the whole interrupted context.
+        doSigreturn(tc, process);
+        return;
+      }
+
+      // Process information (GEM5-024t).  Identity matches the host (the
+      // same owner the stat* layer reports, so libc-test's st_uid==geteuid()
+      // holds); pid/ppid are the SE process's own ids.
+      case SysGetcwd: {
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t size = tc->getReg(rd(16));
+        const std::string &cwd = process->tgtCwd;
+        if (size < cwd.size() + 1) {
+            result = static_cast<RegVal>(-ERANGE);
+            break;
+        }
+        if (!writeGuestBlob(tc, buf, cwd.c_str(), cwd.size() + 1)) {
+            result = static_cast<RegVal>(-EFAULT);
+            break;
+        }
+        result = static_cast<RegVal>(cwd.size() + 1);
+        break;
+      }
+
+      case SysUname: {
+        result = doUname(tc, tc->getReg(rb(16)));
+        break;
+      }
+
+      case SysGetpid: {
+        result = process->pid();
+        break;
+      }
+
+      case SysGettid: {
+        result = threadOf(process, tc).tid;
+        break;
+      }
+
+      case SysGetppid: {
+        result = process->ppid();
+        break;
+      }
+
+      case SysGetuid: {
+        result = ::getuid();
+        break;
+      }
+
+      case SysGeteuid: {
+        result = ::geteuid();
+        break;
+      }
+
+      case SysGetgid: {
+        result = ::getgid();
+        break;
+      }
+
+      case SysGetegid: {
+        result = ::getegid();
+        break;
+      }
+
+      case SysSysinfo: {
+        result = doSysinfo(tc, tc->getReg(rb(16)));
+        break;
+      }
+
+      // Resource limits (GEM5-024t).  getrlimit/setrlimit are the legacy
+      // entries; musl's getrlimit()/setrlimit() route through prlimit64(2).
+      case SysGetrlimit:
+      case SysSetrlimit: {
+        const int resource = static_cast<int>(tc->getReg(rd(16)));
+        const Addr rlim = tc->getReg(rb(16));
+        result = doPrlimit64(tc, process, 0, resource,
+                             nr == SysSetrlimit ? rlim : Addr(0),
+                             nr == SysGetrlimit ? rlim : Addr(0));
+        break;
+      }
+
+      case SysPrlimit64: {
+        result = doPrlimit64(tc, process,
+                             static_cast<int>(tc->getReg(rd(16))),
+                             static_cast<int>(tc->getReg(rd(17))),
+                             tc->getReg(rb(16)), tc->getReg(rb(17)));
+        break;
+      }
+
+      // Guest memory management (contract-syscall §3: pointers in rb, scalars
+      // in rd, both banks counted from 16).
+      case SysBrk: {
+        result = doBrk(process, tc->getReg(rb(16)));
+        break;
+      }
+
+      case SysMmap: {
+        const Addr hint = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        const uint64_t prot = tc->getReg(rd(17));
+        const uint64_t flags = tc->getReg(rd(18));
+        const int fd = static_cast<int>(tc->getReg(rd(19)));
+        const uint64_t offset = tc->getReg(rd(20));
+        result = doMmap(process, hint, length, prot, flags, fd, offset);
+        break;
+      }
+
+      case SysMunmap: {
+        const Addr start = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        result = doMunmap(process, start, length);
+        break;
+      }
+
+      case SysMremap: {
+        // contract-syscall §3 type-based banks: old_addr and new_addr are
+        // pointers (rb16/rb17), the three sizes/flags are data (rd16-rd18).
+        const Addr old_addr = tc->getReg(rb(16));
+        const uint64_t old_size = tc->getReg(rd(16));
+        const uint64_t new_size = tc->getReg(rd(17));
+        const uint64_t flags = tc->getReg(rd(18));
+        const Addr new_addr = tc->getReg(rb(17));
+        result = doMremap(process, old_addr, old_size, new_size, flags,
+                          new_addr);
+        break;
+      }
+
+      case SysMprotect: {
+        const Addr start = tc->getReg(rb(16));
+        const uint64_t length = tc->getReg(rd(16));
+        const uint64_t prot = tc->getReg(rd(17));
+        result = doMprotect(process, start, length, prot);
+        break;
+      }
+
+      // File descriptor and file I/O surface (GEM5-023t).  Argument banks:
+      // scalars in rd16.. and pointers in rb16.. (contract-syscall §3).
+      case SysDup: {
+        result = doDup(process, static_cast<int>(tc->getReg(rd(16))));
+        break;
+      }
+
+      case SysDup3: {
+        const int old_fd = static_cast<int>(tc->getReg(rd(16)));
+        const int new_fd = static_cast<int>(tc->getReg(rd(17)));
+        const uint64_t flags = tc->getReg(rd(18));
+        result = doDup3(process, old_fd, new_fd, flags);
+        break;
+      }
+
+      case SysFcntl: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const int cmd = static_cast<int>(tc->getReg(rd(17)));
+        // fcntl's kernel prototype is (fd, cmd, unsigned long arg), so musl's
+        // argmask keeps all three in the RD bank -- a lock pointer arrives as
+        // the integer value in rd18, not as an RB pointer (contract-syscall
+        // §3 assigns banks by the *syscall* prototype; arch/dadao/
+        // syscall_arch.h lists SYS_fcntl in the mask-0 set).
+        const uint64_t arg = tc->getReg(rd(18));
+        result = doFcntl(tc, process, fd, cmd, arg, retry);
+        break;
+      }
+
+      case SysOpenat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const uint64_t flags = tc->getReg(rd(17));
+        const uint32_t mode = tc->getReg(rd(18));
+        result = doOpenat(tc, process, dirfd, path, flags, mode);
+        break;
+      }
+
+      case SysClose: {
+        result = doClose(process, static_cast<int>(tc->getReg(rd(16))));
+        break;
+      }
+
+      case SysRead: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doRead(tc, process, fd, buf, count, retry);
+        break;
+      }
+
+      case SysReadv: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr iov = tc->getReg(rb(16));
+        const uint64_t iovcnt = tc->getReg(rd(17));
+        result = doReadv(tc, process, fd, iov, iovcnt, retry);
+        break;
+      }
+
+      case SysPread64: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        const int64_t offset = static_cast<int64_t>(tc->getReg(rd(18)));
+        result = doPread64(tc, process, fd, buf, count, offset);
+        break;
+      }
+
+      case SysLseek: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const int64_t offset = static_cast<int64_t>(tc->getReg(rd(17)));
+        const int whence = static_cast<int>(tc->getReg(rd(18)));
+        result = doLseek(process, fd, offset, whence);
+        break;
+      }
+
+      case SysChdir: {
+        result = doChdir(tc, process, tc->getReg(rb(16)));
+        break;
+      }
+
+      case SysFstat: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr stat_addr = tc->getReg(rb(16));
+        result = doFstat(tc, process, fd, stat_addr);
+        break;
+      }
+
+      case SysNewfstatat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr stat_addr = tc->getReg(rb(17));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doNewfstatat(tc, process, dirfd, path, stat_addr, flags);
+        break;
+      }
+
+      case SysStatfs: {
+        const Addr path = tc->getReg(rb(16));
+        const Addr buf = tc->getReg(rb(17));
+        result = doStatfs(tc, process, path, buf);
+        break;
+      }
+
+      case SysFaccessat:
+      case SysFaccessat2: {
+        // faccessat2 is the flag-carrying form musl tries first when the
+        // caller passes AT_EACCESS/AT_SYMLINK_NOFOLLOW; both share one body.
+        // The legacy faccessat has no flags argument at all, so it must not
+        // read rd18 (musl leaves an unrelated value there).
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const int mode = static_cast<int>(tc->getReg(rd(17)));
+        const int flags = nr == SysFaccessat2
+                              ? static_cast<int>(tc->getReg(rd(18)))
+                              : 0;
+        result = doFaccessat(tc, process, dirfd, path, mode, flags);
+        break;
+      }
+
+      case SysGetdents64: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr dir_addr = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doGetdents64(tc, process, fd, dir_addr, count);
+        break;
+      }
+
+      case SysUtimensat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr times = tc->getReg(rb(17));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doUtimensat(tc, process, dirfd, path, times, flags);
+        break;
+      }
+
+      case SysReadlinkat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const Addr buf = tc->getReg(rb(17));
+        const uint64_t bufsiz = tc->getReg(rd(17));
+        result = doReadlinkat(tc, process, dirfd, path, buf, bufsiz);
+        break;
+      }
+
+      case SysUnlinkat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const int flags = static_cast<int>(tc->getReg(rd(17)));
+        result = doUnlinkat(tc, process, dirfd, path, flags);
+        break;
+      }
+
+      case SysMkdirat: {
+        const int dirfd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr path = tc->getReg(rb(16));
+        const uint32_t mode = tc->getReg(rd(17));
+        result = doMkdirat(tc, process, dirfd, path, mode);
+        break;
+      }
+
+      // Clock surface (GEM5-023t): the monotonic/CPU clocks are simulated
+      // time at the GEM5-019t 1e9-ticks/s baseline; REALTIME/gettimeofday/
+      // time stay host-backed like QEMU user mode so file timestamps compare
+      // correctly.
+      case SysClockGettime: {
+        const int clock_id = static_cast<int>(tc->getReg(rd(16)));
+        const Addr tp = tc->getReg(rb(16));
+        result = doClockGettime(tc, clock_id, tp);
+        break;
+      }
+
+      case SysClockGetres: {
+        const int clock_id = static_cast<int>(tc->getReg(rd(16)));
+        const Addr tp = tc->getReg(rb(16));
+        result = doClockGetres(tc, clock_id, tp);
+        break;
+      }
+
+      case SysGettimeofday: {
+        const Addr tv = tc->getReg(rb(16));
+        const Addr tz = tc->getReg(rb(17));
+        result = doGettimeofday(tc, tv, tz);
+        break;
+      }
+
+      case SysNanosleep: {
+        const Addr req = tc->getReg(rb(16));
+        const Addr rem = tc->getReg(rb(17));
+        result = doNanosleep(tc, process, req, rem, sleepParked);
+        if (sleepParked)
+            return; // the result is written by the deadline event
+        break;
+      }
+
+      case SysTimeLegacy: {
+        const Addr tloc = tc->getReg(rb(16));
+        result = doTime(tc, tloc);
+        break;
+      }
+
+      case SysWrite: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr buf = tc->getReg(rb(16));
+        const uint64_t count = tc->getReg(rd(17));
+        result = doWrite(tc, process, fd, buf, count, retry);
+        break;
+      }
+
+      case SysWritev: {
+        const int fd = static_cast<int>(tc->getReg(rd(16)));
+        const Addr iov = tc->getReg(rb(16));
+        const uint64_t iovcnt = tc->getReg(rd(17));
+
+        if (iovcnt > 1024) {
+            result = static_cast<RegVal>(-EINVAL);
+            break;
+        }
+
+        std::vector<uint8_t> raw(iovcnt * 16);
+        if (iovcnt > 0) {
+            SETranslatingPortProxy proxy(tc, SETranslatingPortProxy::Never);
+            if (!proxy.tryReadBlob(iov, raw.data(), raw.size())) {
+                result = static_cast<RegVal>(-EFAULT);
+                break;
+            }
+        }
+
+        RegVal total = 0;
+        bool failed = false;
+        for (uint64_t i = 0; i < iovcnt; ++i) {
+            // struct iovec (contract-abi §1.7): {base, len}, 8 bytes each, BE.
+            const uint64_t base = readBigEndian64(&raw[i * 16]);
+            const uint64_t len = readBigEndian64(&raw[i * 16 + 8]);
+            bool blocked = false;
+            const int64_t written = static_cast<int64_t>(
+                    doWrite(tc, process, fd, base, len, blocked));
+            if (blocked) {
+                // A short write is a legal result: return what already went
+                // out instead of re-executing the whole vector.
+                if (total == 0)
+                    retry = true;
+                break;
+            }
+            if (written < 0) {
+                result = total > 0 ? total : static_cast<RegVal>(written);
+                failed = true;
+                break;
+            }
+            total += static_cast<RegVal>(written);
+        }
+        if (!failed && !retry)
+            result = total;
+        break;
+      }
+
+      // IPC (GEM5-025t): pipes are guest objects (DadaoPipeFDEntry), sockets are
+      // forwarded to the host for the three families the corpus uses.
+      case SysPipe2: {
+        const Addr fildes = tc->getReg(rb(16));
+        const uint64_t flags = tc->getReg(rd(16));
+        result = doPipe2(tc, process, fildes, flags);
+        break;
+      }
+
+      case SysSocket: {
+        result = doSocket(process, static_cast<int>(tc->getReg(rd(16))),
+                          static_cast<int>(tc->getReg(rd(17))),
+                          static_cast<int>(tc->getReg(rd(18))));
+        break;
+      }
+
+      case SysSocketpair: {
+        result = doSocketpair(tc, process,
+                              static_cast<int>(tc->getReg(rd(16))),
+                              static_cast<int>(tc->getReg(rd(17))),
+                              static_cast<int>(tc->getReg(rd(18))),
+                              tc->getReg(rb(16)));
+        break;
+      }
+
+      case SysBind: {
+        result = doBind(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                        tc->getReg(rb(16)),
+                        static_cast<int>(tc->getReg(rd(17))));
+        break;
+      }
+
+      case SysConnect: {
+        result = doConnect(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                           tc->getReg(rb(16)),
+                           static_cast<int>(tc->getReg(rd(17))), retry);
+        break;
+      }
+
+      case SysListen: {
+        result = doListen(process, static_cast<int>(tc->getReg(rd(16))),
+                          static_cast<int>(tc->getReg(rd(17))));
+        break;
+      }
+
+      case SysAccept:
+      case SysAccept4: {
+        result = doAccept(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                          tc->getReg(rb(16)), tc->getReg(rb(17)),
+                          nr == SysAccept4
+                              ? static_cast<int>(tc->getReg(rd(17)))
+                              : 0,
+                          retry);
+        break;
+      }
+
+      case SysSendto: {
+        result = doSendto(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                          tc->getReg(rb(16)), tc->getReg(rd(17)),
+                          static_cast<int>(tc->getReg(rd(18))),
+                          tc->getReg(rb(17)),
+                          static_cast<int>(tc->getReg(rd(19))), retry);
+        break;
+      }
+
+      case SysRecvfrom: {
+        result = doRecvfrom(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                            tc->getReg(rb(16)), tc->getReg(rd(17)),
+                            static_cast<int>(tc->getReg(rd(18))),
+                            tc->getReg(rb(17)), tc->getReg(rb(18)), retry);
+        break;
+      }
+
+      case SysSetsockopt: {
+        result = doSetsockopt(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                              static_cast<int>(tc->getReg(rd(17))),
+                              static_cast<int>(tc->getReg(rd(18))),
+                              tc->getReg(rb(16)),
+                              static_cast<int>(tc->getReg(rd(19))));
+        break;
+      }
+
+      case SysGetsockopt: {
+        result = doGetsockopt(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                              static_cast<int>(tc->getReg(rd(17))),
+                              static_cast<int>(tc->getReg(rd(18))),
+                              tc->getReg(rb(16)), tc->getReg(rb(17)));
+        break;
+      }
+
+      case SysGetsockname: {
+        result = doGetSockName(tc, process,
+                               static_cast<int>(tc->getReg(rd(16))),
+                               tc->getReg(rb(16)), tc->getReg(rb(17)), false);
+        break;
+      }
+
+      case SysGetpeername: {
+        result = doGetSockName(tc, process,
+                               static_cast<int>(tc->getReg(rd(16))),
+                               tc->getReg(rb(16)), tc->getReg(rb(17)), true);
+        break;
+      }
+
+      case SysShutdown: {
+        result = doShutdown(process, static_cast<int>(tc->getReg(rd(16))),
+                            static_cast<int>(tc->getReg(rd(17))));
+        break;
+      }
+
+      // Process creation / exec (GEM5-025t).  musl's fork()/vfork() and
+      // posix_spawn() all arrive at clone(2); CLONE_THREAD stays unimplemented.
+      case SysClone: {
+        result = doClone(tc, process, tc->getReg(rd(16)), tc->getReg(rd(17)),
+                         tc->getReg(rb(16)), tc->getReg(rd(18)),
+                         tc->getReg(rb(17)), suspendSelf);
+        break;
+      }
+
+      case SysExecve: {
+        bool replaced = false;
+        doExecve(tc, process, tc->getReg(rb(16)), tc->getReg(rb(17)),
+                 tc->getReg(rb(18)), result, replaced);
+        if (replaced)
+            return; // the new image is already running; no register write
+        break;
+      }
+
+      case SysWait4: {
+        result = doWait4(tc, process, static_cast<int>(tc->getReg(rd(16))),
+                         tc->getReg(rb(16)),
+                         static_cast<int>(tc->getReg(rd(17))),
+                         tc->getReg(rb(17)), retry);
+        break;
+      }
+
+      default:
+        // 2026-11-02 decision: an unsupported syscall is a hard, explicit
+        // failure with the number and the trapping pc -- never a silent
+        // -ENOSYS/0 continuation.
+        fatal("DADAO SE: syscall %d not implemented (pc=%#x)",
+              static_cast<int>(nr), pc);
+    }
+
+    if (retry) {
+        syscallRetry = true;
+        return; // re-execute the trap (SyscallRetryFault, see inst.cc)
+    }
+
+    tc->setReg(rd(8), result);
+
+    // Linux delivers pending unblocked signals on the way back to user mode.
+    // The syscall's return value is already in rd8, so the frame saved in a
+    // handler carries it; resume at the instruction after the trap.
+    maybeDeliverSignals(tc, process, pc + 4);
+
+    // clone(CLONE_VFORK): the parent stays asleep until the child execs or
+    // exits (Linux vfork semantics).  The result is already in rd8, and the
+    // CPU advances the PC of the suspended context before it stops ticking.
+    if (suspendSelf)
+        tc->suspend();
+}
+
+} // namespace DadaoISA
+} // namespace gem5
