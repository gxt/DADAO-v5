+// Linux/RISC-V syscall numbers used by the G1 static-musl startup path
+// (contract-syscall §1.1: numbers live in rd15; values from the locked
+// upstream table, contract-syscall §1.2).  The table is extended only with
+// the numbers the static tset actually reaches (GEM5-023t), never with a
+// "whole syscall table".
+constexpr uint64_t SysDup = 23;
+constexpr uint64_t SysDup3 = 24;
+constexpr uint64_t SysFcntl = 25;
+constexpr uint64_t SysIoctl = 29;
+constexpr uint64_t SysMkdirat = 34;
+constexpr uint64_t SysUnlinkat = 35;
+constexpr uint64_t SysStatfs = 43;
+constexpr uint64_t SysFaccessat = 48;
+constexpr uint64_t SysOpenat = 56;
+constexpr uint64_t SysClose = 57;
+constexpr uint64_t SysGetdents64 = 61;
+constexpr uint64_t SysLseek = 62;
+constexpr uint64_t SysRead = 63;
+constexpr uint64_t SysWrite = 64;
+constexpr uint64_t SysReadv = 65;
+constexpr uint64_t SysWritev = 66;
+constexpr uint64_t SysPread64 = 67;
+constexpr uint64_t SysReadlinkat = 78;
+constexpr uint64_t SysNewfstatat = 79;
+constexpr uint64_t SysFstat = 80;
+constexpr uint64_t SysUtimensat = 88;
+constexpr uint64_t SysExit = 93;
+constexpr uint64_t SysExitGroup = 94;
+constexpr uint64_t SysSetTidAddress = 96;
+constexpr uint64_t SysNanosleep = 101;
+constexpr uint64_t SysClockGettime = 113;
+constexpr uint64_t SysClockGetres = 114;
+constexpr uint64_t SysGettimeofday = 169;
+constexpr uint64_t SysBrk = 214;
+constexpr uint64_t SysMunmap = 215;
+constexpr uint64_t SysMremap = 216;
+constexpr uint64_t SysMmap = 222;
+constexpr uint64_t SysMprotect = 226;
+constexpr uint64_t SysFaccessat2 = 439;
+
+// time(2) has no number in the locked asm-generic 64-bit table (musl routes
+// time() through clock_gettime(CLOCK_REALTIME)); 1062 is the legacy number
+// gem5's own RISC-V table keeps for it.  It is implemented so a guest that
+// calls syscall(__NR_time) directly still gets Linux semantics.
+constexpr uint64_t SysTimeLegacy = 1062;
+
+// AT_* constants from the locked asm-generic uapi.
+constexpr int AtFdcwd = -100;
+constexpr int AtSymlinkNofollow = 0x100;
+constexpr int AtRemovedir = 0x200;
+constexpr int AtEaccess = 0x200;
+constexpr int AtNoAutomount = 0x800;
+constexpr int AtEmptyPath = 0x1000;
+
+// Guest open(2) flags (asm-generic uapi, contract-syscall §1.2).  The values
+// are the guest ABI's, not the host's: the two happen to agree on x86-64 for
+// everything except O_LARGEFILE, which is mapped explicitly below.
+constexpr uint64_t TgtOCreat = 0x000040;
+constexpr uint64_t TgtOExcl = 0x000080;
+constexpr uint64_t TgtONoctty = 0x000100;
+constexpr uint64_t TgtOTrunc = 0x000200;
+constexpr uint64_t TgtOAppend = 0x000400;
+constexpr uint64_t TgtONonblock = 0x000800;
+constexpr uint64_t TgtODsync = 0x001000;
+constexpr uint64_t TgtODirect = 0x004000;
+constexpr uint64_t TgtOLargefile = 0x008000;
+constexpr uint64_t TgtODirectory = 0x010000;
+constexpr uint64_t TgtONofollow = 0x020000;
+constexpr uint64_t TgtONoatime = 0x040000;
+constexpr uint64_t TgtOCloexec = 0x080000;
+constexpr uint64_t TgtOSync = 0x101000;
+constexpr uint64_t TgtOPath = 0x200000;
+constexpr uint64_t TgtOTmpfile = 0x410000;
+
+// Target struct layouts consumed by the static tset (asm-generic 64-bit
+// uapi; contract-abi §1.7: every multi-byte field is big-endian).  The
+// offsets are written out explicitly because the guest kernel ABI, not the
+// host compiler's padding, defines them.
+constexpr size_t GuestStatSize = 128;
+constexpr size_t GuestStatDev = 0;
+constexpr size_t GuestStatIno = 8;
+constexpr size_t GuestStatMode = 16;
+constexpr size_t GuestStatNlink = 20;
+constexpr size_t GuestStatUid = 24;
+constexpr size_t GuestStatGid = 28;
+constexpr size_t GuestStatRdev = 32;
+constexpr size_t GuestStatSizeField = 48;
+constexpr size_t GuestStatBlksize = 56;
+constexpr size_t GuestStatBlocks = 64;
+constexpr size_t GuestStatAtime = 72;
+constexpr size_t GuestStatAtimeNsec = 80;
+constexpr size_t GuestStatMtime = 88;
+constexpr size_t GuestStatMtimeNsec = 96;
+constexpr size_t GuestStatCtime = 104;
+constexpr size_t GuestStatCtimeNsec = 112;
+
+constexpr size_t GuestStatfsSize = 120;
+constexpr size_t GuestStatfsBlocks = 16;
+constexpr size_t GuestStatfsFsid = 56;
+constexpr size_t GuestStatfsNamelen = 64;
+
+constexpr size_t GuestTimespecSize = 16;
+constexpr size_t GuestTimevalSize = 16;
+
+// struct linux_dirent64: d_ino(8) d_off(8) d_reclen(2) d_type(1) d_name[].
+constexpr size_t GuestDirent64Ino = 0;
+constexpr size_t GuestDirent64Off = 8;
+constexpr size_t GuestDirent64Reclen = 16;
+constexpr size_t GuestDirent64Type = 18;
+
+// mmap(2) flag and protection values (asm-generic uapi, the same numbers the
+// locked RISC-V table uses).  Only the flags the guest memory management of
+// the static tset needs are interpreted; the advisory ones are ignored, as
+// the kernel does.
+constexpr uint64_t MapShared = 0x01;
+constexpr uint64_t MapPrivate = 0x02;
+constexpr uint64_t MapFixed = 0x10;
+constexpr uint64_t MapAnonymous = 0x20;
+constexpr uint64_t MapFixedNoreplace = 0x100000;
+constexpr uint64_t ProtRead = 0x1;
+constexpr uint64_t ProtWrite = 0x2;
+constexpr uint64_t ProtExec = 0x4;
