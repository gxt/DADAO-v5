+// --- Pipes (GEM5-025t) ---------------------------------------------------
+//
+// A pipe is a guest kernel object, not a host file descriptor: both ends are
+// in the guest fd table and the buffer lives in the simulator.  Keeping the
+// state here is what makes a pipe between two guest processes work -- a host
+// pipe would block the *simulator* on a read that only another guest process
+// can satisfy.
+constexpr size_t PipeCapacity = 65536;
+
+struct PipeState
+{
+    std::deque<uint8_t> buffer;
+    int readers = 0;
+    int writers = 0;
+};
+
+/** One end of a pipe in a guest fd table.  `clone()` is what dup(2), fork(2)
+ *  and the fd-table copy in Process::clone() use: the *open file description*
+ *  (the buffer and the end counts) is shared, exactly like Linux. */
+class DadaoPipeFDEntry : public FDEntry
+{
+  public:
+    DadaoPipeFDEntry(std::shared_ptr<PipeState> pipe, bool read_end, int flags) :
+        FDEntry(flags & TgtOCloexec), state(std::move(pipe)), readEnd(read_end),
+        flags(flags)
+    {
+        _class = FDClass::fd_pipe;
+        if (readEnd)
+            ++state->readers;
+        else
+            ++state->writers;
+    }
+
+    DadaoPipeFDEntry(const DadaoPipeFDEntry &other) :
+        FDEntry(other.getCOE()), state(other.state), readEnd(other.readEnd),
+        flags(other.flags)
+    {
+        _class = FDClass::fd_pipe;
+        if (readEnd)
+            ++state->readers;
+        else
+            ++state->writers;
+    }
+
+    ~DadaoPipeFDEntry() override
+    {
+        if (readEnd)
+            --state->readers;
+        else
+            --state->writers;
+    }
+
+    std::shared_ptr<FDEntry>
+    clone() const override
+    {
+        return std::make_shared<DadaoPipeFDEntry>(*this);
+    }
+
+    std::shared_ptr<PipeState> state;
+    bool readEnd;
+    int flags; // guest-visible status flags (access mode + O_NONBLOCK)
+};
+
+/** True when the guest fd is an open end of a pipe. */
+bool
+pipeFdOf(DadaoISA::Process *process, int fd, std::shared_ptr<DadaoPipeFDEntry> &pipe)
+{
+    std::shared_ptr<FDEntry> entry;
+    if (guestFdEntry(process, fd, entry) != 0)
+        return false;
+    pipe = std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry);
+    return pipe != nullptr;
+}
+
+// --- Sockets (GEM5-025t) -------------------------------------------------
+//
+// Only the families the static corpus reaches are forwarded to the host: the
+// AF_UNIX probe musl's nscd lookup opens and the AF_INET loopback traffic of
+// functional/socket.  Everything else is EAFNOSUPPORT, never a silent pass
+// through to a host socket the guest never asked for.
+bool
+familySupported(int family)
+{
+    return family == AfUnix || family == AfInet || family == AfInet6;
+}
+
+/** Guest sa_family (big-endian) -> host order.  Every other sockaddr byte is
+ *  either opaque (a sockaddr_un path) or already network order. */
+void
+sockaddrToHost(uint8_t *raw, size_t len)
+{
+    if (len < 2)
+        return;
+    const uint16_t family = readBigEndian16(raw);
+    std::memcpy(raw, &family, sizeof(family));
+}
+
+void
+sockaddrToGuest(uint8_t *raw, size_t len)
+{
+    if (len < 2)
+        return;
+    uint16_t family;
+    std::memcpy(&family, raw, sizeof(family));
+    writeBigEndian16(raw, family);
+}
+
+/** Non-blocking readiness probe used to keep a blocking guest socket call
+ *  from blocking the simulator: when the host operation would sleep, the
+ *  syscall is retried (SyscallRetryFault) instead. */
+bool
+pollReady(int sim_fd, short events)
+{
+    struct pollfd pfd;
+    pfd.fd = sim_fd;
+    pfd.events = events;
+    pfd.revents = 0;
+    return ::poll(&pfd, 1, 0) > 0;
+}
+
+bool
+hostFdNonblocking(int sim_fd)
+{
+    const int flags = ::fcntl(sim_fd, F_GETFL);
+    return flags >= 0 && (flags & O_NONBLOCK);
+}
+
+// POSIX record locks are per-*process* in Linux, but every guest process runs
+// inside one host process here: forwarding fcntl(F_SETLK) to the host would let
+// a child's lock silently replace its parent's (both carry the host pid).  The
+// table below keeps the owner on the guest side and never asks the host.
+struct GuestFileLock
+{
+    dev_t dev;
+    ino_t ino;
+    DadaoISA::Process *owner;
+    int type;   // F_RDLCK or F_WRLCK
+    int64_t start;
+    int64_t len; // 0 == to EOF
+};
+
+std::vector<GuestFileLock> guestFileLocks;
+
+bool
+lockOverlaps(const GuestFileLock &lock, int64_t start, int64_t len)
+{
+    const int64_t lockEnd = lock.len ? lock.start + lock.len : INT64_MAX;
+    const int64_t end = len ? start + len : INT64_MAX;
+    return start < lockEnd && lock.start < end;
+}
+
+bool
+fileIdentityOf(int simFd, dev_t &dev, ino_t &ino)
+{
+    struct stat st;
+    if (::fstat(simFd, &st) < 0)
+        return false;
+    dev = st.st_dev;
+    ino = st.st_ino;
+    return true;
+}
+
+void
+dropProcessLocks(DadaoISA::Process *owner)
+{
+    guestFileLocks.erase(
+            std::remove_if(guestFileLocks.begin(), guestFileLocks.end(),
+                           [owner](const GuestFileLock &lock) {
+                               return lock.owner == owner;
+                           }),
+            guestFileLocks.end());
+}
+
+void
+dropProcessLocks(DadaoISA::Process *owner, dev_t dev, ino_t ino)
+{
+    guestFileLocks.erase(
+            std::remove_if(guestFileLocks.begin(), guestFileLocks.end(),
+                           [owner, dev, ino](const GuestFileLock &lock) {
+                               return lock.owner == owner &&
+                                      lock.dev == dev && lock.ino == ino;
+                           }),
+            guestFileLocks.end());
+}
+
+struct OpenFlagMap
+{
+    uint64_t guest;
+    int host;
+};
+
+// Checked in this order: O_SYNC carries O_DSYNC's bit and O_TMPFILE carries
+// O_DIRECTORY's, so the superset has to consume the bits first.
+const OpenFlagMap OpenFlags[] = {
+    {TgtOCreat, O_CREAT},
+    {TgtOExcl, O_EXCL},
+    {TgtONoctty, O_NOCTTY},
+    {TgtOTrunc, O_TRUNC},
+    {TgtOAppend, O_APPEND},
+    {TgtONonblock, O_NONBLOCK},
+    {TgtOSync, O_SYNC},
+    {TgtODsync, O_DSYNC},
+#ifdef O_DIRECT
+    {TgtODirect, O_DIRECT},
+#endif
+#ifdef O_TMPFILE
+    {TgtOTmpfile, O_TMPFILE},
+#endif
+    {TgtODirectory, O_DIRECTORY},
+    {TgtONofollow, O_NOFOLLOW},
+#ifdef O_NOATIME
+    {TgtONoatime, O_NOATIME},
+#endif
+    {TgtOCloexec, O_CLOEXEC},
+#ifdef O_PATH
+    {TgtOPath, O_PATH},
+#endif
+    {TgtOLargefile, O_LARGEFILE},
+};
+
+int
+hostOpenFlags(uint64_t guest_flags)
+{
+    int host_flags = guest_flags & O_ACCMODE;
+    uint64_t rest = guest_flags & ~static_cast<uint64_t>(O_ACCMODE);
+
+    for (const auto &mapping : OpenFlags) {
+        if ((rest & mapping.guest) == mapping.guest) {
+            host_flags |= mapping.host;
+            rest &= ~mapping.guest;
+        }
+    }
+    // Flags whose host value is 0 (O_LARGEFILE on 64-bit hosts) still have to
+    // be consumed above; anything left is a flag this SE layer does not know.
+    warn_if(rest, "DADAO SE: open flags %#llx not decoded", rest);
+    return host_flags;
+}
+
+int
+guestOpenFlags(int host_flags)
+{
+    int guest_flags = host_flags & O_ACCMODE;
+
+    for (const auto &mapping : OpenFlags) {
+        if (mapping.host && (host_flags & mapping.host) == mapping.host)
+            guest_flags |= mapping.guest;
+    }
+    return guest_flags;
+}
+
+/** Resolve an openat-style guest path to a host path.
+ *
+ * Relative paths go through the process cwd (and any redirect paths); a
+ * non-AT_FDCWD dirfd contributes the guest name recorded when that directory
+ * was opened.  An absolute path ignores dirfd, exactly as Linux does.
+ */
+int
+resolveGuestPath(DadaoISA::Process *process, int dirfd,
+                 const std::string &path, std::string &host_path,
+                 std::string *guest_path = nullptr)
+{
+    std::string full = path;
+
+    if (dirfd != AtFdcwd && !path.empty() && path[0] != '/') {
+        std::shared_ptr<FDEntry> entry;
+        if (int status = guestFdEntry(process, dirfd, entry); status != 0)
+            return status;
+        auto file_entry = std::dynamic_pointer_cast<FileFDEntry>(entry);
+        if (!file_entry)
+            return -ENOTDIR;
+        full = file_entry->getFileName() + "/" + path;
+    }
+
+    if (guest_path)
+        *guest_path = full;
+    host_path = process->checkPathRedirect(full);
+    return 0;
+}
+
+void
+packGuestStat(const struct stat &host, uint8_t *out)
+{
+    std::memset(out, 0, GuestStatSize);
+    writeBigEndian64(out + GuestStatDev, host.st_dev);
+    writeBigEndian64(out + GuestStatIno, host.st_ino);
+    writeBigEndian32(out + GuestStatMode, host.st_mode);
+    writeBigEndian32(out + GuestStatNlink, host.st_nlink);
+    writeBigEndian32(out + GuestStatUid, host.st_uid);
+    writeBigEndian32(out + GuestStatGid, host.st_gid);
+    writeBigEndian64(out + GuestStatRdev, host.st_rdev);
+    writeBigEndian64(out + GuestStatSizeField, host.st_size);
+    writeBigEndian32(out + GuestStatBlksize, host.st_blksize);
+    writeBigEndian64(out + GuestStatBlocks, host.st_blocks);
+    writeBigEndian64(out + GuestStatAtime, host.st_atim.tv_sec);
+    writeBigEndian64(out + GuestStatAtimeNsec, host.st_atim.tv_nsec);
+    writeBigEndian64(out + GuestStatMtime, host.st_mtim.tv_sec);
+    writeBigEndian64(out + GuestStatMtimeNsec, host.st_mtim.tv_nsec);
+    writeBigEndian64(out + GuestStatCtime, host.st_ctim.tv_sec);
+    writeBigEndian64(out + GuestStatCtimeNsec, host.st_ctim.tv_nsec);
+}
+
+void
+packGuestStatfs(const struct statfs &host, uint8_t *out)
+{
+    // struct statfs (asm-generic 64-bit): all members are 64-bit except the
+    // two 32-bit fsid words.
+    std::memset(out, 0, GuestStatfsSize);
+    writeBigEndian64(out + 0, host.f_type);
+    writeBigEndian64(out + 8, host.f_bsize);
+    writeBigEndian64(out + GuestStatfsBlocks, host.f_blocks);
+    writeBigEndian64(out + 24, host.f_bfree);
+    writeBigEndian64(out + 32, host.f_bavail);
+    writeBigEndian64(out + 40, host.f_files);
+    writeBigEndian64(out + 48, host.f_ffree);
+    writeBigEndian32(out + GuestStatfsFsid, host.f_fsid.__val[0]);
+    writeBigEndian32(out + GuestStatfsFsid + 4, host.f_fsid.__val[1]);
+    writeBigEndian64(out + GuestStatfsNamelen, host.f_namelen);
+    writeBigEndian64(out + 72, host.f_frsize);
+    writeBigEndian64(out + 80, host.f_flags);
+}
+
+/** Fill a guest timespec from seconds/nanoseconds (big-endian). */
+void
+packGuestTimespec(uint8_t *out, int64_t sec, int64_t nsec)
+{
+    writeBigEndian64(out, sec);
+    writeBigEndian64(out + 8, nsec);
+}
+
+/** Simulated time in nanoseconds.
+ *
+ * GEM5-019t fixes the target-tick convention at 1e9 ticks/s (1 tick = 1 ns)
+ * and derives it from gem5's own clock, never from the 1 ps default.  The SE
+ * monotonic/CPU clocks use the same derivation, so the two engines agree on
+ * the unit even though their absolute values are not comparable.
+ */
+uint64_t
+simulatedNanoseconds()
+{
+    const unsigned __int128 scaled =
+        static_cast<unsigned __int128>(curTick()) * 1000000000ULL;
+    return static_cast<uint64_t>(scaled / sim_clock::Frequency);
+}
+
+/** Write to one end of a guest pipe.  Returns the number of bytes accepted;
+ *  `blocked` asks the caller to retry the syscall (the buffer is full). */
+RegVal
+doPipeWrite(ThreadContext *tc, DadaoISA::Process *process,
+            const std::shared_ptr<DadaoPipeFDEntry> &pipe, Addr buf, uint64_t count,
+            bool &blocked)
+{
+    if (pipe->readEnd)
+        return static_cast<RegVal>(-EBADF);
+
+    if (pipe->state->readers == 0) {
+        // EPIPE plus a pending SIGPIPE, exactly like the kernel's pipe_write.
+        postProcessSignal(process, SigPipe, SiUser);
+        return static_cast<RegVal>(-EPIPE);
+    }
+
+    std::vector<uint8_t> data(count);
+    if (count > 0) {
+        SETranslatingPortProxy proxy(tc, SETranslatingPortProxy::Never);
+        if (!proxy.tryReadBlob(buf, data.data(), count))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    if (count == 0)
+        return 0;
+
+    const size_t space = PipeCapacity - pipe->state->buffer.size();
+    if (space == 0) {
+        if (pipe->flags & TgtONonblock)
+            return static_cast<RegVal>(-EAGAIN);
+        blocked = true;
+        return 0;
+    }
+    const size_t written = std::min<size_t>(count, space);
+    for (size_t i = 0; i < written; ++i)
+        pipe->state->buffer.push_back(data[i]);
+    return static_cast<RegVal>(written);
+}
+
+/** Read from one end of a guest pipe.  A short read is normal (the guest sees
+ *  whatever is buffered); EOF is 0 once every write end is closed. */
+RegVal
+doPipeRead(ThreadContext *tc, DadaoISA::Process *process,
+           const std::shared_ptr<DadaoPipeFDEntry> &pipe, Addr buf, uint64_t count,
+           bool &blocked)
+{
+    (void)process;
+    if (!pipe->readEnd)
+        return static_cast<RegVal>(-EBADF);
+    if (count == 0)
+        return 0;
+
+    if (pipe->state->buffer.empty()) {
+        if (pipe->state->writers == 0)
+            return 0; // EOF
+        if (pipe->flags & TgtONonblock)
+            return static_cast<RegVal>(-EAGAIN);
+        blocked = true;
+        return 0;
+    }
+
+    if (!guestRangeWritable(process, buf, count))
+        return static_cast<RegVal>(-EFAULT);
+
+    const size_t available = std::min<size_t>(count, pipe->state->buffer.size());
+    std::vector<uint8_t> data(available);
+    for (size_t i = 0; i < available; ++i) {
+        data[i] = pipe->state->buffer.front();
+        pipe->state->buffer.pop_front();
+    }
+    if (!writeGuestBlob(tc, buf, data.data(), available))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(available);
+}
+
+/** write(2) on a host-backed guest file descriptor.
+ *
+ * Guest memory is read with Never allocation: a bad pointer must fail with
+ * EFAULT, never silently map a fresh page.
+ */
+RegVal
+doWrite(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr buf,
+        uint64_t count, bool &blocked)
+{
+    if (fd < 0 || fd >= process->fds->getSize())
+        return static_cast<RegVal>(-EBADF);
+
+    std::shared_ptr<FDEntry> entry = (*process->fds)[fd];
+    if (!entry)
+        return static_cast<RegVal>(-EBADF);
+    if (auto pipe = std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry))
+        return doPipeWrite(tc, process, pipe, buf, count, blocked);
+
+    auto hostEntry = std::dynamic_pointer_cast<HBFDEntry>(entry);
+    if (!hostEntry)
+        return static_cast<RegVal>(-EBADF);
+
+    const int sim_fd = hostEntry->getSimFD();
+
+    std::vector<uint8_t> data(count);
+    if (count > 0) {
+        SETranslatingPortProxy proxy(tc, SETranslatingPortProxy::Never);
+        if (!proxy.tryReadBlob(buf, data.data(), count))
+            return static_cast<RegVal>(-EFAULT);
+    }
+
+    ssize_t written;
+    do {
+        written = ::write(sim_fd, data.data(), count);
+    } while (written < 0 && errno == EINTR);
+
+    if (written < 0)
+        return static_cast<RegVal>(-errno);
+    return static_cast<RegVal>(written);
+}
+
+/** read(2) on a host-backed guest file descriptor. */
+RegVal
+doRead(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr buf,
+       uint64_t count, bool &blocked)
+{
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+    if (auto pipe = std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry))
+        return doPipeRead(tc, process, pipe, buf, count, blocked);
+
+    auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(entry);
+    if (!host_entry)
+        return static_cast<RegVal>(-EBADF);
+    const int sim_fd = host_entry->getSimFD();
+
+    // Verify the whole destination before ::read consumes anything: a socket
+    // or file must keep its bytes for the next call after an EFAULT, exactly
+    // like QEMU's lock_user(VERIFY_WRITE) ordering.
+    if (!guestRangeWritable(process, buf, count))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::vector<uint8_t> data(count);
+    ssize_t bytes_read;
+    do {
+        bytes_read = ::read(sim_fd, data.data(), count);
+    } while (bytes_read < 0 && errno == EINTR);
+
+    if (bytes_read < 0)
+        return static_cast<RegVal>(-errno);
+    if (bytes_read > 0 && !writeGuestBlob(tc, buf, data.data(), bytes_read))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(bytes_read);
+}
+
+/** pread64(2): read at an explicit offset without moving the file offset. */
+RegVal
+doPread64(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr buf,
+          uint64_t count, int64_t offset)
+{
+    if (offset < 0)
+        return static_cast<RegVal>(-EINVAL);
+
+    int sim_fd;
+    std::shared_ptr<DadaoPipeFDEntry> pipe;
+    if (pipeFdOf(process, fd, pipe))
+        return static_cast<RegVal>(-ESPIPE);
+    if (int status = hostFdOf(process, fd, sim_fd); status != 0)
+        return static_cast<RegVal>(status);
+
+    std::vector<uint8_t> data(count);
+    ssize_t bytes_read;
+    do {
+        bytes_read = ::pread(sim_fd, data.data(), count, offset);
+    } while (bytes_read < 0 && errno == EINTR);
+
+    if (bytes_read < 0)
+        return static_cast<RegVal>(-errno);
+    if (bytes_read > 0 && !writeGuestBlob(tc, buf, data.data(), bytes_read))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(bytes_read);
+}
+
+/** readv(2) on a guest file descriptor. */
+RegVal
+doReadv(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr iov,
+        uint64_t iovcnt, bool &blocked)
+{
+    constexpr uint64_t IovecSize = 16;
+
+    if (iovcnt > 1024)
+        return static_cast<RegVal>(-EINVAL);
+
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+
+    // A pipe end: fill the vector from whatever is buffered (a short read is
+    // normal); only a completely empty buffer waits for the writer.
+    if (auto pipe = std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry)) {
+        if (!pipe->readEnd)
+            return static_cast<RegVal>(-EBADF);
+        if (pipe->state->buffer.empty()) {
+            if (pipe->state->writers == 0)
+                return 0;
+            if (pipe->flags & TgtONonblock)
+                return static_cast<RegVal>(-EAGAIN);
+            blocked = true;
+            return 0;
+        }
+        std::vector<uint8_t> raw(iovcnt * IovecSize);
+        if (iovcnt > 0 && !readGuestBlob(tc, iov, raw.data(), raw.size()))
+            return static_cast<RegVal>(-EFAULT);
+        RegVal total = 0;
+        for (uint64_t i = 0; i < iovcnt && !pipe->state->buffer.empty(); ++i) {
+            const Addr base = readBigEndian64(&raw[i * IovecSize]);
+            const uint64_t len = readBigEndian64(&raw[i * IovecSize + 8]);
+            const size_t n = std::min<size_t>(
+                    len, pipe->state->buffer.size());
+            if (n == 0)
+                continue;
+            // Same verify-before-consume rule as read(2): checking this
+            // iovec first keeps the bytes in the pipe on EFAULT.
+            if (!guestRangeWritable(process, base, n))
+                return total > 0 ? total : static_cast<RegVal>(-EFAULT);
+            std::vector<uint8_t> chunk(n);
+            for (size_t j = 0; j < n; ++j) {
+                chunk[j] = pipe->state->buffer.front();
+                pipe->state->buffer.pop_front();
+            }
+            if (!writeGuestBlob(tc, base, chunk.data(), n))
+                return total > 0 ? total : static_cast<RegVal>(-EFAULT);
+            total += static_cast<RegVal>(n);
+        }
+        return total;
+    }
+
+    auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(entry);
+    if (!host_entry)
+        return static_cast<RegVal>(-EBADF);
+    const int sim_fd = host_entry->getSimFD();
+
+    std::vector<uint8_t> raw(iovcnt * IovecSize);
+    if (!readGuestBlob(tc, iov, raw.data(), raw.size()))
+        return static_cast<RegVal>(-EFAULT);
+
+    RegVal total = 0;
+    for (uint64_t i = 0; i < iovcnt; ++i) {
+        // struct iovec (contract-abi §1.7): {base, len}, 8 bytes each, BE.
+        const Addr base = readBigEndian64(&raw[i * IovecSize]);
+        const uint64_t len = readBigEndian64(&raw[i * IovecSize + 8]);
+        if (len == 0)
+            continue;
+
+        if (!guestRangeWritable(process, base, len))
+            return total > 0 ? total : static_cast<RegVal>(-EFAULT);
+
+        std::vector<uint8_t> data(len);
+        ssize_t bytes_read;
+        do {
+            bytes_read = ::read(sim_fd, data.data(), len);
+        } while (bytes_read < 0 && errno == EINTR);
+
+        if (bytes_read < 0) {
+            if (total > 0)
+                return total;
+            return static_cast<RegVal>(-errno);
+        }
+        if (bytes_read > 0 &&
+            !writeGuestBlob(tc, base, data.data(), bytes_read)) {
+            return static_cast<RegVal>(-EFAULT);
+        }
+        total += bytes_read;
+        if (static_cast<uint64_t>(bytes_read) < len)
+            break;
+    }
+    return total;
+}
+
+/** openat(2): pass the path through to the host and record a guest fd. */
+RegVal
+doOpenat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+         Addr path_addr, uint64_t flags, uint32_t mode)
+{
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string guest_path;
+    std::string host_path;
+    if (int status =
+            resolveGuestPath(process, dirfd, path, host_path, &guest_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    const int host_flags = hostOpenFlags(flags);
+    int sim_fd;
+    do {
+        sim_fd = ::open(host_path.c_str(), host_flags, mode);
+    } while (sim_fd < 0 && errno == EINTR);
+
+    if (sim_fd < 0)
+        return static_cast<RegVal>(-errno);
+
+    // The resolved guest path (not the host one) is kept so a later openat()
+    // relative to this descriptor resolves through the same cwd / redirect
+    // rules, including a directory that was itself opened through a dirfd.
+    auto entry = std::make_shared<FileFDEntry>(
+        sim_fd, host_flags, guest_path, 0, flags & TgtOCloexec);
+    const int guest_fd = allocGuestFd(process, entry);
+    if (guest_fd < 0) {
+        ::close(sim_fd);
+        return static_cast<RegVal>(guest_fd);
+    }
+    return guest_fd;
+}
+
+/** close(2). */
+RegVal
+doClose(DadaoISA::Process *process, int fd)
+{
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+
+    // POSIX: closing any descriptor of a file drops this process's record
+    // locks on it (the guest-side table, see doFcntl).
+    if (auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(entry)) {
+        dev_t dev;
+        ino_t ino;
+        if (fileIdentityOf(host_entry->getSimFD(), dev, ino))
+            dropProcessLocks(process, dev, ino);
+    }
+
+    // closeFDEntry() closes the host fd (except the three std fds) and clears
+    // the slot.  It reports -1, not -errno, on a host failure.
+    if (process->fds->closeFDEntry(fd) < 0)
+        return static_cast<RegVal>(-errno);
+    return 0;
+}
+
+/** lseek(2). */
+RegVal
+doLseek(DadaoISA::Process *process, int fd, int64_t offset, int whence)
+{
+    int sim_fd;
+    std::shared_ptr<DadaoPipeFDEntry> pipe;
+    if (pipeFdOf(process, fd, pipe))
+        return static_cast<RegVal>(-ESPIPE);
+    if (int status = hostFdOf(process, fd, sim_fd); status != 0)
+        return static_cast<RegVal>(status);
+
+    off_t result = ::lseek(sim_fd, offset, whence);
+    return result < 0 ? static_cast<RegVal>(-errno) : result;
+}
+
+/** dup(2). */
+RegVal
+doDup(DadaoISA::Process *process, int fd)
+{
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+
+    std::shared_ptr<FDEntry> clone = entry->clone();
+    clone->setCOE(false);
+    if (auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(clone)) {
+        int sim_fd = ::dup(host_entry->getSimFD());
+        if (sim_fd < 0)
+            return static_cast<RegVal>(-errno);
+        host_entry->setSimFD(sim_fd);
+        const int guest_fd = allocGuestFd(process, clone);
+        if (guest_fd < 0) {
+            ::close(sim_fd);
+            return static_cast<RegVal>(guest_fd);
+        }
+        return guest_fd;
+    }
+
+    // A pipe end: clone() shares the open file description (buffer and end
+    // counts), which is exactly what dup(2) does.
+    const int guest_fd = allocGuestFd(process, clone);
+    return guest_fd < 0 ? static_cast<RegVal>(guest_fd) : guest_fd;
+}
+
+/** dup3(2). */
+RegVal
+doDup3(DadaoISA::Process *process, int old_fd, int new_fd, uint64_t flags)
+{
+    if (flags & ~TgtOCloexec)
+        return static_cast<RegVal>(-EINVAL);
+    if (old_fd == new_fd)
+        return static_cast<RegVal>(-EINVAL);
+    if (new_fd < 0 || new_fd >= process->fds->getSize() ||
+        static_cast<uint64_t>(new_fd) >= process->limits[DadaoISA::RlimitNofile].cur)
+        return static_cast<RegVal>(-EBADF);
+
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, old_fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+
+    std::shared_ptr<FDEntry> clone = entry->clone();
+    clone->setCOE(flags & TgtOCloexec);
+    if (auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(clone)) {
+        int sim_fd = ::dup(host_entry->getSimFD());
+        if (sim_fd < 0)
+            return static_cast<RegVal>(-errno);
+        host_entry->setSimFD(sim_fd);
+
+        if ((*process->fds)[new_fd])
+            process->fds->closeFDEntry(new_fd);
+        process->fds->setFDEntry(new_fd, clone);
+        return new_fd;
+    }
+
+    if ((*process->fds)[new_fd])
+        process->fds->closeFDEntry(new_fd);
+    process->fds->setFDEntry(new_fd, clone);
+    return new_fd;
+}
+
+/** Guest struct flock (asm-generic 64-bit): short type, short whence,
+ * 4 bytes padding, three 64-bit values.  The host layout is identical apart
+ * from byte order, so only the fields are converted. */
+constexpr size_t GuestFlockSize = 32;
+
+RegVal
+doFcntl(ThreadContext *tc, DadaoISA::Process *process, int fd, int cmd,
+        uint64_t arg, bool &blocked)
+{
+    constexpr int FDupfd = 0;
+    constexpr int FDupfdCloexec = 1030;
+    constexpr int FGetfd = 1;
+    constexpr int FSetfd = 2;
+    constexpr int FGetfl = 3;
+    constexpr int FSetfl = 4;
+    constexpr int FGetlk = 5;
+    constexpr int FSetlk = 6;
+    constexpr int FSetlkw = 7;
+
+    int sim_fd;
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+
+    // A pipe end has no host descriptor: its status flags live in the guest
+    // entry (the pipe itself is a guest object, see DadaoPipeFDEntry).
+    if (auto pipe = std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry)) {
+        switch (cmd) {
+          case FDupfd:
+          case FDupfdCloexec: {
+            const int first = static_cast<int>(arg);
+            int limit = process->fds->getSize();
+            const auto &nofile = process->limits[DadaoISA::RlimitNofile];
+            if (nofile.cur < static_cast<uint64_t>(limit))
+                limit = static_cast<int>(nofile.cur);
+            if (first < 0 || first >= limit)
+                return static_cast<RegVal>(-EINVAL);
+            auto clone = pipe->clone();
+            clone->setCOE(cmd == FDupfdCloexec);
+            for (int candidate = first; candidate < limit; ++candidate) {
+                if ((*process->fds)[candidate])
+                    continue;
+                process->fds->setFDEntry(candidate, clone);
+                return candidate;
+            }
+            return static_cast<RegVal>(-EMFILE);
+          }
+          case FGetfd:
+            return pipe->getCOE() ? FD_CLOEXEC : 0;
+          case FSetfd:
+            pipe->setCOE(arg & FD_CLOEXEC);
+            return 0;
+          case FGetfl:
+            return pipe->flags;
+          case FSetfl: {
+            // Only O_NONBLOCK/O_APPEND change on a pipe; both are recorded on
+            // the guest entry because the buffer is guest-side.
+            constexpr int OAppend = 0x400;
+            pipe->flags = (pipe->flags & (O_ACCMODE)) |
+                          (static_cast<int>(arg) & (TgtONonblock | OAppend));
+            return 0;
+          }
+          default:
+            return static_cast<RegVal>(-EINVAL);
+        }
+    }
+
+    if (int status = hostFdOf(process, fd, sim_fd); status != 0)
+        return static_cast<RegVal>(status);
+    auto host_entry = std::dynamic_pointer_cast<HBFDEntry>(entry);
+
+    switch (cmd) {
+      case FDupfd:
+      case FDupfdCloexec: {
+        int first = static_cast<int>(arg);
+        int limit = process->fds->getSize();
+        const auto &nofile = process->limits[DadaoISA::RlimitNofile];
+        if (nofile.cur < static_cast<uint64_t>(limit))
+            limit = static_cast<int>(nofile.cur);
+        if (first < 0 || first >= limit)
+            return static_cast<RegVal>(-EINVAL);
+        for (int candidate = first; candidate < limit; ++candidate) {
+            if ((*process->fds)[candidate])
+                continue;
+            int new_fd = ::dup(sim_fd);
+            if (new_fd < 0)
+                return static_cast<RegVal>(-errno);
+            auto clone = std::dynamic_pointer_cast<HBFDEntry>(entry->clone());
+            clone->setSimFD(new_fd);
+            clone->setCOE(cmd == FDupfdCloexec);
+            process->fds->setFDEntry(candidate, clone);
+            return candidate;
+        }
+        return static_cast<RegVal>(-EMFILE);
+      }
+
+      case FGetfd:
+        return (host_entry->getCOE() ? FD_CLOEXEC : 0);
+
+      case FSetfd:
+        host_entry->setCOE(arg & FD_CLOEXEC);
+        return 0;
+
+      case FGetfl: {
+        int result = ::fcntl(sim_fd, F_GETFL);
+        return result < 0 ? static_cast<RegVal>(-errno) :
+                            guestOpenFlags(result);
+      }
+
+      case FSetfl: {
+        int host_flags = hostOpenFlags(arg);
+        int result = ::fcntl(sim_fd, F_SETFL, host_flags);
+        if (result < 0)
+            return static_cast<RegVal>(-errno);
+        host_entry->setFlags(host_flags);
+        return 0;
+      }
+
+      case FGetlk:
+      case FSetlk:
+      case FSetlkw: {
+        constexpr int FUnlck = 2;
+
+        if (static_cast<Addr>(arg) == 0)
+            return static_cast<RegVal>(-EFAULT);
+
+        uint8_t raw[GuestFlockSize];
+        if (!readGuestBlob(tc, static_cast<Addr>(arg), raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+
+        // struct flock: {short type, short whence, 4 B pad, off start,
+        // off len, pid_t pid} (asm-generic 64-bit, big-endian).
+        const int type = readBigEndian16(raw);
+        const int64_t start = readBigEndian64(raw + 8);
+        const int64_t length = readBigEndian64(raw + 16);
+
+        dev_t dev;
+        ino_t ino;
+        if (!fileIdentityOf(sim_fd, dev, ino))
+            return static_cast<RegVal>(-errno);
+
+        if (cmd == FGetlk) {
+            const GuestFileLock *found = nullptr;
+            for (const auto &lock : guestFileLocks) {
+                if (lock.dev != dev || lock.ino != ino)
+                    continue;
+                if (lock.owner == process)
+                    continue;
+                if (type == F_RDLCK && lock.type == F_RDLCK)
+                    continue; // read/read do not conflict
+                if (!lockOverlaps(lock, start, length))
+                    continue;
+                found = &lock;
+                break;
+            }
+            std::memset(raw, 0, sizeof(raw));
+            if (found != nullptr) {
+                writeBigEndian16(raw, found->type);
+                writeBigEndian16(raw + 2, 0 /* SEEK_SET */);
+                writeBigEndian64(raw + 8, found->start);
+                writeBigEndian64(raw + 16, found->len);
+                writeBigEndian32(raw + 24, found->owner->pid());
+            } else {
+                writeBigEndian16(raw, FUnlck);
+            }
+            if (!writeGuestBlob(tc, static_cast<Addr>(arg), raw, sizeof(raw)))
+                return static_cast<RegVal>(-EFAULT);
+            return 0;
+        }
+
+        // F_SETLK / F_SETLKW: release, or take (replacing this process's own
+        // overlapping range, as POSIX specifies).
+        dropProcessLocks(process, dev, ino);
+        if (type == FUnlck)
+            return 0;
+
+        bool conflict = false;
+        for (const auto &lock : guestFileLocks) {
+            if (lock.dev != dev || lock.ino != ino || lock.owner == process)
+                continue;
+            if (lockOverlaps(lock, start, length)) {
+                conflict = true;
+                break;
+            }
+        }
+        if (conflict) {
+            if (cmd == FSetlkw && !(::fcntl(sim_fd, F_GETFL) & O_NONBLOCK)) {
+                blocked = true; // retried until the owner releases
+                return 0;
+            }
+            return static_cast<RegVal>(-EAGAIN);
+        }
+        // Re-insert every lock this process still holds on the file (the drop
+        // above removed them); POSIX replaces only the overlapping range, and
+        // no corpus case holds more than one lock per file.
+        guestFileLocks.push_back({dev, ino, process, type, start, length});
+        return 0;
+      }
+
+      default:
+        fatal("DADAO SE: fcntl command %d not implemented (fd=%d)", cmd, fd);
+    }
+}
+
+/** fstat(2). */
+RegVal
+doFstat(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr stat_addr)
+{
+    // A pipe end has no host descriptor; report what the kernel would: an
+    // S_IFIFO with no size (musl's stdio asks to pick its buffering).
+    if (std::shared_ptr<DadaoPipeFDEntry> pipe; pipeFdOf(process, fd, pipe)) {
+        struct stat pipe_stat;
+        std::memset(&pipe_stat, 0, sizeof(pipe_stat));
+        pipe_stat.st_mode = S_IFIFO | 0600;
+        pipe_stat.st_nlink = 1;
+        pipe_stat.st_blksize = 4096;
+        pipe_stat.st_uid = ::geteuid();
+        pipe_stat.st_gid = ::getegid();
+        uint8_t raw[GuestStatSize];
+        packGuestStat(pipe_stat, raw);
+        if (!writeGuestBlob(tc, stat_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        return 0;
+    }
+
+    int sim_fd;
+    if (int status = hostFdOf(process, fd, sim_fd); status != 0)
+        return static_cast<RegVal>(status);
+
+    struct stat host_stat;
+    if (::fstat(sim_fd, &host_stat) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestStatSize];
+    packGuestStat(host_stat, raw);
+    if (!writeGuestBlob(tc, stat_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** newfstatat(2) / fstatat64(2). */
+RegVal
+doNewfstatat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+             Addr path_addr, Addr stat_addr, int flags)
+{
+    if (flags & ~(AtSymlinkNofollow | AtEmptyPath | AtNoAutomount))
+        return static_cast<RegVal>(-EINVAL);
+
+    struct stat host_stat;
+    bool use_fd = path_addr == 0;
+    std::string path;
+
+    if (path_addr != 0 && !readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+    if (path_addr != 0 && path.empty())
+        use_fd = flags & AtEmptyPath;
+    if (path_addr == 0 && !(flags & AtEmptyPath))
+        return static_cast<RegVal>(-EFAULT);
+
+    if (use_fd) {
+        int sim_fd;
+        if (int status = hostFdOf(process, dirfd, sim_fd); status != 0)
+            return static_cast<RegVal>(status);
+        if (::fstat(sim_fd, &host_stat) < 0)
+            return static_cast<RegVal>(-errno);
+    } else {
+        std::string host_path;
+        if (int status = resolveGuestPath(process, dirfd, path, host_path);
+            status != 0)
+            return static_cast<RegVal>(status);
+        const int result = (flags & AtSymlinkNofollow) ?
+            ::lstat(host_path.c_str(), &host_stat) :
+            ::stat(host_path.c_str(), &host_stat);
+        if (result < 0)
+            return static_cast<RegVal>(-errno);
+    }
+
+    uint8_t raw[GuestStatSize];
+    packGuestStat(host_stat, raw);
+    if (!writeGuestBlob(tc, stat_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** statfs(2). */
+RegVal
+doStatfs(ThreadContext *tc, DadaoISA::Process *process, Addr path_addr,
+         Addr buf_addr)
+{
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string host_path;
+    if (int status = resolveGuestPath(process, AtFdcwd, path, host_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    struct statfs host_statfs;
+    if (::statfs(host_path.c_str(), &host_statfs) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestStatfsSize];
+    packGuestStatfs(host_statfs, raw);
+    if (!writeGuestBlob(tc, buf_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** faccessat(2)/faccessat2(2).  SE has no permission model of its own, so the
+ *  host's answer is the guest's (same as QEMU user mode); the flag and mode
+ *  validation is the kernel's (fs/open.c: do_faccessat). */
+int
+hostFaccessat(int dirfd, const std::string &path, int mode, int flags)
+{
+    // faccessat2 is the flag-carrying form; the guest ABI's flag values are
+    // the host's, so they pass through unchanged.
+#ifdef SYS_faccessat2
+    const int result =
+        ::syscall(SYS_faccessat2, dirfd, path.c_str(), mode, flags);
+    if (result >= 0)
+        return 0;
+    if (errno != ENOSYS)
+        return -errno;
+    // Pre-5.8 host: only the legacy call exists, and it has no flags.
+    if (flags != 0)
+        return -ENOSYS;
+    return ::faccessat(dirfd, path.c_str(), mode, 0) < 0 ? -errno : 0;
+#else
+    if (flags != 0)
+        return -ENOSYS;
+    return ::faccessat(dirfd, path.c_str(), mode, 0) < 0 ? -errno : 0;
+#endif
+}
+
+RegVal
+doFaccessat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+            Addr path_addr, int mode, int flags)
+{
+    // Kernel validation order: unknown mode bits and unknown flags are EINVAL
+    // before the path is even touched.
+    if (mode & ~(R_OK | W_OK | X_OK))
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & ~(AtEaccess | AtSymlinkNofollow | AtEmptyPath))
+        return static_cast<RegVal>(-EINVAL);
+
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    // AT_EMPTY_PATH: an empty path operates on the descriptor itself.  Without
+    // the flag an empty path simply does not name anything (ENOENT).
+    if (path.empty()) {
+        if (!(flags & AtEmptyPath))
+            return static_cast<RegVal>(-ENOENT);
+        if (dirfd == AtFdcwd) {
+            // The kernel substitutes the working directory for AT_FDCWD.
+            std::string host_cwd = process->checkPathRedirect(process->tgtCwd);
+            return static_cast<RegVal>(
+                hostFaccessat(AT_FDCWD, host_cwd, mode,
+                              flags & ~AtEmptyPath));
+        }
+        std::shared_ptr<FDEntry> entry;
+        if (int status = guestFdEntry(process, dirfd, entry); status != 0)
+            return static_cast<RegVal>(status);
+        if (auto hostEntry = std::dynamic_pointer_cast<HBFDEntry>(entry))
+            return static_cast<RegVal>(
+                hostFaccessat(hostEntry->getSimFD(), "", mode, flags));
+        if (std::dynamic_pointer_cast<DadaoPipeFDEntry>(entry)) {
+            // A pipe inode is 0600 for its owner: any access except execute
+            // passes (the host would say the same for its own pipe fd).
+            return static_cast<RegVal>((mode & X_OK) ? -EACCES : 0);
+        }
+        return static_cast<RegVal>(-EACCES);
+    }
+
+    std::string host_path;
+    if (int status = resolveGuestPath(process, dirfd, path, host_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    return static_cast<RegVal>(
+        hostFaccessat(AT_FDCWD, host_path, mode, flags & ~AtEmptyPath));
+}
+
+/** getdents64(2).
+ *
+ * The host's struct linux_dirent64 has the same field widths and alignment as
+ * the guest's, so the buffer is converted in place (only the three integer
+ * fields change byte order) and keeps its exact length.
+ */
+RegVal
+doGetdents64(ThreadContext *tc, DadaoISA::Process *process, int fd,
+             Addr dir_addr, uint64_t count)
+{
+    if (count == 0)
+        return static_cast<RegVal>(-EINVAL);
+
+    int sim_fd;
+    if (int status = hostFdOf(process, fd, sim_fd); status != 0)
+        return static_cast<RegVal>(status);
+
+    std::vector<uint8_t> data(count);
+    long bytes_read;
+    do {
+        bytes_read = ::syscall(SYS_getdents64, sim_fd, data.data(), count);
+    } while (bytes_read < 0 && errno == EINTR);
+
+    if (bytes_read < 0)
+        return static_cast<RegVal>(-errno);
+    if (bytes_read == 0)
+        return 0;
+
+    size_t offset = 0;
+    while (offset < static_cast<size_t>(bytes_read)) {
+        if (offset + GuestDirent64Type + 1 > static_cast<size_t>(bytes_read))
+            return static_cast<RegVal>(-EINVAL);
+
+        uint64_t ino;
+        int64_t d_off;
+        uint16_t reclen;
+        std::memcpy(&ino, &data[offset + GuestDirent64Ino], sizeof(ino));
+        std::memcpy(&d_off, &data[offset + GuestDirent64Off], sizeof(d_off));
+        std::memcpy(&reclen, &data[offset + GuestDirent64Reclen],
+                    sizeof(reclen));
+        if (reclen < GuestDirent64Type + 1 ||
+            offset + reclen > static_cast<size_t>(bytes_read))
+            return static_cast<RegVal>(-EINVAL);
+
+        writeBigEndian64(&data[offset + GuestDirent64Ino], ino);
+        writeBigEndian64(&data[offset + GuestDirent64Off], d_off);
+        writeBigEndian16(&data[offset + GuestDirent64Reclen], reclen);
+        // d_type is a single byte: no byte-order conversion.
+        offset += reclen;
+    }
+
+    if (!writeGuestBlob(tc, dir_addr, data.data(), bytes_read))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(bytes_read);
+}
+
+/** utimensat(2); a null pathname means "operate on dirfd" (musl's futimens
+ * is implemented as utimensat(fd, 0, times, 0)). */
+RegVal
+doUtimensat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+            Addr path_addr, Addr times_addr, int flags)
+{
+    if (flags & ~AtSymlinkNofollow)
+        return static_cast<RegVal>(-EINVAL);
+
+    struct timespec times[2];
+    const struct timespec *times_ptr = nullptr;
+    if (times_addr != 0) {
+        uint8_t raw[2 * GuestTimespecSize];
+        if (!readGuestBlob(tc, times_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        times[0].tv_sec = readBigEndian64(raw);
+        times[0].tv_nsec = readBigEndian64(raw + 8);
+        times[1].tv_sec = readBigEndian64(raw + 16);
+        times[1].tv_nsec = readBigEndian64(raw + 24);
+        times_ptr = times;
+    }
+
+    int result;
+    if (path_addr == 0) {
+        int sim_fd;
+        if (int status = hostFdOf(process, dirfd, sim_fd); status != 0)
+            return static_cast<RegVal>(status);
+        result = ::futimens(sim_fd, times_ptr);
+    } else {
+        std::string path;
+        if (!readGuestString(tc, path_addr, path))
+            return static_cast<RegVal>(-EFAULT);
+        std::string host_path;
+        if (int status = resolveGuestPath(process, dirfd, path, host_path);
+            status != 0)
+            return static_cast<RegVal>(status);
+        result = ::utimensat(AT_FDCWD, host_path.c_str(), times_ptr,
+                             (flags & AtSymlinkNofollow) ?
+                                 AT_SYMLINK_NOFOLLOW : 0);
+    }
+
+    return result < 0 ? static_cast<RegVal>(-errno) : 0;
+}
+
+/** readlinkat(2). */
+RegVal
+doReadlinkat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+             Addr path_addr, Addr buf_addr, uint64_t bufsiz)
+{
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string host_path;
+    if (int status = resolveGuestPath(process, dirfd, path, host_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    std::vector<char> data(bufsiz);
+    ssize_t result = ::readlink(host_path.c_str(), data.data(), bufsiz);
+    if (result < 0)
+        return static_cast<RegVal>(-errno);
+    if (result > 0 && !writeGuestBlob(tc, buf_addr, data.data(), result))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(result);
+}
+
+/** unlinkat(2). */
+RegVal
+doUnlinkat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+           Addr path_addr, int flags)
+{
+    if (flags & ~AtRemovedir)
+        return static_cast<RegVal>(-EINVAL);
+
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string host_path;
+    if (int status = resolveGuestPath(process, dirfd, path, host_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    const int result = (flags & AtRemovedir) ?
+        ::rmdir(host_path.c_str()) : ::unlink(host_path.c_str());
+    return result < 0 ? static_cast<RegVal>(-errno) : 0;
+}
+
+/** mkdirat(2). */
+RegVal
+doMkdirat(ThreadContext *tc, DadaoISA::Process *process, int dirfd,
+          Addr path_addr, uint32_t mode)
+{
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string host_path;
+    if (int status = resolveGuestPath(process, dirfd, path, host_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    return ::mkdir(host_path.c_str(), mode) < 0 ?
+        static_cast<RegVal>(-errno) : 0;
+}
+
+/** chdir(2): move the guest cwd (Process::tgtCwd, always stored with a
+ *  trailing '/') and the host directory it maps to.  musl's daemon(3) needs
+ *  it before its open("/dev/null"). */
+RegVal
+doChdir(ThreadContext *tc, DadaoISA::Process *process, Addr path_addr)
+{
+    std::string path;
+    if (!readGuestString(tc, path_addr, path))
+        return static_cast<RegVal>(-EFAULT);
+
+    std::string guest_path;
+    std::string host_path;
+    if (int status =
+            resolveGuestPath(process, AtFdcwd, path, host_path, &guest_path);
+        status != 0)
+        return static_cast<RegVal>(status);
+
+    struct stat st;
+    if (::stat(host_path.c_str(), &st) < 0)
+        return static_cast<RegVal>(-errno);
+    if (!S_ISDIR(st.st_mode))
+        return static_cast<RegVal>(-ENOTDIR);
+
+    if (guest_path.empty() || guest_path.back() != '/')
+        guest_path += '/';
+    process->tgtCwd = guest_path;
+    process->hostCwd = process->checkPathRedirect(guest_path);
+    return 0;
+}
+
+/** clock_gettime(2). */
+RegVal
+doClockGettime(ThreadContext *tc, int clock_id, Addr tp_addr)
+{
+    int64_t sec = 0;
+    int64_t nsec = 0;
+
+    switch (clock_id) {
+      case CLOCK_REALTIME: {
+        // Wall-clock time stays host-backed (QEMU user mode passes it
+        // through too); the guest compares it against host file timestamps.
+        struct timespec now;
+        if (::clock_gettime(CLOCK_REALTIME, &now) < 0)
+            return static_cast<RegVal>(-errno);
+        sec = now.tv_sec;
+        nsec = now.tv_nsec;
+        break;
+      }
+      case CLOCK_MONOTONIC:
+      case CLOCK_PROCESS_CPUTIME_ID:
+      case CLOCK_THREAD_CPUTIME_ID: {
+        // Simulated nanoseconds, derived from curTick() at the GEM5-019t
+        // 1e9-ticks/s baseline.  SE is single-threaded, so thread CPU time
+        // and process CPU time are the same simulated-time counter.
+        const uint64_t elapsed = simulatedNanoseconds();
+        sec = elapsed / 1000000000ULL;
+        nsec = elapsed % 1000000000ULL;
+        break;
+      }
+      default:
+        return static_cast<RegVal>(-EINVAL);
+    }
+
+    uint8_t raw[GuestTimespecSize];
+    packGuestTimespec(raw, sec, nsec);
+    if (!writeGuestBlob(tc, tp_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** clock_getres(2). */
+RegVal
+doClockGetres(ThreadContext *tc, int clock_id, Addr tp_addr)
+{
+    switch (clock_id) {
+      case CLOCK_REALTIME:
+      case CLOCK_MONOTONIC:
+      case CLOCK_PROCESS_CPUTIME_ID:
+      case CLOCK_THREAD_CPUTIME_ID:
+        break;
+      default:
+        return static_cast<RegVal>(-EINVAL);
+    }
+
+    if (tp_addr != 0) {
+        uint8_t raw[GuestTimespecSize];
+        packGuestTimespec(raw, 0, 1);
+        if (!writeGuestBlob(tc, tp_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** gettimeofday(2). */
+RegVal
+doGettimeofday(ThreadContext *tc, Addr tv_addr, Addr tz_addr)
+{
+    struct timeval now;
+    if (::gettimeofday(&now, nullptr) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestTimevalSize];
+    writeBigEndian64(raw, now.tv_sec);
+    writeBigEndian64(raw + 8, now.tv_usec);
+    if (!writeGuestBlob(tc, tv_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+
+    if (tz_addr != 0) {
+        uint8_t tz[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+        if (!writeGuestBlob(tc, tz_addr, tz, sizeof(tz)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** Write a timespec in guest order (nanosleep's `rem`). */
+bool
+writeGuestTimespecNs(ThreadContext *tc, Addr addr, uint64_t nanoseconds)
+{
+    if (addr == 0)
+        return true;
+    uint8_t raw[GuestTimespecSize];
+    packGuestTimespec(raw, nanoseconds / 1000000000ULL,
+                      nanoseconds % 1000000000ULL);
+    return writeGuestBlob(tc, addr, raw, sizeof(raw));
+}
+
+uint64_t
+ticksToNanoseconds(Tick ticks)
+{
+    if (ticks <= 0)
+        return 0;
+    const unsigned __int128 ns =
+        static_cast<unsigned __int128>(ticks) * 1000000000ULL;
+    return static_cast<uint64_t>(ns / sim_clock::Frequency);
+}
+
+Tick
+nanosecondsToTicks(uint64_t nanoseconds)
+{
+    const unsigned __int128 ticks = static_cast<unsigned __int128>(nanoseconds) *
+                                    sim_clock::Frequency / 1000000000ULL;
+    return static_cast<Tick>(ticks == 0 ? 1 : ticks);
+}
+
+/** One thread asleep in nanosleep(2) (GEM5-029t).
+ *
+ * SE has no host-side clock to sleep on: the wait is a gem5 event at the
+ * deadline in *guest* time, so the simulator advances its own clock the same
+ * way it does for a futex timeout, and the caller's context is suspended (the
+ * CPU keeps running every other process/thread).  A signal that arrives before
+ * the deadline cancels the event and returns EINTR with the remaining time.
+ */
+struct SleepWaiter
+{
+    DadaoISA::Process *process = nullptr;
+    ContextID cid = 0;
+    Addr remAddr = 0;
+    Tick deadline = 0;
+    Event *timeout = nullptr;
+};
+
+std::list<SleepWaiter *> sleepWaiters;
+
+void
+nanosleepTimeout(SleepWaiter *waiter);
+
+/** The event is AutoDelete (Managed): the queue frees it after dispatch and on
+ *  deschedule, so a non-null pointer means "still scheduled". */
+void
+cancelSleepTimeout(SleepWaiter *waiter)
+{
+    Event *event = waiter->timeout;
+    waiter->timeout = nullptr;
+    if (event != nullptr && event->scheduled())
+        getEventQueue(0)->deschedule(event);
+}
+
+SleepWaiter *
+findSleepWaiter(DadaoISA::Process *process, ContextID cid)
+{
+    for (auto *waiter : sleepWaiters) {
+        if (waiter->process == process && waiter->cid == cid)
+            return waiter;
+    }
+    return nullptr;
+}
+
+void
+dropSleepWaiter(SleepWaiter *waiter)
+{
+    sleepWaiters.remove(waiter);
+    cancelSleepTimeout(waiter);
+    delete waiter;
+}
+
+void
+dropThreadSleepWaiters(DadaoISA::Process *process, ContextID cid)
+{
+    std::vector<SleepWaiter *> dropped;
+    for (auto *waiter : sleepWaiters) {
+        if (waiter->process == process && waiter->cid == cid)
+            dropped.push_back(waiter);
+    }
+    for (auto *waiter : dropped)
+        dropSleepWaiter(waiter);
+}
+
+void
+dropProcessSleepWaiters(DadaoISA::Process *process)
+{
+    std::vector<SleepWaiter *> dropped;
+    for (auto *waiter : sleepWaiters) {
+        if (waiter->process == process)
+            dropped.push_back(waiter);
+    }
+    for (auto *waiter : dropped)
+        dropSleepWaiter(waiter);
+}
+
+/** Park the calling thread until `nanoseconds` of guest time have elapsed.
+ *  The deadline event writes rd8 = 0 and reactivates the context. */
+void
+parkNanosleep(ThreadContext *tc, DadaoISA::Process *process,
+              uint64_t nanoseconds, Addr remAddr)
+{
+    auto *waiter = new SleepWaiter();
+    waiter->process = process;
+    waiter->cid = tc->contextId();
+    waiter->remAddr = remAddr;
+    waiter->deadline = curTick() + nanosecondsToTicks(nanoseconds);
+
+    auto *event = new EventFunctionWrapper([waiter] { nanosleepTimeout(waiter); },
+                                           "dadao-nanosleep-timeout", true);
+    waiter->timeout = event;
+    getEventQueue(0)->schedule(event, waiter->deadline);
+
+    sleepWaiters.push_back(waiter);
+    tc->suspend();
+}
+
+void
+nanosleepTimeout(SleepWaiter *waiter)
+{
+    // The queue deletes the event itself after process() returns.
+    waiter->timeout = nullptr;
+    if (std::find(sleepWaiters.begin(), sleepWaiters.end(), waiter) ==
+        sleepWaiters.end())
+        return; // interrupted before this fired
+    sleepWaiters.remove(waiter);
+    ThreadContext *tc = waiter->process->system->threads[waiter->cid];
+    tc->setReg(rd(8), static_cast<RegVal>(0)); // rem untouched on success
+    if (tc->status() == ThreadContext::Suspended)
+        tc->activate();
+    delete waiter;
+}
+
+/** A signal reached a thread asleep in nanosleep(2): cancel the deadline and
+ *  hand the interrupted call back with EINTR and the remaining guest time in
+ *  `rem` (Linux only writes rem when it returns EINTR).  Returns true when the
+ *  thread was asleep. */
+bool
+interruptNanosleep(ThreadContext *tc, DadaoISA::Process *process,
+                   DadaoISA::ThreadState &thread)
+{
+    SleepWaiter *waiter = findSleepWaiter(process, tc->contextId());
+    if (waiter == nullptr)
+        return false;
+    const Tick now = curTick();
+    const uint64_t remaining =
+        waiter->deadline > now ? ticksToNanoseconds(waiter->deadline - now) : 0;
+    const Addr remAddr = waiter->remAddr;
+    dropSleepWaiter(waiter);
+    // Linux writes rem first and reports EFAULT when that copy fails, even
+    // though the sleep was interrupted (hrtimer_nanosleep's put_timespec64).
+    const bool wrote = writeGuestTimespecNs(tc, remAddr, remaining);
+    tc->setReg(rd(8), static_cast<RegVal>(wrote ? -EINTR : -EFAULT));
+    (void)thread;
+    return true;
+}
+
+/** nanosleep(2).
+ *
+ * Linux semantics: validate the request (EINVAL), return 0 for a zero
+ * request, return EINTR + `rem` when a signal interrupts the sleep, ignore
+ * `rem` otherwise, and take `rem == NULL`.  The sleep itself advances guest
+ * time through the event queue (see SleepWaiter above); it never blocks the
+ * host process, because other guest processes/threads must keep running.
+ */
+RegVal
+doNanosleep(ThreadContext *tc, DadaoISA::Process *process, Addr req_addr,
+            Addr rem_addr, bool &parked)
+{
+    uint8_t raw[GuestTimespecSize];
+    if (!readGuestBlob(tc, req_addr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+
+    const int64_t sec = readBigEndian64(raw);
+    const int64_t nsec = readBigEndian64(raw + 8);
+    if (sec < 0 || nsec < 0 || nsec >= 1000000000LL)
+        return static_cast<RegVal>(-EINVAL);
+
+    const unsigned __int128 requested =
+        static_cast<unsigned __int128>(sec) * 1000000000ULL +
+        static_cast<uint64_t>(nsec);
+    if (requested == 0)
+        return 0;
+
+    // An already pending, unblocked signal ends the call before it sleeps:
+    // EINTR with the whole request still to go (delivered on the way out).
+    if (DadaoISA::ThreadState *thread = process->findThread(tc->contextId())) {
+        if ((thread->pending & ~thread->blocked) != 0) {
+            if (!writeGuestTimespecNs(tc, rem_addr,
+                                      static_cast<uint64_t>(requested)))
+                return static_cast<RegVal>(-EFAULT);
+            return static_cast<RegVal>(-EINTR);
+        }
+    }
+
+    parkNanosleep(tc, process, static_cast<uint64_t>(requested), rem_addr);
+    parked = true;
+    return 0;
+}
+
+/** time(2). */
+RegVal
+doTime(ThreadContext *tc, Addr tloc_addr)
+{
+    const time_t now = ::time(nullptr);
+    if (now == static_cast<time_t>(-1))
+        return static_cast<RegVal>(-errno);
+    if (tloc_addr != 0) {
+        uint8_t raw[8];
+        writeBigEndian64(raw, now);
+        if (!writeGuestBlob(tc, tloc_addr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return static_cast<RegVal>(now);
+}
+
+/** First page of the heap: the heap must never unmap the loaded image. */
+Addr
+heapFloor(DadaoISA::Process *process)
+{
+    return roundUp(process->image.maxAddr(), process->pTable->pageSize());
+}
+
+/** Top of the guest mmap window (defined with extendMmap() below). */
+Addr mmapCeiling(DadaoISA::Process *process);
+
+/** brk(2): move the program break (the anonymous heap).
+ *
+ * Linux semantics (the reference for numbers, flags and errno is the locked
+ * upstream table, contract-syscall §1.2/§5): brk(0) queries and returns the
+ * current break; a successful move returns the new break; a failed one
+ * returns the *old* break and never -ENOMEM.  The heap may neither unmap the
+ * loaded image nor grow past the SE mmap window (the two share [image end,
+ * MmapWindowEnd) and grow towards each other, as they do on Linux).  Pages
+ * are mapped lazily: the VMA is registered here and the physical page is
+ * allocated on first touch by MemState::fixupFault(), the same path the stack
+ * uses.
+ */
+RegVal
+doBrk(DadaoISA::Process *process, Addr new_brk)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr old_brk = mem_state->getBrkPoint();
+    // The interpreter (PT_INTERP) sits at the top of the mmap window but is
+    // not a VMA, so the heap must stop below it as well (GEM5-028t).
+    const Addr heap_limit =
+        std::min<Addr>(mem_state->getStackMin(), mmapCeiling(process));
+
+    if (new_brk == 0 || new_brk == old_brk)
+        return old_brk;
+
+    if (new_brk < heapFloor(process) || new_brk > heap_limit)
+        return old_brk;
+
+    // Address-space limits: a growing heap is a mapping like any other, so
+    // both RLIMIT_AS and RLIMIT_DATA apply (kernel may_expand_vm(); QEMU's
+    // do_brk() grows through target_mmap()).  Failure returns the old break,
+    // never -ENOMEM.
+    if (new_brk > old_brk) {
+        const Addr growth =
+            roundUp(new_brk - old_brk, process->pTable->pageSize());
+        if (!process->asLimitAllows(growth) ||
+            !process->dataLimitAllows(growth))
+            return old_brk;
+    }
+
+    mem_state->updateBrkRegion(old_brk, new_brk);
+    // Mirror the VMA move in the protection shadow (the heap is read/write,
+    // no execute).  updateBrkRegion() may silently refuse when the range is
+    // occupied, so follow the break it actually set.
+    const Addr now = mem_state->getBrkPoint();
+    const Addr page_bytes = process->pTable->pageSize();
+    if (now > old_brk)
+        process->setProtection(roundUp(old_brk, page_bytes),
+                               roundUp(now, page_bytes),
+                               DadaoISA::Process::ProtRead |
+                                   DadaoISA::Process::ProtWrite);
+    else if (now < old_brk)
+        process->clearProtection(roundUp(now, page_bytes),
+                                 roundUp(old_brk, page_bytes));
+    return now;
+}
+
+/** Top of the guest mmap window.
+ *
+ * Process::updateBias() carves the PT_INTERP image out of the top of the
+ * window and applies its load bias; MemState's mmap end is lowered to that
+ * bias (mmapGrowsDown() is true).  The interpreter is not in the VMA list, so
+ * every address-space path that still used MmapWindowEnd (brk, MAP_FIXED
+ * probes, mremap, munmap's window reuse) could grow into it: bound them all
+ * by the interpreter base instead.  (This gem5 tree never assigns
+ * ElfObject::ldMin/ldMax, so mapSize() is 0 and the base is 8 GiB today; the
+ * bound stays correct if that is ever fixed.)
+ */
+Addr
+mmapCeiling(DadaoISA::Process *process)
+{
+    return process->getInterpreter() ? process->getBias()
+                                     : DadaoISA::MmapWindowEnd;
+}
+
+/** Read exactly `len` bytes at `off` from a host file (pread, so the fd's
+ *  own offset is untouched and a guest lseek() is never disturbed). */
+bool
+preadExact(int fd, void *buf, size_t len, off_t off)
+{
+    uint8_t *p = static_cast<uint8_t *>(buf);
+    while (len > 0) {
+        const ssize_t n = ::pread(fd, p, len, off);
+        if (n <= 0)
+            return false;
+        p += n;
+        len -= static_cast<size_t>(n);
+        off += n;
+    }
+    return true;
+}
+
+uint16_t
+fileBe16(const uint8_t *p)
+{
+    return uint16_t((uint16_t(p[0]) << 8) | uint16_t(p[1]));
+}
+
+uint32_t
+fileBe32(const uint8_t *p)
+{
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) |
+           (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+}
+
+uint64_t
+fileBe64(const uint8_t *p)
+{
+    return (uint64_t(fileBe32(p)) << 32) | fileBe32(p + 4);
+}
+
+/** Reject a DADAO ELF whose PT_LOAD segments are not 64 KiB-congruent.
+ *
+ * ldso maps each PT_LOAD at `base + (p_vaddr & -PAGE)`, i.e. it rounds the
+ * virtual address *and* the file offset down to the target page size and
+ * expects the kernel to return the same page offset for both.  With a 64 KiB
+ * target page that only holds when (p_vaddr - p_offset) % 65536 == 0; lld's
+ * defaultMaxPageSize=0x10000 produces such images, but a segment that breaks
+ * the rule would be silently misplaced (wrong bytes at the wrong address).
+ * Failing closed here is the only way the guest can report it.
+ *
+ * The fd is the host descriptor behind the guest's FileFDEntry, so this sees
+ * exactly the bytes ldso will map, independent of the guest path.
+ */
+void
+checkMappedElfSegments(int fd, const std::string &name)
+{
+    uint8_t eh[64];
+    if (!preadExact(fd, eh, sizeof(eh), 0))
+        return;
+    if (eh[0] != 0x7f || eh[1] != 'E' || eh[2] != 'L' || eh[3] != 'F')
+        return;  // not an ELF: nothing to check (data files are valid)
+    if (eh[4] != 2 || eh[5] != 2 || eh[6] != 1)
+        return;  // not ELFCLASS64 / ELFDATA2MSB / EV_CURRENT
+    if (fileBe16(eh + 18) != 0x0da0)
+        return;  // not DADAO (EM_DADAO)
+
+    const uint64_t phoff = fileBe64(eh + 32);
+    const uint16_t phentsize = fileBe16(eh + 54);
+    const uint16_t phnum = fileBe16(eh + 56);
+    if (phentsize < 56 || phnum == 0 || phnum > 512)
+        return;
+
+    std::vector<uint8_t> phdrs(size_t(phentsize) * phnum);
+    if (!preadExact(fd, phdrs.data(), phdrs.size(), phoff))
+        fatal("DADAO SE: cannot read the program headers of '%s'",
+              name.c_str());
+
+    for (unsigned i = 0; i < phnum; ++i) {
+        const uint8_t *ph = phdrs.data() + size_t(i) * phentsize;
+        if (fileBe32(ph) != 1)  // PT_LOAD
+            continue;
+        const uint64_t offset = fileBe64(ph + 8);
+        const uint64_t vaddr = fileBe64(ph + 16);
+        if ((vaddr - offset) & (DadaoISA::PageBytes - 1))
+            fatal("DADAO SE: '%s' PT_LOAD %u has p_vaddr=%#llx, "
+                  "p_offset=%#llx: (p_vaddr - p_offset) %% %llu != 0, so the "
+                  "64 KiB target page cannot map it without misaligning the "
+                  "segment",
+                  name.c_str(), i,
+                  static_cast<unsigned long long>(vaddr),
+                  static_cast<unsigned long long>(offset),
+                  static_cast<unsigned long long>(DadaoISA::PageBytes));
+    }
+}
+
+/** Place an anonymous mapping of `length` bytes in the SE mmap window.
+ *
+ * The window grows downwards from its top (MmapWindowEnd); 0 means the window
+ * is exhausted.  The scan is bounded by the image end so an address-space
+ * fill cannot walk into the loaded image (whose pages have no VMA).
+ */
+Addr
+extendMmap(DadaoISA::Process *process, Addr length)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr floor = heapFloor(process);
+    Addr start = mem_state->getMmapEnd();
+
+    while (start >= floor && start - floor >= length) {
+        start -= length;
+        if (mem_state->isUnmapped(start, length)) {
+            mem_state->setMmapEnd(start);
+            return start;
+        }
+        start -= page_bytes;
+    }
+    return 0;
+}
+
+/** mmap(2): anonymous and file-backed mappings (MAP_PRIVATE|MAP_SHARED,
+ *  MAP_FIXED).  A non-anonymous descriptor is resolved through its
+ *  FileFDEntry and handed to MemState::mapRegion(), whose VMA copies the file
+ *  (host mmap) lazily into guest pages on first touch; the host mapping is
+ *  created here, so closing the guest fd afterwards cannot invalidate it. */
+RegVal
+doMmap(DadaoISA::Process *process, Addr hint, uint64_t length, uint64_t prot,
+       uint64_t flags, int fd, uint64_t offset)
+{
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (length == 0)
+        return static_cast<RegVal>(-EINVAL);
+    if (offset & (page_bytes - 1))
+        return static_cast<RegVal>(-EINVAL);
+    if (prot & ~(ProtRead | ProtWrite | ProtExec | ProtSem))
+        return static_cast<RegVal>(-EINVAL);
+    prot &= ProtMask;
+
+    const bool is_private = flags & MapPrivate;
+    const bool is_shared = flags & MapShared;
+    if (is_private == is_shared)  // exactly one of the two is required
+        return static_cast<RegVal>(-EINVAL);
+
+    if (length > max_addr - page_bytes)
+        return static_cast<RegVal>(-ENOMEM);
+    length = roundUp(length, page_bytes);
+    if (length > max_addr - hint)
+        return static_cast<RegVal>(-ENOMEM);
+
+    // Guest address-space limits (GEM5-030t).  QEMU's target_mmap() checks
+    // these before touching the address space; MAP_GROWSDOWN is the
+    // stack-shaped mapping and is charged to RLIMIT_STACK instead of the
+    // private-writable RLIMIT_DATA branch.
+    const bool growsdown = flags & MapGrowsdown;
+    if (!process->asLimitAllows(length))
+        return static_cast<RegVal>(-ENOMEM);
+    if (growsdown && !process->stackLimitAllows(length))
+        return static_cast<RegVal>(-ENOMEM);
+    if (!growsdown && is_private && (prot & ProtWrite) &&
+        !process->dataLimitAllows(length))
+        return static_cast<RegVal>(-ENOMEM);
+
+    int sim_fd = -1;
+    Addr file_offset = 0;
+    std::string region_name = "anon";
+
+    if (!(flags & MapAnonymous)) {
+        // A descriptor is only valid when it is actually open.  A valid but
+        // non-mappable descriptor (stdin/stdout/stderr or a pipe/socket)
+        // gets ENODEV, which is what Linux reports for fds without an mmap
+        // method.
+        if (fd < 0 || fd >= process->fds->getSize() ||
+            !(*process->fds)[fd])
+            return static_cast<RegVal>(-EBADF);
+        auto ffdp =
+            std::dynamic_pointer_cast<FileFDEntry>((*process->fds)[fd]);
+        if (!ffdp)
+            return static_cast<RegVal>(-ENODEV);
+        sim_fd = ffdp->getSimFD();
+        region_name = ffdp->getFileName();
+
+        struct stat st;
+        if (sim_fd < 0 || ::fstat(sim_fd, &st) != 0)
+            return static_cast<RegVal>(-EBADF);
+        // Only a regular file has page contents to map.  Linux answers
+        // ENODEV for a directory or socket; gem5's VMA would panic trying
+        // to host-mmap one, so fail here instead.
+        if (!S_ISREG(st.st_mode))
+            return static_cast<RegVal>(-ENODEV);
+        // Linux answers EACCES for a PROT_READ mapping of a write-only fd and
+        // for a writable MAP_SHARED mapping without write permission; both
+        // would otherwise reach VMA's host mmap and panic there.
+        const int accmode = ::fcntl(sim_fd, F_GETFL) & O_ACCMODE;
+        if (accmode == O_WRONLY ||
+            ((flags & MapShared) && (prot & ProtWrite) && accmode != O_RDWR))
+            return static_cast<RegVal>(-EACCES);
+
+        // The segment congruence rule the 64 KiB guest page imposes on a
+        // DSO is a property of the file ldso maps, checked before the VMA
+        // is built (GEM5-028t; requirement: never silently misplace).
+        checkMappedElfSegments(sim_fd, region_name);
+
+        // offset page alignment was checked above.  Linux does not bound
+        // offset+length by the file size (a mapping past EOF is legal and
+        // faults with SIGBUS on access); QEMU is more helpful and turns a
+        // mapping that starts at/after EOF into an anonymous one
+        // (linux-user/mmap.c mmap_h_lt_g).  VMA cannot back a region with an
+        // empty host buffer, so follow the QEMU oracle there.  A mapping
+        // that merely crosses EOF is clamped by VMA's host buffer and the
+        // tail reads as zero -- the same substitution QEMU makes with an
+        // anonymous tail for a 64 KiB target page.
+        if (st.st_size <= 0 || offset >= Addr(st.st_size)) {
+            sim_fd = -1;
+            region_name = "anon";
+        } else {
+            file_offset = offset;
+        }
+    }
+
+    const Addr floor = heapFloor(process);
+    const Addr ceiling = mmapCeiling(process);
+    const bool fixed = flags & (MapFixed | MapFixedNoreplace);
+
+    if (fixed) {
+        // MAP_FIXED requires an aligned address (Linux: EINVAL otherwise).
+        if (hint & (page_bytes - 1))
+            return static_cast<RegVal>(-EINVAL);
+        // The SE guest VA convention bounds mappings to the mmap window,
+        // and the interpreter (when present) occupies its top.
+        if (hint < floor || hint + length > ceiling)
+            return static_cast<RegVal>(-ENOMEM);
+        if (flags & MapFixedNoreplace) {
+            if (!mem_state->isUnmapped(hint, length))
+                return static_cast<RegVal>(-EEXIST);
+        } else {
+            // Linux replaces whatever is mapped in the range (VMAs and any
+            // allocated pages), which is also how the heap guard page of
+            // mallocng is installed below the current break.
+            mem_state->unmapRegion(hint, length);
+            process->clearProtection(hint, hint + length);
+        }
+    } else {
+        // Without MAP_FIXED the address is only a hint: Linux rounds it down
+        // to a page boundary and falls back to its own placement if taken.
+        hint &= ~(page_bytes - 1);
+        const bool use_hint = hint != 0 && hint >= floor &&
+                              hint + length <= ceiling &&
+                              mem_state->isUnmapped(hint, length);
+        if (!use_hint) {
+            hint = extendMmap(process, length);
+            if (hint == 0)
+                return static_cast<RegVal>(-ENOMEM);
+        }
+    }
+
+    mem_state->mapRegion(hint, length, region_name, sim_fd, file_offset);
+    process->setProtection(hint, hint + length, static_cast<uint8_t>(prot),
+                           growsdown);
+    return hint;
+}
+
+/** munmap(2): drop the VMA and the physical pages of the range. */
+RegVal
+doMunmap(DadaoISA::Process *process, Addr start, uint64_t length)
+{
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (!length || (start & (page_bytes - 1)) || length > max_addr - start)
+        return static_cast<RegVal>(-EINVAL);
+
+    const Addr mapped = roundUp(length, page_bytes);
+
+    // unmapRegion() also flushes the TLB and deallocates the pages, so a
+    // later access faults.  The protection shadow must forget the range too:
+    // otherwise RLIMIT_AS/DATA keep counting unmapped pages and a later
+    // access could be checked against a stale permission (GEM5-030t).
+    process->memState->unmapRegion(start, mapped);
+    process->clearProtection(start, start + mapped);
+
+    // Let the next anonymous mapping reuse the freed top of the window.  The
+    // kernel does this; without it a probe/fill sequence such as libc-test's
+    // t_vmfill() (mmap a candidate size, munmap it, then mmap the accepted
+    // size) leaks every probe range above MemState's mmap end.
+    if (start + mapped > process->memState->getMmapEnd() &&
+        start + mapped <= mmapCeiling(process))
+        process->memState->setMmapEnd(start + mapped);
+    return 0;
+}
+
+/** mremap(2): resize/move an existing mapping (mallocng realloc path).
+ *
+ * The kernel rounds both lengths up to the page size before doing anything,
+ * which is also how a guest page size of 64 KiB is honoured (mallocng works
+ * in 4096-byte granules internally).
+ */
+RegVal
+doMremap(DadaoISA::Process *process, Addr old_addr, uint64_t old_size,
+         uint64_t new_size, uint64_t flags, Addr new_addr)
+{
+    constexpr uint64_t MremapMaymove = 0x1;
+    constexpr uint64_t MremapFixed = 0x2;
+    constexpr uint64_t MremapDontunmap = 0x4;
+
+    const std::shared_ptr<MemState> mem_state = process->memState;
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (!old_size || !new_size || (old_addr & (page_bytes - 1)))
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & ~(MremapMaymove | MremapFixed | MremapDontunmap))
+        return static_cast<RegVal>(-EINVAL);
+    if ((flags & MremapFixed) && !(flags & MremapMaymove))
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & MremapDontunmap)
+        return static_cast<RegVal>(-EINVAL);  // not modelled
+    if (old_size > max_addr - old_addr || new_size > max_addr - page_bytes)
+        return static_cast<RegVal>(-EINVAL);
+
+    old_size = roundUp(old_size, page_bytes);
+    new_size = roundUp(new_size, page_bytes);
+
+    // mremap only moves memory that is actually mapped.
+    if (mem_state->isUnmapped(old_addr, old_size))
+        return static_cast<RegVal>(-EFAULT);
+
+    const bool fixed = flags & MremapFixed;
+
+    // Protection of the mapping being resized; a move keeps it, the grown
+    // tail inherits it (Linux mremap keeps the VMA's protection).
+    uint8_t prot = DadaoISA::Process::ProtRead | DadaoISA::Process::ProtWrite;
+    bool growdown = false;
+    process->protectionAt(old_addr, prot, growdown);
+
+    if (!fixed && new_size <= old_size) {
+        if (new_size < old_size) {
+            mem_state->unmapRegion(old_addr + new_size, old_size - new_size);
+            process->clearProtection(old_addr + new_size, old_addr + old_size);
+        }
+        return old_addr;
+    }
+
+    // Plain growth may extend in place when the window has room.  A fixed
+    // request always moves to the requested address.
+    const Addr grow = new_size > old_size ? new_size - old_size : 0;
+    const Addr old_end = old_addr + old_size;
+    const Addr ceiling = mmapCeiling(process);
+    if (!fixed && grow > 0 && old_end <= ceiling &&
+        grow <= ceiling - old_end &&
+        mem_state->isUnmapped(old_end, grow)) {
+        // A growing mapping is bounded by RLIMIT_AS, and by RLIMIT_DATA when
+        // it is writable (QEMU's mremap grows through target_mmap).
+        if (!process->asLimitAllows(grow) ||
+            ((prot & DadaoISA::Process::ProtWrite) &&
+             !process->dataLimitAllows(grow)))
+            return static_cast<RegVal>(-ENOMEM);
+        mem_state->mapRegion(old_end, grow, "anon");
+        process->setProtection(old_end, new_size + old_addr, prot, growdown);
+        return old_addr;
+    }
+    if (!(flags & MremapMaymove))
+        return static_cast<RegVal>(-ENOMEM);
+
+    Addr dest;
+    if (fixed) {
+        if ((new_addr & (page_bytes - 1)) ||
+            new_addr < heapFloor(process) ||
+            new_addr > max_addr - new_size ||
+            new_addr + new_size > ceiling)
+            return static_cast<RegVal>(-EINVAL);
+        // Linux rejects a MREMAP_FIXED target that overlaps the old range
+        // (including the same start), so the old pages are never both the
+        // source and the destination of the move.
+        if (new_addr < old_end && old_addr < new_addr + new_size)
+            return static_cast<RegVal>(-EINVAL);
+        dest = new_addr;
+    } else {
+        dest = extendMmap(process, new_size);
+        if (dest == 0)
+            return static_cast<RegVal>(-ENOMEM);
+    }
+
+    // A moved mapping costs the address space it occupies at the new address
+    // until the old pages are released; the kernel checks the growth of the
+    // mapping, which is what the limits are about.
+    if (new_size > old_size &&
+        !process->asLimitAllows(new_size - old_size))
+        return static_cast<RegVal>(-ENOMEM);
+
+    // remapRegion() moves both the VMA slices and the existing page table
+    // entries; the pages that were never touched stay lazy at the new
+    // address.  The grown tail is a fresh VMA and a shrunk tail is dropped.
+    const Addr move_len = std::min(old_size, new_size);
+    mem_state->remapRegion(old_addr, dest, move_len);
+    process->clearProtection(dest, dest + new_size);
+    process->moveProtection(old_addr, old_addr + move_len, dest);
+    if (new_size > move_len) {
+        mem_state->mapRegion(dest + move_len, new_size - move_len, "anon");
+        process->setProtection(dest + move_len, dest + new_size, prot,
+                               growdown);
+    }
+    if (old_size > move_len) {
+        mem_state->unmapRegion(old_addr + move_len, old_size - move_len);
+        process->clearProtection(old_addr + move_len, old_addr + old_size);
+    }
+    return dest;
+}
+
+/** mprotect(2).
+ *
+ * SE keeps the guest-visible page protection in DadaoISA::Process (the host
+ * page table has none); arch/dadao/tlb.cc enforces it and raises SIGSEGV on a
+ * denied CPU access (GEM5-030t).  A hole inside the range is accepted and
+ * left alone, which is what QEMU's page_set_flags() over the reserved guest
+ * VA does (Linux would return ENOMEM; the QEMU user-mode answer is the SE
+ * reference, ADR-0048 D1).
+ */
+RegVal
+doMprotect(DadaoISA::Process *process, Addr start, uint64_t length,
+           uint64_t prot)
+{
+    const Addr page_bytes = process->pTable->pageSize();
+    const Addr max_addr = std::numeric_limits<Addr>::max();
+
+    if (length == 0)
+        return 0;
+    if (start & (page_bytes - 1))
+        return static_cast<RegVal>(-EINVAL);
+    if (prot & ~(ProtRead | ProtWrite | ProtExec | ProtSem | ProtGrowsdown))
+        return static_cast<RegVal>(-EINVAL);
+    if (length > max_addr - start)
+        return static_cast<RegVal>(-ENOMEM);
+
+    Addr end = start + length;
+
+    // PROT_GROWSDOWN is the stack special case of the kernel (mm/mprotect.c
+    // do_mprotect_pkey): the requested [start,end) must overlap a VMA, and
+    // that VMA fixes the protection start -- start=vma->vm_start for an
+    // interior start, a start below the VMA while still overlapping, or an
+    // exact vm_start start.  No overlapping VMA is ENOMEM; a non-growdown VMA
+    // is EINVAL.  QEMU's linux-user rejects the bit for this target (it is
+    // HPPA-only there), so the kernel behaviour is implemented here and
+    // recorded as a QEMU-parity difference.  `end` stays start+length
+    // (start_orig+len), exactly as the kernel leaves it.
+    if (prot & ProtGrowsdown) {
+        Addr region_start;
+        bool growdown = false;
+        if (!process->growDownRegion(start, end, region_start, growdown))
+            return static_cast<RegVal>(-ENOMEM);
+        if (!growdown)
+            return static_cast<RegVal>(-EINVAL);
+        start = region_start;
+    }
+
+    process->protectMapped(start, end,
+                           static_cast<uint8_t>(prot & ProtMask));
+    return 0;
+}
+
+// --- Signals -------------------------------------------------------------
+//
+// Linux delivers a signal "on the way back to user mode": a self-raised
+// signal (kill/tkill/tgkill), or one unblocked by rt_sigprocmask, is handled
+// after the syscall has written its result.  SE has exactly one thread and no
+// other sender, so that is the only delivery point; the frame is what
+// musl's ucontext_t/siginfo_t name (the same frame QEMU's linux-user builds
+// for this port).
+
+uint64_t
+signalBit(int sig)
+{
+    return uint64_t(1) << (sig - 1);
+}
+
+/** The calling thread's per-thread state (mask, pending set, altstack,
+ *  clear-tid, robust list).  Every runnable context of a process has an
+ *  entry, created by initState() for the main thread and by clone(2). */
+DadaoISA::ThreadState &
+threadOf(DadaoISA::Process *process, ThreadContext *tc)
+{
+    DadaoISA::ThreadState *state = process->findThread(tc->contextId());
+    fatal_if(state == nullptr,
+             "DADAO SE: context %d has no thread state (pid %d)",
+             tc->contextId(), process->pid());
+    return *state;
+}
+
+bool
+onAltStack(const DadaoISA::ThreadState &thread, Addr sp)
+{
+    // Linux on_sig_stack(): with SS_AUTODISARM set the kernel cannot be on the
+    // alternate stack by construction, so the test always reports "no".
+    if (thread.altStackFlags & SsAutodisarm)
+        return false;
+    return thread.altStackSize != 0 && sp - thread.altStackSp < thread.altStackSize;
+}
+
+int
+altStackFlags(const DadaoISA::ThreadState &thread, Addr sp)
+{
+    const int mode =
+        thread.altStackSize == 0
+            ? SsDisable
+            : (onAltStack(thread, sp) ? SsOnstack : 0);
+    return mode | (thread.altStackFlags & SsFlagBits);
+}
+
+/** Redirect the guest PC (the same full-width write B5 branches use). */
+void
+redirectTo(ThreadContext *tc, Addr target)
+{
+    DadaoISA::PCState state(target);
+    state.npc(target);
+    tc->pcState(state);
+}
+
+/** End the process the way an uncaught signal kills a Linux process: the
+ *  status a parent sees is 128+N (QEMU user mode does the same).  A signal
+ *  death of the last process still ends the simulation with that status. */
+// Defined with the multi-process surface below (it has to release the
+// process's descriptors and thread contexts, not just the simulation).
+void
+doExit(ThreadContext *tc, DadaoISA::Process *process, int status, int sig,
+       bool group);
+
+DadaoISA::Process *
+findLiveProcess(uint64_t pid);
+
+/** The registry of live processes (defined with the multi-process surface). */
+extern std::vector<DadaoISA::Process *> liveProcesses;
+
+void
+terminateWithSignal(ThreadContext *tc, int sig)
+{
+    warn("DADAO SE: signal %d terminates the guest (default action)", sig);
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    doExit(tc, process, 0, sig, false);
+}
+
+/** Push one return address onto the architectural RAS (RegRAS then MemRAS).
+ *
+ * This is the same C1/C2/C3a/C3b transition as exec/b5.cc:pushRas(), applied
+ * to the thread context: the guest's `ret` at the end of the handler pops it,
+ * so the handler returns to the sigtramp page.  The RAS state itself
+ * (ra0/RACNT/MRPTR) is architectural state the guest owns.
+ */
+bool
+pushRasReturn(ThreadContext *tc, Addr address)
+{
+    constexpr uint64_t Mask48 = (uint64_t(1) << 48) - 1;
+    constexpr uint64_t RecursionMax = 0xFFFF;
+    constexpr unsigned NumRaSlots = 63;
+    constexpr uint64_t SbzMask = 0xFFC0000000000000ULL;
+
+    auto readRa = [&](unsigned idx) {
+        return tc->getReg(intReg(DadaoISA::int_reg::RaBase + idx));
+    };
+    auto writeRa = [&](unsigned idx, uint64_t value) {
+        tc->setReg(intReg(DadaoISA::int_reg::RaBase + idx), value);
+    };
+    auto writeHeader = [&](uint64_t racnt, uint64_t mrptr) {
+        writeRa(0, (readRa(0) & SbzMask) | ((racnt & 0x3F) << 48) |
+                       (mrptr & Mask48));
+    };
+
+    const uint64_t ra0 = readRa(0);
+    const uint64_t racnt = (ra0 >> 48) & 0x3F;
+    const uint64_t mrptr = ra0 & Mask48;
+    const uint64_t entry = (uint64_t(1) << 48) | (address & Mask48);
+
+    if (racnt == 0) { // C1: empty stack
+        writeRa(NumRaSlots, entry);
+        writeHeader(1, mrptr);
+        return true;
+    }
+
+    const uint64_t top = readRa(NumRaSlots);
+    const uint64_t topCount = top >> 48;
+    const uint64_t topAddr = top & Mask48;
+    if (topAddr == (address & Mask48) && topCount < RecursionMax) { // C2
+        writeRa(NumRaSlots, (((topCount + 1) & 0xFFFF) << 48) | topAddr);
+        return true;
+    }
+
+    if (racnt < NumRaSlots) { // C3a: one free register slot
+        for (uint64_t j = 64 - racnt; j <= NumRaSlots; ++j)
+            writeRa(j - 1, readRa(j));
+        writeRa(NumRaSlots, entry);
+        writeHeader(racnt + 1, mrptr);
+        return true;
+    }
+
+    if (mrptr == 0) // C3b: overflow and no MemRAS
+        return false;
+    const uint64_t newPtr = mrptr - 8;
+    uint8_t bytes[8];
+    writeBigEndian64(bytes, readRa(64 - racnt));
+    SETranslatingPortProxy proxy(tc);
+    if (!proxy.tryWriteBlob(newPtr, bytes, sizeof(bytes)))
+        return false;
+    for (uint64_t j = 2; j <= NumRaSlots; ++j)
+        writeRa(j - 1, readRa(j));
+    writeRa(NumRaSlots, entry);
+    writeHeader(NumRaSlots, newPtr);
+    return true;
+}
+
+/** Build the signal frame on the guest stack and enter the handler.
+ *
+ * Returns true when a handler was entered (the PC is redirected); false when
+ * the signal was consumed without one (SIG_IGN, or a default ignore).  A
+ * default *terminate* ends the simulation inside this call.  `faultAddr` is
+ * the si_addr of a hardware-detected fault (SIGSEGV/SIGBUS); 0 for a signal
+ * that has no fault address (kill(2) and friends).
+ */
+bool
+deliverSignal(ThreadContext *tc, DadaoISA::Process *process, int sig,
+              Addr resumePc, int siCode, Addr faultAddr = 0)
+{
+    auto &state = process->signals;
+    DadaoISA::ThreadState &thread = threadOf(process, tc);
+    const DadaoISA::SignalDisposition action = state.actions[sig];
+
+    if (action.handler == SigIgn)
+        return false;
+
+    if (action.handler == SigDfl) {
+        // Default dispositions of the signals SE can raise.  The ignore set
+        // is the one QEMU's linux-user applies; everything else terminates.
+        if (sig == SigChld || sig == SigUrg || sig == SigWinch ||
+            sig == SigCont)
+            return false;
+        terminateWithSignal(tc, sig);
+        return false;
+    }
+
+    const Addr sp = tc->getReg(rb(1));
+    Addr base = sp;
+    if ((action.flags & SaOnStack) && thread.altStackSize != 0 &&
+        !onAltStack(thread, sp))
+        base = thread.altStackSp + thread.altStackSize;
+
+    if (base < GuestSigframeSize) {
+        warn("DADAO SE: signal %d has no room for a frame (sp=%#x)", sig, sp);
+        terminateWithSignal(tc, SigSegv);
+        return false;
+    }
+    const Addr frame = (base - GuestSigframeSize) & ~Addr(0xf);
+    if (base != sp && frame < thread.altStackSp) {
+        warn("DADAO SE: sigaltstack is too small for signal %d", sig);
+        terminateWithSignal(tc, SigSegv);
+        return false;
+    }
+
+    std::vector<uint8_t> raw(GuestSigframeSize, 0);
+    uint8_t *siginfo = raw.data();
+    uint8_t *uc = raw.data() + GuestSiginfoSize;
+
+    // siginfo_t: 3 x int, then the union at offset 16.  SIGSEGV/SIGBUS carry
+    // `si_addr` there (musl's _sigfault.si_addr); the process-directed
+    // signals carry {si_pid, si_uid} (__si_common.__first.__piduid).
+    writeBigEndian32(siginfo + 0, sig);
+    writeBigEndian32(siginfo + 4, 0);
+    writeBigEndian32(siginfo + 8, static_cast<uint32_t>(siCode));
+    if (sig == SigSegv) {
+        writeBigEndian64(siginfo + 16, faultAddr);
+    } else {
+        writeBigEndian32(siginfo + 16, process->pid());
+        writeBigEndian32(siginfo + 20, static_cast<uint32_t>(::geteuid()));
+    }
+
+    // ucontext_t: uc_flags, uc_link, uc_stack, uc_sigmask, uc_mcontext.
+    writeBigEndian64(uc + 0, 0);
+    writeBigEndian64(uc + 8, 0);
+    writeBigEndian64(uc + 16, thread.altStackSp);
+    writeBigEndian32(uc + 24, altStackFlags(thread, sp));
+    writeBigEndian64(uc + 32, thread.altStackSize);
+    // uc_sigmask saves the pre-signal mask (the one sigreturn restores); the
+    // handler runs with old | sa_mask | sig instead.
+    writeBigEndian64(uc + 40, thread.blocked);
+
+    writeBigEndian64(uc + GuestUcMcontext + GuestMcPc, resumePc);
+    for (unsigned i = 0; i < 64; ++i) {
+        const uint64_t rdValue = (i == 0) ? 0 : tc->getReg(rd(i));
+        const uint64_t rbValue = (i == 0) ? resumePc : tc->getReg(rb(i));
+        writeBigEndian64(uc + GuestUcMcontext + GuestMcRd + 8 * i, rdValue);
+        writeBigEndian64(uc + GuestUcMcontext + GuestMcRb + 8 * i, rbValue);
+    }
+
+    if (!writeGuestBlob(tc, frame, raw.data(), raw.size())) {
+        warn("DADAO SE: cannot write the signal frame for %d at %#x", sig,
+             frame);
+        terminateWithSignal(tc, SigSegv);
+        return false;
+    }
+    thread.signalFrames.push_back(frame);
+
+    // signal_delivered(): an SS_AUTODISARM stack is disabled for the handler
+    // and comes back with the frame's uc_stack on sigreturn.
+    if (thread.altStackFlags & SsAutodisarm) {
+        thread.altStackSp = 0;
+        thread.altStackSize = 0;
+        thread.altStackFlags = 0;
+    }
+
+    uint64_t handlerMask = thread.blocked | action.mask;
+    if (!(action.flags & SaNodefer))
+        handlerMask |= signalBit(sig);
+    thread.blocked = handlerMask;
+    if (action.flags & SaResethand)
+        state.actions[sig].handler = SigDfl;
+
+    if (!pushRasReturn(tc, DadaoISA::SigTrampBase)) {
+        warn("DADAO SE: cannot push the sigreturn trampoline for signal %d",
+             sig);
+        terminateWithSignal(tc, SigSegv);
+        return false;
+    }
+
+    // Handler entry (contract-abi §4.1/§4.4, the same registers QEMU sets):
+    // sp = the frame, rd16 = sig, rb16 = &siginfo, rb17 = &ucontext.
+    tc->setReg(rb(1), frame);
+    tc->setReg(rd(16), sig);
+    tc->setReg(rb(16), frame);
+    tc->setReg(rb(17), frame + GuestSiginfoSize);
+    redirectTo(tc, action.handler);
+    return true;
+}
+
+/** Deliver the lowest-numbered pending signal that is not blocked.  Stops
+ *  after entering one handler: the next delivery happens when that handler
+ *  returns through rt_sigreturn. */
+void
+maybeDeliverSignals(ThreadContext *tc, DadaoISA::Process *process,
+                    Addr resumePc)
+{
+    DadaoISA::ThreadState &thread = threadOf(process, tc);
+    for (int sig = 1; sig <= NumSignals; ++sig) {
+        if (process->hasExited)
+            return; // the last delivery ended the process
+        const uint64_t bit = signalBit(sig);
+        if (!(thread.pending & bit))
+            continue;
+        const bool unblockable = (sig == SigKill || sig == SigStop);
+        if (!unblockable && (thread.blocked & bit))
+            continue;
+        thread.pending &= ~bit;
+        if (sig == SigKill) {
+            terminateWithSignal(tc, SigKill);
+            return;
+        }
+        if (sig == SigStop) {
+            // SE has no job control; a stopped process could only hang.
+            warn("DADAO SE: SIGSTOP ignored (no job control in SE)");
+            continue;
+        }
+        if (deliverSignal(tc, process, sig, resumePc, thread.pendingCode[sig]))
+            return;
+    }
+}
+
+/** rt_sigaction(2). */
+RegVal
+doSigaction(ThreadContext *tc, DadaoISA::Process *process, int sig, Addr act,
+            Addr oldAct, uint64_t sigsetsize)
+{
+    if (sigsetsize != 8)
+        return static_cast<RegVal>(-EINVAL);
+    if (sig < 1 || sig > NumSignals)
+        return static_cast<RegVal>(-EINVAL);
+    if (act != 0 && (sig == SigKill || sig == SigStop))
+        return static_cast<RegVal>(-EINVAL); // uncatchable
+
+    DadaoISA::SignalDisposition &action = process->signals.actions[sig];
+    uint8_t raw[GuestSigactionSize];
+
+    if (oldAct != 0) {
+        std::memset(raw, 0, sizeof(raw));
+        writeBigEndian64(raw + GuestSigactionHandler, action.handler);
+        writeBigEndian64(raw + GuestSigactionFlags, action.flags);
+        writeBigEndian64(raw + GuestSigactionMask, action.mask);
+        if (!writeGuestBlob(tc, oldAct, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+
+    if (act != 0) {
+        if (!readGuestBlob(tc, act, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        action.handler = readBigEndian64(raw + GuestSigactionHandler);
+        action.flags = readBigEndian64(raw + GuestSigactionFlags);
+        action.mask = readBigEndian64(raw + GuestSigactionMask);
+    }
+    return 0;
+}
+
+/** rt_sigprocmask(2). */
+RegVal
+doSigprocmask(ThreadContext *tc, DadaoISA::Process *process, int how,
+              Addr setAddr, Addr oldAddr, uint64_t sigsetsize)
+{
+    if (sigsetsize != 8)
+        return static_cast<RegVal>(-EINVAL);
+    if (how < SigBlock || how > SigSetmask)
+        return static_cast<RegVal>(-EINVAL);
+
+    uint8_t raw[8];
+    uint64_t set = 0;
+    if (setAddr != 0) {
+        if (!readGuestBlob(tc, setAddr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        set = readBigEndian64(raw);
+    }
+
+    DadaoISA::ThreadState &thread = threadOf(process, tc);
+    const uint64_t old = thread.blocked;
+    if (oldAddr != 0) {
+        uint8_t oldRaw[8];
+        writeBigEndian64(oldRaw, old);
+        if (!writeGuestBlob(tc, oldAddr, oldRaw, sizeof(oldRaw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+
+    if (setAddr != 0) {
+        uint64_t blocked = old;
+        switch (how) {
+          case SigBlock: blocked |= set; break;
+          case SigUnblock: blocked &= ~set; break;
+          case SigSetmask: blocked = set; break;
+        }
+        // SIGKILL and SIGSTOP can never be blocked (Linux drops those bits
+        // silently rather than failing the call).
+        blocked &= ~(signalBit(SigKill) | signalBit(SigStop));
+        thread.blocked = blocked;
+        syncPendingSignal(process, thread);
+    }
+    return 0;
+}
+
+/** rt_sigpending(2): signals pending *and* blocked. */
+RegVal
+doSigpending(ThreadContext *tc, DadaoISA::Process *process, Addr setAddr,
+             uint64_t sigsetsize)
+{
+    if (sigsetsize != 8)
+        return static_cast<RegVal>(-EINVAL);
+    uint8_t raw[8];
+    const DadaoISA::ThreadState &thread = threadOf(process, tc);
+    writeBigEndian64(raw, thread.pending & thread.blocked);
+    if (!writeGuestBlob(tc, setAddr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** sigaltstack(2); the validation order is the kernel's
+ *  (kernel/signal.c:do_sigaltstack). */
+RegVal
+doSigaltstack(ThreadContext *tc, DadaoISA::Process *process, Addr ssAddr,
+              Addr oldSsAddr)
+{
+    DadaoISA::ThreadState &thread = threadOf(process, tc);
+    uint8_t raw[GuestStacktSize];
+    uint8_t old[GuestStacktSize];
+
+    if (oldSsAddr != 0) {
+        std::memset(old, 0, sizeof(old));
+        writeBigEndian64(old + 0, thread.altStackSp);
+        writeBigEndian32(old + 8, altStackFlags(thread, tc->getReg(rb(1))));
+        writeBigEndian64(old + 16, thread.altStackSize);
+    }
+
+    if (ssAddr != 0) {
+        if (!readGuestBlob(tc, ssAddr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        Addr ssSp = readBigEndian64(raw);
+        const int flags = static_cast<int>(
+            static_cast<int32_t>(readBigEndian32(raw + 8)));
+        uint64_t ssSize = readBigEndian64(raw + 16);
+
+        if (onAltStack(thread, tc->getReg(rb(1))))
+            return static_cast<RegVal>(-EPERM);
+        switch (flags & ~SsFlagBits) {
+          case SsDisable:
+            ssSp = 0;
+            ssSize = 0;
+            break;
+          case 0:
+          case SsOnstack:
+            if (ssSize < MinSigStkSz)
+                return static_cast<RegVal>(-ENOMEM);
+            break;
+          default:
+            return static_cast<RegVal>(-EINVAL);
+        }
+        thread.altStackSp = ssSp;
+        thread.altStackSize = ssSize;
+        thread.altStackFlags = flags;
+    }
+
+    if (oldSsAddr != 0 &&
+        !writeGuestBlob(tc, oldSsAddr, old, sizeof(old)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** rt_sigreturn(2): restore the interrupted context from the frame at sp.
+ *  The handler may have edited the frame in place (musl's cancellation
+ *  handler rewrites MC_PC and uc_sigmask), which is why the frame is read
+ *  here rather than kept in host state. */
+void
+doSigreturn(ThreadContext *tc, DadaoISA::Process *process)
+{
+    DadaoISA::ThreadState &thread = threadOf(process, tc);
+    // The frame the matching delivery pushed; fall back to the ABI stack
+    // convention only if the handler returned without a recorded frame.
+    const Addr frame = thread.signalFrames.empty()
+                           ? tc->getReg(rb(1))
+                           : thread.signalFrames.back();
+    if (!thread.signalFrames.empty())
+        thread.signalFrames.pop_back();
+    std::vector<uint8_t> raw(GuestSigframeSize);
+    if (!readGuestBlob(tc, frame, raw.data(), raw.size())) {
+        warn("DADAO SE: rt_sigreturn with an unreadable frame at %#x", frame);
+        terminateWithSignal(tc, SigSegv);
+        return;
+    }
+    const uint8_t *uc = raw.data() + GuestSiginfoSize;
+
+    const Addr pc = readBigEndian64(uc + GuestUcMcontext + GuestMcPc);
+    const uint64_t mask = readBigEndian64(uc + 40);
+    if ((pc & 3) != 0) {
+        warn("DADAO SE: rt_sigreturn with a corrupt frame at %#x", frame);
+        terminateWithSignal(tc, SigSegv);
+        return;
+    }
+
+    // Restore the alternate-stack descriptor (kernel restore_altstack ignores
+    // validation errors: an invalid saved value simply leaves it unchanged).
+    const Addr ssSp = readBigEndian64(uc + 16);
+    const int ssFlags = static_cast<int32_t>(readBigEndian32(uc + 24));
+    const uint64_t ssSize = readBigEndian64(uc + 32);
+    const int ssMode = ssFlags & ~SsFlagBits;
+    if (ssMode == SsDisable) {
+        thread.altStackSp = 0;
+        thread.altStackSize = 0;
+        thread.altStackFlags = ssFlags & SsFlagBits;
+    } else if (ssMode == 0 || ssMode == SsOnstack) {
+        thread.altStackSp = ssSp;
+        thread.altStackSize = ssSize;
+        thread.altStackFlags = ssFlags & SsFlagBits;
+    }
+
+    thread.blocked = mask;
+    syncPendingSignal(process, thread);
+
+    for (unsigned i = 1; i < 64; ++i) {
+        tc->setReg(rd(i),
+                   readBigEndian64(uc + GuestUcMcontext + GuestMcRd + 8 * i));
+        tc->setReg(rb(i),
+                   readBigEndian64(uc + GuestUcMcontext + GuestMcRb + 8 * i));
+    }
+    redirectTo(tc, pc);
+
+    // A handler can unblock a pending signal by editing uc_sigmask.
+    maybeDeliverSignals(tc, process, pc);
+}
+
+/** kill(2): queue a process-directed signal.
+ *
+ * Linux target selection (kernel/signal.c: kill_something_info):
+ *   pid > 0   that process only                    -> ESRCH if not live
+ *   pid == 0  the caller's process group
+ *   pid == -1 every process the caller may signal (SE: every live process,
+ *             the caller included -- there is no init process to spare)
+ *   pid < -1  the process group -pid               -> ESRCH if the group has
+ *             no live process
+ * sig == 0 is the existence/permission probe: nothing is delivered, and the
+ * call succeeds when at least one target exists.
+ */
+RegVal
+doKill(ThreadContext *tc, DadaoISA::Process *process, int pid, int sig,
+       int siCode)
+{
+    (void)tc;
+    if (sig < 0 || sig > NumSignals)
+        return static_cast<RegVal>(-EINVAL);
+
+    std::vector<DadaoISA::Process *> targets;
+    if (pid > 0) {
+        if (DadaoISA::Process *target = findLiveProcess(pid))
+            targets.push_back(target);
+    } else if (pid == 0 || pid < -1) {
+        const uint64_t group =
+            pid == 0 ? process->pgid() : static_cast<uint64_t>(-pid);
+        for (auto *candidate : liveProcesses) {
+            if (candidate->pgid() == group)
+                targets.push_back(candidate);
+        }
+    } else { // pid == -1
+        targets = liveProcesses;
+    }
+    if (targets.empty())
+        return static_cast<RegVal>(-ESRCH);
+    if (sig == 0)
+        return 0;
+    for (auto *target : targets)
+        postProcessSignal(target, sig, siCode);
+    return 0;
+}
+
+// --- Threads, futexes and the robust list (GEM5-026t) ---------------------
+//
+// A thread is a second ThreadContext of the *same* Process: the address space,
+// the fd table and the signal dispositions are shared, while the stack pointer,
+// the thread pointer (rb3) and the per-thread Linux state (ThreadState) are
+// not.  A syscall that would sleep in the kernel is a *suspend* of that thread
+// context, never a host sleep and never a retry poll: the futex wait queue
+// below holds the sleeping thread, and FUTEX_WAKE/timeout/signal hands it the
+// syscall result and reactivates it through gem5's event queue.
+
+constexpr uint32_t FutexWaitersBit = 0x80000000u; // FUTEX_WAITERS
+constexpr uint32_t FutexOwnerDied = 0x40000000u;  // FUTEX_OWNER_DIED
+constexpr uint32_t FutexTidMask = 0x3fffffffu;
+
+// futex(2) operations (asm-generic linux/futex.h) that the corpus reaches.
+constexpr uint64_t FutexWaitOp = 0;
+constexpr uint64_t FutexWakeOp = 1;
+constexpr uint64_t FutexFdOp = 2;
+constexpr uint64_t FutexRequeueOp = 3;
+constexpr uint64_t FutexCmpRequeueOp = 4;
+constexpr uint64_t FutexWakeOpOp = 5;
+constexpr uint64_t FutexLockPiOp = 6;
+constexpr uint64_t FutexUnlockPiOp = 7;
+constexpr uint64_t FutexTrylockPiOp = 8;
+constexpr uint64_t FutexWaitBitsetOp = 9;
+constexpr uint64_t FutexWakeBitsetOp = 10;
+constexpr uint64_t FutexPrivateFlag = 128;
+constexpr uint64_t FutexClockRealtimeFlag = 256;
+constexpr uint64_t FutexCmdMask = ~(FutexPrivateFlag | FutexClockRealtimeFlag);
+constexpr uint32_t FutexBitsetAny = 0xffffffffu;
+
+/** One thread asleep in futex(2).  heap-allocated: the timeout event holds a
+ *  pointer to it and the list is searched by address. */
+struct FutexWaiter
+{
+    DadaoISA::Process *process = nullptr;
+    ContextID cid = 0;
+    int tid = 0;                 // owner tid handed over by FUTEX_UNLOCK_PI
+    Addr addr = 0;
+    uint32_t bitset = FutexBitsetAny;
+    bool pi = false;             // FUTEX_LOCK_PI waiter
+    Event *timeout = nullptr;
+};
+
+std::list<FutexWaiter *> futexWaiters;
+
+bool
+readGuestWord(ThreadContext *tc, Addr addr, uint32_t &value)
+{
+    uint8_t raw[4];
+    if (!readGuestBlob(tc, addr, raw, sizeof(raw)))
+        return false;
+    value = readBigEndian32(raw);
+    return true;
+}
+
+bool
+writeGuestWord(ThreadContext *tc, Addr addr, uint32_t value)
+{
+    uint8_t raw[4];
+    writeBigEndian32(raw, value);
+    return writeGuestBlob(tc, addr, raw, sizeof(raw));
+}
+
+
+void
+cancelFutexTimeout(FutexWaiter *waiter)
+{
+    Event *event = waiter->timeout;
+    waiter->timeout = nullptr;
+    if (event == nullptr)
+        return;
+    // The timeout event is created with AutoDelete (Managed): the queue frees
+    // it both after dispatch and on deschedule, so it must never be deleted
+    // here.  A non-null pointer means "still scheduled" -- the callback
+    // clears the field before it can fire twice.
+    if (event->scheduled())
+        getEventQueue(0)->deschedule(event);
+}
+
+/** Resolve a futex timeout argument to an absolute tick.  Returns 0, -EFAULT
+ *  or -EINVAL; *expired is set when the deadline is already in the past
+ *  (Linux returns ETIMEDOUT without sleeping in that case). */
+int
+futexDeadline(ThreadContext *tc, Addr tsAddr, bool absolute, bool realtime,
+              Tick &when, bool &expired)
+{
+    uint8_t raw[GuestTimespecSize];
+    if (!readGuestBlob(tc, tsAddr, raw, sizeof(raw)))
+        return -EFAULT;
+    const int64_t sec = readBigEndian64(raw);
+    const int64_t nsec = readBigEndian64(raw + 8);
+    if (sec < 0 || nsec < 0 || nsec >= 1000000000LL)
+        return -EINVAL;
+
+    const unsigned __int128 requested =
+        static_cast<unsigned __int128>(sec) * 1000000000ULL +
+        static_cast<uint64_t>(nsec);
+    unsigned __int128 remaining = requested;
+    if (absolute) {
+        unsigned __int128 current;
+        if (realtime) {
+            struct timespec now;
+            if (::clock_gettime(CLOCK_REALTIME, &now) < 0)
+                return -errno;
+            current = static_cast<unsigned __int128>(now.tv_sec) *
+                          1000000000ULL +
+                      static_cast<uint64_t>(now.tv_nsec);
+        } else {
+            current = simulatedNanoseconds();
+        }
+        remaining = requested > current ? requested - current : 0;
+    }
+    expired = (remaining == 0);
+    if (expired)
+        return 0;
+    // 1 tick == 1 ns at the GEM5-019t 1e9-ticks/s baseline; derive it from the
+    // engine clock so a different sim frequency still means the same time.
+    const unsigned __int128 ticks =
+        remaining * static_cast<unsigned __int128>(sim_clock::Frequency) /
+        1000000000ULL;
+    when = curTick() + static_cast<Tick>(ticks == 0 ? 1 : ticks);
+    return 0;
+}
+
+void
+futexTimeout(FutexWaiter *waiter);
+
+/** Park the calling thread on `addr` (suspend the context; the result is
+ *  written when something wakes it).  Returns 0 when parked, or the futex
+ *  error a timeout argument has already earned. */
+int
+parkOnFutex(ThreadContext *tc, DadaoISA::Process *process, Addr addr,
+            uint32_t bitset, bool pi, Addr timeoutAddr, bool absolute,
+            bool realtime)
+{
+    auto *waiter = new FutexWaiter();
+    waiter->process = process;
+    waiter->cid = tc->contextId();
+    waiter->addr = addr;
+    waiter->bitset = bitset;
+    waiter->pi = pi;
+    waiter->tid = threadOf(process, tc).tid;
+
+    if (timeoutAddr != 0) {
+        Tick when = 0;
+        bool expired = false;
+        const int status = futexDeadline(tc, timeoutAddr, absolute, realtime,
+                                        when, expired);
+        if (status != 0)
+            return status;
+        if (expired)
+            return -ETIMEDOUT;
+        {
+            auto *event = new EventFunctionWrapper(
+                    [waiter] { futexTimeout(waiter); },
+                    "dadao-futex-timeout", true);
+            waiter->timeout = event;
+            getEventQueue(0)->schedule(event, when);
+        }
+    }
+
+    futexWaiters.push_back(waiter);
+    threadOf(process, tc).futexWaitAddr = addr;
+    tc->suspend();
+    return 0;
+}
+
+/** Complete a parked futex wait: cancel the timeout, remove the waiter from
+ *  the queue, hand the syscall result to the thread and run it again. */
+void
+finishFutexWaiter(FutexWaiter *waiter, RegVal result)
+{
+    futexWaiters.remove(waiter);
+    cancelFutexTimeout(waiter);
+    if (DadaoISA::ThreadState *thread =
+                waiter->process->findThread(waiter->cid)) {
+        thread->futexWaitAddr = 0;
+    }
+    ThreadContext *tc = waiter->process->system->threads[waiter->cid];
+    tc->setReg(rd(8), result);
+    if (tc->status() == ThreadContext::Suspended)
+        tc->activate();
+    delete waiter;
+}
+
+void
+futexTimeout(FutexWaiter *waiter)
+{
+    // The event queue deletes the event itself after process() returns.
+    waiter->timeout = nullptr;
+    if (std::find(futexWaiters.begin(), futexWaiters.end(), waiter) ==
+        futexWaiters.end())
+        return; // woken and dropped before this fired
+    futexWaiters.remove(waiter);
+    if (DadaoISA::ThreadState *thread =
+                waiter->process->findThread(waiter->cid)) {
+        thread->futexWaitAddr = 0;
+    }
+    ThreadContext *tc = waiter->process->system->threads[waiter->cid];
+    tc->setReg(rd(8), static_cast<RegVal>(-ETIMEDOUT));
+    if (tc->status() == ThreadContext::Suspended)
+        tc->activate();
+    delete waiter;
+}
+
+/** A contended FUTEX_LOCK_PI wake: the futex word is the only source of
+ *  truth, so the woken thread re-reads it and takes ownership when the word
+ *  no longer names an owner (Linux keeps FUTEX_OWNER_DIED across the hand
+ *  over, which is what makes musl's userspace trylock report EOWNERDEAD).
+ *  Returns false when somebody else still owns the futex: the thread stays
+ *  parked. */
+bool
+acquirePi(DadaoISA::Process *process, FutexWaiter *waiter)
+{
+    ThreadContext *tc = process->system->threads[waiter->cid];
+    uint32_t word = 0;
+    if (!readGuestWord(tc, waiter->addr, word))
+        return false;
+    if ((word & FutexTidMask) != 0 &&
+        (word & FutexTidMask) != static_cast<uint32_t>(waiter->tid))
+        return false;
+    const uint32_t owned =
+        static_cast<uint32_t>(waiter->tid) | (word & FutexOwnerDied);
+    return writeGuestWord(tc, waiter->addr, owned);
+}
+
+/** Wake up to `count` threads waiting on `addr` whose bitset intersects. */
+size_t
+wakeFutexWaiters(DadaoISA::Process *process, Addr addr, uint32_t bitset,
+                 size_t count)
+{
+    std::vector<FutexWaiter *> woken;
+    for (auto *waiter : futexWaiters) {
+        if (woken.size() >= count)
+            break;
+        if (waiter->process != process || waiter->addr != addr)
+            continue;
+        if ((waiter->bitset & bitset) == 0)
+            continue;
+        // A PI waiter is woken by a plain FUTEX_WAKE too (musl's robust-list
+        // processing in __pthread_exit does exactly that); it takes the futex
+        // itself or keeps waiting.
+        if (waiter->pi && !acquirePi(process, waiter))
+            continue;
+        woken.push_back(waiter);
+    }
+    for (auto *waiter : woken)
+        finishFutexWaiter(waiter, 0);
+    return woken.size();
+}
+
+/** Move up to `count` threads waiting on `from` to the futex word `to`. */
+size_t
+requeueFutexWaiters(DadaoISA::Process *process, Addr from, Addr to,
+                    size_t count)
+{
+    size_t moved = 0;
+    for (auto *waiter : futexWaiters) {
+        if (moved >= count)
+            break;
+        if (waiter->process != process || waiter->addr != from || waiter->pi)
+            continue;
+        waiter->addr = to;
+        if (DadaoISA::ThreadState *thread =
+                    process->findThread(waiter->cid)) {
+            thread->futexWaitAddr = to;
+        }
+        moved++;
+    }
+    return moved;
+}
+
+/** Drop a thread's futex wait (thread exit) without waking anything. */
+void
+dropFutexWaiters(DadaoISA::Process *process, ContextID cid)
+{
+    std::vector<FutexWaiter *> dropped;
+    for (auto *waiter : futexWaiters) {
+        if (waiter->process == process && waiter->cid == cid)
+            dropped.push_back(waiter);
+    }
+    for (auto *waiter : dropped) {
+        futexWaiters.remove(waiter);
+        cancelFutexTimeout(waiter);
+        delete waiter;
+    }
+}
+
+void
+dropProcessFutexWaiters(DadaoISA::Process *process)
+{
+    std::vector<FutexWaiter *> dropped;
+    for (auto *waiter : futexWaiters) {
+        if (waiter->process == process)
+            dropped.push_back(waiter);
+    }
+    for (auto *waiter : dropped) {
+        futexWaiters.remove(waiter);
+        cancelFutexTimeout(waiter);
+        delete waiter;
+    }
+}
+
+/** The kernel's exit_robust_list(): mark every robust mutex this thread still
+ *  owns as FUTEX_OWNER_DIED and wake one waiter on each. */
+void
+processRobustList(ThreadContext *tc, DadaoISA::Process *process,
+                  const DadaoISA::ThreadState &thread)
+{
+    if (thread.robustList == 0 || thread.tid == 0)
+        return;
+    uint8_t raw[8];
+    if (!readGuestBlob(tc, thread.robustList, raw, sizeof(raw)))
+        return;
+    Addr entry = readBigEndian64(raw);
+    // futex_offset sits right after the list head pointer.
+    if (!readGuestBlob(tc, thread.robustList + 8, raw, sizeof(raw)))
+        return;
+    const int64_t futexOffset = static_cast<int64_t>(readBigEndian64(raw));
+
+    for (unsigned guard = 0; guard < 4096; ++guard) {
+        if (entry == 0 || entry == thread.robustList)
+            return;
+        uint32_t word = 0;
+        const Addr uaddr = entry + futexOffset;
+        if (readGuestWord(tc, uaddr, word) &&
+            (word & FutexTidMask) == static_cast<uint32_t>(thread.tid)) {
+            if (writeGuestWord(tc, uaddr, word | FutexOwnerDied))
+                wakeFutexWaiters(process, uaddr, FutexBitsetAny, 1);
+        }
+        if (!readGuestBlob(tc, entry, raw, sizeof(raw)))
+            return;
+        entry = readBigEndian64(raw);
+    }
+}
+
+/** Refresh the per-thread "deliverable signal queued" hint the instruction
+ *  loop tests. */
+void
+syncPendingSignal(DadaoISA::Process *process,
+                  const DadaoISA::ThreadState &thread)
+{
+    auto *isa = dynamic_cast<DadaoISA::ISA *>(
+            process->system->threads[thread.cid]->getIsaPtr());
+    if (isa != nullptr)
+        isa->setPendingSignal((thread.pending & ~thread.blocked) != 0);
+}
+
+/** Queue a signal on one thread; a thread asleep in a syscall is woken so it
+ *  can take it (a futex wait returns -EINTR after the handler has run). */
+void
+queueThreadSignal(DadaoISA::Process *process, DadaoISA::ThreadState &thread,
+                  int sig, int siCode)
+{
+    thread.pending |= signalBit(sig);
+    thread.pendingCode[sig] = siCode;
+    syncPendingSignal(process, thread);
+
+    ThreadContext *tc = process->system->threads[thread.cid];
+    if (tc->status() != ThreadContext::Suspended)
+        return; // delivered on the way back from its next syscall
+
+    if (thread.futexWaitAddr != 0) {
+        FutexWaiter *waiter = nullptr;
+        for (auto *candidate : futexWaiters) {
+            if (candidate->process == process && candidate->cid == thread.cid) {
+                waiter = candidate;
+                break;
+            }
+        }
+        if (waiter != nullptr) {
+            futexWaiters.remove(waiter);
+            cancelFutexTimeout(waiter);
+            delete waiter;
+        }
+        thread.futexWaitAddr = 0;
+        // The interrupted syscall returns -EINTR, but only after the handler
+        // has run: build the frame now, resume after the trap on sigreturn.
+        tc->setReg(rd(8), static_cast<RegVal>(-EINTR));
+        thread.pending &= ~signalBit(sig);
+        const Addr resumePc = tc->pcState().instAddr();
+        deliverSignal(tc, process, sig, resumePc, siCode);
+    } else if (interruptNanosleep(tc, process, thread)) {
+        // Same shape for nanosleep(2): EINTR plus the remaining time, and the
+        // handler resumes after the trap (the PC has not advanced yet).
+        thread.pending &= ~signalBit(sig);
+        const Addr resumePc = tc->pcState().instAddr() + 4;
+        deliverSignal(tc, process, sig, resumePc, siCode);
+    }
+    if (tc->status() == ThreadContext::Suspended)
+        tc->activate();
+}
+
+/** Process-directed signal (kill(2), SIGCHLD): pick one thread that can take
+ *  it, preferring a thread that does not block it. */
+void
+postProcessSignal(DadaoISA::Process *process, int sig, int siCode)
+{
+    DadaoISA::ThreadState *chosen = nullptr;
+    for (auto &entry : process->threads) {
+        if (!entry.second.live)
+            continue;
+        if ((entry.second.blocked & signalBit(sig)) == 0) {
+            chosen = &entry.second;
+            break;
+        }
+        if (chosen == nullptr)
+            chosen = &entry.second;
+    }
+    if (chosen == nullptr)
+        return;
+    queueThreadSignal(process, *chosen, sig, siCode);
+}
+
+/** Thread-directed signal (tkill(2)/tgkill(2)). */
+RegVal
+doThreadKill(DadaoISA::Process *process, int tid, int sig, int siCode)
+{
+    if (sig < 0 || sig > NumSignals)
+        return static_cast<RegVal>(-EINVAL);
+    // Linux: tkill's pid <= 0 is EINVAL (sys_tkill), and an unknown tid is
+    // ESRCH.
+    if (tid <= 0)
+        return static_cast<RegVal>(-EINVAL);
+    DadaoISA::ThreadState *thread = process->findThreadByTid(tid);
+    if (thread == nullptr)
+        return static_cast<RegVal>(-ESRCH);
+    if (sig == 0)
+        return 0;
+    queueThreadSignal(process, *thread, sig, siCode);
+    return 0;
+}
+
+/** tgkill(2): a thread of a specific thread group.
+ *
+ * Linux (kernel/signal.c: sys_tgkill / do_send_specific): pid <= 0 or
+ * tgid <= 0 is EINVAL; the (tgid, tid) pair must name a live task of that
+ * group, and any mismatch is ESRCH (not EINVAL) so that a recycled tid cannot
+ * be signalled by a stale tgid.
+ */
+RegVal
+doTgkill(DadaoISA::Process *caller, int tgid, int tid, int sig)
+{
+    if (sig < 0 || sig > NumSignals)
+        return static_cast<RegVal>(-EINVAL);
+    if (tgid <= 0 || tid <= 0)
+        return static_cast<RegVal>(-EINVAL);
+
+    DadaoISA::Process *target = findLiveProcess(tgid);
+    if (target == nullptr)
+        return static_cast<RegVal>(-ESRCH);
+    DadaoISA::ThreadState *thread = target->findThreadByTid(tid);
+    if (thread == nullptr)
+        return static_cast<RegVal>(-ESRCH);
+    if (sig == 0)
+        return 0;
+    queueThreadSignal(target, *thread, sig, SiTkill);
+    return 0;
+}
+
+/** futex(2).  `parked` reports that the calling thread was suspended: its
+ *  result is written when the wait is completed, so the dispatcher must not
+ *  write rd8 or deliver signals now. */
+RegVal
+doFutex(ThreadContext *tc, DadaoISA::Process *process, Addr uaddr,
+        uint64_t opRaw, uint32_t val, uint64_t val2, Addr uaddr2,
+        uint32_t val3, bool &parked)
+{
+    const uint64_t op = opRaw & FutexCmdMask;
+    const bool realtime = (opRaw & FutexClockRealtimeFlag) != 0;
+
+    switch (op) {
+      case FutexWaitOp:
+      case FutexWaitBitsetOp: {
+        uint32_t word = 0;
+        if (!readGuestWord(tc, uaddr, word))
+            return static_cast<RegVal>(-EFAULT);
+        if (word != val)
+            return static_cast<RegVal>(-EAGAIN);
+        uint32_t bitset = FutexBitsetAny;
+        if (op == FutexWaitBitsetOp) {
+            if (val3 == 0)
+                return static_cast<RegVal>(-EINVAL);
+            bitset = val3;
+        }
+        const DadaoISA::ThreadState &thread = threadOf(process, tc);
+        if ((thread.pending & ~thread.blocked) != 0)
+            return static_cast<RegVal>(-EINTR);
+        const bool absolute = (op == FutexWaitBitsetOp);
+        const int status = parkOnFutex(tc, process, uaddr, bitset, false,
+                                       tc->getReg(rb(17)), absolute, realtime);
+        if (status != 0)
+            return static_cast<RegVal>(status);
+        parked = true;
+        return 0;
+      }
+
+      case FutexWakeOp:
+      case FutexWakeBitsetOp: {
+        uint32_t bitset = FutexBitsetAny;
+        if (op == FutexWakeBitsetOp) {
+            if (val3 == 0)
+                return static_cast<RegVal>(-EINVAL);
+            bitset = val3;
+        }
+        return static_cast<RegVal>(wakeFutexWaiters(process, uaddr, bitset,
+                                                   val));
+      }
+
+      case FutexRequeueOp: {
+        const size_t woken = wakeFutexWaiters(process, uaddr, FutexBitsetAny,
+                                             val);
+        return static_cast<RegVal>(
+                woken + requeueFutexWaiters(process, uaddr, uaddr2, val2));
+      }
+
+      case FutexCmpRequeueOp: {
+        uint32_t word = 0;
+        if (!readGuestWord(tc, uaddr, word))
+            return static_cast<RegVal>(-EFAULT);
+        if (word != val3)
+            return static_cast<RegVal>(-EAGAIN);
+        const size_t woken = wakeFutexWaiters(process, uaddr, FutexBitsetAny,
+                                             val);
+        return static_cast<RegVal>(
+                woken + requeueFutexWaiters(process, uaddr, uaddr2, val2));
+      }
+
+      case FutexLockPiOp: {
+        uint32_t word = 0;
+        if (!readGuestWord(tc, uaddr, word))
+            return static_cast<RegVal>(-EFAULT);
+        const int tid = threadOf(process, tc).tid;
+        if ((word & FutexTidMask) == 0) {
+            // Free (possibly with FUTEX_OWNER_DIED left by a dead owner): take
+            // it and preserve the owner-died bit for musl's trylock.
+            const uint32_t owned =
+                static_cast<uint32_t>(tid) | (word & FutexOwnerDied);
+            if (!writeGuestWord(tc, uaddr, owned))
+                return static_cast<RegVal>(-EFAULT);
+            return 0;
+        }
+        if ((word & FutexTidMask) == static_cast<uint32_t>(tid))
+            return static_cast<RegVal>(-EDEADLK);
+        if ((word & FutexWaitersBit) == 0 &&
+            !writeGuestWord(tc, uaddr, word | FutexWaitersBit))
+            return static_cast<RegVal>(-EFAULT);
+        const int status = parkOnFutex(tc, process, uaddr, FutexBitsetAny,
+                                       true, tc->getReg(rb(17)), true,
+                                       realtime);
+        if (status != 0)
+            return static_cast<RegVal>(status);
+        parked = true;
+        return 0;
+      }
+
+      case FutexUnlockPiOp: {
+        FutexWaiter *next = nullptr;
+        bool more = false;
+        for (auto *waiter : futexWaiters) {
+            if (waiter->process != process || waiter->addr != uaddr ||
+                !waiter->pi)
+                continue;
+            if (next == nullptr)
+                next = waiter;
+            else
+                more = true;
+        }
+        uint32_t word = 0;
+        if (next != nullptr) {
+            word = static_cast<uint32_t>(next->tid);
+            if (more)
+                word |= FutexWaitersBit;
+        }
+        if (!writeGuestWord(tc, uaddr, word))
+            return static_cast<RegVal>(-EFAULT);
+        if (next != nullptr)
+            finishFutexWaiter(next, 0);
+        return 0;
+      }
+
+      case FutexTrylockPiOp: {
+        uint32_t word = 0;
+        if (!readGuestWord(tc, uaddr, word))
+            return static_cast<RegVal>(-EFAULT);
+        const int tid = threadOf(process, tc).tid;
+        if (word != 0)
+            return static_cast<RegVal>(-EBUSY);
+        if (!writeGuestWord(tc, uaddr, static_cast<uint32_t>(tid)))
+            return static_cast<RegVal>(-EFAULT);
+        return 0;
+      }
+
+      case FutexFdOp:
+      case FutexWakeOpOp:
+        warn("DADAO SE: futex operation %d is not modelled", (int)op);
+        return static_cast<RegVal>(-ENOSYS);
+
+      default:
+        warn("DADAO SE: futex operation %d is not supported", (int)op);
+        return static_cast<RegVal>(-EINVAL);
+    }
+}
+
+// --- Resource limits -----------------------------------------------------
+
+/** prlimit64(2) body; getrlimit/setrlimit share it (musl routes both through
+ *  prlimit64 on this ABI). */
+RegVal
+doPrlimit64(ThreadContext *tc, DadaoISA::Process *process, int pid,
+            int resource, Addr newAddr, Addr oldAddr)
+{
+    if (resource < 0 ||
+        resource >= static_cast<int>(DadaoISA::NumResourceLimits))
+        return static_cast<RegVal>(-EINVAL);
+    if (pid != 0 && pid != static_cast<int>(process->pid()))
+        return static_cast<RegVal>(-ESRCH);
+
+    uint8_t raw[GuestRlimitSize];
+    if (newAddr != 0) {
+        if (!readGuestBlob(tc, newAddr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+        const uint64_t cur = readBigEndian64(raw);
+        const uint64_t max = readBigEndian64(raw + 8);
+        if (cur > max)
+            return static_cast<RegVal>(-EINVAL);
+        // Raising the *hard* limit needs CAP_SYS_RESOURCE (kernel do_prlimit);
+        // SE has no privilege model, so like an unprivileged process it
+        // refuses.  (QEMU-084t chose not to enforce this; Linux is the
+        // reference here and the difference is recorded.)
+        if (max > process->limits[resource].max)
+            return static_cast<RegVal>(-EPERM);
+        process->limits[resource].cur = cur;
+        process->limits[resource].max = max;
+        process->limitsSet[resource] = true;
+    }
+
+    if (oldAddr != 0) {
+        uint64_t cur = process->limits[resource].cur;
+        uint64_t max = process->limits[resource].max;
+        // An RLIMIT_STACK the guest never set reads back as the main-stack
+        // region the loader mapped -- QEMU-084t's guest_rlimit_get() rule.
+        // Reporting RLIM_INFINITY would claim head-room the guest has not.
+        if (resource == static_cast<int>(DadaoISA::RlimitStack) &&
+            !process->limitsSet[resource]) {
+            cur = max = std::max<Addr>(process->memState->getMaxStackSize(),
+                                       32 * process->pTable->pageSize());
+        }
+        writeBigEndian64(raw, cur);
+        writeBigEndian64(raw + 8, max);
+        if (!writeGuestBlob(tc, oldAddr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+// --- Process information -------------------------------------------------
+
+/** uname(2): host identity with the emulated machine name, like QEMU. */
+RegVal
+doUname(ThreadContext *tc, Addr bufAddr)
+{
+    struct utsname host;
+    if (::uname(&host) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestUtsnameSize];
+    std::memset(raw, 0, sizeof(raw));
+    const char *fields[6] = {host.sysname, host.nodename, host.release,
+                             host.version, "dadao",
+#ifdef _GNU_SOURCE
+                             host.domainname
+#else
+                             host.__domainname
+#endif
+    };
+    for (unsigned i = 0; i < 6; ++i) {
+        const size_t len = std::min(std::strlen(fields[i]),
+                                    GuestUtsnameField - 1);
+        std::memcpy(raw + i * GuestUtsnameField, fields[i], len);
+    }
+    if (!writeGuestBlob(tc, bufAddr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** sysinfo(2): the host's numbers in the guest's big-endian layout. */
+RegVal
+doSysinfo(ThreadContext *tc, Addr bufAddr)
+{
+    struct sysinfo host;
+    if (::sysinfo(&host) < 0)
+        return static_cast<RegVal>(-errno);
+
+    uint8_t raw[GuestSysinfoSize];
+    std::memset(raw, 0, sizeof(raw));
+    writeBigEndian64(raw + 0, host.uptime);
+    writeBigEndian64(raw + 8, host.loads[0]);
+    writeBigEndian64(raw + 16, host.loads[1]);
+    writeBigEndian64(raw + 24, host.loads[2]);
+    writeBigEndian64(raw + 32, host.totalram);
+    writeBigEndian64(raw + 40, host.freeram);
+    writeBigEndian64(raw + 48, host.sharedram);
+    writeBigEndian64(raw + 56, host.bufferram);
+    writeBigEndian64(raw + 64, host.totalswap);
+    writeBigEndian64(raw + 72, host.freeswap);
+    writeBigEndian16(raw + 80, host.procs);
+    writeBigEndian64(raw + 88, host.totalhigh);
+    writeBigEndian64(raw + 96, host.freehigh);
+    writeBigEndian32(raw + 104, host.mem_unit);
+    if (!writeGuestBlob(tc, bufAddr, raw, sizeof(raw)))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+/** The multi-process registry (defined with the syscall surface below): the
+ *  first image loaded becomes the simulation's main process. */
+void adoptAsMainProcess(DadaoISA::Process *process);
+
+class DadaoLoader : public Process::Loader
+{
+  public:
+    Process *
+    load(const ProcessParams &params, loader::ObjectFile *obj) override
+    {
+        if (obj->getArch() != loader::Dadao)
+            return nullptr;
+
+        loader::OpSys opsys = obj->getOpSys();
+        if (opsys == loader::UnknownOpSys) {
+            warn("Unknown operating system; assuming Linux.");
+            opsys = loader::Linux;
+        }
+        if (opsys != loader::Linux)
+            return nullptr;
+
+        auto *process = new DadaoISA::Process(params, obj);
+        // The first image loaded is the simulation's main process; later ones
+        // (fork/execve) register themselves with the same registry.
+        adoptAsMainProcess(process);
+        return process;
+    }
+};
+
+// --- Pipes, sockets and multiple processes (GEM5-025t) -------------------
+//
+// One gem5 Process object per guest process and one ThreadContext per
+// runnable process; the CPU interleaves them the way a kernel interleaves
+// processes.  A syscall that would sleep in the kernel is answered with
+// "retry" (SyscallRetryFault, see inst.cc) instead of blocking the host
+// thread: the process that could satisfy the call is itself a guest, so a host
+// sleep would deadlock the simulation.
+
+std::vector<DadaoISA::Process *> liveProcesses;
+DadaoISA::Process *mainProcess = nullptr;
+
+void
+registerLiveProcess(DadaoISA::Process *process)
+{
+    liveProcesses.push_back(process);
+}
+
+/** The first image loaded is the simulation's main process.  fork/execve
+ *  images are registered by their own paths, so a later call is a no-op. */
+void
+adoptAsMainProcess(DadaoISA::Process *process)
+{
+    if (mainProcess != nullptr)
+        return;
+    mainProcess = process;
+    registerLiveProcess(process);
+}
+
+void
+unregisterLiveProcess(DadaoISA::Process *process)
+{
+    liveProcesses.erase(std::remove(liveProcesses.begin(), liveProcesses.end(),
+                                    process), liveProcesses.end());
+}
+
+DadaoISA::Process *
+findLiveProcess(uint64_t pid)
+{
+    for (auto *process : liveProcesses) {
+        if (process->pid() == pid && !process->replacedByExec)
+            return process;
+    }
+    return nullptr;
+}
+
+/** End one thread of a process that still has other live threads: process
+ *  state (address space, fds, signal dispositions) survives, only the
+ *  per-thread state, the clear-tid word and the robust list are settled. */
+void
+doExitThread(ThreadContext *tc, DadaoISA::Process *process, int status)
+{
+    (void)status;
+    DadaoISA::ThreadState *state = process->findThread(tc->contextId());
+    if (state == nullptr || !state->live)
+        return;
+    const ContextID cid = tc->contextId();
+    const Addr clearTid = state->clearTid;
+    const DadaoISA::ThreadState snapshot = *state;
+
+    // A thread cannot be asleep in the kernel while it runs SYS_exit, but a
+    // timed wait queued for it must never fire against a dead context.
+    dropFutexWaiters(process, cid);
+    dropThreadSleepWaiters(process, cid);
+
+    // exit_robust_list(): orphan every robust mutex this thread still owns.
+    processRobustList(tc, process, snapshot);
+
+    state->live = false;
+    process->threads.erase(cid);
+
+    // set_tid_address(2)/CLONE_CHILD_CLEARTID: the word is cleared last, and
+    // the wake is what releases __tl_lock waiters in musl.
+    if (clearTid != 0) {
+        uint8_t zero[4] = {0, 0, 0, 0};
+        if (writeGuestBlob(tc, clearTid, zero, sizeof(zero)))
+            wakeFutexWaiters(process, clearTid, FutexBitsetAny, 1);
+    }
+
+    process->revokeThreadContext(cid);
+    tc->halt();
+}
+
+void
+doExit(ThreadContext *tc, DadaoISA::Process *process, int status, int sig,
+       bool group)
+{
+    if (process == nullptr || process->hasExited)
+        return;
+
+    // SYS_exit from one of several threads terminates just that thread;
+    // exit_group and a fatal signal take the whole process (Linux semantics).
+    if (!group && sig == 0 && process->liveThreadCount() > 1) {
+        doExitThread(tc, process, status);
+        return;
+    }
+
+    process->hasExited = true;
+    process->waitStatus = sig ? (sig & 0x7f) : ((status & 0xff) << 8);
+
+    // A clone(CLONE_VFORK) parent is asleep until this child execs or dies.
+    for (ContextID ctx : process->vforkContexts) {
+        ThreadContext *ptc = process->system->threads[ctx];
+        if (ptc->status() == ThreadContext::Suspended)
+            ptc->activate();
+    }
+    process->vforkContexts.clear();
+
+    if (auto *parent = process->parentProcess) {
+        // SIGCHLD is process-directed: queue it on a thread that can take it.
+        postProcessSignal(parent, SigChld,
+                          sig ? SiChildKilled : SiChildExited);
+    }
+
+    // POSIX record locks die with the process.
+    dropProcessLocks(process);
+
+    // Close the process's descriptors -- unless the table is shared with the
+    // parent (clone(CLONE_FILES)), in which case the parent still owns it.
+    if (!process->sharesFdTable) {
+        for (int i = 0; i < process->fds->getSize(); ++i) {
+            if ((*process->fds)[i])
+                process->fds->closeFDEntry(i);
+        }
+    }
+
+    dropProcessFutexWaiters(process);
+    dropProcessSleepWaiters(process);
+    for (auto &entry : process->threads)
+        entry.second.live = false;
+    process->threads.clear();
+
+    for (ContextID ctx : process->contextIds) {
+        ThreadContext *ptc = process->system->threads[ctx];
+        if (ptc->status() != ThreadContext::Halted)
+            ptc->halt();
+    }
+    process->contextIds.clear();
+    unregisterLiveProcess(process);
+
+    if (liveProcesses.empty()) {
+        int code = 0;
+        if (mainProcess != nullptr && mainProcess->hasExited) {
+            code = (mainProcess->waitStatus & 0x7f)
+                       ? ((mainProcess->waitStatus & 0x7f) | 0x80)
+                       : ((mainProcess->waitStatus >> 8) & 0xff);
+        }
+        exitSimLoop("exiting with last active thread context", code & 0xff);
+    }
+}
+
+/** pipe2(2).  Both ends are guest objects (DadaoPipeFDEntry); O_NONBLOCK and
+ *  O_CLOEXEC are the guest ABI's bits and are recorded on the entry. */
+RegVal
+doPipe2(ThreadContext *tc, DadaoISA::Process *process, Addr fildesAddr,
+        uint64_t flags)
+{
+    if (flags & ~static_cast<uint64_t>(TgtOCloexec | TgtONonblock))
+        return static_cast<RegVal>(-EINVAL);
+    if (fildesAddr == 0)
+        return static_cast<RegVal>(-EFAULT);
+
+    auto state = std::make_shared<PipeState>();
+    const int nonblock = (flags & TgtONonblock) ? TgtONonblock : 0;
+    // F_GETFL reports the access mode of the end (O_RDONLY == 0, O_WRONLY == 1).
+    auto readEnd = std::make_shared<DadaoPipeFDEntry>(state, true, nonblock);
+    auto writeEnd = std::make_shared<DadaoPipeFDEntry>(state, false,
+                                                       O_WRONLY | nonblock);
+    readEnd->setCOE(flags & TgtOCloexec);
+    writeEnd->setCOE(flags & TgtOCloexec);
+
+    const int readFd = allocGuestFd(process, readEnd);
+    if (readFd < 0)
+        return static_cast<RegVal>(readFd);
+    const int writeFd = allocGuestFd(process, writeEnd);
+    if (writeFd < 0) {
+        process->fds->closeFDEntry(readFd);
+        return static_cast<RegVal>(writeFd);
+    }
+
+    uint8_t raw[8];
+    writeBigEndian32(raw, readFd);
+    writeBigEndian32(raw + 4, writeFd);
+    if (!writeGuestBlob(tc, fildesAddr, raw, sizeof(raw))) {
+        process->fds->closeFDEntry(readFd);
+        process->fds->closeFDEntry(writeFd);
+        return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** socket(2): AF_UNIX/AF_INET/AF_INET6 are forwarded to the host, every other
+ *  family is EAFNOSUPPORT (the corpus only uses these three). */
+RegVal
+doSocket(DadaoISA::Process *process, int domain, int type, int protocol)
+{
+    if (!familySupported(domain))
+        return static_cast<RegVal>(-EAFNOSUPPORT);
+
+    const int baseType = type & ~(TgtSockCloexec | TgtSockNonblock);
+    if (baseType != SockStream && baseType != SockDgram &&
+        baseType != SockRaw && baseType != SockSeqpacket)
+        return static_cast<RegVal>(-ESOCKTNOSUPPORT);
+
+    const int simFd = ::socket(domain, type, protocol);
+    if (simFd < 0)
+        return static_cast<RegVal>(-errno);
+
+    auto entry = std::make_shared<SocketFDEntry>(
+            simFd, domain, baseType, protocol, (type & TgtSockCloexec) != 0);
+    const int guestFd = allocGuestFd(process, entry);
+    if (guestFd < 0) {
+        ::close(simFd);
+        return static_cast<RegVal>(guestFd);
+    }
+    return guestFd;
+}
+
+/** Read a guest sockaddr into `raw` (family still big-endian). */
+bool
+readGuestSockaddr(ThreadContext *tc, Addr addr, int addrlen, uint8_t *raw)
+{
+    if (addrlen < 0 || static_cast<size_t>(addrlen) > GuestSockaddrMax)
+        return false;
+    std::memset(raw, 0, GuestSockaddrMax);
+    if (addrlen == 0)
+        return true;
+    return readGuestBlob(tc, addr, raw, addrlen);
+}
+
+/** Copy a host sockaddr back to the guest, honouring the guest's buffer size
+ *  the way the kernel does (family back to big-endian, length clamped). */
+bool
+writeGuestSockaddr(ThreadContext *tc, Addr addrAddr, Addr lenAddr,
+                   const uint8_t *raw, int addrlen, int guestLen)
+{
+    if (addrAddr != 0 && guestLen > 0) {
+        const int copy = std::min(addrlen, guestLen);
+        std::vector<uint8_t> out(raw, raw + copy);
+        sockaddrToGuest(out.data(), copy);
+        if (!writeGuestBlob(tc, addrAddr, out.data(), copy))
+            return false;
+    }
+    if (lenAddr != 0) {
+        uint8_t rawLen[4];
+        writeBigEndian32(rawLen, static_cast<uint32_t>(addrlen));
+        if (!writeGuestBlob(tc, lenAddr, rawLen, sizeof(rawLen)))
+            return false;
+    }
+    return true;
+}
+
+bool
+readGuestSocklen(ThreadContext *tc, Addr lenAddr, int &len)
+{
+    if (lenAddr == 0) {
+        len = 0;
+        return true;
+    }
+    uint8_t raw[4];
+    if (!readGuestBlob(tc, lenAddr, raw, sizeof(raw)))
+        return false;
+    len = static_cast<int>(readBigEndian32(raw));
+    return true;
+}
+
+RegVal
+doBind(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr addrAddr,
+       int addrlen)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    uint8_t raw[GuestSockaddrMax];
+    if (!readGuestSockaddr(tc, addrAddr, addrlen, raw))
+        return static_cast<RegVal>(-EINVAL);
+    sockaddrToHost(raw, addrlen);
+    if (::bind(simFd, reinterpret_cast<struct sockaddr *>(raw), addrlen) < 0)
+        return static_cast<RegVal>(-errno);
+    return 0;
+}
+
+RegVal
+doConnect(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr addrAddr,
+          int addrlen, bool &blocked)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    uint8_t raw[GuestSockaddrMax];
+    if (!readGuestSockaddr(tc, addrAddr, addrlen, raw))
+        return static_cast<RegVal>(-EINVAL);
+    sockaddrToHost(raw, addrlen);
+
+    const int guestFlags = ::fcntl(simFd, F_GETFL);
+    const bool guestBlocking = guestFlags >= 0 && !(guestFlags & O_NONBLOCK);
+    if (guestBlocking)
+        ::fcntl(simFd, F_SETFL, guestFlags | O_NONBLOCK);
+
+    const int rc = ::connect(simFd, reinterpret_cast<struct sockaddr *>(raw),
+                             addrlen);
+    const int err = errno;
+    if (guestBlocking)
+        ::fcntl(simFd, F_SETFL, guestFlags);
+
+    if (rc == 0 || err == EISCONN)
+        return 0;
+    if (err != EINPROGRESS && err != EALREADY)
+        return static_cast<RegVal>(-err);
+    if (!guestBlocking)
+        return static_cast<RegVal>(err == EINPROGRESS ? -EINPROGRESS : -EALREADY);
+    if (!pollReady(simFd, POLLOUT)) {
+        blocked = true;
+        return 0;
+    }
+    int soError = 0;
+    socklen_t soLen = sizeof(soError);
+    if (::getsockopt(simFd, SOL_SOCKET, SO_ERROR, &soError, &soLen) < 0)
+        return static_cast<RegVal>(-errno);
+    return soError ? static_cast<RegVal>(-soError) : 0;
+}
+
+RegVal
+doListen(DadaoISA::Process *process, int fd, int backlog)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    if (::listen(simFd, backlog) < 0)
+        return static_cast<RegVal>(-errno);
+    return 0;
+}
+
+/** accept(2)/accept4(2): the accepted socket becomes a guest fd. */
+RegVal
+doAccept(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr addrAddr,
+         Addr lenAddr, int flags, bool &blocked)
+{
+    std::shared_ptr<FDEntry> entry;
+    if (int status = guestFdEntry(process, fd, entry); status != 0)
+        return static_cast<RegVal>(status);
+    auto listener = std::dynamic_pointer_cast<SocketFDEntry>(entry);
+    if (!listener)
+        return static_cast<RegVal>(-ENOTSOCK);
+    const int simFd = listener->getSimFD();
+
+    int guestLen = 0;
+    if (!readGuestSocklen(tc, lenAddr, guestLen))
+        return static_cast<RegVal>(-EFAULT);
+
+    if (!pollReady(simFd, POLLIN)) {
+        if (hostFdNonblocking(simFd))
+            return static_cast<RegVal>(-EAGAIN);
+        blocked = true;
+        return 0;
+    }
+
+    uint8_t raw[GuestSockaddrMax];
+    std::memset(raw, 0, sizeof(raw));
+    socklen_t addrlen = sizeof(raw);
+    const int hostFlags =
+        (flags & (TgtSockCloexec | TgtSockNonblock));
+    const int newFd = ::accept4(simFd, reinterpret_cast<struct sockaddr *>(raw),
+                                &addrlen, hostFlags);
+    if (newFd < 0)
+        return static_cast<RegVal>(-errno);
+
+    if (!writeGuestSockaddr(tc, addrAddr, lenAddr, raw,
+                            static_cast<int>(addrlen), guestLen)) {
+        ::close(newFd);
+        return static_cast<RegVal>(-EFAULT);
+    }
+
+    auto accepted = std::make_shared<SocketFDEntry>(
+            newFd, listener->_domain, listener->_type, listener->_protocol,
+            (flags & TgtSockCloexec) != 0);
+    const int guestFd = allocGuestFd(process, accepted);
+    if (guestFd < 0) {
+        ::close(newFd);
+        return static_cast<RegVal>(guestFd);
+    }
+    return guestFd;
+}
+
+RegVal
+doSendto(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr buf,
+         uint64_t len, int flags, Addr addrAddr, int addrlen, bool &blocked)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+
+    std::vector<uint8_t> data(len);
+    if (len > 0) {
+        SETranslatingPortProxy proxy(tc, SETranslatingPortProxy::Never);
+        if (!proxy.tryReadBlob(buf, data.data(), len))
+            return static_cast<RegVal>(-EFAULT);
+    }
+
+    uint8_t raw[GuestSockaddrMax];
+    struct sockaddr *addr = nullptr;
+    socklen_t hostAddrLen = 0;
+    if (addrAddr != 0) {
+        if (!readGuestSockaddr(tc, addrAddr, addrlen, raw))
+            return static_cast<RegVal>(-EINVAL);
+        sockaddrToHost(raw, addrlen);
+        addr = reinterpret_cast<struct sockaddr *>(raw);
+        hostAddrLen = addrlen;
+    }
+
+    if (!hostFdNonblocking(simFd) && !pollReady(simFd, POLLOUT)) {
+        blocked = true;
+        return 0;
+    }
+    ssize_t sent;
+    do {
+        sent = ::sendto(simFd, data.data(), len, flags, addr, hostAddrLen);
+    } while (sent < 0 && errno == EINTR);
+    if (sent < 0)
+        return static_cast<RegVal>(-errno);
+    return static_cast<RegVal>(sent);
+}
+
+RegVal
+doRecvfrom(ThreadContext *tc, DadaoISA::Process *process, int fd, Addr buf,
+           uint64_t len, int flags, Addr addrAddr, Addr lenAddr, bool &blocked)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+
+    int guestLen = 0;
+    if (!readGuestSocklen(tc, lenAddr, guestLen))
+        return static_cast<RegVal>(-EFAULT);
+
+    if (!hostFdNonblocking(simFd) && !pollReady(simFd, POLLIN)) {
+        blocked = true;
+        return 0;
+    }
+
+    std::vector<uint8_t> data(len);
+    uint8_t raw[GuestSockaddrMax];
+    std::memset(raw, 0, sizeof(raw));
+    socklen_t addrlen = sizeof(raw);
+    ssize_t received;
+    do {
+        received = ::recvfrom(simFd, data.data(), len, flags,
+                              addrAddr != 0
+                                  ? reinterpret_cast<struct sockaddr *>(raw)
+                                  : nullptr,
+                              addrAddr != 0 ? &addrlen : nullptr);
+    } while (received < 0 && errno == EINTR);
+    if (received < 0)
+        return static_cast<RegVal>(-errno);
+
+    if (addrAddr != 0 && !writeGuestSockaddr(tc, addrAddr, lenAddr, raw,
+                                             static_cast<int>(addrlen),
+                                             guestLen))
+        return static_cast<RegVal>(-EFAULT);
+    if (received > 0 && !writeGuestBlob(tc, buf, data.data(), received))
+        return static_cast<RegVal>(-EFAULT);
+    return static_cast<RegVal>(received);
+}
+
+RegVal
+doSetsockopt(ThreadContext *tc, DadaoISA::Process *process, int fd, int level,
+             int optname, Addr optval, int optlen)
+{
+    constexpr int SolSocket = 1;
+    constexpr int SoRcvTimeo = 20;
+    constexpr int SoSndTimeo = 21;
+
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    if (optlen < 0 || optlen > 256)
+        return static_cast<RegVal>(-EINVAL);
+    std::vector<uint8_t> raw(optlen);
+    if (optlen > 0 && !readGuestBlob(tc, optval, raw.data(), optlen))
+        return static_cast<RegVal>(-EFAULT);
+
+    // struct timeval (SO_RCVTIMEO/SO_SNDTIMEO) is two 64-bit fields and the
+    // guest is big-endian; every other option is an opaque integer/struct.
+    if (level == SolSocket && (optname == SoRcvTimeo || optname == SoSndTimeo) &&
+        optlen == 16) {
+        struct timeval tv;
+        tv.tv_sec = readBigEndian64(raw.data());
+        tv.tv_usec = readBigEndian64(raw.data() + 8);
+        if (::setsockopt(simFd, level, optname, &tv, sizeof(tv)) < 0)
+            return static_cast<RegVal>(-errno);
+        return 0;
+    }
+
+    if (::setsockopt(simFd, level, optname, raw.data(), optlen) < 0)
+        return static_cast<RegVal>(-errno);
+    return 0;
+}
+
+RegVal
+doGetsockopt(ThreadContext *tc, DadaoISA::Process *process, int fd, int level,
+             int optname, Addr optval, Addr optlenAddr)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    int guestLen = 0;
+    if (!readGuestSocklen(tc, optlenAddr, guestLen))
+        return static_cast<RegVal>(-EFAULT);
+    if (guestLen < 0 || guestLen > 256)
+        return static_cast<RegVal>(-EINVAL);
+
+    std::vector<uint8_t> raw(guestLen > 0 ? guestLen : 1);
+    socklen_t len = guestLen;
+    if (::getsockopt(simFd, level, optname, raw.data(), &len) < 0)
+        return static_cast<RegVal>(-errno);
+    if (len > 0 && !writeGuestBlob(tc, optval, raw.data(), len))
+        return static_cast<RegVal>(-EFAULT);
+    return writeGuestSockaddr(tc, 0, optlenAddr, nullptr, len, 0)
+               ? static_cast<RegVal>(0)
+               : static_cast<RegVal>(-EFAULT);
+}
+
+RegVal
+doGetSockName(ThreadContext *tc, DadaoISA::Process *process, int fd,
+              Addr addrAddr, Addr lenAddr, bool peer)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    int guestLen = 0;
+    if (!readGuestSocklen(tc, lenAddr, guestLen))
+        return static_cast<RegVal>(-EFAULT);
+
+    uint8_t raw[GuestSockaddrMax];
+    std::memset(raw, 0, sizeof(raw));
+    socklen_t addrlen = sizeof(raw);
+    const int rc = peer
+        ? ::getpeername(simFd, reinterpret_cast<struct sockaddr *>(raw), &addrlen)
+        : ::getsockname(simFd, reinterpret_cast<struct sockaddr *>(raw), &addrlen);
+    if (rc < 0)
+        return static_cast<RegVal>(-errno);
+    if (!writeGuestSockaddr(tc, addrAddr, lenAddr, raw,
+                            static_cast<int>(addrlen), guestLen))
+        return static_cast<RegVal>(-EFAULT);
+    return 0;
+}
+
+RegVal
+doShutdown(DadaoISA::Process *process, int fd, int how)
+{
+    int simFd;
+    if (int status = hostFdOf(process, fd, simFd); status != 0)
+        return static_cast<RegVal>(status);
+    if (::shutdown(simFd, how) < 0)
+        return static_cast<RegVal>(-errno);
+    return 0;
+}
+
+RegVal
+doSocketpair(ThreadContext *tc, DadaoISA::Process *process, int domain,
+             int type, int protocol, Addr svAddr)
+{
+    if (!familySupported(domain))
+        return static_cast<RegVal>(-EAFNOSUPPORT);
+    if (svAddr == 0)
+        return static_cast<RegVal>(-EFAULT);
+    const int baseType = type & ~(TgtSockCloexec | TgtSockNonblock);
+    int sv[2];
+    if (::socketpair(domain, type, protocol, sv) < 0)
+        return static_cast<RegVal>(-errno);
+
+    auto first = std::make_shared<SocketFDEntry>(
+            sv[0], domain, baseType, protocol, (type & TgtSockCloexec) != 0);
+    auto second = std::make_shared<SocketFDEntry>(
+            sv[1], domain, baseType, protocol, (type & TgtSockCloexec) != 0);
+    const int fd0 = allocGuestFd(process, first);
+    if (fd0 < 0) {
+        ::close(sv[0]);
+        ::close(sv[1]);
+        return static_cast<RegVal>(fd0);
+    }
+    const int fd1 = allocGuestFd(process, second);
+    if (fd1 < 0) {
+        process->fds->closeFDEntry(fd0);
+        ::close(sv[1]);
+        return static_cast<RegVal>(fd1);
+    }
+    uint8_t raw[8];
+    writeBigEndian32(raw, fd0);
+    writeBigEndian32(raw + 4, fd1);
+    if (!writeGuestBlob(tc, svAddr, raw, sizeof(raw))) {
+        process->fds->closeFDEntry(fd0);
+        process->fds->closeFDEntry(fd1);
+        return static_cast<RegVal>(-EFAULT);
+    }
+    return 0;
+}
+
+/** clone(CLONE_THREAD): add a thread to the *calling process* -- same address
+ *  space, fd table and signal dispositions, its own stack, thread pointer and
+ *  per-thread kernel state.  The new thread runs on a free ThreadContext of
+ *  the same CPU, so the CPU interleaves the two like a kernel does. */
+RegVal
+doCloneThread(ThreadContext *tc, DadaoISA::Process *process, uint64_t flags,
+              Addr newsp, Addr parentTidPtr, uint64_t tls, Addr childTidPtr)
+{
+    // CLONE_THREAD requires a shared address space and shared handlers; a
+    // thread also needs the private stack musl's __clone always passes.
+    if (!(flags & CloneVm) || !(flags & CloneSighand))
+        return static_cast<RegVal>(-EINVAL);
+    if (newsp == 0)
+        return static_cast<RegVal>(-EINVAL);
+    if (flags & CloneUnsupportedNamespaces)
+        return static_cast<RegVal>(-EINVAL);
+
+    // RLIMIT_NPROC counts the tasks of the process, threads included.
+    const uint64_t nprocLimit = process->limits[DadaoISA::RlimitNproc].cur;
+    if (nprocLimit != DadaoISA::RlimInfinity &&
+        process->liveThreadCount() >= nprocLimit)
+        return static_cast<RegVal>(-EAGAIN);
+
+    ThreadContext *ctc = tc->getSystemPtr()->threads.findFree();
+    if (ctc == nullptr)
+        return static_cast<RegVal>(-EAGAIN);
+
+    const ContextID cid = ctc->contextId();
+    gem5::Process *owner = ctc->getProcessPtr();
+    ctc->setProcessPtr(process);
+    if (owner != nullptr && owner != process &&
+        std::find(owner->contextIds.begin(), owner->contextIds.end(), cid) !=
+            owner->contextIds.end())
+        owner->revokeThreadContext(cid);
+    if (std::find(process->contextIds.begin(), process->contextIds.end(),
+                  cid) == process->contextIds.end())
+        process->assignThreadContext(cid);
+
+    const DadaoISA::ThreadState &parentThread = threadOf(process, tc);
+    DadaoISA::ThreadState &childThread = process->threadState(cid);
+    childThread = DadaoISA::ThreadState();
+    childThread.tid = process->nextThreadTid++;
+    childThread.cid = cid;
+    childThread.live = true;
+    childThread.blocked = parentThread.blocked; // inherited; altstack is not
+    if (flags & CloneChildCleartid)
+        childThread.clearTid = childTidPtr;
+
+    // The child is the caller at the point where the trap has completed: the
+    // same register file, the stack it was cloned with, rd8 = 0.
+    for (unsigned i = 0; i < 64; ++i) {
+        ctc->setReg(intReg(DadaoISA::int_reg::RdBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RdBase + i)));
+        ctc->setReg(intReg(DadaoISA::int_reg::RbBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RbBase + i)));
+        ctc->setReg(intReg(DadaoISA::int_reg::RaBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RaBase + i)));
+        const RegId rf(DadaoISA::floatRegClass, i);
+        ctc->setReg(rf, tc->getReg(rf));
+    }
+    const Addr trapPc = tc->pcState().instAddr();
+    ctc->pcState(DadaoISA::PCState(trapPc + 4));
+    ctc->setReg(rb(1), newsp);
+    ctc->setReg(rd(8), RegVal(0));
+    // CLONE_SETTLS installs the thread pointer: rb3 = rbtp (spec/DADAO-21 ABI,
+    // contract-abi §1.2).  This is QEMU's cpu_set_tls equivalent; musl's
+    // __clone stub also writes it, which is why a raw clone needs this one.
+    if (flags & CloneSetTls)
+        ctc->setReg(rb(3), tls);
+
+    uint8_t rawPid[4];
+    writeBigEndian32(rawPid, static_cast<uint32_t>(childThread.tid));
+    if ((flags & CloneParentSettid) &&
+        !writeGuestBlob(tc, parentTidPtr, rawPid, sizeof(rawPid)))
+        return static_cast<RegVal>(-EFAULT);
+    if ((flags & CloneChildSettid) &&
+        !writeGuestBlob(ctc, childTidPtr, rawPid, sizeof(rawPid)))
+        return static_cast<RegVal>(-EFAULT);
+
+    ctc->activate();
+    return static_cast<RegVal>(childThread.tid);
+}
+
+/** clone(2) -- the fork/vfork/posix_spawn entry point of musl (which calls
+ *  clone even for fork(2)), and (CLONE_THREAD) the pthread_create entry. */
+RegVal
+doClone(ThreadContext *tc, DadaoISA::Process *process, uint64_t flags,
+        Addr newsp, Addr parentTidPtr, uint64_t tls, Addr childTidPtr,
+        bool &suspendSelf)
+{
+    if (flags & CloneThread)
+        return doCloneThread(tc, process, flags, newsp, parentTidPtr, tls,
+                             childTidPtr);
+    if (flags & CloneUnsupportedNamespaces)
+        return static_cast<RegVal>(-EINVAL);
+    if ((flags & CloneSighand) && !(flags & CloneVm))
+        return static_cast<RegVal>(-EINVAL);
+    if ((flags & CloneVm) && newsp == 0)
+        return static_cast<RegVal>(-EINVAL);
+
+    // RLIMIT_NPROC (asm-generic 6): the kernel refuses fork/clone past the
+    // limit with EAGAIN, which libc-test's pthread_atfork-errno-clobber relies
+    // on.  SE has no uid-wide process count, so the guest process count is it.
+    const uint64_t nprocLimit = process->limits[DadaoISA::RlimitNproc].cur;
+    if (nprocLimit != DadaoISA::RlimInfinity &&
+        liveProcesses.size() >= nprocLimit)
+        return static_cast<RegVal>(-EAGAIN);
+
+    ThreadContext *ctc = tc->getSystemPtr()->threads.findFree();
+    if (ctc == nullptr)
+        return static_cast<RegVal>(-EAGAIN);
+
+    // First free PID below System::maxPID, exactly like the kernel's alloc_pid
+    // (gem5 keeps the set of live PIDs in System::PIDs).
+    const std::set<int> &pids = process->system->PIDs;
+    int pid = *pids.begin();
+    do {
+        ++pid;
+    } while (pids.find(pid) != pids.end());
+    if (pid >= System::maxPID)
+        fatal("DADAO SE: clone: no free pid below %d "
+              "(System::maxPID)", pid);
+
+    ProcessParams *pp = new ProcessParams();
+    pp->executable = process->progName();
+    pp->cmd = process->argv;
+    pp->env = process->envp;
+    pp->system = process->system;
+    pp->cwd = process->tgtCwd;
+    pp->input = "stdin";
+    pp->output = "stdout";
+    pp->errout = "stderr";
+    pp->uid = process->uid();
+    pp->euid = process->euid();
+    pp->gid = process->gid();
+    pp->egid = process->egid();
+    pp->release = process->release;
+    pp->maxStackSize = process->memState->getMaxStackSize();
+    pp->useArchPT = process->useArchPT;
+    pp->kvmInSE = process->kvmInSE;
+    pp->pid = pid;
+    pp->ppid = process->pid();
+    // Linux fork(2)/clone(2) without CLONE_THREAD places the child in the
+    // parent's process group; kill(0, sig) and wait4(0, ...) need it.
+    pp->pgid = process->pgid();
+    auto *child = dynamic_cast<DadaoISA::Process *>(pp->create());
+    fatal_if(child == nullptr, "DADAO SE: clone: loader produced no DADAO process");
+
+    gem5::Process *owner = ctc->getProcessPtr();
+    ctc->setProcessPtr(child);
+    child->assignThreadContext(ctc->contextId());
+    if (owner != nullptr &&
+        std::find(owner->contextIds.begin(), owner->contextIds.end(),
+                  ctc->contextId()) != owner->contextIds.end())
+        owner->revokeThreadContext(ctc->contextId());
+
+    child->initState();
+    process->clone(tc, ctc, child, flags);
+
+    child->parentProcess = process;
+    process->children.push_back(child);
+    child->signals = process->signals; // dispositions are process-wide
+    {
+        // The calling thread's mask and alternate stack are inherited; pending
+        // signals are not (Linux fork: the child starts with an empty queue).
+        const DadaoISA::ThreadState &parentThread = threadOf(process, tc);
+        DadaoISA::ThreadState &childThread = threadOf(child, ctc);
+        childThread.blocked = parentThread.blocked;
+        childThread.altStackSp = parentThread.altStackSp;
+        childThread.altStackSize = parentThread.altStackSize;
+    }
+    for (unsigned i = 0; i < DadaoISA::NumResourceLimits; ++i) {
+        child->limits[i] = process->limits[i];
+        child->limitsSet[i] = process->limitsSet[i];
+    }
+    // Page protection: threads (CLONE_VM) share it, fork gets a copy.  The
+    // fork copy replaces the child's own freshly built map so the parent's
+    // mprotect/mmap state is what the guest sees.
+    child->inheritProtection(process, flags & CloneVm);
+    // The table is only really shared when clone() shared it (gem5 copies it
+    // unless the CLONE_FILES macros are visible; ask the object, not the flag).
+    child->sharesFdTable = child->fds == process->fds;
+    *child->sigchld = true;
+    registerLiveProcess(child);
+
+    // Child register state: a copy of the parent's, returning 0 from the trap
+    // (the parent returns the child pid further down).
+    for (unsigned i = 0; i < 64; ++i) {
+        ctc->setReg(intReg(DadaoISA::int_reg::RdBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RdBase + i)));
+        ctc->setReg(intReg(DadaoISA::int_reg::RbBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RbBase + i)));
+        ctc->setReg(intReg(DadaoISA::int_reg::RaBase + i),
+                    tc->getReg(intReg(DadaoISA::int_reg::RaBase + i)));
+        const RegId rf(DadaoISA::floatRegClass, i);
+        ctc->setReg(rf, tc->getReg(rf));
+    }
+    // The child is a copy of the caller at the point where the trap has just
+    // completed: the next instruction is the one after the trap (pc), and the
+    // one after that is pc + 4 (npc) -- exactly what the parent's advancePC
+    // will produce, so the first instruction after fork runs once.
+    const Addr trapPc = tc->pcState().instAddr();
+    ctc->pcState(DadaoISA::PCState(trapPc + 4));
+
+    // Linux gives the child the stack pointer it was cloned with (musl's
+    // __clone reserves 16 bytes there for func/arg and reads them back in the
+    // child); newsp == 0 means "keep the caller's stack" (fork/vfork).
+    if (newsp != 0)
+        ctc->setReg(rb(1), newsp);
+    ctc->setReg(rd(8), RegVal(0));
+
+    if (flags & CloneParentSettid) {
+        uint8_t rawPid[4];
+        writeBigEndian32(rawPid, static_cast<uint32_t>(child->pid()));
+        writeGuestBlob(tc, parentTidPtr, rawPid, sizeof(rawPid));
+    }
+    if (flags & CloneChildSettid) {
+        uint8_t rawPid[4];
+        writeBigEndian32(rawPid, static_cast<uint32_t>(child->pid()));
+        writeGuestBlob(ctc, childTidPtr, rawPid, sizeof(rawPid));
+    }
+    if (flags & CloneChildCleartid) {
+        // The child clears this word (and wakes a waiter) when it exits.
+        DadaoISA::ThreadState &childThread = threadOf(child, ctc);
+        childThread.clearTid = childTidPtr;
+    }
+
+    ctc->activate();
+
+    if (flags & CloneVfork) {
+        child->vforkContexts.push_back(tc->contextId());
+        suspendSelf = true;
+    }
+
+    return static_cast<RegVal>(child->pid());
+}
+
+/** execve(2): replace the calling process image with a new DADAO ET_EXEC
+ *  binary.  A non-DADAO file is ENOEXEC (Linux's "unrecognised executable
+ *  format"), never a fatal: the SE platform cannot run host code. */
+void
+doExecve(ThreadContext *tc, DadaoISA::Process *process, Addr pathAddr,
+         Addr argvAddr, Addr envpAddr, RegVal &result, bool &replaced)
+{
+    constexpr size_t MaxVector = 4096;
+
+    std::string path;
+    if (!readGuestString(tc, pathAddr, path)) {
+        result = static_cast<RegVal>(-EFAULT);
+        return;
+    }
+
+    const auto readVector = [tc](Addr addr, std::vector<std::string> &out) {
+        for (size_t i = 0; addr != 0; ++i) {
+            if (i >= MaxVector)
+                return false;
+            uint8_t raw[8];
+            if (!readGuestBlob(tc, addr + 8 * i, raw, sizeof(raw)))
+                return false;
+            const Addr item = readBigEndian64(raw);
+            if (item == 0)
+                return true;
+            std::string value;
+            if (!readGuestString(tc, item, value))
+                return false;
+            out.push_back(value);
+        }
+        return true;
+    };
+
+    std::vector<std::string> argv;
+    std::vector<std::string> envp;
+    if (!readVector(argvAddr, argv)) {
+        result = static_cast<RegVal>(-EFAULT);
+        return;
+    }
+    if (!readVector(envpAddr, envp)) {
+        result = static_cast<RegVal>(-EFAULT);
+        return;
+    }
+    if (argv.empty()) {
+        result = static_cast<RegVal>(-EFAULT);
+        return;
+    }
+
+    std::string hostPath;
+    if (int status = resolveGuestPath(process, AtFdcwd, path, hostPath); status != 0) {
+        result = static_cast<RegVal>(status);
+        return;
+    }
+    if (hostPath.empty()) {
+        result = static_cast<RegVal>(-ENOENT);
+        return;
+    }
+
+    // stat() first: gem5's loader fatals when it cannot open the file, but a
+    // missing interpreter is just ENOENT for execve (and ENOEXEC for a file
+    // that is not a runnable ELF).
+    struct stat st;
+    if (::stat(hostPath.c_str(), &st) < 0) {
+        result = static_cast<RegVal>(-errno);
+        return;
+    }
+    if (!S_ISREG(st.st_mode)) {
+        result = static_cast<RegVal>(-EACCES);
+        return;
+    }
+
+    // Readability is checked here, before the loader: gem5's ImageFileData
+    // fatals when the file cannot be opened, while execve must report the
+    // host's errno (a mode-0000 ELF is EACCES).  The open also catches the
+    // other "cannot even read it" failures (ELOOP, EMFILE, ENOMEM, ...) so
+    // they never reach the fatal path.
+    const int probeFd = ::open(hostPath.c_str(), O_RDONLY);
+    if (probeFd < 0) {
+        result = static_cast<RegVal>(-errno);
+        return;
+    }
+    ::close(probeFd);
+
+    loader::ObjectFile *obj = loader::createObjectFile(hostPath);
+    if (obj == nullptr) {
+        result = static_cast<RegVal>(-ENOEXEC);
+        return;
+    }
+    const bool runnable =
+        obj->getArch() == loader::Dadao &&
+        obj->getByteOrder() == ByteOrder::big &&
+        dynamic_cast<loader::ElfObject *>(obj) != nullptr &&
+        dynamic_cast<loader::ElfObject *>(obj)->elfType() == ET_EXEC &&
+        obj->getInterpreter() == nullptr &&
+        (dynamic_cast<loader::ElfObject *>(obj)->elfFlags() & 0xff) == 1 &&
+        (dynamic_cast<loader::ElfObject *>(obj)->elfFlags() >> 8) == 0;
+    if (!runnable) {
+        delete obj;
+        result = static_cast<RegVal>(-ENOEXEC);
+        return;
+    }
+
+    ProcessParams *pp = new ProcessParams();
+    pp->executable = hostPath;
+    pp->cmd = argv;
+    pp->env = envp;
+    pp->system = process->system;
+    pp->cwd = process->tgtCwd;
+    pp->input = "stdin";
+    pp->output = "stdout";
+    pp->errout = "stderr";
+    pp->uid = process->uid();
+    pp->euid = process->euid();
+    pp->gid = process->gid();
+    pp->egid = process->egid();
+    pp->release = process->release;
+    pp->maxStackSize = process->memState->getMaxStackSize();
+    pp->useArchPT = process->useArchPT;
+    pp->kvmInSE = process->kvmInSE;
+    pp->pid = process->pid();
+    pp->ppid = process->ppid();
+    pp->pgid = process->pgid(); // execve(2) keeps the process group
+
+    // The PID stays reserved by this image until the new one takes it over.
+    process->system->PIDs.erase(process->pid());
+    DadaoISA::Process *newProcess =
+        dynamic_cast<DadaoISA::Process *>(Process::tryLoaders(*pp, obj));
+    if (newProcess == nullptr) {
+        process->system->PIDs.insert(process->pid());
+        result = static_cast<RegVal>(-ENOEXEC);
+        return;
+    }
+
+    newProcess->fds = process->fds;
+    for (int i = 0; i < newProcess->fds->getSize(); ++i) {
+        std::shared_ptr<FDEntry> entry = (*newProcess->fds)[i];
+        if (entry && entry->getCOE())
+            newProcess->fds->closeFDEntry(i);
+    }
+    // Signal state across execve: dispositions reset to SIG_DFL except the
+    // ignored ones, the blocked mask and the alternate stack are kept.
+    newProcess->signals = process->signals;
+    for (int sig = 1; sig <= NumSignals; ++sig) {
+        if (newProcess->signals.actions[sig].handler != SigIgn)
+            newProcess->signals.actions[sig] = DadaoISA::SignalDisposition();
+    }
+    for (unsigned i = 0; i < DadaoISA::NumResourceLimits; ++i) {
+        newProcess->limits[i] = process->limits[i];
+        newProcess->limitsSet[i] = process->limitsSet[i];
+    }
+    newProcess->parentProcess = process->parentProcess;
+    newProcess->sharesFdTable = process->sharesFdTable;
+    *newProcess->sigchld = true;
+    if (auto *parent = process->parentProcess) {
+        for (auto *&child : parent->children) {
+            if (child == process)
+                child = newProcess;
+        }
+    }
+    if (mainProcess == process)
+        mainProcess = newProcess;
+
+    process->replacedByExec = true;
+    process->contextIds.clear();
+    unregisterLiveProcess(process);
+    registerLiveProcess(newProcess);
+
+    for (ContextID ctx : process->vforkContexts) {
+        ThreadContext *ptc = process->system->threads[ctx];
+        if (ptc->status() == ThreadContext::Suspended)
+            ptc->activate();
+    }
+    process->vforkContexts.clear();
+
+    tc->clearArchRegs();
+    tc->setProcessPtr(newProcess);
+    newProcess->assignThreadContext(tc->contextId());
+    newProcess->init();
+    newProcess->initState();
+
+    // execve keeps the calling thread's mask and alternate stack.
+    {
+        const DadaoISA::ThreadState &oldThread = threadOf(process, tc);
+        DadaoISA::ThreadState &newThread = threadOf(newProcess, tc);
+        newThread.blocked = oldThread.blocked;
+        newThread.altStackSp = oldThread.altStackSp;
+        newThread.altStackSize = oldThread.altStackSize;
+        newThread.altStackFlags = oldThread.altStackFlags;
+    }
+
+    // initState() leaves PCState(entry) (npc = entry + 4), but the CPU advances
+    // this thread once more after the trap returns: make that advance land on
+    // the new image's entry point (advance() is pc = npc, npc += 4).
+    const Addr entryPoint = newProcess->getStartPC();
+    DadaoISA::PCState entryState(entryPoint);
+    entryState.npc(entryPoint);
+    tc->pcState(entryState);
+
+    tc->activate();
+
+    replaced = true;
+}
+
+/** wait4(2): reap a child, or ask for a retry when a live child has not
+ *  exited yet.  The status is the raw Linux wait status. */
+RegVal
+doWait4(ThreadContext *tc, DadaoISA::Process *process, int pid, Addr statAddr,
+        int options, Addr rusageAddr, bool &blocked)
+{
+    const auto matches = [&](DadaoISA::Process *child) {
+        if (pid == -1)
+            return true;
+        if (pid > 0)
+            return static_cast<int>(child->pid()) == pid;
+        if (pid == 0)
+            return child->pgid() == process->pgid();
+        return static_cast<int>(child->pgid()) == -pid;
+    };
+
+    DadaoISA::Process *found = nullptr;
+    // Linux reports ECHILD when no child *matches* the request, even if other
+    // children exist and are alive; only a matching child that has not exited
+    // keeps the caller waiting.
+    bool anyMatch = false;
+    for (auto *child : process->children) {
+        if (!matches(child))
+            continue;
+        anyMatch = true;
+        if (child->hasExited) {
+            found = child;
+            break;
+        }
+    }
+    if (found == nullptr) {
+        if (!anyMatch)
+            return static_cast<RegVal>(-ECHILD);
+        if (options & WaitNoHang)
+            return 0;
+        blocked = true;
+        return 0;
+    }
+
+    if (statAddr != 0) {
+        uint8_t raw[4];
+        writeBigEndian32(raw, static_cast<uint32_t>(found->waitStatus));
+        if (!writeGuestBlob(tc, statAddr, raw, sizeof(raw)))
+            return static_cast<RegVal>(-EFAULT);
+    }
+    if (rusageAddr != 0) {
+        // struct rusage: two timevals plus 14 longs; SE reports zeros.
+        std::vector<uint8_t> zeros(144, 0);
+        if (!writeGuestBlob(tc, rusageAddr, zeros.data(), zeros.size()))
+            return static_cast<RegVal>(-EFAULT);
+    }
+
+    const int childPid = static_cast<int>(found->pid());
+    process->children.erase(std::remove(process->children.begin(),
+                                        process->children.end(), found),
+                            process->children.end());
+    // Linux frees the pid when the zombie is reaped, so the slot can be
+    // reused.  Without this the SE pid table only ever grows and fork(2)
+    // eventually dies at System::maxPID.
+    process->system->PIDs.erase(found->pid());
+    return childPid;
+}
