+// Static per-instruction latency policy for the wuming cycle table (M16).
+//
+// The table itself (``wuming_cycles.hh``) is generated from
+// ``docs/core-wuming-cycle-model.md``; this header is the *policy* that turns
+// one row into the extra cycles gem5 must add after an instruction completes.
+// It is plain C++ so the standalone policy harness can exercise all 264 rows
+// without gem5 headers.
+//
+// Milestones: m16-gem5-003 maps the classes whose rows already carry a fixed
+// figure (A / A2 / A3 / B4 / G1-G4); the parameterised classes (B1/B2/B3/B5,
+// C, D, D', E, F, and the ``dynamic`` rows inside B4/A3/G1-G3) keep gem5's
+// one-cycle placeholder until m16-gem5-004 (width/mode), 005 (block transfer)
+// and 006 (memory timing).  There is no guessed cycle count here: a row is
+// used only when the document gives a literal fixed value.
+#ifndef __ARCH_DADAO_WUMING_LATENCY_HH__
+#define __ARCH_DADAO_WUMING_LATENCY_HH__
+
+#include <cstdint>
+#include <string_view>
+
+#include "arch/dadao/wuming_cycles.hh"
+
+namespace gem5
+{
+namespace DadaoISA
+{
+namespace wuming
+{
+
+/** Classes whose cycle figures this milestone feeds into gem5.  A3/G1/G2/G3
+ *  only have parameterised rows today (RAS kind, trap target, range), so they
+ *  contribute zero until their dynamic model lands. */
+constexpr uint32_t kStaticClassMask =
+    (1u << static_cast<unsigned>(CycleClass::A)) |
+    (1u << static_cast<unsigned>(CycleClass::A2)) |
+    (1u << static_cast<unsigned>(CycleClass::A3)) |
+    (1u << static_cast<unsigned>(CycleClass::B4)) |
+    (1u << static_cast<unsigned>(CycleClass::G1)) |
+    (1u << static_cast<unsigned>(CycleClass::G2)) |
+    (1u << static_cast<unsigned>(CycleClass::G3)) |
+    (1u << static_cast<unsigned>(CycleClass::G4));
+
+/** Rows whose latency is carried by the memory system keep it there: the
+ *  extraExecLatency contract in arch/generic/isa.hh says loads/stores return
+ *  zero, and m16-gem5-006 is the one that models ld/st timing.  Only one row
+ *  in the static class set is affected (``ld.o rf``, classified B4 by the
+ *  document's FP/register-data row). */
+inline bool
+memoryRow(const CycleRow &row)
+{
+    const std::string_view mnemonic(row.mnemonic);
+    return mnemonic.compare(0, 3, "ld.") == 0 ||
+           mnemonic.compare(0, 3, "st.") == 0;
+}
+
+/** Extra cycles after the instruction for one table row.
+ *
+ *  The document counts EXEC-to-writeback cycles, and TimingSimpleCPU already
+ *  spends one cycle in execute(), so the extra is ``value - 1``.  Zero means
+ *  "keep the one-cycle placeholder": no fixed figure in the table (dynamic
+ *  row), class outside this milestone, a memory row, or a one-cycle value.
+ */
+inline unsigned
+extraExecCycles(const CycleRow *row)
+{
+    if (row == nullptr)
+        return 0;
+    if (row->dynamic[0] != '\0')
+        return 0;
+    if ((row->classMask & kStaticClassMask) == 0)
+        return 0;
+    if (memoryRow(*row))
+        return 0;
+    if (row->cycles <= 1)
+        return 0;
+    return static_cast<unsigned>(row->cycles) - 1;
+}
+
+/** Same, for a contract id (nullptr / unknown id => 0). */
+inline unsigned
+extraExecCycles(std::string_view id)
+{
+    const CycleRow *row = byId(id);
+    return extraExecCycles(row);
+}
+
+} // namespace wuming
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_WUMING_LATENCY_HH__
