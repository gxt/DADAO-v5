diff --git a/src/arch/dadao/process.hh b/src/arch/dadao/process.hh
new file mode 100644
index 0000000..8e2b4ee
--- /dev/null
+++ b/src/arch/dadao/process.hh
@@ -0,0 +1,120 @@
+// DADAO syscall-emulation process: static ET_EXEC image, initial stack vector
+// and the SE platform's initial architectural state.
+//
+// The address-space layout below is an SE platform convention (ADR-0048 D1:
+// SE only ever compares with QEMU user mode), not an architectural assertion.
+#ifndef __ARCH_DADAO_PROCESS_HH__
+#define __ARCH_DADAO_PROCESS_HH__
+
+#include "params/Process.hh"
+#include "sim/process.hh"
+
+namespace gem5
+{
+
+namespace loader
+{
+class ObjectFile;
+} // namespace loader
+
+namespace DadaoISA
+{
+
+// Top of the anonymous mmap window (SE platform convention, ADR-0048 D1).
+// A bounded window keeps the guest-visible address space comparable to the
+// QEMU user baseline and makes an address-space-fill / munmap sweep bounded;
+// the image and the heap live below it, the stack above it.
+constexpr Addr MmapWindowEnd = 0x0000000200000000ULL; // 8 GiB
+
+// Signal trampoline page (SE platform convention, same role as QEMU
+// linux-user's sigtramp page): two instructions that perform rt_sigreturn,
+//   set.zw rd15, wp0, 139   encoding 0x4c3c008b
+//   trap cfx0, 0            encoding 0x7f000000
+// The guest has no SA_RESTORER (musl arch/dadao/bits/signal.h defines none),
+// so the kernel-side trampoline is how a returning handler gets back.  Placed
+// between the mmap window top and MemRAS, outside both.
+constexpr Addr SigTrampBase = 0x0000400000000000ULL;
+
+/** One guest signal disposition (rt_sigaction's 32-byte struct reduced to
+ *  the fields the SE driver acts on; musl arch/dadao/ksigaction.h without
+ *  SA_RESTORER is {handler, flags, mask[8B], unused}). */
+struct SignalDisposition
+{
+    Addr handler = 0;   // SIG_DFL (0), SIG_IGN (1), or a guest code address
+    uint64_t flags = 0;
+    uint64_t mask = 0;  // 8-byte sigset: bit (sig-1) for signals 1..64
+};
+
+/** Per-process Linux signal state.  SE is single-threaded in this round, so
+ *  one blocked mask and one pending set are enough (Linux keeps them per
+ *  thread); the frame layout is the one musl's ucontext_t names. */
+struct SignalState
+{
+    uint64_t blocked = 0;
+    uint64_t pending = 0;
+    int pendingCode[65] = {};     // siginfo si_code for the pending signal
+    SignalDisposition actions[65]; // [1..64] addressable; [0] unused
+    Addr altStackSp = 0;
+    uint64_t altStackSize = 0;     // 0 == SS_DISABLE
+};
+
+/** struct rlimit value pair (prlimit64).  RLIM_INFINITY is all ones. */
+struct ResourceLimit
+{
+    uint64_t cur;
+    uint64_t max;
+};
+
+constexpr uint64_t RlimInfinity = ~uint64_t(0);
+// RLIMIT_* numbers 0..15 (asm-generic uapi).
+constexpr unsigned NumResourceLimits = 16;
+constexpr unsigned RlimitData = 2;
+constexpr unsigned RlimitStack = 3;
+constexpr unsigned RlimitNofile = 7;
+constexpr unsigned RlimitNproc = 6;
+constexpr unsigned RlimitAs = 9;
+
+class Process : public gem5::Process
+{
+  public:
+    Process(const ProcessParams &params, loader::ObjectFile *objFile);
+
+    SignalState signals;
+    ResourceLimit limits[NumResourceLimits];
+
+    // Multi-process state (GEM5-025t).  fork(2)/clone(2) create a second
+    // Process object whose parentProcess is the caller; wait4(2) reaps it.
+    Process *parentProcess = nullptr;
+    std::vector<Process *> children; // forked, not yet reaped
+    bool hasExited = false;
+    int waitStatus = 0;              // raw Linux wait(2) status
+    bool replacedByExec = false;     // image replaced by execve(2)
+    bool sharesFdTable = false;      // clone(CLONE_FILES)
+
+    // The SE loader and execve(2) build the initial stack/register state here.
+    void initState() override;
+
+  protected:
+
+    /** Build argc/argv/envp/auxv on the initial stack (big-endian fields). */
+    template <class IntType>
+    void argsInit(Addr pageSize);
+
+  private:
+    /** Fail closed on anything but a big-endian, static, flat ET_EXEC. */
+    void validateStaticElf();
+
+    /** The SE configuration lists the same Process once per thread context
+     *  (the CPU requires one workload per context), so instantiate() calls
+     *  initState() several times on one object; only the first builds the
+     *  image, the stack and the MemRAS. */
+    bool initialStateBuilt = false;
+
+    /** Exact initial stack pointer (before the VMA page rounding). */
+    Addr initialSp = 0;
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_PROCESS_HH__
