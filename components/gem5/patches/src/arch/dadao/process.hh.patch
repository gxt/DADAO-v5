+// DADAO syscall-emulation process: static ET_EXEC image, initial stack vector
+// and the SE platform's initial architectural state.
+//
+// The address-space layout below is an SE platform convention (ADR-0048 D1:
+// SE only ever compares with QEMU user mode), not an architectural assertion.
+#ifndef __ARCH_DADAO_PROCESS_HH__
+#define __ARCH_DADAO_PROCESS_HH__
+
+#include "params/Process.hh"
+#include "sim/process.hh"
+
+namespace gem5
+{
+
+namespace loader
+{
+class ObjectFile;
+} // namespace loader
+
+namespace DadaoISA
+{
+
+// Top of the anonymous mmap window (SE platform convention, ADR-0048 D1).
+// A bounded window keeps the guest-visible address space comparable to the
+// QEMU user baseline and makes an address-space-fill / munmap sweep bounded;
+// the image and the heap live below it, the stack above it.
+constexpr Addr MmapWindowEnd = 0x0000000200000000ULL; // 8 GiB
+
+class Process : public gem5::Process
+{
+  public:
+    Process(const ProcessParams &params, loader::ObjectFile *objFile);
+
+  protected:
+    void initState() override;
+
+    /** Build argc/argv/envp/auxv on the initial stack (big-endian fields). */
+    template <class IntType>
+    void argsInit(Addr pageSize);
+
+  private:
+    /** Fail closed on anything but a big-endian, static, flat ET_EXEC. */
+    void validateStaticElf();
+
+    /** Exact initial stack pointer (before the VMA page rounding). */
+    Addr initialSp = 0;
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_PROCESS_HH__
