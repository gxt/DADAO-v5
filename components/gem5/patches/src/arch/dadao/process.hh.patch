diff --git a/src/arch/dadao/process.hh b/src/arch/dadao/process.hh
new file mode 100644
index 0000000..cf3b825
--- /dev/null
+++ b/src/arch/dadao/process.hh
@@ -0,0 +1,322 @@
+// DADAO syscall-emulation process: ET_EXEC image (static or with a PT_INTERP
+// interpreter), initial stack vector and the SE platform's initial
+// architectural state.
+//
+// The address-space layout below is an SE platform convention (ADR-0048 D1:
+// SE only ever compares with QEMU user mode), not an architectural assertion.
+#ifndef __ARCH_DADAO_PROCESS_HH__
+#define __ARCH_DADAO_PROCESS_HH__
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <vector>
+
+#include "arch/dadao/page_size.hh"
+#include "params/Process.hh"
+#include "sim/process.hh"
+
+namespace gem5
+{
+
+namespace loader
+{
+class ElfObject;
+class ObjectFile;
+} // namespace loader
+
+namespace DadaoISA
+{
+
+// Top of the anonymous mmap window (SE platform convention, ADR-0048 D1).
+// A bounded window keeps the guest-visible address space comparable to the
+// QEMU user baseline and makes an address-space-fill / munmap sweep bounded;
+// the image and the heap live below it, the stack above it.
+constexpr Addr MmapWindowEnd = 0x0000000200000000ULL; // 8 GiB
+
+// Signal trampoline page (SE platform convention, same role as QEMU
+// linux-user's sigtramp page): two instructions that perform rt_sigreturn,
+//   set.zw rd15, wp0, 139   encoding 0x4c3c008b
+//   trap cfx0, 0            encoding 0x7f000000
+// The guest has no SA_RESTORER (musl arch/dadao/bits/signal.h defines none),
+// so the kernel-side trampoline is how a returning handler gets back.  Placed
+// between the mmap window top and MemRAS, outside both.
+constexpr Addr SigTrampBase = 0x0000400000000000ULL;
+
+/** One guest signal disposition (rt_sigaction's 32-byte struct reduced to
+ *  the fields the SE driver acts on; musl arch/dadao/ksigaction.h without
+ *  SA_RESTORER is {handler, flags, mask[8B], unused}). */
+struct SignalDisposition
+{
+    Addr handler = 0;   // SIG_DFL (0), SIG_IGN (1), or a guest code address
+    uint64_t flags = 0;
+    uint64_t mask = 0;  // 8-byte sigset: bit (sig-1) for signals 1..64
+};
+
+/** Process-wide signal *actions* (rt_sigaction).  Linux shares the
+ *  dispositions between the threads of a process; the mask, the pending set
+ *  and the alternate stack are per thread (ThreadState). */
+struct SignalState
+{
+    SignalDisposition actions[65]; // [1..64] addressable; [0] unused
+};
+
+/** struct rlimit value pair (prlimit64).  RLIM_INFINITY is all ones. */
+struct ResourceLimit
+{
+    uint64_t cur;
+    uint64_t max;
+};
+
+constexpr uint64_t RlimInfinity = ~uint64_t(0);
+// RLIMIT_* numbers 0..15 (asm-generic uapi).
+constexpr unsigned NumResourceLimits = 16;
+constexpr unsigned RlimitData = 2;
+constexpr unsigned RlimitStack = 3;
+constexpr unsigned RlimitNofile = 7;
+constexpr unsigned RlimitNproc = 6;
+constexpr unsigned RlimitAs = 9;
+
+/** Per-thread Linux state (GEM5-026t).  One entry per *live* thread of the
+ *  process, keyed by the gem5 context id that runs it.  Signal *actions* are
+ *  process-wide (SignalState); everything below is per thread exactly as
+ *  Linux keeps it: the blocked mask, the pending set, the alternate stack, the
+ *  clear-tid address of set_tid_address(2)/clone(CLONE_CHILD_CLEARTID) and the
+ *  robust-list head of set_robust_list(2). */
+struct ThreadState
+{
+    int tid = 0;                 // Linux tid; the main thread's is the pid
+    ContextID cid = 0;           // gem5 context running this thread
+    bool live = false;
+    Addr clearTid = 0;           // set_tid_address(2) / CLONE_CHILD_CLEARTID
+    Addr robustList = 0;         // set_robust_list(2) head
+    uint64_t robustLen = 0;
+    uint64_t blocked = 0;        // signal mask (bit sig-1)
+    uint64_t pending = 0;        // signals queued for this thread
+    int pendingCode[65] = {};    // siginfo si_code of a pending signal
+    Addr altStackSp = 0;
+    uint64_t altStackSize = 0;   // 0 == SS_DISABLE
+    /** The SS_* flags the guest installed (SS_AUTODISARM is the only bit the
+     *  kernel keeps; SS_DISABLE/SS_ONSTACK are derived from size/SP). */
+    int altStackFlags = 0;
+    /** Non-zero while this thread sleeps on a futex (GEM5-026t): the futex
+     *  wait queue keeps the completion state, this is only the address, so an
+     *  exiting thread can be dropped from the queue. */
+    Addr futexWaitAddr = 0;
+
+    /** Signal frames pushed on this thread, innermost last.  rt_sigreturn
+     *  reads the top one instead of trusting rb1: an ABI-legal handler (and
+     *  musl's cancellation handler in particular) may return to the
+     *  trampoline with a stack pointer that is not the frame base. */
+    std::vector<Addr> signalFrames;
+};
+
+class Process : public gem5::Process
+{
+  public:
+    Process(const ProcessParams &params, loader::ObjectFile *objFile);
+
+    SignalState signals;
+    ResourceLimit limits[NumResourceLimits];
+    /** True once the guest called setrlimit/prlimit64 for that resource.  Only
+     *  RLIMIT_STACK needs it: until set, its guest-visible value is the stack
+     *  region the loader mapped (QEMU-084t, same rule), not RLIM_INFINITY. */
+    bool limitsSet[NumResourceLimits] = {};
+
+    // PROT_* bits (asm-generic uapi) as stored in the SE page-protection map.
+    static constexpr uint8_t ProtNone = 0;
+    static constexpr uint8_t ProtRead = 1;
+    static constexpr uint8_t ProtWrite = 2;
+    static constexpr uint8_t ProtExec = 4;
+
+    /** One contiguous range of pages with the same protection. */
+    struct ProtRange
+    {
+        Addr end = 0;
+        uint8_t prot = 0;
+        bool growdown = false;
+    };
+
+    // --- SE page protection (mprotect(2), GEM5-030t) --------------------
+    //
+    // SE has no hardware page table and the host page table has no per-page
+    // permissions, so the guest-visible protection of a mapped range is kept
+    // here and checked by arch/dadao/tlb.cc on every CPU-issued access.
+    // Ranges are page-aligned and disjoint; a page with no entry is untracked
+    // (the pre-GEM5-030t behaviour: readable/writable/executable, and not
+    // counted by the address-space accounting).  The image, the stack, the
+    // MemRAS, the trampoline and every mmap/brk page are registered, so a
+    // guest access to an untracked page can only be one with no mapping at
+    // all (the page-table fault path handles that).
+
+    /** Install `prot` over [start,end) (rounded out to pages), splitting any
+     *  range it overlaps.  This is mmap/brk/exec: it may create entries. */
+    void setProtection(Addr start, Addr end, uint8_t prot,
+                       bool growdown = false);
+
+    /** Drop all protection entries in [start,end) (munmap/brk shrink). */
+    void clearProtection(Addr start, Addr end);
+
+    /** Move the entries in [start,end) to `dest` (mremap); the source range is
+     *  left untracked.  `dest` must have been cleared first. */
+    void moveProtection(Addr start, Addr end, Addr dest);
+
+    /** Apply `prot` to the *mapped* pages of [start,end), leaving holes alone
+     *  (mprotect).  Untracked pages are not created: a hole has no mapping to
+     *  protect, and counting it as mapped would corrupt RLIMIT_AS.  The
+     *  MAP_GROWSDOWN attribute of each range is kept (it belongs to the VMA,
+     *  not to the protection). */
+    void protectMapped(Addr start, Addr end, uint8_t prot);
+
+    /** Protection of the page containing `vaddr`; false when untracked.
+     *  Defined inline (not in process.cc): tlb.cc calls it on every CPU
+     *  access, so the 16-entry cache hit is the hot path and the std::map
+     *  lookup only runs after a miss. */
+    bool protectionAt(Addr vaddr, uint8_t &prot, bool &growdown) const
+    {
+        const Addr vpage = vaddr & ~Addr(PageBytes - 1);
+        const ProtCache &cache =
+            protCache[(vaddr >> PageShift) & (ProtCacheEntries - 1)];
+        if (cache.epoch == protEpoch && cache.page == vpage) {
+            if (!cache.tracked)
+                return false;
+            prot = cache.prot;
+            growdown = cache.growdown;
+            return true;
+        }
+        return protectionSlow(vpage, prot, growdown);
+    }
+
+    /** mm/mprotect.c PROT_GROWSDOWN: find the first VMA overlapping
+     *  [start,end); false = no overlap (ENOMEM).  On success `regionStart`
+     *  is that VMA's start (the kernel's `start = vma->vm_start`, valid for
+     *  interior and below-but-overlapping starts too) and `growdown` says
+     *  whether it is a MAP_GROWSDOWN VMA (else EINVAL). */
+    bool growDownRegion(Addr start, Addr end, Addr &regionStart,
+                        bool &growdown) const;
+
+    /** Fault-time downward growth of a MAP_GROWSDOWN range: extend it to the
+     *  page of `vaddr` when the gap is free, RLIMIT_STACK/RLIMIT_AS allow it
+     *  and no other mapping is in the way (Linux expand_downwards()).  Denied
+     *  means "this was a stack-growth fault that may not grow": the caller
+     *  turns it into the guest SIGSEGV instead of a page-table fixup. */
+    enum class GrowResult { NotStack, Grown, Denied };
+    GrowResult growDown(Addr vaddr);
+
+    /** Bytes covered by any protection entry (RLIMIT_AS usage). */
+    uint64_t trackedBytes() const;
+    /** Bytes covered by a writable entry (RLIMIT_DATA usage). */
+    uint64_t writableBytes() const;
+
+    /** Would growing the address space by `bytes` stay inside the guest's
+     *  RLIMIT_AS?  (Same arithmetic as QEMU-084t guest_rlimit_exceeds.) */
+    bool asLimitAllows(Addr bytes) const;
+    /** RLIMIT_DATA, including the kernel's cur==0 Valgrind workaround. */
+    bool dataLimitAllows(Addr bytes) const;
+    /** RLIMIT_STACK on a MAP_GROWSDOWN mapping; unlimited until the guest sets
+     *  the limit (the default readback is the mapped stack region). */
+    bool stackLimitAllows(Addr bytes) const;
+
+    /** Fork/exec inheritance: share the map on CLONE_VM, copy it otherwise. */
+    void inheritProtection(const Process *parent, bool share);
+
+    /** Deliver the guest-visible fault of a denied access (SIGSEGV with
+     *  si_code=siCode and si_addr=vaddr); SIG_DFL terminates the guest. */
+    void memoryFault(ThreadContext *tc, Addr vaddr, int siCode);
+
+    /** Live threads of this process, keyed by gem5 context id.  The main
+     *  thread's tid equals pid(); clone(CLONE_THREAD) adds entries and SYS_exit
+     *  of a non-last thread removes one. */
+    std::map<ContextID, ThreadState> threads;
+
+    /** Next tid to hand out to a clone(CLONE_THREAD) child. */
+    int nextThreadTid = 0;
+
+    ThreadState &threadState(ContextID cid) { return threads[cid]; }
+
+    ThreadState *findThread(ContextID cid)
+    {
+        auto it = threads.find(cid);
+        return it == threads.end() ? nullptr : &it->second;
+    }
+
+    /** Live thread with this Linux tid, or nullptr. */
+    ThreadState *findThreadByTid(int tid);
+
+    /** How many threads of this process are still running. */
+    size_t liveThreadCount() const;
+
+    // Multi-process state (GEM5-025t).  fork(2)/clone(2) create a second
+    // Process object whose parentProcess is the caller; wait4(2) reaps it.
+    Process *parentProcess = nullptr;
+    std::vector<Process *> children; // forked, not yet reaped
+    bool hasExited = false;
+    int waitStatus = 0;              // raw Linux wait(2) status
+    bool replacedByExec = false;     // image replaced by execve(2)
+    bool sharesFdTable = false;      // clone(CLONE_FILES)
+
+    // The SE loader and execve(2) build the initial stack/register state here.
+    void initState() override;
+
+    /** One-shot front half: gem5::Process::init() carves the interpreter's
+     *  footprint and applies its load bias, which must happen once even
+     *  though this Process is listed once per thread context. */
+    void init() override;
+
+  protected:
+
+    /** Build argc/argv/envp/auxv on the initial stack (big-endian fields). */
+    template <class IntType>
+    void argsInit(Addr pageSize);
+
+  private:
+    /** Fail closed on anything but a big-endian ET_EXEC with a relocatable
+     *  interpreter (ET_DYN PIE executables are not implemented). */
+    void validateElf();
+
+    /** Register the loaded image's per-page protection from the ELF program
+     *  headers (PT_LOAD p_flags), instead of the pre-030t blanket RWX. */
+    void registerImageProtection(loader::ElfObject *elf);
+
+    /** The SE configuration lists the same Process once per thread context
+     *  (the CPU requires one workload per context), so instantiate() calls
+     *  init()/initState() several times on one object; only the first builds
+     *  the image, the stack and the MemRAS and applies the interpreter bias. */
+    bool initialized = false;
+    bool initialStateBuilt = false;
+
+    /** Exact initial stack pointer (before the VMA page rounding). */
+    Addr initialSp = 0;
+
+    /** Page protection intervals, keyed by page-aligned start.  Shared by
+     *  clone(CLONE_VM) threads, copied by fork (see inheritProtection). */
+    std::shared_ptr<std::map<Addr, ProtRange>> protMap =
+        std::make_shared<std::map<Addr, ProtRange>>();
+
+    /** Direct-mapped cache for the TLB hot path (GEM5-030t): a benchmark
+     *  touches a handful of pages over and over, and a std::map lookup on
+     *  every load/store/fetch is measurable (four llvm-ts cases sit within
+     *  seconds of the 120 s budget).  Any protection change bumps `epoch`
+     *  and invalidates the whole cache. */
+    struct ProtCache
+    {
+        Addr page = ~Addr(0);
+        uint64_t epoch = ~uint64_t(0);
+        uint8_t prot = 0;
+        bool growdown = false;
+        bool tracked = false;
+    };
+    static constexpr unsigned ProtCacheEntries = 16;
+    mutable ProtCache protCache[ProtCacheEntries];
+    mutable uint64_t protEpoch = 0;
+
+    /** Cold half of protectionAt(): map lookup plus cache fill. */
+    bool protectionSlow(Addr vpage, uint8_t &prot, bool &growdown) const;
+
+    void flushProtCache() { ++protEpoch; }
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_PROCESS_HH__
