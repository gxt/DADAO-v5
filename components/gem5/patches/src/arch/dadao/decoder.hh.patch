+// DADAO instruction decoder (B0 skeleton).
+#ifndef __ARCH_DADAO_DECODER_HH__
+#define __ARCH_DADAO_DECODER_HH__
+
+#include "arch/dadao/pcstate.hh"
+#include "arch/dadao/types.hh"
+#include "arch/generic/decode_cache.hh"
+#include "arch/generic/decoder.hh"
+#include "cpu/static_inst.hh"
+#include "params/DadaoDecoder.hh"
+#include "sim/byteswap.hh"
+
+namespace gem5
+{
+namespace DadaoISA
+{
+
+class Decoder : public InstDecoder
+{
+  protected:
+    ExtMachInst emi = 0;
+    static GenericISA::BasicDecodeCache<Decoder, ExtMachInst> defaultCache;
+    friend class GenericISA::BasicDecodeCache<Decoder, ExtMachInst>;
+
+    StaticInstPtr decodeInst(ExtMachInst machInst);
+
+  public:
+    explicit Decoder(const DadaoDecoderParams &p) : InstDecoder(p, &emi) {}
+
+    void
+    moreBytes(const PCStateBase &, Addr) override
+    {
+        // DADAO is big-endian; the fetch buffer was filled with guest bytes.
+        emi = gtoh(emi, ByteOrder::big);
+        instDone = true;
+    }
+
+    StaticInstPtr
+    decode(PCStateBase &nextPC) override
+    {
+        if (!instDone)
+            return nullptr;
+        instDone = false;
+        return defaultCache.decode(this, emi, nextPC.instAddr());
+    }
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_DECODER_HH__
