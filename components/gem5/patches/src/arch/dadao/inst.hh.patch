+// DADAO StaticInst (B0 decode + B1/B2/B3/B4/B5/B6/B7 execution).
+#
+// One instruction class carries the decode result.  Batches B1 (load/store),
+// B2 (16-bit immediate), B3 (64-bit data/address operations), B4 (32/16/8-bit
+// data operations + rev.t/w/b), B5 (block copies, conditional assignment,
+// control flow and the RAS), B6 (swym, cfx system instructions, fence and
+// LR/SC) and B7 (the 55 floating-point ids) execute; every other decoded batch
+// and every illegal encoding returns an explicit fault (unimplemented / ILLI),
+// so there is no silent success.
+#ifndef __ARCH_DADAO_INST_HH__
+#define __ARCH_DADAO_INST_HH__
+
+#include <string>
+
+#include "arch/dadao/decode/decode.hh"
+#include "arch/dadao/pcstate.hh"
+#include "arch/dadao/types.hh"
+#include "cpu/static_inst.hh"
+
+namespace gem5
+{
+namespace DadaoISAInst
+{
+
+class DadaoInst : public StaticInst
+{
+  private:
+    DadaoISA::ExtMachInst word;
+    DadaoISA::decode::DecodedInst decoded;
+
+    std::string generateDisassembly(
+            Addr pc, const loader::SymbolTable *symtab) const override;
+
+  public:
+    explicit DadaoInst(DadaoISA::ExtMachInst word);
+
+    Fault execute(ExecContext *xc, trace::InstRecord *traceData) const override;
+
+    void
+    advancePC(PCStateBase &pc) const override
+    {
+        pc.as<DadaoISA::PCState>().advance();
+    }
+
+    std::unique_ptr<PCStateBase>
+    buildRetPC(const PCStateBase &, const PCStateBase &call) const override
+    {
+        auto result = std::unique_ptr<PCStateBase>(call.clone());
+        result->as<DadaoISA::PCState>().advance();
+        return result;
+    }
+
+    size_t
+    asBytes(void *buf, size_t maxSize) override
+    {
+        return simpleAsBytes(buf, maxSize, word);
+    }
+};
+
+} // namespace DadaoISAInst
+} // namespace gem5
+
+#endif // __ARCH_DADAO_INST_HH__
