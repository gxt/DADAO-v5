+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+namespace
+{
+
+/** The hmon frame is a single hardware frame; this guard stops a runaway
+ *  recursive fault (spec/Kaiwu §4.4; the implementation may stop the
+ *  machine when the handler cannot make progress). */
+constexpr unsigned kMaxDepth = 8;
+
+/** Install a redirect target (`sequentialNext`: see node_cfx.cc -- a fault
+ *  invoked from `BaseSimpleCPU::advancePC()` is not followed by an advance). */
+void
+setPc(ThreadContext *tc, Addr pc, bool sequentialNext = false)
+{
+    PCState target(pc);
+    target.npc(sequentialNext ? pc + 4 : pc);
+    tc->pcState(target);
+}
+
+Addr
+currentPc(ThreadContext *tc)
+{
+    return tc->pcState().instAddr();
+}
+
+/** Exception/interrupt entry clears this hart's LR/SC reservation
+ *  (spec/SimRISC-12 §1「保留机制」): an `sc` after a handler must fail, so the
+ *  reservation is dropped at the one place that actually enters a vector --
+ *  prior to this, a `trap`/fault entry left it live and the following `sc`
+ *  succeeded (ISS-443). */
+void
+clearReservationOnEntry(ThreadContext *tc)
+{
+    if (auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr()))
+        isa->clearReservations();
+}
+
+bool
+inRange(Addr base, Addr size, Addr addr, Addr len)
+{
+    if (len == 0 || addr < base)
+        return false;
+    const Addr off = addr - base;
+    return off < size && len <= size - off;
+}
+
+uint64_t *
+modeReg(TinyCfxMode *m, int cg, int rc)
+{
+    if (rc >= 0 && rc <= 3) {
+        switch (rc) {
+          case 0: return &m->cfxtrap;
+          case 1: return &m->cfxmem;
+          case 2: return &m->cfxreg;
+          default: return &m->cfxexe;
+        }
+    }
+    if (rc == 14)
+        return &m->switchRunMode;
+    if (rc == 15)
+        return &m->excpVector;
+    if (cg == 3 && rc == 12)
+        return &m->cgRegDeleg;
+    return nullptr;
+}
+
+/** cfx2rd/cfx2rc register pointer.  cg7 is handled separately (read-only
+ *  computed table).  nullptr => CFXREG. */
+uint64_t *
+regPtr(TinyState &s, int ci, int cfxha, int cg, int rc, bool write)
+{
+    TinyCfxRegs &r = s.cfx[ci];
+
+    if (cg >= 0 && cg <= 2)
+        return modeReg(&r.mode[cg], cg, rc);
+    if (cg == 3) {
+        // cg3 is the hypv mode register bank; any other run mode => CFXREG
+        // (spec/DADAO-13 §1).  Tiny stays in hypv, but the check is the same
+        // explicit failure as QEMU's cfx_reg_ptr, never a silent success.
+        if ((s.runMode & 0x3) != 3)
+            return nullptr;
+        return modeReg(&r.mode[3], cg, rc);
+    }
+
+    switch (cg) {
+      case 4:
+        if (write)
+            return nullptr;
+        switch (rc) {
+          case 0: return &r.cfxId;
+          case 1: return &r.version;
+          case 2: return &r.trapNum;
+          case 3: return &r.excpSyncNum;
+          case 4: return &r.excpAsyncNum;
+          case 5: return &r.escapeNum;
+          case 6: return &r.scratchRegsNum;
+          default: return nullptr;
+        }
+      case 5:
+        switch (rc) {
+          /* cg5 entry record/cause fields are HW/RO (write => CFXREG);
+           * rc8-rc11 are the export intent (m18-spec-007). */
+          case 0: return write ? nullptr : &r.prevRunMode;
+          case 1: return write ? nullptr : &r.prevCfxCode;
+          case 2: return write ? nullptr : &r.prevIp;
+          case 3: return write ? nullptr : &r.prevIntrMask;
+          case 4: return write ? nullptr : &r.causeId;
+          case 5: return write ? nullptr : &r.causeInfo;
+          case 8: return &r.escapeRunMode;
+          case 9: return &r.escapeCfxCode;
+          case 10: return &r.escapeIp;
+          case 11: return &r.escapeIntrMask;
+          default: return nullptr;
+        }
+      case 6:
+        if (static_cast<uint64_t>(rc) >= r.scratchRegsNum)
+            return nullptr;
+        return &r.scratch[rc];
+      case 8:
+        if (cfxha == TinyCfxhaHmon && rc == 1)
+            return &r.globalCfxIntrMask;
+        // cfx_power's cg8 rc1 (power ctrl) is not modelled by the gem5 Tiny
+        // platform; CFXREG is the explicit failure, never a silent stub.
+        return nullptr;
+      default:
+        return nullptr;
+    }
+}
+
+uint64_t
+cg7Value(const TinyState &s, int ci, int rc)
+{
+    const int block = rc / 4;
+    const int field = rc % 4;
+    if (block != 0)
+        return 0;  // blocks 1..15: exists = 0 => start/size/attr read 0
+
+    const bool hmon = (ci == 1);
+    const Addr base = hmon ? s.hmonBase : s.romBase;
+    const Addr size = hmon ? s.hmonSize : s.romSize;
+    const uint64_t cfxha = hmon ? TinyCfxhaHmon : TinyCfxhaPower;
+    const uint64_t start = static_cast<uint64_t>(base) - (cfxha << 42);
+    // exists (bit0) + SRAM (bit1) / ROM (bit2); attr R/W/X for SRAM, R/X for
+    // the BootROM (spec/DADAO-12 §3.8; block values are test-machine约定).
+    const uint64_t desc = hmon ? 0x3ULL : 0x5ULL;
+    const uint64_t attr = hmon ? 0x7ULL : 0x5ULL;
+
+    switch (field) {
+      case 0: return desc;
+      case 1: return start;
+      case 2: return size;
+      default: return attr;
+    }
+}
+
+uint64_t
+tinyEnter(TinyState &s, uint64_t cause, int target, uint64_t causeIp,
+          uint64_t causeInfo)
+{
+    const uint8_t entryMode = s.runMode;
+    const int ci = tinyCfxIndex(target);
+
+    // contract-see §6.1.1 / ADR-0062 D1/D3: class/wyde pairing and the one-hot
+    // shape are checked before the id reaches the frame (named failure).
+    checkCauseId(cause);
+
+    if (ci < 0)
+        return 0;
+
+    // Step 4: trap / sync counter (Tiny has no async sources).
+    if (cause == TinyCauseCfxTrap)
+        s.cfx[ci].trapNum++;
+    else
+        s.cfx[ci].excpSyncNum++;
+
+    // Step 5: save the entry record (cg5 rc0-rc3) and the cause fields, then
+    // copy rc0-rc3 into the export intent rc8-rc11 (spec/DADAO-12 §3.6/§5.2).
+    // `prevCfxCode` is sampled before step 6 rewrites `cfxCode`; the prev intr
+    // mask is the entry run-mode monitor's `cg8 rc1` snapshot (no such monitor
+    // row on Tiny except hypv/hmon => all ones fail-safe).
+    const int mon = tinyCfxIndex(entryMode & 0x3);
+    const uint64_t prevMask =
+        (mon >= 0) ? s.cfx[mon].globalCfxIntrMask : ~0ULL;
+    TinyCfxRegs &r = s.cfx[ci];
+    r.prevRunMode = entryMode & 0x3;
+    r.prevCfxCode = s.cfxCode & 0x3F;
+    r.prevIp = causeIp;
+    r.prevIntrMask = prevMask;
+    r.causeId = cause;
+    r.causeInfo = causeInfo;
+    r.escapeRunMode = r.prevRunMode;
+    r.escapeCfxCode = r.prevCfxCode;
+    r.escapeIp = r.prevIp;
+    r.escapeIntrMask = r.prevIntrMask;
+
+    // Step 6: the run mode is fixed at hypv on the Tiny profile -- the machine
+    // provides no mode-switch path (spec/Kaiwu §2), so a guest-written
+    // switch_run_mode value cannot leave hypv.  QEMU applies the same
+    // profile-level override (non-user profile => DADAO_MODE_HYPV).
+    // Step 7 value = the target vector.
+    const uint64_t vec = s.cfx[ci].mode[entryMode & 0x3].excpVector;
+    s.runMode = 3;  // hypv (spec/Kaiwu §2; DADAO-13 §1)
+    s.cfxCode = static_cast<uint8_t>(target);
+    return vec;
+}
+
+} // anonymous namespace
+
+int
+tinyCfxIndex(int cfxha)
+{
+    if (cfxha == TinyCfxhaPower)
+        return 0;
+    if (cfxha == TinyCfxhaHmon)
+        return 1;
+    return -1;
+}
+
+bool
+tinyCfxReserved(uint64_t cfxha)
+{
+    return (cfxha >= 6 && cfxha <= 14) || (cfxha >= 16 && cfxha <= 31) ||
+           (cfxha >= 35 && cfxha <= 61);
+}
+
+void
+tinyResetState(TinyState &s, ThreadContext *tc, Addr romBase, Addr romSize,
+               Addr sramBase, Addr sramSize, Addr hmonBase, Addr hmonSize)
+{
+    s = TinyState();
+    s.active = true;
+    s.tc = tc;
+    s.romBase = romBase;
+    s.romSize = romSize;
+    s.sramBase = sramBase;
+    s.sramSize = sramSize;
+    s.hmonBase = hmonBase;
+    s.hmonSize = hmonSize;
+    s.runMode = 3;  // hypv
+    s.cfxCode = TinyCfxhaPower;
+
+    constexpr uint64_t kMaskDefault = 0xFFFFFFFFFFFFFFF7ULL;
+    constexpr uint64_t kMaskHmon = 0x7FFFFFFFFFFFFFF7ULL;
+
+    for (int i = 0; i < 2; ++i) {
+        const uint64_t cfxha = (i == 0) ? TinyCfxhaPower : TinyCfxhaHmon;
+        const uint64_t maskInit = (cfxha == TinyCfxhaHmon)
+            ? kMaskHmon : kMaskDefault;
+        TinyCfxRegs &r = s.cfx[i];
+        for (int m = 0; m < 4; ++m) {
+            TinyCfxMode &mr = r.mode[m];
+            mr.cfxtrap = maskInit;
+            mr.cfxmem = maskInit;
+            mr.cfxreg = maskInit;
+            mr.cfxexe = maskInit;
+            mr.switchRunMode = 3;  // hypv (DADAO-13 §1 cg3)
+            // Platform-defined vector初值 (DADAO-13 §1): the hmon handler is
+            // installed at the hmon SRAM base; the power reset vector is the
+            // BootROM base.  Guest software still writes the hmon vector
+            // explicitly at startup (spec/Kaiwu §4.4).
+            mr.excpVector = (cfxha == TinyCfxhaHmon) ? hmonBase : romBase;
+            mr.cgRegDeleg = (m == 3) ? ~0ULL : 0;
+        }
+        r.globalCfxIntrMask = (cfxha == TinyCfxhaHmon) ? ~0ULL : 0;
+        r.cfxId = cfxha;
+        r.version = 0x00010000ULL;
+        r.scratchRegsNum = 4;
+    }
+}
+
+bool
+tinyPermDenied(const TinyState &s, int target, int kind)
+{
+    const int ci = tinyCfxIndex(target);
+    if (ci < 0)
+        return false;
+    if (target == s.cfxCode)
+        return false;  // self: the cfx axis is bypassed
+    const TinyCfxMode &m = s.cfx[ci].mode[s.runMode & 0x3];
+    uint64_t mask = 0;
+    switch (kind) {
+      case 0: mask = m.cfxtrap; break;
+      case 1: mask = m.cfxmem; break;
+      case 2: mask = m.cfxreg; break;
+      default: mask = m.cfxexe; break;
+    }
+    return (mask & (1ULL << (s.cfxCode & 0x3F))) != 0;
+}
+
+bool
+tinyAddressMapped(const TinyState &s, Addr addr, Addr len)
+{
+    return inRange(s.romBase, s.romSize, addr, len) ||
+           inRange(s.sramBase, s.sramSize, addr, len) ||
+           inRange(s.hmonBase, s.hmonSize, addr, len);
+}
+
+bool
+tinyAccessDenied(const TinyState &s, Addr addr, int kind)
+{
+    int target;
+    if (inRange(s.hmonBase, s.hmonSize, addr, 1))
+        target = TinyCfxhaHmon;
+    else if (inRange(s.romBase, s.romSize, addr, 1) ||
+             inRange(s.sramBase, s.sramSize, addr, 1))
+        target = TinyCfxhaPower;
+    else
+        return false;  // not an implemented segment: CFXMEM, not CFXPERM
+    return tinyPermDenied(s, target, kind);
+}
+
+bool
+tinyCfxRaise(ThreadContext *tc, TinyState &s, uint64_t cause, int target,
+             uint64_t causeIp, uint64_t causeInfo, bool fromFault)
+{
+    if (target < 0)
+        target = TinyCfxhaHmon;
+    if (tinyCfxIndex(target) < 0)
+        return false;
+    if (s.depth >= kMaxDepth)
+        return false;
+
+    const uint64_t vec = tinyEnter(s, cause, target, causeIp, causeInfo);
+    // The vector must live in an implemented segment; otherwise the frame can
+    // never run (spec/Kaiwu §4.4 implementation stop condition).
+    if (!tinyAddressMapped(s, vec, 4))
+        return false;
+
+    s.depth++;
+    // Entering a handler is a clearing event for the LR/SC reservation
+    // (spec/SimRISC-12 §1; ISS-443).
+    clearReservationOnEntry(tc);
+    setPc(tc, vec, fromFault);
+    return true;
+}
+
+void
+tinyTrap(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint32_t immu18)
+{
+    const uint64_t info = (uint64_t(0x7F) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18) |
+                          uint64_t(immu18 & 0x3FFFF);
+    const Addr pc = currentPc(tc);
+
+    // The semihosting tag is short-circuited by DadaoInst::execute() before
+    // this hook; reaching here means an unsupported tag => ILLI.
+    if (immu18 >= 0x3FF00) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyCfxIndex(cfxha) < 0) {
+        // Tiny implements only cfx3/cfx63: every other cfxha is ILLI here
+        // (spec/Kaiwu §3/§4.4), unlike the Vast CFXREG routing.
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyPermDenied(s, cfxha, 0)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, pc);
+        return;
+    }
+    tinyCfxRaise(tc, s, TinyCauseCfxTrap, cfxha, pc, info);
+}
+
+bool
+tinyEscape(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint32_t byteOffset)
+{
+    // `escape cfxHA` has no offset (imms18 is SBZ; B6 rejects non-zero), so
+    // byteOffset is always 0.
+    (void)byteOffset;
+    const uint64_t info = (uint64_t(0x7E) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18);
+    const Addr pc = currentPc(tc);
+
+    // Step 0 (DADAO-12 §5.1): reserved cfx => ILLI (a monitor route on Tiny,
+    // so `-1` names hmon) before any state change.
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return true;
+    }
+    // `cfxha` must be the current cfx; otherwise the current cfx's CFXESC.
+    if (cfxha != s.cfxCode) {
+        tinyCfxRaise(tc, s, TinyCauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+    const int ci = tinyCfxIndex(s.cfxCode);
+    if (ci < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+
+    // Export intent is the only return source; every rejection is before the
+    // mode/cfx/mask/PC switch.
+    const TinyCfxRegs &r = s.cfx[ci];
+    const unsigned targetMode = r.escapeRunMode & 0x3;
+    const unsigned targetCfx = r.escapeCfxCode & 0x3F;
+    // Privilege escalation (target above current) => CFXESC.
+    if (targetMode > (s.runMode & 0x3)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+    // The target cfx must be implemented and the target mode must have a
+    // monitor.  Tiny only implements power/hmon and only the hypv monitor, so
+    // any other target fails closed here (spec/Kaiwu §2/§7.1).
+    const int mon = tinyCfxIndex(targetMode);
+    if (tinyCfxIndex(targetCfx) < 0 || mon < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+
+    const Addr ret = static_cast<Addr>(r.escapeIp) & ~0x3ULL;
+    const uint64_t retMask = r.escapeIntrMask;
+
+    s.runMode = targetMode;
+    s.cfxCode = static_cast<uint8_t>(targetCfx);
+    s.cfx[ci].escapeNum++;
+    s.cfx[mon].globalCfxIntrMask = retMask;   // one word, atomic with the jump
+    if (s.depth > 0)
+        s.depth--;
+    setPc(tc, ret);
+    return true;
+}
+
+bool
+tinyCfxRead(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint8_t cg,
+            uint8_t rc, uint64_t &out, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return false;
+    }
+    const int ci = tinyCfxIndex(cfxha);
+    if (ci < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (tinyPermDenied(s, cfxha, 2)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, pc);
+        return false;
+    }
+    if (cg == 7) {
+        out = cg7Value(s, ci, rc & 0x3F);
+        return true;
+    }
+    if (cg > 8) {
+        // cg8 carries the monitor async-intr-mask row (and, for other cfx,
+        // no row: regPtr returns nullptr); cg9+ do not exist on Tiny.
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    uint64_t *p = regPtr(s, ci, cfxha, cg, rc, false);
+    if (p == nullptr) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    out = *p;
+    return true;
+}
+
+bool
+tinyCfxWrite(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint8_t cg,
+             uint8_t rc, uint64_t val, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return false;
+    }
+    const int ci = tinyCfxIndex(cfxha);
+    if (ci < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (tinyPermDenied(s, cfxha, 2)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, pc);
+        return false;
+    }
+    if (cg == 7 || cg > 8) {
+        // cg7 is read-only; cg9+ do not exist (spec/DADAO-12 §3.8).
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    uint64_t *p = regPtr(s, ci, cfxha, cg, rc, true);
+    if (p == nullptr) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (cg == 3 && rc == 14) {
+        // Kaiwu §2: on the Tiny profile a switch_run_mode write is
+        // ignored -- the saved value stays 3 (hypv) and a read returns the
+        // saved value (it is not a "constant 3" read-only register).  The
+        // write itself succeeds, so no fault is raised.
+        return true;
+    }
+    if (cg == 3 && rc == 15) {
+        // DADAO-13 §1: hypv_excp_vector writes ignore the low two bits
+        // (value[1:0] <- 0, 4-byte aligned), with no fault.
+        *p = val & ~0x3ULL;
+    } else if (cg == 3 && rc == 12) {
+        *p = val | (1ULL << 3);  // DADAO-13 §1: bit3 reads back as 1
+    } else if (cg <= 3 && rc == 14) {
+        *p = val & 0x3ULL;
+    } else if (cg <= 3 && rc == 15) {
+        *p = val & ~0x3ULL;
+    } else if (cg == 5 && rc == 8) {
+        *p = val & 0x3ULL;
+    } else if (cg == 5 && rc == 9) {
+        *p = val & 0x3FULL;
+    } else if (cg == 5 && rc == 10) {
+        *p = val & ~0x3ULL;
+    } else {
+        *p = val;
+    }
+    return true;
+}
+
