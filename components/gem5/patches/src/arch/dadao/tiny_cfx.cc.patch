+// DADAO Tiny machine model: cfx_power (cfx63) + cfx3 hmon.
+#include "arch/dadao/tiny_cfx.hh"
+
+#include "arch/dadao/pcstate.hh"
+#include "cpu/thread_context.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+namespace
+{
+
+/** The hmon frame is a single hardware frame; this guard stops a runaway
+ *  recursive fault (spec/Machine-v5 §4.4; the implementation may stop the
+ *  machine when the handler cannot make progress). */
+constexpr unsigned kMaxDepth = 8;
+
+void
+setPc(ThreadContext *tc, Addr pc)
+{
+    PCState target(pc);
+    target.npc(pc);
+    tc->pcState(target);
+}
+
+Addr
+currentPc(ThreadContext *tc)
+{
+    return tc->pcState().instAddr();
+}
+
+bool
+inRange(Addr base, Addr size, Addr addr, Addr len)
+{
+    if (len == 0 || addr < base)
+        return false;
+    const Addr off = addr - base;
+    return off < size && len <= size - off;
+}
+
+int
+monitorIndex(uint8_t runMode)
+{
+    // Tiny is always hypv; its monitor is cfx3 (spec/Machine-v5 §2/§4.4).
+    (void)runMode;
+    return tinyCfxIndex(TinyCfxhaHmon);
+}
+
+uint64_t *
+modeReg(TinyCfxMode *m, int cg, int rc)
+{
+    if (rc >= 0 && rc <= 4) {
+        switch (rc) {
+          case 0: return &m->cfxtrap;
+          case 1: return &m->cfxmem;
+          case 2: return &m->cfxreg;
+          case 3: return &m->cfxexe;
+          default: return &m->cfxIntrMask;
+        }
+    }
+    if (rc == 8)
+        return &m->switchRunMode;
+    if (rc == 10)
+        return &m->excpVector;
+    if (cg == 3 && rc == 12)
+        return &m->cgRegDeleg;
+    return nullptr;
+}
+
+/** cfx2rd/cfx2rc register pointer.  cg7 is handled separately (read-only
+ *  computed table).  nullptr => CFXREG. */
+uint64_t *
+regPtr(TinyState &s, int ci, int cfxha, int cg, int rc, bool write)
+{
+    TinyCfxRegs &r = s.cfx[ci];
+
+    if (cg >= 0 && cg <= 2)
+        return modeReg(&r.mode[cg], cg, rc);
+    if (cg == 3)
+        return modeReg(&r.mode[3], cg, rc);
+
+    switch (cg) {
+      case 4:
+        if (write)
+            return nullptr;
+        switch (rc) {
+          case 0: return &r.cfxId;
+          case 1: return &r.version;
+          case 2: return &r.trapNum;
+          case 3: return &r.excpSyncNum;
+          case 4: return &r.excpAsyncNum;
+          case 5: return &r.escapeNum;
+          case 6: return &r.scratchRegsNum;
+          default: return nullptr;
+        }
+      case 5:
+        switch (rc) {
+          case 0: return &r.prevRunMode;
+          case 2: return write ? nullptr : &r.causeId;
+          case 3: return &r.causeIp;
+          case 4: return write ? nullptr : &r.causeInfo;
+          case 5: return &r.pending;
+          default: return nullptr;
+        }
+      case 6:
+        if (static_cast<uint64_t>(rc) >= r.scratchRegsNum)
+            return nullptr;
+        return &r.scratch[rc];
+      case 8:
+        if (cfxha == TinyCfxhaHmon && rc == 1)
+            return &r.globalCfxIntrMask;
+        // cfx_power's cg8 rc1 (power ctrl) is not modelled by the gem5 Tiny
+        // platform; CFXREG is the explicit failure, never a silent stub.
+        return nullptr;
+      default:
+        return nullptr;
+    }
+}
+
+uint64_t
+cg7Value(const TinyState &s, int ci, int rc)
+{
+    const int block = rc / 4;
+    const int field = rc % 4;
+    if (block != 0)
+        return 0;  // blocks 1..15: exists = 0 => start/size/attr read 0
+
+    const bool hmon = (ci == 1);
+    const Addr base = hmon ? s.hmonBase : s.romBase;
+    const Addr size = hmon ? s.hmonSize : s.romSize;
+    const uint64_t cfxha = hmon ? TinyCfxhaHmon : TinyCfxhaPower;
+    const uint64_t start = static_cast<uint64_t>(base) - (cfxha << 42);
+    // exists (bit0) + SRAM (bit1) / ROM (bit2); attr R/W/X for SRAM, R/X for
+    // the BootROM (spec/DADAO-12 §3.8; block values are test-machine约定).
+    const uint64_t desc = hmon ? 0x3ULL : 0x5ULL;
+    const uint64_t attr = hmon ? 0x7ULL : 0x5ULL;
+
+    switch (field) {
+      case 0: return desc;
+      case 1: return start;
+      case 2: return size;
+      default: return attr;
+    }
+}
+
+uint64_t
+tinyEnter(TinyState &s, uint64_t cause, int target, uint64_t causeIp,
+          uint64_t causeInfo)
+{
+    const uint8_t entryMode = s.runMode;
+    const int ci = tinyCfxIndex(target);
+
+    if (ci < 0)
+        return 0;
+
+    // Step 4: trap / sync counter (Tiny has no async sources).
+    if (cause == TinyCauseCfxTrap)
+        s.cfx[ci].trapNum++;
+    else
+        s.cfx[ci].excpSyncNum++;
+
+    // Step 5: save the frame and, for a trap, the monitor's global mask.
+    s.cfx[ci].prevRunMode = entryMode;
+    s.cfx[ci].causeIp = causeIp;
+    s.cfx[ci].causeId = cause;
+    s.cfx[ci].causeInfo = causeInfo;
+    if (cause == TinyCauseCfxTrap) {
+        const int mon = monitorIndex(entryMode);
+        s.cfx[ci].savedIntrMonitor = static_cast<uint64_t>(mon);
+        s.cfx[ci].savedIntrValid = true;
+        if (mon >= 0) {
+            s.cfx[ci].savedGlobalIntrMask = s.cfx[mon].globalCfxIntrMask;
+            s.cfx[mon].globalCfxIntrMask = ~0ULL;
+        }
+    }
+
+    // Step 6: switch mode/cfx; step 7 value = the target vector.
+    const uint64_t vec = s.cfx[ci].mode[entryMode & 0x3].excpVector;
+    s.runMode = s.cfx[ci].mode[entryMode & 0x3].switchRunMode & 0x3;
+    s.cfxCode = static_cast<uint8_t>(target);
+    return vec;
+}
+
+} // anonymous namespace
+
+int
+tinyCfxIndex(int cfxha)
+{
+    if (cfxha == TinyCfxhaPower)
+        return 0;
+    if (cfxha == TinyCfxhaHmon)
+        return 1;
+    return -1;
+}
+
+bool
+tinyCfxReserved(uint64_t cfxha)
+{
+    return (cfxha >= 6 && cfxha <= 14) || (cfxha >= 16 && cfxha <= 31) ||
+           (cfxha >= 35 && cfxha <= 61);
+}
+
+void
+tinyResetState(TinyState &s, ThreadContext *tc, Addr romBase, Addr romSize,
+               Addr sramBase, Addr sramSize, Addr hmonBase, Addr hmonSize)
+{
+    s = TinyState();
+    s.active = true;
+    s.tc = tc;
+    s.romBase = romBase;
+    s.romSize = romSize;
+    s.sramBase = sramBase;
+    s.sramSize = sramSize;
+    s.hmonBase = hmonBase;
+    s.hmonSize = hmonSize;
+    s.runMode = 3;  // hypv
+    s.cfxCode = TinyCfxhaPower;
+
+    constexpr uint64_t kMaskDefault = 0xFFFFFFFFFFFFFFF7ULL;
+    constexpr uint64_t kMaskHmon = 0x7FFFFFFFFFFFFFF7ULL;
+
+    for (int i = 0; i < 2; ++i) {
+        const uint64_t cfxha = (i == 0) ? TinyCfxhaPower : TinyCfxhaHmon;
+        const uint64_t maskInit = (cfxha == TinyCfxhaHmon)
+            ? kMaskHmon : kMaskDefault;
+        TinyCfxRegs &r = s.cfx[i];
+        for (int m = 0; m < 4; ++m) {
+            TinyCfxMode &mr = r.mode[m];
+            mr.cfxtrap = maskInit;
+            mr.cfxmem = maskInit;
+            mr.cfxreg = maskInit;
+            mr.cfxexe = maskInit;
+            mr.cfxIntrMask = ~0ULL;
+            mr.switchRunMode = 3;  // hypv (DADAO-13 §1 cg3)
+            // Platform-defined vector初值 (DADAO-13 §1): the hmon handler is
+            // installed at the hmon SRAM base; the power reset vector is the
+            // BootROM base.  Guest software still writes the hmon vector
+            // explicitly at startup (spec/Machine-v5 §4.4).
+            mr.excpVector = (cfxha == TinyCfxhaHmon) ? hmonBase : romBase;
+            mr.cgRegDeleg = (m == 3) ? ~0ULL : 0;
+        }
+        r.globalCfxIntrMask = (cfxha == TinyCfxhaHmon) ? ~0ULL : 0;
+        r.cfxId = cfxha;
+        r.version = 0x00010000ULL;
+        r.scratchRegsNum = 4;
+    }
+}
+
+bool
+tinyPermDenied(const TinyState &s, int target, int kind)
+{
+    const int ci = tinyCfxIndex(target);
+    if (ci < 0)
+        return false;
+    if (target == s.cfxCode)
+        return false;  // self: the cfx axis is bypassed
+    const TinyCfxMode &m = s.cfx[ci].mode[s.runMode & 0x3];
+    uint64_t mask = 0;
+    switch (kind) {
+      case 0: mask = m.cfxtrap; break;
+      case 1: mask = m.cfxmem; break;
+      case 2: mask = m.cfxreg; break;
+      default: mask = m.cfxexe; break;
+    }
+    return (mask & (1ULL << (s.cfxCode & 0x3F))) != 0;
+}
+
+bool
+tinyAddressMapped(const TinyState &s, Addr addr, Addr len)
+{
+    return inRange(s.romBase, s.romSize, addr, len) ||
+           inRange(s.sramBase, s.sramSize, addr, len) ||
+           inRange(s.hmonBase, s.hmonSize, addr, len);
+}
+
+bool
+tinyAccessDenied(const TinyState &s, Addr addr, int kind)
+{
+    int target;
+    if (inRange(s.hmonBase, s.hmonSize, addr, 1))
+        target = TinyCfxhaHmon;
+    else if (inRange(s.romBase, s.romSize, addr, 1) ||
+             inRange(s.sramBase, s.sramSize, addr, 1))
+        target = TinyCfxhaPower;
+    else
+        return false;  // not an implemented segment: CFXMEM, not CFXPERM
+    return tinyPermDenied(s, target, kind);
+}
+
+bool
+tinyCfxRaise(ThreadContext *tc, TinyState &s, uint64_t cause, int target,
+             uint64_t causeIp, uint64_t causeInfo)
+{
+    if (target < 0)
+        target = TinyCfxhaHmon;
+    if (tinyCfxIndex(target) < 0)
+        return false;
+    if (s.depth >= kMaxDepth)
+        return false;
+
+    const uint64_t vec = tinyEnter(s, cause, target, causeIp, causeInfo);
+    // The vector must live in an implemented segment; otherwise the frame can
+    // never run (spec/Machine-v5 §4.4 implementation stop condition).
+    if (!tinyAddressMapped(s, vec, 4))
+        return false;
+
+    s.depth++;
+    setPc(tc, vec);
+    return true;
+}
+
+void
+tinyTrap(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint32_t immu18)
+{
+    const uint64_t info = (uint64_t(0x7F) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18) |
+                          uint64_t(immu18 & 0x3FFFF);
+    const Addr pc = currentPc(tc);
+
+    // The semihosting tag is short-circuited by DadaoInst::execute() before
+    // this hook; reaching here means an unsupported tag => ILLI.
+    if (immu18 >= 0x3FF00) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyCfxIndex(cfxha) < 0) {
+        // Tiny implements only cfx3/cfx63: every other cfxha is ILLI here
+        // (spec/Machine-v5 §3/§4.4), unlike the Vast CFXREG routing.
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return;
+    }
+    if (tinyPermDenied(s, cfxha, 0)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, info);
+        return;
+    }
+    tinyCfxRaise(tc, s, TinyCauseCfxTrap, cfxha, pc, info);
+}
+
+bool
+tinyEscape(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint32_t byteOffset)
+{
+    const uint64_t info = (uint64_t(0x7E) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18) |
+                          uint64_t((byteOffset >> 2) & 0x3FFFF);
+    const Addr pc = currentPc(tc);
+
+    if (byteOffset != 0 && byteOffset != 4) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return true;
+    }
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return true;
+    }
+    const int ci = tinyCfxIndex(s.cfxCode);
+    if (ci < 0 || cfxha != s.cfxCode || s.cfx[ci].causeId == 0) {
+        // Frame/target error: CFXESC enters the current cfx, before any state
+        // switch (spec/DADAO-12 §5.3 step 0).
+        tinyCfxRaise(tc, s, TinyCauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+
+    // Step 1: restore the monitor global mask saved by `trap` (a plain
+    // synchronous fault saved nothing; spec/DADAO-12 §5.3).
+    if (s.cfx[ci].savedIntrValid) {
+        const int mon = static_cast<int>(s.cfx[ci].savedIntrMonitor);
+        if (mon >= 0 && mon < 2)
+            s.cfx[mon].globalCfxIntrMask = s.cfx[ci].savedGlobalIntrMask;
+        s.cfx[ci].savedIntrValid = false;
+    }
+    // Step 2: restore the previous run mode.
+    s.runMode = s.cfx[ci].prevRunMode & 0x3;
+    // Step 3/4: count the escape and return to cause_ip + offset.
+    s.cfx[ci].escapeNum++;
+    if (s.depth > 0)
+        s.depth--;
+    const Addr ret = static_cast<Addr>(s.cfx[ci].causeIp) + byteOffset;
+    setPc(tc, ret);
+    return true;
+}
+
+bool
+tinyCfxRead(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint8_t cg,
+            uint8_t rc, uint64_t &out, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return false;
+    }
+    const int ci = tinyCfxIndex(cfxha);
+    if (ci < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (tinyPermDenied(s, cfxha, 2)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, info);
+        return false;
+    }
+    if (cg == 7) {
+        out = cg7Value(s, ci, rc & 0x3F);
+        return true;
+    }
+    if (cg > 7) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    uint64_t *p = regPtr(s, ci, cfxha, cg, rc, false);
+    if (p == nullptr) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    out = *p;
+    return true;
+}
+
+bool
+tinyCfxWrite(ThreadContext *tc, TinyState &s, uint8_t cfxha, uint8_t cg,
+             uint8_t rc, uint64_t val, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (tinyCfxReserved(cfxha)) {
+        tinyCfxRaise(tc, s, TinyCauseIlli, -1, pc, info);
+        return false;
+    }
+    const int ci = tinyCfxIndex(cfxha);
+    if (ci < 0) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (tinyPermDenied(s, cfxha, 2)) {
+        tinyCfxRaise(tc, s, TinyCauseCfxPerm, -1, pc, info);
+        return false;
+    }
+    if (cg == 7 || cg > 8) {
+        // cg7 is read-only; cg9+ do not exist (spec/DADAO-12 §3.8).
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    uint64_t *p = regPtr(s, ci, cfxha, cg, rc, true);
+    if (p == nullptr) {
+        tinyCfxRaise(tc, s, TinyCauseCfxReg, -1, pc, info);
+        return false;
+    }
+    if (cg == 3 && rc == 12)
+        *p = val | (1ULL << 3);  // DADAO-13 §1: bit3 reads back as 1
+    else
+        *p = val;
+    return true;
+}
+
+} // namespace DadaoISA
+} // namespace gem5
