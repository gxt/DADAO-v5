+#ifndef __ARCH_DADAO_FAULTS_HH__
+#define __ARCH_DADAO_FAULTS_HH__
+
+#include "arch/dadao/isa.hh"
+#include "cpu/thread_context.hh"
+#include "sim/faults.hh"
+#include "sim/sim_exit.hh"
+
+namespace gem5::DadaoISA
+{
+// Machine-01 converts unhandled precise faults into process exit codes.
+class MachineFault : public FaultBase
+{
+  private:
+    const FaultName faultName;
+    const int exitCode;
+    const RegVal cause;
+    const RegVal causeInfo;
+    const int targetCfx;
+
+  public:
+    MachineFault(FaultName name, int code, RegVal cause_id=0,
+                 RegVal cause_info=0, int target=-1)
+        : faultName(name), exitCode(code),
+          cause(cause_id ? cause_id :
+                ((code >= 0x81 && code <= 0x86) ||
+                 (code >= 0x88 && code <= 0x8d)) ?
+                    (RegVal(1) << (code & 0x7f)) : 0),
+          causeInfo(cause_info), targetCfx(target)
+    {}
+    FaultName name() const override { return faultName; }
+    void
+    invoke(ThreadContext *tc, const StaticInstPtr &) override
+    {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        if (cause && isa &&
+            isa->enterFault(tc, cause, tc->pcState().instAddr(),
+                            causeInfo, targetCfx)) {
+            return;
+        }
+        exitSimLoopNow(faultName, exitCode);
+    }
+};
+}
+
+#endif
