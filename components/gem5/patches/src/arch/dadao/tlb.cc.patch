+// DADAO SE TLB -- direct pass-through translation plus the permission shadow.
+#include "arch/dadao/tlb.hh"
+
+#include <memory>
+
+#include "arch/dadao/process.hh"
+#include "base/logging.hh"
+#include "cpu/thread_context.hh"
+#include "mem/page_table.hh"
+#include "sim/faults.hh"
+#include "sim/process.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+void
+AccessFault::invoke(ThreadContext *tc, const StaticInstPtr &inst)
+{
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    fatal_if(process == nullptr,
+             "DADAO SE: access fault on a non-DADAO process");
+    // SEGV_ACCERR (asm-generic): the mapping exists but the protection does
+    // not allow this access.  The Linux page-fault path reports the same code.
+    process->memoryFault(tc, vaddr, 2);
+}
+
+void
+PageFault::invoke(ThreadContext *tc, const StaticInstPtr &inst)
+{
+    auto *process = dynamic_cast<DadaoISA::Process *>(tc->getProcessPtr());
+    fatal_if(process == nullptr,
+             "DADAO SE: page fault on a non-DADAO process");
+    // SEGV_MAPERR (asm-generic): nothing is mapped at this address.  QEMU's
+    // linux-user forwards the same fault; the guest either handles it or dies
+    // of SIGSEGV.  The simulator keeps running (the guest's parent sees the
+    // child's death exactly as it would under Linux).
+    process->memoryFault(tc, vaddr, 1);
+}
+
+Fault
+TLB::translate(const RequestPtr &req, ThreadContext *tc, BaseMMU::Mode mode,
+               bool guestAccess)
+{
+    // The DADAO SE TLB is only ever attached to a DADAO SE process; a
+    // dynamic_cast here would run on every memory access.
+    auto *process = static_cast<Process *>(tc->getProcessPtr());
+
+    if (guestAccess) {
+        uint8_t prot = 0;
+        bool growdown = false;
+        if (process->protectionAt(req->getVaddr(), prot, growdown)) {
+            const uint8_t needed = mode == BaseMMU::Write
+                ? Process::ProtWrite
+                : (mode == BaseMMU::Execute ? Process::ProtExec
+                                            : Process::ProtRead);
+            if ((prot & needed) == 0)
+                return std::make_shared<AccessFault>(req->getVaddr());
+        }
+    }
+
+    Addr paddr;
+    if (!process->pTable->translate(req->getVaddr(), paddr)) {
+        // A MAP_GROWSDOWN mapping grows downwards on the fault that touches
+        // the page below it (Linux expand_downwards).  The grown page is still
+        // lazy: fixupFault() below allocates it.  A refused growth
+        // (RLIMIT_STACK/AS, or a mapping in the gap) is the guest's SIGSEGV,
+        // not an emulator abort.
+        if (guestAccess && mode != BaseMMU::Execute &&
+            process->growDown(req->getVaddr()) ==
+                Process::GrowResult::Denied)
+            return std::make_shared<AccessFault>(req->getVaddr());
+        // A page of an existing VMA (data, stack, heap, mmap) that has no
+        // frame yet is a lazy allocation, not a guest fault: bring it in and
+        // retry the translation.  Doing this here (instead of through
+        // GenericPageTableFault::invoke) keeps the "mapping exists" and
+        // "guest really strayed" cases apart, so the latter can be delivered
+        // to the guest as SIGSEGV instead of panicking the simulator.
+        if (guestAccess && process->fixupFault(req->getVaddr()) &&
+            process->pTable->translate(req->getVaddr(), paddr)) {
+            req->setPaddr(paddr);
+            return NoFault;
+        }
+        // Nothing is mapped at this address: the guest's own fault, exactly
+        // as QEMU forwards it.  The functional path (syscall copies) has no
+        // guest PC to signal; its caller turns the fault into EFAULT.
+        if (guestAccess)
+            return std::make_shared<PageFault>(req->getVaddr());
+        return std::make_shared<GenericPageTableFault>(req->getVaddr());
+    }
+
+    req->setPaddr(paddr);
+    return NoFault;
+}
+
+void
+TLB::demapPage(Addr vaddr, uint64_t asn)
+{
+    // SE has no TLB entries to invalidate: the host page table is the truth.
+}
+
+Fault
+TLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
+                     BaseMMU::Mode mode)
+{
+    return translate(req, tc, mode, true);
+}
+
+void
+TLB::translateTiming(const RequestPtr &req, ThreadContext *tc,
+                     BaseMMU::Translation *translation, BaseMMU::Mode mode)
+{
+    translation->finish(translate(req, tc, mode, true), req, tc, mode);
+}
+
+Fault
+TLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
+                         BaseMMU::Mode mode)
+{
+    // Used by SETranslatingPortProxy: the same host page table lookup, minus
+    // the request/translation bookkeeping and minus the protection check --
+    // the syscall layer must see a failed copy (EFAULT), not a guest signal.
+    return translate(req, tc, mode, false);
+}
+
+Fault
+TLB::finalizePhysical(const RequestPtr &req, ThreadContext *tc,
+                      BaseMMU::Mode mode) const
+{
+    return NoFault;
+}
+
+} // namespace DadaoISA
+} // namespace gem5
