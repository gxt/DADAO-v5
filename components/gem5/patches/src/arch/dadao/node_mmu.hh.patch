+// DADAO Node MMU: instruction/data TLB pair over the PTW identity map.
+//
+// A separate SimObject from the SE DADAOMMU and the Tiny FsMMU: the TLBs are
+// DadaoNodeTlb (guest TLB + page-table walk), and functional probes (the
+// semihosting pointer proxy) use 64 KiB pages.
+#ifndef __ARCH_DADAO_NODE_MMU_HH__
+#define __ARCH_DADAO_NODE_MMU_HH__
+
+#include "arch/dadao/page_size.hh"
+#include "arch/generic/mmu.hh"
+#include "params/DadaoNodeMMU.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+class NodeMMU : public BaseMMU
+{
+  public:
+    using Params = DadaoNodeMMUParams;
+
+    explicit NodeMMU(const Params &p) : BaseMMU(p) {}
+
+    TranslationGenPtr
+    translateFunctional(Addr start, Addr size, ThreadContext *tc, Mode mode,
+                        Request::Flags flags) override
+    {
+        return TranslationGenPtr(new MMUTranslationGen(
+                PageBytes, start, size, tc, this, mode, flags));
+    }
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_NODE_MMU_HH__
