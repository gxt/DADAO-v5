+// DADAO FS workload: boot image loading and reset for the two FS machines.
+//
+// profile="tiny" (Machine-v5-Tiny): 64 KiB BootROM + 8 MiB SRAM, raw images
+// carry a 0x100-byte zero prefix, ELF images bring their own BootROM crt.
+// profile="node" (Machine-v5-Node): 4 MiB BootROM (exact size) + 2 GiB PA RAM,
+// raw images load at kernel_base with no prefix, ELF PT_LOAD segments must be
+// in PA RAM, and the reset PC is the BootROM reset vector.
+//
+// Loading is fail-closed: every malformed image is a fatal error naming the
+// file/segment/field, never a silent relocation or truncation.
+#ifndef __ARCH_DADAO_FS_WORKLOAD_HH__
+#define __ARCH_DADAO_FS_WORKLOAD_HH__
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/loader/object_file.hh"
+#include "base/loader/symtab.hh"
+#include "enums/ByteOrder.hh"
+#include "params/DadaoFsWorkload.hh"
+#include "sim/workload.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+class FsWorkload : public Workload
+{
+  public:
+    using Params = DadaoFsWorkloadParams;
+
+    explicit FsWorkload(const Params &p);
+    ~FsWorkload() override;
+
+    void initState() override;
+
+    loader::Arch getArch() const override { return loader::Dadao; }
+    ByteOrder byteOrder() const override { return ByteOrder::big; }
+
+    Addr getEntry() const override { return entry; }
+
+    const loader::SymbolTable &
+    symtab(ThreadContext *tc) override
+    {
+        return symbols;
+    }
+
+    bool
+    insertSymbol(const loader::Symbol &symbol) override
+    {
+        return symbols.insert(symbol);
+    }
+
+    SimObject *getSemihosting() const override { return semihosting; }
+
+    bool nodeProfile() const { return isNode; }
+    Addr resetPc() const { return p_reset_pc; }
+    Addr romBase() const { return p_rom_base; }
+    Addr romSize() const { return p_rom_size; }
+    Addr sramBase() const { return p_sram_base; }
+    Addr sramSize() const { return p_sram_size; }
+    Addr hmonBase() const { return p_hmon_base; }
+    Addr hmonSize() const { return p_hmon_size; }
+    Addr ramBase() const { return p_ram_base; }
+    Addr ramSize() const { return p_ram_size; }
+    Addr pmemBase() const { return p_pmem_base; }
+    Addr kernelBase() const { return p_kernel_base; }
+    Addr kernelReserved() const { return p_kernel_reserved; }
+    const std::string &traceCpuPath() const { return traceCpu; }
+
+  private:
+    const std::string profileName;
+    const bool isNode;
+
+    const Addr p_rom_base;
+    const Addr p_rom_size;
+    const Addr p_sram_base;
+    const Addr p_sram_size;
+    const Addr p_hmon_base;
+    const Addr p_hmon_size;
+    const Addr p_ram_base;
+    const Addr p_ram_size;
+    const Addr p_pmem_base;
+    const Addr p_kernel_base;
+    const Addr p_kernel_reserved;
+    const Addr p_reset_pc;
+
+    const std::string kernelPath;
+    const std::string traceCpu;
+    loader::ObjectFile *kernelObj = nullptr;
+    loader::SymbolTable symbols;
+
+    std::vector<uint8_t> romData;
+    std::vector<uint8_t> rawData;
+    Addr entry = 0;
+    bool isElf = false;
+    SimObject *semihosting = nullptr;
+
+    bool inRange(Addr base, Addr size, Addr addr, Addr len) const;
+    bool inSegment(Addr addr, Addr len) const;
+    void loadBootrom(const std::string &path);
+    void validateElf(const std::vector<uint8_t> &file);
+    void loadRaw(const std::vector<uint8_t> &file);
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_FS_WORKLOAD_HH__
