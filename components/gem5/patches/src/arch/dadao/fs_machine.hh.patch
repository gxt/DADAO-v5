@@ -0,0 +1,187 @@
+// DADAO FS machine fault model.
+//
+// Tiny carries cfx3 hmon: a synchronous exception enters the hmon vector with
+// the architectural frame (spec/Kaiwu §4.4).  The exit code below is the
+// fallback used when the handler cannot run (unmapped vector, nesting guard)
+// and the code reported by the §7.1 segments.  The exit-code segment is chosen
+// by the fault destination:
+//
+//   0x80-0xBF  other cfx: bit7=1, bit6=0, bit5:0 = cfxHA
+//   0xC0-0xFF  monitor:  bit7=1, bit6=1, bit5:4 = run mode,
+//                        bit3:0 = DADAO exception bit index
+//
+// The monitor segment is NOT "0x80 | bit index"; the current run mode is part
+// of the code.  `CFXTRAP`/`CFXESC` that enter the target/current cfx use the
+// other-cfx segment, never the monitor segment.  The SE platform keeps its own
+// panic-based behaviour; the helpers below decide from the *workload type*,
+// never from a global switch.
+#ifndef __ARCH_DADAO_FS_MACHINE_HH__
+#define __ARCH_DADAO_FS_MACHINE_HH__
+
+#include <cstdint>
+#include <string>
+
+#include "sim/faults.hh"
+
+namespace gem5
+{
+
+class ThreadContext;
+
+namespace DadaoISA
+{
+
+class FsWorkload;
+
+/** DADAO exception bit indices (spec/DADAO-12 §5.2(二)). */
+enum MachineFaultCause : uint8_t
+{
+    FaultCfxTrap = 0,
+    FaultCfxMem  = 1,
+    FaultCfxReg  = 2,
+    FaultCfxEsc  = 3,
+    FaultCfxPerm = 7,
+    FaultIlli    = 8,
+    FaultUndi    = 9,
+    FaultRasof   = 10,
+    FaultRasuf   = 11,
+    FaultMalign  = 12,
+    FaultIalign  = 13,
+
+    // Call-site spellings kept from the old exit-code enum.
+    FaultCFXMEM = FaultCfxMem,
+    FaultCFXREG = FaultCfxReg,
+    FaultILLI   = FaultIlli,
+    FaultUNDI   = FaultUndi,
+    FaultRASOF  = FaultRasof,
+    FaultRASUF  = FaultRasuf,
+    FaultMALIGN = FaultMalign,
+    FaultIALIGN = FaultIalign,
+};
+
+/** Flat cause bitmap `[63:32]` (spec/DADAO-12 §3.6 cg5; contract-see §6.1.1;
+ *  ADR-0062 D1-D3).  `[38:32]` is the permission bitmap and `[56:48]` the
+ *  memory/missing bitmap; a page-table fault sets exactly one of those bits
+ *  and leaves `[15:0]` zero.  `CFXPERM`/`CFXMEM` mean cfx source-mask denial
+ *  and non-PTW internal access only, so they carry no high bit at all.
+ *  `[39]`, `[47:40]`, `[57]` and `[63:58]` stay reserved (zero). */
+enum CauseSub : uint64_t
+{
+    // `[38:32]`: permission bitmap (PTW HSJU / R-W-X denial).
+    SubNuPerm   = 1ULL << 32,  // HSJU `U` clear, running in user
+    SubNjPerm   = 1ULL << 33,  // HSJU `J` clear, running in jail
+    SubNsPerm   = 1ULL << 34,  // HSJU `S` clear, running in supv
+    SubNhPerm   = 1ULL << 35,  // HSJU `H` clear, running in hypv
+    SubNrPerm   = 1ULL << 36,  // read of a page without `R`
+    SubNwPerm   = 1ULL << 37,  // write of a page without `W`
+    SubNxPerm   = 1ULL << 38,  // fetch of a page without `X`
+
+    // `[56:48]`: memory/missing bitmap (PTW page/fragment + A/D write-back).
+    SubIgpTrap  = 1ULL << 48,  // fetch: L1 P=0,SP=0 or L2 P=0
+    SubIspTrap  = 1ULL << 49,  // fetch: L1 P=0, SP=1
+    SubIgpfTrap = 1ULL << 50,  // fetch: small-page (GPF) fragment missing
+    SubIspfTrap = 1ULL << 51,  // fetch: superpage (SPF) fragment missing
+    SubDgpTrap  = 1ULL << 52,  // data: L1 P=0,SP=0 or L2 P=0
+    SubDspTrap  = 1ULL << 53,  // data: L1 P=0, SP=1
+    SubDgpfTrap = 1ULL << 54,  // data: small-page (GPF) fragment missing
+    SubDspfTrap = 1ULL << 55,  // data: superpage (SPF) fragment missing
+    SubAdwbFail = 1ULL << 56,  // A/D write-back to a PTE failed
+};
+
+constexpr uint64_t CauseReserved16 = 0xFFFFULL << 16; // `[31:16]` future classes
+// `[39]`, `[47:40]`, `[57]`, `[63:58]`: deleted / reserved, always zero.
+constexpr uint64_t CauseReservedHigh =
+    (0xFFULL << 40) | (1ULL << 39) | (1ULL << 57) | (0x3FULL << 58);
+
+/** Check the shape of an `excp_cause_id` value before it reaches the frame
+ *  (contract-see §6.1.1; ADR-0062 D1): the 64-bit value is either zero or has
+ *  exactly one bit set, and every reserved bit is zero.  That single rule
+ *  subsumes the old class/wyde pairing: a low cause cannot be combined with a
+ *  bitmap bit and a bitmap bit cannot be combined with another.  A raise site
+ *  that gets it wrong stops the run with a named failure instead of handing
+ *  the kernel an ambiguous id (cold path: once per exception entry). */
+void checkCauseId(uint64_t causeId);
+
+/** Exit code for a machine fault (spec/Kaiwu §7.1).  `targetCfxha < 0`
+ *  means the fault belongs to the current run-mode monitor. */
+constexpr uint8_t
+machineFaultExitCode(uint8_t cause, uint8_t runMode, int targetCfxha)
+{
+    if (targetCfxha >= 0)
+        return static_cast<uint8_t>(0x80 | (targetCfxha & 0x3F));
+    return static_cast<uint8_t>(0xC0 | ((runMode & 0x3) << 4) | (cause & 0xF));
+}
+
+// spec/Kaiwu §7.1 formula self-checks (compile-time, never silent).
+static_assert(machineFaultExitCode(FaultCfxTrap, 3, 7) == 0x87,
+              "other-cfx segment: cfxHA 7");
+static_assert(machineFaultExitCode(FaultCfxTrap, 3, 63) == 0xBF,
+              "other-cfx segment: cfxHA 63");
+static_assert(machineFaultExitCode(FaultCfxMem, 2, -1) == 0xE1,
+              "monitor: supv CFXMEM");
+static_assert(machineFaultExitCode(FaultIlli, 3, -1) == 0xF8,
+              "monitor: hypv ILLI");
+static_assert(machineFaultExitCode(FaultIalign, 0, -1) == 0xCD,
+              "monitor: user IALIGN");
+
+const char *machineFaultName(uint8_t cause);
+
+/** The FS workload of this thread context, or nullptr for SE / no workload. */
+FsWorkload *asFsWorkload(ThreadContext *tc);
+
+/** True iff *tc* belongs to the DADAO FS machine (SE is false). */
+bool isFsMachine(ThreadContext *tc);
+
+/** Machine fault that stops the simulation with the §7.1 exit code (first
+ *  fault wins).  `targetCfxha < 0` selects the current run-mode monitor.
+ *  `causeIp`/`causeInfo` are the architectural frame fields handed to the
+ *  Tiny hmon vector; 0 for causeIp means "the current instruction address". */
+class MachineFault : public FaultBase
+{
+  private:
+    uint8_t cause;
+    uint64_t causeSub;
+    int targetCfxha;
+    Addr causeIp;
+    uint64_t causeInfo;
+
+  public:
+    explicit MachineFault(uint8_t cause, int targetCfxha = -1,
+                          Addr causeIp = 0, uint64_t causeInfo = 0,
+                          uint64_t causeSub = 0) :
+        cause(cause), causeSub(causeSub), targetCfxha(targetCfxha),
+        causeIp(causeIp), causeInfo(causeInfo)
+    {}
+
+    FaultName name() const override { return machineFaultName(cause); }
+
+    void invoke(ThreadContext *tc, const StaticInstPtr &inst) override;
+
+    uint8_t causeIndex() const { return cause; }
+};
+
+Fault machineFault(uint8_t cause);
+
+/** Machine fault carrying the architectural cause_ip/cause_info and, for a
+ *  page-table fault, one bit of the flat `excp_cause_id` bitmap (ADR-0062
+ *  D1/D3; contract-see §6.1.1). */
+Fault machineFaultAt(uint8_t cause, Addr causeIp, uint64_t causeInfo,
+                     uint64_t causeSub = 0);
+
+/** Machine fault whose exit code belongs to the other-cfx segment
+ *  (`0x80 | cfxHA`).  Current QEMU/gem5 machines route CFXTRAP/CFXESC into
+ *  vectors, so there is no call site yet; this is the explicit other-cfx form
+ *  of the spec/Kaiwu §7.1 mapping (never the monitor segment). */
+Fault machineFaultToCfx(uint8_t cause, uint8_t cfxha);
+
+/** Stop the simulation with the spec/Kaiwu §7.1 code for `cause` (bit index)
+ *  raised in `runMode`; `targetCfxha < 0` selects the monitor segment.  This
+ *  is the "the exception vector cannot be entered" stop itself (no second
+ *  attempt to deliver), used by the Node machine once the monitor vector is
+ *  known to be unreachable. */
+void machineFaultExit(uint8_t cause, uint8_t runMode, int targetCfxha);
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_FS_MACHINE_HH__
