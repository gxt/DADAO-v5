+const char *
+instructionName(unsigned op)
+{
+    switch (op) {
+      case 0x10: return "ld.ub";
+      case 0x11: return "ld.uw";
+      case 0x12: return "ld.ut";
+      case 0x13: return "ld.sb";
+      case 0x14: return "ld.sw";
+      case 0x15: return "ld.st";
+      case 0x18: return "st.b";
+      case 0x19: return "st.w";
+      case 0x1a: return "st.t";
+      case 0x20: case 0x22: case 0x24: return "ld.o";
+      case 0x21: case 0x23: case 0x25: return "st.o";
+      case 0x28: return "ldm.ub";
+      case 0x29: return "ldm.uw";
+      case 0x2a: return "ldm.ut";
+      case 0x2b: return "ldm.sb";
+      case 0x2c: return "ldm.sw";
+      case 0x2d: return "ldm.st";
+      case 0x30: return "stm.b";
+      case 0x31: return "stm.w";
+      case 0x32: return "stm.t";
+      case 0x38: case 0x3a: case 0x3c: return "ldm.o";
+      case 0x39: case 0x3b: case 0x3d: return "stm.o";
+      case 0x40: return "misc";
+      case 0x41: return "misc.t";
+      case 0x42: return "misc.w";
+      case 0x43: return "misc.b";
+      case 0x48: return "or.w";
+      case 0x49: return "andn.w";
+      case 0x4a: return "or.w";
+      case 0x4b: return "andn.w";
+      case 0x4c: return "set.zw";
+      case 0x4d: return "set.ow";
+      case 0x4e: return "set.zw";
+      case 0x50: return "add.uo";
+      case 0x51: return "add.so";
+      case 0x52: return "sub.uo";
+      case 0x53: return "sub.so";
+      case 0x54: return "mul.uo";
+      case 0x55: return "mul.so";
+      case 0x59: case 0x5b: return "add.si";
+      case 0x5c: return "cmp.ui";
+      case 0x5d: return "cmp.si";
+      case 0x60: return "cs.n";
+      case 0x62: return "cs.z";
+      case 0x64: return "cs.p";
+      case 0x66: return "cs.eq";
+      case 0x67: return "cs.ne";
+      case 0x68: return "br.n";
+      case 0x69: return "br.nn";
+      case 0x6a: case 0x72: return "br.z";
+      case 0x6b: case 0x73: return "br.nz";
+      case 0x6c: return "br.p";
+      case 0x6d: return "br.np";
+      case 0x6e: return "br.eq";
+      case 0x6f: return "br.ne";
+      case 0x70: case 0x71: return "jump";
+      case 0x74: case 0x75: return "call";
+      case 0x76: return "ret";
+      case 0x77: return "swym";
+      default: return "unknown";
+    }
+}
+}
+
+DadaoInst::DadaoInst(DadaoISA::ExtMachInst w)
+    : StaticInst(instructionName(w >> 24), IntAluOp),
+      word(w)
+{
+    size(4);
+    flags[IsInteger] = true;
+    if ((w >> 24) >= 0x10 && (w >> 24) <= 0x3d) {
+        const unsigned op = w >> 24;
+        flags[IsLoad] = (op >= 0x10 && op <= 0x15) ||
+                        op == 0x20 || op == 0x22 || op == 0x24 ||
+                        (op >= 0x28 && op <= 0x2d) ||
+                        op == 0x38 || op == 0x3a || op == 0x3c;
+        flags[IsStore] = (op >= 0x18 && op <= 0x1a) ||
+                         op == 0x21 || op == 0x23 || op == 0x25 ||
+                         (op >= 0x30 && op <= 0x32) ||
+                         op == 0x39 || op == 0x3b || op == 0x3d;
+    }
+    if (instructionName(w >> 24) == std::string("unknown")) {
+        flags[IsInvalid] = true;
+        flags[IsNonSpeculative] = true;
+    }
+}
+
+std::string
+DadaoInst::generateDisassembly(Addr, const loader::SymbolTable *) const
+{
+    return csprintf("%s 0x%08x", mnemonic, word);
+}
+
+void
+DadaoInst::advancePC(ThreadContext *tc) const
+{
+    const auto old_pc = tc->pcState().as<DadaoISA::PCState>();
+    StaticInst::advancePC(tc);
+    const auto rb0 = DadaoISA::intRegClass[DadaoISA::int_reg::RbBase];
+    if (!old_pc.explicitBranch())
+        tc->setReg(rb0, tc->getReg(rb0) + 4);
+
+    auto next_pc = tc->pcState().as<DadaoISA::PCState>();
+    next_pc.pc(next_pc.pc() & 0xffffffffffffULL);
+    next_pc.npc(next_pc.npc() & 0xffffffffffffULL);
+    next_pc.explicitBranch(false);
+    tc->pcState(next_pc);
+}
+
+Fault
+DadaoInst::execute(ExecContext *xc, trace::InstRecord *) const
+{
+    const unsigned op = word >> 24;
+    const unsigned ha = (word >> 18) & 63;
+    auto *tc = xc->tcBase();
+    auto rd = [tc](unsigned i) {
+        return tc->getReg(DadaoISA::intRegClass[DadaoISA::int_reg::RdBase + i]);
+    };
+    auto set_rd = [tc](unsigned i, uint64_t value) {
+        if (i)
+            tc->setReg(DadaoISA::intRegClass[DadaoISA::int_reg::RdBase + i],
+                    value);
+    };
+    auto rb = [tc](unsigned i) {
+        return tc->getReg(DadaoISA::intRegClass[DadaoISA::int_reg::RbBase + i]);
+    };
+    auto set_rb = [tc](unsigned i, uint64_t value) {
+        if (i)
+            tc->setReg(DadaoISA::intRegClass[DadaoISA::int_reg::RbBase + i],
+                    value);
+    };
+    auto ra = [tc](unsigned i) {
+        return tc->getReg(DadaoISA::intRegClass[DadaoISA::int_reg::RaBase + i]);
+    };
+    auto set_ra = [tc](unsigned i, uint64_t value) {
+        if (i == 0)
+            value &= 0x003fffffffffffffULL;
+        tc->setReg(DadaoISA::intRegClass[DadaoISA::int_reg::RaBase + i],
+                value);
+    };
+    auto branch = [tc](uint64_t target) {
+        tc->setReg(DadaoISA::intRegClass[DadaoISA::int_reg::RbBase], target);
+        auto pc = tc->pcState().as<DadaoISA::PCState>();
+        pc.npc(target & 0xffffffffffffULL);
+        pc.explicitBranch(true);
+        tc->pcState(pc);
+    };
+    const bool single_mem = (op >= 0x10 && op <= 0x15) ||
+                            (op >= 0x18 && op <= 0x1a) ||
+                            (op >= 0x20 && op <= 0x25);
+    const bool block_mem = (op >= 0x28 && op <= 0x2d) ||
+                           (op >= 0x30 && op <= 0x32) ||
+                           (op >= 0x38 && op <= 0x3d);
+    if (single_mem || block_mem) {
+        const unsigned hb = (word >> 12) & 63;
+        const bool load = (op >= 0x10 && op <= 0x15) ||
+                          op == 0x20 || op == 0x22 || op == 0x24 ||
+                          (op >= 0x28 && op <= 0x2d) ||
+                          op == 0x38 || op == 0x3a || op == 0x3c;
+        const bool rd_bank = op <= 0x21 ||
+                             (op >= 0x28 && op <= 0x32) ||
+                             op == 0x38 || op == 0x39;
+        const bool rb_bank = op == 0x22 || op == 0x23 ||
+                             op == 0x3a || op == 0x3b;
+        const unsigned size =
+            (op == 0x10 || op == 0x13 || op == 0x18 ||
+             op == 0x28 || op == 0x2b || op == 0x30) ? 1 :
+            (op == 0x11 || op == 0x14 || op == 0x19 ||
+             op == 0x29 || op == 0x2c || op == 0x31) ? 2 :
+            (op == 0x12 || op == 0x15 || op == 0x1a ||
+             op == 0x2a || op == 0x2d || op == 0x32) ? 4 : 8;
+        const bool sign_extend = op == 0x13 || op == 0x14 || op == 0x15 ||
+                                 op == 0x2b || op == 0x2c || op == 0x2d;
+        const unsigned count = block_mem ? (word & 63) : 1;
+        if ((load && ((rd_bank || rb_bank) && ha == 0)) ||
+            (block_mem && (count == 0 || ha + count > 64)))
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const int64_t imms12 = static_cast<int32_t>(word << 20) >> 20;
+        const unsigned hc = (word >> 6) & 63;
+        const uint64_t offset = block_mem ? rd(hc) : uint64_t(imms12);
+        const Addr address = (rb(hb) + offset) & 0xffffffffffffULL;
+        if (address & (size - 1))
+            return std::make_shared<DadaoISA::MachineFault>("MALIGN", 0x8c);
+        auto reg_id = [rd_bank, rb_bank](unsigned index) {
+            return DadaoISA::intRegClass[
+                (rd_bank ? DadaoISA::int_reg::RdBase :
+                 rb_bank ? DadaoISA::int_reg::RbBase :
+                           DadaoISA::int_reg::RaBase) + index];
+        };
+        std::vector<uint64_t> values(count);
+        static const Request::Flags flags{};
+        if (load) {
+            for (unsigned i = 0; i < count; ++i) {
+                uint8_t bytes[8] = {};
+                const std::vector<bool> enabled(size, true);
+                const Addr current =
+                        (address + i * size) & 0xffffffffffffULL;
+                Fault fault = xc->readMem(current, bytes, size,
+                                          flags, enabled);
+                if (fault != NoFault)
+                    return fault;
+                uint64_t value = 0;
+                for (unsigned j = 0; j < size; ++j)
+                    value = (value << 8) | bytes[j];
+                if (sign_extend && size < 8 &&
+                    (value & (1ULL << (size * 8 - 1))))
+                    value |= ~0ULL << (size * 8);
+                values[i] = value;
+            }
+            for (unsigned i = 0; i < count; ++i) {
+                uint64_t value = values[i];
+                if (!rd_bank && !rb_bank && ha + i == 0)
+                    value &= 0x003fffffffffffffULL;
+                tc->setReg(reg_id(ha + i), value);
+            }
+        } else {
+            std::vector<std::array<uint8_t, 8>> old_values;
+            if (block_mem) {
+                old_values.resize(count);
+                for (unsigned i = 0; i < count; ++i) {
+                    const Addr current =
+                            (address + i * size) & 0xffffffffffffULL;
+                    const std::vector<bool> enabled(size, true);
+                    Fault fault = xc->readMem(
+                            current, old_values[i].data(), size, flags,
+                            enabled);
+                    if (fault != NoFault)
+                        return fault;
+                }
+            }
+            for (unsigned i = 0; i < count; ++i) {
+                uint64_t value = tc->getReg(reg_id(ha + i));
+                uint8_t bytes[8] = {};
+                for (unsigned j = 0; j < size; ++j)
+                    bytes[size - j - 1] = value >> (j * 8);
+                const std::vector<bool> enabled(size, true);
+                const Addr current =
+                        (address + i * size) & 0xffffffffffffULL;
+                Fault fault = xc->writeMem(bytes, size, current, flags,
+                                           nullptr, enabled);
+                if (fault != NoFault) {
+                    for (unsigned j = 0; j < i; ++j) {
+                        const Addr rollback_addr =
+                                (address + j * size) & 0xffffffffffffULL;
+                        Fault rollback = xc->writeMem(
+                                old_values[j].data(), size, rollback_addr,
+                                flags, nullptr, enabled);
+                        panic_if(rollback != NoFault,
+                                "DADAO block-store rollback failed");
+                    }
+                    return fault;
+                }
+            }
+        }
+    } else if (op >= 0x68 && op <= 0x73) {
+        const unsigned hb = (word >> 12) & 63;
+        const int64_t imms18 = static_cast<int32_t>(word << 14) >> 14;
+        const int64_t imms12 = static_cast<int32_t>(word << 20) >> 20;
+        const int64_t imms24 = static_cast<int32_t>(word << 8) >> 8;
+        bool taken = false;
+        int64_t offset = imms18;
+        switch (op) {
+          case 0x68: taken = static_cast<int64_t>(rd(ha)) < 0; break;
+          case 0x69: taken = static_cast<int64_t>(rd(ha)) >= 0; break;
+          case 0x6a: taken = rd(ha) == 0; break;
+          case 0x6b: taken = rd(ha) != 0; break;
+          case 0x6c: taken = static_cast<int64_t>(rd(ha)) > 0; break;
+          case 0x6d: taken = static_cast<int64_t>(rd(ha)) <= 0; break;
+          case 0x6e: taken = rd(ha) == rd(hb); offset = imms12; break;
+          case 0x6f: taken = rd(ha) != rd(hb); offset = imms12; break;
+          case 0x70: taken = true; offset = imms24; break;
+          case 0x71:
+            taken = true;
+            branch(rb(ha) + rd(hb) + (uint64_t(imms12) << 2));
+            break;
+          case 0x72: taken = rb(ha) == 0; break;
+          case 0x73: taken = rb(ha) != 0; break;
+        }
+        if (taken && op != 0x71)
+            branch(rb(0) + (uint64_t(offset) << 2));
+    } else if (op == 0x74 || op == 0x75) {
+        const unsigned hb = (word >> 12) & 63;
+        const int64_t imms12 = static_cast<int32_t>(word << 20) >> 20;
+        const int64_t imms24 = static_cast<int32_t>(word << 8) >> 8;
+        const uint64_t ras = ra(0);
+        const unsigned racnt = (ras >> 48) & 0x3f;
+        const Addr mrptr = ras & 0xffffffffffffULL;
+        const uint64_t return_addr =
+                (tc->pcState().instAddr() + 4) & 0xffffffffffffULL;
+        const uint64_t entry = (1ULL << 48) | return_addr;
+        const uint64_t top = ra(63);
+
+        if (racnt && (top & 0xffffffffffffULL) == return_addr &&
+            (top >> 48) != 0xffff) {
+            set_ra(63, top + (1ULL << 48));
+        } else if (racnt < 63) {
+            const unsigned first = 64 - racnt;
+            for (unsigned i = first; i < 64; ++i)
+                set_ra(i - 1, ra(i));
+            set_ra(63, entry);
+            set_ra(0, (uint64_t(racnt + 1) << 48) | mrptr);
+        } else {
+            if (!mrptr)
+                return std::make_shared<DadaoISA::MachineFault>(
+                        "RASOF", 0x8a);
+            const Addr spill_addr = (mrptr - 8) & 0xffffffffffffULL;
+            uint8_t bytes[8] = {};
+            const uint64_t oldest = ra(1);
+            for (unsigned i = 0; i < 8; ++i)
+                bytes[7 - i] = oldest >> (i * 8);
+            static const Request::Flags flags{};
+            const std::vector<bool> enabled(8, true);
+            Fault fault = xc->writeMem(bytes, 8, spill_addr, flags, nullptr,
+                                       enabled);
+            if (fault != NoFault)
+                return fault;
+            for (unsigned i = 2; i < 64; ++i)
+                set_ra(i - 1, ra(i));
+            set_ra(63, entry);
+            set_ra(0, (uint64_t(63) << 48) | spill_addr);
+        }
+
+        if (op == 0x74)
+            branch(rb(0) + (uint64_t(imms24) << 2));
+        else
+            branch(rb(ha) + rd(hb) + (uint64_t(imms12) << 2));
+    } else if (op == 0x76) {
+        const int64_t imms18 = static_cast<int32_t>(word << 14) >> 14;
+        if (ha == 0 && imms18 != 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+
+        const uint64_t ras = ra(0);
+        const unsigned racnt = (ras >> 48) & 0x3f;
+        const Addr mrptr = ras & 0xffffffffffffULL;
+        uint64_t return_entry;
+        if (racnt) {
+            return_entry = ra(63);
+            const unsigned repeats = return_entry >> 48;
+            if (!repeats)
+                return std::make_shared<DadaoISA::MachineFault>(
+                        "RASUF", 0x8b);
+            if (repeats > 1) {
+                set_ra(63, return_entry - (1ULL << 48));
+            } else {
+                const unsigned first = 64 - racnt;
+                for (unsigned i = 62; i >= first; --i)
+                    set_ra(i + 1, ra(i));
+                set_ra(0, (uint64_t(racnt - 1) << 48) | mrptr);
+            }
+        } else {
+            if (!mrptr)
+                return std::make_shared<DadaoISA::MachineFault>(
+                        "RASUF", 0x8b);
+            uint8_t bytes[8] = {};
+            static const Request::Flags flags{};
+            const std::vector<bool> enabled(8, true);
+            Fault fault = xc->readMem(mrptr, bytes, 8, flags, enabled);
+            if (fault != NoFault)
+                return fault;
+            return_entry = 0;
+            for (unsigned i = 0; i < 8; ++i)
+                return_entry = (return_entry << 8) | bytes[i];
+            const unsigned repeats = return_entry >> 48;
+            if (!repeats)
+                return std::make_shared<DadaoISA::MachineFault>(
+                        "RASUF", 0x8b);
+            if (repeats > 1) {
+                set_ra(63, return_entry - (1ULL << 48));
+                set_ra(0, (1ULL << 48) |
+                        ((mrptr + 8) & 0xffffffffffffULL));
+            } else {
+                set_ra(0, (mrptr + 8) & 0xffffffffffffULL);
+            }
+        }
+        set_rd(ha, static_cast<uint64_t>(imms18));
+        branch(return_entry & 0xffffffffffffULL);
+    } else if (op >= 0x41 && op <= 0x43 &&
+               (ha == 0x12 || ha == 0x13 || ha == 0x14 ||
+                ha == 0x1a || ha == 0x1b || ha == 0x1c ||
+                ha == 0x20 || ha == 0x21 || ha == 0x28 ||
+                ha == 0x29 || ha == 0x2a || ha == 0x2b ||
+                ha == 0x30 || ha == 0x31 || ha == 0x38 ||
+                ha == 0x39 || ha == 0x3a || ha == 0x3b)) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const unsigned width = op == 0x41 ? 32 : op == 0x42 ? 16 : 8;
+        const uint64_t mask = (1ULL << width) - 1;
+        auto signed_value = [width, mask](uint64_t value) {
+            value &= mask;
+            if (value & (1ULL << (width - 1)))
+                value |= ~mask;
+            return static_cast<int64_t>(value);
+        };
+        const bool signed_op = ha & 1;
+        const uint64_t lhs = rd(hc) & mask;
+        const uint64_t rhs = rd(hd) & mask;
+        uint64_t result = 0;
+        if (ha >= 0x12 && ha <= 0x1c) {
+            const bool immediate = ha >= 0x1a;
+            const unsigned amount = immediate ? hd : (rd(hd) & 63);
+            if (amount >= width)
+                return std::make_shared<DadaoISA::MachineFault>(
+                        "ILLI", 0x88);
+            if (ha == 0x12 || ha == 0x1a)
+                result = lhs >> amount;
+            else if (ha == 0x13 || ha == 0x1b)
+                result = static_cast<uint64_t>(
+                        signed_value(lhs) >> amount);
+            else
+                result = lhs << amount;
+        } else if (ha == 0x20 || ha == 0x21) {
+            result = signed_op ? signed_value(lhs) + signed_value(rhs) :
+                                lhs + rhs;
+        } else if (ha == 0x28 || ha == 0x29) {
+            result = signed_op ? signed_value(lhs) - signed_value(rhs) :
+                                lhs - rhs;
+        } else if (ha == 0x2a || ha == 0x2b) {
+            if (signed_op)
+                result = (signed_value(lhs) > signed_value(rhs)) -
+                         (signed_value(lhs) < signed_value(rhs));
+            else
+                result = (lhs > rhs) - (lhs < rhs);
+        } else if (ha == 0x30 || ha == 0x31) {
+            result = signed_op ? signed_value(lhs) * signed_value(rhs) :
+                                lhs * rhs;
+        } else if (!rhs) {
+            result = (ha == 0x38 || ha == 0x39) ? mask : lhs;
+        } else if (signed_op) {
+            const int64_t signed_lhs = signed_value(lhs);
+            const int64_t signed_rhs = signed_value(rhs);
+            const int64_t minimum = -(1LL << (width - 1));
+            if (signed_lhs == minimum && signed_rhs == -1)
+                result = (ha == 0x39) ? lhs : 0;
+            else if (ha == 0x39)
+                result = signed_lhs / signed_rhs;
+            else
+                result = signed_lhs % signed_rhs;
+        } else if (ha == 0x38) {
+            result = lhs / rhs;
+        } else {
+            result = lhs % rhs;
+        }
+        result &= mask;
+        if (signed_op && (result & (1ULL << (width - 1))))
+            result |= ~mask;
+        set_rd(hb, result);
+    } else if (op == 0x40 && ha >= 0x08 && ha <= 0x0b) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        uint64_t result = 0;
+        if (ha == 0x08)
+            result = rd(hc) & rd(hd);
+        else if (ha == 0x09)
+            result = rd(hc) | rd(hd);
+        else if (ha == 0x0a)
+            result = rd(hc) ^ rd(hd);
+        else
+            result = ~(rd(hc) ^ rd(hd));
+        set_rd(hb, result);
+    } else if (op == 0x40 && ha >= 0x10 && ha <= 0x1c) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const bool immediate = ha >= 0x18;
+        const unsigned kind = ha - (immediate ? 0x18 : 0x10);
+        if (kind > 4)
+            return std::make_shared<DadaoISA::MachineFault>("UNDI", 0x89);
+        const unsigned amount = immediate ? hd : (rd(hd) & 63);
+        const uint64_t source = rd(hc);
+        uint64_t result = 0;
+        if (kind == 0 || kind == 1) {
+            const uint64_t mask = amount == 63 ? ~0ULL :
+                                  (1ULL << (amount + 1)) - 1;
+            result = source & mask;
+            if (kind == 1 && amount != 63 &&
+                (source & (1ULL << amount)))
+                result |= ~mask;
+        } else if (kind == 2) {
+            result = source >> amount;
+        } else if (kind == 3) {
+            result = static_cast<uint64_t>(
+                    static_cast<int64_t>(source) >> amount);
+        } else {
+            result = source << amount;
+        }
+        set_rd(hb, result);
+    } else if (op == 0x40 && (ha == 0x2a || ha == 0x2b)) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        int result;
+        if (ha == 0x2a)
+            result = (rd(hc) > rd(hd)) - (rd(hc) < rd(hd));
+        else
+            result = (static_cast<int64_t>(rd(hc)) >
+                      static_cast<int64_t>(rd(hd))) -
+                     (static_cast<int64_t>(rd(hc)) <
+                      static_cast<int64_t>(rd(hd)));
+        set_rd(hb, static_cast<uint64_t>(result));
+    } else if (op == 0x40 &&
+               ((ha >= 0x2c && ha <= 0x2e) ||
+                (ha >= 0x34 && ha <= 0x36))) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned count = word & 63;
+        const bool dst_rd = ha == 0x2c || ha == 0x2e || ha == 0x36;
+        const bool dst_rb = ha == 0x34 || ha == 0x35;
+        const bool src_rd = ha == 0x2c || ha == 0x2d || ha == 0x35;
+        const bool src_rb = ha == 0x34 || ha == 0x36;
+        const bool same_bank = ha == 0x2c || ha == 0x34;
+        const bool overlap = hb < hc + count && hc < hb + count;
+        if (count == 0 || hb + count > 64 || hc + count > 64 ||
+            ((dst_rd || dst_rb) && hb == 0) ||
+            (same_bank && overlap))
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        std::vector<uint64_t> values(count);
+        for (unsigned i = 0; i < count; ++i)
+            values[i] = src_rd ? rd(hc + i) :
+                        src_rb ? rb(hc + i) : ra(hc + i);
+        for (unsigned i = 0; i < count; ++i) {
+            if (dst_rd)
+                set_rd(hb + i, values[i]);
+            else if (dst_rb)
+                set_rb(hb + i, values[i]);
+            else
+                set_ra(hb + i, values[i]);
+        }
+    } else if (op == 0x40 && ha >= 0x30 && ha <= 0x32) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        if (ha == 0x30)
+            set_rb(hb, rb(hc) + rd(hd));
+        else if (ha == 0x31)
+            set_rb(hb, rb(hc) - rd(hd));
+        else
+            set_rd(hb, static_cast<uint64_t>(
+                    (rb(hc) > rb(hd)) - (rb(hc) < rb(hd))));
+    } else if (op == 0x40 && ha >= 0x38 && ha <= 0x3b) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if (hb == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const uint64_t lhs = rd(hc), rhs = rd(hd);
+        uint64_t result;
+        if (ha == 0x38)
+            result = rhs ? lhs / rhs : ~0ULL;
+        else if (ha == 0x3a)
+            result = rhs ? lhs % rhs : lhs;
+        else {
+            const int64_t signed_lhs = static_cast<int64_t>(lhs);
+            const int64_t signed_rhs = static_cast<int64_t>(rhs);
+            if (signed_rhs == 0)
+                result = ha == 0x39 ? ~0ULL : lhs;
+            else if (signed_lhs == INT64_MIN && signed_rhs == -1)
+                result = ha == 0x39 ? lhs : 0;
+            else if (ha == 0x39)
+                result = static_cast<uint64_t>(signed_lhs / signed_rhs);
+            else
+                result = static_cast<uint64_t>(signed_lhs % signed_rhs);
+        }
+        set_rd(hb, result);
+    } else if ((op >= 0x48 && op <= 0x4e) && op != 0x4f) {
+        if (ha == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const uint64_t value = uint64_t(word & 0xffff) <<
+                               (16 * ((word >> 16) & 3));
+        const uint64_t lane_mask = 0xffffULL <<
+                                   (16 * ((word >> 16) & 3));
+        uint64_t result = 0;
+        switch (op) {
+          case 0x48: result = rd(ha) | value; break;
+          case 0x49: result = rd(ha) & ~value; break;
+          case 0x4a: result = rb(ha) | value; break;
+          case 0x4b: result = rb(ha) & ~value; break;
+          case 0x4c: result = value; break;
+          case 0x4d: result = ~lane_mask | value; break;
+          case 0x4e: result = value; break;
+          default: break;
+        }
+        if (op == 0x4a || op == 0x4b || op == 0x4e)
+            set_rb(ha, result);
+        else
+            set_rd(ha, result);
+    } else if (op == 0x5c || op == 0x5d) {
+        if (ha == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const unsigned hb = (word >> 12) & 63;
+        const uint64_t immu12 = word & 0xfff;
+        const int64_t imms12 = static_cast<int32_t>(word << 20) >> 20;
+        int cmp;
+        if (op == 0x5c)
+            cmp = (rd(hb) > immu12) - (rd(hb) < immu12);
+        else
+            cmp = (static_cast<int64_t>(rd(hb)) > imms12) -
+                  (static_cast<int64_t>(rd(hb)) < imms12);
+        set_rd(ha, static_cast<uint64_t>(cmp));
+    } else if (op == 0x59 || op == 0x5b) {
+        if (ha == 0)
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const int64_t imm = static_cast<int32_t>(word << 14) >> 14;
+        const auto id = DadaoISA::intRegClass[
+                (op == 0x59 ? DadaoISA::int_reg::RdBase :
+                 DadaoISA::int_reg::RbBase) + ha];
+        tc->setReg(id, tc->getReg(id) + imm);
+    } else if (op >= 0x50 && op <= 0x55) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if ((ha == 0 && hb == 0) || (ha == hb && ha != 0))
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        const uint64_t lhs = rd(hc), rhs = rd(hd);
+        uint64_t high = 0;
+        uint64_t low = 0;
+        if (op == 0x50) {
+            low = lhs + rhs;
+            high = low < lhs;
+        } else if (op == 0x51) {
+            const __int128 result = static_cast<__int128>(
+                    static_cast<int64_t>(lhs)) +
+                    static_cast<int64_t>(rhs);
+            low = static_cast<uint64_t>(result);
+            high = static_cast<uint64_t>(
+                    static_cast<unsigned __int128>(result) >> 64);
+        } else if (op == 0x52) {
+            low = lhs - rhs;
+            high = lhs < rhs;
+        } else if (op == 0x53) {
+            const __int128 result = static_cast<__int128>(
+                    static_cast<int64_t>(lhs)) -
+                    static_cast<int64_t>(rhs);
+            low = static_cast<uint64_t>(result);
+            high = static_cast<uint64_t>(
+                    static_cast<unsigned __int128>(result) >> 64);
+        } else if (op == 0x54) {
+            const unsigned __int128 result =
+                    static_cast<unsigned __int128>(lhs) * rhs;
+            low = static_cast<uint64_t>(result);
+            high = static_cast<uint64_t>(result >> 64);
+        } else {
+            const __int128 result = static_cast<__int128>(
+                    static_cast<int64_t>(lhs)) *
+                    static_cast<int64_t>(rhs);
+            low = static_cast<uint64_t>(result);
+            high = static_cast<uint64_t>(
+                    static_cast<unsigned __int128>(result) >> 64);
+        }
+        set_rd(ha, high);
+        set_rd(hb, low);
+    } else if (op == 0x60 || op == 0x62 || op == 0x64 ||
+               op == 0x66 || op == 0x67) {
+        const unsigned hb = (word >> 12) & 63;
+        const unsigned hc = (word >> 6) & 63;
+        const unsigned hd = word & 63;
+        if ((op <= 0x64 && hb == 0) || (op >= 0x66 && hc == 0))
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        if (op == 0x60)
+            set_rd(hb, static_cast<int64_t>(rd(ha)) < 0 ? rd(hc) : rd(hd));
+        else if (op == 0x62)
+            set_rd(hb, rd(ha) == 0 ? rd(hc) : rd(hd));
+        else if (op == 0x64)
+            set_rd(hb, static_cast<int64_t>(rd(ha)) > 0 ? rd(hc) : rd(hd));
+        else if ((op == 0x66 && rd(ha) == rd(hb)) ||
+                 (op == 0x67 && rd(ha) != rd(hb)))
+            set_rd(hc, rd(hd));
+    } else if (op == 0x77 && ha == 0x22) {
+        // Architectural placeholder; timing detail is not observable here.
+    } else {
+        if (DadaoISA::isDefinedEncoding(word))
+            return std::make_shared<DadaoISA::MachineFault>("ILLI", 0x88);
+        return std::make_shared<DadaoISA::MachineFault>("UNDI", 0x89);
+    }
+    return NoFault;
+}
+}
