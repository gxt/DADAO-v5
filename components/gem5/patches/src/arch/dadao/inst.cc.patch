+const char *
+mnemonicOf(DadaoISA::ExtMachInst word)
+{
+    const auto decoded = DadaoISA::decode::decodeWord(word);
+    return decoded.ok() ? decoded.entry->mnemonic : "illi";
+}
+
+/** gem5 adapter for the B1-B7 execution cores.
+ *
+ * The cores are plain C++ and only see byte arrays; this class provides the
+ * architectural register file (rd/rb/ra via the integer register class, rf via
+ * the float register class), the memory interface and the B6 platform hooks.
+ * executeB1() through executeB7() accept the same instance (it implements
+ * exec::B7Context, hence exec::B6Context/B5Context/B1Context/RegAccess); the
+ * B7 rounding-mode/flag helpers use the existing float accessors and the FCSR
+ * write mask.
+ *
+ * B6 platform boundary: there is no cfx register file / permission matrix /
+ * SEE frame / privilege model in G1, so readCfx()/writeCfx() report CFXREG,
+ * escapeFrom() reports CFXESC and non-syscall traps panic.  The one modelled
+ * trap is the SE syscall entry (`trap cfx0, 0`), which hands control to the
+ * workload's syscall dispatcher.  The reservation is held by the per-thread
+ * ISA object, single slot, exact address + width (SPEC-181t F8.1); no
+ * checkpoint state.
+ */
+class Gem5B1Context : public exec::B7Context
+{
+  private:
+    ExecContext *xc;
+    ThreadContext *tc;
+    Fault memFault;
+    uint64_t malignAddr;
+    unsigned malignWidth;
+    uint64_t currentWord = 0;
+
+    static RegId
+    intReg(exec::Bank bank, unsigned idx)
+    {
+        RegIndex base = DadaoISA::int_reg::RdBase;
+        switch (bank) {
+          case exec::Bank::Rd:
+            base = DadaoISA::int_reg::RdBase;
+            break;
+          case exec::Bank::Rb:
+            base = DadaoISA::int_reg::RbBase;
+            break;
+          case exec::Bank::Ra:
+            base = DadaoISA::int_reg::RaBase;
+            break;
+        }
+        return RegId(DadaoISA::intRegClass, base + idx);
+    }
+
+    static RegId
+    floatReg(unsigned idx)
+    {
+        return RegId(DadaoISA::floatRegClass, idx);
+    }
+
+    static std::vector<bool>
+    allBytes(unsigned bytes)
+    {
+        return std::vector<bool>(bytes, true);
+    }
+
+    DadaoISA::ISA *
+    isa() const
+    {
+        // One ISA object per thread (B6 reservation state lives there).
+        auto *isa = dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+        if (isa == nullptr)
+            panic("DADAO exec: thread ISA object is not a DadaoISA::ISA");
+        return isa;
+    }
+
+    DadaoISA::ISA *
+    dadaoIsa() const
+    {
+        return dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+    }
+
+    static bool nodeActive(DadaoISA::ISA *isa)
+    {
+        return isa != nullptr && isa->nodeState().active;
+    }
+
+  public:
+    explicit Gem5B1Context(ExecContext *xc) :
+        xc(xc), tc(xc->tcBase()), memFault(NoFault), malignAddr(0),
+        malignWidth(0)
+    {}
+
+    void setCurrentWord(uint64_t word) { currentWord = word; }
+
+    uint64_t
+    readInt(exec::Bank bank, unsigned idx) override
+    {
+        // rd0 is hard-wired zero; rb0 reads the current instruction address.
+        if (bank == exec::Bank::Rd && idx == 0)
+            return 0;
+        if (bank == exec::Bank::Rb && idx == 0)
+            return pc();
+        return tc->getReg(intReg(bank, idx));
+    }
+
+    void
+    writeInt(exec::Bank bank, unsigned idx, uint64_t val) override
+    {
+        // rd0/rb0 are read-only; executeB1()/executeB2() raise ILLI before any
+        // such write, so reaching this is an internal ISA bug -- fail loudly.
+        if ((bank == exec::Bank::Rd || bank == exec::Bank::Rb) && idx == 0) {
+            panic("DADAO exec: illegal write to read-only %s0",
+                  bank == exec::Bank::Rd ? "rd" : "rb");
+        }
+        tc->setReg(intReg(bank, idx), val);
+    }
+
+    uint64_t
+    readFloat(unsigned idx) override
+    {
+        return tc->getReg(floatReg(idx));
+    }
+
+    void
+    writeFloatLow32(unsigned idx, uint32_t val) override
+    {
+        const uint64_t old = tc->getReg(floatReg(idx));
+        tc->setReg(floatReg(idx), (old & 0xFFFFFFFF00000000ULL) | val);
+    }
+
+    void
+    writeFloat64(unsigned idx, uint64_t val) override
+    {
+        tc->setReg(floatReg(idx), val);
+    }
+
+    void
+    writeFcsr(uint64_t raw) override
+    {
+        // rf0 keeps its read-only quiet-NaN and SBZ bits; only the rounding
+        // mode [33:32] and the accrued flags [4:0] are writable
+        // (contract-isa §1.3.3).
+        constexpr uint64_t mask = (uint64_t(3) << 32) | 0x1F;
+        const uint64_t old = tc->getReg(floatReg(0));
+        tc->setReg(floatReg(0), (old & ~mask) | (raw & mask));
+    }
+
+    uint64_t
+    pc() const override
+    {
+        return xc->pcState().as<DadaoISA::PCState>().instAddr();
+    }
+
+    void
+    branchTo(uint64_t target64) override
+    {
+        // The full 64-bit target is written to rb0/PC; the low 48 bits are
+        // what the address space uses (ADR-0012 D8.3/D8.7).
+        //
+        // DadaoInst::advancePC() calls PCState::advance(), which moves pc to
+        // npc.  Setting only pc would therefore make the CPU continue at
+        // target + 4; npc is set to the target as well so the next fetched
+        // instruction is exactly the branch target.
+        DadaoISA::PCState target(target64);
+        target.npc(target64);
+        xc->pcState(target);
+    }
+
+    bool
+    readMem(uint64_t addr, unsigned bytes, uint8_t *out) override
+    {
+        const Fault fault = xc->readMem(addr, out, bytes, Request::Flags(0),
+                                        allBytes(bytes));
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        return true;
+    }
+
+    bool
+    writeMem(uint64_t addr, const uint8_t *in, unsigned bytes) override
+    {
+        const Fault fault = xc->writeMem(const_cast<uint8_t *>(in), bytes, addr,
+                                         Request::Flags(0), nullptr,
+                                         allBytes(bytes));
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        return true;
+    }
+
+    void
+    reportMalign(uint64_t addr, unsigned width) override
+    {
+        malignAddr = addr;
+        malignWidth = width;
+    }
+
+    bool
+    readCfx(uint8_t cfxha, uint8_t cg, uint8_t rc, uint64_t &out) override
+    {
+        // Node: the cfx register file lives in the ISA state.  Architectural
+        // faults (CFXREG/CFXPERM/ILLI) enter the current monitor and return
+        // true with the PC already redirected.
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa))
+            return DadaoISA::nodeCfxRead(tc, isa->nodeState(), cfxha, cg, rc,
+                                         out, currentWord);
+        return false;
+    }
+
+    bool
+    writeCfx(uint8_t cfxha, uint8_t cg, uint8_t rc, uint64_t val) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa))
+            return DadaoISA::nodeCfxWrite(tc, isa->nodeState(), cfxha, cg, rc,
+                                          val, currentWord);
+        return false;
+    }
+
+    void
+    trapTo(uint8_t cfxha, uint32_t immu18) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa)) {
+            DadaoISA::nodeTrap(tc, isa->nodeState(), cfxha, immu18);
+            return;
+        }
+        if (DadaoISA::isFsMachine(tc)) {
+            // Tiny has no cfx vectors.  The semihosting tag is served before
+            // the reserved-cfxha check in DadaoInst::execute(); a trap that
+            // reaches here is a general trap and is ILLI (spec/Machine-v5 §3).
+            DadaoISA::machineFault(DadaoISA::FaultILLI)->invoke(tc, nullptr);
+            return;
+        }
+
+        // SE entry point: `trap cfx0, 0` is umon / SBI_UMON_SYSCALL
+        // (contract-syscall §2).  The workload dispatches on rd15 and the CPU
+        // advances the PC by 4 like any other sequential instruction.
+        if (cfxha == 0 && immu18 == 0) {
+            tc->getSystemPtr()->workload->syscall(tc);
+            return;
+        }
+
+        // The SEE exception vector / frame model is not implemented; other
+        // trap combinations must fail loudly (semihosting and the FS SYS_EXIT
+        // path are separate, later milestones).
+        panic("DADAO B6: trap cfx%u, %u (SEE vector model not implemented)",
+              cfxha, immu18);
+    }
+
+    bool
+    escapeFrom(uint8_t cfxha, uint32_t byteOffset) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); nodeActive(isa))
+            return DadaoISA::nodeEscape(tc, isa->nodeState(), cfxha,
+                                        byteOffset);
+        // No SEE frame to return to: explicit CFXESC, never a silent success.
+        (void)cfxha;
+        (void)byteOffset;
+        return false;
+    }
+
+    void
+    setReservation(uint64_t addr, unsigned width) override
+    {
+        isa()->setReservation(addr, width);
+    }
+
+    bool
+    hasReservation(uint64_t addr, unsigned width) const override
+    {
+        return isa()->hasReservation(addr, width);
+    }
+
+    void
+    clearReservations() override { isa()->clearReservations(); }
+
+    void
+    ordering(uint8_t cfxha, uint8_t pred, uint8_t succ) override
+    {
+        // No cfx resource-domain model in G1; this hook is the insertion point
+        // (the GEM5-002t matrix marks it as such).  The barrier strength is
+        // therefore not observable in this component (open question 4).
+        (void)cfxha;
+        (void)pred;
+        (void)succ;
+    }
+
+    bool
+    readMemOrdered(uint64_t addr, unsigned bytes, uint8_t *out,
+                   uint8_t order) override
+    {
+        // order bit0 = acquire, bit1 = release (B6Spec).
+        Request::Flags flags(0);
+        if (order & 0x1)
+            flags.set(Request::ACQUIRE);
+        if (order & 0x2)
+            flags.set(Request::RELEASE);
+        const Fault fault = xc->readMem(addr, out, bytes, flags,
+                                        allBytes(bytes));
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        return true;
+    }
+
+    bool
+    writeMemOrdered(uint64_t addr, const uint8_t *in, unsigned bytes,
+                    uint8_t order) override
+    {
+        Request::Flags flags(0);
+        if (order & 0x1)
+            flags.set(Request::ACQUIRE);
+        if (order & 0x2)
+            flags.set(Request::RELEASE);
+        const Fault fault = xc->writeMem(const_cast<uint8_t *>(in), bytes, addr,
+                                         flags, nullptr, allBytes(bytes));
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        return true;
+    }
+
+    Fault memFaultValue() const { return memFault; }
+    uint64_t malignAddress() const { return malignAddr; }
+    unsigned malignAccessWidth() const { return malignWidth; }
+    ThreadContext *threadContext() const { return tc; }
+};
+
+/** Translate one exec::Fault into the gem5 fault of DadaoInst::execute().
+ *
+ * The batch cores are strict about their own batch, so a fault a batch cannot
+ * raise means the dispatcher and the core disagree (unreachable in practice).
+ * Those paths keep the pre-convergence panic texts verbatim instead of mapping
+ * them to a plausible-looking gem5 fault.
+ */
+Fault
+mapExecFault(uint8_t batch, exec::Fault fault, Gem5B1Context &ctx,
+             DadaoISA::ExtMachInst word,
+             const DadaoISA::decode::DecodedInst &decoded)
+{
+    const char *id = decoded.entry->id;
+    ThreadContext *tc = ctx.threadContext();
+    const bool fs = DadaoISA::isFsMachine(tc);
+
+    switch (fault) {
+      case exec::Fault::None:
+        return NoFault;
+      case exec::Fault::Illegal:
+        if (fs)
+            return DadaoISA::machineFault(DadaoISA::FaultILLI);
+        return std::make_shared<DadaoISA::IllegalInstruction>(word);
+      case exec::Fault::Malign:
+        switch (batch) {
+          case 1:
+          case 6:
+            if (fs)
+                return DadaoISA::machineFault(DadaoISA::FaultMALIGN);
+            return std::make_shared<DadaoISA::MalignInstruction>(
+                    word, ctx.malignAddress(), ctx.malignAccessWidth());
+          case 5:
+            panic("DADAO B5: %s raised Malign but B5 has no aligned access",
+                  id);
+          case 3:
+          case 4:
+            panic("DADAO B%u: %s raised Malign but B%u has no memory access",
+                  batch, id, batch);
+          default:
+            panic("DADAO B%u: %s raised a memory/alignment fault but B%u has "
+                  "no memory access", batch, id, batch);
+        }
+      case exec::Fault::Memory:
+        switch (batch) {
+          case 1:
+          case 5:
+          case 6:
+            return ctx.memFaultValue();
+          case 3:
+          case 4:
+            panic("DADAO B%u: %s raised Memory but B%u has no memory access",
+                  batch, id, batch);
+          default:
+            panic("DADAO B%u: %s raised a memory/alignment fault but B%u has "
+                  "no memory access", batch, id, batch);
+        }
+      case exec::Fault::RasOverflow:
+      case exec::Fault::RasUnderflow:
+        if (batch == 5) {
+            if (fs)
+                return DadaoISA::machineFault(
+                        fault == exec::Fault::RasOverflow ?
+                        DadaoISA::FaultRASOF : DadaoISA::FaultRASUF);
+            panic("DADAO B5: %s raised %s (architectural trap model not "
+                  "implemented)", id,
+                  fault == exec::Fault::RasOverflow ? "RASOF" : "RASUF");
+        }
+        panic("DADAO B%u: %s raised a RAS fault but B%u has no RAS", batch,
+              id, batch);
+      case exec::Fault::CfxReg: {
+        if (batch != 6) {
+            panic("DADAO B%u: %s raised a cfx fault but B%u has no cfx "
+                  "access", batch, id, batch);
+        }
+        if (fs)
+            return DadaoISA::machineFault(DadaoISA::FaultCFXREG);
+        uint64_t cfxha = 0, cg = 0, rc = 0;
+        exec::fieldValue(decoded, "cfxha", cfxha);
+        exec::fieldValue(decoded, "cghb", cg);
+        exec::fieldValue(decoded, "rchc", rc);
+        panic("DADAO B6: %s cfx%llu cg%llu rc%llu raised CFXREG "
+              "(cfx register file not modelled)", id,
+              (unsigned long long)cfxha, (unsigned long long)cg,
+              (unsigned long long)rc);
+      }
+      case exec::Fault::CfxEsc: {
+        if (batch != 6) {
+            panic("DADAO B%u: %s raised a cfx fault but B%u has no cfx "
+                  "access", batch, id, batch);
+        }
+        // Tiny has no SEE frame: `escape` is ILLI (spec/Machine-v5 §3).
+        if (fs)
+            return DadaoISA::machineFault(DadaoISA::FaultILLI);
+        uint64_t cfxha = 0, imms18 = 0;
+        exec::fieldValue(decoded, "cfxha", cfxha);
+        exec::fieldValue(decoded, "imms18", imms18);
+        panic("DADAO B6: %s cfx%llu offset 0x%llx raised CFXESC "
+              "(SEE frame model not implemented)", id,
+              (unsigned long long)cfxha,
+              (unsigned long long)((imms18 & 0x3FFFF) << 2));
+      }
+      default:
+        // Any NotB* here means the dispatched core rejected an instruction
+        // whose entry is in its own batch: an internal disagreement.
+        panic("DADAO B%u: %s (0x%08x) is batch %u but rejected by executeB%u()",
+              batch, id, word, batch, batch);
+    }
+}
+
+} // anonymous namespace
+
+DadaoInst::DadaoInst(DadaoISA::ExtMachInst w) :
+    StaticInst(mnemonicOf(w), IntAluOp), word(w),
+    decoded(DadaoISA::decode::decodeWord(w))
+{
+    size(4);
+    if (decoded.ok()) {
+        const bool fp = std::string(decoded.entry->scope) == "fp";
+        flags[IsInteger] = !fp;
+        flags[IsFloating] = fp;
+    } else {
+        flags[IsInvalid] = true;
+        flags[IsNonSpeculative] = true;
+    }
+}
+
+std::string
+DadaoInst::generateDisassembly(Addr, const loader::SymbolTable *) const
+{
+    return csprintf("%s 0x%08x", mnemonic, word);
+}
+
+Fault
+DadaoInst::execute(ExecContext *xc, trace::InstRecord *) const
+{
+    ThreadContext *tc = xc->tcBase();
+    const bool fs = DadaoISA::isFsMachine(tc);
+
+    // Node instruction-boundary bookkeeping: count instructions, emit the
+    // optional PC/MODE trace, and deliver one pending async source before the
+    // instruction runs (single-hart, AtomicSimpleCPU granularity).
+    auto *isa = dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+    if (isa != nullptr && isa->nodeState().active) {
+        DadaoISA::NodeState &node = isa->nodeState();
+        if (isa->tracing()) {
+            const std::string_view idv(decoded.ok() ? decoded.entry->id : "");
+            const bool control =
+                idv.substr(0, 3) == "br_" || idv.substr(0, 5) == "jump_" ||
+                idv.substr(0, 5) == "call_" || idv.substr(0, 4) == "ret_" ||
+                idv.substr(0, 5) == "trap_" || idv.substr(0, 7) == "escape_";
+            isa->traceInstruction(tc->pcState().instAddr(), node.runMode,
+                                  control);
+        }
+        node.insnCount++;
+        if (DadaoISA::nodeDeliverAsync(tc, node))
+            return NoFault;
+    }
+
+    if (!decoded.ok()) {
+        // No opcode-table id: UNDI on the FS machine, ILLI (panic) in SE.
+        if (fs)
+            return DadaoISA::machineFault(DadaoISA::FaultUNDI);
+        return std::make_shared<DadaoISA::IllegalInstruction>(word);
+    }
+
+    // FS semihosting entry (contract-semihosting §1/§2): `trap <any cfxha>,
+    // 0x3FFxx` is short-circuited before any cfx/vector handling.  The service
+    // number is rd16; the tag itself only selects the semihosting path.
+    if (fs && std::string_view(decoded.entry->id) == "trap_ciii_cfx") {
+        uint64_t immu18 = 0;
+        if (exec::fieldValue(decoded, "immu18", immu18) &&
+            (immu18 & 0x3FF00) == 0x3FF00) {
+            auto *fsWorkload = DadaoISA::asFsWorkload(tc);
+            auto *semi = dynamic_cast<DadaoISA::Semihosting *>(
+                    fsWorkload->getSemihosting());
+            if (semi == nullptr) {
+                // --semihost=off: the trap has no service to enter.
+                return DadaoISA::machineFault(DadaoISA::FaultILLI);
+            }
+            const RegVal op = tc->getReg(RegId(DadaoISA::intRegClass,
+                    DadaoISA::int_reg::RdBase + 16));
+            semi->call(tc, op);
+            // No `escape`: the PC advances past the trap by the normal
+            // sequential step (IP += 4, contract-semihosting §4).
+            return NoFault;
+        }
+    }
+
+    // Tiny implements no cfx register file at all: every cfx2rd/cfx2rc is
+    // CFXREG (0x84), whatever the cfxha (spec/Machine-v5 §3).
+    if (fs && !(isa != nullptr && isa->nodeState().active)) {
+        const std::string_view id(decoded.entry->id);
+        if (id == "cfx2rd_crrr_cfx" || id == "cfx2rc_crrr_cfx")
+            return DadaoISA::machineFault(DadaoISA::FaultCFXREG);
+    }
+
+    // Node: trap/escape/cfx2rd/cfx2rc are serviced by the platform model
+    // directly.  The B6 core rejects reserved cfxha statically (ILLI) and
+    // unimplemented registers (CFXREG); spec/DADAO-12 §5 routes those to the
+    // current-mode monitor instead of terminating the machine (QEMU-080t
+    // helper_cfx_trap/escape/cfx2rd/cfx2rc), so the Node path must run the
+    // full permission/exception-entry flow here.
+    if (isa != nullptr && isa->nodeState().active) {
+        const std::string_view id(decoded.entry->id);
+        DadaoISA::NodeState &node = isa->nodeState();
+        if (id == "trap_ciii_cfx") {
+            uint64_t cfxha = 0, immu18 = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "immu18", immu18);
+            DadaoISA::nodeTrap(tc, node, static_cast<uint8_t>(cfxha),
+                               static_cast<uint32_t>(immu18));
+            return NoFault;
+        }
+        if (id == "escape_ciii_cfx") {
+            uint64_t cfxha = 0, imms18 = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "imms18", imms18);
+            DadaoISA::nodeEscape(tc, node, static_cast<uint8_t>(cfxha),
+                                 static_cast<uint32_t>((imms18 & 0x3FFFF)
+                                                       << 2));
+            return NoFault;
+        }
+        if (id == "cfx2rd_crrr_cfx" || id == "cfx2rc_crrr_cfx") {
+            uint64_t cfxha = 0, cg = 0, rc = 0, rd = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "cghb", cg);
+            exec::fieldValue(decoded, "rchc", rc);
+            exec::fieldValue(decoded, "rdhd", rd);
+            const RegIndex idx = DadaoISA::int_reg::RdBase + unsigned(rd);
+            if (id == "cfx2rd_crrr_cfx") {
+                uint64_t value = 0;
+                DadaoISA::nodeCfxRead(tc, node, uint8_t(cfxha), uint8_t(cg),
+                                      uint8_t(rc), value, word);
+                if (rd != 0)
+                    tc->setReg(RegId(DadaoISA::intRegClass, idx), value);
+            } else {
+                const uint64_t value = (rd == 0)
+                    ? 0
+                    : tc->getReg(RegId(DadaoISA::intRegClass, idx));
+                DadaoISA::nodeCfxWrite(tc, node, uint8_t(cfxha), uint8_t(cg),
+                                       uint8_t(rc), value, word);
+            }
+            return NoFault;
+        }
+    }
+
+    // The only place an unimplemented instruction is produced: a decoded
+    // entry outside B1-B7.  Every contract id is in B1-B7 (check_converge.py
+    // asserts it), so this guard is unreachable for the 264 ids.
+    const uint8_t batch = decoded.entry->batch;
+    if (batch < 1 || batch > 7) {
+        return std::make_shared<DadaoISA::UnimplementedInstruction>(
+                word, decoded.entry->id);
+    }
+
+    Gem5B1Context ctx(xc);
+    ctx.setCurrentWord(word);
+    return mapExecFault(batch, exec::dispatchBatch(batch, decoded, ctx), ctx,
+                        word, decoded);
+}
+
+} // namespace DadaoISAInst
+} // namespace gem5
