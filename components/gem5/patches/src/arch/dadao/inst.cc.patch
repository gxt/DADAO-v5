+// DADAO StaticInst: B0 skeleton + the B1-B7 execution dispatcher.
+// execute() guards the batch and hands off to exec::dispatchBatch(),
+// the single batch -> core mapping (exec/dispatch.cc).
+#include "arch/dadao/inst.hh"
+
+#include <memory>
+#include <vector>
+
+#include "arch/dadao/exec/b7.hh"
+#include "arch/dadao/exec/dispatch.hh"
+#include "arch/dadao/faults.hh"
+#include "arch/dadao/isa.hh"
+#include "arch/dadao/regs/float.hh"
+#include "arch/dadao/regs/int.hh"
+#include "base/cprintf.hh"
+#include "cpu/exec_context.hh"
+#include "cpu/thread_context.hh"
