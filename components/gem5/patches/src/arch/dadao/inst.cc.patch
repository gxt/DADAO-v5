+#include "arch/dadao/regs/float.hh"
+#include "arch/dadao/regs/int.hh"
+#include "arch/dadao/semihosting.hh"
+#include "arch/dadao/se_workload.hh"
+#include "arch/generic/mmu.hh"
+#include "base/cprintf.hh"
