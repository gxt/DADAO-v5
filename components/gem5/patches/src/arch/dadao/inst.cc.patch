+namespace exec = DadaoISA::exec;
+
+const char *
+mnemonicOf(DadaoISA::ExtMachInst word)
+{
+    const auto decoded = DadaoISA::decode::decodeWord(word);
+    return decoded.ok() ? decoded.entry->mnemonic : "illi";
+}
+
+/** Memory classification, read from the execution cores' single dispatch
+ * tables (B1 `Access`, B6 `B6Op` LR/SC).  This is the same source the cores
+ * dispatch on, so the StaticInst flags cannot drift into a second opcode
+ * table: an id is a memory reference here exactly when a core performs the
+ * access there. */
+const DadaoISA::exec::B1Spec *
+b1SpecOf(const DadaoISA::decode::DecodedInst &decoded)
+{
+    return decoded.ok() ? DadaoISA::exec::specForId(decoded.entry->id)
+                        : nullptr;
+}
+
+const DadaoISA::exec::B6Spec *
+b6SpecOf(const DadaoISA::decode::DecodedInst &decoded)
+{
+    return decoded.ok() ? DadaoISA::exec::b6SpecForId(decoded.entry->id)
+                        : nullptr;
+}
+
+bool
+isLoadWord(const DadaoISA::decode::DecodedInst &decoded)
+{
+    if (const auto *spec = b1SpecOf(decoded))
+        return spec->access == DadaoISA::exec::Access::Load;
+    if (const auto *spec = b6SpecOf(decoded))
+        return spec->op == DadaoISA::exec::B6Op::Lr;
+    return false;
+}
+
+bool
+isStoreWord(const DadaoISA::decode::DecodedInst &decoded)
+{
+    if (const auto *spec = b1SpecOf(decoded))
+        return spec->access == DadaoISA::exec::Access::Store;
+    if (const auto *spec = b6SpecOf(decoded))
+        return spec->op == DadaoISA::exec::B6Op::Sc;
+    return false;
+}
+
+/** LR/SC are the atomic pair (contract-isa §14.2): one reservation, read then
+ * conditional write.  They are neither a plain load nor a plain store, the
+ * same split gem5's RISC-V AMO/LR-SC classes make. */
+bool
+isAtomicWord(const DadaoISA::decode::DecodedInst &decoded)
+{
+    const auto *spec = b6SpecOf(decoded);
+    return spec != nullptr &&
+           (spec->op == DadaoISA::exec::B6Op::Lr ||
+            spec->op == DadaoISA::exec::B6Op::Sc);
+}
+
+OpClass
+opClassOf(DadaoISA::ExtMachInst word)
+{
+    const auto decoded = DadaoISA::decode::decodeWord(word);
+    if (isLoadWord(decoded))
+        return MemReadOp;
+    if (isStoreWord(decoded))
+        return MemWriteOp;
+    return IntAluOp;
+}
+
+/** gem5 adapter for the B1-B7 execution cores.
+ *
+ * The cores are plain C++ and only see byte arrays; this class provides the
+ * architectural register file (rd/rb/ra via the integer register class, rf via
+ * the float register class), the memory interface and the B6 platform hooks.
+ * executeB1() through executeB7() accept the same instance (it implements
+ * exec::B7Context, hence exec::B6Context/B5Context/B1Context/RegAccess); the
+ * B7 rounding-mode/flag helpers use the existing float accessors and the FCSR
+ * write mask.
+ *
+ * B6 platform boundary: there is no cfx register file / permission matrix /
+ * SEE frame / privilege model in G1, so readCfx()/writeCfx() report CFXREG,
+ * escapeFrom() reports CFXESC and non-syscall traps panic.  The one modelled
+ * trap is the SE syscall entry (`trap cfx0, 0`), which hands control to the
+ * workload's syscall dispatcher.  The reservation is held by the per-thread
+ * ISA object, single slot, exact address + width (SPEC-181t F8.1); no
+ * checkpoint state.
+ */
+/** A guest store by `tc` clears every *other* hart's LR/SC reservation for
+ *  the same exact address and width (contract-isa §LR-SC).  The scan is
+ *  skipped entirely while no hart holds a reservation. */
+void
+invalidatePeerReservations(ThreadContext *tc, Addr addr, unsigned width)
+{
+    if (!DadaoISA::ISA::anyReservationHeld())
+        return;
+    auto *mine = dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+    // Copy first: clearReservations() shrinks the holder list.
+    std::vector<DadaoISA::ISA *> hit;
+    for (DadaoISA::ISA *isa : DadaoISA::ISA::reservationHolders()) {
+        if (isa != mine && isa->hasReservation(addr, width))
+            hit.push_back(isa);
+    }
+    for (DadaoISA::ISA *isa : hit)
+        isa->clearReservations();
+}
+
+class Gem5B1Context : public exec::B7Context
+{
+  private:
+    ExecContext *xc;
+    ThreadContext *tc;
+    Fault memFault;
+    uint64_t malignAddr;
+    unsigned malignWidth;
+    uint64_t currentWord = 0;
+
+    static RegId
+    intReg(exec::Bank bank, unsigned idx)
+    {
+        RegIndex base = DadaoISA::int_reg::RdBase;
+        switch (bank) {
+          case exec::Bank::Rd:
+            base = DadaoISA::int_reg::RdBase;
+            break;
+          case exec::Bank::Rb:
+            base = DadaoISA::int_reg::RbBase;
+            break;
+          case exec::Bank::Ra:
+            base = DadaoISA::int_reg::RaBase;
+            break;
+        }
+        return RegId(DadaoISA::intRegClass, base + idx);
+    }
+
+    static RegId
+    floatReg(unsigned idx)
+    {
+        return RegId(DadaoISA::floatRegClass, idx);
+    }
+
+    static std::vector<bool>
+    allBytes(unsigned bytes)
+    {
+        return std::vector<bool>(bytes, true);
+    }
+
+    DadaoISA::ISA *
+    isa() const
+    {
+        // One ISA object per thread (B6 reservation state lives there).
+        auto *isa = dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+        if (isa == nullptr)
+            panic("DADAO exec: thread ISA object is not a DadaoISA::ISA");
+        return isa;
+    }
+
+    DadaoISA::ISA *
+    dadaoIsa() const
+    {
+        return dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+    }
+
+    static bool nodeActive(DadaoISA::ISA *isa)
+    {
+        return isa != nullptr && isa->nodeState().active;
+    }
+
+  public:
+    explicit Gem5B1Context(ExecContext *xc) :
+        xc(xc), tc(xc->tcBase()), memFault(NoFault), malignAddr(0),
+        malignWidth(0)
+    {}
+
+    /** The trap handler asked for the instruction to run again (a syscall
+     *  that would have blocked: pipe/wait4/socket).  execute() turns this
+     *  into a SyscallRetryFault, which leaves the PC on the trap. */
+    bool syscallRetry = false;
+
+    void setCurrentWord(uint64_t word) { currentWord = word; }
+
+    uint64_t
+    readInt(exec::Bank bank, unsigned idx) override
+    {
+        // rd0 is hard-wired zero; rb0 reads the current instruction address.
+        if (bank == exec::Bank::Rd && idx == 0)
+            return 0;
+        if (bank == exec::Bank::Rb && idx == 0)
+            return pc();
+        return tc->getReg(intReg(bank, idx));
+    }
+
+    void
+    writeInt(exec::Bank bank, unsigned idx, uint64_t val) override
+    {
+        // rd0/rb0 are read-only; executeB1()/executeB2() raise ILLI before any
+        // such write, so reaching this is an internal ISA bug -- fail loudly.
+        if ((bank == exec::Bank::Rd || bank == exec::Bank::Rb) && idx == 0) {
+            panic("DADAO exec: illegal write to read-only %s0",
+                  bank == exec::Bank::Rd ? "rd" : "rb");
+        }
+        // ra0[63:54] is SBZ and write-ignored (contract-isa §1.3.4,
+        // spec/SimRISC-00 §2.4): the RA write port drops those ten bits, so
+        // a write only takes effect on RACNT[53:48] and MRPTR[47:0] and the
+        // SBZ bits read back as 0.  ra1-ra63 are untouched -- they carry a
+        // 16-bit recursion count in [63:48] and stay fully writable.  The
+        // RAS header updates keep their own SBZ handling (exec/b5.cc
+        // writeRasHeader) and reach this port with [63:54] already zero.
+        if (bank == exec::Bank::Ra && idx == 0)
+            val &= 0x003FFFFFFFFFFFFFULL;
+        tc->setReg(intReg(bank, idx), val);
+    }
+
+    uint64_t
+    readFloat(unsigned idx) override
+    {
+        return tc->getReg(floatReg(idx));
+    }
+
+    void
+    writeFloatLow32(unsigned idx, uint32_t val) override
+    {
+        // Single-precision producers (`ld.t`/`ldm.t` and every ft result)
+        // replace only [31:0]; [63:32] keeps its old value
+        // (spec/SimRISC-01 §ld.t note, spec/SimRISC-07 §1.3).
+        const uint64_t old = tc->getReg(floatReg(idx));
+        if (idx == 0) {
+            // rf0 is the FCSR: the writable fields are the rounding mode
+            // [33:32] and the accrued flags [4:0] (spec/SimRISC-00 §2.3.1).
+            // A low-32 write does not reach [33:32] at all, so only [4:0]
+            // can change here; the read-only qNaN [31:22] and the SBZ
+            // [21:5] stay (m13-gem5-013).
+            constexpr uint64_t lowMask = 0x1F;
+            tc->setReg(floatReg(idx),
+                       (old & ~lowMask) | (uint64_t(val) & lowMask));
+            return;
+        }
+        tc->setReg(floatReg(idx), (old & 0xFFFFFFFF00000000ULL) | val);
+    }
+
+    void
+    writeFloat64(unsigned idx, uint64_t val) override
+    {
+        tc->setReg(floatReg(idx), val);
+    }
+
+    void
+    writeFcsr(uint64_t raw) override
+    {
+        // rf0 keeps its read-only quiet-NaN and SBZ bits; only the rounding
+        // mode [33:32] and the accrued flags [4:0] are writable
+        // (contract-isa §1.3.3).
+        constexpr uint64_t mask = (uint64_t(3) << 32) | 0x1F;
+        const uint64_t old = tc->getReg(floatReg(0));
+        tc->setReg(floatReg(0), (old & ~mask) | (raw & mask));
+    }
+
+    uint64_t
+    pc() const override
+    {
+        return xc->pcState().as<DadaoISA::PCState>().instAddr();
+    }
+
+    void
+    branchTo(uint64_t target64) override
+    {
+        // The full 64-bit target is written to rb0/PC; the low 48 bits are
+        // what the address space uses (ADR-0012 D8.3/D8.7).
+        //
+        // DadaoInst::advancePC() calls PCState::advance(), which moves pc to
+        // npc.  Setting only pc would therefore make the CPU continue at
+        // target + 4; npc is set to the target as well so the next fetched
+        // instruction is exactly the branch target.
+        DadaoISA::PCState target(target64);
+        target.npc(target64);
+        xc->pcState(target);
+    }
+
+    /** The architectural current cfx (`inner_cfx_code`) of the running FS
+     *  machine, or -1 when neither the Tiny nor the Node cfx model is active.
+     *
+     *  A fault whose destination is the *current* cfx (CFXESC, DADAO-12
+     *  §5.2(一)) must be addressed to this number; the machine's fault
+     *  fallback cannot derive it from the run mode. */
+    int
+    currentCfx() const
+    {
+        DadaoISA::ISA *isa = dadaoIsa();
+        if (isa == nullptr)
+            return -1;
+        if (isa->nodeState().active)
+            return isa->nodeState().cfxCode;
+        if (isa->tinyState().active)
+            return isa->tinyState().cfxCode;
+        return -1;
+    }
+
+    /** True when the data access cannot use the CPU's synchronous interface.
+     *
+     *  An AtomicSimpleCPU completes `ExecContext::readMem/writeMem` inline, but
+     *  a TimingSimpleCPU has no synchronous data path at all: the base class
+     *  panics (`src/cpu/simple/base.hh`, "readMem() is not implemented")
+     *  because a *timed* access can only complete later, through
+     *  `initiateAcc`/`completeAcc`, which needs a two-phase instruction.
+     *
+     *  The DADAO exec cores (exec/b1..b7) are one-shot functions that read
+     *  memory in the middle of `execute()`, so this side must keep the
+     *  synchronous contract.  In timing mode it therefore reaches the same
+     *  backing store through a **functional** access -- exactly the mechanism
+     *  the SE syscall layer and the ELF loader already use
+     *  (SETranslatingPortProxy).  Semantics are unchanged (same page table,
+     *  same memory); the access is simply not *timed*: the ld/st round trip is
+     *  accounted for by the wuming cycle model (wuming_latency.hh) instead of
+     *  by the memory system.  m16-gem5-006 records that split. */
+    bool
+    functionalMem() const
+    {
+        return tc != nullptr &&
+               tc->getSystemPtr()->getMemoryMode() == enums::timing;
+    }
+
+    /** A fully simulated machine (Kaiwu-Tiny / Kaiwu-Vast) is running.
+     *
+     *  Same discriminator the cfx and semihosting paths use: the FS workload
+     *  activates exactly one of the two machine states at reset, SE leaves
+     *  both inactive. */
+    bool
+    fsMachineActive() const
+    {
+        DadaoISA::ISA *isa = dadaoIsa();
+        return isa != nullptr &&
+               (isa->tinyState().active || isa->nodeState().active);
+    }
+
+    /** Functional data access on a fully simulated machine (FS + Timing).
+     *
+     *  The FS TLBs are the only place that knows the Tiny segment rules and
+     *  the Vast page-table walk, and the atomic path gets its CFXMEM/CFXPERM/
+     *  PTW faults from the very same `translate*` entry points.  A functional
+     *  shortcut that skipped them would either bypass the fault (silent wrong
+     *  value) or turn a guest exception into a simulator panic, so the access
+     *  translates through the guest MMU here and reports the fault exactly
+     *  like `readMem`/`writeMem` does in atomic mode.  Only the *timing* is
+     *  absent: the ld/st round trip is charged by the wuming cycle model
+     *  (m16-gem5-006 待裁定 1, carried into FS by m16-gem5-015).
+     *
+     *  One translation is enough: a DADAO element access is at most 8 bytes
+     *  and naturally aligned (an unaligned one has already raised Malign), so
+     *  it never crosses a 64 KiB page boundary. */
+    bool
+    functionalFsAccess(uint64_t addr, uint8_t *buf, unsigned bytes, bool write,
+                       Request::Flags flags)
+    {
+        const auto mode = write ? BaseMMU::Write : BaseMMU::Read;
+        RequestPtr req = std::make_shared<Request>(
+                addr, bytes, flags, tc->getCpuPtr()->dataRequestorId(),
+                tc->pcState().instAddr(), tc->contextId());
+        Fault fault = tc->getMMUPtr()->translateFunctional(req, tc, mode);
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        PortProxy &phys = tc->getSystemPtr()->physProxy;
+        if (write)
+            phys.writeBlobPhys(req->getPaddr(), flags, buf, bytes);
+        else
+            phys.readBlobPhys(req->getPaddr(), flags, buf, bytes);
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr)
+            isa->noteDataAccess(write);
+        return true;
+    }
+
+    bool
+    accessMem(uint64_t addr, uint8_t *buf, unsigned bytes, bool write,
+              Request::Flags flags)
+    {
+        if (functionalMem()) {
+            if (fsMachineActive())
+                return functionalFsAccess(addr, buf, bytes, write, flags);
+            SETranslatingPortProxy proxy(tc);
+            const bool ok = write ? proxy.tryWriteBlob(addr, buf, bytes)
+                                  : proxy.tryReadBlob(addr, buf, bytes);
+            if (!ok)
+                panic("DADAO timing data %s of %u B at %#x did not translate; "
+                      "the exec cores read memory synchronously (inst.cc "
+                      "|functionalMem|)", write ? "write" : "read", bytes,
+                      addr);
+            if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr)
+                isa->noteDataAccess(write);
+            return true;
+        }
+        const Fault fault = write
+            ? xc->writeMem(buf, bytes, addr, flags, nullptr, allBytes(bytes))
+            : xc->readMem(addr, buf, bytes, flags, allBytes(bytes));
+        if (fault != NoFault) {
+            memFault = fault;
+            return false;
+        }
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr)
+            isa->noteDataAccess(write);
+        return true;
+    }
+
+    bool
+    readMem(uint64_t addr, unsigned bytes, uint8_t *out) override
+    {
+        return accessMem(addr, out, bytes, false, Request::Flags(0));
+    }
+
+    bool
+    writeMem(uint64_t addr, const uint8_t *in, unsigned bytes) override
+    {
+        return accessMem(addr, const_cast<uint8_t *>(in), bytes, true,
+                         Request::Flags(0));
+    }
+
+    void
+    reportMalign(uint64_t addr, unsigned width) override
+    {
+        malignAddr = addr;
+        malignWidth = width;
+    }
+
+    bool
+    readCfx(uint8_t cfxha, uint8_t cg, uint8_t rc, uint64_t &out) override
+    {
+        // Node: the cfx register file lives in the ISA state.  Architectural
+        // faults (CFXREG/CFXPERM/ILLI) enter the current monitor and return
+        // true with the PC already redirected.
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa))
+            return DadaoISA::nodeCfxRead(tc, isa->nodeState(), cfxha, cg, rc,
+                                         out, currentWord);
+        if (DadaoISA::ISA *isa = dadaoIsa();
+            isa != nullptr && isa->tinyState().active) {
+            // Tiny cfx2rd is pre-handled in DadaoInst::execute(); this hook
+            // returns true so the generic B6 path never raises a second fault.
+            out = 0;
+            (void)DadaoISA::tinyCfxRead(tc, isa->tinyState(), cfxha, cg, rc,
+                                        out, currentWord);
+            return true;
+        }
+        return false;
+    }
+
+    bool
+    writeCfx(uint8_t cfxha, uint8_t cg, uint8_t rc, uint64_t val) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa))
+            return DadaoISA::nodeCfxWrite(tc, isa->nodeState(), cfxha, cg, rc,
+                                          val, currentWord);
+        if (DadaoISA::ISA *isa = dadaoIsa();
+            isa != nullptr && isa->tinyState().active) {
+            (void)DadaoISA::tinyCfxWrite(tc, isa->tinyState(), cfxha, cg, rc,
+                                         val, currentWord);
+            return true;
+        }
+        return false;
+    }
+
+    void
+    trapTo(uint8_t cfxha, uint32_t immu18) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa)) {
+            DadaoISA::nodeTrap(tc, isa->nodeState(), cfxha, immu18);
+            return;
+        }
+        if (DadaoISA::ISA *isa = dadaoIsa();
+            isa != nullptr && isa->tinyState().active) {
+            // Tiny: general trap (semihosting was short-circuited earlier)
+            // enters the target cfx vector; reserved/unimplemented => ILLI
+            // into hmon (spec/Kaiwu §3/§4.1/§4.4).
+            DadaoISA::tinyTrap(tc, isa->tinyState(), cfxha, immu18);
+            return;
+        }
+        if (DadaoISA::isFsMachine(tc)) {
+            DadaoISA::machineFault(DadaoISA::FaultILLI)->invoke(tc, nullptr);
+            return;
+        }
+
+        // SE entry point: `trap cfx0, 0` is umon / SBI_UMON_SYSCALL
+        // (contract-syscall §2).  The workload dispatches on rd15 and the CPU
+        // advances the PC by 4 like any other sequential instruction -- unless
+        // the call cannot make progress yet, in which case execute() reports a
+        // SyscallRetryFault and the trap runs again later.
+        if (cfxha == 0 && immu18 == 0) {
+            auto *workload = dynamic_cast<DadaoISA::SEWorkload *>(
+                    tc->getSystemPtr()->workload);
+            workload->syscall(tc);
+            if (workload->syscallRetry)
+                syscallRetry = true;
+            return;
+        }
+
+        // The SEE exception vector / frame model is not implemented; other
+        // trap combinations must fail loudly (semihosting and the FS SYS_EXIT
+        // path are separate, later milestones).
+        panic("DADAO B6: trap cfx%u, %u (SEE vector model not implemented)",
+              cfxha, immu18);
+    }
+
+    bool
+    escapeFrom(uint8_t cfxha, uint32_t byteOffset) override
+    {
+        if (DadaoISA::ISA *isa = dadaoIsa(); isa != nullptr && nodeActive(isa))
+            return DadaoISA::nodeEscape(tc, isa->nodeState(), cfxha,
+                                        byteOffset);
+        if (DadaoISA::ISA *isa = dadaoIsa();
+            isa != nullptr && isa->tinyState().active)
+            return DadaoISA::tinyEscape(tc, isa->tinyState(), cfxha,
+                                        byteOffset);
+        // No SEE frame to return to: explicit CFXESC, never a silent success.
+        (void)cfxha;
+        (void)byteOffset;
+        return false;
+    }
+
+    void
+    setReservation(uint64_t addr, unsigned width) override
+    {
+        isa()->setReservation(addr, width);
+    }
+
+    bool
+    hasReservation(uint64_t addr, unsigned width) const override
+    {
+        return isa()->hasReservation(addr, width);
+    }
+
+    void
+    clearReservations() override { isa()->clearReservations(); }
+
+    void
+    ordering(uint8_t cfxha, uint8_t pred, uint8_t succ) override
+    {
+        // No cfx resource-domain model in G1; this hook is the insertion point
+        // (the GEM5-002t matrix marks it as such).  The barrier strength is
+        // therefore not observable in this component (open question 4).
+        (void)cfxha;
+        (void)pred;
+        (void)succ;
+    }
+
+    bool
+    readMemOrdered(uint64_t addr, unsigned bytes, uint8_t *out,
+                   uint8_t order) override
+    {
+        // order bit0 = acquire, bit1 = release (B6Spec).
+        Request::Flags flags(0);
+        if (order & 0x1)
+            flags.set(Request::ACQUIRE);
+        if (order & 0x2)
+            flags.set(Request::RELEASE);
+        return accessMem(addr, out, bytes, false, flags);
+    }
+
+    bool
+    writeMemOrdered(uint64_t addr, const uint8_t *in, unsigned bytes,
+                    uint8_t order) override
+    {
+        Request::Flags flags(0);
+        if (order & 0x1)
+            flags.set(Request::ACQUIRE);
+        if (order & 0x2)
+            flags.set(Request::RELEASE);
+        if (!accessMem(addr, const_cast<uint8_t *>(in), bytes, true, flags))
+            return false;
+        invalidatePeerReservations(tc, addr, bytes);
+        return true;
+    }
+
+    Fault memFaultValue() const { return memFault; }
+    uint64_t malignAddress() const { return malignAddr; }
+    unsigned malignAccessWidth() const { return malignWidth; }
+    ThreadContext *threadContext() const { return tc; }
+};
+
+/** Translate one exec::Fault into the gem5 fault of DadaoInst::execute().
+ *
+ * The batch cores are strict about their own batch, so a fault a batch cannot
+ * raise means the dispatcher and the core disagree (unreachable in practice).
+ * Those paths keep the pre-convergence panic texts verbatim instead of mapping
+ * them to a plausible-looking gem5 fault.
+ *
+ * On the FS machine every one of these is an *execution-time synchronous
+ * exception*: `machineFault*()` carries the architectural frame and enters the
+ * current run-mode monitor (Node: `nodeSyncEnter`; Tiny: hmon).  No route from
+ * here stops the machine directly -- that happens only when the monitor vector
+ * is unreachable (spec/Kaiwu §7.1), inside the delivery itself.
+ */
+Fault
+mapExecFault(uint8_t batch, exec::Fault fault, Gem5B1Context &ctx,
+             DadaoISA::ExtMachInst word,
+             const DadaoISA::decode::DecodedInst &decoded)
+{
+    const char *id = decoded.entry->id;
+    ThreadContext *tc = ctx.threadContext();
+    const bool fs = DadaoISA::isFsMachine(tc);
+    const Addr ip = tc->pcState().instAddr();
+
+    switch (fault) {
+      case exec::Fault::None:
+        return NoFault;
+      case exec::Fault::Illegal:
+        if (fs)
+            return DadaoISA::machineFaultAt(DadaoISA::FaultILLI, ip, word);
+        return std::make_shared<DadaoISA::IllegalInstruction>(word);
+      case exec::Fault::Malign:
+        switch (batch) {
+          case 1:
+          case 6:
+            if (fs)
+                return DadaoISA::machineFaultAt(
+                    DadaoISA::FaultMALIGN, ip, ctx.malignAddress());
+            return std::make_shared<DadaoISA::MalignInstruction>(
+                    word, ctx.malignAddress(), ctx.malignAccessWidth());
+          case 5:
+            panic("DADAO B5: %s raised Malign but B5 has no aligned access",
+                  id);
+          case 3:
+          case 4:
+            panic("DADAO B%u: %s raised Malign but B%u has no memory access",
+                  batch, id, batch);
+          default:
+            panic("DADAO B%u: %s raised a memory/alignment fault but B%u has "
+                  "no memory access", batch, id, batch);
+        }
+      case exec::Fault::Memory:
+        switch (batch) {
+          case 1:
+          case 5:
+          case 6:
+            return ctx.memFaultValue();
+          case 3:
+          case 4:
+            panic("DADAO B%u: %s raised Memory but B%u has no memory access",
+                  batch, id, batch);
+          default:
+            panic("DADAO B%u: %s raised a memory/alignment fault but B%u has "
+                  "no memory access", batch, id, batch);
+        }
+      case exec::Fault::RasOverflow:
+      case exec::Fault::RasUnderflow:
+        if (batch == 5) {
+            if (fs)
+                return DadaoISA::machineFaultAt(
+                        fault == exec::Fault::RasOverflow ?
+                        DadaoISA::FaultRASOF : DadaoISA::FaultRASUF, ip, 0);
+            panic("DADAO B5: %s raised %s (architectural trap model not "
+                  "implemented)", id,
+                  fault == exec::Fault::RasOverflow ? "RASOF" : "RASUF");
+        }
+        panic("DADAO B%u: %s raised a RAS fault but B%u has no RAS", batch,
+              id, batch);
+      case exec::Fault::CfxReg: {
+        if (batch != 6) {
+            panic("DADAO B%u: %s raised a cfx fault but B%u has no cfx "
+                  "access", batch, id, batch);
+        }
+        if (fs)
+            return DadaoISA::machineFaultAt(DadaoISA::FaultCFXREG, ip, word);
+        uint64_t cfxha = 0, cg = 0, rc = 0;
+        exec::fieldValue(decoded, "cfxha", cfxha);
+        exec::fieldValue(decoded, "cghb", cg);
+        exec::fieldValue(decoded, "rchc", rc);
+        panic("DADAO B6: %s cfx%llu cg%llu rc%llu raised CFXREG "
+              "(cfx register file not modelled)", id,
+              (unsigned long long)cfxha, (unsigned long long)cg,
+              (unsigned long long)rc);
+      }
+      case exec::Fault::CfxEsc: {
+        if (batch != 6) {
+            panic("DADAO B%u: %s raised a cfx fault but B%u has no cfx "
+                  "access", batch, id, batch);
+        }
+        // CFXESC belongs to the *current* cfx (DADAO-12 §5.2(一): "escape
+        // 帧错误或目标错误 ⇒ 当前核芯功能扩展，不属于 monitor 路由"), never
+        // to the current run-mode monitor.  The platform hooks deliver the
+        // target/frame errors themselves (tinyEscape/nodeEscape); this
+        // fallback is the encoding-level case in which the hook is not
+        // called at all -- B6 raises CFXESC before `escapeFrom()` for
+        // `imms18[1] = 1` (cg9 is a capture buffer, not a return frame,
+        // §5.1).  Address it to `inner_cfx_code`: an unreachable vector then
+        // stops with the Kaiwu §7.1 other-cfx code (`0x80 | cfxha`), not the
+        // monitor code.
+        if (fs) {
+            const int target = ctx.currentCfx();
+            if (target >= 0)
+                return DadaoISA::machineFaultToCfx(
+                        DadaoISA::FaultCfxEsc, static_cast<uint8_t>(target),
+                        ip, word);
+            // No cfx model on this FS machine: the fault has no architectural
+            // destination at all.  Fail loudly instead of inventing a route.
+            panic("DADAO B6: %s raised CFXESC on an FS machine with no cfx "
+                  "state", id);
+        }
+        uint64_t cfxha = 0, imms18 = 0;
+        exec::fieldValue(decoded, "cfxha", cfxha);
+        exec::fieldValue(decoded, "imms18", imms18);
+        panic("DADAO B6: %s cfx%llu offset 0x%llx raised CFXESC "
+              "(SEE frame model not implemented)", id,
+              (unsigned long long)cfxha,
+              (unsigned long long)((imms18 & 0x3FFFF) << 2));
+      }
+      default:
+        // Any NotB* here means the dispatched core rejected an instruction
+        // whose entry is in its own batch: an internal disagreement.
+        panic("DADAO B%u: %s (0x%08x) is batch %u but rejected by executeB%u()",
+              batch, id, word, batch, batch);
+    }
+}
+
+} // anonymous namespace
+
+DadaoInst::DadaoInst(DadaoISA::ExtMachInst w) :
+    StaticInst(mnemonicOf(w), opClassOf(w)), word(w),
+    decoded(DadaoISA::decode::decodeWord(w))
+{
+    size(4);
+    if (decoded.ok()) {
+        const bool fp = std::string(decoded.entry->scope) == "fp";
+        flags[IsInteger] = !fp;
+        flags[IsFloating] = fp;
+        // Memory class (D21 of the gem5 difference inventory): the flags make
+        // the instruction a memory reference to gem5 (isMemRef()), feed the
+        // load/store statistics and route the TimingSimpleCPU through
+        // initiateAcc().  They do **not** gate the classic caches: with
+        // AtomicSimpleCPU the data packet is sent by ExecContext::readMem/
+        // writeMem regardless (measured in m16-gem5-020, see the task book).
+        flags[IsLoad] = isLoadWord(decoded);
+        flags[IsStore] = isStoreWord(decoded);
+        flags[IsAtomic] = isAtomicWord(decoded);
+    } else {
+        flags[IsInvalid] = true;
+        flags[IsNonSpeculative] = true;
+    }
+}
+
+std::string
+DadaoInst::generateDisassembly(Addr, const loader::SymbolTable *) const
+{
+    return csprintf("%s 0x%08x", mnemonic, word);
+}
+
+Fault
+DadaoInst::initiateAcc(ExecContext *xc, trace::InstRecord *traceData) const
+{
+    Fault fault = execute(xc, traceData);
+    if (fault == NoFault && !isMicroop()) {
+        // TimingSimpleCPU's memory branch calls postExecute() but not
+        // countInst() (an upstream ISA completes later in completeAcc()).
+        // DADAO completes the functional access inside execute() and never
+        // sees a packet, so mirror BaseSimpleCPU::countInst() here: without
+        // it totalInsts() and --max-insts would skip every load/store.
+        if (auto *simple = dynamic_cast<SimpleExecContext *>(xc)) {
+            simple->numInst++;
+            simple->numOp++;
+        }
+    }
+    return fault;
+}
+
+bool
+DadaoInst::fieldValue(const char *name, uint64_t &value) const
+{
+    return exec::fieldValue(decoded, std::string_view(name), value);
+}
+
+Fault
+DadaoInst::execute(ExecContext *xc, trace::InstRecord *) const
+{
+    ThreadContext *tc = xc->tcBase();
+    const bool fs = DadaoISA::isFsMachine(tc);
+
+    // Node instruction-boundary bookkeeping: count instructions, emit the
+    // optional PC/MODE trace, and deliver one pending async source before the
+    // instruction runs (single-hart, AtomicSimpleCPU granularity).
+    auto *isa = dynamic_cast<DadaoISA::ISA *>(tc->getIsaPtr());
+    // The latency hook runs from advanceInst(), after advancePC(); record the
+    // address of *this* instruction while it is still the pc state.  A block
+    // transfer may take `rb0` (= current IP) as its base, which no register
+    // read can recover after the pc has advanced (m16-gem5-018).
+    if (isa != nullptr)
+        isa->noteWumingInstAddr(tc->pcState().instAddr());
+    if (isa != nullptr && isa->nodeState().active) {
+        DadaoISA::NodeState &node = isa->nodeState();
+        // The instruction encoding is `excp_cause_info` for ILLI/UNDI/CFXREG/
+        // CFXESC (DADAO-12 §4.1); the address-translation side (a store to the
+        // read-only BootROM) raises ILLI without seeing this word.
+        node.curInstWord = word;
+        if (isa->tracing()) {
+            const std::string_view idv(decoded.ok() ? decoded.entry->id : "");
+            const bool control =
+                idv.substr(0, 3) == "br_" || idv.substr(0, 5) == "jump_" ||
+                idv.substr(0, 5) == "call_" || idv.substr(0, 4) == "ret_" ||
+                idv.substr(0, 5) == "trap_" || idv.substr(0, 7) == "escape_";
+            isa->traceInstruction(tc->pcState().instAddr(), node.runMode,
+                                  control);
+        }
+        node.insnCount++;
+        if (DadaoISA::nodeDeliverAsync(tc, node))
+            return NoFault;
+    }
+
+    // Asynchronous signal delivery (GEM5-026t): a queued, unblocked signal is
+    // taken at an instruction boundary, so a thread that never issues a
+    // syscall -- musl's asynchronously cancelled spinner -- still sees it.
+    // The interrupted instruction is re-executed after the handler returns
+    // (the frame records this PC).
+    if (!fs && isa != nullptr && isa->hasPendingSignal()) {
+        auto *seWorkload = dynamic_cast<DadaoISA::SEWorkload *>(
+                tc->getSystemPtr()->workload);
+        if (seWorkload != nullptr && seWorkload->deliverPendingSignal(tc))
+            return NoFault;
+    }
+
+    if (!decoded.ok()) {
+        // No opcode-table id: UNDI on the FS machine, ILLI (panic) in SE.
+        if (fs)
+            return DadaoISA::machineFaultAt(
+                DadaoISA::FaultUNDI, tc->pcState().instAddr(), word);
+        return std::make_shared<DadaoISA::IllegalInstruction>(word);
+    }
+
+    // Semihosting entry (contract-semihosting §1/§2): `trap <any cfxha>,
+    // 0x3FFxx` is short-circuited before any cfx/vector handling.  The service
+    // number is rd16; the tag itself only selects the semihosting path.
+    //
+    // m16-gem5-007: the responder is resolved through the workload, so an SE
+    // run can carry one as well (DadaoSEWorkload.semihosting; NULL by
+    // default).  With no responder the SE path falls through unchanged and the
+    // trap reaches the execution core, which panics as before.
+    if (std::string_view(decoded.entry->id) == "trap_ciii_cfx") {
+        uint64_t immu18 = 0;
+        if (exec::fieldValue(decoded, "immu18", immu18) &&
+            (immu18 & 0x3FF00) == 0x3FF00) {
+            Workload *workload = tc->getSystemPtr()->workload;
+            auto *semi = workload != nullptr
+                ? dynamic_cast<DadaoISA::Semihosting *>(
+                        workload->getSemihosting())
+                : nullptr;
+            if (semi == nullptr) {
+                if (fs) {
+                    // --semihost=off: the trap has no service to enter.
+                    return DadaoISA::machineFaultAt(
+                        DadaoISA::FaultILLI, tc->pcState().instAddr(), word);
+                }
+            } else {
+                const RegVal op = tc->getReg(RegId(DadaoISA::intRegClass,
+                        DadaoISA::int_reg::RdBase + 16));
+                semi->call(tc, op);
+                // No `escape`: the PC advances past the trap by the normal
+                // sequential step (IP += 4, contract-semihosting §4).
+                return NoFault;
+            }
+        }
+    }
+
+    // Tiny: cfx2rd/cfx2rc are serviced here so a faulting access never writes
+    // the destination register (precise exception).  Reserved/unimplemented
+    // cfxha and missing cg/rc are raised by tinyCfxRead/Write themselves.
+    if (fs && isa != nullptr && isa->tinyState().active) {
+        const std::string_view id(decoded.entry->id);
+        if (id == "cfx2rd_crrr_cfx" || id == "cfx2rc_crrr_cfx") {
+            uint64_t cfxha = 0, cg = 0, rc = 0, rd = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "cghb", cg);
+            exec::fieldValue(decoded, "rchc", rc);
+            exec::fieldValue(decoded, "rdhd", rd);
+            const RegIndex idx = DadaoISA::int_reg::RdBase + unsigned(rd);
+            if (id == "cfx2rd_crrr_cfx") {
+                uint64_t value = 0;
+                if (DadaoISA::tinyCfxRead(tc, isa->tinyState(),
+                                          uint8_t(cfxha), uint8_t(cg),
+                                          uint8_t(rc), value, word)) {
+                    if (rd != 0)
+                        tc->setReg(RegId(DadaoISA::intRegClass, idx), value);
+                }
+            } else {
+                const uint64_t value = (rd == 0)
+                    ? 0 : tc->getReg(RegId(DadaoISA::intRegClass, idx));
+                (void)DadaoISA::tinyCfxWrite(tc, isa->tinyState(),
+                                             uint8_t(cfxha), uint8_t(cg),
+                                             uint8_t(rc), value, word);
+            }
+            return NoFault;
+        }
+    }
+
+    // Neither Tiny nor Node state exists: no cfx register file at all, so
+    // every cfx2rd/cfx2rc is CFXREG.
+    if (fs && !(isa != nullptr && isa->nodeState().active) &&
+        !(isa != nullptr && isa->tinyState().active)) {
+        const std::string_view id(decoded.entry->id);
+        if (id == "cfx2rd_crrr_cfx" || id == "cfx2rc_crrr_cfx")
+            return DadaoISA::machineFaultAt(
+                DadaoISA::FaultCFXREG, tc->pcState().instAddr(), word);
+    }
+
+    // Node: trap/escape/cfx2rd/cfx2rc are serviced by the platform model
+    // directly.  The B6 core rejects reserved cfxha statically (ILLI) and
+    // unimplemented registers (CFXREG); spec/DADAO-12 §5 routes those to the
+    // current-mode monitor instead of terminating the machine (QEMU-080t
+    // helper_cfx_trap/escape/cfx2rd/cfx2rc), so the Node path must run the
+    // full permission/exception-entry flow here.
+    if (isa != nullptr && isa->nodeState().active) {
+        const std::string_view id(decoded.entry->id);
+        DadaoISA::NodeState &node = isa->nodeState();
+        if (id == "trap_ciii_cfx") {
+            uint64_t cfxha = 0, immu18 = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "immu18", immu18);
+            DadaoISA::nodeTrap(tc, node, static_cast<uint8_t>(cfxha),
+                               static_cast<uint32_t>(immu18));
+            return NoFault;
+        }
+        if (id == "escape_ciii_cfx") {
+            uint64_t cfxha = 0, imms18 = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "imms18", imms18);
+            DadaoISA::nodeEscape(tc, node, static_cast<uint8_t>(cfxha),
+                                 static_cast<uint32_t>((imms18 & 0x3FFFF)
+                                                       << 2));
+            return NoFault;
+        }
+        if (id == "cfx2rd_crrr_cfx" || id == "cfx2rc_crrr_cfx") {
+            uint64_t cfxha = 0, cg = 0, rc = 0, rd = 0;
+            exec::fieldValue(decoded, "cfxha", cfxha);
+            exec::fieldValue(decoded, "cghb", cg);
+            exec::fieldValue(decoded, "rchc", rc);
+            exec::fieldValue(decoded, "rdhd", rd);
+            const RegIndex idx = DadaoISA::int_reg::RdBase + unsigned(rd);
+            if (id == "cfx2rd_crrr_cfx") {
+                uint64_t value = 0;
+                DadaoISA::nodeCfxRead(tc, node, uint8_t(cfxha), uint8_t(cg),
+                                      uint8_t(rc), value, word);
+                if (rd != 0)
+                    tc->setReg(RegId(DadaoISA::intRegClass, idx), value);
+            } else {
+                const uint64_t value = (rd == 0)
+                    ? 0
+                    : tc->getReg(RegId(DadaoISA::intRegClass, idx));
+                DadaoISA::nodeCfxWrite(tc, node, uint8_t(cfxha), uint8_t(cg),
+                                       uint8_t(rc), value, word);
+            }
+            return NoFault;
+        }
+    }
+
+    // The only place an unimplemented instruction is produced: a decoded
+    // entry outside B1-B7.  Every contract id is in B1-B7 (check_converge.py
+    // asserts it), so this guard is unreachable for the 264 ids.
+    const uint8_t batch = decoded.entry->batch;
+    if (batch < 1 || batch > 7) {
+        return std::make_shared<DadaoISA::UnimplementedInstruction>(
+                word, decoded.entry->id);
+    }
+
+    Gem5B1Context ctx(xc);
+    ctx.setCurrentWord(word);
+    Fault fault = mapExecFault(batch, exec::dispatchBatch(batch, decoded, ctx),
+                               ctx, word, decoded);
+    // A syscall that could not make progress runs again from the same trap
+    // (SyscallRetryFault leaves the PC alone, sim/faults.cc).
+    if (ctx.syscallRetry)
+        return std::make_shared<SyscallRetryFault>();
+    return fault;
+}
