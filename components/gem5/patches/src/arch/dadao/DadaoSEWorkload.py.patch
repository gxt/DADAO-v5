+class DadaoSEWorkload(SEWorkload):
+    type = "DadaoSEWorkload"
+    cxx_class = "gem5::DadaoISA::SEWorkload"
+    cxx_header = "arch/dadao/se_workload.hh"
+
+    # m16-gem5-007: semihosting responder for bare-metal Kaiwu images.
+    # NULL (the default) leaves the SE trap path unchanged.
