+#ifndef __ARCH_DADAO_PCSTATE_HH__
+#define __ARCH_DADAO_PCSTATE_HH__
+
+#include "arch/generic/pcstate.hh"
+#include "enums/ByteOrder.hh"
+
+namespace gem5::DadaoISA
+{
+class PCState : public GenericISA::SimplePCState<4>
+{
+  private:
+    bool _explicitBranch = false;
+
+  public:
+    using GenericISA::SimplePCState<4>::SimplePCState;
+    PCStateBase *clone() const override { return new PCState(*this); }
+    ByteOrder byteOrder() const { return ByteOrder::big; }
+    bool explicitBranch() const { return _explicitBranch; }
+    void explicitBranch(bool value) { _explicitBranch = value; }
+
+    void
+    update(const PCStateBase &other) override
+    {
+        GenericISA::SimplePCState<4>::update(other);
+        _explicitBranch = other.as<PCState>()._explicitBranch;
+    }
+
+    bool
+    equals(const PCStateBase &other) const override
+    {
+        return GenericISA::SimplePCState<4>::equals(other) &&
+               _explicitBranch == other.as<PCState>()._explicitBranch;
+    }
+};
+}
+
+#endif
