+++ b/src/arch/dadao/page_size.hh
@@ -0,0 +1,24 @@
+// DADAO page size (architecture: 16-bit bytes, i.e. 64 KiB pages).
+//
+// The architecture page is 64 KiB, so syscall emulation uses the same number:
+// the guest-visible AT_PAGESZ and the host-proxy page table are both 64 KiB.
+// (qemu-dadao's current TARGET_PAGE_BITS = 12 is a QEMU defect tracked by a
+// separate QEMU task; it is not a reference value.)
+#ifndef __ARCH_DADAO_PAGE_SIZE_HH__
+#define __ARCH_DADAO_PAGE_SIZE_HH__
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+const Addr PageShift = 16;
+const Addr PageBytes = 1ULL << PageShift;
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_PAGE_SIZE_HH__
