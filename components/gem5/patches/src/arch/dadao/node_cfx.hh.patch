+++ b/src/arch/dadao/node_cfx.hh
@@ -0,0 +1,469 @@
+// DADAO Node machine model: cfx register file, run modes, monitor entry/exit,
+// the cfx_pmem DMA engine, cfx_time/cfx_hart counters and async arbitration.
+//
+// Source of truth: spec/DADAO-12 §2/§3/§4 (register file, exception-entry
+// flow, cfx_pmem §4.9, cfx_time/cfx_hart §4.7/§4.10), spec/DADAO-13 §1
+// (hypv cg3 rows), spec/Kaiwu §1-§4 and ADR-0040/ADR-0041/ADR-0042/
+// ADR-0043/ADR-0045.  The Node state is per thread and lives in the ISA
+// object; the SE and Tiny FS paths never touch it.
+#ifndef __ARCH_DADAO_NODE_CFX_HH__
+#define __ARCH_DADAO_NODE_CFX_HH__
+
+#include <cstdint>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+class ThreadContext;
+class Event;
+
+namespace DadaoISA
+{
+
+class ISA;
+
+/** Run modes (spec/DADAO-12 §2.2; same encoding as the PTE HSJU bits). */
+enum NodeMode : uint8_t
+{
+    NodeUser = 0,
+    NodeJail = 1,
+    NodeSupv = 2,
+    NodeHypv = 3,
+};
+
+/** cfxha values the Node machine implements. */
+enum NodeCfxha : uint8_t
+{
+    CfxhaPtw = 4,
+    /** cfx_cache (cfx5).  It has the generic cg0-cg7 rows in NodeState::cfx
+     *  (trap vector, frame, both-axis masks; contract-see §3), plus its cg8
+     *  register face (contract-cache CACHE-03/04).  The I/D state it maintains
+     *  lives in the classic L1 caches, not in NodeState (m16-gem5-021/024). */
+    CfxhaCache = 5,
+    CfxhaHart = 15,
+    CfxhaPmem = 32,
+    CfxhaTime = 34,
+    CfxhaPower = 63,
+};
+
+/** Number of cfx rows in NodeState::cfx / kCfxhaMap (one per implemented
+ *  cfxha; cfx_cache included since m16-gem5-024). */
+inline constexpr int NodeNumCfx = 10;
+
+/** Exception causes (spec/DADAO-12 §4; one-hot). */
+enum NodeCause : uint64_t
+{
+    CauseCfxTrap  = 1ULL << 0,
+    CauseCfxMem   = 1ULL << 1,
+    CauseCfxReg   = 1ULL << 2,
+    CauseCfxEsc   = 1ULL << 3,
+    CauseCfxPerm  = 1ULL << 7,
+    CauseIlli     = 1ULL << 8,
+    CauseUndi     = 1ULL << 9,
+    CauseRasOf    = 1ULL << 10,
+    CauseRasUf    = 1ULL << 11,
+    CauseMalign   = 1ULL << 12,
+    CauseIalign   = 1ULL << 13,
+    /* A page-table fault sets one bit of the flat [38:32]/[56:48] bitmap and
+     * clears the low cause (ADR-0062 D1/D2); CauseCfxMem/CauseCfxPerm mean
+     * non-PTW internal access and cfx source-mask denial only.  No PTWERR
+     * low cause.  Async sources have no cause id at all: their identity is
+     * the source cfxha bitmap in cfx_hart cg9 (spec/DADAO-12 §5.4). */
+};
+
+/** PTE / TLB constants (spec/DADAO-12 §2.2.1-§2.2.4). */
+enum : uint64_t
+{
+    PteP = 1ULL << 0,
+    PteSp = 1ULL << 1,
+    PteD = 1ULL << 2,
+    PteA = 1ULL << 3,
+    PteG = 1ULL << 4,
+    PteX = 1ULL << 5,
+    PteW = 1ULL << 6,
+    PteR = 1ULL << 7,
+};
+
+constexpr unsigned NodeSuperShift = 29;
+constexpr unsigned NodeNormalShift = 16;
+constexpr uint64_t NodePpnMask = 0x00FFFFFFFFFF0000ULL;
+constexpr uint64_t NodeSuperPpnMask = 0x00FFFFFFE0000000ULL;
+constexpr uint64_t NodePtbrMask = 0x00FFFFFFFFFF0000ULL;
+constexpr uint64_t NodeVaMask = 0x000003FFFFFFFFFFULL;
+constexpr uint64_t NodeAddrMask = 0x0000FFFFFFFFFFFFULL;
+constexpr unsigned NodeFragShift = 8;
+
+/** First-level I/D TLB geometry (user ruling 2026-11-19; identical to the
+ *  Kaiwu-Vast RTL): normal pages use NodeTlbSets groups x NodeTlbWays ways
+ *  with the set index taken from VA[16] (the 64 KiB page-number LSB);
+ *  superpages use NodeTlbSuperEntries fully-associative entries.  Both
+ *  arrays replace by LRU; there are no special entries.  Every entry count
+ *  in the model is derived from these constants. */
+constexpr unsigned NodeTlbSets = 2;
+constexpr unsigned NodeTlbWays = 8;
+constexpr unsigned NodeTlbSuperEntries = 4;
+constexpr unsigned NodeTlbSetShift = 16;
+static_assert((NodeTlbSets & (NodeTlbSets - 1)) == 0,
+              "the set index masks VA[16], so the group count must be a "
+              "power of two");
+
+/** One cfx mode row (cg0-cg3, spec/DADAO-12 §3; DADAO-13 §1 for cg3).
+ *  rc4 (the pre-`ADR-0061` `cfx_intr_mask`) is **not defined** any more:
+ *  async source masks live in `cg8 rc1` of cfx0-cfx3, so rc4 keeps no state
+ *  and an access raises CFXREG (spec/DADAO-12 §3).  `rc9`/`rc11` stay
+ *  reserved holes. */
+struct NodeCfxMode
+{
+    uint64_t cfxtrap = 0;
+    uint64_t cfxmem = 0;
+    uint64_t cfxreg = 0;
+    uint64_t cfxexe = 0;
+    uint64_t switchRunMode = 0;
+    uint64_t excpVector = 0;
+    uint64_t cgRegDeleg = 0;
+};
+
+/** One implemented cfx (cfx0/1/2/3/4/5/15/32/34/63). */
+struct NodeCfxRegs
+{
+    NodeCfxMode mode[4];
+    uint64_t scratch[4] = {0, 0, 0, 0};
+    uint64_t cfxId = 0;
+    uint64_t version = 0;
+    uint64_t trapNum = 0;
+    uint64_t excpSyncNum = 0;
+    uint64_t excpAsyncNum = 0;
+    uint64_t escapeNum = 0;
+    uint64_t scratchRegsNum = 0;
+    uint64_t prevRunMode = 0;
+    /* cg5 rc1 (spec/DADAO-12 §3.6): `inner_cfx_code` at exception entry, saved
+     * by step 5 before step 6 rewrites it and restored by `escape` (§5.3). */
+    uint64_t prevCfxCode = 0;
+    uint64_t causeId = 0;
+    uint64_t causeIp = 0;
+    uint64_t causeInfo = 0;
+    /* cg5 rc5 `excp_pending` (sync frame field, spec/DADAO-12 §3.6).  The
+     * async pending bitmap is *not* here: it belongs to `cfx_hart cg9 rc4`
+     * (NodeState::asyncSrcPending, §4.7/§5.4). */
+    uint64_t pending = 0;
+    /* cfx0-cfx3 cg8 rc1 `cfx_<monitor>_async_intr_mask`: bit = source cfxha,
+     * 0 = allow, 1 = mask, reset all ones (ADR-0061 D5). */
+    uint64_t globalCfxIntrMask = 0;
+};
+
+/** One guest-visible TLB entry (ADR-0041 D8/D9).  This is the instruction-side
+ *  shape: it has no D state at all (`instruction` TLB, user ruling 2026-11-19),
+ *  so the I table can never record a dirty bit. */
+struct NodeTlbEntry
+{
+    bool valid = false;
+    unsigned sizeLog2 = NodeNormalShift;
+    uint64_t va = 0;
+    uint64_t pa = 0;
+    uint64_t ptePa = 0;
+    uint64_t hsju = 0;
+    uint8_t frags = 0;
+    bool r = false;
+    bool w = false;
+    bool x = false;
+    bool g = false;
+    uint16_t asid = 0;
+    bool aLocal = false;
+    bool aDirty = false;
+};
+
+/** Data-side TLB entry: the common fields plus the local D state. */
+struct NodeTlbDataEntry : NodeTlbEntry
+{
+    bool dLocal = false;
+    bool dDirty = false;
+};
+
+/** True when the entry has A/D bits that still have to reach its PTE. */
+inline bool
+nodeTlbDirty(const NodeTlbEntry &e)
+{
+    return e.aDirty;
+}
+
+inline bool
+nodeTlbDirty(const NodeTlbDataEntry &e)
+{
+    return e.aDirty || e.dDirty;
+}
+
+/** PTE bits a write-back has to OR in (A/D only; other fields untouched). */
+inline uint64_t
+nodeTlbDirtyBits(const NodeTlbEntry &e)
+{
+    return e.aDirty ? PteA : 0;
+}
+
+inline uint64_t
+nodeTlbDirtyBits(const NodeTlbDataEntry &e)
+{
+    return (e.aDirty ? PteA : 0) | (e.dDirty ? PteD : 0);
+}
+
+inline void
+nodeTlbClearDirty(NodeTlbEntry &e)
+{
+    e.aDirty = false;
+}
+
+inline void
+nodeTlbClearDirty(NodeTlbDataEntry &e)
+{
+    e.aDirty = false;
+    e.dDirty = false;
+}
+
+/** Apply one access to the local A/D state (TLB-14).  The instruction side
+ *  only ever tracks A, so its overload ignores `write`. */
+inline void
+nodeTlbTouch(NodeTlbEntry &e, bool write)
+{
+    (void)write;
+    if (!e.aLocal) {
+        e.aLocal = true;
+        e.aDirty = true;
+    }
+}
+
+inline void
+nodeTlbTouch(NodeTlbDataEntry &e, bool write)
+{
+    if (!e.aLocal) {
+        e.aLocal = true;
+        e.aDirty = true;
+    }
+    if (write && !e.dLocal) {
+        e.dLocal = true;
+        e.dDirty = true;
+    }
+}
+
+/** Seed the local D state from the leaf PTE; the I side has no D bit. */
+inline void
+nodeTlbSetDLocal(NodeTlbEntry &, uint64_t)
+{
+}
+
+inline void
+nodeTlbSetDLocal(NodeTlbDataEntry &e, uint64_t pte)
+{
+    e.dLocal = (pte & PteD) != 0;
+}
+
+/** cfx_pmem SRAM + DMA register state (spec/DADAO-12 §4.9). */
+struct NodeDmaState
+{
+    uint64_t src = 0;
+    uint64_t dst = 0;
+    uint64_t size = 0;
+    uint64_t ctrl = 0;
+    uint64_t status = 0;
+    uint64_t dir = 0;
+    uint64_t irqEn = 0;
+    uint64_t cfxOff = 0;
+    uint64_t pa = 0;
+    uint64_t len = 0;
+};
+
+/** cfx_cache (cfx5) manager state: the two software-visible controls only.
+ *  The cache organisation and its contents belong to the gem5 classic L1
+ *  caches (contract CACHE-05); `cfx_cache_ctrl` drives them through the
+ *  standard maintenance requests.  cfx5 itself is implemented on both
+ *  `cache-model` settings (CACHE-27 `cache-model` dimension): `exist` is
+ *  `0b11` when the classic L1s are wired in (`cache-model=on`) and 0 when
+ *  they are not (`cache-model=off`), where the registers stay accessible but
+ *  a command has no effect (m16-gem5-023). */
+struct NodeCacheState
+{
+    /** `cfx_cache_exist`: bit0 = I cache, bit1 = D cache (CACHE-06). */
+    uint8_t exist = 0;
+    /** `cfx_cache_enable`: reset value = exist; bits above 1 read 0 (CACHE-07). */
+    uint8_t enable = 0;
+    /** `cfx_cache_addr_start`: PA[55:0] (CACHE-18). */
+    uint64_t addrStart = 0;
+    /** `cfx_cache_addr_size`: byte count of the `PA 区间` scope (CACHE-17). */
+    uint64_t addrSize = 0;
+};
+
+/** Per-thread Node architectural state. */
+struct NodeState
+{
+    bool active = false;
+    ThreadContext *tc = nullptr;
+
+    // Geometry (from the DadaoFsWorkload parameters).
+    Addr romBase = 0;
+    Addr romSize = 0;
+    Addr ramBase = 0;
+    Addr ramSize = 0;
+    Addr pmemBase = 0;
+
+    NodeCfxRegs cfx[NodeNumCfx];
+
+    uint8_t runMode = NodeHypv;
+    uint8_t cfxCode = CfxhaPower;
+
+    // Address-space step 1 + step 3 (ADR-0039/ADR-0041).
+    uint64_t ptbr = 0;
+    uint64_t ptwEnable = 0;
+    uint64_t tlbAsid = 0;
+    uint64_t tlbStart = 0;
+    uint64_t tlbSize = 0;
+    uint64_t tlbControl = 0;
+
+    /** First-level TLB, split by side (user ruling 2026-11-19).  Normal pages
+     *  live in the group x way arrays (set = VA[16]); superpages live in the
+     *  fully-associative arrays.  `*Lru` holds the age of each entry: 0 is
+     *  the MRU end and ways - 1 the victim. */
+    NodeTlbEntry itlb[NodeTlbSets][NodeTlbWays];
+    NodeTlbEntry itlbSp[NodeTlbSuperEntries];
+    uint8_t itlbLru[NodeTlbSets][NodeTlbWays] = {};
+    uint8_t itlbSpLru[NodeTlbSuperEntries] = {};
+    NodeTlbDataEntry dtlb[NodeTlbSets][NodeTlbWays];
+    NodeTlbDataEntry dtlbSp[NodeTlbSuperEntries];
+    uint8_t dtlbLru[NodeTlbSets][NodeTlbWays] = {};
+    uint8_t dtlbSpLru[NodeTlbSuperEntries] = {};
+
+    NodeDmaState dma;
+
+    /** cfx_pmem PM region descriptors (spec/DADAO-12 §4.9): cg12/13/14
+     *  rc0-63 start/size/attr, reset 0.  `pmemExist` is the read-only
+     *  `cg8 rc0` value: this test machine reports all 64 regions present
+     *  (the same convention as QEMU/RTL). */
+    uint64_t pmemExist = 0;
+    uint64_t pmemStart[64] = {};
+    uint64_t pmemSize[64] = {};
+    uint64_t pmemAttr[64] = {};
+
+    /** cfx_cache (cfx5) controls; the L1 contents live in the classic caches. */
+    NodeCacheState cache;
+
+    // cfx_time / cfx_hart (1 count = 1 ns, 1 GHz test machine).
+    uint64_t timeBaseTick = 0;
+    uint64_t insnCount = 0;
+    uint64_t timerCmp = 0;
+    uint64_t timerCtrl = 0;
+
+    /* cfx_hart cg9 async capture buffer (spec/DADAO-12 §4.7/§5.4, ADR-0061
+     * D7).  Every async entry overwrites the capture slots wholesale
+     * (`rc0`-`rc3`, plus clearing the delivered bits of `rc4`); there is no
+     * frame phase, no frame_valid and no "software writes 0 to release the
+     * frame".  `asyncSrcFrame`/`asyncSrcPending` are HW-written and
+     * software-read-only (a write is ignored, no exception). */
+    uint64_t asyncPrevRunMode = 0;    /* cg9 rc0 (2 bits)   */
+    uint64_t asyncPrevCfxCode = 0;    /* cg9 rc1 (6 bits)   */
+    uint64_t asyncCauseIp = 0;        /* cg9 rc2 (48 bits)  */
+    uint64_t asyncSrcFrame = 0;       /* cg9 rc3 (HW/RO)    */
+    uint64_t asyncSrcPending = 0;     /* cg9 rc4 (HW/RO)    */
+    uint64_t asyncExcpVector = 0;     /* cg9 rc5 (48 bits)  */
+    /* cg9 rc6 `async_switch_run_mode`: RW, reset 2 (supv); an async entry
+     * uses the current value (spec/DADAO-12 §4.7, m18-spec-006). */
+    uint64_t asyncSwitchRunMode = NodeSupv;
+
+    Event *dmaEvent = nullptr;
+    Event *timerEvent = nullptr;
+
+    /** Word of the instruction currently executing.  `ILLI`/`UNDI`/`CFXREG`/
+     *  `CFXESC` carry the instruction encoding as `excp_cause_info`
+     *  (DADAO-12 §4.1), including the faults raised from the address-translation
+     *  side (a store to the read-only BootROM), where the word is not a
+     *  parameter of the raise call. */
+    uint64_t curInstWord = 0;
+
+    /** Force the next instruction-boundary trace dump (set when an exception
+     *  is masked and the PC skips one instruction). */
+    bool traceForce = false;
+};
+
+/** Release the two scheduled events (ISA destructor). */
+void nodeFreeEvents(NodeState &s);
+
+/** cfxha -> compact index into NodeState::cfx, or -1 if not implemented. */
+int nodeCfxIndex(int cfxha);
+
+/** True for the reserved cfxha codes (6-14, 16-31, 35-61; spec/DADAO-12 §1). */
+bool nodeCfxReserved(uint64_t cfxha);
+
+/** Apply the Node reset values (spec/DADAO-12 §2.1/§3, DADAO-13 §1).
+ *  `cacheExist` is the cfx_cache_exist value of this hart (bit0 I, bit1 D);
+ *  it is `0b11` exactly when the classic L1 caches are wired in
+ *  (m16-gem5-021) and 0 otherwise -- cfx5 is implemented either way, only
+ *  its effect differs (m16-gem5-023) -- and it becomes the reset value of
+ *  cache_enable. */
+void nodeResetState(NodeState &s, ThreadContext *tc, Addr romBase,
+                    Addr romSize, Addr ramBase, Addr ramSize, Addr pmemBase,
+                    uint8_t cacheExist);
+
+/** Two-axis permission check (ADR-0045 D1/D2): `kind` 0..3 =
+ *  trap/mem/reg/exe.  Self bypasses the cfx axis only. */
+bool nodePermDenied(const NodeState &s, int target, int kind);
+
+/** Exception-entry flow for a *synchronous* exception (spec/DADAO-12 §5.2).
+ *  Returns the vector and sets *entered.  Async delivery does not go through
+ *  here: it is a capture-buffer entry (`nodeDeliverAsync`, §5.4). */
+uint64_t nodeCfxEnter(NodeState &s, uint64_t cause, int target,
+                      uint64_t causeIp, uint64_t causeInfo, bool *entered);
+
+/** Raise a synchronous exception into `target` and set the PC (vector on
+ *  entry, pc+4 when masked).  `fromFault` selects the redirect form: a gem5
+ *  `Fault` is invoked from `BaseSimpleCPU::advancePC()`, which does not
+ *  advance the PC afterwards, so the sequential next instruction must be
+ *  installed with the vector (otherwise the vector's first instruction is
+ *  executed twice). */
+void nodeCfxRaise(ThreadContext *tc, NodeState &s, uint64_t cause, int target,
+                  uint64_t causeIp, uint64_t causeInfo, bool fromFault = false);
+
+/** True when `vec` can be fetched as an exception vector: 4-byte aligned, a
+ *  virtual address (cfxha 0) with PTW enabled, or inside RAM / BootROM /
+ *  the hmon, smon or cfx_pmem SRAM (spec/DADAO-12 §5.2 step 7). */
+bool nodeVectorReachable(const NodeState &s, uint64_t vec);
+
+/** Deliver one *execution-time synchronous exception* to the current run-mode
+ *  monitor (spec/DADAO-12 §5.2; the monitor is the first handler for every
+ *  sync exception — `Kaiwu-Vast` has no second route).  `cause` is one-hot.
+ *  When the monitor vector cannot be reached (the only remaining case that
+ *  stops the machine) the simulation ends with the spec/Kaiwu §7.1 code of
+ *  the *entry* run mode. */
+void nodeSyncEnter(ThreadContext *tc, NodeState &s, uint64_t cause, int target,
+                   uint64_t causeIp, uint64_t causeInfo);
+
+/** cfx2rd / cfx2rc (spec/DADAO-12 §3/§4.5/§4.7/§4.9/§4.10).
+ *  Both return false only when the platform cannot service the access at all
+ *  (never for an architectural fault: those enter the monitor and return
+ *  true with the PC already redirected). */
+bool nodeCfxRead(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint8_t cg,
+                 uint8_t rc, uint64_t &out, uint64_t instWord);
+bool nodeCfxWrite(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint8_t cg,
+                  uint8_t rc, uint64_t val, uint64_t instWord);
+
+/** trap / escape (spec/DADAO-12 §5). */
+void nodeTrap(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint32_t immu18);
+bool nodeEscape(ThreadContext *tc, NodeState &s, uint8_t cfxha,
+                uint32_t byteOffset);
+
+/** Deliver every pending asynchronous source that the *current run mode's*
+ *  monitor mask lets through, at one instruction boundary (spec/DADAO-12
+ *  §5.4(三)): one capture, bitmap union, pending cleared, `excp_async_num`
+ *  +1 regardless of how many sources.  The caller must not execute the
+ *  current instruction when this returns true. */
+bool nodeDeliverAsync(ThreadContext *tc, NodeState &s);
+
+/** cfx_time value (ns since reset). */
+uint64_t nodeTimeValue(const NodeState &s);
+
+/** Complete/inspect the cfx_pmem DMA (called by the scheduled event and by
+ *  the register reads/writes). */
+void nodeDmaComplete(ThreadContext *tc, NodeState &s);
+void nodeTimerExpire(ThreadContext *tc, NodeState &s);
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_NODE_CFX_HH__
