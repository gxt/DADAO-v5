+// DADAO syscall-emulation workload: the SE "OS" object.
+//
+// It owns the loader hook (an ET_EXEC DADAO object becomes a DADAO Process)
+// and the minimal Linux-compatible syscall surface of the G1 milestone.  A
+// GDB register description and the FS workload model are deliberately absent.
+#ifndef __ARCH_DADAO_SE_WORKLOAD_HH__
+#define __ARCH_DADAO_SE_WORKLOAD_HH__
+
+#include "arch/dadao/page_size.hh"
+#include "arch/dadao/semihosting.hh"
+#include "base/loader/object_file.hh"
+#include "enums/ByteOrder.hh"
+#include "params/DadaoSEWorkload.hh"
+#include "sim/se_workload.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+class SEWorkload : public gem5::SEWorkload
+{
+  public:
+    using Params = DadaoSEWorkloadParams;
+
+    explicit SEWorkload(const Params &p) :
+        gem5::SEWorkload(p, PageShift), semihosting(p.semihosting)
+    {}
+
+    loader::Arch getArch() const override { return loader::Dadao; }
+
+    ByteOrder byteOrder() const override { return ByteOrder::big; }
+
+    /** Semihosting responder for a bare-metal Tiny/Machine-v5 image loaded by
+     *  SE (m16-gem5-007).  `NULL` -- the default -- keeps every existing SE
+     *  run byte-identical: a `trap` with the semihosting tag then reaches the
+     *  execution core and panics there, exactly as before.  Machine-v5-Tiny
+     *  applications reach the host only through semihosting (spec/Machine-v5
+     *  §5), so a same-ELF comparison against the chipyard harness needs it. */
+    SimObject *getSemihosting() const override { return semihosting; }
+
+    /** Entry point of `trap cfx0, 0` (umon, SBI_UMON_SYSCALL). */
+    void syscall(ThreadContext *tc) override;
+
+    /** Deliver a queued, unblocked signal to `tc` at an instruction boundary
+     *  (asynchronous delivery: a thread that never enters the kernel -- musl's
+     *  cancellation of a spinning thread -- still sees its signals).  Returns
+     *  true when a handler was entered, i.e. the PC moved. */
+    bool deliverPendingSignal(ThreadContext *tc);
+
+    /** Set when the last syscall could not make progress (an empty pipe, a
+     *  child that has not exited, a socket with nothing to read).  inst.cc
+     *  turns it into a SyscallRetryFault, which re-executes the trap instead
+     *  of writing a made-up result -- blocking the host thread would deadlock
+     *  the simulation, because the peer is another guest process. */
+    bool syscallRetry = false;
+
+  private:
+    SimObject *semihosting = nullptr;
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_SE_WORKLOAD_HH__
