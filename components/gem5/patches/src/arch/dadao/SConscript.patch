diff --git a/src/arch/dadao/SConscript b/src/arch/dadao/SConscript
new file mode 100644
index 0000000..e37ac23
--- /dev/null
+++ b/src/arch/dadao/SConscript
@@ -0,0 +1,84 @@
+# DADAO ISA build description (B0 decode + B1/B2/B3/B4/B5/B6/B7 execution).
+Import('*')
+
+if not env['CONF']['USE_DADAO_ISA']:
+    Return()
+
+env.TagImplies('dadao isa', 'gem5 lib')
+env.TagImplies('isa', 'dadao isa')
+
+Source('decoder.cc', tags=['dadao isa'])
+Source('isa.cc', tags=['dadao isa'])
+Source('inst.cc', tags=['dadao isa'])
+Source('decode/decode.cc', tags=['dadao isa'])
+# B1 execution core (plain C++; the assertion harness exec/b1_test.cc is
+# compiled separately by tools/gem5/check_b1.py and is not part of the build).
+Source('exec/b1.cc', tags=['dadao isa'])
+# B2 execution core (plain C++; exec/b2_test.cc is compiled by
+# tools/gem5/check_b2.py and is not part of the build).
+Source('exec/b2.cc', tags=['dadao isa'])
+# B3 execution core (plain C++; exec/b3_test.cc is compiled by
+# tools/gem5/check_b3.py and is not part of the build).
+Source('exec/b3.cc', tags=['dadao isa'])
+# B4 execution core (plain C++; exec/b4_test.cc is compiled by
+# tools/gem5/check_b4.py and is not part of the build).
+Source('exec/b4.cc', tags=['dadao isa'])
+# B5 execution core (plain C++; exec/b5_test.cc is compiled by
+# tools/gem5/check_b5.py and is not part of the build).
+Source('exec/b5.cc', tags=['dadao isa'])
+# B6 execution core (plain C++; exec/b6_test.cc is compiled by
+# tools/gem5/check_b6.py and is not part of the build).
+Source('exec/b6.cc', tags=['dadao isa'])
+# B7 execution core (plain C++; exec/b7_test.cc is compiled by
+# tools/gem5/check_b7.py and is not part of the build).  exec/fp_soft.cc holds
+# the pure-integer IEEE 754 library used only by the B7 core.
+Source('exec/b7.cc', tags=['dadao isa'])
+Source('exec/fp_soft.cc', tags=['dadao isa'])
+# Unified batch dispatcher (plain C++; shared by inst.cc and the
+# GEM5-013t convergence harness exec/converge_test.cc, which is compiled
+# by tools/gem5/check_converge.py and is not part of the build).
+Source('exec/dispatch.cc', tags=['dadao isa'])
+# Syscall-emulation platform (GEM5-014t): host-page-table process, the minimal
+# syscall surface and the SE TLB/MMU/interrupt objects.  The FS memory model is
+# intentionally absent.
+Source('process.cc', tags=['dadao isa'])
+Source('se_workload.cc', tags=['dadao isa'])
+Source('tlb.cc', tags=['dadao isa'])
+# FS Machine-v5-Tiny platform (GEM5-015t): BootROM/SRAM workload, identity
+# segment-checking TLB/MMU, machine-fault -> exit code and semihosting.  These
+# are separate objects from the SE files above; SE behaviour is unchanged.
+Source('fs_machine.cc', tags=['dadao isa'])
+Source('fs_tlb.cc', tags=['dadao isa'])
+Source('fs_workload.cc', tags=['dadao isa'])
+Source('semihosting.cc', tags=['dadao isa'])
+# FS Machine-v5-Node platform (GEM5-016t): cfx register file/monitor, PTW/TLB
+# and the address-routing walk.  Separate sources; SE and Tiny stay untouched.
+Source('node_cfx.cc', tags=['dadao isa'])
+Source('node_tlb.cc', tags=['dadao isa'])
+# Tiny cfx_power/cfx3 hmon model (M13 preamble): separate from the Vast
+# (Node) register file; SE and Vast behaviour is unchanged.
+Source('tiny_cfx.cc', tags=['dadao isa'])
+
+SimObject('DadaoDecoder.py', sim_objects=['DadaoDecoder'], tags=['dadao isa'])
+SimObject('DadaoISA.py', sim_objects=['DadaoISA'], tags=['dadao isa'])
+SimObject('DadaoInterrupts.py', sim_objects=['DadaoInterrupts'],
+          tags=['dadao isa'])
+SimObject('DadaoMMU.py', sim_objects=['DadaoMMU'], tags=['dadao isa'])
+SimObject('DadaoSEWorkload.py', sim_objects=['DadaoSEWorkload'],
+          tags=['dadao isa'])
+SimObject('DadaoTlb.py', sim_objects=['DadaoTlb'], tags=['dadao isa'])
+# DadaoCPU.py only assembles existing SimObjects into a CPU class (same shape
+# as RiscvCPU.py), so it registers no new SimObject of its own.
+SimObject('DadaoCPU.py', sim_objects=[], tags=['dadao isa'])
+SimObject('DadaoFsTlb.py', sim_objects=['DadaoFsTlb'], tags=['dadao isa'])
+SimObject('DadaoFsMMU.py', sim_objects=['DadaoFsMMU'], tags=['dadao isa'])
+SimObject('DadaoFsWorkload.py', sim_objects=['DadaoFsWorkload'],
+          tags=['dadao isa'])
+SimObject('DadaoSemihosting.py', sim_objects=['DadaoSemihosting'],
+          tags=['dadao isa'])
+SimObject('DadaoFsCPU.py', sim_objects=[], tags=['dadao isa'])
+SimObject('DadaoNodeTlb.py', sim_objects=['DadaoNodeTlb'], tags=['dadao isa'])
+SimObject('DadaoNodeMMU.py', sim_objects=['DadaoNodeMMU'], tags=['dadao isa'])
+SimObject('DadaoNodeCPU.py', sim_objects=[], tags=['dadao isa'])
+
+ISADesc('isa/main.isa', tags=['dadao isa'])
