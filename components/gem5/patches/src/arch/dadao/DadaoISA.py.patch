+++ b/src/arch/dadao/DadaoISA.py
@@ -0,0 +1,34 @@
+from m5.objects.BaseISA import BaseISA
+from m5.params import *
+
+
+class DadaoISA(BaseISA):
+    type = "DadaoISA"
+    cxx_class = "gem5::DadaoISA::ISA"
+    cxx_header = "arch/dadao/isa.hh"
+
+    # Wuming per-instruction execution latency (M16: docs/core-wuming-cycle-model.md
+    # parsed into arch/dadao/wuming_cycles.{hh,cc}).  Off by default: the DADAO
+    # ISA then keeps gem5's upstream one-cycle execution model bit for bit, so
+    # every pre-M16 run stays byte-identical.  m16-gem5-003 drives the static
+    # classes, m16-gem5-004 the width/mode classes, m16-gem5-005 the block
+    # transfers (D `ldm`/`stm`: one micro-op per element plus one bus beat per
+    # 8-byte element group; D' register copies: 1+N).
+    #
+    # Instruction counting: the per-element cost lives entirely in the *cycle*
+    # model.  execute() still retires one StaticInst per contract instruction,
+    # so `simInsts` counts an `ldm`/`stm`/`rd2rd` once (a literal N-micro-op
+    # expansion would not change `simInsts` either -- gem5 counts the
+    # macro-instruction).  Chipyard has no instruction counter to align with:
+    # the two engines are compared cycle per instruction, not instruction per
+    # instruction.
+    enable_wuming_cycles = Param.Bool(
+        False, "Drive ISA::extraExecLatency from the wuming cycle table (M16)")
+
+    # B1/B2 multiplication latency is a hardware configuration (R2: initial 3,
+    # configurable 1/2/3).  When set, this gem5 TimingExpr overrides the table
+    # default (3 for B1, 1 for B2 -- both are read from the generated table, never
+    # hand-copied).  NULL keeps the table default.  Any gem5 TimingExpr works;
+    # m16-gem5-004 exercises TimingExprLiteral for the 1/2/3 configurations.
+    wuming_mul_expr = Param.TimingExpr(
+        NULL, "B1/B2 multiplier latency as a gem5 TimingExpr (NULL = table default)")
