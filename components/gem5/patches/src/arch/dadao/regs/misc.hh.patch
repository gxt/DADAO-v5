+// silent read of zero.
+#ifndef __ARCH_DADAO_REGS_MISC_HH__
+#define __ARCH_DADAO_REGS_MISC_HH__
+
+#include "cpu/reg_class.hh"
+#include "debug/MiscRegs.hh"
+
+namespace gem5
+{
+namespace DadaoISA
+{
+namespace misc_reg
+{
+
+inline constexpr RegIndex NumRegs = 1; // placeholder index; no semantic regs
+
+} // namespace misc_reg
+
+inline constexpr RegClass miscRegClass(MiscRegClass, MiscRegClassName,
+        misc_reg::NumRegs, debug::MiscRegs);
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_REGS_MISC_HH__
