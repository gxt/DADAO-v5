+// DADAO gem5 B7 execution core -- pure-integer IEEE 754-2019 arithmetic.
+//
+// Every operation is a bit-exact integer algorithm; no host float/double takes
+// part in computing a result, in rounding or in a comparison.  See fp_soft.hh
+// for the conventions.  spec/SimRISC-07 §1 and contract-fp §1 define the
+// environment (rf0[33:32] rounding, rf0[4:0] accrued flags, tininess detected
+// AFTER rounding, sticky flags) and IEEE 754-2019 defines the operations.
+#include "arch/dadao/exec/fp_soft.hh"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace gem5
+{
+namespace DadaoISA
+{
+namespace exec
+{
+namespace fp
+{
+
+namespace
+{
+
+struct Info
+{
+    unsigned w;         // total bits
+    unsigned fracbits;  // stored fraction bits
+    unsigned eb;        // exponent field bits
+    int bias;
+    unsigned p;         // precision (hidden bit included)
+};
+
+constexpr Info kF32 = {32, 23, 8, 127, 24};
+constexpr Info kF64 = {64, 52, 11, 1023, 53};
+
+const Info &
+infoOf(Fmt fmt)
+{
+    return fmt == Fmt::F32 ? kF32 : kF64;
+}
+
+unsigned
+bitLen(uint64_t value)
+{
+    unsigned n = 0;
+    while (value) {
+        ++n;
+        value >>= 1;
+    }
+    return n;
+}
+
+unsigned
+bitLen128(unsigned __int128 value)
+{
+    const uint64_t hi = uint64_t(value >> 64);
+    return hi ? 64 + bitLen(hi) : bitLen(uint64_t(value));
+}
+
+uint64_t
+maskBits(Fmt fmt, uint64_t bits)
+{
+    return fmt == Fmt::F32 ? (bits & 0xFFFFFFFFull) : bits;
+}
+
+uint64_t
+signBit(Fmt fmt)
+{
+    return uint64_t(1) << (infoOf(fmt).w - 1);
+}
+
+uint64_t
+expAll(Fmt fmt)
+{
+    return (uint64_t(1) << infoOf(fmt).eb) - 1;
+}
+
+uint64_t
+infBits(Fmt fmt, bool sign)
+{
+    const Info &f = infoOf(fmt);
+    return (sign ? signBit(fmt) : 0) | (expAll(fmt) << f.fracbits);
+}
+
+uint64_t
+zeroBits(Fmt fmt, bool sign)
+{
+    return sign ? signBit(fmt) : 0;
+}
+
+enum class Kind : uint8_t
+{
+    Zero,
+    Subnormal,
+    Normal,
+    Inf,
+    NaN,
+};
+
+struct Unpacked
+{
+    Kind kind;
+    bool sign;
+    bool quiet;  // NaN only: quiet bit set
+    uint64_t sig;
+    int64_t exp;
+};
+
+Unpacked
+unpack(Fmt fmt, uint64_t bits)
+{
+    const Info &f = infoOf(fmt);
+    bits = maskBits(fmt, bits);
+    const bool sign = ((bits >> (f.w - 1)) & 1) != 0;
+    const uint64_t expField = (bits >> f.fracbits) & expAll(fmt);
+    const uint64_t frac = bits & ((uint64_t(1) << f.fracbits) - 1);
+    if (expField == expAll(fmt)) {
+        if (frac == 0)
+            return {Kind::Inf, sign, false, 0, 0};
+        const bool quiet = ((frac >> (f.fracbits - 1)) & 1) != 0;
+        return {Kind::NaN, sign, quiet, frac, 0};
+    }
+    if (expField == 0) {
+        if (frac == 0)
+            return {Kind::Zero, sign, false, 0, 0};
+        return {Kind::Subnormal, sign, false, frac,
+                int64_t(1) - int64_t(f.bias) - int64_t(f.fracbits)};
+    }
+    return {Kind::Normal, sign, false, frac | (uint64_t(1) << f.fracbits),
+            int64_t(expField) - int64_t(f.bias) - int64_t(f.fracbits)};
+}
+
+bool
+isNaNPayload(Fmt fmt, uint64_t bits)
+{
+    return unpack(fmt, bits).kind == Kind::NaN;
+}
+
+struct RoundResult
+{
+    uint64_t bits;
+    uint8_t flags;
+};
+
+/** Overflow result: ±Inf or the largest finite, per rounding mode. */
+uint64_t
+overflowBits(Fmt fmt, bool sign, Mode mode)
+{
+    const Info &f = infoOf(fmt);
+    const bool toInf = mode == Mode::RNE ||
+                       (mode == Mode::RUP && !sign) ||
+                       (mode == Mode::RDN && sign);
+    if (toInf)
+        return infBits(fmt, sign);
+    return (sign ? signBit(fmt) : 0) | ((expAll(fmt) - 1) << f.fracbits) |
+           ((uint64_t(1) << f.fracbits) - 1);
+}
+
+/** Round-and-pack, the single rounding step shared by every operation.
+ *
+ * The exact result is (-1)^sign * (sig + eps) * 2^exp with eps in [0, 1) and
+ * eps != 0 iff `sticky`.  Rounding uses rf0[33:32]; tininess is detected after
+ * rounding (spec/SimRISC-07 §1) so UF is only set when the rounded result is
+ * subnormal/zero AND the result is inexact.
+ */
+RoundResult
+roundPack(Fmt fmt, Mode mode, bool sign, unsigned __int128 sig, int64_t exp,
+          bool sticky)
+{
+    const Info &f = infoOf(fmt);
+    if (sig == 0) {
+        if (!sticky)
+            return {zeroBits(fmt, sign), 0};
+        // A non-zero value always has a non-zero significand in every caller;
+        // keep the invariant local and documented instead of mis-rounding.
+        sig = 1;
+        exp -= 1;
+    }
+
+    const int64_t subQuantum =
+        int64_t(1) - int64_t(f.bias) - int64_t(f.fracbits);
+    const int64_t emax = int64_t(f.bias);
+    const int64_t emin = int64_t(1) - int64_t(f.bias);
+
+    const unsigned len = bitLen128(sig);
+    const int64_t msbExp = exp + int64_t(len) - 1;
+    int64_t qexp = msbExp - int64_t(f.p) + 1;
+    if (qexp < subQuantum)
+        qexp = subQuantum;
+
+    unsigned __int128 kept = 0;
+    bool inexact = false;
+    int halfCmp = 0;  // remainder versus half a quantum: <0 / 0 / >0
+
+    if (exp >= qexp) {
+        // Fewer significant bits than the precision: exact left shift plus the
+        // sticky tail (which is always below half a quantum).
+        kept = sig << unsigned(exp - qexp);
+        inexact = sticky;
+        halfCmp = -1;
+    } else {
+        int64_t diff = qexp - exp;
+        if (exp < qexp - 300)
+            diff = 300;
+        if (diff >= 128) {
+            kept = 0;
+            inexact = true;
+            if (diff > 128) {
+                halfCmp = -1;  // 2^(diff-1) >= 2^128 > sig
+            } else {
+                const unsigned __int128 half = (unsigned __int128)1 << 127;
+                halfCmp = sig > half ? 1 : (sig < half ? -1 : (sticky ? 1 : 0));
+            }
+        } else {
+            const unsigned drop = unsigned(diff);
+            kept = sig >> drop;
+            const unsigned __int128 lost =
+                sig & (((unsigned __int128)1 << drop) - 1);
+            inexact = sticky || (lost != 0);
+            if (drop == 0) {
+                halfCmp = -1;  // only the sticky tail, below half a quantum
+            } else {
+                const unsigned __int128 half =
+                    (unsigned __int128)1 << (drop - 1);
+                halfCmp = lost > half ? 1 : (lost < half ? -1 : (sticky ? 1 : 0));
+            }
+        }
+    }
+
+    bool increment = false;
+    if (inexact) {
+        switch (mode) {
+          case Mode::RNE:
+            increment = halfCmp > 0 || (halfCmp == 0 && (kept & 1) != 0);
+            break;
+          case Mode::RTZ:
+            increment = false;
+            break;
+          case Mode::RDN:
+            increment = sign;
+            break;
+          case Mode::RUP:
+            increment = !sign;
+            break;
+        }
+    }
+    if (increment)
+        ++kept;
+    if (kept >> f.p) {  // carried into the next binade
+        kept >>= 1;
+        qexp += 1;
+    }
+
+    if (kept == 0) {
+        const uint8_t flags = inexact ? uint8_t(UF | NX) : uint8_t(0);
+        return {zeroBits(fmt, sign), flags};
+    }
+
+    const int64_t e = qexp + int64_t(bitLen128(kept)) - 1;
+    if (e > emax)
+        return {overflowBits(fmt, sign, mode), uint8_t(OF | NX)};
+    if (e < emin) {
+        // Subnormal (or zero, handled above): tiny AND inexact => UF.
+        const uint8_t flags = inexact ? uint8_t(UF | NX) : uint8_t(0);
+        return {(sign ? signBit(fmt) : 0) | uint64_t(kept), flags};
+    }
+    const uint64_t expField = uint64_t(e + int64_t(f.bias));
+    const uint64_t frac = uint64_t(kept) - (uint64_t(1) << f.fracbits);
+    const uint8_t flags = inexact ? uint8_t(NX) : uint8_t(0);
+    return {(sign ? signBit(fmt) : 0) | (expField << f.fracbits) | frac,
+            flags};
+}
+
+Val
+packed(const RoundResult &r)
+{
+    return {r.bits, r.flags};
+}
+
+/** Compare two finite non-zero magnitudes exactly. */
+int
+magnitudeCmp(const Unpacked &a, const Unpacked &b)
+{
+    const int64_t ea = a.exp + int64_t(bitLen(a.sig)) - 1;
+    const int64_t eb = b.exp + int64_t(bitLen(b.sig)) - 1;
+    if (ea != eb)
+        return ea > eb ? 1 : -1;
+    // Same binade: the exponent difference is the width difference (<= 52).
+    if (a.exp >= b.exp) {
+        const uint64_t as = a.sig << unsigned(a.exp - b.exp);
+        return as > b.sig ? 1 : (as < b.sig ? -1 : 0);
+    }
+    const uint64_t bs = b.sig << unsigned(b.exp - a.exp);
+    return a.sig > bs ? 1 : (a.sig < bs ? -1 : 0);
+}
+
+/** A finite addend with an arbitrary-width integer significand. */
+struct Wide
+{
+    unsigned __int128 sig;
+    int64_t exp;
+    bool sign;
+
+    int64_t
+    top() const
+    {
+        return exp + int64_t(bitLen128(sig)) - 1;
+    }
+};
+
+/** Exact sum/difference of two finite values of the same format.
+ *
+ * `a` must have the larger magnitude (the caller orders them).  A 127-bit
+ * window anchored at a's most significant bit keeps a exactly and keeps every
+ * bit of b down to the window bottom; anything below becomes sticky, which is
+ * safe because the window bottom is always more than two bits below the
+ * rounding quantum (p <= 53, window = 126 bits).
+ */
+Val
+addFinite(Fmt fmt, Mode mode, const Wide &a, const Wide &b)
+{
+    int64_t eWin = a.top() - 126;
+    unsigned __int128 ma = a.sig << unsigned(a.exp - eWin);
+    unsigned __int128 mb = 0;
+    bool sticky = false;
+    const int64_t sb = b.exp - eWin;
+    if (sb >= 0) {
+        mb = b.sig << unsigned(sb);
+    } else {
+        const uint64_t drop = uint64_t(-sb);
+        if (drop >= 128) {
+            sticky = true;
+        } else {
+            mb = b.sig >> drop;
+            if ((b.sig & (((unsigned __int128)1 << drop) - 1)) != 0)
+                sticky = true;
+        }
+    }
+
+    unsigned __int128 m;
+    if (a.sign == b.sign) {
+        m = ma + mb;
+    } else {
+        m = ma - mb;
+        if (m == 0) {
+            // Exact zero sum (|a| >= |b| and the kept windows cancel, so the
+            // sticky tail is necessarily empty).
+            return packed(roundPack(fmt, mode, mode == Mode::RDN, 0, 0,
+                                    false));
+        }
+        if (sticky) {
+            // The dropped tail of b is *subtracted* from the magnitude, so the
+            // exact magnitude is just BELOW m.  Re-encode it as
+            // (2m - 1 + eps) * 2^(eWin-1): strictly between m-1/2 and m, i.e.
+            // on the correct side of the rounding boundary for every mode.
+            // The gap (2^(eWin-1)) is far below the rounding quantum (p <= 53,
+            // the window keeps 126 bits of a), so only the sign of the tail
+            // matters -- and that is exactly what this encodes.
+            m = (m << 1) - 1;
+            eWin -= 1;
+        }
+    }
+    return packed(roundPack(fmt, mode, a.sign, m, eWin, sticky));
+}
+
+Val
+addSub(Fmt fmt, Mode mode, uint64_t aBits, uint64_t bBits, bool negateB)
+{
+    Unpacked a = unpack(fmt, aBits);
+    Unpacked b = unpack(fmt, bBits);
+    if (negateB)
+        b.sign = !b.sign;
+
+    const bool aNaN = a.kind == Kind::NaN;
+    const bool bNaN = b.kind == Kind::NaN;
+    if (aNaN || bNaN) {
+        const bool snan = (aNaN && !a.quiet) || (bNaN && !b.quiet);
+        return {qnanBits(fmt), snan ? uint8_t(NV) : uint8_t(0)};
+    }
+    if (a.kind == Kind::Inf && b.kind == Kind::Inf) {
+        if (a.sign != b.sign)
+            return {qnanBits(fmt), NV};
+        return {infBits(fmt, a.sign), 0};
+    }
+    if (a.kind == Kind::Inf)
+        return {infBits(fmt, a.sign), 0};
+    if (b.kind == Kind::Inf)
+        return {infBits(fmt, b.sign), 0};
+    if (a.kind == Kind::Zero && b.kind == Kind::Zero) {
+        if (a.sign == b.sign)
+            return {zeroBits(fmt, a.sign), 0};
+        return {zeroBits(fmt, mode == Mode::RDN), 0};
+    }
+    if (a.kind == Kind::Zero) {
+        // 0 - b is -b: negateB is not visible in bBits, so flip the sign here
+        // (b is finite and non-zero at this point).
+        return {maskBits(fmt, bBits) ^ (negateB ? signBit(fmt) : 0), 0};
+    }
+    if (b.kind == Kind::Zero)
+        return {maskBits(fmt, aBits), 0};
+
+    if (magnitudeCmp(a, b) < 0) {
+        const Unpacked tmp = a;
+        a = b;
+        b = tmp;
+    }
+    return addFinite(fmt, mode, {a.sig, a.exp, a.sign}, {b.sig, b.exp, b.sign});
+}
+
+/** Round an exact integer magnitude to an integer under `mode`. */
+struct IntRound
+{
+    unsigned __int128 value;
+    bool inexact;
+};
+
+IntRound
+roundToInteger(unsigned __int128 sig, int64_t exp, Mode mode, bool sign)
+{
+    if (exp >= 0) {
+        if (exp > 74 || int64_t(bitLen128(sig)) + exp > 127) {
+            // Far beyond any 64-bit destination: report an obvious overflow.
+            return {((unsigned __int128)1) << 100, true};
+        }
+        return {sig << unsigned(exp), false};
+    }
+    const int64_t diff = -exp;
+    const unsigned drop = diff > 127 ? 127 : unsigned(diff);
+    unsigned __int128 kept = sig >> drop;
+    const unsigned __int128 lost =
+        sig & (((unsigned __int128)1 << drop) - 1);
+    if (lost == 0)
+        return {kept, false};
+    int halfCmp;
+    if (diff > 127) {
+        halfCmp = -1;
+    } else {
+        const unsigned __int128 half = (unsigned __int128)1 << (drop - 1);
+        halfCmp = lost > half ? 1 : (lost < half ? -1 : 0);
+    }
+    bool increment = false;
+    switch (mode) {
+      case Mode::RNE:
+        increment = halfCmp > 0 || (halfCmp == 0 && (kept & 1) != 0);
+        break;
+      case Mode::RTZ:
+        increment = false;
+        break;
+      case Mode::RDN:
+        increment = sign;
+        break;
+      case Mode::RUP:
+        increment = !sign;
+        break;
+    }
+    if (increment)
+        ++kept;
+    return {kept, true};
+}
+
+uint64_t
+intWidthMask(unsigned width)
+{
+    return width >= 64 ? ~uint64_t(0) : ((uint64_t(1) << width) - 1);
+}
+
+/** Widen a `width`-bit integer result to the 64-bit rd register.
+ *
+ * The SimRISC convention for a 32-bit result in a 64-bit register is sign
+ * extension for the signed variants and zero extension for the unsigned ones
+ * (spec/SimRISC-08 §1.1 for the integer ops; the f2i naming `it`/`ut` follows
+ * the same rule).
+ */
+uint64_t
+widenInt(uint64_t value, unsigned width, bool isSigned)
+{
+    if (!isSigned || width >= 64)
+        return value;
+    const uint64_t sign = uint64_t(1) << (width - 1);
+    return (value ^ sign) - sign;
+}
+
+/** Integer square root of a 128-bit value (Newton, converges from above). */
+unsigned __int128
+isqrt128(unsigned __int128 value)
+{
+    if (value == 0)
+        return 0;
+    unsigned __int128 x =
+        ((unsigned __int128)1) << ((bitLen128(value) + 1) / 2);
+    while (true) {
+        const unsigned __int128 y = (x + value / x) >> 1;
+        if (y >= x)
+            return x;
+        x = y;
+    }
+}
+
+/** Ordering of the boolean "product is the larger addend" question. */
+bool
+wideGreater(const Wide &a, const Wide &b)
+{
+    const int64_t ta = a.top(), tb = b.top();
+    if (ta != tb)
+        return ta > tb;
+    // Same top bit: the exponent difference equals the width difference, so
+    // left-aligning the narrower one needs at most 53 bits.
+    if (a.exp >= b.exp)
+        return (a.sig << unsigned(a.exp - b.exp)) > b.sig;
+    return a.sig > (b.sig << unsigned(b.exp - a.exp));
+}
+
+} // anonymous namespace
+
+uint16_t
+classify(Fmt fmt, uint64_t bits)
+{
+    const Info &f = infoOf(fmt);
+    bits = maskBits(fmt, bits);
+    const bool sign = ((bits >> (f.w - 1)) & 1) != 0;
+    const uint64_t expField = (bits >> f.fracbits) & expAll(fmt);
+    const uint64_t frac = bits & ((uint64_t(1) << f.fracbits) - 1);
+    unsigned bit = 0;
+    if (expField == expAll(fmt)) {
+        if (frac == 0)
+            bit = sign ? 2 : 9;                       // -Inf / +Inf
+        else
+            bit = ((frac >> (f.fracbits - 1)) & 1) ? 1 : 0;  // qNaN / sNaN
+    } else if (expField == 0) {
+        if (frac == 0)
+            bit = sign ? 5 : 6;                       // -0 / +0
+        else
+            bit = sign ? 4 : 7;                       // -Sub / +Sub
+    } else {
+        bit = sign ? 3 : 8;                           // -N / +N
+    }
+    return uint16_t(1u << bit);
+}
+
+bool
+isNaNBits(Fmt fmt, uint64_t bits)
+{
+    return isNaNPayload(fmt, bits);
+}
+
+bool
+isSNaNBits(Fmt fmt, uint64_t bits)
+{
+    const Unpacked u = unpack(fmt, bits);
+    return u.kind == Kind::NaN && !u.quiet;
+}
+
+uint64_t
+qnanBits(Fmt fmt)
+{
+    const Info &f = infoOf(fmt);
+    return (expAll(fmt) << f.fracbits) | (uint64_t(1) << (f.fracbits - 1));
+}
+
+uint64_t
+snanBits(Fmt fmt)
+{
+    const Info &f = infoOf(fmt);
+    return (expAll(fmt) << f.fracbits) | 1;
+}
+
+Val
+add(Fmt fmt, Mode mode, uint64_t a, uint64_t b)
+{
+    return addSub(fmt, mode, a, b, false);
+}
+
+Val
+sub(Fmt fmt, Mode mode, uint64_t a, uint64_t b)
+{
+    return addSub(fmt, mode, a, b, true);
+}
+
+Val
+mul(Fmt fmt, Mode mode, uint64_t a, uint64_t b)
+{
+    const Unpacked ua = unpack(fmt, a);
+    const Unpacked ub = unpack(fmt, b);
+    const bool sign = ua.sign != ub.sign;
+    const bool aNaN = ua.kind == Kind::NaN, bNaN = ub.kind == Kind::NaN;
+    if (aNaN || bNaN) {
+        const bool snan = (aNaN && !ua.quiet) || (bNaN && !ub.quiet);
+        return {qnanBits(fmt), snan ? uint8_t(NV) : uint8_t(0)};
+    }
+    if (ua.kind == Kind::Inf || ub.kind == Kind::Inf) {
+        if (ua.kind == Kind::Zero || ub.kind == Kind::Zero)
+            return {qnanBits(fmt), NV};
+        return {infBits(fmt, sign), 0};
+    }
+    if (ua.kind == Kind::Zero || ub.kind == Kind::Zero)
+        return {zeroBits(fmt, sign), 0};
+    const unsigned __int128 product =
+        (unsigned __int128)ua.sig * ub.sig;
+    return packed(
+        roundPack(fmt, mode, sign, product, ua.exp + ub.exp, false));
+}
+
+Val
+div(Fmt fmt, Mode mode, uint64_t a, uint64_t b)
+{
+    const Unpacked ua = unpack(fmt, a);
+    const Unpacked ub = unpack(fmt, b);
+    const bool sign = ua.sign != ub.sign;
+    const bool aNaN = ua.kind == Kind::NaN, bNaN = ub.kind == Kind::NaN;
+    if (aNaN || bNaN) {
+        const bool snan = (aNaN && !ua.quiet) || (bNaN && !ub.quiet);
+        return {qnanBits(fmt), snan ? uint8_t(NV) : uint8_t(0)};
+    }
+    if (ua.kind == Kind::Inf) {
+        if (ub.kind == Kind::Inf)
+            return {qnanBits(fmt), NV};
+        return {infBits(fmt, sign), 0};
+    }
+    if (ub.kind == Kind::Inf)
+        return {zeroBits(fmt, sign), 0};
+    if (ub.kind == Kind::Zero) {
+        if (ua.kind == Kind::Zero)
+            return {qnanBits(fmt), NV};
+        return {infBits(fmt, sign), DZ};
+    }
+    if (ua.kind == Kind::Zero)
+        return {zeroBits(fmt, sign), 0};
+
+    // Long division with a 127-bit numerator: at least p + 3 quotient bits.
+    const unsigned shift = 127 - bitLen(ua.sig);
+    const unsigned __int128 num = (unsigned __int128)ua.sig << shift;
+    const unsigned __int128 quot = num / ub.sig;
+    const bool sticky = (num % ub.sig) != 0;
+    return packed(roundPack(fmt, mode, sign, quot, ua.exp - ub.exp -
+                                                  int64_t(shift), sticky));
+}
+
+Val
+rem(Fmt fmt, uint64_t a, uint64_t b)
+{
+    const Unpacked ua = unpack(fmt, a);
+    const Unpacked ub = unpack(fmt, b);
+    const bool aNaN = ua.kind == Kind::NaN, bNaN = ub.kind == Kind::NaN;
+    if (aNaN || bNaN) {
+        const bool snan = (aNaN && !ua.quiet) || (bNaN && !ub.quiet);
+        return {qnanBits(fmt), snan ? uint8_t(NV) : uint8_t(0)};
+    }
+    if (ua.kind == Kind::Inf)
+        return {qnanBits(fmt), NV};
+    if (ub.kind == Kind::Zero)
+        return {qnanBits(fmt), NV};
+    if (ub.kind == Kind::Inf || ua.kind == Kind::Zero)
+        return {maskBits(fmt, a), 0};
+
+    // |x| >= |y| is required for a non-zero quotient.  Both significands are
+    // left-aligned to 64 bits so the truncated quotient and its parity can be
+    // produced with a bounded (<= ~2100 step) doubling loop.
+    auto align = [](const Unpacked &u, uint64_t &sig, int64_t &exp) {
+        const unsigned sh = 64 - bitLen(u.sig);
+        sig = u.sig << sh;
+        exp = u.exp - int64_t(sh);
+    };
+    uint64_t xa = 0, ya = 0;
+    int64_t ea = 0, eb = 0;
+    align(ua, xa, ea);
+    align(ub, ya, eb);
+
+    const int cmp = (ea != eb) ? (ea > eb ? 1 : -1)
+                               : (xa > ya ? 1 : (xa < ya ? -1 : 0));
+    if (cmp < 0)
+        return {maskBits(fmt, a), 0};  // |x| < |y| => n == 0 => x
+
+    uint64_t parity = 0;
+    uint64_t rest = xa % ya;
+    if (ea == eb)
+        parity = (xa / ya) & 1;
+    for (int64_t i = ea - eb; i > 0; --i) {
+        const unsigned __int128 twice = (unsigned __int128)rest << 1;
+        parity = (twice >= ya) ? 1 : 0;
+        rest = uint64_t(twice >= ya ? twice - ya : twice);
+    }
+
+    // n = nearest integer to x/y, ties to even.
+    const unsigned __int128 twice = (unsigned __int128)rest << 1;
+    bool up;
+    if (twice > ya)
+        up = true;
+    else if (twice < ya)
+        up = false;
+    else
+        up = (parity & 1) != 0;
+    const uint64_t mag = up ? (ya - rest) : rest;
+    const bool sign = up ? !ua.sign : ua.sign;
+    if (mag == 0)
+        return {zeroBits(fmt, ua.sign), 0};  // exact multiple: sign of x
+    return packed(roundPack(fmt, Mode::RNE, sign, mag, eb, false));
+}
+
+Val
+sclb(Fmt fmt, Mode mode, uint64_t x, int64_t n)
+{
+    const Unpacked u = unpack(fmt, x);
+    if (u.kind == Kind::NaN)
+        return {qnanBits(fmt), u.quiet ? uint8_t(0) : uint8_t(NV)};
+    if (u.kind == Kind::Inf)
+        return {infBits(fmt, u.sign), 0};
+    if (u.kind == Kind::Zero)
+        return {zeroBits(fmt, u.sign), 0};
+    // The exponent is only compared against the format range, so clamping it
+    // far outside that range avoids int64 overflow without iterating over |n|.
+    constexpr int64_t kClamp = 100000;
+    int64_t exp;
+    if (n >= kClamp || n <= -kClamp) {
+        exp = n > 0 ? kClamp : -kClamp;
+    } else {
+        exp = u.exp + n;  // |n| < 100000 and u.exp is a format exponent
+        if (exp > kClamp)
+            exp = kClamp;
+        else if (exp < -kClamp)
+            exp = -kClamp;
+    }
+    return packed(roundPack(fmt, mode, u.sign, u.sig, exp, false));
+}
+
+Val
+sqrt(Fmt fmt, Mode mode, uint64_t x)
+{
+    const Unpacked u = unpack(fmt, x);
+    if (u.kind == Kind::NaN)
+        return {qnanBits(fmt), u.quiet ? uint8_t(0) : uint8_t(NV)};
+    if (u.kind == Kind::Zero)
+        return {zeroBits(fmt, u.sign), 0};  // rootn(-0, 2) model: -0
+    if (u.sign)
+        return {qnanBits(fmt), NV};
+    if (u.kind == Kind::Inf)
+        return {infBits(fmt, false), 0};
+
+    uint64_t sig = u.sig;
+    int64_t exp = u.exp;
+    if (exp & 1) {  // make the exponent even; sig <= 2^54
+        sig <<= 1;
+        exp -= 1;
+    }
+    const unsigned len = bitLen(sig);
+    const unsigned pad = (126 - len) / 2;  // sqrt then has ~63-64 bits
+    const unsigned __int128 radicand = (unsigned __int128)sig << (2 * pad);
+    const unsigned __int128 root = isqrt128(radicand);
+    const bool sticky = root * root != radicand;
+    return packed(roundPack(fmt, mode, false, root, exp / 2 - int64_t(pad),
+                            sticky));
+}
+
+Val
+fma(Fmt fmt, Mode mode, uint64_t a, uint64_t b, uint64_t c)
+{
+    const Unpacked ua = unpack(fmt, a);
+    const Unpacked ub = unpack(fmt, b);
+    const Unpacked uc = unpack(fmt, c);
+    const bool psign = ua.sign != ub.sign;
+
+    const bool aNaN = ua.kind == Kind::NaN;
+    const bool bNaN = ub.kind == Kind::NaN;
+    const bool cNaN = uc.kind == Kind::NaN;
+    const bool zeroTimesInf =
+        (ua.kind == Kind::Zero && ub.kind == Kind::Inf) ||
+        (ua.kind == Kind::Inf && ub.kind == Kind::Zero);
+    if (aNaN || bNaN || cNaN || zeroTimesInf) {
+        // 0 x Inf outranks the qNaN propagation of the addend (spec §2.5).
+        bool nv = zeroTimesInf;
+        if (aNaN && !ua.quiet)
+            nv = true;
+        if (bNaN && !ub.quiet)
+            nv = true;
+        if (cNaN && !uc.quiet)
+            nv = true;
+        return {qnanBits(fmt), nv ? uint8_t(NV) : uint8_t(0)};
+    }
+
+    const bool pInf = ua.kind == Kind::Inf || ub.kind == Kind::Inf;
+    if (pInf) {
+        if (uc.kind == Kind::Inf) {
+            if (psign != uc.sign)
+                return {qnanBits(fmt), NV};
+            return {infBits(fmt, psign), 0};
+        }
+        return {infBits(fmt, psign), 0};
+    }
+    const bool pZero = ua.kind == Kind::Zero || ub.kind == Kind::Zero;
+    if (pZero) {
+        if (uc.kind == Kind::Inf)
+            return {infBits(fmt, uc.sign), 0};
+        if (uc.kind == Kind::Zero) {
+            if (psign == uc.sign)
+                return {zeroBits(fmt, psign), 0};
+            return {zeroBits(fmt, mode == Mode::RDN), 0};
+        }
+        return {maskBits(fmt, c), 0};
+    }
+    if (uc.kind == Kind::Inf)
+        return {infBits(fmt, uc.sign), 0};
+
+    const Wide product{(unsigned __int128)ua.sig * ub.sig, ua.exp + ub.exp,
+                       psign};
+    if (uc.kind == Kind::Zero)
+        return packed(
+            roundPack(fmt, mode, psign, product.sig, product.exp, false));
+
+    const Wide addend{uc.sig, uc.exp, uc.sign};
+    if (wideGreater(product, addend))
+        return addFinite(fmt, mode, product, addend);
+    return addFinite(fmt, mode, addend, product);
+}
+
+Val
+fromInt(Fmt fmt, Mode mode, uint64_t value, unsigned width, bool isSigned)
+{
+    const uint64_t mask = intWidthMask(width);
+    uint64_t raw = value & mask;
+    bool sign = false;
+    uint64_t mag = raw;
+    if (isSigned) {
+        sign = ((raw >> (width - 1)) & 1) != 0;
+        if (sign)
+            mag = ((~raw) + 1) & mask;
+    }
+    if (mag == 0)
+        return {zeroBits(fmt, false), 0};
+    return packed(roundPack(fmt, mode, sign, mag, 0, false));
+}
+
+Val
+toInt(Fmt fmt, Mode mode, uint64_t bits, unsigned width, bool isSigned)
+{
+    const Unpacked u = unpack(fmt, bits);
+    const uint64_t umax = intWidthMask(width);
+    const uint64_t smax =
+        width >= 64 ? (~uint64_t(0) >> 1) : ((uint64_t(1) << (width - 1)) - 1);
+    const uint64_t sminMag = width >= 64 ? (uint64_t(1) << 63)
+                                         : (uint64_t(1) << (width - 1));
+    const uint64_t posMax = isSigned ? smax : umax;
+    const uint64_t negMaxBits = uint64_t(0) - sminMag;
+
+    const auto widen = [&](uint64_t pattern) {
+        return widenInt(pattern & umax, width, isSigned);
+    };
+
+    if (u.kind == Kind::NaN)
+        return {widen(posMax), NV};  // NaN has no sign: target maximum
+    if (u.kind == Kind::Inf) {
+        if (u.sign)
+            return {widen(isSigned ? negMaxBits : 0), NV};
+        return {widen(posMax), NV};
+    }
+    if (u.kind == Kind::Zero)
+        return {0, 0};
+
+    const IntRound rounded = roundToInteger(u.sig, u.exp, mode, u.sign);
+    if (rounded.value == 0) {
+        // The rounded integer is 0: representable in every target width, so
+        // only inexact (not invalid) applies.
+        return {0, rounded.inexact ? uint8_t(NX) : uint8_t(0)};
+    }
+    if (u.sign) {
+        if (!isSigned || rounded.value > sminMag) {
+            // Negative value outside the destination range: saturate, NV only.
+            return {widen(isSigned ? negMaxBits : 0), NV};
+        }
+        return {widen(uint64_t(uint64_t(0) - uint64_t(rounded.value))),
+                rounded.inexact ? uint8_t(NX) : uint8_t(0)};
+    }
+    if (rounded.value > posMax)
+        return {widen(posMax), NV};
+    return {widen(uint64_t(rounded.value)),
+            rounded.inexact ? uint8_t(NX) : uint8_t(0)};
+}
+
+Val
+convert(Fmt dst, Mode mode, Fmt src, uint64_t bits)
+{
+    const Info &df = infoOf(dst);
+    const Info &sf = infoOf(src);
+    const Unpacked u = unpack(src, bits);
+    if (u.kind == Kind::NaN) {
+        const uint64_t srcFrac = u.sig & ((uint64_t(1) << sf.fracbits) - 1);
+        uint64_t dstFrac;
+        if (df.fracbits >= sf.fracbits) {
+            dstFrac = srcFrac << (df.fracbits - sf.fracbits);
+        } else {
+            const unsigned shift = sf.fracbits - df.fracbits;
+            dstFrac = srcFrac >> shift;
+            if (dstFrac == 0 && srcFrac != 0)
+                dstFrac = 1;  // never turn a NaN into an infinity
+        }
+        if (dstFrac == 0)
+            dstFrac = 1;
+        if (!u.quiet)
+            dstFrac |= uint64_t(1) << (df.fracbits - 1);
+        return {(u.sign ? signBit(dst) : 0) | (expAll(dst) << df.fracbits) |
+                    dstFrac,
+                u.quiet ? uint8_t(0) : uint8_t(NV)};
+    }
+    if (u.kind == Kind::Inf)
+        return {infBits(dst, u.sign), 0};
+    if (u.kind == Kind::Zero)
+        return {zeroBits(dst, u.sign), 0};
+    return packed(roundPack(dst, mode, u.sign, u.sig, u.exp, false));
+}
+
+Val
+roundInt(Fmt fmt, uint64_t bits, uint8_t onehot, Mode rfMode)
+{
+    const Info &f = infoOf(fmt);
+    const Unpacked u = unpack(fmt, bits);
+    if (u.kind == Kind::NaN)
+        return {qnanBits(fmt), u.quiet ? uint8_t(0) : uint8_t(NV)};
+    if (u.kind == Kind::Inf || u.kind == Kind::Zero)
+        return {maskBits(fmt, bits), 0};
+    if (u.exp >= 0)
+        return {maskBits(fmt, bits), 0};
+    const int64_t msbExp = u.exp + int64_t(bitLen(u.sig)) - 1;
+    if (msbExp >= int64_t(f.p))
+        return {maskBits(fmt, bits), 0};  // |x| >= 2^p: already an integer
+
+    enum class Dir
+    {
+        Even,
+        Away,
+        Zero,
+        Up,
+        Down,
+    };
+    Dir dir;
+    switch (onehot) {
+      case 0x01: dir = Dir::Even; break;
+      case 0x02: dir = Dir::Away; break;
+      case 0x04: dir = Dir::Zero; break;
+      case 0x08: dir = Dir::Up; break;
+      case 0x10: dir = Dir::Down; break;
+      case 0x20:
+        switch (rfMode) {
+          case Mode::RNE: dir = Dir::Even; break;
+          case Mode::RTZ: dir = Dir::Zero; break;
+          case Mode::RDN: dir = Dir::Down; break;
+          default: dir = Dir::Up; break;
+        }
+        break;
+      default:
+        // Legality (encode_onehot) rejects every other code before we get here.
+        dir = Dir::Even;
+        break;
+    }
+
+    const uint64_t drop = uint64_t(-u.exp);
+    uint64_t kept = 0;
+    uint64_t lost = u.sig;
+    int halfCmp = -1;
+    if (drop < 64) {
+        kept = u.sig >> drop;
+        lost = u.sig & ((uint64_t(1) << drop) - 1);
+        if (lost != 0) {
+            const uint64_t half = uint64_t(1) << (drop - 1);
+            halfCmp = lost > half ? 1 : (lost < half ? -1 : 0);
+        }
+    }
+    bool increment = false;
+    if (lost != 0) {
+        switch (dir) {
+          case Dir::Even:
+            increment = halfCmp > 0 || (halfCmp == 0 && (kept & 1) != 0);
+            break;
+          case Dir::Away:
+            increment = halfCmp >= 0;
+            break;
+          case Dir::Zero:
+            increment = false;
+            break;
+          case Dir::Up:
+            increment = !u.sign;
+            break;
+          case Dir::Down:
+            increment = u.sign;
+            break;
+        }
+    }
+    const uint64_t n = kept + (increment ? 1 : 0);
+    const uint8_t flags =
+        (onehot == 0x20 && lost != 0) ? uint8_t(NX) : uint8_t(0);
+    if (n == 0)
+        return {zeroBits(fmt, u.sign), flags};  // the zero keeps the sign
+    return {roundPack(fmt, Mode::RNE, u.sign, n, 0, false).bits, flags};
+}
+
+Cmp
+compare(Fmt fmt, uint64_t a, uint64_t b)
+{
+    const Unpacked ua = unpack(fmt, a);
+    const Unpacked ub = unpack(fmt, b);
+    if (ua.kind == Kind::NaN || ub.kind == Kind::NaN)
+        return Cmp::Unordered;
+    if (ua.kind == Kind::Zero && ub.kind == Kind::Zero)
+        return Cmp::Equal;
+    if (ua.kind == Kind::Zero)
+        return ub.sign ? Cmp::Greater : Cmp::Less;
+    if (ub.kind == Kind::Zero)
+        return ua.sign ? Cmp::Less : Cmp::Greater;
+    if (ua.sign != ub.sign)
+        return ua.sign ? Cmp::Less : Cmp::Greater;
+
+    int mag;
+    if (ua.kind == Kind::Inf && ub.kind == Kind::Inf)
+        mag = 0;
+    else if (ua.kind == Kind::Inf)
+        mag = 1;
+    else if (ub.kind == Kind::Inf)
+        mag = -1;
+    else
+        mag = magnitudeCmp(ua, ub);
+    if (mag == 0)
+        return Cmp::Equal;
+    if (ua.sign)
+        return mag > 0 ? Cmp::Less : Cmp::Greater;
+    return mag > 0 ? Cmp::Greater : Cmp::Less;
+}
