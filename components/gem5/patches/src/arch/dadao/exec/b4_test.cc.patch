+execOpOf(TestOp op)
+{
+    switch (op) {
+      case T_ADD: return exec::B4Op::Add;
+      case T_SUB: return exec::B4Op::Sub;
+      case T_MUL: return exec::B4Op::Mul;
+      case T_DIV: return exec::B4Op::Div;
+      case T_REM: return exec::B4Op::Rem;
+      case T_CMP: return exec::B4Op::Cmp;
+      case T_SHL: return exec::B4Op::Shl;
+      case T_ROL: return exec::B4Op::Rol;
+      case T_SHRU: return exec::B4Op::ShrU;
+      case T_SHRS: return exec::B4Op::ShrS;
+      case T_REV: return exec::B4Op::Rev;
+    }
+    return exec::B4Op::Add;
