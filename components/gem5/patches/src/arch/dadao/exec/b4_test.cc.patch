+/*
+ * DADAO gem5 B4 execution assertions (GEM5-009t).
+ *
+ * Standalone C++17 harness (no gem5 headers): compiled by
+ * `tools/gem5/check_b4.py` against
+ * src/arch/dadao/{exec/b4.cc,exec/b4_test.cc,decode/decode.cc}.
+ *
+ * Everything here is derived from spec/SimRISC-08, spec/SimRISC-09,
+ * spec/SimRISC-10, spec/SimRISC-04, contract-isa §6/§10/§11/§12 and
+ * contracts/opcodes.yaml -- never from another implementation:
+ *   * the 63 B4 ids are listed one by one (batch membership is never guessed
+ *     from mnemonics; shl/rol/shr each have an orrr and an orri id, and
+ *     add/sub/mul/div/rem/cmp share mnemonics across the 32/16/8-bit widths)
+ *     and must equal the live decode-table B4 set;
+ *   * expected values are computed by an independent oracle table: sources are
+ *     truncated to the operation width before the operation, results are
+ *     zero/sign-extended over all 64 bits, compare is -1/0/1 over all 64 bits,
+ *     and divide/remainder use the contract's constant results;
+ *   * statically illegal instructions (dst rd0, orri immu6 >= width, non
+ *     one-hot / k >= S rev) raise ILLI for every id with zero register reads
+ *     and zero writes;
+ *   * rev.t/w/b are checked for every legal k and every block, including
+ *     k=8 bswap vectors and the "k=1 is per-block, not 64-bit" rule.
+ */
