+// ---------------------------------------------------------------------------
+// Independent value oracles.
+// ---------------------------------------------------------------------------
+
+uint64_t
+maskWidth(unsigned width)
+{
+    return width >= 64 ? ~uint64_t(0) : ((uint64_t(1) << width) - 1);
+}
+
+uint64_t
+signedBits(uint64_t value, unsigned width)
+{
+    const uint64_t mask = maskWidth(width);
+    value &= mask;
+    if (((value >> (width - 1)) & 1) != 0)
+        value |= ~mask;
+    return value;
+}
+
+uint64_t
+extend(uint64_t value, unsigned width, bool isSigned)
+{
+    const uint64_t low = value & maskWidth(width);
+    return isSigned ? signedBits(low, width) : low;
+}
+
+uint64_t
+compareValue(bool less, bool equal)
+{
+    return less ? ~uint64_t(0) : (equal ? 0 : 1);
+}
+
+uint64_t
+expectedArith(TestOp op, unsigned width, bool isSigned, uint64_t a,
+              uint64_t b)
+{
+    const uint64_t mask = maskWidth(width);
+    a &= mask;
+    b &= mask;
+    switch (op) {
+      case T_ADD:
+        return extend(a + b, width, isSigned);
+      case T_SUB:
+        return extend(a - b, width, isSigned);
+      case T_MUL:
+        return extend(static_cast<uint64_t>(
+                          static_cast<unsigned __int128>(a) * b),
+                      width, isSigned);
+      case T_CMP:
+        if (isSigned) {
+            const int64_t sa = static_cast<int64_t>(signedBits(a, width));
+            const int64_t sb = static_cast<int64_t>(signedBits(b, width));
+            return compareValue(sa < sb, sa == sb);
+        }
+        return compareValue(a < b, a == b);
+      case T_DIV:
+      case T_REM: {
+        const bool div = op == T_DIV;
+        if (!isSigned) {
+            if (b == 0)
+                return div ? mask : a;
+            return div ? (a / b) : (a % b);
+        }
+        const int64_t sa = static_cast<int64_t>(signedBits(a, width));
+        const int64_t sb = static_cast<int64_t>(signedBits(b, width));
+        const int64_t intMin = -(static_cast<int64_t>(1) << (width - 1));
+        if (sb == 0)
+            return div ? ~uint64_t(0) : signedBits(a, width);
+        if (sa == intMin && sb == -1)
+            return div ? signedBits(uint64_t(1) << (width - 1), width) : 0;
+        return div ? signedBits(static_cast<uint64_t>(sa / sb), width)
+                   : signedBits(static_cast<uint64_t>(sa % sb), width);
+      }
+      default:
+        return 0;
+    }
+}
+
+uint64_t
+expectedShift(TestOp op, unsigned width, uint64_t a, unsigned amount)
+{
+    const uint64_t mask = maskWidth(width);
+    const unsigned shamt = amount & (width - 1);
+    a &= mask;
+    switch (op) {
+      case T_SHL:
+        return (a << shamt) & mask;
+      case T_ROL:
+        return ((a << shamt) | (a >> ((width - shamt) & (width - 1)))) &
+               mask;
+      case T_SHRU:
+        return a >> shamt;
+      case T_SHRS: {
+        uint64_t result = a >> shamt;
+        if (shamt != 0 && ((a >> (width - 1)) & 1) != 0)
+            result |= mask & ~(mask >> shamt);
+        return signedBits(result, width);
+      }
+      default:
+        return 0;
+    }
+}
+
+/** Independent per-block reverse oracle (contract-isa §6.4.3). */
+uint64_t
+expectedRev(uint64_t value, unsigned blockSize, unsigned k)
+{
+    const unsigned blocks = 64 / blockSize;
+    const unsigned units = blockSize / k;
+    const uint64_t unitMask = maskWidth(k);
+    uint64_t result = 0;
+    for (unsigned block = 0; block < blocks; ++block) {
+        const unsigned blockBase = block * blockSize;
+        uint64_t out = 0;
+        for (unsigned unit = 0; unit < units; ++unit) {
+            const uint64_t bits =
+                (value >> (blockBase + unit * k)) & unitMask;
+            out |= bits << ((units - 1 - unit) * k);
+        }
+        result |= out << blockBase;
+    }
+    return result;
+}
