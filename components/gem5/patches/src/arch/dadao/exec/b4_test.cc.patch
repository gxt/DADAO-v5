+// ---------------------------------------------------------------------------
+// 6. Divide / remainder: truncation, constants, rd0 divisor.
+// ---------------------------------------------------------------------------
+
+void
+checkDivRem()
+{
+    struct DivCase
+    {
+        const char *id;
+        uint64_t a;
+        uint64_t b;
+        uint64_t expected;
+    };
+    const DivCase cases[] = {
+        // C99 truncation toward zero; remainder sign = dividend sign.
+        {"div.st_orrr_rd", 0xFFFFFFF9ULL, 3, ~uint64_t(0) - 1},   // -7/3=-2
+        {"div.st_orrr_rd", 7, 0xFFFFFFFDULL, ~uint64_t(0) - 1},    // 7/-3=-2
+        {"div.st_orrr_rd", 0xFFFFFFF9ULL, 0xFFFFFFFDULL, 2},       // -7/-3=2
+        {"rem.st_orrr_rd", 0xFFFFFFF9ULL, 3, ~uint64_t(0)},        // -7%3=-1
+        {"rem.st_orrr_rd", 7, 0xFFFFFFFDULL, 1},                   // 7%-3=1
+        {"rem.st_orrr_rd", 0xFFFFFFF9ULL, 0xFFFFFFFDULL, ~uint64_t(0)},
+        {"div.sw_orrr_rd", 0xFFF9ULL, 3, 0xFFFFFFFFFFFFFFFEULL},
+        {"div.sw_orrr_rd", 7, 0xFFFDULL, 0xFFFFFFFFFFFFFFFEULL},
+        {"div.sw_orrr_rd", 0xFFF9ULL, 0xFFFDULL, 2},
+        {"rem.sw_orrr_rd", 0xFFF9ULL, 3, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.sw_orrr_rd", 7, 0xFFFDULL, 1},
+        {"rem.sw_orrr_rd", 0xFFF9ULL, 0xFFFDULL, 0xFFFFFFFFFFFFFFFFULL},
+        {"div.sb_orrr_rd", 0xF9ULL, 3, 0xFFFFFFFFFFFFFFFEULL},
+        {"div.sb_orrr_rd", 7, 0xFDULL, 0xFFFFFFFFFFFFFFFEULL},
+        {"div.sb_orrr_rd", 0xF9ULL, 0xFDULL, 2},
+        {"rem.sb_orrr_rd", 0xF9ULL, 3, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.sb_orrr_rd", 7, 0xFDULL, 1},
+        {"rem.sb_orrr_rd", 0xF9ULL, 0xFDULL, 0xFFFFFFFFFFFFFFFFULL},
+        // Unsigned: zero-extended results.
+        {"div.ut_orrr_rd", 0x80000005ULL, 3, 0x000000002AAAAAACULL},
+        {"rem.ut_orrr_rd", 0x80000005ULL, 3, 0x00000001ULL},
+        {"div.uw_orrr_rd", 0x8005ULL, 3, 0x0000000000002AACULL},
+        {"rem.uw_orrr_rd", 0x8005ULL, 3, 0x00000001ULL},
+        {"div.ub_orrr_rd", 0x85ULL, 3, 0x2CULL},
+        {"rem.ub_orrr_rd", 0x85ULL, 3, 0x01ULL},
+        // Divide-by-zero constants (contract-isa §6.1.5).
+        {"div.ut_orrr_rd", 0x12345678ULL, 0, 0x00000000FFFFFFFFULL},
+        {"rem.ut_orrr_rd", 0x12345678ULL, 0, 0x0000000012345678ULL},
+        {"div.uw_orrr_rd", 0x1234ULL, 0, 0x000000000000FFFFULL},
+        {"rem.uw_orrr_rd", 0x1234ULL, 0, 0x0000000000001234ULL},
+        {"div.ub_orrr_rd", 0x12ULL, 0, 0x00000000000000FFULL},
+        {"rem.ub_orrr_rd", 0x12ULL, 0, 0x0000000000000012ULL},
+        {"div.st_orrr_rd", 0x12345678ULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.st_orrr_rd", 0x12345678ULL, 0, 0x0000000012345678ULL},
+        {"div.st_orrr_rd", 0xFFFFFFF9ULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.st_orrr_rd", 0xFFFFFFF9ULL, 0, 0xFFFFFFFFFFFFFFF9ULL},
+        {"div.sw_orrr_rd", 0xFFF9ULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.sw_orrr_rd", 0xFFF9ULL, 0, 0xFFFFFFFFFFFFFFF9ULL},
+        {"div.sb_orrr_rd", 0xF9ULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"rem.sb_orrr_rd", 0xF9ULL, 0, 0xFFFFFFFFFFFFFFF9ULL},
+        // Signed overflow INT_MIN / -1 constants.
+        {"div.st_orrr_rd", 0x80000000ULL, 0xFFFFFFFFULL,
+         0xFFFFFFFF80000000ULL},
+        {"rem.st_orrr_rd", 0x80000000ULL, 0xFFFFFFFFULL, 0},
+        {"div.sw_orrr_rd", 0x8000ULL, 0xFFFFULL, 0xFFFFFFFFFFFF8000ULL},
+        {"rem.sw_orrr_rd", 0x8000ULL, 0xFFFFULL, 0},
+        {"div.sb_orrr_rd", 0x80ULL, 0xFFULL, 0xFFFFFFFFFFFFFF80ULL},
+        {"rem.sb_orrr_rd", 0x80ULL, 0xFFULL, 0},
+    };
+    for (const DivCase &c : cases) {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.a;
+        ctx.rd[8] = c.b;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s divrem: fault %s", c.id,
+              faultName(fault));
+        check(ctx.rd[5] == c.expected,
+              "%s 0x%016" PRIx64 ",0x%016" PRIx64 ": 0x%016" PRIx64
+              " (expected 0x%016" PRIx64 ")", c.id, c.a, c.b, ctx.rd[5],
+              c.expected);
+    }
+
+    // rdhd = rd0 reads 0 -> divide-by-zero constant, still legal, for every
+    // width and signedness.
+    const char *const divIds[] = {
+        "div.ut_orrr_rd", "div.st_orrr_rd", "rem.ut_orrr_rd",
+        "rem.st_orrr_rd", "div.uw_orrr_rd", "div.sw_orrr_rd",
+        "rem.uw_orrr_rd", "rem.sw_orrr_rd", "div.ub_orrr_rd",
+        "div.sb_orrr_rd", "rem.ub_orrr_rd", "rem.sb_orrr_rd",
+    };
+    for (const char *id : divIds) {
+        const Oracle *o = oracleOf(id);
+        if (o == nullptr) {
+            fail("%s: missing oracle", id);
+            continue;
+        }
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0x1234;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 0;
+        const exec::Fault fault = runWord(ctx, id, makeWord(id, w));
+        check(fault == exec::Fault::None, "%s rdhd=rd0: legal (got %s)", id,
+              faultName(fault));
+        const uint64_t expected =
+            expectedArith(o->op, o->width, o->isSigned, 0x1234, 0);
+        check(ctx.rd[5] == expected,
+              "%s rdhd=rd0 uses the divide-by-zero constant (got "
+              "0x%016" PRIx64 ", expected 0x%016" PRIx64 ")", id, ctx.rd[5],
+              expected);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 7. Shifts / rotates: mod-width register amounts, immediate SBZ, wraps.
+// ---------------------------------------------------------------------------
+
+void
+checkShift()
+{
+    // orrr amount is the low log2(width) bits: rdhd = width => 0; rdhd all
+    // ones => width-1.
+    struct ShCase
+    {
+        const char *id;
+        unsigned width;
+        uint64_t value;
+        uint64_t rdhd;
+        unsigned amount;
+    };
+    const ShCase cases[] = {
+        {"shl.t_orrr_rd", 32, 0x00000001ULL, 32, 0},
+        {"shl.t_orrr_rd", 32, 0x00000001ULL, ~uint64_t(0), 31},
+        {"rol.t_orrr_rd", 32, 0x00000001ULL, 32, 0},
+        {"shr.ut_orrr_rd", 32, 0x80000000ULL, 32, 0},
+        {"shr.st_orrr_rd", 32, 0x80000000ULL, ~uint64_t(0), 31},
+        {"shl.w_orrr_rd", 16, 0x0001ULL, 16, 0},
+        {"rol.w_orrr_rd", 16, 0x0001ULL, ~uint64_t(0), 15},
+        {"shr.uw_orrr_rd", 16, 0x8000ULL, 16, 0},
+        {"shr.sw_orrr_rd", 16, 0x8000ULL, ~uint64_t(0), 15},
+        {"shl.b_orrr_rd", 8, 0x01ULL, 8, 0},
+        {"rol.b_orrr_rd", 8, 0x01ULL, ~uint64_t(0), 7},
+        {"shr.ub_orrr_rd", 8, 0x80ULL, 8, 0},
+        {"shr.sb_orrr_rd", 8, 0x80ULL, ~uint64_t(0), 7},
+    };
+    for (const ShCase &c : cases) {
+        const Oracle *o = oracleOf(c.id);
+        if (o == nullptr) {
+            fail("%s: missing oracle", c.id);
+            continue;
+        }
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.value;
+        ctx.rd[8] = c.rdhd;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s orrr amount: fault %s", c.id,
+              faultName(fault));
+        const uint64_t expected =
+            expectedShift(o->op, o->width, c.value, c.amount);
+        check(ctx.rd[5] == expected,
+              "%s rdhd=0x%016" PRIx64 " => shamt %u (0x%016" PRIx64
+              ", expected 0x%016" PRIx64 ")", c.id, c.rdhd, c.amount,
+              ctx.rd[5], expected);
+    }
+
+    // rotates wrap inside the width.
+    struct RotCase
+    {
+        const char *id;
+        unsigned width;
+        uint64_t value;
+        unsigned shamt;
+        uint64_t expected;
+    };
+    const RotCase rots[] = {
+        {"rol.t_orri_rd", 32, 1, 1, 2},
+        {"rol.t_orri_rd", 32, 0x80000000ULL, 1, 1},
+        {"rol.w_orri_rd", 16, 1, 1, 2},
+        {"rol.w_orri_rd", 16, 0x8000ULL, 1, 1},
+        {"rol.b_orri_rd", 8, 1, 1, 2},
+        {"rol.b_orri_rd", 8, 0x80ULL, 1, 1},
+        {"rol.t_orri_rd", 32, 0x12345678ULL, 0, 0x12345678ULL},
+    };
+    for (const RotCase &c : rots) {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.value;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = c.shamt;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s rotate: fault %s", c.id,
+              faultName(fault));
+        check(ctx.rd[5] == c.expected,
+              "%s rol(0x%016" PRIx64 ",%u)=0x%016" PRIx64
+              " (expected 0x%016" PRIx64 ")", c.id, c.value, c.shamt,
+              ctx.rd[5], c.expected);
+    }
+
+    // immediate SBZ: immu6 == width is ILLI and no source register is read;
+    // immu6 == width-1 is legal.
+    const struct
+    {
+        const char *id;
+        unsigned width;
+    } sbz[] = {
+        {"shl.t_orri_rd", 32}, {"rol.t_orri_rd", 32},
+        {"shr.ut_orri_rd", 32}, {"shr.st_orri_rd", 32},
+        {"shl.w_orri_rd", 16}, {"rol.w_orri_rd", 16},
+        {"shr.uw_orri_rd", 16}, {"shr.sw_orri_rd", 16},
+        {"shl.b_orri_rd", 8}, {"rol.b_orri_rd", 8},
+        {"shr.ub_orri_rd", 8}, {"shr.sb_orri_rd", 8},
+    };
+    for (const auto &c : sbz) {
+        MockRegAccess bad;
+        initContext(bad);
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = c.width;
+        const exec::Fault fault = runWord(bad, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::Illegal,
+              "%s immu6=%u -> Illegal (got %s)", c.id, c.width,
+              faultName(fault));
+        check(bad.writes.empty() && bad.reads == 0,
+              "%s immu6=%u: ILLI before any register read/write", c.id,
+              c.width);
+
+        MockRegAccess ok;
+        initContext(ok);
+        ok.rd[6] = 1;
+        w.imm = c.width - 1;
+        const exec::Fault legal = runWord(ok, c.id, makeWord(c.id, w));
+        check(legal == exec::Fault::None,
+              "%s immu6=%u is legal (got %s)", c.id, c.width - 1,
+              faultName(legal));
+    }
+
+    // shl clears the high bits, shr.st fills with the sign bit.
+    {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0xFFFFFFFFULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = 1;
+        const exec::Fault fault =
+            runWord(ctx, "shl.t_orri_rd", makeWord("shl.t_orri_rd", w));
+        check(fault == exec::Fault::None, "shl.t high bits: fault %s",
+              faultName(fault));
+        check(ctx.rd[5] == 0x00000000FFFFFFFEULL,
+              "shl.t clears [63:32] (got 0x%016" PRIx64 ")", ctx.rd[5]);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 8. rev.t / rev.w / rev.b: every legal k, every block, bswap vectors, ILLI.
+// ---------------------------------------------------------------------------
+
+void
+checkReverse()
+{
+    const struct
+    {
+        const char *id;
+        unsigned blockSize;
+        unsigned ks[5];
+        unsigned numKs;
+    } revs[] = {
+        {"rev.t_orri_rd", 32, {1, 2, 4, 8, 16}, 5},
+        {"rev.w_orri_rd", 16, {1, 2, 4, 8, 0}, 4},
+        {"rev.b_orri_rd", 8, {1, 2, 4, 0, 0}, 3},
+    };
+    const uint64_t values[] = {
+        0, 1, ~uint64_t(0), 0x0123456789ABCDEFULL, 0xFFFFFFFF00000000ULL,
+    };
+    for (const auto &r : revs) {
+        for (unsigned ki = 0; ki < r.numKs; ++ki) {
+            const unsigned k = r.ks[ki];
+            for (uint64_t value : values) {
+                MockRegAccess ctx;
+                initContext(ctx);
+                ctx.rd[6] = value;
+                WordSpec w;
+                w.rdhb = 5;
+                w.rdhc = 6;
+                w.imm = k;
+                const exec::Fault fault =
+                    runWord(ctx, r.id, makeWord(r.id, w));
+                check(fault == exec::Fault::None, "%s k=%u: fault %s", r.id,
+                      k, faultName(fault));
+                const uint64_t expected =
+                    expectedRev(value, r.blockSize, k);
+                check(ctx.rd[5] == expected,
+                      "%s k=%u src=0x%016" PRIx64 ": 0x%016" PRIx64
+                      " (expected 0x%016" PRIx64 ")", r.id, k, value,
+                      ctx.rd[5], expected);
+            }
+        }
+    }
+
+    // Known bswap vectors, including a non-zero high block (all blocks are
+    // processed even when the spec's k=8 usage convention expects high zero).
+    const struct
+    {
+        const char *id;
+        unsigned k;
+        uint64_t value;
+        uint64_t expected;
+    } swaps[] = {
+        {"rev.t_orri_rd", 8, 0x0123456789ABCDEFULL, 0x67452301EFCDAB89ULL},
+        {"rev.w_orri_rd", 8, 0x0123456789ABCDEFULL, 0x23016745AB89EFCDULL},
+        {"rev.t_orri_rd", 8, 0x01234567ULL, 0x67452301ULL},
+        {"rev.w_orri_rd", 8, 0x0123ULL, 0x2301ULL},
+    };
+    for (const auto &c : swaps) {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.value;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = c.k;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s bswap: fault %s", c.id,
+              faultName(fault));
+        check(ctx.rd[5] == c.expected,
+              "%s k=%u bswap 0x%016" PRIx64 " -> 0x%016" PRIx64
+              " (expected 0x%016" PRIx64 ")", c.id, c.k, c.value, ctx.rd[5],
+              c.expected);
+    }
+
+    // k=1 reverses bits inside each block, not the whole 64-bit register.
+    {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0x0000000080000000ULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = 1;
+        const exec::Fault fault =
+            runWord(ctx, "rev.t_orri_rd", makeWord("rev.t_orri_rd", w));
+        check(fault == exec::Fault::None, "rev.t k=1: fault %s",
+              faultName(fault));
+        check(ctx.rd[5] == 1,
+              "rev.t k=1 reverses the low 32-bit block only (got "
+              "0x%016" PRIx64 ")", ctx.rd[5]);
+        check(ctx.rd[5] != 0x0000000100000000ULL,
+              "rev.t k=1 is not the 64-bit bitreverse");
+    }
+
+    // Every illegal k (0 / non-one-hot / k == S / 63) is ILLI before a read.
+    const struct
+    {
+        const char *id;
+        unsigned blockSize;
+        unsigned ks[8];
+        unsigned numKs;
+    } illegal[] = {
+        {"rev.t_orri_rd", 32, {0, 3, 5, 6, 32, 63, 0, 0}, 6},
+        {"rev.w_orri_rd", 16, {0, 3, 5, 6, 16, 63, 0, 0}, 6},
+        {"rev.b_orri_rd", 8, {0, 3, 5, 6, 8, 63, 0, 0}, 6},
+    };
+    for (const auto &r : illegal) {
+        for (unsigned ki = 0; ki < r.numKs; ++ki) {
+            MockRegAccess ctx;
+            initContext(ctx);
+            WordSpec w;
+            w.rdhb = 5;
+            w.rdhc = 6;
+            w.imm = r.ks[ki];
+            const exec::Fault fault =
+                runWord(ctx, r.id, makeWord(r.id, w));
+            check(fault == exec::Fault::Illegal,
+                  "%s k=%u -> Illegal (got %s)", r.id, r.ks[ki],
+                  faultName(fault));
+            check(ctx.writes.empty() && ctx.reads == 0,
+                  "%s k=%u: ILLI before any register read/write", r.id,
+                  r.ks[ki]);
+        }
+    }
+
+    // rd0 source is legal (result 0); rdhb == rdhc reverses in place.
+    for (const auto &r : revs) {
+        const unsigned k = r.ks[0];
+        MockRegAccess zero;
+        initContext(zero);
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 0;
+        w.imm = k;
+        const exec::Fault fault =
+            runWord(zero, r.id, makeWord(r.id, w));
+        check(fault == exec::Fault::None, "%s rd0 source: legal (got %s)",
+              r.id, faultName(fault));
+        check(zero.rd[5] == 0, "%s rd0 source: result 0", r.id);
+
+        MockRegAccess inPlace;
+        initContext(inPlace);
+        inPlace.rd[5] = 0x0123456789ABCDEFULL;
+        w.rdhc = 5;
+        const exec::Fault ok =
+            runWord(inPlace, r.id, makeWord(r.id, w));
+        check(ok == exec::Fault::None, "%s in-place: fault %s", r.id,
+              faultName(ok));
+        check(inPlace.rd[5] ==
+                  expectedRev(0x0123456789ABCDEFULL, r.blockSize, k),
+              "%s in-place reverses the pre-instruction value", r.id);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 9. Static legality never reads or writes for all 63 ids.
+// ---------------------------------------------------------------------------
+
+void
+checkLegality()
+{
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        MockRegAccess ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rdhb = 0;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        // Keep the immediate legal so only dst_rd0 can trigger.
+        w.imm = o.rule == RULE_RD0_ONEHOT ? 2 : 0;
+        const exec::Fault fault = runWord(ctx, o.id, makeWord(o.id, w));
+        check(fault == exec::Fault::Illegal, "%s dst rd0 -> Illegal (got %s)",
+              o.id, faultName(fault));
+        check(ctx.writes.empty() && ctx.badWrites == 0 &&
+                  ctx.badFloats == 0 && ctx.reads == 0,
+              "%s dst rd0: no register read/write", o.id);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 10. Decode metadata (rule_refs / spec_cite) is consumed.
+// ---------------------------------------------------------------------------
+
+void
+checkRules()
+{
+    size_t rd0 = 0;
+    size_t sbz = 0;
+    size_t onehot = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch != 4)
+            continue;
+        check(entry.specCite != nullptr && entry.specCite[0] != '\0',
+              "%s has a spec_cite", entry.id);
+        for (unsigned r = 0; r < entry.numRules; ++r) {
+            const char *rule = entry.rules[r];
+            if (strEq(rule, "dst_rd0"))
+                ++rd0;
+            else if (strEq(rule, "encode_sbz"))
+                ++sbz;
+            else if (strEq(rule, "encode_onehot"))
+                ++onehot;
+            else
+                fail("%s: unknown rule_ref %s", entry.id, rule);
+        }
+    }
+    check(rd0 == 63, "rule dst_rd0 count == 63 (actual %zu)", rd0);
+    check(sbz == 12, "rule encode_sbz count == 12 (actual %zu)", sbz);
+    check(onehot == 3, "rule encode_onehot count == 3 (actual %zu)",
+          onehot);
+
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        const decode::DecodeEntry *entry = decode::entryById(o.id);
+        if (entry == nullptr) {
+            fail("%s: missing decode entry", o.id);
+            continue;
+        }
+        if (o.rule == RULE_RD0_SBZ) {
+            check(entry->numRules == 2 && strEq(entry->rules[0], "dst_rd0") &&
+                      strEq(entry->rules[1], "encode_sbz"),
+                  "%s rule_refs == dst_rd0 + encode_sbz", o.id);
+        } else if (o.rule == RULE_RD0_ONEHOT) {
+            check(entry->numRules == 2 && strEq(entry->rules[0], "dst_rd0") &&
+                      strEq(entry->rules[1], "encode_onehot"),
+                  "%s rule_refs == dst_rd0 + encode_onehot", o.id);
+        } else {
+            check(entry->numRules == 1 && strEq(entry->rules[0], "dst_rd0"),
+                  "%s rule_refs == dst_rd0", o.id);
+        }
+    }
+}
+
+} // anonymous namespace
+
+int
+main()
+{
+    checkCoverage();
+    checkPositiveAll();
+    checkDispatch();
+    checkTruncation();
+    checkExtension();
+    checkDivRem();
+    checkShift();
+    checkReverse();
+    checkLegality();
+    checkRules();
+
+    std::printf("\nsummary: B4 coverage 63/63, oracle rows %zu, failures %d\n",
+                kOracleCount, failures);
+    return failures == 0 ? 0 : 1;
+}
