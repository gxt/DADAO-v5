+// ---------------------------------------------------------------------------
+// Mock architectural state (plain C++, no gem5).
+// ---------------------------------------------------------------------------
+
+struct Write
+{
+    exec::Bank bank;
+    unsigned idx;
+    uint64_t value;
+};
+
+struct MockRegAccess : public exec::RegAccess
+{
+    uint64_t rd[64] = {};
+    uint64_t rb[64] = {};
+    uint64_t ra[64] = {};
+    uint64_t rf[64] = {};
+    uint64_t ip = 0x1000;
+
+    int badWrites = 0;
+    int badFloats = 0;
+    int reads = 0;
+    std::vector<Write> writes;
+
+    uint64_t
+    readInt(exec::Bank bank, unsigned idx) override
+    {
+        ++reads;
+        switch (bank) {
+          case exec::Bank::Rd: return idx == 0 ? 0 : rd[idx];
+          case exec::Bank::Rb: return idx == 0 ? ip : rb[idx];
+          case exec::Bank::Ra: return ra[idx];
+        }
+        return 0;
+    }
+
+    void
+    writeInt(exec::Bank bank, unsigned idx, uint64_t val) override
+    {
+        if ((bank == exec::Bank::Rd || bank == exec::Bank::Rb) && idx == 0) {
+            ++badWrites;
+            return;
+        }
+        writes.push_back({bank, idx, val});
+        switch (bank) {
+          case exec::Bank::Rd: rd[idx] = val; break;
+          case exec::Bank::Rb: rb[idx] = val; break;
+          case exec::Bank::Ra: ra[idx] = val; break;
+        }
+    }
+
+    uint64_t readFloat(unsigned idx) override
+    {
+        ++badFloats;
+        return rf[idx];
+    }
+
+    void
+    writeFloat64(unsigned idx, uint64_t val) override
+    {
+        ++badFloats;
+        rf[idx] = val;
+    }
+
+    void
+    writeFcsr(uint64_t raw) override
+    {
+        ++badFloats;
+        rf[0] = raw;
+    }
+
+    uint64_t pc() const override { return ip; }
+};
+
+void
+initContext(MockRegAccess &ctx)
+{
+    for (unsigned i = 0; i < 64; ++i) {
+        ctx.rd[i] = 0xDEAD000000000000ULL + i;
+        ctx.rb[i] = 0xBEEF000000000000ULL + i;
+        ctx.ra[i] = 0xCAFE000000000000ULL + i;
+        ctx.rf[i] = 0xF00D000000000000ULL + i;
+    }
+    ctx.rd[0] = 0;
+    ctx.rb[0] = 0;
+    ctx.rf[0] = 0;
+    ctx.ip = 0x1000;
+}
+
+// ---------------------------------------------------------------------------
+// Word construction helpers.
+// ---------------------------------------------------------------------------
+
+struct WordSpec
+{
+    unsigned rdhb = 5;
+    unsigned rdhc = 6;
+    unsigned rdhd = 8;
+    unsigned imm = 8;
+};
+
+uint32_t
+makeWord(const char *id, const WordSpec &w)
+{
+    const decode::DecodeEntry *entry = decode::entryById(id);
+    if (entry == nullptr) {
+        fail("encode: unknown id %s", id);
+        return 0;
+    }
+    struct FieldVal
+    {
+        const char *name;
+        uint64_t value;
+    };
+    const FieldVal values[] = {
+        {"rdhb", w.rdhb}, {"rdhc", w.rdhc}, {"rdhd", w.rdhd},
+        {"immu6", w.imm},
+    };
+    uint32_t raw = entry->value;
+    for (const FieldVal &fv : values) {
+        for (unsigned i = 0; i < entry->numFields; ++i) {
+            const decode::FieldDesc &field = decode::fieldDesc(*entry, i);
+            if (std::strcmp(field.name, fv.name) != 0)
+                continue;
+            const uint32_t mask =
+                ((uint32_t(1) << field.width()) - 1) << field.lo;
+            raw = (raw & ~mask) |
+                  ((static_cast<uint32_t>(fv.value) << field.lo) & mask);
+            break;
+        }
+    }
+    return raw;
+}
+
+exec::Fault
+runWord(MockRegAccess &ctx, const char *id, uint32_t raw)
+{
+    const decode::DecodedInst decoded = decode::decodeWord(raw);
+    if (!decoded.ok()) {
+        fail("%s: encoding 0x%08x does not decode", id, raw);
+        return exec::Fault::Illegal;
+    }
+    if (!strEq(decoded.entry->id, id)) {
+        fail("%s: encoding 0x%08x decoded as %s", id, raw,
+             decoded.entry->id);
+        return exec::Fault::Illegal;
+    }
+    return exec::executeB4(decoded, ctx);
+}
+
+const char *
+faultName(exec::Fault fault)
+{
+    switch (fault) {
+      case exec::Fault::None: return "None";
+      case exec::Fault::NotB1: return "NotB1";
+      case exec::Fault::NotB2: return "NotB2";
+      case exec::Fault::NotB3: return "NotB3";
+      case exec::Fault::NotB4: return "NotB4";
+      case exec::Fault::NotB5: return "NotB5";
+      case exec::Fault::Illegal: return "Illegal";
+      case exec::Fault::Malign: return "Malign";
+      case exec::Fault::Memory: return "Memory";
+      case exec::Fault::RasOverflow: return "RasOverflow";
+      case exec::Fault::RasUnderflow: return "RasUnderflow";
+      case exec::Fault::NotB6: return "NotB6";
+      case exec::Fault::CfxReg: return "CfxReg";
+      case exec::Fault::CfxEsc: return "CfxEsc";
+      case exec::Fault::NotB7: return "NotB7";
+    }
+    return "?";
+}
+
+// ---------------------------------------------------------------------------
+// 1. Coverage: 63 explicit ids, one positive case each.
+// ---------------------------------------------------------------------------
+
+/** One execution with the destination/source register numbers and the source
+ * values of the oracle.  `rhs` is the arithmetic right operand; `shamtReg` is
+ * the orrr shift amount register value; `imm6` is the orri field. */
+void
+expectCase(const Oracle &o, const char *label, uint64_t a, uint64_t rhs,
+           unsigned shamtReg, unsigned imm6)
+{
+    MockRegAccess ctx;
+    initContext(ctx);
+    ctx.rd[6] = a;
+    const bool shift = o.op == T_SHL || o.op == T_ROL || o.op == T_SHRU ||
+                       o.op == T_SHRS;
+    ctx.rd[8] = (shift && strEq(o.format, "orrr")) ? shamtReg : rhs;
+
+    WordSpec w;
+    w.rdhb = 5;
+    w.rdhc = 6;
+    w.rdhd = 8;
+    w.imm = imm6;
+    const exec::Fault fault = runWord(ctx, o.id, makeWord(o.id, w));
+    check(fault == exec::Fault::None, "%s %s: fault %s", o.id, label,
+          faultName(fault));
+    if (fault != exec::Fault::None)
+        return;
+
+    const uint64_t expected = o.op == T_REV
+        ? expectedRev(a, o.width, imm6)
+        : (o.op == T_SHL || o.op == T_ROL || o.op == T_SHRU ||
+           o.op == T_SHRS)
+            ? expectedShift(o.op, o.width, a,
+                            strEq(o.format, "orrr") ? shamtReg : imm6)
+            : expectedArith(o.op, o.width, o.isSigned, a, rhs);
+    check(ctx.rd[5] == expected,
+          "%s %s: 0x%016" PRIx64 " (expected 0x%016" PRIx64 ")", o.id,
+          label, ctx.rd[5], expected);
+    check(ctx.writes.size() == 1 && ctx.writes[0].bank == exec::Bank::Rd &&
+              ctx.writes[0].idx == 5,
+          "%s %s: exactly one RD write to rdhb", o.id, label);
+    check(ctx.badWrites == 0 && ctx.badFloats == 0,
+          "%s %s: no illegal write attempt", o.id, label);
+}
+
+void
+checkPositiveAll()
+{
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        const int before = failures;
+        if (o.op == T_REV) {
+            const unsigned k = o.width == 8 ? 4 : 8;
+            expectCase(o, "positive", 0x0123456789ABCDEFULL, 0, 0, k);
+        } else if (o.op == T_SHL || o.op == T_ROL || o.op == T_SHRU ||
+                   o.op == T_SHRS) {
+            const uint64_t a = o.width == 32 ? 0x80000005ULL
+                              : o.width == 16 ? 0x8005ULL : 0x85ULL;
+            expectCase(o, "positive", a, 0, 3, 3);
+        } else {
+            const uint64_t a = o.width == 32 ? 0x80000005ULL
+                              : o.width == 16 ? 0x8005ULL : 0x85ULL;
+            expectCase(o, "positive", a, 3, 0, 0);
+        }
+        if (failures == before)
+            std::printf("[PASS] b4-id %s\n", o.id);
+    }
+    check(kOracleCount == 63, "oracle rows == 63 (actual %zu)",
+          kOracleCount);
+}
+
+// ---------------------------------------------------------------------------
+// 2. Decode-table membership / spec table consistency.
+// ---------------------------------------------------------------------------
+
+void
+checkCoverage()
+{
+    size_t live = 0;
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        const decode::DecodeEntry *entry = decode::entryById(o.id);
+        check(entry != nullptr, "%s exists in the decode table", o.id);
+        if (entry == nullptr)
+            continue;
+        check(entry->batch == 4, "%s is batch 4 (actual %u)", o.id,
+              entry->batch);
+        check(strEq(entry->format, o.format), "%s is %s (actual %s)", o.id,
+              o.format, entry->format);
+        const exec::B4Spec *spec = exec::b4SpecForId(o.id);
+        check(spec != nullptr, "executeB4 covers b4 id %s", o.id);
+        if (spec != nullptr) {
+            check(spec->op == execOpOf(o.op),
+                  "%s spec op matches the independent oracle", o.id);
+            check(spec->width == o.width, "%s spec width == %u", o.id,
+                  o.width);
+            check(spec->isSigned == o.isSigned,
+                  "%s spec signedness matches the oracle", o.id);
+        }
+        ++live;
+    }
+    check(live == 63, "B4 coverage %zu/63", live);
+    std::printf("B4 coverage %zu/63\n", live);
+
+    // Every live batch-4 entry has exactly one oracle row and one spec row.
+    size_t batch4 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch != 4)
+            continue;
+        ++batch4;
+        check(oracleOf(entry.id) != nullptr, "oracle row for batch-4 id %s",
+              entry.id);
+        check(exec::b4SpecForId(entry.id) != nullptr,
+              "executeB4 covers batch-4 id %s", entry.id);
+    }
+    check(batch4 == 63, "live batch-4 entry count == 63 (actual %zu)",
+          batch4);
+    check(exec::b4SpecCount() == 63,
+          "executeB4 spec count == 63 (actual %zu)", exec::b4SpecCount());
+
+    // Spec rows are unique and all map back to a batch-4 decode entry.
+    for (size_t i = 0; i < exec::b4SpecCount(); ++i) {
+        const exec::B4Spec &spec = exec::b4Specs()[i];
+        for (size_t j = i + 1; j < exec::b4SpecCount(); ++j) {
+            check(!strEq(spec.id, exec::b4Specs()[j].id),
+                  "spec ids unique: %s vs %s", spec.id,
+                  exec::b4Specs()[j].id);
+        }
+        const decode::DecodeEntry *entry = decode::entryById(spec.id);
+        check(entry != nullptr && entry->batch == 4,
+              "spec id %s is a batch-4 decode entry", spec.id);
+    }
+
+    // The 201 non-B4 entries must stay NotB4 without touching a register.
+    size_t notB4 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        const decode::DecodedInst decoded = decode::decodeWord(entry.value);
+        if (!decoded.ok() || !strEq(decoded.entry->id, entry.id)) {
+            fail("entry %s: value 0x%08x does not decode back", entry.id,
+                 entry.value);
+            continue;
+        }
+        MockRegAccess ctx;
+        initContext(ctx);
+        const exec::Fault fault = exec::executeB4(decoded, ctx);
+        if (entry.batch == 4) {
+            check(fault != exec::Fault::NotB4, "%s is handled by executeB4",
+                  entry.id);
+        } else {
+            ++notB4;
+            if (fault != exec::Fault::NotB4)
+                fail("%s (batch %u) returned %s, expected NotB4", entry.id,
+                     entry.batch, faultName(fault));
+            if (!ctx.writes.empty() || ctx.badWrites != 0 ||
+                    ctx.badFloats != 0 || ctx.reads != 0)
+                fail("%s (batch %u) touched a register on NotB4", entry.id,
+                     entry.batch);
+        }
+    }
+    check(notB4 == 264 - 63, "non-B4 ids return NotB4 (%zu/201)", notB4);
+    std::printf("non-B4 ids return NotB4 (%zu/201)\n", notB4);
+}
+
+// ---------------------------------------------------------------------------
+// 3. Dispatch by id (same mnemonic across formats and widths).
+// ---------------------------------------------------------------------------
+
+void
+checkDispatch()
+{
+    // shl.t/rol.t/shr.ut/shr.st each have an orrr (register amount) and an
+    // orri (immediate amount) id; both must execute, with the field roles of
+    // their own format.
+    const char *const pairs[] = {
+        "shl.t", "shl.t_orrr_rd", "shl.t_orri_rd",
+        "rol.t", "rol.t_orrr_rd", "rol.t_orri_rd",
+        "shr.ut", "shr.ut_orrr_rd", "shr.ut_orri_rd",
+        "shr.st", "shr.st_orrr_rd", "shr.st_orri_rd",
+    };
+    for (unsigned i = 0; i < 8; i += 3) {
+        const Oracle *reg = oracleOf(pairs[i + 1]);
+        const Oracle *imm = oracleOf(pairs[i + 2]);
+        check(reg != nullptr && imm != nullptr,
+              "%s has both orrr and orri ids", pairs[i]);
+        if (reg == nullptr || imm == nullptr)
+            continue;
+        check(std::strcmp(reg->id, imm->id) != 0,
+              "%s orrr/orri ids differ", pairs[i]);
+        // Same source/amount, different format: identical result.
+        MockRegAccess a;
+        initContext(a);
+        a.rd[6] = 0x80000005ULL;
+        a.rd[8] = 5;
+        WordSpec wr;
+        wr.rdhb = 5;
+        wr.rdhc = 6;
+        wr.rdhd = 8;
+        const exec::Fault fr = runWord(a, reg->id, makeWord(reg->id, wr));
+        MockRegAccess b;
+        initContext(b);
+        b.rd[6] = 0x80000005ULL;
+        WordSpec wi;
+        wi.rdhb = 5;
+        wi.rdhc = 6;
+        wi.imm = 5;
+        const exec::Fault fi = runWord(b, imm->id, makeWord(imm->id, wi));
+        check(fr == exec::Fault::None && fi == exec::Fault::None,
+              "%s orrr/orri both execute (got %s/%s)", pairs[i],
+              faultName(fr), faultName(fi));
+        check(a.rd[5] == b.rd[5],
+              "%s orrr amount rdhd[4:0] == orri immu6 (0x%016" PRIx64
+              " vs 0x%016" PRIx64 ")", pairs[i], a.rd[5], b.rd[5]);
+    }
+
+    // add/sub/mul/div/rem/cmp share mnemonics across widths; the width comes
+    // from the id, never from the mnemonic.
+    const char *const wide[][3] = {
+        {"add.ut", "add.ut_orrr_rd", "add.uw_orrr_rd"},
+        {"add.st", "add.st_orrr_rd", "add.sw_orrr_rd"},
+        {"add.ub", "add.ub_orrr_rd", "add.uw_orrr_rd"},
+        {"sub.ut", "sub.ut_orrr_rd", "sub.uw_orrr_rd"},
+        {"mul.ut", "mul.ut_orrr_rd", "mul.uw_orrr_rd"},
+        {"div.ut", "div.ut_orrr_rd", "div.uw_orrr_rd"},
+        {"rem.ut", "rem.ut_orrr_rd", "rem.uw_orrr_rd"},
+        {"cmp.ut", "cmp.ut_orrr_rd", "cmp.uw_orrr_rd"},
+    };
+    for (const auto &row : wide) {
+        const Oracle *first = oracleOf(row[1]);
+        const Oracle *second = oracleOf(row[2]);
+        check(first != nullptr && second != nullptr,
+              "%s has rows for both widths", row[0]);
+        if (first != nullptr && second != nullptr)
+            check(first->width != second->width,
+                  "%s widths differ (%u vs %u)", row[0], first->width,
+                  second->width);
+    }
+
+    // rev.t/rev.w/rev.b each hit their own block size.
+    const char *const revIds[] = {"rev.t_orri_rd", "rev.w_orri_rd",
+                                  "rev.b_orri_rd"};
+    const unsigned revSizes[] = {32, 16, 8};
+    for (unsigned i = 0; i < 3; ++i) {
+        const Oracle *o = oracleOf(revIds[i]);
+        check(o != nullptr && o->width == revSizes[i],
+              "%s uses block size %u", revIds[i], revSizes[i]);
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0x0123456789ABCDEFULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = revSizes[i] == 8 ? 4 : 8;
+        const exec::Fault fault = runWord(ctx, revIds[i], makeWord(revIds[i], w));
+        check(fault == exec::Fault::None, "%s executes (got %s)", revIds[i],
+              faultName(fault));
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 4. Width truncation: high source bits never participate.
+// ---------------------------------------------------------------------------
+
+void
+checkTruncation()
+{
+    struct TruncCase
+    {
+        const char *id;
+        uint64_t a;
+        uint64_t b;
+    };
+    // High bits all ones: only the low width participates.
+    const TruncCase cases[] = {
+        {"add.ut_orrr_rd", ~uint64_t(0), 1},
+        {"add.uw_orrr_rd", ~uint64_t(0), 1},
+        {"add.ub_orrr_rd", ~uint64_t(0), 1},
+        {"sub.ut_orrr_rd", ~uint64_t(0), 0},
+        {"sub.uw_orrr_rd", ~uint64_t(0), 0},
+        {"sub.ub_orrr_rd", ~uint64_t(0), 0},
+    };
+    for (const TruncCase &c : cases) {
+        const Oracle *o = oracleOf(c.id);
+        if (o == nullptr) {
+            fail("%s: missing oracle", c.id);
+            continue;
+        }
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.a;
+        ctx.rd[8] = c.b;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s truncation: fault %s", c.id,
+              faultName(fault));
+        const uint64_t expected =
+            expectedArith(o->op, o->width, o->isSigned, c.a, c.b);
+        check(ctx.rd[5] == expected,
+              "%s high bits ignored (0x%016" PRIx64 ", expected 0x%016" PRIx64
+              ")", c.id, ctx.rd[5], expected);
+    }
+
+    // cmp only compares the low width (the 64-bit compare would say 1).
+    const struct
+    {
+        const char *id;
+        uint64_t a;
+        uint64_t b;
+    } cmps[] = {
+        {"cmp.ut_orrr_rd", 0xFFFFFFFF00000001ULL, 2},
+        {"cmp.uw_orrr_rd", 0xFFFFFFFFFFFF0001ULL, 2},
+        {"cmp.ub_orrr_rd", 0xFFFFFFFFFFFFFF01ULL, 2},
+    };
+    for (const auto &c : cmps) {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.a;
+        ctx.rd[8] = c.b;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s truncation: fault %s", c.id,
+              faultName(fault));
+        check(ctx.rd[5] == ~uint64_t(0),
+              "%s compares only the low width (got 0x%016" PRIx64 ")", c.id,
+              ctx.rd[5]);
+    }
+
+    // mul only keeps the low width of the product.
+    {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0xFFFFFFFFULL;
+        ctx.rd[8] = 0xFFFFFFFFULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault =
+            runWord(ctx, "mul.ut_orrr_rd", makeWord("mul.ut_orrr_rd", w));
+        check(fault == exec::Fault::None, "mul.ut truncation: fault %s",
+              faultName(fault));
+        check(ctx.rd[5] == 1,
+              "mul.ut keeps the low 32 bits of the product (got 0x%016" PRIx64
+              ")", ctx.rd[5]);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 5. Extension: u zero-extends, s sign-extends over all 64 bits.
+// ---------------------------------------------------------------------------
+
+void
+checkExtension()
+{
+    struct ExtCase
+    {
+        const char *id;
+        uint64_t a;
+        uint64_t b;
+        uint64_t expected;
+    };
+    const ExtCase cases[] = {
+        // .st/.sw/.sb: high bit of the width result set -> all top bits one.
+        {"add.st_orrr_rd", 0x7FFFFFFFULL, 1, 0xFFFFFFFF80000000ULL},
+        {"add.sw_orrr_rd", 0x7FFFULL, 1, 0xFFFFFFFFFFFF8000ULL},
+        {"add.sb_orrr_rd", 0x7FULL, 1, 0xFFFFFFFFFFFFFF80ULL},
+        {"sub.st_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+        {"sub.sw_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+        {"sub.sb_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+        {"mul.st_orrr_rd", 0x40000000ULL, 2, 0xFFFFFFFF80000000ULL},
+        {"mul.sw_orrr_rd", 0x4000ULL, 2, 0xFFFFFFFFFFFF8000ULL},
+        {"mul.sb_orrr_rd", 0x40ULL, 2, 0xFFFFFFFFFFFFFF80ULL},
+        // .ut/.uw/.ub: the same low bits but the top bits are zero.
+        {"add.ut_orrr_rd", 0x7FFFFFFFULL, 1, 0x0000000080000000ULL},
+        {"add.uw_orrr_rd", 0x7FFFULL, 1, 0x0000000000008000ULL},
+        {"add.ub_orrr_rd", 0x7FULL, 1, 0x0000000000000080ULL},
+        {"sub.ut_orrr_rd", 0, 1, 0x00000000FFFFFFFFULL},
+        {"sub.uw_orrr_rd", 0, 1, 0x000000000000FFFFULL},
+        {"sub.ub_orrr_rd", 0, 1, 0x00000000000000FFULL},
+        {"mul.ut_orrr_rd", 0x40000000ULL, 2, 0x0000000080000000ULL},
+        {"mul.uw_orrr_rd", 0x4000ULL, 2, 0x0000000000008000ULL},
+        {"mul.ub_orrr_rd", 0x40ULL, 2, 0x0000000000000080ULL},
+        // cmp -1 is all 64 bits, never a zero-extended width mask.
+        {"cmp.st_orrr_rd", 0xFFFFFFFFULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"cmp.ut_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+        {"cmp.sw_orrr_rd", 0xFFFFULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"cmp.uw_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+        {"cmp.sb_orrr_rd", 0xFFULL, 0, 0xFFFFFFFFFFFFFFFFULL},
+        {"cmp.ub_orrr_rd", 0, 1, 0xFFFFFFFFFFFFFFFFULL},
+    };
+    for (const ExtCase &c : cases) {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = c.a;
+        ctx.rd[8] = c.b;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.rdhd = 8;
+        const exec::Fault fault = runWord(ctx, c.id, makeWord(c.id, w));
+        check(fault == exec::Fault::None, "%s extension: fault %s", c.id,
+              faultName(fault));
+        check(ctx.rd[5] == c.expected,
+              "%s 0x%016" PRIx64 ",0x%016" PRIx64 ": 0x%016" PRIx64
+              " (expected 0x%016" PRIx64 ")", c.id, c.a, c.b, ctx.rd[5],
+              c.expected);
+    }
+
+    // shr.st sign-fills and shr.ut zero-fills.
+    {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0x80000000ULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = 1;
+        const exec::Fault fault =
+            runWord(ctx, "shr.st_orri_rd", makeWord("shr.st_orri_rd", w));
+        check(fault == exec::Fault::None, "shr.st sign fill: fault %s",
+              faultName(fault));
+        check(ctx.rd[5] == 0xFFFFFFFFC0000000ULL,
+              "shr.st fills with bit31 over all 64 bits (got 0x%016" PRIx64
+              ")", ctx.rd[5]);
+    }
+    {
+        MockRegAccess ctx;
+        initContext(ctx);
+        ctx.rd[6] = 0x80000000ULL;
+        WordSpec w;
+        w.rdhb = 5;
+        w.rdhc = 6;
+        w.imm = 1;
+        const exec::Fault fault =
+            runWord(ctx, "shr.ut_orri_rd", makeWord("shr.ut_orri_rd", w));
+        check(fault == exec::Fault::None, "shr.ut zero fill: fault %s",
+              faultName(fault));
+        check(ctx.rd[5] == 0x40000000ULL,
+              "shr.ut zero-extends (got 0x%016" PRIx64 ")", ctx.rd[5]);
+    }
+}
