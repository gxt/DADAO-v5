+// DADAO gem5 execution core: shared register access for the B1-B7 batches.
+//
+// Plain C++ (no gem5 headers), like the B0 decode core, so the same code is
+// driven by the standalone assertion harnesses (exec/*_test.cc) and by the
+// gem5 adapter (inst.cc).
+//
+// Only what the batches have in common lives here: the fault result, the
+// integer bank selector, the destination register group and the register
+// access interface.  Memory access and the B1-only 32-bit float half write
+// stay in the batch that needs them (exec/b1.hh).
+#ifndef __ARCH_DADAO_EXEC_COMMON_HH__
+#define __ARCH_DADAO_EXEC_COMMON_HH__
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+#include "arch/dadao/decode/decode.hh"
+
+namespace gem5
+{
+namespace DadaoISA
+{
+namespace exec
+{
+
+/** Result of executing one instruction.
+ *
+ * NotB1/.../NotB6 mean "this instruction is not in that batch"; the caller
+ * must keep it unimplemented rather than guessing.  Each executeB*() returns
+ * only its own NotB* value (never another batch's), and the caller keeps the
+ * instruction unimplemented in that case.
+ *
+ * RasOverflow/RasUnderflow are the B5 RAS faults (contract-isa §8.6); they are
+ * precise and only the B5 call/ret core can return them.
+ *
+ * CfxReg/CfxEsc are the B6 runtime faults (contract-isa §13.6, spec/SimRISC-11
+ * §3/§4): a missing cfx register combination or a rejected escape frame.  They
+ * are appended after the existing values so no earlier enumerator changes.
+ *
+ * NotB7 is the B7 batch marker, appended last for the same reason.
+ */
+enum class Fault
+{
+    None,
+    NotB1,
+    NotB2,
+    NotB3,
+    NotB4,
+    NotB5,
+    Illegal,
+    Malign,
+    Memory,
+    RasOverflow,
+    RasUnderflow,
+    NotB6,
+    CfxReg,
+    CfxEsc,
+    NotB7,
+};
+
+/** Integer banks; RF goes through the float accessors. */
+enum class Bank
+{
+    Rd,
+    Rb,
+    Ra,
+};
+
+/** Destination register group of an instruction. */
+enum class Target : uint8_t
+{
+    Rd,
+    Rb,
+    Ra,
+    Rf,
+};
+
+/** Architectural register access, implemented by the gem5 adapter and by the
+ * assertion harness.
+ *
+ * rd0 reads as 0 and rb0 reads as the current instruction address; rf0 reads
+ * the whole FCSR word and writeFcsr() applies the FCSR write mask.  There is
+ * deliberately no memory method here: the B2 batch has no memory access, so
+ * that path is impossible by construction.
+ */
+class RegAccess
+{
+  public:
+    virtual ~RegAccess() = default;
+
+    virtual uint64_t readInt(Bank bank, unsigned idx) = 0;
+    virtual void writeInt(Bank bank, unsigned idx, uint64_t val) = 0;
+
+    /** Full 64-bit RF read (rf0 reads the whole FCSR word). */
+    virtual uint64_t readFloat(unsigned idx) = 0;
+    /** Write the whole 64-bit register (never used for rf0). */
+    virtual void writeFloat64(unsigned idx, uint64_t val) = 0;
+    /** rf0 write: only [33:32] (rounding mode) and [4:0] (flags) change. */
+    virtual void writeFcsr(uint64_t raw) = 0;
+
+    /** Address of the instruction being executed (IP, not IP+4). */
+    virtual uint64_t pc() const = 0;
+};
+
+/** Look up one decoded field by name; false when the entry has no such field.
+ *
+ * Callers must treat false as a hard failure (ILLI / panic), never as a zero
+ * value: a missing field means the contract and the implementation disagree.
+ *
+ * The execution cores look the same field names up on every execution of a
+ * static instruction, so a linear name scan per operand is measurable in the
+ * SE interpreter (the field names are addressable literals at each call site).
+ * A small direct-mapped cache keyed by the decoded entry plus the literal's
+ * address and length turns the steady state into one pointer comparison; a
+ * miss runs the original scan and refills the entry, so an answer can never
+ * differ from the scan.  gem5's simulation loop is single-threaded, like the
+ * standalone assertion harnesses.
+ */
+inline bool
+fieldValue(const decode::DecodedInst &inst, std::string_view name,
+           uint64_t &out)
+{
+    if (!inst.ok() || name.empty())
+        return false;
+
+    struct CacheSlot
+    {
+        const decode::DecodeEntry *entry = nullptr;
+        const char *name = nullptr;
+        size_t length = 0;
+        uint8_t index = 0;
+    };
+    static constexpr unsigned kCacheSlots = 512;
+    static CacheSlot cache[kCacheSlots];
+
+    const uintptr_t entryAddr = reinterpret_cast<uintptr_t>(inst.entry);
+    const uintptr_t nameAddr = reinterpret_cast<uintptr_t>(name.data());
+    const unsigned slot = static_cast<unsigned>(
+        ((entryAddr >> 4) ^ nameAddr ^ (name.size() << 1)) &
+        (kCacheSlots - 1));
+    CacheSlot &cached = cache[slot];
+    if (cached.entry == inst.entry && cached.name == name.data() &&
+        cached.length == name.size()) {
+        out = inst.fieldValues[cached.index];
+        return true;
+    }
+
+    for (unsigned i = 0; i < inst.numFields; ++i) {
+        if (std::string_view(decode::fieldDesc(*inst.entry, i).name) == name) {
+            out = inst.fieldValues[i];
+            cached = CacheSlot{inst.entry, name.data(), name.size(),
+                               static_cast<uint8_t>(i)};
+            return true;
+        }
+    }
+    return false;
+}
+
+/** Resolve an execution-core spec from the decoded entry in constant time.
+ *
+ * `specForId()` scans the id strings of a whole batch (up to 63 for B4), and
+ * the SE dispatcher called it on every executed instruction; that scan was the
+ * dominant per-instruction cost of the interpreter.  A `DecodedInst` always
+ * carries a pointer into the generated decode table, whose position is stable,
+ * so the mapping is built once per spec table (by id, matching the old scan)
+ * and then indexed by the entry's position.  An entry outside the table (or a
+ * spec id the decode table does not know) still yields nullptr, i.e. the
+ * uncovered-id error path is unchanged.
+ */
+template <class Spec, size_t N>
+class SpecsByEntry
+{
+  public:
+    explicit SpecsByEntry(const Spec (&specs)[N])
+    {
+        const decode::DecodeEntry *base = decode::entries();
+        byEntry.assign(decode::entryCount(), nullptr);
+        for (const Spec &spec : specs) {
+            const decode::DecodeEntry *entry = decode::entryById(spec.id);
+            if (entry != nullptr) {
+                byEntry[static_cast<size_t>(entry - base)] = &spec;
+            }
+        }
+    }
+
+    const Spec *
+    get(const decode::DecodeEntry *entry) const
+    {
+        const decode::DecodeEntry *base = decode::entries();
+        const uintptr_t addr = reinterpret_cast<uintptr_t>(entry);
+        const uintptr_t start = reinterpret_cast<uintptr_t>(base);
+        const uintptr_t end = start + decode::entryCount() * sizeof(*base);
+        if (entry == nullptr || addr < start || addr >= end)
+            return nullptr;
+        return byEntry[static_cast<size_t>(entry - base)];
+    }
+
+  private:
+    std::vector<const Spec *> byEntry;
+};
+
+} // namespace exec
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_EXEC_COMMON_HH__
