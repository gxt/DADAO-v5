+int
+main()
+{
+    checkPositiveAll();
+    checkCoverage();
+    checkSwym();
+    checkFence();
+    checkLr();
+    checkSc();
+    checkCfx();
+    checkTrapEscape();
+    checkDispatch();
+
+    std::printf("\nsummary: B6 coverage 30/30, oracle rows %zu, "
+                "failures %d\n", kOracleCount, failures);
+    return failures == 0 ? 0 : 1;
+}
