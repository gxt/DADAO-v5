+namespace
+{
+
+int failures = 0;
+
+void
+fail(const char *fmt, ...)
+{
+    ++failures;
+    va_list args;
+    va_start(args, fmt);
+    std::printf("[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+}
+
+void
+check(bool condition, const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    std::printf(condition ? "[PASS] " : "[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+    if (!condition)
+        ++failures;
+}
+
+bool
+strEq(const char *a, const char *b)
+{
+    return a != nullptr && b != nullptr && std::strcmp(a, b) == 0;
+}
+
+/** Field-name equality where "absent" (nullptr) is itself a value. */
+bool
+sameField(const char *a, const char *b)
+{
+    if (a == nullptr || b == nullptr)
+        return a == b;
+    return std::strcmp(a, b) == 0;
+}
