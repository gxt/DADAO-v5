+/*
+ * DADAO gem5 B6 execution assertions (GEM5-011t).
+ *
+ * Standalone C++17 harness (no gem5 headers): compiled by
+ * `tools/gem5/check_b6.py` against
+ * src/arch/dadao/{exec/b6.cc,exec/b6_test.cc,decode/decode.cc}.
+ *
+ * Everything here is derived from spec/SimRISC-11 §1-§5 (cfx system
+ * instructions + fence), spec/SimRISC-12 §1.1/§2 (LR/SC + swym),
+ * contract-isa §13.1/§13.6/§14.1/§14.2 and ADR-0034/ADR-0044 -- never from
+ * another implementation:
+ *   * the 30 B6 ids are listed one by one and must equal the live decode-table
+ *     B6 set (batch membership is never guessed from a mnemonic);
+ *   * the oracle rows are independent of exec/b6.cc (width, memory order and
+ *     field names are written out here, one id at a time);
+ *   * static ILLI is checked before any register/cfx/memory access (read and
+ *     write counts are asserted to be zero on the fault paths);
+ *   * MALIGN, CFXREG, CFXESC and Memory are precise: zero architectural
+ *     writes, and the reservation is only consumed by a completed sc.
+ */
