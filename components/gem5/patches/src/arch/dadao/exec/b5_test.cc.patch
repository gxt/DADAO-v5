+
+enum TestOp
+{
+    T_COPY,
+    T_CS,
+    T_BR,
+    T_JUMP,
+    T_CALL,
+    T_RET,
+};
+
+enum Group
+{
+    G_RD,
+    G_RB,
+    G_RA,
+    G_RF,
+};
+
+enum CsKind
+{
+    CS_N,
+    CS_Z,
+    CS_P,
+    CS_EQ,
+    CS_NE,
+};
+
+enum BrKind
+{
+    BR_N,
+    BR_NN,
+    BR_Z,
+    BR_NZ,
+    BR_P,
+    BR_NP,
+    BR_EQ,
+    BR_NE,
+    BR_RB_Z,
+    BR_RB_NZ,
+};
+
+struct Oracle
+{
+    const char *id;
+    TestOp op;
+    const char *format;
+    Group dst;
+    Group src;
+    const char *dstField;
+    const char *srcField;
+    CsKind cs;
+    BrKind br;
+    bool iiii;
+};
