+/*
+ * DADAO gem5 B5 execution assertions (GEM5-010t).
+ *
+ * Standalone C++17 harness (no gem5 headers): compiled by
+ * `tools/gem5/check_b5.py` against
+ * src/arch/dadao/{exec/b5.cc,exec/b5_test.cc,decode/decode.cc}.
+ *
+ * Everything here is derived from spec/SimRISC-02 (block assignment),
+ * spec/SimRISC-06 (control flow), spec/SimRISC-00 §2.4 (RAS),
+ * contract-isa §3.3.3/§4/§6.5/§8 and contract-fp §12 -- never from another
+ * implementation:
+ *   * the 28 B5 ids are listed one by one and must equal the live decode-table
+ *     B5 set (batch membership is never guessed from a mnemonic);
+ *   * the oracle tables are independent of exec/b5.cc (groups, condition
+ *     codes, immediate widths and RAS flows are written out here);
+ *   * static ILLI is checked before any register read (read/write counts are
+ *     asserted to be zero on the ILLI paths);
+ *   * RASOF/RASUF/Memory are precise: zero register/memory writes and the PC
+ *     still points at the call/ret instruction.
+ */
+#include <cinttypes>
+#include <climits>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "arch/dadao/decode/decode.hh"
+#include "arch/dadao/exec/b5.hh"
+#include "arch/dadao/exec/common.hh"
+
+namespace decode = gem5::DadaoISA::decode;
+namespace exec = gem5::DadaoISA::exec;
+
+namespace
+{
+
+int failures = 0;
+
+void
+fail(const char *fmt, ...)
+{
+    ++failures;
+    va_list args;
+    va_start(args, fmt);
+    std::printf("[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+}
+
+void
+check(bool condition, const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    std::printf(condition ? "[PASS] " : "[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+    if (!condition)
+        ++failures;
+}
+
+bool
+strEq(const char *a, const char *b)
+{
+    return a != nullptr && b != nullptr && std::strcmp(a, b) == 0;
+}
+
+constexpr uint64_t kMask48 = 0x0000FFFFFFFFFFFFULL;
+constexpr uint64_t kFcsrMask = (uint64_t(3) << 32) | 0x1F;
+constexpr uint64_t kSbz = 0x2AAULL << 54;
+
+uint64_t
+entryValue(uint64_t count, uint64_t addr)
+{
+    return ((count & 0xFFFF) << 48) | (addr & kMask48);
+}
+
+uint64_t
+ra0Value(uint64_t racnt, uint64_t mrptr)
+{
+    return kSbz | ((racnt & 0x3F) << 48) | (mrptr & kMask48);
+}
