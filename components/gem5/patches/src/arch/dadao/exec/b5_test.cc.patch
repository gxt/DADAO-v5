+constexpr size_t kOracleCount = sizeof(kOracle) / sizeof(kOracle[0]);
+
+const Oracle *
+oracleOf(const char *id)
+{
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        if (strEq(kOracle[i].id, id))
+            return &kOracle[i];
+    }
+    return nullptr;
+}
