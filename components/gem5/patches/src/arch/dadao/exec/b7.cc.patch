+// DADAO gem5 B7 execution core -- the 55 floating-point ids.
+//
+// Dispatch is by `entry->id` only: `ft*`/`fo*`, `ft2it`/`ft2ut`,
+// `qcmp`/`scmp`, `sgnn`/`sgnj` and add/sub/mul/div share their encoding format
+// and differ only in one table field.  The id set below must equal the live
+// batch_of() B7 set of the GEM5-002t matrix (55 rows).
+//
+// Static legality comes from the contract's rule_refs; it is checked before any
+// register read, so an ILLI leaves zero reads and zero writes.  Every FP
+// instruction is free of traps and of architectural faults: only the accrued
+// flags in rf0[4:0] change (contract-fp §1).
+#include "arch/dadao/exec/b7.hh"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <string_view>
+
