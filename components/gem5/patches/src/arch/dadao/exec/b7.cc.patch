+constexpr fp::Fmt F32 = fp::Fmt::F32;
+constexpr fp::Fmt F64 = fp::Fmt::F64;
+constexpr Target TRf = Target::Rf;
+constexpr Target TRd = Target::Rd;
+
+// Legality masks, one per shape of the contract's legality sets.
