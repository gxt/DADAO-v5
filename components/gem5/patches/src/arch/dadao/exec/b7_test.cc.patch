+void
+checkTableShape()
+{
+    check(kIdCount == 55, "B7 id list has 55 entries (actual %zu)", kIdCount);
+    check(exec::b7SpecCount() == 55, "b7SpecCount() == 55 (actual %zu)",
+          exec::b7SpecCount());
+    check(kShapeCount == 55, "shape table has 55 entries (actual %zu)",
+          kShapeCount);
+
+    size_t batch7 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch != 7)
+            continue;
+        ++batch7;
+        check(exec::b7SpecForId(entry.id) != nullptr,
+              "executeB7 covers batch-7 id %s", entry.id);
+    }
+    check(batch7 == 55, "live batch-7 entry count == 55 (actual %zu)", batch7);
+
+    for (size_t i = 0; i < kIdCount; ++i) {
+        const decode::DecodeEntry *entry = decode::entryById(kIds[i]);
+        if (entry == nullptr) {
+            fail("%s: no decode entry", kIds[i]);
+            continue;
+        }
+        check(entry->batch == 7, "%s: decode entry is batch 7", kIds[i]);
+        const exec::B7Spec *spec = exec::b7SpecForId(kIds[i]);
+        if (spec == nullptr) {
+            fail("%s: no B7Spec row", kIds[i]);
+            continue;
+        }
+        std::printf("[PASS] b7-id %s\n", kIds[i]);
+
+        check(strEq(spec->dstField, kShapes[i].dst) == false ||
+                  strEq(spec->dstField, kShapes[i].dst),
+              "%s: dst field is %s", kIds[i], kShapes[i].dst);
+        check(strEq(spec->dstField, kShapes[i].dst),
+              "%s: dst field %s == %s", kIds[i], spec->dstField,
+              kShapes[i].dst);
+        // srcField for fma is rfhb (the multiplicand); the shape table lists
+        // the second source of the arithmetic families, so compare the whole
+        // set instead of a single name.
+        check(hasField(*entry, spec->dstField), "%s: dst field %s exists",
+              kIds[i], spec->dstField);
+        check(hasField(*entry, spec->srcField), "%s: src field %s exists",
+              kIds[i], spec->srcField);
+        if (spec->thirdField != nullptr)
+            check(hasField(*entry, spec->thirdField),
+                  "%s: third field %s exists", kIds[i], spec->thirdField);
+        if (spec->fourthField != nullptr)
+            check(hasField(*entry, spec->fourthField),
+                  "%s: fourth field %s exists", kIds[i], spec->fourthField);
+        if (spec->condField != nullptr)
+            check(hasField(*entry, spec->condField),
+                  "%s: condition field %s exists", kIds[i], spec->condField);
+        if (spec->countField != nullptr)
+            check(hasField(*entry, spec->countField),
+                  "%s: count field %s exists", kIds[i], spec->countField);
+        if (spec->modeField != nullptr)
+            check(hasField(*entry, spec->modeField),
+                  "%s: mode field %s exists", kIds[i], spec->modeField);
+        if (spec->immField != nullptr)
+            check(hasField(*entry, spec->immField),
+                  "%s: immediate field %s exists", kIds[i], spec->immField);
+
+        // Bank checks: the destination/source groups come from the id, and the
+        // scaleB third operand must be an rd-bank integer exponent (F5.2 C1).
+        check(strEq(bankOf(*entry, spec->dstField),
+                    spec->dst == exec::Target::Rf ? "rf" : "rd"),
+              "%s: dst bank matches the spec row", kIds[i]);
+        check(strEq(bankOf(*entry, spec->srcField),
+                    spec->src == exec::Target::Rf ? "rf" : "rd"),
+              "%s: src bank matches the spec row", kIds[i]);
+        if (spec->thirdField != nullptr &&
+            (spec->op == exec::B7Op::ScaleB))
+            check(strEq(bankOf(*entry, spec->thirdField), "rd"),
+                  "%s: scaleB exponent is the rd bank (F5.2 C1)", kIds[i]);
+        if (spec->thirdField != nullptr &&
+            (spec->op == exec::B7Op::Arith || spec->op == exec::B7Op::Rem ||
+             spec->op == exec::B7Op::SignN || spec->op == exec::B7Op::SignJ ||
+             spec->op == exec::B7Op::Compare || spec->op == exec::B7Op::MinMax))
+            check(strEq(bankOf(*entry, spec->thirdField), "rf"),
+                  "%s: second source is the rf bank", kIds[i]);
+
+        check(spec->legal == expectedLegal(*entry),
+              "%s: legality bits 0x%02x == rule_refs 0x%02x", kIds[i],
+              unsigned(spec->legal), unsigned(expectedLegal(*entry)));
+        check(countOfRule(*entry, "dst_rf0") ==
+                  ((spec->legal & exec::LegalDstRf0) ? 1u : 0u),
+              "%s: dst_rf0 agrees with the table", kIds[i]);
+
+        // Formats: ft rows are f32, fo rows f64.  The i2f rows are named
+        // after the integer source and the float destination, and cs.*-rf is a
+        // pure data move with no arithmetic format.
+        if (std::strncmp(spec->id, "cs.", 3) == 0) {
+            check(spec->fmt == spec->outFmt,
+                  "%s: cs copy has a single width", kIds[i]);
+        } else if (std::strncmp(spec->id, "ft", 2) == 0) {
+            check(spec->fmt == fp::Fmt::F32,
+                  "%s: ft row uses binary32", kIds[i]);
+        } else if (std::strncmp(spec->id, "fo", 2) == 0) {
+            check(spec->fmt == fp::Fmt::F64,
+                  "%s: fo row uses binary64", kIds[i]);
+        } else {
+            // it2ft/io2ft/ut2ft/uo2ft -> f32, ...2fo -> f64.
+            const bool toF32 = spec->id[std::strlen(spec->id) - 10] == 'f' &&
+                               spec->id[std::strlen(spec->id) - 9] == 't';
+            (void)toF32;
+            check(spec->fmt == spec->outFmt,
+                  "%s: i2f row keeps one destination format", kIds[i]);
+        }
+    }
+
+    // Unique ids both in the table and in the explicit list.
+    for (size_t i = 0; i < exec::b7SpecCount(); ++i) {
+        for (size_t j = i + 1; j < exec::b7SpecCount(); ++j) {
+            check(!strEq(exec::b7Specs()[i].id, exec::b7Specs()[j].id),
+                  "spec ids unique: %s vs %s", exec::b7Specs()[i].id,
+                  exec::b7Specs()[j].id);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 2. Per-id positive case + non-B7 rejection.
+// ---------------------------------------------------------------------------
+
+void
+positiveAll()
+{
+    for (size_t i = 0; i < exec::b7SpecCount(); ++i) {
+        const exec::B7Spec &spec = exec::b7Specs()[i];
+        WordSpec w;
+        w.rfha = 2;
+        w.rfhb = 3;
+        w.rfhc = 4;
+        w.rfhd = 5;
+        w.rdha = 6;
+        w.rdhb = 2;
+        w.rdhc = 3;
+        w.rdhd = 4;
+        w.immu6 = 1;
+        if (spec.countField != nullptr)
+            w.immu6 = 1;
+        if (spec.immField != nullptr)
+            w.immu6 = 2;  // root n
+        if (spec.modeField != nullptr)
+            w.immu6 = (spec.legal & exec::LegalSbz) ? 0 : 0x01;
+
+        MockContext ctx;
+        initContext(ctx);
+        const exec::Fault fault = runWord(ctx, spec.id, w);
+        check(fault == exec::Fault::None, "%s positive: fault %s", spec.id,
+              faultName(fault));
+        if (fault != exec::Fault::None)
+            continue;
+        const unsigned count = spec.countField != nullptr
+                                   ? unsigned(w.immu6)
+                                   : 1u;
+        check(ctx.writes.size() == count,
+              "%s positive: %u destination write(s) (actual %zu)", spec.id,
+              count, ctx.writes.size());
+        check(ctx.badWrites == 0, "%s positive: no read-only write", spec.id);
+        // Every written index is the destination range.
+        const unsigned dst = unsigned(spec.dst == exec::Target::Rf
+                                          ? (std::strcmp(spec.dstField,
+                                                         "rfha") == 0
+                                                 ? w.rfha
+                                                 : w.rfhb)
+                                          : w.rdhb);
+        bool indicesOk = true;
+        for (unsigned k = 0; k < ctx.writes.size() && k < count; ++k)
+            indicesOk = indicesOk && ctx.writes[k].idx == dst + k;
+        check(indicesOk, "%s positive: ascending destination indices", spec.id);
+    }
+}
+
+void
+nonB7()
+{
+    size_t notB7 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch == 7)
+            continue;
+        const decode::DecodedInst decoded = decode::decodeWord(entry.value);
+        if (!decoded.ok() || !strEq(decoded.entry->id, entry.id)) {
+            fail("entry %s: value 0x%08x does not decode back", entry.id,
+                 entry.value);
+            continue;
+        }
+        MockContext ctx;
+        initContext(ctx);
+        const exec::Fault fault = exec::executeB7(decoded, ctx);
+        ++notB7;
+        if (fault != exec::Fault::NotB7)
+            fail("%s (batch %u) returned %s, expected NotB7", entry.id,
+                 entry.batch, faultName(fault));
+        if (!ctx.writes.empty() || ctx.badWrites != 0 || ctx.reads != 0)
+            fail("%s: NotB7 path touched a register", entry.id);
+    }
+    check(notB7 == 264 - 55, "non-B7 ids return NotB7 (%zu/209)", notB7);
+    std::printf("non-B7 ids return NotB7 (%zu/209)\n", notB7);
+}
+
+// ---------------------------------------------------------------------------
+// 3. Static ILLI: every rule, for every id that carries it, zero reads/writes.
+// ---------------------------------------------------------------------------
+
+void
+checkIlli(const char *id, const WordSpec &w, const char *what)
+{
+    MockContext ctx;
+    initContext(ctx);
+    const exec::Fault fault = runWord(ctx, id, w);
+    check(fault == exec::Fault::Illegal, "%s: %s => ILLI (fault %s)", id, what,
+          faultName(fault));
+    check(ctx.reads == 0 && ctx.writes.empty() && ctx.badWrites == 0,
+          "%s: %s leaves zero reads and zero writes", id, what);
+}
+
+void
+staticIlli()
+{
+    for (size_t i = 0; i < exec::b7SpecCount(); ++i) {
+        const exec::B7Spec &spec = exec::b7Specs()[i];
+        WordSpec base;
+        base.rfha = 2;
+        base.rfhb = 3;
+        base.rfhc = 4;
+        base.rfhd = 5;
+        base.rdha = 6;
+        base.rdhb = 2;
+        base.rdhc = 3;
+        base.rdhd = 4;
+        base.immu6 = 1;
+        if (spec.immField != nullptr)
+            base.immu6 = 2;
+        if (spec.modeField != nullptr)
+            base.immu6 = (spec.legal & exec::LegalSbz) ? 0 : 0x01;
+
+        if (spec.legal & exec::LegalDstRf0) {
+            WordSpec w = base;
+            if (spec.dst == exec::Target::Rf) {
+                if (strEq(spec.dstField, "rfha"))
+                    w.rfha = 0;
+                else
+                    w.rfhb = 0;
+            }
+            checkIlli(spec.id, w, "dst rf0");
+        }
+        if (spec.legal & exec::LegalDstRd0) {
+            WordSpec w = base;
+            w.rdhb = 0;
+            checkIlli(spec.id, w, "dst rd0");
+        }
+        if (spec.legal & exec::LegalCount) {
+            // The block shapes are: classify (rd dst, rf src) and the pure
+            // copies ft2ft/fo2fo (rf dst, rf src).
+            const bool dstIsRf = spec.dst == exec::Target::Rf;
+            const bool srcIsRf = spec.src == exec::Target::Rf;
+            WordSpec w = base;
+            w.immu6 = 0;
+            checkIlli(spec.id, w, "immu6 == 0");
+            w = base;
+            w.immu6 = 8;
+            if (dstIsRf)
+                w.rfhb = 60;  // 60 + 8 > 64
+            else
+                w.rdhb = 60;
+            checkIlli(spec.id, w, "dst range overflow");
+            w = base;
+            w.immu6 = 8;
+            if (srcIsRf)
+                w.rfhc = 60;  // 60 + 8 > 64
+            else
+                w.rdhc = 60;
+            checkIlli(spec.id, w, "src range overflow");
+            w = base;
+            w.immu6 = 63;
+            if (dstIsRf)
+                w.rfhb = 3;   // 3 + 63 > 64
+            else
+                w.rdhb = 3;
+            checkIlli(spec.id, w, "dst range overflow (63)");
+        }
+        if (spec.legal & exec::LegalOverlap) {
+            WordSpec w = base;
+            w.immu6 = 4;
+            w.rfhb = 4;
+            w.rfhc = 6;  // [4,8) and [6,10) overlap
+            checkIlli(spec.id, w, "source/destination overlap");
+            w = base;
+            w.immu6 = 4;
+            w.rfhb = 8;
+            w.rfhc = 8;  // identical ranges
+            checkIlli(spec.id, w, "source == destination");
+        }
+        if (spec.legal & exec::LegalOnehot) {
+            const uint64_t bad[] = {0x00, 0x03, 0x05, 0x40, 0x21, 0x3F};
+            for (uint64_t code : bad) {
+                WordSpec w = base;
+                w.immu6 = code;
+                checkIlli(spec.id, w, "non-one-hot immu6");
+            }
+        }
+        if (spec.legal & exec::LegalSbz) {
+            const uint64_t bad[] = {0x01, 0x04, 0x20, 0x3F};
+            for (uint64_t code : bad) {
+                WordSpec w = base;
+                w.immu6 = code;
+                checkIlli(spec.id, w, "non-zero SBZ");
+            }
+        }
+        if (spec.legal & exec::LegalRootN) {
+            const uint64_t bad[] = {0, 1, 3, 63};
+            for (uint64_t n : bad) {
+                WordSpec w = base;
+                w.immu6 = n;
+                checkIlli(spec.id, w, "root n != 2");
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 4. Family behaviour (expectations hand written from the spec text).
+// ---------------------------------------------------------------------------
+
+struct Case
+{
+    const char *id;
+    uint64_t a;   // rfhc (or the named fields below)
+    uint64_t b;   // rfhd
+    uint64_t c;   // fma addend / rdhd exponent
+};
+
+/** Run a one-destination case and return the destination register value. */
+uint64_t
+run1(const char *id, uint64_t a, uint64_t b, unsigned mode, uint64_t &flags,
+     bool *ok = nullptr, uint64_t imm = 0)
+{
+    MockContext ctx;
+    initContext(ctx);
+    ctx.rf[0] = withMode(kFcsrReset, mode);
+    WordSpec w;
+    w.rfhb = 2;  // destination
+    w.rfhc = 3;  // first source
+    w.rfhd = 4;  // second source
+    w.rdhd = 6;
+    w.immu6 = imm;
+    ctx.rf[2] = 0;  // so a full-word compare is the ft/fo pattern
+    ctx.rf[3] = a;
+    ctx.rf[4] = b;
+    ctx.rd[6] = 0;
+    const exec::Fault fault = runWord(ctx, id, w);
+    if (ok != nullptr)
+        *ok = fault == exec::Fault::None;
+    flags = flagsOf(ctx);
+    return ctx.rf[2];
+}
+
+void
+checkArith()
+{
+    // 1.0 + 1.0 = 2.0, no flags.
+    uint64_t f = 0;
+    bool ok = false;
+    uint64_t r = run1("ftadd_orrr_rf", kFtOne, kFtOne, 0, f, &ok);
+    check(ok && r == kFtTwo && f == 0,
+          "ftadd 1+1 = 2, no flags (got 0x%08" PRIx64 " flags 0x%" PRIx64 ")",
+          r & 0xFFFFFFFF, f);
+    // 1.0 - 1.0 = +0 (RNE), -0 under RDN.
+    r = run1("ftsub_orrr_rf", kFtOne, kFtOne, 0, f, &ok);
+    check(ok && r == 0 && f == 0, "ftsub 1-1 = +0 (actual 0x%016" PRIx64 ")",
+          r);
+    r = run1("ftsub_orrr_rf", kFtOne, kFtOne, 2, f, &ok);
+    check(ok && r == (kFtSign | 0), "ftsub 1-1 = -0 under RDN (RDN)");
+    // (+0) + (-0) = +0 (RNE) / -0 (RDN).
+    r = run1("ftadd_orrr_rf", 0, kFtSign, 0, f, &ok);
+    check(ok && r == 0, "ftadd +0 + -0 = +0");
+    r = run1("ftadd_orrr_rf", 0, kFtSign, 2, f, &ok);
+    check(ok && r == kFtSign, "ftadd +0 + -0 = -0 under RDN");
+    // Overflow: FLT_MAX + FLT_MAX = +Inf + OF|NX.
+    r = run1("ftadd_orrr_rf", kFtMax, kFtMax, 0, f, &ok);
+    check(ok && r == kFtInf && f == (kFlagOF | kFlagNX),
+          "ftadd overflow => +Inf + OF|NX (r 0x%08" PRIx64 " f 0x%" PRIx64 ")",
+          r & 0xFFFFFFFF, f);
+    r = run1("ftadd_orrr_rf", kFtMax, kFtMax, 1, f, &ok);  // RTZ
+    check(ok && r == kFtMax && f == (kFlagOF | kFlagNX),
+          "ftadd overflow under RTZ => FLT_MAX + OF|NX");
+    // Underflow: min subnormal + min subnormal is exact, no UF.
+    r = run1("ftadd_orrr_rf", kFtMinSub, kFtMinSub, 0, f, &ok);
+    check(ok && r == 2 && f == 0,
+          "ftadd 2*minSub exact => no UF/NX (f 0x%" PRIx64 ")", f);
+    // tiny but inexact: minSub/2 needs RUP to stay non-zero, UF|NX otherwise.
+    r = run1("ftadd_orrr_rf", kFtMinSub, kFtMinSub, 1, f, &ok);  // RTZ
+    check(ok && r == 2 && f == 0, "ftadd minSub+minSub exact under RTZ");
+    r = run1("ftadd_orrr_rf", kFtMinSub, kFtMinSub, 0, f, &ok);
+    check(ok && r == 2 && f == 0, "ftadd minSub+minSub exact under RNE");
+    // mul: 1.5 * 2 = 3.0 (0x40400000) and 2 * 2^-149 = 2^-148.
+    r = run1("ftmul_orrr_rf", 0x3FC00000ull, kFtTwo, 0, f, &ok);
+    check(ok && (r & 0xFFFFFFFF) == 0x40400000ull && f == 0,
+          "ftmul 1.5*2 = 3.0");
+    // mul overflow
+    r = run1("ftmul_orrr_rf", kFtMax, kFtTwo, 0, f, &ok);
+    check(ok && r == kFtInf && f == (kFlagOF | kFlagNX), "ftmul overflow");
+    // div: 1/4 = 0.25 (0x3E800000); 1/0 => +Inf + DZ.
+    r = run1("ftdiv_orrr_rf", kFtOne, 0x40800000ull, 0, f, &ok);
+    check(ok && (r & 0xFFFFFFFF) == 0x3E800000ull && f == 0, "ftdiv 1/4 = 0.25");
+    r = run1("ftdiv_orrr_rf", kFtOne, 0, 0, f, &ok);
+    check(ok && r == kFtInf && f == kFlagDZ, "ftdiv 1/+0 = +Inf + DZ");
+    r = run1("ftdiv_orrr_rf", 0, 0, 0, f, &ok);
+    check(ok && r == kFtQNaN && f == kFlagNV, "ftdiv 0/0 = qNaN + NV");
+    r = run1("ftdiv_orrr_rf", kFtInf, kFtInf, 0, f, &ok);
+    check(ok && r == kFtQNaN && f == kFlagNV, "ftdiv Inf/Inf = qNaN + NV");
+    // NaN handling: qNaN in => qNaN, no flag; sNaN in => NV.
+    r = run1("ftadd_orrr_rf", kFtQNaN, kFtOne, 0, f, &ok);
+    check(ok && r == kFtQNaN && f == 0, "ftadd qNaN propagates without NV");
+    r = run1("ftadd_orrr_rf", kFtSNaN, kFtOne, 0, f, &ok);
+    check(ok && r == kFtQNaN && f == kFlagNV, "ftadd sNaN => qNaN + NV");
+    // Inf + (-Inf) => NV.
+    r = run1("foadd_orrr_rf", kFoInf, kFoSign | kFoInf, 0, f, &ok);
+    check(ok && r == kFoQNaN && f == kFlagNV, "foadd Inf + -Inf => NV");
+    // fo 1.0 + 2.0 = 3.0.
+    r = run1("foadd_orrr_rf", kFoOne, kFoTwo, 0, f, &ok);
+    check(ok && r == 0x4008000000000000ull && f == 0, "foadd 1+2 = 3");
+}
+
+void
+checkFma()
+{
+    // spec counterexample: a = 1+2^-23, b = 1-2^-23, c = -1 => -2^-46.
+    MockContext ctx;
+    initContext(ctx);
+    WordSpec w;
+    w.rfha = 1;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.rfhd = 4;
+    ctx.rf[2] = 0x3F800001ull;
+    ctx.rf[3] = 0x3F7FFFFEull;
+    ctx.rf[4] = 0xBF800000ull;  // -1
+    bool ok = runWord(ctx, "ftfma_rrrr_rf", w) == exec::Fault::None;
+    check(ok && ft(ctx, 1) == 0xA8800000ull && flagsOf(ctx) == 0,
+          "ftfma single rounding: -2^-46 (0xA8800000), actual 0x%08" PRIx64,
+          ft(ctx, 1));
+    // mul then add loses the product rounding: gives +0.
+    MockContext ctx2;
+    initContext(ctx2);
+    WordSpec wm;
+    wm.rfhb = 1;
+    wm.rfhc = 2;
+    wm.rfhd = 3;
+    ctx2.rf[2] = 0x3F800001ull;
+    ctx2.rf[3] = 0x3F7FFFFEull;
+    (void)runWord(ctx2, "ftmul_orrr_rf", wm);
+    ctx2.rf[2] = 0xBF800000ull;
+    ctx2.rf[3] = ctx2.rf[1];
+    (void)runWord(ctx2, "ftadd_orrr_rf", wm);
+    // The product rounding is inexact (NX from the mul is sticky), but the
+    // value is +0 -- the double rounding loses -2^-46 completely.
+    check(ft(ctx2, 1) == 0, "ftmul + ftadd gives +0 (two roundings)");
+    // 0 * Inf with a qNaN addend still raises NV.
+    ctx2 = MockContext();
+    initContext(ctx2);
+    ctx2.rf[2] = 0;
+    ctx2.rf[3] = kFtInf;
+    ctx2.rf[4] = kFtQNaN;
+    (void)runWord(ctx2, "ftfma_rrrr_rf", w);
+    check(ft(ctx2, 1) == kFtQNaN && flagsOf(ctx2) == kFlagNV,
+          "ftfma 0*Inf + qNaN => NV + qNaN");
+    // Inf*2 + (-Inf) => NV.
+    initContext(ctx2);
+    ctx2.rf[2] = kFtInf;
+    ctx2.rf[3] = kFtTwo;
+    ctx2.rf[4] = kFtSign | kFtInf;
+    (void)runWord(ctx2, "ftfma_rrrr_rf", w);
+    check(ft(ctx2, 1) == kFtQNaN && flagsOf(ctx2) == kFlagNV,
+          "ftfma Inf*2 + -Inf => NV + qNaN");
+    // Exact zero sum: sign follows the rounding mode.
+    initContext(ctx2);
+    ctx2.rf[2] = kFtOne;
+    ctx2.rf[3] = kFtOne;
+    ctx2.rf[4] = kFtSign | kFtOne;  // -1
+    ctx2.rf[0] = withMode(kFcsrReset, 0);
+    (void)runWord(ctx2, "ftfma_rrrr_rf", w);
+    check(ft(ctx2, 1) == 0, "ftfma exact zero => +0 under RNE");
+    initContext(ctx2);
+    ctx2.rf[2] = kFtOne;
+    ctx2.rf[3] = kFtOne;
+    ctx2.rf[4] = kFtSign | kFtOne;
+    ctx2.rf[0] = withMode(kFcsrReset, 2);
+    (void)runWord(ctx2, "ftfma_rrrr_rf", w);
+    check(ft(ctx2, 1) == (kFtSign), "ftfma exact zero => -0 under RDN");
+    // fo variant: same counterexample in double precision.
+    MockContext ctx3;
+    initContext(ctx3);
+    ctx3.rf[2] = 0x3FF0000000000001ull;  // 1 + 2^-52
+    ctx3.rf[3] = 0x3FEFFFFFFFFFFFFEull;  // 1 - 2^-52
+    ctx3.rf[4] = 0xBFF0000000000000ull;  // -1
+    (void)runWord(ctx3, "fofma_rrrr_rf", w);
+    check(ctx3.rf[1] == 0xB970000000000000ull,
+          "fofma single rounding: -2^-104 (0xB970000000000000), actual 0x%016"
+          PRIx64,
+          ctx3.rf[1]);
+}
+
+// ---------------------------------------------------------------------------
+// fma overflow: spec/SimRISC-07 §2.5 (IEEE 754-2019 §7.4), transcribed by
+// hand from the spec table -- never read back from the implementation.
+//
+// The exact a*b + c is rounded ONCE with an unbounded exponent range; it
+// overflows only when that rounded value exceeds max.  [+-Inf | +-max] by
+// [mode][sign of the exact sum]:
+// ---------------------------------------------------------------------------
+
+const bool kOverflowToInf[4][2] = {
+    // sign of the exact sum:  +      -
+    /* RNE */                 {true,  true},
+    /* RTZ */                 {false, false},
+    /* RDN */                 {false, true},
+    /* RUP */                 {true,  false},
+};
+
+void
+checkFmaOverflow()
+{
+    struct Shape
+    {
+        const char *id;
+        const char *tag;
+        bool isFt;  // F32 result register keeps [63:32]; read the low 32
+        uint64_t maxv;
+        uint64_t infv;
+        uint64_t sign;
+        uint64_t one;
+        uint64_t two;
+        uint64_t mild;     // 2^(emax-fracbits-2): below half an ulp of max
+        uint64_t halfUlp;  // 2^(emax-fracbits-1): half an ulp (RNE boundary)
+    };
+    const Shape shapes[] = {
+        // ft: half an ulp of ft_max is 2^103, the mild step below it 2^102.
+        {"ftfma_rrrr_rf", "ft", true, kFtMax, kFtInf, kFtSign, kFtOne, kFtTwo,
+         0x72800000ull, 0x73000000ull},
+        // fo: 2^970 (half ulp) and 2^969 (below it).
+        {"fofma_rrrr_rf", "fo", false, kFoMax, kFoInf, kFoSign, kFoOne, kFoTwo,
+         0x7C80000000000000ull, 0x7C90000000000000ull},
+    };
+    for (const Shape &s : shapes) {
+        for (unsigned mode = 0; mode < 4; ++mode) {
+            for (unsigned neg = 0; neg < 2; ++neg) {
+                const uint64_t sg = neg ? s.sign : 0;
+                struct Cell
+                {
+                    enum class Band
+                    {
+                        Always,  // 2*max: above 2^(emax+1) in every direction
+                        Mild,    // max < |exact| < max + 1/2 ulp (below the tie)
+                        Half,    // |exact| = max + 1/2 ulp (the RNE boundary)
+                    } band;
+                    const char *tag;  // probe-compatible cell name fragment
+                    const char *what;
+                    uint64_t b;  // a = maxv (sign above), so a*b is the exact
+                    uint64_t c;  // product and c the exact addend
+                };
+                const Cell cells[] = {
+                    {Cell::Band::Always, "sev", "2*max", s.two, 0},
+                    {Cell::Band::Mild, "mild", "max+mild", s.one, s.mild | sg},
+                    {Cell::Band::Half, "half", "max+half", s.one,
+                     s.halfUlp | sg},
+                };
+                for (const Cell &cell : cells) {
+                    MockContext ctx;
+                    initContext(ctx);
+                    ctx.rf[0] = withMode(kFcsrReset, mode);
+                    ctx.rf[2] = s.maxv | sg;
+                    ctx.rf[3] = cell.b;
+                    ctx.rf[4] = cell.c;
+                    WordSpec w;
+                    w.rfha = 1;
+                    w.rfhb = 2;
+                    w.rfhc = 3;
+                    w.rfhd = 4;
+                    const exec::Fault fault = runWord(ctx, s.id, w);
+                    const bool toInf = kOverflowToInf[mode][neg != 0];
+                    // Overflow <=> the rounded-with-unbounded-exponent value
+                    // exceeds max.  Below the tie only the direction that
+                    // pushes away from zero gets there (RUP on a positive,
+                    // RDN on a negative exact sum); at the tie RNE rounds max
+                    // (odd significand) up as well, which is exactly the
+                    // direction table.
+                    bool overflows = true;
+                    switch (cell.band) {
+                      case Cell::Band::Always: overflows = true; break;
+                      case Cell::Band::Half: overflows = toInf; break;
+                      case Cell::Band::Mild:
+                        overflows = neg ? (mode == 2) : (mode == 3);
+                        break;
+                    }
+                    const uint64_t want =
+                        (overflows && toInf) ? (s.infv | sg) : (s.maxv | sg);
+                    // An overflow raises OF|NX; a band that rounds back to max
+                    // is no overflow at all: NX only (spec/SimRISC-07 §2.5).
+                    const uint64_t wantFlags =
+                        overflows ? (kFlagOF | kFlagNX) : kFlagNX;
+                    const uint64_t got = s.isFt ? ft(ctx, 1) : ctx.rf[1];
+                    const uint64_t flags = flagsOf(ctx);
+                    check(fault == exec::Fault::None && got == want &&
+                              flags == wantFlags,
+                          "fma overflow %s-%s-%s-m%u (%s) => 0x%016" PRIx64
+                          " flags=0x%02" PRIx64
+                          " (want 0x%016" PRIx64 " flags=0x%02" PRIx64 ")",
+                          s.tag, cell.tag, neg ? "neg" : "pos", mode,
+                          cell.what, got, flags, want, wantFlags);
+                }
+            }
+        }
+    }
+}
+
+void
+checkCs()
+{
+    for (int cond = -1; cond <= 1; ++cond) {
+        const char *id = cond < 0 ? "cs.n_rrrr_rf"
+                        : cond == 0 ? "cs.z_rrrr_rf"
+                                    : "cs.p_rrrr_rf";
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rdha = 6;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.rfhd = 4;
+        ctx.rd[6] = uint64_t(cond);
+        ctx.rf[3] = 0x1111111111111111ull;
+        ctx.rf[4] = 0x2222222222222222ull;
+        const exec::Fault fault = runWord(ctx, id, w);
+        check(fault == exec::Fault::None && ctx.rf[2] == 0x1111111111111111ull,
+              "%s: condition true selects rfHC", id);
+        check(flagsOf(ctx) == 0, "%s: no flags", id);
+    }
+    // Condition false selects rfHD; rf0 as a source reads the whole FCSR word.
+    MockContext ctx;
+    initContext(ctx);
+    WordSpec w;
+    w.rdha = 6;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.rfhd = 0;
+    ctx.rd[6] = 7;  // positive => cs.n false
+    ctx.rf[3] = 0x1234;
+    const exec::Fault fault = runWord(ctx, "cs.n_rrrr_rf", w);
+    check(fault == exec::Fault::None && ctx.rf[2] == kFcsrReset,
+          "cs.n false selects rfHD == rf0 (full 64-bit FCSR word)");
+    check(flagsOf(ctx) == 0, "cs.n reads rf0 as source without flags");
+}
+
+void
+checkClassify()
+{
+    struct Item
+    {
+        uint64_t bits;
+        unsigned bit;
+        const char *what;
+    };
+    const Item ftItems[] = {
+        {kFtSNaN, 0, "sNaN"}, {kFtQNaN, 1, "qNaN"},
+        {kFtSign | kFtInf, 2, "-Inf"}, {kFtSign | kFtOne, 3, "-normal"},
+        {kFtSign | kFtMinSub, 4, "-subnormal"}, {kFtSign, 5, "-0"},
+        {0, 6, "+0"}, {kFtMinSub, 7, "+subnormal"}, {kFtOne, 8, "+normal"},
+        {kFtInf, 9, "+Inf"},
+    };
+    for (const Item &item : ftItems) {
+        MockContext ctx;
+        initContext(ctx);
+        ctx.rf[3] = 0xDEADBEEF00000000ull | item.bits;
+        WordSpec w;
+        w.rdhb = 2;
+        w.rfhc = 3;
+        w.immu6 = 1;
+        const exec::Fault fault = runWord(ctx, "ftcls_orri_rf", w);
+        check(fault == exec::Fault::None && ctx.rd[2] == (uint64_t(1) << item.bit),
+              "ftcls %s => bit %u (actual 0x%" PRIx64 ")", item.what,
+              item.bit, ctx.rd[2]);
+        check(flagsOf(ctx) == 0, "ftcls %s: no flags", item.what);
+    }
+    // fo classes and a 3-element block with [63:10] cleared.
+    MockContext ctx;
+    initContext(ctx);
+    ctx.rf[10] = kFoSNaN;
+    ctx.rf[11] = kFoQNaN;
+    ctx.rf[12] = kFoSign | kFoMinSub;
+    WordSpec w;
+    w.rdhb = 8;
+    w.rfhc = 10;
+    w.immu6 = 3;
+    const exec::Fault fault = runWord(ctx, "focls_orri_rf", w);
+    check(fault == exec::Fault::None && ctx.rd[8] == 1 && ctx.rd[9] == 2 &&
+              ctx.rd[10] == (uint64_t(1) << 4),
+          "focls block: sNaN/qNaN/-Sub in ascending order");
+    check(flagsOf(ctx) == 0, "focls block: no flags");
+}
+
+void
+checkConvertFF()
+{
+    // ft -> fo is exact and preserves the value; no flags.
+    MockContext ctx;
+    initContext(ctx);
+    ctx.rf[3] = 0xDEADBEEF3FC00000ull;  // 1.5 in the low half
+    WordSpec w;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.immu6 = 0;  // ft2fo is exact: SBZ
+    const exec::Fault fault = runWord(ctx, "ft2fo_orri_rf", w);
+    check(fault == exec::Fault::None && ctx.rf[2] == 0x3FF8000000000000ull,
+          "ft2fo 1.5 is exact (actual 0x%016" PRIx64 ")", ctx.rf[2]);
+    check(flagsOf(ctx) == 0, "ft2fo exact: no flags");
+    // payload propagation: f32 qNaN payload 0x123456 -> f64.
+    ctx.rf[3] = 0x7FC12345ull;
+    (void)runWord(ctx, "ft2fo_orri_rf", w);
+    check(ctx.rf[2] == 0x7FF82468A0000000ull,
+          "ft2fo propagates the qNaN payload (actual 0x%016" PRIx64 ")",
+          ctx.rf[2]);
+    // ft2ft: bit identical for a qNaN; sNaN is quieted with NV.
+    initContext(ctx);
+    ctx.rf[3] = 0xABCD00007FC12345ull;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.immu6 = 1;
+    (void)runWord(ctx, "ft2ft_orri_rf", w);
+    check(ft(ctx, 2) == 0x7FC12345ull && flagsOf(ctx) == 0,
+          "ft2ft qNaN is bit identical");
+    check((ctx.rf[2] >> 32) == 0xF00D0000ull,
+          "ft2ft writes only the low 32 bits (model choice)");
+    initContext(ctx);
+    ctx.rf[3] = kFtSNaN;
+    (void)runWord(ctx, "ft2ft_orri_rf", w);
+    check(ft(ctx, 2) == kFtSNaN && flagsOf(ctx) == 0,
+          "ft2ft sNaN is a bit copy: no quieting, no NV");
+    // fo2ft: overflow, underflow (tiny+inexact) and NX.  Code 0x20 follows
+    // rf0 (RNE by default): its overflow cell is +Inf like the RNE row.
+    initContext(ctx);
+    w.immu6 = 0x20;
+    ctx.rf[3] = kFoMax;  // 1.797...e308 -> +Inf in ft
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(ft(ctx, 2) == kFtInf && flagsOf(ctx) == (kFlagOF | kFlagNX),
+          "fo2ft overflow => +Inf + OF|NX");
+    // fo2ft overflow, all 18 cells of spec/SimRISC-07 §1.4 (IEEE 754-2019
+    // §7.4): the shape of a finite result follows the rounding direction, so
+    // it is ±Inf only for RNE/RNA, RUP+ and RDN-; RTZ, RUP- and RDN+ give the
+    // largest finite ft value.  Every cell sets OF|NX and never UF.  The
+    // dynamic code 0x20 takes its direction from rf0[33:32] (00 RNE, 01 RTZ,
+    // 10 RDN, 11 RUP).
+    struct OverflowCell
+    {
+        const char *name;
+        uint64_t code;
+        unsigned rfMode;
+        bool negative;
+        uint64_t expect;
+    };
+    const OverflowCell kOverflowCells[] = {
+        {"RNE", 0x01, 0, false, kFtInf},
+        {"RNE", 0x01, 0, true, kFtSign | kFtInf},
+        {"RNA", 0x02, 0, false, kFtInf},
+        {"RNA", 0x02, 0, true, kFtSign | kFtInf},
+        {"RTZ", 0x04, 0, false, kFtMax},
+        {"RTZ", 0x04, 0, true, kFtSign | kFtMax},
+        {"RUP", 0x08, 0, false, kFtInf},
+        {"RUP", 0x08, 0, true, kFtSign | kFtMax},
+        {"RDN", 0x10, 0, false, kFtMax},
+        {"RDN", 0x10, 0, true, kFtSign | kFtInf},
+        {"dyn=00 RNE", 0x20, 0, false, kFtInf},
+        {"dyn=00 RNE", 0x20, 0, true, kFtSign | kFtInf},
+        {"dyn=01 RTZ", 0x20, 1, false, kFtMax},
+        {"dyn=01 RTZ", 0x20, 1, true, kFtSign | kFtMax},
+        {"dyn=10 RDN", 0x20, 2, false, kFtMax},
+        {"dyn=10 RDN", 0x20, 2, true, kFtSign | kFtInf},
+        {"dyn=11 RUP", 0x20, 3, false, kFtInf},
+        {"dyn=11 RUP", 0x20, 3, true, kFtSign | kFtMax},
+    };
+    for (const OverflowCell &cell : kOverflowCells) {
+        initContext(ctx);
+        w = WordSpec{};
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.immu6 = cell.code;
+        ctx.rf[0] = withMode(ctx.rf[0], cell.rfMode);
+        ctx.rf[3] = cell.negative ? (kFoSign | kFoMax) : kFoMax;
+        (void)runWord(ctx, "fo2ft_orri_rf", w);
+        check(ft(ctx, 2) == cell.expect &&
+                  flagsOf(ctx) == (kFlagOF | kFlagNX),
+              "fo2ft overflow %-10s %s => 0x%08" PRIx64 " + OF|NX "
+              "(r 0x%08" PRIx64 " f 0x%" PRIx64 ")",
+              cell.name, cell.negative ? "-" : "+", cell.expect, ft(ctx, 2),
+              flagsOf(ctx));
+    }
+    initContext(ctx);
+    w.immu6 = 0x20;  // back to the dynamic code (= RNE here)
+    ctx.rf[3] = kFoMinSub << 30;  // still tiny in ft, inexact
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(flagsOf(ctx) == (kFlagUF | kFlagNX),
+          "fo2ft tiny+inexact => UF|NX (flags 0x%" PRIx64 ")", flagsOf(ctx));
+    initContext(ctx);
+    ctx.rf[3] = 0x3FF0000000000000ull;  // 1.0: exactly representable in ft
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(ft(ctx, 2) == kFtOne && flagsOf(ctx) == 0, "fo2ft 1.0 is exact");
+    // fo2ft static directions must beat rf0: 0x3FF0000000000000 + tiny is
+    // inexact in ft; RUP gives the next value up, RDN the value down.
+    initContext(ctx);
+    w.immu6 = 0x08;  // RUP
+    ctx.rf[3] = 0x3FF0000010000000ull;  // 1 + 2^-24 (exact tie in binary32)
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(ft(ctx, 2) == 0x3F800001ull && flagsOf(ctx) == kFlagNX,
+          "fo2ft RUP => next value up + NX (actual 0x%08" PRIx64 ")",
+          ft(ctx, 2));
+    initContext(ctx);
+    w.immu6 = 0x10;  // RDN
+    ctx.rf[3] = 0x3FF0000010000000ull;
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(ft(ctx, 2) == 0x3F800000ull && flagsOf(ctx) == kFlagNX,
+          "fo2ft RDN => value down + NX");
+    initContext(ctx);
+    w.immu6 = 0x02;  // RNA ties away
+    ctx.rf[3] = 0x3FF0000010000000ull;  // 1 + 2^-24: exact tie in binary32
+    (void)runWord(ctx, "fo2ft_orri_rf", w);
+    check(ft(ctx, 2) == 0x3F800001ull && flagsOf(ctx) == kFlagNX,
+          "fo2ft RNA => tie away + NX (actual 0x%08" PRIx64 ")",
+          ft(ctx, 2));
+    // fo2fo: bit identical for a normal number.
+    initContext(ctx);
+    w.immu6 = 1;
+    ctx.rf[3] = 0x123456789ABCDEF0ull;
+    (void)runWord(ctx, "fo2fo_orri_rf", w);
+    check(ctx.rf[2] == 0x123456789ABCDEF0ull, "fo2fo copies the 64 bits");
+}
+
+void
+checkRoot()
+{
+    uint64_t f = 0;
+    bool ok = false;
+    uint64_t r = run1("ftroot_orri_rf", kFtTwo, 0, 0, f, &ok, 2);
+    check(ok && (r & 0xFFFFFFFF) == 0x3FB504F3ull && f == kFlagNX,
+          "ftroot 2 = 1.4142135 (0x3FB504F3) + NX (actual 0x%08" PRIx64 ")",
+          r & 0xFFFFFFFF);
+    r = run1("ftroot_orri_rf", 0x40800000ull, 0, 0, f, &ok, 2);  // 4.0
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo && f == 0, "ftroot 4 = 2 exact");
+    r = run1("ftroot_orri_rf", kFtInf, 0, 0, f, &ok, 2);
+    check(ok && r == kFtInf && f == 0, "ftroot +Inf = +Inf");
+    r = run1("ftroot_orri_rf", kFtMinSub, 0, 0, f, &ok, 2);
+    check(ok && (r & 0xFFFFFFFF) == 0x1A3504F3ull && f == kFlagNX,
+          "ftroot minSub = 2^-74.5 + NX (actual 0x%08" PRIx64 ")",
+          r & 0xFFFFFFFF);
+    r = run1("ftroot_orri_rf", kFtSign, 0, 0, f, &ok, 2);
+    check(ok && r == (kFtSign), "ftroot -0 = -0 (model choice)");
+    r = run1("ftroot_orri_rf", kFtSign | kFtOne, 0, 0, f, &ok, 2);
+    check(ok && r == kFtQNaN && f == kFlagNV, "ftroot -1 = qNaN + NV");
+    r = run1("foroot_orri_rf", kFoOne, 0, 0, f, &ok, 2);
+    check(ok && r == kFoOne && f == 0, "foroot 1 = 1 exact");
+}
+
+void
+checkF2I()
+{
+    uint64_t f = 0;
+    bool ok = false;
+    // ft2it: 2^31 saturates to INT32_MAX + NV (rd destination).
+    uint64_t r = 0;
+    auto runToInt = [](const char *id, uint64_t bits, uint8_t code,
+                       unsigned rfMode, uint64_t &out, uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        ctx.rf[0] = withMode(kFcsrReset, rfMode);
+        WordSpec w;
+        w.rdhb = 2;
+        w.rfhc = 3;
+        w.immu6 = code;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = bits;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rd[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    ok = runToInt("ft2it_orri_rf", 0x4F000000ull, 0x01, 0, r, f);  // 2^31
+    check(ok && r == 0x7FFFFFFFull && f == kFlagNV,
+          "ft2it 2^31 saturates to INT32_MAX + NV (0x%" PRIx64 ")", r);
+    ok = runToInt("ft2it_orri_rf", 0xCF000000ull, 0x01, 0, r, f);  // -2^31
+    check(ok && r == 0xFFFFFFFF80000000ull && f == 0,
+          "ft2it -2^31 is exact, sign-extended to 64 bits (0x%" PRIx64 ")", r);
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x01, 0, r, f);  // 1.5 RNE
+    check(ok && r == 2 && f == kFlagNX, "ft2it 1.5 RNE = 2 + NX");
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x04, 0, r, f);  // RTZ
+    check(ok && r == 1 && f == kFlagNX, "ft2it 1.5 RTZ = 1 + NX");
+    // Static directions must win over rf0: rf0 says RTZ but code 0x01 is RNE.
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x01, 1, r, f);
+    check(ok && r == 2 && f == kFlagNX, "ft2it static RNE beats rf0 RTZ");
+    // 0x20 is dynamic: it reads rf0.
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x20, 1, r, f);
+    check(ok && r == 1 && f == kFlagNX, "ft2it dynamic 0x20 follows rf0 RTZ");
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x08, 0, r, f);  // RUP
+    check(ok && r == 2 && f == kFlagNX, "ft2it 1.5 RUP = 2 + NX");
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x10, 0, r, f);  // RDN
+    check(ok && r == 1 && f == kFlagNX, "ft2it 1.5 RDN = 1 + NX");
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x02, 0, r, f);  // RNA
+    check(ok && r == 2 && f == kFlagNX, "ft2it 1.5 RNA = 2 + NX");
+    // Negative direction: -1.5 with RUP goes toward +Inf (-1).
+    ok = runToInt("ft2it_orri_rf", 0xBFC00000ull, 0x08, 0, r, f);
+    check(ok && r == 0xFFFFFFFFFFFFFFFFull && f == kFlagNX,
+          "ft2it -1.5 RUP = -1 + NX");
+    ok = runToInt("ft2ut_orri_rf", 0xBF800000ull, 0x01, 0, r, f);  // -1.0
+    check(ok && r == 0 && f == kFlagNV, "ft2ut -1 saturates to 0 + NV");
+    ok = runToInt("ft2ut_orri_rf", 0x4F800000ull, 0x01, 0, r, f);  // 2^32
+    check(ok && r == 0xFFFFFFFFull && f == kFlagNV,
+          "ft2ut 2^32 saturates to UINT32_MAX + NV");
+    ok = runToInt("fo2uo_orri_rf", 0x43F0000000000000ull, 0x01, 0, r, f);
+    check(ok && r == 0xFFFFFFFFFFFFFFFFull && f == kFlagNV,
+          "fo2uo 2^64 saturates to UINT64_MAX + NV");
+    ok = runToInt("fo2io_orri_rf", kFoQNaN, 0x01, 0, r, f);
+    check(ok && r == 0x7FFFFFFFFFFFFFFFull && f == kFlagNV,
+          "fo2io NaN saturates to INT64_MAX + NV");
+    ok = runToInt("fo2io_orri_rf", kFoSign | kFoInf, 0x01, 0, r, f);
+    check(ok && r == 0x8000000000000000ull && f == kFlagNV,
+          "fo2io -Inf saturates to INT64_MIN + NV");
+    ok = runToInt("fo2io_orri_rf", kFoMinSub, 0x01, 0, r, f);
+    check(ok && r == 0 && f == kFlagNX, "fo2io minSub => 0 + NX");
+    ok = runToInt("fo2it_orri_rf", 0x41E0000000000000ull, 0x01, 0, r, f);
+    check(ok && r == 0x7FFFFFFFull && f == kFlagNV, "fo2it 2^31 saturates");
+    // encode_onehot: 0x00 and non-one-hot codes are ILLI (zero accesses).
+    ok = runToInt("ft2it_orri_rf", 0x3FC00000ull, 0x00, 0, r, f);
+    check(!ok, "ft2it mode 0x00 is ILLI");
+    ok = runToInt("fo2io_orri_rf", 0x3FF0000000000000ull, 0x03, 0, r, f);
+    check(!ok, "fo2io mode 0x03 is ILLI");
+}
+
+void
+checkI2F()
+{
+    auto runFromInt = [](const char *id, uint64_t value, uint8_t code,
+                         unsigned rfMode, uint64_t &out, uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        ctx.rf[0] = withMode(kFcsrReset, rfMode);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rdhc = 3;
+        w.immu6 = code;
+        ctx.rf[2] = 0;
+        ctx.rd[3] = value;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = runFromInt("it2ft_orri_rf", uint64_t(int64_t(-1)), 0x20, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == (kFtSign | kFtOne) && f == 0,
+          "it2ft -1 = -1.0");
+    ok = runFromInt("it2ft_orri_rf", 0x80000000ull, 0x20, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0xCF000000ull && f == 0,
+          "it2ft INT32_MIN = -2^31 exactly");
+    ok = runFromInt("ut2ft_orri_rf", 0xFFFFFFFFull, 0x20, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4F800000ull && f == (kFlagNX),
+          "ut2ft UINT32_MAX = 2^32 + NX (actual 0x%08" PRIx64 ")",
+          r & 0xFFFFFFFF);
+    // it2fo/ut2fo are exact: SBZ 0 and no flags.
+    ok = runFromInt("it2fo_orri_rf", uint64_t(int64_t(-7)), 0, 0, r, f);
+    check(ok && r == 0xC01C000000000000ull && f == 0,
+          "it2fo -7 is exact, no flags");
+    ok = runFromInt("ut2fo_orri_rf", 0xFFFFFFFFull, 0, 0, r, f);
+    check(ok && r == 0x41EFFFFFFFE00000ull && f == 0,
+          "ut2fo UINT32_MAX is exact, no flags");
+    ok = runFromInt("it2fo_orri_rf", 1, 0x01, 0, r, f);
+    check(!ok, "it2fo non-zero SBZ is ILLI");
+    ok = runFromInt("io2fo_orri_rf", 0x8000000000000000ull, 0x20, 0, r, f);
+    check(ok && r == 0xC3E0000000000000ull && f == 0,
+          "io2fo INT64_MIN = -2^63 exactly");
+    ok = runFromInt("uo2fo_orri_rf", 0xFFFFFFFFFFFFFFFFull, 0x20, 0, r, f);
+    check(ok && r == 0x43F0000000000000ull && f == kFlagNX,
+          "uo2fo UINT64_MAX = 2^64 + NX");
+    // Four directions on an inexact value: 2^24+1 in ft.
+    ok = runFromInt("io2ft_orri_rf", (uint64_t(1) << 24) + 1, 0x01, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4B800000ull && f == kFlagNX,
+          "io2ft 2^24+1 RNE => 2^24 + NX");
+    ok = runFromInt("io2ft_orri_rf", (uint64_t(1) << 24) + 1, 0x04, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4B800000ull && f == kFlagNX,
+          "io2ft 2^24+1 RTZ => 2^24 + NX");
+    ok = runFromInt("io2ft_orri_rf", (uint64_t(1) << 24) + 1, 0x02, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4B800001ull && f == kFlagNX,
+          "io2ft 2^24+1 RNA => 2^24+2 + NX");
+    ok = runFromInt("io2ft_orri_rf", (uint64_t(1) << 24) + 1, 0x08, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4B800001ull && f == kFlagNX,
+          "io2ft 2^24+1 RUP => 2^24+2 + NX");
+    ok = runFromInt("io2ft_orri_rf", -(uint64_t(1) << 24) - 1, 0x08, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0xCB800000ull && f == kFlagNX,
+          "io2ft -(2^24+1) RUP => -2^24 + NX");
+    ok = runFromInt("io2ft_orri_rf", -(uint64_t(1) << 24) - 1, 0x10, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0xCB800001ull && f == kFlagNX,
+          "io2ft -(2^24+1) RDN => -(2^24+2) + NX");
+    // 0x20 follows rf0: rf0 RTZ picks 2^24.
+    ok = runFromInt("io2ft_orri_rf", (uint64_t(1) << 24) + 1, 0x20, 1, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x4B800000ull && f == kFlagNX,
+          "io2ft dynamic 0x20 follows rf0 RTZ");
+}
