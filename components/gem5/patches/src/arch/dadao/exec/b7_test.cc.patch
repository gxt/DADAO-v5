+void
+checkRoundInt()
+{
+    auto runRnd = [](const char *id, uint64_t bits, uint64_t onehot,
+                     unsigned rfMode, uint64_t &out, uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        ctx.rf[0] = withMode(kFcsrReset, rfMode);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.immu6 = onehot;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = bits;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    const uint64_t oneHalf = 0x3FC00000ull;   // 1.5
+    const uint64_t twoHalf = 0x40200000ull;   // 2.5
+    const uint64_t half = kFtHalf;            // 0.5
+    ok = runRnd("ftrnd_orri_rf", twoHalf, 0x01, 0, r, f);  // ties-to-even
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo && f == 0,
+          "ftrnd 2.5 ties-to-even = 2 (no NX)");
+    ok = runRnd("ftrnd_orri_rf", oneHalf, 0x02, 0, r, f);  // ties-to-away
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo && f == 0,
+          "ftrnd 1.5 ties-to-away = 2");
+    ok = runRnd("ftrnd_orri_rf", kFtSign | oneHalf, 0x04, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == (kFtSign | kFtOne) && f == 0,
+          "ftrnd -1.5 toward zero = -1");
+    ok = runRnd("ftrnd_orri_rf", oneHalf, 0x08, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo, "ftrnd 1.5 toward +Inf = 2");
+    ok = runRnd("ftrnd_orri_rf", oneHalf, 0x10, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne, "ftrnd 1.5 toward -Inf = 1");
+    ok = runRnd("ftrnd_orri_rf", kFtSign | half, 0x04, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtSign,
+          "ftrnd -0.5 toward zero = -0 (sign kept, no NX)");
+    ok = runRnd("ftrnd_orri_rf", oneHalf, 0x20, 0, r, f);  // exact, RNE
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo && f == kFlagNX,
+          "ftrnd 1.5 exact RNE = 2 + NX");
+    ok = runRnd("ftrnd_orri_rf", oneHalf, 0x20, 0, r, f);
+    ok = runRnd("ftrnd_orri_rf", kFtOne, 0x01, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftrnd integral value is unchanged (no NX)");
+    ok = runRnd("ftrnd_orri_rf", 0x4B000000ull, 0x20, 3, r, f);  // 2^23
+    check(ok && (r & 0xFFFFFFFF) == 0x4B000000ull && f == 0,
+          "ftrnd |x| >= 2^24 is returned as-is");
+    ok = runRnd("ftrnd_orri_rf", kFtQNaN, 0x01, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == 0,
+          "ftrnd qNaN => canonical qNaN (no NV)");
+    ok = runRnd("ftrnd_orri_rf", 0x7FA00000ull, 0x01, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == kFlagNV,
+          "ftrnd sNaN => NV + qNaN");
+    // fornd: 2^52+0.5 tie -> even.
+    ok = runRnd("fornd_orri_rf", 0x4320000000000001ull, 0x01, 0, r, f);
+    check(ok && r == 0x4320000000000000ull, "fornd tie rounds to even");
+}
+
+void
+checkRem()
+{
+    auto runRem = [](const char *id, uint64_t a, uint64_t b, uint64_t &out,
+                     uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.rfhd = 4;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = a;
+        ctx.rf[4] = b;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    // 5.5 rem 2 = -0.5 (5.5/2 = 2.75 -> n = 3 -> 5.5 - 6 = -0.5).
+    ok = runRem("ftrem_orrr_rf", 0x40B00000ull, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0xBF000000ull && f == 0,
+          "ftrem 5.5 rem 2 = -0.5 (actual 0x%08" PRIx64 ")", r & 0xFFFFFFFF);
+    ok = runRem("ftrem_orrr_rf", 0xC0B00000ull, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x3F000000ull,
+          "ftrem -5.5 rem 2 = +0.5 (sign follows x's nearest result)");
+    // Tie: 3 rem 2 => 3/2 = 1.5 => n = 2 (even) => -1.
+    ok = runRem("ftrem_orrr_rf", 0x40400000ull, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == (kFtSign | kFtOne),
+          "ftrem 3 rem 2 = -1 (tie to even)");
+    // 5 rem 2 = 1.
+    ok = runRem("ftrem_orrr_rf", 0x40A00000ull, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne, "ftrem 5 rem 2 = 1");
+    ok = runRem("ftrem_orrr_rf", kFtOne, kFtInf, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftrem x rem Inf = x (no flags)");
+    ok = runRem("ftrem_orrr_rf", 0x40B00000ull, kFtInf, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x40B00000ull && f == 0,
+          "ftrem 5.5 rem Inf = 5.5");
+    ok = runRem("ftrem_orrr_rf", kFtInf, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == kFlagNV,
+          "ftrem Inf rem 2 = qNaN + NV");
+    ok = runRem("ftrem_orrr_rf", kFtOne, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == kFlagNV,
+          "ftrem 1 rem 0 = qNaN + NV");
+    ok = runRem("ftrem_orrr_rf", kFtOne, kFtSNaN, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == kFlagNV,
+          "ftrem sNaN => NV + qNaN");
+    ok = runRem("ftrem_orrr_rf", kFtOne, kFtQNaN, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == 0,
+          "ftrem qNaN => qNaN with no flags");
+    // Exact remainder never sets NX even when the result is subnormal.
+    ok = runRem("ftrem_orrr_rf", 0x33800000ull, 0x34000000ull, r, f);  // 2^-24, 2^-23
+    check(ok && (r & 0xFFFFFFFF) == 0x33800000ull && f == 0,
+          "ftrem tiny exact remainder sets no flags");
+    // 1e38-ish magnitude difference, exercises the long-division loop.
+    ok = runRem("ftrem_orrr_rf", 0x7F000000ull, 0x3F800001ull, r, f);
+    check(ok && f == 0, "ftrem huge/huge runs without flags");
+}
+
+void
+checkSclb()
+{
+    auto runSclb = [](const char *id, uint64_t x, uint64_t exponent,
+                      unsigned mode, uint64_t &out, uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        ctx.rf[0] = withMode(kFcsrReset, mode);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.rdhd = 6;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = x;
+        ctx.rd[6] = exponent;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, 0, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftsclb x*2^0 = x (rd0 exponent 0)");
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, 1, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo, "ftsclb 1*2^1 = 2");
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, uint64_t(-1), 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtHalf, "ftsclb 1*2^-1 = 0.5");
+    // rdHD is the rrHD field, NOT rfHD: the rf3 decoy must not be read.
+    MockContext ctx;
+    initContext(ctx);
+    WordSpec w;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.rdhd = 4;
+    ctx.rf[3] = kFtOne;
+    ctx.rf[4] = 0x41200000ull;  // 10.0 decoy
+    ctx.rd[4] = 10;
+    (void)runWord(ctx, "ftsclb_orrr_rf", w);
+    check(ft(ctx, 2) == 0x44800000ull,
+          "ftsclb uses rdHD = 10 => 1024 (actual 0x%08" PRIx64 ")",
+          ft(ctx, 2));
+    // Overflow / underflow / Inf / zero.
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, 200, 0, r, f);
+    check(ok && r == kFtInf && f == (kFlagOF | kFlagNX),
+          "ftsclb 1*2^200 overflows");
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, uint64_t(-200), 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0 && f == (kFlagUF | kFlagNX),
+          "ftsclb 1*2^-200 underflows to 0 + UF|NX");
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, uint64_t(-149), 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtMinSub && f == 0,
+          "ftsclb 1*2^-149 = minSub exactly (no flags)");
+    ok = runSclb("ftsclb_orrr_rf", kFtInf, 1000, 0, r, f);
+    check(ok && r == kFtInf && f == 0, "ftsclb Inf*2^n = Inf");
+    ok = runSclb("ftsclb_orrr_rf", kFtSign, 1000, 0, r, f);
+    check(ok && r == kFtSign && f == 0, "ftsclb -0*2^n = -0");
+    // A huge exponent must not iterate: INT64_MIN/MAX terminate immediately.
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, 0x7FFFFFFFFFFFFFFFull, 0, r, f);
+    check(ok && r == kFtInf && f == (kFlagOF | kFlagNX),
+          "ftsclb n = INT64_MAX overflows without iterating");
+    ok = runSclb("ftsclb_orrr_rf", kFtOne, 0x8000000000000000ull, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0 && f == (kFlagUF | kFlagNX),
+          "ftsclb n = INT64_MIN underflows without iterating");
+    ok = runSclb("fosclb_orrr_rf", kFoOne, 1024, 0, r, f);
+    check(ok && r == kFoInf && f == (kFlagOF | kFlagNX),
+          "fosclb 1*2^1024 overflows");
+}
