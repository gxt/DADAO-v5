+// ---------------------------------------------------------------------------
+// 5. FCSR / composition / ordering rules.
+// ---------------------------------------------------------------------------
+
+void
+checkFcsr()
+{
+    // Flags are sticky across instructions and only [4:0] changes.
+    MockContext ctx;
+    initContext(ctx);
+    ctx.rf[0] = withFlags(withMode(kFcsrReset, 0), 0);
+    WordSpec w;
+    w.rfhb = 2;
+    w.rfhc = 3;
+    w.rfhd = 4;
+    ctx.rf[3] = kFtOne;
+    ctx.rf[4] = 0;
+    (void)runWord(ctx, "ftdiv_orrr_rf", w);  // DZ
+    check(flagsOf(ctx) == kFlagDZ, "FCSR: div by zero sets DZ");
+    ctx.rf[3] = kFtQNaN;
+    ctx.rf[4] = kFtOne;
+    (void)runWord(ctx, "ftadd_orrr_rf", w);  // no flags
+    check(flagsOf(ctx) == kFlagDZ, "FCSR: a clean operation keeps old flags");
+    // A *different* new flag must be OR-ed in, never overwrite the old ones.
+    WordSpec toInt;
+    toInt.rdhb = 2;
+    toInt.rfhc = 4;
+    toInt.immu6 = 1;
+    ctx.rf[4] = 0x3FC00000ull;  // 1.5 -> NX
+    (void)runWord(ctx, "ft2it_orri_rf", toInt);
+    check(flagsOf(ctx) == (kFlagDZ | kFlagNX),
+          "FCSR: sticky OR keeps DZ and adds NX (flags 0x%" PRIx64 ")",
+          flagsOf(ctx));
+    ctx.rf[0] = withFlags(ctx.rf[0], 0);  // software clear
+    ctx.rf[3] = kFtOne;
+    ctx.rf[4] = kFtSign;
+    (void)runWord(ctx, "ftdiv_orrr_rf", w);  // -Inf => DZ again
+    check(flagsOf(ctx) == kFlagDZ, "FCSR: sticky OR keeps DZ");
+    check(modeOf(ctx) == 0, "FCSR: the rounding mode is preserved");
+    check(ctx.fcsrWrites >= 1, "FCSR: the flag write goes through writeFcsr");
+    // No-flag instructions must not write rf0 at all.
+    initContext(ctx);
+    const int before = ctx.fcsrWrites;
+    ctx.rf[3] = kFtOne;
+    ctx.rf[4] = kFtOne;
+    (void)runWord(ctx, "ftadd_orrr_rf", w);
+    check(ctx.fcsrWrites == before,
+          "FCSR: a flag-free operation does not write rf0");
+
+    // Four rounding modes drive the same operation differently: 1 + 2^-24.
+    const uint64_t kOnePlusTiny = 0x3F800001ull;  // 1 + 2^-23
+    (void)kOnePlusTiny;
+    for (unsigned mode = 0; mode < 4; ++mode) {
+        initContext(ctx);
+        ctx.rf[0] = withMode(kFcsrReset, mode);
+        ctx.rf[3] = kFtOne;
+        ctx.rf[4] = (mode == 0 || mode == 3) ? 0x3F800001ull : 0x3F800001ull;
+        (void)runWord(ctx, "ftmul_orrr_rf", w);  // 1 * (1+2^-23) = exact
+        check(ft(ctx, 2) == 0x3F800001ull, "mode %u: exact multiply", mode);
+    }
+    // 1 * 2^-149 / 2 => 2^-150: RTZ/RDN -> 0 (UF|NX), RUP -> minSub (UF|NX).
+    initContext(ctx);
+    ctx.rf[0] = withMode(kFcsrReset, 1);
+    ctx.rf[3] = kFtMinSub;
+    ctx.rf[4] = kFtTwo;
+    (void)runWord(ctx, "ftdiv_orrr_rf", w);
+    check(ft(ctx, 2) == 0 && flagsOf(ctx) == (kFlagUF | kFlagNX),
+          "RTZ: minSub/2 => +0 + UF|NX");
+    initContext(ctx);
+    ctx.rf[0] = withMode(kFcsrReset, 3);
+    ctx.rf[3] = kFtMinSub;
+    ctx.rf[4] = kFtTwo;
+    (void)runWord(ctx, "ftdiv_orrr_rf", w);
+    check(ft(ctx, 2) == kFtMinSub && flagsOf(ctx) == (kFlagUF | kFlagNX),
+          "RUP: minSub/2 => minSub + UF|NX");
+
+    // rf0 as a source is the whole FCSR word (its low half is a qNaN).
+    initContext(ctx);
+    ctx.rf[0] = kFcsrReset;
+    ctx.rf[2] = 0;
+    ctx.rf[3] = kFtOne;
+    ctx.rf[4] = kFtOne;
+    WordSpec rf0src;
+    rf0src.rfhb = 2;
+    rf0src.rfhc = 0;  // rf0 as a source
+    rf0src.rfhd = 3;
+    (void)runWord(ctx, "ftadd_orrr_rf", rf0src);
+    check(ft(ctx, 2) == kFtQNaN,
+          "rf0 as a source reads the FCSR qNaN (ft half)");
+
+    // Destination/source overlap is allowed for single-destination forms.
+    initContext(ctx);
+    ctx.rf[2] = kFtOne;
+    ctx.rf[3] = kFtTwo;
+    WordSpec ov;
+    ov.rfhb = 2;
+    ov.rfhc = 2;
+    ov.rfhd = 3;
+    (void)runWord(ctx, "ftadd_orrr_rf", ov);
+    check(ft(ctx, 2) == 0x40400000ull, "ftadd rf2 = rf2 + rf3 (read before write)");
+}
+
+void
+checkBlock()
+{
+    // classify block of 3 ascending, then a block writing at the range end.
+    MockContext ctx;
+    initContext(ctx);
+    ctx.rf[60] = kFtOne;
+    ctx.rf[61] = kFtSign;
+    ctx.rf[62] = kFtInf;
+    WordSpec w;
+    w.rdhb = 61;
+    w.rfhc = 60;
+    w.immu6 = 3;
+    const exec::Fault fault = runWord(ctx, "ftcls_orri_rf", w);
+    check(fault == exec::Fault::None && ctx.rd[61] == 0x100 &&
+              ctx.rd[62] == 0x20 && ctx.rd[63] == 0x200,
+          "ftcls block [61,64) writes the last three rd registers "
+          "(fault %s, 0x%" PRIx64 " 0x%" PRIx64 " 0x%" PRIx64 ")",
+          faultName(fault), ctx.rd[61], ctx.rd[62], ctx.rd[63]);
+    // 64-element block is legal (count 63 + start 1).
+    initContext(ctx);
+    w.rdhb = 1;
+    w.rfhc = 1;
+    w.immu6 = 63;
+    check(runWord(ctx, "ftcls_orri_rf", w) == exec::Fault::None &&
+              ctx.writes.size() == 63,
+          "ftcls count 63 from index 1 is legal");
+}
+
+void
+checkDispatchIds()
+{
+    // Ids that share a mnemonic family must dispatch differently.
+    const exec::B7Spec *ft2it = exec::b7SpecForId("ft2it_orri_rf");
+    const exec::B7Spec *ft2ut = exec::b7SpecForId("ft2ut_orri_rf");
+    check(ft2it != nullptr && ft2ut != nullptr && ft2it->intSigned &&
+              !ft2ut->intSigned,
+          "dispatch: ft2it is signed, ft2ut is unsigned");
+    const exec::B7Spec *it2ft = exec::b7SpecForId("it2ft_orri_rf");
+    const exec::B7Spec *io2ft = exec::b7SpecForId("io2ft_orri_rf");
+    check(it2ft != nullptr && io2ft != nullptr && it2ft->intWidth == 32 &&
+              io2ft->intWidth == 64,
+          "dispatch: it2ft is 32-bit, io2ft is 64-bit");
+    const exec::B7Spec *ftadd = exec::b7SpecForId("ftadd_orrr_rf");
+    const exec::B7Spec *ftsub = exec::b7SpecForId("ftsub_orrr_rf");
+    const exec::B7Spec *ftmul = exec::b7SpecForId("ftmul_orrr_rf");
+    const exec::B7Spec *ftdiv = exec::b7SpecForId("ftdiv_orrr_rf");
+    check(ftadd && ftsub && ftmul && ftdiv && ftadd->arith == 0 &&
+              ftsub->arith == 1 && ftmul->arith == 2 && ftdiv->arith == 3,
+          "dispatch: add/sub/mul/div come from the id");
+    const exec::B7Spec *qcmp = exec::b7SpecForId("ftqcmp_orrr_rf");
+    const exec::B7Spec *scmp = exec::b7SpecForId("ftscmp_orrr_rf");
+    check(qcmp && scmp && qcmp->quietCompare && !scmp->quietCompare,
+          "dispatch: qcmp is quiet, scmp is signaling");
+    const exec::B7Spec *sgnn = exec::b7SpecForId("ftsgnn_orrr_rf");
+    const exec::B7Spec *sgnj = exec::b7SpecForId("ftsgnj_orrr_rf");
+    check(sgnn && sgnj && sgnn->negate && !sgnj->negate,
+          "dispatch: sgnn negates the injected sign, sgnj copies it");
+    const exec::B7Spec *ftmin = exec::b7SpecForId("ftmin_orrr_rf");
+    const exec::B7Spec *ftmax = exec::b7SpecForId("ftmax_orrr_rf");
+    check(ftmin && ftmax && !ftmin->isMax && ftmax->isMax,
+          "dispatch: min/max come from the id");
+    const exec::B7Spec *sclb = exec::b7SpecForId("ftsclb_orrr_rf");
+    check(sclb != nullptr && strEq(sclb->thirdField, "rdhd"),
+          "dispatch: ftsclb third operand is rdhd (F5.2 C1)");
+    const exec::B7Spec *csn = exec::b7SpecForId("cs.n_rrrr_rf");
+    const exec::B7Spec *csz = exec::b7SpecForId("cs.z_rrrr_rf");
+    const exec::B7Spec *csp = exec::b7SpecForId("cs.p_rrrr_rf");
+    check(csn && csz && csp && csn->csCond == 0 && csz->csCond == 1 &&
+              csp->csCond == 2,
+          "dispatch: cs.n/z/p conditions come from the id");
+    check(exec::b7SpecForId("ftadd_orrr_rf")->op == exec::B7Op::Arith &&
+              exec::b7SpecForId("ftrem_orrr_rf")->op == exec::B7Op::Rem &&
+              exec::b7SpecForId("ftsclb_orrr_rf")->op == exec::B7Op::ScaleB,
+          "dispatch: add/rem/scaleB are distinct ops");
+}
