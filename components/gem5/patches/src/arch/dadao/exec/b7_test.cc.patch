+void
+checkSign()
+{
+    auto runSign = [](const char *id, uint64_t a, uint64_t b, uint64_t &out,
+                      uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.rfhd = 4;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = a;
+        ctx.rf[4] = b;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    ok = runSign("ftsgnj_orrr_rf", kFtSign | kFtOne, 0, r, f);  // abs
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftsgnj rfHD=+0 => abs (sign 0)");
+    ok = runSign("ftsgnj_orrr_rf", kFtOne, kFtSign, r, f);
+    check(ok && (r & 0xFFFFFFFF) == (kFtSign | kFtOne),
+          "ftsgnj copySign(1.0, -0) = -1.0");
+    ok = runSign("ftsgnn_orrr_rf", kFtOne, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == (kFtSign | kFtOne),
+          "ftsgnn rfHD=+0 => -abs");
+    ok = runSign("ftsgnn_orrr_rf", kFtSign | kFtOne, kFtSign, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne, "ftsgnn copy(same) => negate");
+    ok = runSign("ftsgnj_orrr_rf", 0x7FC12345ull, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0x7FC12345ull,
+          "ftsgnj keeps the NaN payload bits");
+    ok = runSign("fosgnj_orrr_rf", 0x7FF8000000000123ull, 0, r, f);
+    check(ok && r == 0x7FF8000000000123ull, "fosgnj keeps the fo payload");
+}
