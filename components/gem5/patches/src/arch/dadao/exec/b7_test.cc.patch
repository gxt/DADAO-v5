+// ---------------------------------------------------------------------------
+// Mock architectural state.
+// ---------------------------------------------------------------------------
+
+struct RegWrite
+{
+    enum class Bank
+    {
+        Rd,
+        Rb,
+        Ra,
+        Rf,
+    } bank;
+    unsigned idx;
+    uint64_t value;
+};
+
+struct MockContext : public exec::B7Context
+{
+    uint64_t rd[64] = {};
+    uint64_t rb[64] = {};
+    uint64_t ra[64] = {};
+    uint64_t rf[64] = {};
+    uint64_t ip = 0x1000;
+
+    int reads = 0;
+    int fcsrWrites = 0;
+    int badWrites = 0;
+    std::vector<RegWrite> writes;
+
+    uint64_t
+    readInt(exec::Bank bank, unsigned idx) override
+    {
+        ++reads;
+        switch (bank) {
+          case exec::Bank::Rd: return idx == 0 ? 0 : rd[idx];
+          case exec::Bank::Rb: return idx == 0 ? ip : rb[idx];
+          case exec::Bank::Ra: return ra[idx];
+        }
+        return 0;
+    }
+
+    void
+    writeInt(exec::Bank bank, unsigned idx, uint64_t val) override
+    {
+        if ((bank == exec::Bank::Rd || bank == exec::Bank::Rb) && idx == 0) {
+            ++badWrites;
+            return;
+        }
+        writes.push_back({bank == exec::Bank::Rd ? RegWrite::Bank::Rd
+                          : bank == exec::Bank::Rb ? RegWrite::Bank::Rb
+                                                   : RegWrite::Bank::Ra,
+                           idx, val});
+        switch (bank) {
+          case exec::Bank::Rd: rd[idx] = val; break;
+          case exec::Bank::Rb: rb[idx] = val; break;
+          case exec::Bank::Ra: ra[idx] = val; break;
+        }
+    }
+
+    uint64_t
+    readFloat(unsigned idx) override
+    {
+        ++reads;
+        return rf[idx];
+    }
+
+    // ft results keep [63:32] (model choice, same rule as B1 ld.t).
+    void
+    writeFloatLow32(unsigned idx, uint32_t val) override
+    {
+        rf[idx] = (rf[idx] & 0xFFFFFFFF00000000ull) | val;
+        writes.push_back({RegWrite::Bank::Rf, idx, rf[idx]});
+    }
+
+    void
+    writeFloat64(unsigned idx, uint64_t val) override
+    {
+        rf[idx] = val;
+        writes.push_back({RegWrite::Bank::Rf, idx, val});
+    }
+
+    // FCSR write mask: only [33:32] and [4:0] are writable.
+    void
+    writeFcsr(uint64_t raw) override
+    {
+        ++fcsrWrites;
+        rf[0] = (rf[0] & ~kFcsrMask) | (raw & kFcsrMask);
+    }
+
+    uint64_t pc() const override { return ip; }
+
+    void
+    branchTo(uint64_t target64) override
+    {
+        ip = target64;
+    }
+
+    // ---- memory (B1) ----------------------------------------------------
+    bool
+    readMem(uint64_t, unsigned, uint8_t *) override
+    {
+        return false;
+    }
+    bool
+    writeMem(uint64_t, const uint8_t *, unsigned) override
+    {
+        return false;
+    }
+
+    // ---- B6 hooks (never reached by B7) ---------------------------------
+    bool
+    readCfx(uint8_t, uint8_t, uint8_t, uint64_t &) override
+    {
+        return false;
+    }
+    bool
+    writeCfx(uint8_t, uint8_t, uint8_t, uint64_t) override
+    {
+        return false;
+    }
+    void trapTo(uint8_t, uint32_t) override {}
+    bool escapeFrom(uint8_t, uint32_t) override { return false; }
+    void setReservation(uint64_t, unsigned) override {}
+    bool hasReservation(uint64_t, unsigned) const override { return false; }
+    void clearReservations() override {}
+    void ordering(uint8_t, uint8_t, uint8_t) override {}
+};
+
+void
+initContext(MockContext &ctx)
+{
+    for (unsigned i = 0; i < 64; ++i) {
+        ctx.rd[i] = 0xDAD0000000000000ull + i;
+        ctx.rb[i] = 0xB0B0000000000000ull + i;
+        ctx.ra[i] = 0xCAFE000000000000ull + i;
+        ctx.rf[i] = 0xF00D000000000000ull + i;
+    }
+    ctx.rd[0] = 0;
+    ctx.rb[0] = 0;
+    ctx.ra[0] = 0;
+    ctx.rf[0] = kFcsrReset;
+    ctx.ip = 0x1000;
+    ctx.reads = 0;
+    ctx.fcsrWrites = 0;
+    ctx.badWrites = 0;
+    ctx.writes.clear();
+}
