+void
+checkMinMax()
+{
+    auto runMm = [](const char *id, uint64_t a, uint64_t b, uint64_t &out,
+                    uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rfhb = 2;
+        w.rfhc = 3;
+        w.rfhd = 4;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = a;
+        ctx.rf[4] = b;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rf[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    ok = runMm("ftmin_orrr_rf", 0, kFtSign, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtSign, "ftmin(+0, -0) = -0");
+    ok = runMm("ftmax_orrr_rf", 0, kFtSign, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0, "ftmax(+0, -0) = +0");
+    ok = runMm("ftmin_orrr_rf", kFtSign, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtSign, "ftmin(-0, +0) = -0");
+    ok = runMm("ftmax_orrr_rf", kFtSign, 0, r, f);
+    check(ok && (r & 0xFFFFFFFF) == 0, "ftmax(-0, +0) = +0");
+    ok = runMm("ftmin_orrr_rf", kFtOne, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne, "ftmin(1, 2) = 1");
+    ok = runMm("ftmax_orrr_rf", kFtOne, kFtTwo, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtTwo, "ftmax(1, 2) = 2");
+    ok = runMm("ftmin_orrr_rf", kFtOne, kFtQNaN, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftmin(number, qNaN) = number, no NV");
+    ok = runMm("ftmax_orrr_rf", kFtQNaN, kFtOne, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == 0,
+          "ftmax(qNaN, number) = number");
+    ok = runMm("ftmin_orrr_rf", kFtOne, kFtSNaN, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtOne && f == kFlagNV,
+          "ftmin(number, sNaN) = number + NV");
+    ok = runMm("ftmin_orrr_rf", kFtQNaN, kFtSNaN, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtQNaN && f == kFlagNV,
+          "ftmin(double NaN) = canonical qNaN + NV");
+    ok = runMm("ftmax_orrr_rf", kFtInf, kFtOne, r, f);
+    check(ok && (r & 0xFFFFFFFF) == kFtInf, "ftmax(+Inf, 1) = +Inf");
+    ok = runMm("fomin_orrr_rf", kFoSign | kFoInf, kFoOne, r, f);
+    check(ok && r == (kFoSign | kFoInf), "fomin(-Inf, 1) = -Inf");
+    ok = runMm("fomax_orrr_rf", kFoQNaN, kFoSNaN, r, f);
+    check(ok && r == kFoQNaN && f == kFlagNV,
+          "fomax(double NaN) = fo canonical qNaN + NV");
+}
