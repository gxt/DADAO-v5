+// ---------------------------------------------------------------------------
+// Probe mode: print raw results for tools/gem5/b7_ref.py.
+// ---------------------------------------------------------------------------
+
+namespace
+{
+
+bool
+parseHex(const std::string &text, uint64_t &out)
+{
+    try {
+        std::size_t used = 0;
+        out = std::stoull(text, &used, 0);
+        return used == text.size();
+    } catch (...) {
+        return false;
+    }
+}
+
+int
+probe(const char *path)
+{
+    std::ifstream in(path);
+    if (!in) {
+        std::fprintf(stderr, "b7_test: cannot open vector file %s\n", path);
+        return 1;
+    }
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.empty() || line[0] == '#')
+            continue;
+        std::istringstream stream(line);
+        std::string name, id;
+        if (!(stream >> name >> id)) {
+            std::fprintf(stderr, "b7_test: bad vector line: %s\n",
+                         line.c_str());
+            return 1;
+        }
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        std::string token;
+        bool ok = true;
+        while (stream >> token) {
+            const std::size_t eq = token.find('=');
+            if (eq == std::string::npos) {
+                std::fprintf(stderr, "b7_test: bad token %s\n", token.c_str());
+                return 1;
+            }
+            const std::string key = token.substr(0, eq);
+            uint64_t value = 0;
+            if (!parseHex(token.substr(eq + 1), value)) {
+                std::fprintf(stderr, "b7_test: bad value in %s\n",
+                             token.c_str());
+                return 1;
+            }
+            if (key.size() > 2 && key[0] == 'r' &&
+                (key[1] == 'f' || key[1] == 'd' || key[1] == 'b' ||
+                 key[1] == 'a') &&
+                key.find_first_not_of("0123456789", 2) == std::string::npos) {
+                const unsigned idx = unsigned(std::stoul(key.substr(2)));
+                if (idx >= 64) {
+                    std::fprintf(stderr, "b7_test: register index too big\n");
+                    return 1;
+                }
+                switch (key[1]) {
+                  case 'f': ctx.rf[idx] = value; break;
+                  case 'd': ctx.rd[idx] = value; break;
+                  case 'b': ctx.rb[idx] = value; break;
+                  default: ctx.ra[idx] = value; break;
+                }
+                continue;
+            }
+            if (key == "rfha")
+                w.rfha = value;
+            else if (key == "rfhb")
+                w.rfhb = value;
+            else if (key == "rfhc")
+                w.rfhc = value;
+            else if (key == "rfhd")
+                w.rfhd = value;
+            else if (key == "rdha")
+                w.rdha = value;
+            else if (key == "rdhb")
+                w.rdhb = value;
+            else if (key == "rdhc")
+                w.rdhc = value;
+            else if (key == "rdhd")
+                w.rdhd = value;
+            else if (key == "immu6")
+                w.immu6 = value;
+            else {
+                std::fprintf(stderr, "b7_test: unknown key %s\n", key.c_str());
+                return 1;
+            }
+        }
+        if (!ok)
+            return 1;
+
+        const exec::Fault fault = runWord(ctx, id.c_str(), w);
+        std::printf("VECTOR %s\n", name.c_str());
+        std::printf("FAULT %s\n", faultName(fault));
+        for (const RegWrite &wr : ctx.writes) {
+            const char *bank = wr.bank == RegWrite::Bank::Rd ? "rd"
+                               : wr.bank == RegWrite::Bank::Rb ? "rb"
+                               : wr.bank == RegWrite::Bank::Ra ? "ra"
+                                                               : "rf";
+            std::printf("W %s %u 0x%016" PRIx64 "\n", bank, wr.idx, wr.value);
+        }
+        std::printf("FCSR 0x%016" PRIx64 "\n", ctx.rf[0]);
+        std::printf("END %s\n", name.c_str());
+    }
+    return failures == 0 ? 0 : 1;
+}
+
+} // anonymous namespace
+
+int
+main(int argc, char **argv)
+{
+    for (int i = 1; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--vectors") == 0 && i + 1 < argc)
+            return probe(argv[++i]);
+    }
+
+    checkTableShape();
+    positiveAll();
+    nonB7();
+    staticIlli();
+    checkArith();
+    checkFma();
+    checkFmaOverflow();
+    checkCs();
+    checkClassify();
+    checkConvertFF();
+    checkRoot();
+    checkF2I();
+    checkI2F();
+    checkRoundInt();
+    checkRem();
+    checkSclb();
+    checkSign();
+    checkCompare();
+    checkMinMax();
+    checkFcsr();
+    checkBlock();
+    checkDispatchIds();
+
+    std::printf("\nsummary: B7 coverage 55/55, failures %d\n", failures);
+    return failures == 0 ? 0 : 1;
+}
