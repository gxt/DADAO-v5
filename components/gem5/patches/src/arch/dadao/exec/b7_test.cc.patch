+// ---------------------------------------------------------------------------
+// Format constants (raw bits only: the harness never uses a host float).
+// ---------------------------------------------------------------------------
+
+constexpr uint64_t kFtSign = 0x80000000ull;
+constexpr uint64_t kFoSign = 0x8000000000000000ull;
+constexpr uint64_t kFtOne = 0x3F800000ull;                  // 1.0
+constexpr uint64_t kFtTwo = 0x40000000ull;                  // 2.0
+constexpr uint64_t kFtHalf = 0x3F000000ull;                 // 0.5
+constexpr uint64_t kFtFifteen = 0x41700000ull;              // 15.0
+constexpr uint64_t kFtMax = 0x7F7FFFFFull;                  // FLT_MAX
+constexpr uint64_t kFtInf = 0x7F800000ull;
+constexpr uint64_t kFtQNaN = 0x7FC00000ull;
+constexpr uint64_t kFtSNaN = 0x7F800001ull;
+constexpr uint64_t kFtMinSub = 0x00000001ull;               // 2^-149
+constexpr uint64_t kFtMinNormal = 0x00800000ull;            // 2^-126
+constexpr uint64_t kFoOne = 0x3FF0000000000000ull;
+constexpr uint64_t kFoTwo = 0x4000000000000000ull;
+constexpr uint64_t kFoHalf = 0x3FE0000000000000ull;
+constexpr uint64_t kFoMax = 0x7FEFFFFFFFFFFFFFull;
+constexpr uint64_t kFoInf = 0x7FF0000000000000ull;
+constexpr uint64_t kFoQNaN = 0x7FF8000000000000ull;
+constexpr uint64_t kFoSNaN = 0x7FF0000000000001ull;
+constexpr uint64_t kFoMinSub = 0x0000000000000001ull;
+constexpr uint64_t kFoMinNormal = 0x0010000000000000ull;
+
+constexpr uint64_t kFlagNV = 0x01;
+constexpr uint64_t kFlagDZ = 0x02;
+constexpr uint64_t kFlagOF = 0x04;
+constexpr uint64_t kFlagUF = 0x08;
+constexpr uint64_t kFlagNX = 0x10;
+
+// rf0 (FCSR) layout (contract-fp §1): [63:51]/[31:22] read-only qNaN,
+// [33:32] rounding mode, [4:0] flags.
+constexpr uint64_t kFcsrReset = 0x7FF800007FC00000ull;
+constexpr uint64_t kFcsrMask = (uint64_t(3) << 32) | 0x1Full;
+
+uint64_t
+withMode(uint64_t fcsr, unsigned mode)
+{
+    return (fcsr & ~(uint64_t(3) << 32)) | (uint64_t(mode & 3) << 32);
+}
+
+uint64_t
+withFlags(uint64_t fcsr, uint64_t flags)
+{
+    return (fcsr & ~uint64_t(0x1F)) | (flags & 0x1F);
+}
