+int failures = 0;
+
+void
+fail(const char *fmt, ...)
+{
+    ++failures;
+    va_list args;
+    va_start(args, fmt);
+    std::printf("[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+}
+
+void
+check(bool condition, const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    std::printf(condition ? "[PASS] " : "[FAIL] ");
+    std::vprintf(fmt, args);
+    std::printf("\n");
+    va_end(args);
+    if (!condition)
+        ++failures;
+}
