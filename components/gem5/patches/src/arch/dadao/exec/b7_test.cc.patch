+/*
+ * DADAO gem5 B7 execution assertions (GEM5-012t).
+ *
+ * Standalone C++17 harness (no gem5 headers): compiled by
+ * `tools/gem5/check_b7.py` against
+ * src/arch/dadao/{exec/fp_soft.cc,exec/b7.cc,exec/b7_test.cc,decode/decode.cc}.
+ *
+ * Everything here is derived from spec/SimRISC-07 (all FP sections + appendix
+ * B), spec/SimRISC-00 §2.3/§2.3.1 (rf / FCSR), spec/SimRISC-02 §3 (cs.*-rf),
+ * contract-fp §1-§10/§15/§16/§18-§20 and IEEE 754-2019 -- never from another
+ * implementation:
+ *   * the 55 B7 ids are listed one by one and must equal the live decode-table
+ *     B7 set (batch membership is never guessed from a mnemonic);
+ *   * every row is cross-checked against the decode entry (field names, banks,
+ *     format, legality bits versus rule_refs);
+ *   * static ILLI is checked before any register read (zero reads and zero
+ *     writes on every ILLI path);
+ *   * the boundary expectations quoted by the task are hand written from the
+ *     spec text, not produced by an oracle.
+ *
+ * Two modes:
+ *   * default -- self assertions, one [PASS]/[FAIL] line per check;
+ *   * --vectors <file> -- probe mode: read register/field inputs, execute, and
+ *     print the raw result (writes + final FCSR) for tools/gem5/b7_ref.py.
+ */
