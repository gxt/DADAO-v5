+void
+checkCompare()
+{
+    auto runCmp = [](const char *id, uint64_t a, uint64_t b, uint64_t &out,
+                     uint64_t &flags) {
+        MockContext ctx;
+        initContext(ctx);
+        WordSpec w;
+        w.rdhb = 2;
+        w.rfhc = 3;
+        w.rfhd = 4;
+        ctx.rf[2] = 0;
+        ctx.rf[3] = a;
+        ctx.rf[4] = b;
+        const exec::Fault fault = runWord(ctx, id, w);
+        out = ctx.rd[2];
+        flags = flagsOf(ctx);
+        return fault == exec::Fault::None;
+    };
+    uint64_t r = 0, f = 0;
+    bool ok = false;
+    ok = runCmp("ftqcmp_orrr_rf", kFtTwo, kFtOne, r, f);
+    check(ok && r == 1 && f == 0, "ftqcmp 2 > 1 => 1");
+    ok = runCmp("ftqcmp_orrr_rf", kFtOne, kFtOne, r, f);
+    check(ok && r == 0, "ftqcmp 1 == 1 => 0");
+    ok = runCmp("ftqcmp_orrr_rf", kFtOne, kFtTwo, r, f);
+    check(ok && r == 0xFFFFFFFFFFFFFFFFull, "ftqcmp 1 < 2 => -1 (64-bit all ones)");
+    ok = runCmp("ftqcmp_orrr_rf", 0, kFtSign, r, f);
+    check(ok && r == 0, "ftqcmp +0 == -0");
+    ok = runCmp("ftqcmp_orrr_rf", kFtQNaN, kFtOne, r, f);
+    check(ok && r == kFtQNaN && f == 0, "ftqcmp unordered(quiet) => qNaN, no NV");
+    ok = runCmp("ftscmp_orrr_rf", kFtQNaN, kFtOne, r, f);
+    check(ok && r == kFtSNaN && f == kFlagNV,
+          "ftscmp unordered => sNaN + NV (user ruling 3)");
+    ok = runCmp("foqcmp_orrr_rf", kFoQNaN, kFoOne, r, f);
+    check(ok && r == kFoQNaN && f == 0, "foqcmp unordered => fo qNaN");
+    ok = runCmp("foscmp_orrr_rf", kFoInf, kFoOne, r, f);
+    check(ok && r == 1 && f == 0, "foscmp +Inf > 1 => 1");
+}
