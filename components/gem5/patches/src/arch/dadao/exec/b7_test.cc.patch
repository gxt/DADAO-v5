+unsigned
+countOfRule(const decode::DecodeEntry &entry, const char *rule)
+{
+    unsigned n = 0;
+    for (unsigned i = 0; i < entry.numRules; ++i) {
+        if (strEq(entry.rules[i], rule))
+            ++n;
+    }
+    return n;
+}
+
+uint16_t
+expectedLegal(const decode::DecodeEntry &entry)
+{
+    uint16_t legal = 0;
+    if (countOfRule(entry, "dst_rf0"))
+        legal |= exec::LegalDstRf0;
+    if (countOfRule(entry, "dst_rd0"))
+        legal |= exec::LegalDstRd0;
+    if (countOfRule(entry, "mreg_zero") ||
+        countOfRule(entry, "mreg_range_overflow"))
+        legal |= exec::LegalCount;
+    if (countOfRule(entry, "mreg_range_overlap"))
+        legal |= exec::LegalOverlap;
+    if (countOfRule(entry, "encode_onehot"))
+        legal |= exec::LegalOnehot;
+    if (countOfRule(entry, "encode_fp_root_n"))
+        legal |= exec::LegalRootN;
+    if (countOfRule(entry, "encode_sbz"))
+        legal |= exec::LegalSbz;
+    return legal;
+}
+
+bool
+hasField(const decode::DecodeEntry &entry, const char *name)
+{
+    for (unsigned i = 0; i < entry.numFields; ++i) {
+        if (strEq(decode::fieldDesc(entry, i).name, name))
+            return true;
+    }
+    return false;
+}
+
+const char *
+bankOf(const decode::DecodeEntry &entry, const char *name)
+{
+    for (unsigned i = 0; i < entry.numFields; ++i) {
+        if (strEq(decode::fieldDesc(entry, i).name, name))
+            return decode::fieldDesc(entry, i).bank;
+    }
+    return "";
+}
