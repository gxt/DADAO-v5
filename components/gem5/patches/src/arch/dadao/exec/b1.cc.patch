+    {"ld.o_rrii_rf", Access::Load, Target::Rf, Shape::Single, 8, false,
+        "rfha", "rbhb", nullptr, nullptr},
+    {"st.o_rrii_rf", Access::Store, Target::Rf, Shape::Single, 8, false,
+        "rfha", "rbhb", nullptr, nullptr},
+    // ---- multi RD loads (contract-isa §3.1.2) --------------------------
+    {"ldm.ub_rrri_rd", Access::Load, Target::Rd, Shape::Multi, 1, false,
+        "rdha", "rbhb", "rdhc", "immu6"},
+    {"ldm.uw_rrri_rd", Access::Load, Target::Rd, Shape::Multi, 2, false,
