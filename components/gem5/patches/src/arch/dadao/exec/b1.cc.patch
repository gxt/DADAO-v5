+// DADAO gem5 B1 execution core -- implementation.
+//
+// The 38 B1 ids are dispatched through the table below (no mnemonic guessing:
+// the id set must equal the batch_of() set of the GEM5-002t matrix).
+#include "arch/dadao/exec/b1.hh"
+
+#include <cstddef>
+
+namespace gem5
+{
+namespace DadaoISA
+{
+namespace exec
+{
+
+namespace
+{
+
+// Valid virtual addresses are 48-bit (contract-isa §1.5).
+constexpr uint64_t kVaMask = (uint64_t(1) << 48) - 1;
+
+// Format of the fields (decode/decode.hh): rrii = dst, rbhb, imms12;
+// rrri = dst, rbhb, rdhc, immu6.
+const B1Spec kSpecs[] = {
+    // ---- single RD loads (contract-isa §3.1.1) -------------------------
+    {"ld.ub_rrii_rd", Access::Load, Target::Rd, Shape::Single, 1, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.uw_rrii_rd", Access::Load, Target::Rd, Shape::Single, 2, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.ut_rrii_rd", Access::Load, Target::Rd, Shape::Single, 4, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.sb_rrii_rd", Access::Load, Target::Rd, Shape::Single, 1, true,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.sw_rrii_rd", Access::Load, Target::Rd, Shape::Single, 2, true,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.st_rrii_rd", Access::Load, Target::Rd, Shape::Single, 4, true,
+        "rdha", "rbhb", nullptr, nullptr},
+    // ---- single RD stores (contract-isa §3.1.1) ------------------------
+    {"st.b_rrii_rd", Access::Store, Target::Rd, Shape::Single, 1, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"st.w_rrii_rd", Access::Store, Target::Rd, Shape::Single, 2, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"st.t_rrii_rd", Access::Store, Target::Rd, Shape::Single, 4, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"ld.o_rrii_rd", Access::Load, Target::Rd, Shape::Single, 8, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    {"st.o_rrii_rd", Access::Store, Target::Rd, Shape::Single, 8, false,
+        "rdha", "rbhb", nullptr, nullptr},
+    // ---- single RB / RA (contract-isa §3.2 / §3.3.1) -------------------
+    {"ld.o_rrii_rb", Access::Load, Target::Rb, Shape::Single, 8, false,
+        "rbha", "rbhb", nullptr, nullptr},
+    {"st.o_rrii_rb", Access::Store, Target::Rb, Shape::Single, 8, false,
+        "rbha", "rbhb", nullptr, nullptr},
+    {"ld.o_rrii_ra", Access::Load, Target::Ra, Shape::Single, 8, false,
