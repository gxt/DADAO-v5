+    {"ldm.sb_rrri_rd", Access::Load, Target::Rd, Shape::Multi, 1, true,
+        "rdha", "rbhb", "rdhc", "immu6"},
+    {"ldm.sw_rrri_rd", Access::Load, Target::Rd, Shape::Multi, 2, true,
+        "rdha", "rbhb", "rdhc", "immu6"},
+    {"ldm.st_rrri_rd", Access::Load, Target::Rd, Shape::Multi, 4, true,
+        "rdha", "rbhb", "rdhc", "immu6"},
+    // ---- multi RD stores (contract-isa §3.1.2) -------------------------
+    {"stm.b_rrri_rd", Access::Store, Target::Rd, Shape::Multi, 1, false,
