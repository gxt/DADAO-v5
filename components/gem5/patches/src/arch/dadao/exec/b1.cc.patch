+    // ---- single RF (contract-fp §11) -----------------------------------
+    {"ld.t_rrii_rf", Access::Load, Target::Rf, Shape::Single, 4, false,
+        "rfha", "rbhb", nullptr, nullptr},
+    {"st.t_rrii_rf", Access::Store, Target::Rf, Shape::Single, 4, false,
