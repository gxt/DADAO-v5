+
+constexpr size_t kNumSpecs = sizeof(kSpecs) / sizeof(kSpecs[0]);
+
+/** Look up a named field; false when the id has no such field (or the name is
+ * absent from the spec row). */
+bool
+lookupField(const decode::DecodedInst &inst, const char *name, uint64_t &out)
+{
+    if (name == nullptr)
+        return false;
+    return fieldValue(inst, std::string_view(name), out);
+}
+
+/** Big-endian bytes -> value (DADAO is big-endian, contract-isa §1.6). */
+uint64_t
+beToHost(const uint8_t *buf, unsigned width)
+{
+    uint64_t value = 0;
+    for (unsigned i = 0; i < width; ++i)
+        value = (value << 8) | buf[i];
+    return value;
+}
+
+/** Value -> big-endian bytes, keeping the low `width` bytes. */
+void
+hostToBe(uint64_t value, unsigned width, uint8_t *buf)
+{
+    for (unsigned i = 0; i < width; ++i)
+        buf[i] = (value >> (8 * (width - 1 - i))) & 0xFF;
+}
+
+uint64_t
+readSource(B1Context &ctx, Target target, unsigned idx)
+{
+    switch (target) {
+      case Target::Rd: return ctx.readInt(Bank::Rd, idx);
+      case Target::Rb: return ctx.readInt(Bank::Rb, idx);
+      case Target::Ra: return ctx.readInt(Bank::Ra, idx);
+      case Target::Rf: return ctx.readFloat(idx);
+    }
+    return 0;
+}
+
+void
+writeDestination(B1Context &ctx, Target target, unsigned idx, uint64_t raw,
+           unsigned width)
+{
+    switch (target) {
+      case Target::Rd:
+        ctx.writeInt(Bank::Rd, idx, raw);
+        return;
+      case Target::Rb:
+        ctx.writeInt(Bank::Rb, idx, raw);
+        return;
+      case Target::Ra:
+        ctx.writeInt(Bank::Ra, idx, raw);
+        return;
+      case Target::Rf:
+        if (width == 4) {
+            // ld.t / ldm.t: [31:0] replaced, [63:32] preserved (contract-fp
+            // §11), which also covers rf0 (FCSR high half untouched).
+            ctx.writeFloatLow32(idx, static_cast<uint32_t>(raw));
+        } else if (idx == 0) {
+            ctx.writeFcsr(raw);
+        } else {
+            ctx.writeFloat64(idx, raw);
+        }
+        return;
+    }
+}
+
+} // anonymous namespace
+
+size_t
+specCount()
+{
+    return kNumSpecs;
+}
+
+const B1Spec *
+specs()
+{
+    return kSpecs;
+}
+
+const B1Spec *
+specForId(std::string_view id)
+{
+    for (size_t i = 0; i < kNumSpecs; ++i) {
+        if (id == kSpecs[i].id)
+            return &kSpecs[i];
+    }
+    return nullptr;
+}
+
+Fault
+executeB1(const decode::DecodedInst &inst, B1Context &ctx)
+{
+    if (!inst.ok() || inst.entry->batch != 1)
+        return Fault::NotB1;
+
+    // An uncovered B1 id is a contract/implementation mismatch: trap (ILLI)
+    // instead of silently succeeding.  b1_test asserts the covered set equals
+    // the live B1 set, so this branch is unreachable for a coherent table.
+    const B1Spec *spec = specForId(inst.entry->id);
+    if (spec == nullptr)
+        return Fault::Illegal;
+
+    uint64_t dstValue = 0;
+    uint64_t baseValue = 0;
+    uint64_t offValue = 0;
+    uint64_t countValue = 0;
+    if (!lookupField(inst, spec->dstField, dstValue) ||
+        !lookupField(inst, spec->baseField, baseValue)) {
+        return Fault::Illegal;
+    }
+
+    const bool multi = spec->shape == Shape::Multi;
+    if (multi) {
+        if (!lookupField(inst, spec->offsetField, offValue) ||
+            !lookupField(inst, spec->countField, countValue)) {
+            return Fault::Illegal;
+        }
+    } else if (lookupField(inst, spec->offsetField, offValue) ||
+               lookupField(inst, spec->countField, countValue)) {
+        return Fault::Illegal;
+    }
+
+    const unsigned dst = static_cast<unsigned>(dstValue);
+    const unsigned base = static_cast<unsigned>(baseValue);
+    const unsigned count = multi ? static_cast<unsigned>(countValue) : 1u;
+
+    // ---- static legality (ILLI): before any register or memory access ----
+    if (spec->access == Access::Load) {
+        // rd0 / rb0 are read-only: loading into them is illegal.  ra0 and rf0
+        // are legal destinations (contract-isa §3.3, contract-fp §11).
+        if (spec->target == Target::Rd && dst == 0)
+            return Fault::Illegal;
+        if (spec->target == Target::Rb && dst == 0)
+            return Fault::Illegal;
+    }
+    if (multi) {
+        if (count == 0)
+            return Fault::Illegal;
+        // No wrap and no truncation: the destination block must fit.
+        if (dst + count > 64)
+            return Fault::Illegal;
+    }
+
+    // ---- effective address (48-bit virtual, mod 2^48) --------------------
+    uint64_t ea;
+    if (multi) {
+        // The address offset register is read once, *before* the block write:
+        // "when the range includes rdHC the address still uses the original
+        // rdHC" (SimRISC-01 §1/§2).
+        const uint64_t offset =
+            ctx.readInt(Bank::Rd, static_cast<unsigned>(offValue));
+        ea = (ctx.readInt(Bank::Rb, base) + offset) & kVaMask;
+    } else {
+        uint64_t immValue = 0;
+        if (!lookupField(inst, "imms12", immValue))
+            return Fault::Illegal;
+        // imms12 is a *signed* 12-bit field and must be sign-extended to 64
+        // bits before the addition (not zero-extended).
+        const int64_t imm = decode::signExtend(immValue, 12);
+        ea = (ctx.readInt(Bank::Rb, base) + static_cast<uint64_t>(imm)) &
+            kVaMask;
+    }
+
+    // ---- dynamic legality (MALIGN): alignment before touching memory -----
+    const unsigned width = spec->width;
+    if (width > 1 && (ea & (uint64_t(width) - 1)) != 0) {
+        ctx.reportMalign(ea, width);
+        return Fault::Malign;
+    }
+
+    // ---- element loop: increasing i, each element read/write in order -----
+    for (unsigned i = 0; i < count; ++i) {
+        const unsigned idx = dst + i;
+        const uint64_t addr = (ea + uint64_t(i) * width) & kVaMask;
+
+        if (spec->access == Access::Load) {
+            uint8_t buf[8] = {};
+            if (!ctx.readMem(addr, width, buf))
+                return Fault::Memory;
+            const uint64_t raw = beToHost(buf, width);
+            const uint64_t value = spec->signExtend
+                ? static_cast<uint64_t>(decode::signExtend(raw, width * 8))
+                : raw;
+            writeDestination(ctx, spec->target, idx, value, width);
+        } else {
+            const uint64_t value = readSource(ctx, spec->target, idx);
+            uint8_t buf[8] = {};
+            hostToBe(value, width, buf);
+            if (!ctx.writeMem(addr, buf, width))
+                return Fault::Memory;
+        }
+    }
+
+    return Fault::None;
+}
