+
+int
+main()
+{
+    checkCoverage();
+    checkRrrr();
+    checkImmediate();
+    checkBitScan();
+    checkLogic();
+    checkShift();
+    checkExtend();
+    checkReverse();
+    checkRb();
+    checkDivRem();
+    checkLegality();
+    checkRules();
+
+    std::printf("\nsummary: B3 coverage 42/42, oracle rows %zu, failures %d\n",
+                kOracleCount, failures);
+    return failures == 0 ? 0 : 1;
+}
