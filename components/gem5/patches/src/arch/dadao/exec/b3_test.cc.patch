+// ---------------------------------------------------------------------------
+// Word construction helpers.
+// ---------------------------------------------------------------------------
+
+struct WordSpec
+{
+    unsigned rdha = 5;
+    unsigned rdhb = 5;
+    unsigned rbha = 5;
+    unsigned rbhb = 5;
+    unsigned rdhc = 6;
+    unsigned rdhd = 8;
+    unsigned rbhc = 6;
+    unsigned rbhd = 8;
+    unsigned imm = 8;
+};
+
+uint32_t
+makeWord(const char *id, const WordSpec &w)
+{
+    const decode::DecodeEntry *entry = decode::entryById(id);
+    if (entry == nullptr) {
+        fail("encode: unknown id %s", id);
+        return 0;
+    }
+    struct FieldVal
+    {
+        const char *name;
+        uint64_t value;
+    };
+    const FieldVal values[] = {
+        {"rdha", w.rdha}, {"rdhb", w.rdhb},
+        {"rbha", w.rbha}, {"rbhb", w.rbhb},
+        {"rdhc", w.rdhc}, {"rdhd", w.rdhd},
+        {"rbhc", w.rbhc}, {"rbhd", w.rbhd},
+        {"immu6", w.imm}, {"immu12", w.imm},
+        {"imms12", w.imm}, {"imms18", w.imm},
+    };
+    uint32_t raw = entry->value;
+    for (const FieldVal &fv : values) {
+        for (unsigned i = 0; i < entry->numFields; ++i) {
+            const decode::FieldDesc &field = decode::fieldDesc(*entry, i);
+            if (std::strcmp(field.name, fv.name) != 0)
+                continue;
+            const uint32_t mask =
+                ((uint32_t(1) << field.width()) - 1) << field.lo;
+            raw = (raw & ~mask) |
+                  ((static_cast<uint32_t>(fv.value) << field.lo) & mask);
+            break;
+        }
+    }
+    return raw;
+}
+
+exec::Fault
+runWord(MockRegAccess &ctx, const char *id, uint32_t raw)
+{
+    const decode::DecodedInst decoded = decode::decodeWord(raw);
+    if (!decoded.ok()) {
+        fail("%s: encoding 0x%08x does not decode", id, raw);
+        return exec::Fault::Illegal;
+    }
+    if (!strEq(decoded.entry->id, id)) {
+        fail("%s: encoding 0x%08x decoded as %s", id, raw, decoded.entry->id);
+        return exec::Fault::Illegal;
+    }
+    return exec::executeB3(decoded, ctx);
+}
