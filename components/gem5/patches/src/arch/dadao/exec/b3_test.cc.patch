+// ---------------------------------------------------------------------------
+// Independent value oracles.
+// ---------------------------------------------------------------------------
+
+struct U128
+{
+    uint64_t hi;
+    uint64_t lo;
+};
+
+uint64_t
+lowMask(unsigned bits)
+{
+    return bits >= 64 ? ~uint64_t(0) : ((uint64_t(1) << bits) - 1);
+}
+
+U128
+expectedRrrr(TestOp op, uint64_t a, uint64_t b)
+{
+    switch (op) {
+      case T_ADD_UO: {
+        const uint64_t lo = a + b;
+        return {lo < a ? uint64_t(1) : uint64_t(0), lo};
+      }
+      case T_SUB_UO: {
+        const uint64_t lo = a - b;
+        return {a < b ? uint64_t(1) : uint64_t(0), lo};
+      }
+      case T_ADD_SO: {
+        const __int128 sum = static_cast<__int128>(static_cast<int64_t>(a)) +
+                             static_cast<__int128>(static_cast<int64_t>(b));
+        const unsigned __int128 bits = static_cast<unsigned __int128>(sum);
+        return {static_cast<uint64_t>(bits >> 64),
+                static_cast<uint64_t>(bits)};
+      }
+      case T_SUB_SO: {
+        const __int128 diff = static_cast<__int128>(static_cast<int64_t>(a)) -
+                              static_cast<__int128>(static_cast<int64_t>(b));
+        const unsigned __int128 bits = static_cast<unsigned __int128>(diff);
+        return {static_cast<uint64_t>(bits >> 64),
+                static_cast<uint64_t>(bits)};
+      }
+      case T_MUL_UO: {
+        const unsigned __int128 product =
+            static_cast<unsigned __int128>(a) * b;
+        return {static_cast<uint64_t>(product >> 64),
+                static_cast<uint64_t>(product)};
+      }
+      case T_MUL_SO: {
+        const __int128 product =
+            static_cast<__int128>(static_cast<int64_t>(a)) *
+            static_cast<__int128>(static_cast<int64_t>(b));
+        const unsigned __int128 bits = static_cast<unsigned __int128>(product);
+        return {static_cast<uint64_t>(bits >> 64),
+                static_cast<uint64_t>(bits)};
+      }
+      case T_CLMUL: {
+        uint64_t hi = 0;
+        uint64_t lo = 0;
+        for (unsigned i = 0; i < 64; ++i) {
+            if (((a >> i) & 1) == 0)
+                continue;
+            for (unsigned j = 0; j < 64; ++j) {
+                if (((b >> j) & 1) == 0)
+                    continue;
+                const unsigned bit = i + j;
+                if (bit < 64)
+                    lo ^= uint64_t(1) << bit;
+                else
+                    hi ^= uint64_t(1) << (bit - 64);
+            }
+        }
+        return {hi, lo};
+    }
+    default:
+        break;
+    }
+    return {0, 0};
+}
+
+uint64_t
+cmpUnsigned(uint64_t a, uint64_t b)
+{
+    if (a < b)
+        return ~uint64_t(0);
+    return a == b ? 0 : 1;
+}
+
+uint64_t
+cmpSigned(uint64_t a, uint64_t b)
+{
+    const int64_t sa = static_cast<int64_t>(a);
+    const int64_t sb = static_cast<int64_t>(b);
+    if (sa < sb)
+        return ~uint64_t(0);
+    return sa == sb ? 0 : 1;
+}
+
+uint64_t
+rol64(uint64_t value, unsigned amount)
+{
+    const unsigned n = amount & 63;
+    if (n == 0)
+        return value;
+    return (value << n) | (value >> (64 - n));
+}
+
+uint64_t
+bitReverse64(uint64_t value)
+{
+    uint64_t result = 0;
+    for (unsigned i = 0; i < 64; ++i)
+        result |= ((value >> i) & 1) << (63 - i);
+    return result;
+}
+
+/** Independent block reverse: split into 64/k k-bit units and reverse the
+ * unit order (unit bit order unchanged). */
+uint64_t
+expectedRev(uint64_t value, unsigned k)
+{
+    const unsigned units = 64 / k;
+    const uint64_t mask = lowMask(k);
+    uint64_t result = 0;
+    for (unsigned i = 0; i < units; ++i) {
+        const uint64_t unit = (value >> (i * k)) & mask;
+        result |= unit << ((units - 1 - i) * k);
+    }
+    return result;
+}
+
+uint64_t
+expectedDivRem(TestOp op, uint64_t a, uint64_t b)
+{
+    const bool isDiv = op == T_DIV_UO || op == T_DIV_SO;
+    const bool isSigned = op == T_DIV_SO || op == T_REM_SO;
+    if (!isSigned) {
+        if (b == 0)
+            return isDiv ? ~uint64_t(0) : a;
+        return isDiv ? a / b : a % b;
+    }
+    const int64_t sa = static_cast<int64_t>(a);
+    const int64_t sb = static_cast<int64_t>(b);
+    if (sb == 0)
+        return isDiv ? ~uint64_t(0) : a;
+    if (sa == INT64_MIN && sb == -1)
+        return isDiv ? (uint64_t(1) << 63) : 0;
+    return static_cast<uint64_t>(isDiv ? sa / sb : sa % sb);
+}
+
+// ---------------------------------------------------------------------------
+// 1. Coverage: 42/42 ids, live B3 set == explicit list, non-B3 -> NotB3.
+// ---------------------------------------------------------------------------
+
+void
+checkCoverage()
+{
+    size_t live = 0;
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        const decode::DecodeEntry *entry = decode::entryById(o.id);
+        check(entry != nullptr, "b3 list id %s exists in the decode table",
+              o.id);
+        if (entry == nullptr)
+            continue;
+        check(entry->batch == 3, "b3 list id %s is in batch 3 (actual %u)",
+              o.id, entry->batch);
+        check(strEq(entry->format, o.format),
+              "b3 list id %s is %s (actual %s)", o.id, o.format,
+              entry->format);
+        const exec::B3Spec *spec = exec::b3SpecForId(o.id);
+        check(spec != nullptr, "executeB3 covers b3 id %s", o.id);
+        if (spec != nullptr)
+            check(spec->op == execOpOf(o.op),
+                  "%s spec op matches the independent oracle", o.id);
+        ++live;
+        std::printf("[PASS] b3-id %s\n", o.id);
+    }
+    check(live == 42, "B3 coverage %zu/42", live);
+    std::printf("B3 coverage %zu/42\n", live);
+
+    // Every live batch-3 entry has exactly one oracle row and one spec row.
+    size_t batch3 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch != 3)
+            continue;
+        ++batch3;
+        check(oracleOf(entry.id) != nullptr, "oracle row for batch-3 id %s",
+              entry.id);
+        check(exec::b3SpecForId(entry.id) != nullptr,
+              "executeB3 covers batch-3 id %s", entry.id);
+    }
+    check(batch3 == 42, "live batch-3 entry count == 42 (actual %zu)",
+          batch3);
+    check(exec::b3SpecCount() == 42,
+          "executeB3 spec count == 42 (actual %zu)", exec::b3SpecCount());
+
+    // Spec rows are unique and all map back to a batch-3 decode entry.
+    for (size_t i = 0; i < exec::b3SpecCount(); ++i) {
+        const exec::B3Spec &spec = exec::b3Specs()[i];
+        for (size_t j = i + 1; j < exec::b3SpecCount(); ++j) {
+            check(!strEq(spec.id, exec::b3Specs()[j].id),
+                  "spec ids unique: %s vs %s", spec.id,
+                  exec::b3Specs()[j].id);
+        }
+        const decode::DecodeEntry *entry = decode::entryById(spec.id);
+        check(entry != nullptr && entry->batch == 3,
+              "spec id %s is a batch-3 decode entry", spec.id);
+    }
+
+    // The 222 non-B3 entries must stay NotB3 and must not touch any register.
+    size_t notB3 = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        const decode::DecodedInst decoded = decode::decodeWord(entry.value);
+        if (!decoded.ok() || !strEq(decoded.entry->id, entry.id)) {
+            fail("entry %s: value 0x%08x does not decode back", entry.id,
+                 entry.value);
+            continue;
+        }
+        MockRegAccess ctx;
+        initContext(ctx);
+        const exec::Fault fault = exec::executeB3(decoded, ctx);
+        if (entry.batch == 3) {
+            check(fault != exec::Fault::NotB3, "%s is handled by executeB3",
+                  entry.id);
+        } else {
+            ++notB3;
+            if (fault != exec::Fault::NotB3)
+                fail("%s (batch %u) returned %s, expected NotB3", entry.id,
+                     entry.batch, faultName(fault));
+            if (!ctx.writes.empty() || ctx.badWrites != 0 ||
+                    ctx.badFloats != 0)
+                fail("%s (batch %u) touched a register on NotB3", entry.id,
+                     entry.batch);
+        }
+    }
+    check(notB3 == 264 - 42, "non-B3 ids return NotB3 (%zu/222)", notB3);
+    std::printf("non-B3 ids return NotB3 (%zu/222)\n", notB3);
+
+    // Rule references must match contracts/opcodes.yaml: dst_dual_same (7),
+    // dst_rd0 (31), dst_rb0 (4) and rev.o's encode_onehot (1).
+    size_t dual = 0;
+    size_t rd0 = 0;
+    size_t rb0 = 0;
+    size_t onehot = 0;
+    for (size_t i = 0; i < decode::entryCount(); ++i) {
+        const decode::DecodeEntry &entry = decode::entries()[i];
+        if (entry.batch != 3)
+            continue;
+        for (unsigned r = 0; r < entry.numRules; ++r) {
+            const char *rule = entry.rules[r];
+            if (strEq(rule, "dst_dual_same"))
+                ++dual;
+            else if (strEq(rule, "dst_rd0"))
+                ++rd0;
+            else if (strEq(rule, "dst_rb0"))
+                ++rb0;
+            else if (strEq(rule, "encode_onehot"))
+                ++onehot;
+            else
+                fail("%s: unknown rule_ref %s", entry.id, rule);
+        }
+    }
+    check(dual == 7, "rule dst_dual_same count == 7 (actual %zu)", dual);
+    check(rd0 == 31, "rule dst_rd0 count == 31 (actual %zu)", rd0);
+    check(rb0 == 4, "rule dst_rb0 count == 4 (actual %zu)", rb0);
+    check(onehot == 1, "rule encode_onehot count == 1 (actual %zu)", onehot);
+}
+
+// ---------------------------------------------------------------------------
+// 2. 128-bit rrrr arithmetic.
+// ---------------------------------------------------------------------------
+
+void
+expectRrrr(const char *id, TestOp op, unsigned ha, unsigned hb, uint64_t a,
+           uint64_t b, const char *label)
+{
+    MockRegAccess ctx;
+    initContext(ctx);
+    ctx.rd[6] = a;
+    ctx.rd[8] = b;
+
+    WordSpec w;
+    w.rdha = ha;
+    w.rdhb = hb;
+    w.rdhc = 6;
+    w.rdhd = 8;
+    const exec::Fault fault = runWord(ctx, id, makeWord(id, w));
+    check(fault == exec::Fault::None, "%s %s: fault %s", id, label,
+          faultName(fault));
+    if (fault != exec::Fault::None)
+        return;
+
+    const U128 expected = expectedRrrr(op, a, b);
+    if (ha != 0) {
+        check(ctx.rd[ha] == expected.hi,
+              "%s %s: hi 0x%016" PRIx64 " (expected 0x%016" PRIx64 ")",
+              id, label, ctx.rd[ha], expected.hi);
+    } else {
+        check(ctx.rd[0] == 0, "%s %s: rd0 stays zero", id, label);
+    }
+    if (hb != 0) {
+        check(ctx.rd[hb] == expected.lo,
+              "%s %s: lo 0x%016" PRIx64 " (expected 0x%016" PRIx64 ")",
+              id, label, ctx.rd[hb], expected.lo);
+    } else {
+        check(ctx.rd[0] == 0, "%s %s: rd0 stays zero", id, label);
+    }
+    const size_t expectedWrites = (ha != 0 ? 1u : 0u) + (hb != 0 ? 1u : 0u);
+    check(ctx.writes.size() == expectedWrites,
+          "%s %s: %zu register write(s)", id, label, ctx.writes.size());
+    check(ctx.badWrites == 0, "%s %s: no rd0 write path", id, label);
+}
+
+void
+checkRrrr()
+{
+    struct Pair
+    {
+        uint64_t a;
+        uint64_t b;
+        const char *label;
+    };
+    const Pair pairs[] = {
+        {0, 0, "0+0"},
+        {1, 2, "1,2"},
+        {5, 3, "5,3"},
+        {3, 5, "3,5"},
+        {0, 1, "0,1"},
+        {1, 0, "1,0"},
+        {~uint64_t(0), 1, "max,1"},
+        {~uint64_t(0), ~uint64_t(0), "max,max"},
+        {uint64_t(1) << 63, 2, "2^63,2"},
+        {2, uint64_t(1) << 63, "2,2^63"},
+        {0x0123456789ABCDEFULL, 0xFEDCBA9876543210ULL, "pattern"},
+        {uint64_t(1) << 63, ~uint64_t(0), "min,-1"},
+    };
+
+    for (size_t i = 0; i < kOracleCount; ++i) {
+        const Oracle &o = kOracle[i];
+        if (o.rule != RULE_DUAL_SAME)
+            continue;
+
+        for (const Pair &p : pairs) {
+            expectRrrr(o.id, o.op, 5, 0, p.a, p.b, p.label);
+            expectRrrr(o.id, o.op, 0, 5, p.a, p.b, p.label);
+        }
+
+        // Both destinations: low half to rdhb, high half to rdha.
+        {
+            const U128 expected = expectedRrrr(o.op, uint64_t(2) << 62, 3);
+            MockRegAccess ctx;
+            initContext(ctx);
+            ctx.rd[6] = uint64_t(2) << 62;
+            ctx.rd[8] = 3;
+            WordSpec w;
+            w.rdha = 4;
+            w.rdhb = 5;
+            w.rdhc = 6;
+            w.rdhd = 8;
+            const exec::Fault fault =
+                runWord(ctx, o.id, makeWord(o.id, w));
+            check(fault == exec::Fault::None,
+                  "%s dual destination: fault %s", o.id, faultName(fault));
+            check(ctx.rd[4] == expected.hi, "%s dual destination: hi",
+                  o.id);
+            check(ctx.rd[5] == expected.lo, "%s dual destination: lo",
+                  o.id);
+            check(ctx.writes.size() == 2,
+                  "%s dual destination: two writes", o.id);
+        }
+
+        // Alias/snapshot: rdha=rdhc and rdhb=rdhd, so an implementation that
+        // writes the high half before reading the sources is caught.
+        {
+            const uint64_t a = 0x0F0F0F0F0F0F0F0FULL;
+            const uint64_t b = 0x00FF00FF00FF00FFULL;
+            const U128 expected = expectedRrrr(o.op, a, b);
+            MockRegAccess ctx;
+            initContext(ctx);
+            ctx.rd[5] = a;
+            ctx.rd[6] = b;
+            WordSpec w;
+            w.rdha = 5;
+            w.rdhb = 6;
+            w.rdhc = 5;
+            w.rdhd = 6;
+            const exec::Fault fault =
+                runWord(ctx, o.id, makeWord(o.id, w));
+            check(fault == exec::Fault::None, "%s alias snapshot: fault %s",
+                  o.id, faultName(fault));
+            check(ctx.rd[5] == expected.hi && ctx.rd[6] == expected.lo,
+                  "%s alias snapshot: hi/lo from the source snapshot", o.id);
+        }
+
+        // Dual-destination legality: both rd0, or the same non-rd0 register.
+        {
+            MockRegAccess ctx;
+            initContext(ctx);
+            WordSpec w;
+            w.rdha = 0;
+            w.rdhb = 0;
+            const exec::Fault both = runWord(ctx, o.id, makeWord(o.id, w));
+            check(both == exec::Fault::Illegal,
+                  "%s both rd0 -> Illegal (got %s)", o.id,
+                  faultName(both));
+            check(ctx.writes.empty(), "%s both rd0: no register write",
+                  o.id);
+
+            w.rdha = 5;
+            w.rdhb = 5;
+            const exec::Fault same = runWord(ctx, o.id, makeWord(o.id, w));
+            check(same == exec::Fault::Illegal,
+                  "%s rdha == rdhb != rd0 -> Illegal (got %s)", o.id,
+                  faultName(same));
+            check(ctx.writes.empty(), "%s same destination: no register write",
+                  o.id);
+        }
+    }
+}
