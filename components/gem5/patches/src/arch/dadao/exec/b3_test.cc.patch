+void
+initContext(MockRegAccess &ctx)
+{
+    for (unsigned i = 0; i < 64; ++i) {
+        ctx.rd[i] = 0xDEAD000000000000ULL + i;
+        ctx.rb[i] = 0xBEEF000000000000ULL + i;
+        ctx.ra[i] = 0xCAFE000000000000ULL + i;
+        ctx.rf[i] = 0xF00D000000000000ULL + i;
+    }
+    ctx.rd[0] = 0;
+    ctx.rb[0] = 0;
+    ctx.rf[0] = 0;
+    ctx.ip = 0x1000;
+}
