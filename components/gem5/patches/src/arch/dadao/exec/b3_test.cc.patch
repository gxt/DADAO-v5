+/*
+ * DADAO gem5 B3 execution assertions (GEM5-008t).
+ *
+ * Standalone C++17 harness (no gem5 headers): compiled by
+ * `tools/gem5/check_b3.py` against
+ * src/arch/dadao/{exec/b3.cc,exec/b3_test.cc,decode/decode.cc}.
+ *
+ * Everything here is derived from spec/SimRISC-04, spec/SimRISC-05,
+ * spec/SimRISC-12, contract-isa §6/§7 and contracts/opcodes.yaml -- never from
+ * another implementation:
+ *   * the 42 B3 ids are listed one by one (batch membership is never guessed
+ *     from mnemonics; sub.o has three ids, cmp.uo two, shl/rol/shr/ext each
+ *     have orrr and orri ids) and must equal the live decode-table B3 set;
+ *   * expected values are computed by an independent oracle table, including
+ *     the 128-bit high/low split, carry/borrow, sign extension, rotation,
+ *     bit scan with an effective upper bit, block reverse and the constant
+ *     divide/remainder results;
+ *   * every case checks the destination register value, the write count and
+ *     that no illegal path writes a register;
+ *   * statically illegal instructions (rd0/rb0 destinations, dual-destination
+ *     aliasing, non-one-hot rev.o, ext hd > 63) raise ILLI before any write.
+ */
+#include <cinttypes>
+#include <climits>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "arch/dadao/decode/decode.hh"
+#include "arch/dadao/exec/b3.hh"
+#include "arch/dadao/exec/common.hh"
