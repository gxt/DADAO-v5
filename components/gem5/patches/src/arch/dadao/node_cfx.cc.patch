+int
+nodeCfxIndex(int cfxha)
+{
+    for (int i = 0; i < NodeNumCfx; ++i)
+        if (kCfxhaMap[i] == cfxha)
+            return i;
+    return -1;
+}
+
+bool
+nodeCfxReserved(uint64_t cfxha)
+{
+    return (cfxha >= 6 && cfxha <= 14) || (cfxha >= 16 && cfxha <= 31) ||
+           (cfxha >= 35 && cfxha <= 61);
+}
+
+void
+nodeFreeEvents(NodeState &s)
+{
+    delete s.dmaEvent;
+    delete s.timerEvent;
+    s.dmaEvent = nullptr;
+    s.timerEvent = nullptr;
+}
+
+uint64_t
+nodeTimeValue(const NodeState &s)
+{
+    const Tick now = curTick();
+    // cfx_time counts nanoseconds: gem5's global tick is 1 ps.
+    return now >= s.timeBaseTick ? (now - s.timeBaseTick) / kPsPerNs : 0;
+}
+
+void
+nodeResetState(NodeState &s, ThreadContext *tc, Addr romBase, Addr romSize,
+               Addr ramBase, Addr ramSize, Addr pmemBase, uint8_t cacheExist)
+{
+    s.active = true;
+    s.tc = tc;
+    s.romBase = romBase;
+    s.romSize = romSize;
+    s.ramBase = ramBase;
+    s.ramSize = ramSize;
+    s.pmemBase = pmemBase;
+
+    s.runMode = NodeHypv;
+    s.cfxCode = CfxhaPower;
+
+    // cfx_cache: reset enable = exist (CACHE-07); the address registers reset
+    // to 0.  With no L1 wired (cache-model=off) exist is 0 and cfx5 does not
+    // exist at all (register access => CFXREG).
+    s.cache = NodeCacheState();
+    s.cache.exist = cacheExist & 0x3;
+    s.cache.enable = s.cache.exist;
+
+    s.ptbr = 0;
+    s.ptwEnable = 0;
+    s.tlbAsid = 0;
+    s.tlbStart = 0;
+    s.tlbSize = 0;
+    s.tlbControl = 0;
+    for (unsigned set = 0; set < NodeTlbSets; ++set) {
+        for (unsigned way = 0; way < NodeTlbWays; ++way) {
+            s.itlb[set][way] = NodeTlbEntry();
+            s.dtlb[set][way] = NodeTlbDataEntry();
+            s.itlbLru[set][way] = way;
+            s.dtlbLru[set][way] = way;
+        }
+    }
+    for (unsigned way = 0; way < NodeTlbSuperEntries; ++way) {
+        s.itlbSp[way] = NodeTlbEntry();
+        s.dtlbSp[way] = NodeTlbDataEntry();
+        s.itlbSpLru[way] = way;
+        s.dtlbSpLru[way] = way;
+    }
+
+    s.dma = NodeDmaState();
+
+    s.timeBaseTick = curTick();
+    s.insnCount = 0;
+    s.timerCmp = 0;
+    s.timerCtrl = 0;
+
+    if (s.dmaEvent == nullptr) {
+        auto *event = new NodeDmaEvent;
+        event->tc = tc;
+        event->state = &s;
+        s.dmaEvent = event;
+    } else {
+        deschedule(s.dmaEvent);
+    }
+    if (s.timerEvent == nullptr) {
+        auto *event = new NodeTimerEvent;
+        event->tc = tc;
+        event->state = &s;
+        s.timerEvent = event;
+    } else {
+        deschedule(s.timerEvent);
+    }
+
+    constexpr uint64_t kMaskDefault = 0xFFFFFFFFFFFFFFF7ULL;
+    constexpr uint64_t kMaskHmon = 0x7FFFFFFFFFFFFFF7ULL;
+
+    for (int i = 0; i < NodeNumCfx; ++i) {
+        NodeCfxRegs &r = s.cfx[i];
+        const uint64_t cfxha = kCfxhaMap[i];
+        const uint64_t maskInit = (cfxha == 3) ? kMaskHmon : kMaskDefault;
+
+        r = NodeCfxRegs();
+        for (int m = 0; m < 4; ++m) {
+            NodeCfxMode &mr = r.mode[m];
+            mr.cfxtrap = maskInit;
+            mr.cfxmem = maskInit;
+            mr.cfxreg = maskInit;
+            mr.cfxexe = maskInit;
+            mr.cfxIntrMask = ~0ULL;
+            if (m == NodeHypv) {
+                // DADAO-13 §1 (cg3/hypv rows): H-mode switch values and the
+                // per-cfx vector base (cfxha << 42 | 0x3ff_ffff_0000).
+                mr.switchRunMode = NodeHypv;
+                mr.excpVector = (cfxha << 42) + 0x3FFFFFF0000ULL;
+                mr.cgRegDeleg = ~0ULL;
+            } else {
+                mr.switchRunMode = NodeSupv;
+                mr.excpVector = 0;
+                mr.cgRegDeleg = 0;
+            }
+        }
+        r.globalCfxIntrMask = (cfxha < 4) ? ~0ULL : 0;
+        r.cfxId = cfxha;
+        r.version = 0x00010000ULL;
+        r.scratchRegsNum = 4;
+    }
+}
+
+bool
+nodePermDenied(const NodeState &s, int target, int kind)
+{
+    const int ci = nodeCfxIndex(target);
+    if (ci < 0)
+        return false;
+    if (target == s.cfxCode)
+        return false; // self: the cfx axis is bypassed
+    const NodeCfxMode &m = s.cfx[ci].mode[s.runMode & 0x3];
+    uint64_t mask = 0;
+    switch (kind) {
+      case 0: mask = m.cfxtrap; break;
+      case 1: mask = m.cfxmem; break;
+      case 2: mask = m.cfxreg; break;
+      default: mask = m.cfxexe; break;
+    }
+    return (mask & (1ULL << (s.cfxCode & 0x3F))) != 0;
+}
+
+void
+nodeFrameBlockAsync(NodeState &s, int ci, uint8_t entryMode)
+{
+    const int mon = entryMode & 0x3;
+    s.cfx[ci].savedGlobalIntrMask = s.cfx[mon].globalCfxIntrMask;
+    s.cfx[ci].savedIntrMonitor = mon;
+    s.cfx[mon].globalCfxIntrMask = ~0ULL;
+}
+
+uint64_t
+nodeCfxEnter(NodeState &s, uint64_t cause, int target, uint64_t causeIp,
+             uint64_t causeInfo, bool sync, bool *entered)
+{
+    const uint8_t entryMode = s.runMode;
+    const int ci = nodeCfxIndex(target);
+    uint64_t vec;
+
+    // contract-see §6.1.1 / ADR-0056 D3: the class/wyde pairing and the
+    // one-hot shape are checked before the id reaches the frame, so a wrong
+    // raise site fails by name instead of silently handing the kernel an
+    // ambiguous id.
+    checkCauseId(cause);
+
+    if (ci < 0) {
+        *entered = false;
+        return 0;
+    }
+    if (!sync) {
+        // step 3: two-level interrupt source filter (ADR-0045 D3).  Either the
+        // current cfx's cfx_intr_mask or the entry-mode monitor's
+        // global_cfx_intr_mask set => pending, no delivery.  Sync exceptions
+        // are never masked (§5.2 step 2).
+        const int cur = nodeCfxIndex(s.cfxCode);
+        const uint64_t curMask = (cur >= 0)
+            ? s.cfx[cur].mode[entryMode].cfxIntrMask : 0;
+        const uint64_t globalMask =
+            s.cfx[entryMode & 0x3].globalCfxIntrMask;
+        if ((curMask & (1ULL << target)) ||
+            (globalMask & (1ULL << target))) {
+            s.cfx[ci].pending |= cause;
+            *entered = false;
+            return 0;
+        }
+    }
+
+    // step 4: trap / sync / async counter
+    if (cause == CauseCfxTrap)
+        s.cfx[ci].trapNum++;
+    else if (!sync)
+        s.cfx[ci].excpAsyncNum++;
+    else
+        s.cfx[ci].excpSyncNum++;
+
+    // step 5: save the previous run mode and current cfx (no independent
+    // cfx-mask state).  `prevCfxCode` must be sampled *before* step 6 rewrites
+    // `cfxCode` (DADAO-12 §5.2 step 5/6), so a frame that receives a nested
+    // async delivery still knows the cfx it interrupted.
+    s.cfx[ci].prevRunMode = entryMode;
+    s.cfx[ci].prevCfxCode = s.cfxCode & 0x3F;
+
+    // step 6: switch to the entry-mode values; the cfx target changes but
+    // there is no cfx-mask layer to switch.
+    vec = s.cfx[ci].mode[entryMode].excpVector;
+    s.runMode = s.cfx[ci].mode[entryMode].switchRunMode & 0x3;
+    s.cfxCode = static_cast<uint8_t>(target);
+
+    // step 5 continued: record cause ip / id / info
+    s.cfx[ci].causeIp = causeIp;
+    s.cfx[ci].causeId = cause;
+    s.cfx[ci].causeInfo = causeInfo;
+
+    // step 7: the caller jumps to the vector
+    *entered = true;
+    return vec;
+}
+
+void
+nodeCfxRaise(ThreadContext *tc, NodeState &s, uint64_t cause, int target,
+             uint64_t causeIp, uint64_t causeInfo, bool fromFault)
+{
+    bool entered = false;
+    const uint64_t vec =
+        nodeCfxEnter(s, cause, target, causeIp, causeInfo, true, &entered);
+    if (entered)
+        clearReservationOnEntry(tc);
+    setPc(tc, entered ? vec : causeIp + 4, fromFault);
+    // A masked exception skips one instruction; keep the trace TB boundary.
+    s.traceForce = true;
+}
+
+bool
+nodeVectorReachable(const NodeState &s, uint64_t vec)
+{
+    // The vector follows the ordinary address rules (spec/DADAO-12 §5.2
+    // step 7): cfxha = addr[47:42]; `cfxha == 0` is a virtual address, every
+    // other value must land in one of the machine's internal segments.
+    if (vec & 0x3)
+        return false;
+    const Addr addr = vec & NodeAddrMask;
+    const unsigned cfxha = (addr >> 42) & 0x3F;
+
+    if (cfxha == 0) {
+        // Software guarantees the vector page is mapped ("硬件不提供向量缺失
+        // 的恢复机制"); with PTW off nothing in the memory window translates.
+        return (s.ptwEnable & 1) != 0;
+    }
+    if (regionCovers(s.ramBase, s.ramSize, addr, 4) ||
+        regionCovers(s.romBase, s.romSize, addr, 4))
+        return true;
+    // hmon / smon / cfx_pmem internal SRAM: cfxha 3 / 2 / 32, internal offset
+    // 0x3ff_0000_0000 (spec/Kaiwu §1.1, DADAO-13 §1).
+    if (cfxha == 3 || cfxha == 2 || cfxha == CfxhaPmem)
+        return regionCovers(kPmemCfxOffset, kPmemSize, addr & NodeVaMask, 4);
+    return false;
+}
+
+void
+nodeSyncEnter(ThreadContext *tc, NodeState &s, uint64_t cause, int target,
+              uint64_t causeIp, uint64_t causeInfo)
+{
+    const uint8_t entryMode = s.runMode & 0x3;
+    const int ci = nodeCfxIndex(target);
+    const uint64_t vec =
+        (ci >= 0) ? s.cfx[ci].mode[entryMode].excpVector : 0;
+
+    if (ci < 0 || !nodeVectorReachable(s, vec)) {
+        // The monitor vector cannot be entered.  This is the one remaining
+        // machine stop for a synchronous exception (spec/Kaiwu §7.1), encoded
+        // for the *entry* run mode: the frame switch below has not happened.
+        machineFaultExit(static_cast<uint8_t>(__builtin_ctzll(cause)),
+                         entryMode, (target <= 3) ? -1 : target);
+        return;
+    }
+    // Fault-invoked redirect: gem5's advancePC() will not advance the PC, so
+    // the vector's first instruction must not be re-executed.
+    nodeCfxRaise(tc, s, cause, target, causeIp, causeInfo, true);
+}
