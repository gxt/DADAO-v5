+/** cfxha values with a register row (DADAO-12 §3).  `cfx_cache` (5) is
+ *  appended last on purpose: the first nine entries keep the index order the
+ *  fixed trace/dump uses (`kTraceCfxha` in isa.cc), and lookups are by value
+ *  (`nodeCfxIndex`), never by position.  cfx5's generic cg0-cg7 rows carry
+ *  its trap vector, frame and both-axis masks (contract-see §3); its cg8
+ *  register face is decoded separately (contract-cache CACHE-03/04). */
+constexpr int kCfxhaMap[NodeNumCfx] = {0, 1, 2, 3, 4, 15, 32, 34, 63, 5};
+
+/** cfx_pmem SRAM internal offset (DADAO-12 §2.1/§4.9). */
+constexpr uint64_t kPmemCfxOffset = 0x3FF00000000ULL;
+constexpr uint64_t kPmemSize = 64 * 1024;
+
+/** cfx_pmem DMA register bits (DADAO-12 §4.9). */
+constexpr uint64_t kDmaBusy = 1ULL << 0;
+constexpr uint64_t kDmaDone = 1ULL << 1;
+constexpr uint64_t kDmaError = 1ULL << 2;
+constexpr unsigned kDmaErrShift = 3;
+constexpr uint64_t kDmaErrMask = 0x1FULL << kDmaErrShift;
+constexpr uint64_t kDmaCtrlStart = 1ULL << 0;
+constexpr uint64_t kDmaCtrlDir = 1ULL << 1;
+constexpr uint64_t kDmaCtrlIrqEn = 1ULL << 2;
+// gem5's global tick is 1 ps (a 1 GHz CPU tick = 1000 of them); the DMA
+// completes 1 us later so BUSY is observable for many instructions.
+constexpr uint64_t kPsPerNs = 1000;
+constexpr uint64_t kDmaTimerTicks = 1000 * kPsPerNs;
+
+/** cfx_hart timer bits (DADAO-12 §4.7). */
+constexpr uint64_t kHartEnable = 1ULL << 0;
+constexpr uint64_t kHartImask = 1ULL << 1;
+constexpr uint64_t kHartIstatus = 1ULL << 2;
+
+constexpr uint64_t kTimeFreq = 1000000000ULL;
+
+/** cfx_cache_ctrl command encoding (contract CACHE-09). */
+constexpr unsigned kCacheOpNone = 0x0;
+constexpr unsigned kCacheOpClean = 0x1;
+constexpr unsigned kCacheOpInvalidate = 0x2;
+constexpr unsigned kCacheOpFlush = 0x3;
+
+constexpr unsigned kCacheScopeAll = 0x0;
+constexpr unsigned kCacheScopeLine = 0x1;
+constexpr unsigned kCacheScopeRange = 0x2;
+constexpr unsigned kCacheScopeReserved = 0x3;
+
+/** cfx_cache address mask: the whole 56-bit physical address space
+ *  (CACHE-18: `addr_start` carries PA[55:0] and [63:56] read 0).  This is
+ *  *not* NodeAddrMask (48 bits), which the vector/VA checks use. */
+constexpr uint64_t kCachePaMask = (1ULL << 56) - 1;
+
+/** Selection bits [15:14] of cfx_cache_ctrl (CACHE-09: bit15 = I, bit14 = D). */
+constexpr uint64_t kCacheSelInst = 1ULL << 15;
+constexpr uint64_t kCacheSelData = 1ULL << 14;
+
+/** Install a redirect target.  `sequentialNext` = the redirect comes from a
+ *  gem5 `Fault`: `BaseSimpleCPU::advancePC()` invokes the fault and does not
+ *  advance the PC afterwards, so npc must be the instruction *after* the
+ *  vector.  An in-execute redirect (trap / escape / cfx fault) is followed by
+ *  `PCState::advance()` (pc = npc), so there npc must be the vector itself. */
+void
+setPc(ThreadContext *tc, Addr pc, bool sequentialNext = false)
+{
+    DadaoISA::PCState target(pc);
+    target.npc(sequentialNext ? pc + 4 : pc);
+    tc->pcState(target);
+}
+
+/** Current instruction address (the faulting instruction when called from
+ *  a hook: gem5 keeps the PC at the executing instruction). */
+Addr
+currentPc(ThreadContext *tc)
+{
+    return tc->pcState().instAddr();
+}
+
+/** Exception/interrupt entry clears this hart's LR/SC reservation
+ *  (spec/SimRISC-12 §1「保留机制」): an `sc` after a handler must fail, so the
+ *  reservation is dropped whenever a vector is actually entered (sync fault,
+ *  `trap`, or async delivery).  Before this, entry left it live and the
+ *  following `sc` succeeded (ISS-443). */
+void
+clearReservationOnEntry(ThreadContext *tc)
+{
+    if (auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr()))
+        isa->clearReservations();
+}
+
+class NodeDmaEvent : public Event
+{
+  public:
+    ThreadContext *tc = nullptr;
+    NodeState *state = nullptr;
+
+    void process() override { nodeDmaComplete(tc, *state); }
+
+    const char *
+    description() const override
+    {
+        return "DADAO cfx_pmem DMA completion";
+    }
+};
+
+class NodeTimerEvent : public Event
+{
+  public:
+    ThreadContext *tc = nullptr;
+    NodeState *state = nullptr;
+
+    void process() override { nodeTimerExpire(tc, *state); }
+
+    const char *
+    description() const override
+    {
+        return "DADAO cfx_hart timer expiry";
+    }
+};
+
+void
+reschedule(Event *event, Tick when)
+{
+    EventQueue *queue = curEventQueue();
+    if (event->scheduled())
+        queue->reschedule(event, when);
+    else
+        queue->schedule(event, when);
+}
+
+void
+deschedule(Event *event)
+{
+    if (event->scheduled())
+        curEventQueue()->deschedule(event);
+}
+
+bool
+regionCovers(Addr base, Addr size, Addr addr, Addr len)
+{
+    if (len == 0 || addr < base)
+        return false;
+    const Addr off = addr - base;
+    return off < size && len <= size - off;
+}
