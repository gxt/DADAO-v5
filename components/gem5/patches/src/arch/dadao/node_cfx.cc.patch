+
+uint64_t *
+cfxModeReg(NodeCfxMode *m, int rc)
+{
+    switch (rc) {
+      case 0: return &m->cfxtrap;
+      case 1: return &m->cfxmem;
+      case 2: return &m->cfxreg;
+      case 3: return &m->cfxexe;
+      case 4: return &m->cfxIntrMask;
+      case 8: return &m->switchRunMode;
+      case 10: return &m->excpVector;
+      case 12: return &m->cgRegDeleg;
+      default: return nullptr;
+    }
+}
+
+/** cg7 internal-space descriptor (DADAO-12 §3.8; read-only). */
+uint64_t
+cg7SpaceReg(const NodeState &s, int cfxha, unsigned rc)
+{
+    static const uint64_t smon[4] = {0x3, 0x3FF00000000ULL, 0x10000ULL, 0x7};
+    static const uint64_t pmem[4] = {0x3, 0x3FF00000000ULL, 0x10000ULL, 0x3};
+    const uint64_t power[4] = {
+        0x5,
+        s.romBase & ((1ULL << 42) - 1),
+        s.romSize,
+        0x5,
+    };
+    const uint64_t *blk;
+
+    if (rc / 4 != 0)
+        return 0;
+    switch (cfxha) {
+      case 2:
+      case 3: blk = smon; break;
+      case 32: blk = pmem; break;
+      case 63: blk = power; break;
+      default: return 0;
+    }
+    return blk[rc % 4];
+}
+
+/** Resolve (cfxha, cg, rc) to a register; nullptr => CFXREG. */
+uint64_t *
+cfxRegPtr(NodeState &s, int ci, int cg, int rc, bool write)
+{
+    NodeCfxRegs &r = s.cfx[ci];
+    const int cfxha = kCfxhaMap[ci];
+
+    if (cg <= 2) {
+        if (rc <= 4 || (rc >= 8 && rc <= 11))
+            return cfxModeReg(&r.mode[cg], rc);
+        return nullptr;
+    }
+    if (cg == 3) {
+        if (s.runMode != NodeHypv)
+            return nullptr; // cg3 is hypv-only (DADAO-13 §1)
+        if (rc <= 4 || (rc >= 8 && rc <= 12))
+            return cfxModeReg(&r.mode[3], rc);
+        return nullptr;
+    }
+    switch (cg) {
+      case 4:
+        switch (rc) {
+          case 0: return write ? nullptr : &r.cfxId;
+          case 1: return write ? nullptr : &r.version;
+          case 2: return write ? nullptr : &r.trapNum;
+          case 3: return write ? nullptr : &r.excpSyncNum;
+          case 4: return write ? nullptr : &r.excpAsyncNum;
+          case 5: return write ? nullptr : &r.escapeNum;
+          case 6: return write ? nullptr : &r.scratchRegsNum;
+          default: return nullptr;
+        }
+      case 5:
+        switch (rc) {
+          case 0: return &r.prevRunMode;
+          case 1: return &r.prevCfxCode;
+          case 2: return write ? nullptr : &r.causeId;
+          case 3: return &r.causeIp;
+          case 4: return write ? nullptr : &r.causeInfo;
+          case 5: return &r.pending;
+          default: return nullptr;
+        }
+      case 6:
+        if (static_cast<uint64_t>(rc) >= r.scratchRegsNum)
+            return nullptr;
+        return &r.scratch[rc];
+      case 8:
+        if (cfxha < 4 && rc == 1)
+            return &r.globalCfxIntrMask;
+        return (cfxha == CfxhaPtw && rc == 8) ? &s.ptwEnable : nullptr;
+      case 9:
+        return (cfxha == CfxhaPtw && rc == 0) ? &s.ptbr : nullptr;
+      case 12:
+        if (cfxha != CfxhaPtw)
+            return nullptr;
+        switch (rc) {
+          case 0: return write ? &s.tlbControl : nullptr;
+          case 1: return &s.tlbAsid;
+          case 2: return &s.tlbStart;
+          case 3: return &s.tlbSize;
+          default: return nullptr;
+        }
+      default:
+        return nullptr;
+    }
+}
+
+bool
+delegDenied(const NodeState &s, int ci, int cg)
+{
+    if (s.runMode != NodeSupv || cg > 63)
+        return false;
+    return (s.cfx[ci].mode[NodeHypv].cgRegDeleg & (1ULL << cg)) != 0;
+}
+
+bool
+dmaRegRead(NodeState &s, unsigned rc, uint64_t *val)
+{
+    switch (rc) {
+      case 0: *val = s.dma.src; return true;
+      case 1: *val = s.dma.dst; return true;
+      case 2: *val = s.dma.size & 0x3FFFFFFFULL; return true;
+      case 3: *val = s.dma.ctrl & ~kDmaCtrlStart; return true;
+      case 4: *val = s.dma.status; return true;
+      default: return false;
+    }
+}
+
+bool
+dmaPaOk(const NodeState &s, uint64_t pa, uint64_t len, bool write)
+{
+    const uint64_t end = pa + len;
+    if (end < pa)
+        return false;
+    if (pa >= s.ramBase && end <= s.ramBase + s.ramSize)
+        return true;
+    if (!write && pa >= s.romBase && end <= s.romBase + s.romSize)
+        return true;
+    return false;
+}
+
+void
+dmaStart(ThreadContext *tc, NodeState &s, uint64_t ctrl)
+{
+    const uint64_t dir = (ctrl & kDmaCtrlDir) ? 1 : 0;
+    const uint64_t cfxAddr = (dir ? s.dma.dst : s.dma.src) & NodeVaMask;
+    const uint64_t pa = (dir ? s.dma.src : s.dma.dst) & 0x00FFFFFFFFFFFFFFULL;
+    const uint64_t size = s.dma.size & 0x3FFFFFFFULL;
+    uint64_t err = 0;
+
+    // ERR_CODE is one-hot at status[15:3] (DADAO-12 §4.9).
+    if (size == 0 || size > (1ULL << 29)) {
+        err = 1; // ERR_SIZE
+    } else if (size > kPmemSize) {
+        err = 2; // ERR_CFX_RANGE
+    } else if (cfxAddr < kPmemCfxOffset ||
+               cfxAddr - kPmemCfxOffset > kPmemSize - size) {
+        err = 2; // ERR_CFX_RANGE
+    } else if (size > (1ULL << 56) - pa) {
+        err = 4; // ERR_PA_RANGE
+    } else if (!dmaPaOk(s, pa, size, dir == 0)) {
+        err = 8; // ERR_PA_FAULT
+    }
+
+    if (err) {
+        s.dma.status |= kDmaError | (err << kDmaErrShift);
+        if (s.dma.irqEn) {
+            const int ci = nodeCfxIndex(CfxhaPmem);
+            if (ci >= 0)
+                s.cfx[ci].pending |= CausePmemDma;
+        }
+        return;
+    }
+
+    s.dma.dir = dir;
+    s.dma.cfxOff = cfxAddr - kPmemCfxOffset;
+    s.dma.pa = pa;
+    s.dma.len = size;
+    s.dma.status |= kDmaBusy;
+    reschedule(s.dmaEvent, curTick() + kDmaTimerTicks);
+    (void)tc;
+}
+
+bool
+dmaRegWrite(ThreadContext *tc, NodeState &s, unsigned rc, uint64_t val)
+{
+    const bool busy = (s.dma.status & kDmaBusy) != 0;
+
+    switch (rc) {
+      case 0:
+        if (!busy)
+            s.dma.src = val;
+        return true;
+      case 1:
+        if (!busy)
+            s.dma.dst = val;
+        return true;
+      case 2:
+        if (!busy)
+            s.dma.size = val & 0x3FFFFFFFULL;
+        return true;
+      case 3:
+        if (busy)
+            return true;
+        s.dma.ctrl = val & (kDmaCtrlDir | kDmaCtrlIrqEn);
+        s.dma.irqEn = (val & kDmaCtrlIrqEn) ? 1 : 0;
+        if (val & kDmaCtrlStart)
+            dmaStart(tc, s, val);
+        return true;
+      case 4:
+        if (busy)
+            return true;
+        if (val & kDmaDone)
+            s.dma.status &= ~kDmaDone;
+        if (val & kDmaError)
+            s.dma.status &= ~(kDmaError | kDmaErrMask);
+        return true;
+      default:
+        return false;
+    }
+}
+
+bool
+hartIstatus(const NodeState &s)
+{
+    return (s.timerCtrl & kHartEnable) && s.timerCmp != ~0ULL &&
+           nodeTimeValue(s) >= s.timerCmp;
+}
+
+bool
+hartRegRead(const NodeState &s, unsigned rc, uint64_t *val)
+{
+    switch (rc) {
+      case 0: *val = 0; return true;
+      case 2: *val = nodeTimeValue(s); return true;
+      case 3: *val = s.insnCount; return true;
+      case 4: *val = s.timerCmp; return true;
+      case 5:
+        *val = (s.timerCtrl & (kHartEnable | kHartImask)) |
+               (hartIstatus(s) ? kHartIstatus : 0);
+        return true;
+      default: return false;
+    }
+}
+
+void
+timerArm(ThreadContext *tc, NodeState &s)
+{
+    (void)tc;
+    if (!(s.timerCtrl & kHartEnable) || s.timerCmp == ~0ULL) {
+        deschedule(s.timerEvent);
+        return;
+    }
+    const uint64_t now = nodeTimeValue(s);
+    if (now >= s.timerCmp) {
+        deschedule(s.timerEvent);
+        nodeTimerExpire(s.tc, s);
+        return;
+    }
+    reschedule(s.timerEvent, s.timeBaseTick + s.timerCmp * kPsPerNs);
+}
+
+bool
+hartRegWrite(ThreadContext *tc, NodeState &s, unsigned rc, uint64_t val)
+{
+    const int ci = nodeCfxIndex(CfxhaHart);
+
+    switch (rc) {
+      case 4:
+        s.timerCmp = val;
+        if (ci >= 0)
+            s.cfx[ci].pending &= ~CauseTimer;
+        deschedule(s.timerEvent);
+        timerArm(tc, s);
+        return true;
+      case 5:
+        s.timerCtrl = val & (kHartEnable | kHartImask);
+        if (!(s.timerCtrl & kHartImask) && hartIstatus(s)) {
+            if (ci >= 0)
+                s.cfx[ci].pending |= CauseTimer;
+        }
+        timerArm(tc, s);
+        return true;
+      default:
+        return false;
+    }
+}
+
+bool
+timeRegRead(const NodeState &s, unsigned rc, uint64_t *val)
+{
+    switch (rc) {
+      case 0: *val = kTimeFreq; return true;
+      case 1: *val = nodeTimeValue(s); return true;
+      default: return false;
+    }
+}
+
+/** True when `e` falls inside the command's address scope (TLB-23). */
+bool
+tlbEntryInScope(const NodeState &s, const NodeTlbEntry &e, unsigned scope,
+                bool asidAny, uint64_t start, uint64_t size)
+{
+    if (!e.valid)
+        return false;
+    if (!asidAny && (e.g || e.asid != static_cast<uint16_t>(s.tlbAsid)))
+        return false;
+    if (scope == 0x1) {
+        const uint64_t mask = (1ULL << e.sizeLog2) - 1;
+        return (start & ~mask) == e.va;
+    }
+    if (scope == 0x2) {
+        uint64_t end = start + size;
+        const uint64_t pageEnd = e.va + (1ULL << e.sizeLog2);
+        if (end < start)
+            end = ~0ULL;
+        return e.va < end && start < pageEnd;
+    }
+    return true;
+}
+
+/** Run one `cfx_ptw_tlb_control` operation over one table.  Entry-granular
+ *  and stop-on-first-failure (TLB-37): a write-back failure keeps the failing
+ *  entry and everything after it untouched, and returns 2 with its PTE PA. */
+template <class Entry, unsigned N>
+int
+tlbTableExec(NodeState &s, Entry (&entries)[N], unsigned op, unsigned scope,
+             bool asidAny, uint64_t start, uint64_t size, uint64_t *errPa)
+{
+    for (unsigned i = 0; i < N; ++i) {
+        Entry &e = entries[i];
+        if (!tlbEntryInScope(s, e, scope, asidAny, start, size))
+            continue;
+        if ((op & 0x1) && nodeTlbDirty(e)) {
+            if (!regionCovers(s.ramBase, s.ramSize, e.ptePa, 8)) {
+                // The backing store is not writable (e.g. a page table in
+                // the BootROM): monitor CFXMEM, entry kept (ADR-0041 D7/D10).
+                *errPa = e.ptePa;
+                return 2;
+            }
+            System *system = s.tc->getSystemPtr();
+            uint64_t pte = 0;
+            for (unsigned b = 0; b < 8; ++b) {
+                uint8_t byte = 0;
+                system->physProxy.readBlobPhys(e.ptePa + b, 0, &byte, 1);
+                pte = (pte << 8) | byte;
+            }
+            // Atomic OR: the I and D tables may each hold pending bits for
+            // the same PTE, so never overwrite the word (TLB-15).
+            pte |= nodeTlbDirtyBits(e);
+            uint8_t bytes[8];
+            for (unsigned b = 0; b < 8; ++b)
+                bytes[b] = (pte >> (56 - 8 * b)) & 0xFF;
+            system->physProxy.writeBlobPhys(e.ptePa, 0, bytes, 8);
+            nodeTlbClearDirty(e);
+        }
+        if (op & 0x2)
+            e.valid = false;
+    }
+    return 0;
+}
+
+/** cfx_ptw cg12 rc0 command (DADAO-12 §4.5; ADR-0041 D3/D6/D7).
+ *  Returns 0 (ok), 1 (CFXREG operand) or 2 (A/D write-back failure with
+ *  *errPa; delivered to the current monitor as CFXMEM).  The spec has one
+ *  TLB (no I/D selector), so every command walks the I table and then the D
+ *  table; a failure stops the whole command. */
+int
+tlbControlExec(NodeState &s, uint64_t val, uint64_t *errPa)
+{
+    const unsigned op = val & 0x3;
+    const unsigned scope = (val >> 2) & 0x3;
+    const bool asidAny = (val >> 4) & 0x1;
+    const uint64_t start = s.tlbStart;
+    const uint64_t size = s.tlbSize;
+
+    if (op == 0x0)
+        return 0;
+    if (scope == 0x3)
+        return 1;
+    if (scope == 0x2 && size == 0)
+        return 1;
+
+    for (unsigned set = 0; set < NodeTlbSets; ++set) {
+        const int r = tlbTableExec(s, s.itlb[set], op, scope, asidAny, start,
+                                   size, errPa);
+        if (r != 0)
+            return r;
+    }
+    int r = tlbTableExec(s, s.itlbSp, op, scope, asidAny, start, size, errPa);
+    if (r != 0)
+        return r;
+    for (unsigned set = 0; set < NodeTlbSets; ++set) {
+        r = tlbTableExec(s, s.dtlb[set], op, scope, asidAny, start, size,
+                         errPa);
+        if (r != 0)
+            return r;
+    }
+    return tlbTableExec(s, s.dtlbSp, op, scope, asidAny, start, size, errPa);
+}
+
+/** Issue one classic-L1 maintenance request for one line (m16-gem5-021).
+ *
+ * This is the standard gem5 cache-maintenance request that Arm's
+ * `dc cvac/civac/ivac` build (src/arch/arm/isa/insts/data64.isa) and x86's
+ * `clflushopt/clwb` build (src/arch/x86/isa/microops/ldstop.isa):
+ * `Request::CLEAN` / `Request::INVALIDATE` / `DST_POC` on a line-sized
+ * access, which `Packet::makeWriteCmd()` turns into `MemCmd::CleanSharedReq`
+ * / `InvalidateReq` / `CleanInvalidReq`.  The cache itself then performs the
+ * writeback and/or the discard (`BaseCache::access` forwards a maintenance
+ * request, `BaseCache::recvAtomic` writes a dirty line back for a clean and
+ * `Cache::recvAtomic` drops an invalidated line), so `src/mem/cache` is
+ * untouched.
+ *
+ * The D side uses the CPU's data port and the I side its instruction port --
+ * the I cache sits only on the latter, and INVALIDATE there is exactly "drop
+ * the line" (the I side never holds dirty data, so flush == invalidate,
+ * CACHE-19).  Both sends are atomic: the command completes synchronously
+ * (CACHE-24) and the DADAO exec cores are one-shot, so there is no two-phase
+ * initiateAcc/completeAcc flow to hand the packet to.
+ *
+ * The address is the architecturally supplied **physical** address
+ * (CACHE-02/16/17): the request carries Request::PHYSICAL, is never
+ * translated, and the cache matches it against its PA tags.
+ */
+void
+cacheMaintainLine(NodeState &s, bool inst, Addr line, Request::Flags flags)
+{
+    BaseCPU *cpu = s.tc->getCpuPtr();
+    auto *port = dynamic_cast<RequestPort *>(
+        inst ? &cpu->getInstPort() : &cpu->getDataPort());
+    panic_if(port == nullptr,
+             "DADAO cfx_cache: CPU %s has no classic %s port to maintain",
+             cpu->name(), inst ? "instruction" : "data");
+    System *system = s.tc->getSystemPtr();
+    const unsigned lineSize = system->cacheLineSize();
+
+    // CACHE-22: a line that is not backed by memory in this machine (an
+    // address outside every RAM/ROM/device window) has no cache effect and
+    // raises nothing -- there is nothing to maintain and nothing to route.
+    if (!system->isMemAddr(line))
+        return;
+
+    RequestPtr req = std::make_shared<Request>(
+            line, lineSize, flags | Request::PHYSICAL,
+            inst ? cpu->instRequestorId() : cpu->dataRequestorId());
+    req->setContext(s.tc->contextId());
+    req->taskId(cpu->taskId());
+
+    Packet pkt(req, Packet::makeWriteCmd(req));
+    port->sendAtomic(&pkt);
+}
+
+/** Run one cfx_cache_ctrl operation over one side (CACHE-15..22).
+ *
+ * "PA 单行" and "PA 区间" name their lines directly, so the request is built
+ * from the command operands.  "all" has no operand: the lines are the ones
+ * that side currently holds, which is what the tag store lists (a maintenance
+ * command only ever has an observable effect on a line that is present, so
+ * that is equivalent to sweeping the address space and its cost is bounded by
+ * the cache geometry instead of by the PA space). */
+void
+cacheSideExec(NodeState &s, bool inst, unsigned op, unsigned scope,
+              uint64_t start, uint64_t size, BaseTags *tags)
+{
+    // CACHE-19: I has no dirty state -- `clean` is a no-op there.
+    if (inst && op == kCacheOpClean)
+        return;
+    if (tags == nullptr)
+        return;
+
+    Request::Flags flags;
+    switch (op) {
+      case kCacheOpClean:
+        flags = Request::CLEAN | Request::DST_POC;
+        break;
+      case kCacheOpInvalidate:
+        // Dirty data is dropped, never written back (CACHE-20).
+        flags = Request::INVALIDATE | Request::DST_POC;
+        break;
+      default:  // kCacheOpFlush: write back, then drop (CACHE-20)
+        flags = Request::CLEAN | Request::INVALIDATE | Request::DST_POC;
+        break;
+    }
+
+    const unsigned lineSize = s.tc->getSystemPtr()->cacheLineSize();
+    const Addr lineMask = Addr(lineSize) - 1;
+    const Addr first = start & kCachePaMask;
+
+    // CACHE-16: "PA 单行" is one line, named by addr_start; whether it is
+    // present is the cache's business (a miss forwards the request and
+    // nothing happens, CACHE-22).
+    if (scope == kCacheScopeLine) {
+        cacheMaintainLine(s, inst, first & ~lineMask, flags);
+        return;
+    }
+
+    // CACHE-15/17: "all" is every line the side holds, "PA 区间" the held
+    // lines that intersect [start, start + size).  A maintenance command only
+    // has an observable effect on a line that is present, so enumerating the
+    // tag store is equivalent to sweeping the address space and keeps the
+    // cost bounded by the cache geometry (a huge addr_size cannot hang the
+    // simulation).
+    const Addr rangeEnd = (size > kCachePaMask - first) ? kCachePaMask + 1
+                                                        : first + size;
+    std::vector<Addr> lines;
+    tags->forEachBlk([&](CacheBlk &blk) {
+        if (blk.isValid())
+            lines.push_back(tags->regenerateBlkAddr(&blk));
+    });
+    for (Addr line : lines) {
+        if (scope == kCacheScopeRange &&
+            !(line < rangeEnd && first < line + lineSize))
+            continue;
+        cacheMaintainLine(s, inst, line, flags);
+    }
+}
+
+/** cfx_cache_ctrl write (CACHE-09..25).  Returns 0 (ok) or 1 (CFXREG).
+ *  The judgement order is the contract's: selection, then operation, then
+ *  the range encoding and its operand (CACHE-11); the CFXREG of an illegal
+ *  encoding therefore happens before any maintenance action (CACHE-25). */
+int
+cacheControlExec(NodeState &s, uint64_t val)
+{
+    const unsigned op = val & 0x3;
+    const unsigned scope = (val >> 2) & 0x3;
+    const bool selI = (val & kCacheSelInst) != 0;
+    const bool selD = (val & kCacheSelData) != 0;
+
+    // CACHE-12/13: no side selected, or `none`, is an unconditional no-op
+    // that does not even look at the range encoding or addr_size.
+    if (!selI && !selD)
+        return 0;
+    if (op == kCacheOpNone)
+        return 0;
+    // CACHE-14: only a command that actually selects something validates.
+    if (scope == kCacheScopeReserved)
+        return 1;
+    if (scope == kCacheScopeRange && s.cache.addrSize == 0)
+        return 1;
+
+    // m16-gem5-023 / CACHE-27 (`cache-model` dimension): with no cache model
+    // this machine still implements cfx5, but `cache_exist` reads 0 and a
+    // legal command has no effect -- it is accepted (no CFXREG) and performs
+    // no maintenance.  The encoding checks above are not gated by it
+    // (CACHE-14 still raises, exactly as with `cache_enable` = 0, CACHE-08).
+    if (s.cache.exist == 0)
+        return 0;
+
+    auto *isa = dynamic_cast<ISA *>(s.tc->getIsaPtr());
+    BaseTags *itags = (isa != nullptr) ? isa->cfxItags() : nullptr;
+    BaseTags *dtags = (isa != nullptr) ? isa->cfxDtags() : nullptr;
+
+    // CACHE-21: I first, then D; CACHE-08: a side whose enable bit is 0 is
+    // not maintained (the encoding checks above are unaffected by enable).
+    if (selI && (s.cache.enable & 0x1))
+        cacheSideExec(s, true, op, scope, s.cache.addrStart,
+                      s.cache.addrSize, itags);
+    if (selD && (s.cache.enable & 0x2))
+        cacheSideExec(s, false, op, scope, s.cache.addrStart,
+                      s.cache.addrSize, dtags);
+    return 0;
+}
+
+/** cfx5 cg8 register read (CACHE-03/06/07/18, CACHE-27 `cache-model`
+ *  dimension).  Only called after `nodeCfxRead` has applied the cfxreg mask
+ *  and the supv cg delegation (m16-gem5-024), so the two-axis permission
+ *  model gates cfx5 exactly like every other cfx.  The five contract
+ *  registers exist whether or not a cache model is present:
+ *  `cache_exist` simply reads 0 when `cache-model=off` (m16-gem5-023), so the
+ *  access never raises CFXREG.  Everything outside them is reserved, and a
+ *  reserved rc (including the write-only rc9) still raises CFXREG here
+ *  (CACHE-04). */
+void
+cacheRegRead(ThreadContext *tc, NodeState &s, uint8_t cg, uint8_t rc,
+             uint64_t &out, uint64_t info)
+{
+    const Addr pc = currentPc(tc);
+
+    if (cg == 8) {
+        switch (rc) {
+          case 0:  out = s.cache.exist; return;
+          case 8:  out = s.cache.enable; return;
+          // rc9 (`cache_ctrl`) is write-only: it executes on the write.
+          case 10: out = s.cache.addrStart; return;
+          case 11: out = s.cache.addrSize; return;
+          default: break;
+        }
+    }
+    nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+}
+
+/** cfx5 cg8 register write (CACHE-03/07/09/18/24, CACHE-27 `cache-model`
+ *  dimension).  Called only after the same permission + delegation checks as
+ *  every other cfx write (m16-gem5-024).  Writable registers stay writable
+ *  with no cache model; the
+ *  writes are accepted and have no effect beyond the register value
+ *  (`cache_enable` reads back 0 because it is masked with `cache_exist`). */
+void
+cacheRegWrite(ThreadContext *tc, NodeState &s, uint8_t cg, uint8_t rc,
+              uint64_t val, uint64_t info)
+{
+    const Addr pc = currentPc(tc);
+
+    if (cg == 8) {
+        switch (rc) {
+          case 0:
+            // `cache_exist` is read-only (hardware-set).
+            break;
+          case 8:
+            // CACHE-07: a bit whose exist bit is 0 reads back 0; the other
+            // bits are reserved and read 0.
+            s.cache.enable = val & s.cache.exist & 0x3;
+            return;
+          case 9:
+            // CACHE-24: the write itself is the command; it completes
+            // synchronously, so the next access already sees the effect.
+            if (cacheControlExec(s, val) != 0)
+                nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return;
+          case 10:
+            s.cache.addrStart = val & kCachePaMask;
+            return;
+          case 11:
+            s.cache.addrSize = val;
+            return;
+          default:
+            break;
+        }
+    }
+    nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+}
+
+} // anonymous namespace
+
+void
+nodeDmaComplete(ThreadContext *tc, NodeState &s)
+{
+    if (!(s.dma.status & kDmaBusy))
+        return;
+
+    System *system = tc->getSystemPtr();
+    std::vector<uint8_t> buf(s.dma.len);
+    const Addr cfxPhys = s.pmemBase + s.dma.cfxOff;
+    bool ok = true;
+
+    if (s.dma.dir == 0) {
+        system->physProxy.readBlobPhys(cfxPhys, 0, buf.data(), s.dma.len);
+        system->physProxy.writeBlobPhys(s.dma.pa, 0, buf.data(), s.dma.len);
+    } else {
+        system->physProxy.readBlobPhys(s.dma.pa, 0, buf.data(), s.dma.len);
+        system->physProxy.writeBlobPhys(cfxPhys, 0, buf.data(), s.dma.len);
+    }
+
+    s.dma.status &= ~kDmaBusy;
+    if (!ok) {
+        s.dma.status |= kDmaError | (8ULL << kDmaErrShift);
+    } else {
+        s.dma.status |= kDmaDone;
+    }
+
+    if (s.dma.irqEn) {
+        const int ci = nodeCfxIndex(CfxhaPmem);
+        if (ci >= 0)
+            s.cfx[ci].pending |= CausePmemDma;
+    }
+}
+
+void
+nodeTimerExpire(ThreadContext *tc, NodeState &s)
+{
+    (void)tc;
+    const int ci = nodeCfxIndex(CfxhaHart);
+    if (!(s.timerCtrl & kHartEnable) || s.timerCmp == ~0ULL)
+        return;
+    if (nodeTimeValue(s) < s.timerCmp)
+        return;
+    if (ci >= 0)
+        s.cfx[ci].pending |= CauseTimer;
+}
+
+bool
+nodeDeliverAsync(ThreadContext *tc, NodeState &s)
+{
+    struct Source
+    {
+        int cfxha;
+        uint64_t cause;
+    };
+    static const Source sources[] = {
+        {CfxhaHart, CauseTimer},
+        {CfxhaPmem, CausePmemDma},
+    };
+
+    for (const auto &src : sources) {
+        const int ci = nodeCfxIndex(src.cfxha);
+        if (ci < 0 || !(s.cfx[ci].pending & src.cause))
+            continue;
+        if (src.cfxha == CfxhaHart && (s.timerCtrl & kHartImask))
+            continue;
+
+        const uint8_t entryMode = s.runMode;
+        const uint64_t info =
+            (src.cfxha == CfxhaHart) ? 0 : s.dma.status;
+        bool entered = false;
+        const uint64_t vec = nodeCfxEnter(s, src.cause, src.cfxha, currentPc(tc),
+                                          info, false, &entered);
+        if (!entered)
+            continue;
+        // Async delivery is an interrupt entry: clear the reservation
+        // (spec/SimRISC-12 §1; ISS-443).
+        clearReservationOnEntry(tc);
+        s.cfx[ci].pending &= ~src.cause;
+        setPc(tc, vec);
+        nodeFrameBlockAsync(s, ci, entryMode);
+        return true;
+    }
+    return false;
+}
+
+/** Write the L1 D-cache back at a monitor hand-off (m16-gem5-022).
+ *
+ * With the classic write-back L1 D cache wired in (cache-model=on), the Vast
+ * power stage loads the hmon image into HMON SRAM with ordinary stores and
+ * hmon primes the cfx_pmem SRAM for cfx_pmem the same way.  Those lines stay
+ * dirty, so the monitor's own segment and its page-table template are not in
+ * memory; an architectural `D | invalidate | all` (or any invalidate covering
+ * them, CACHE-20) drops them and a later monitor entry cannot be fetched.
+ * The contract leaves cache organisation to the implementation and the RTL
+ * keeps the monitor in internal SRAM, so the test machine hands the monitor
+ * segment over in memory: flush D exactly at the two hand-off traps
+ * (power -> hmon, hmon -> test body).  `cache_exist` bit1 = 0 (no L1) makes
+ * this a no-op, so cache-model=off is byte-identical. */
+void
+nodeFlushDAtHandoff(NodeState &s)
+{
+    if ((s.cache.exist & 0x2) == 0)
+        return;
+    auto *isa = dynamic_cast<ISA *>(s.tc->getIsaPtr());
+    if (isa == nullptr)
+        return;
+    cacheSideExec(s, false, kCacheOpFlush, kCacheScopeAll, 0, 0,
+                  isa->cfxDtags());
+}
+
+void
+nodeTrap(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint32_t immu18)
+{
+    const uint64_t info = (uint64_t(0x7F) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18) |
+                          uint64_t(immu18 & 0x3FFFF);
+    const Addr pc = currentPc(tc);
+
+    if (immu18 >= 0x3FF00) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return;
+    }
+    if (nodeCfxReserved(cfxha)) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return;
+    }
+    const int ci = nodeCfxIndex(cfxha);
+    if (ci < 0) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return;
+    }
+    if (nodePermDenied(s, cfxha, 0)) {
+        nodeCfxRaise(tc, s, CauseCfxPerm | SubNcfxPerm, s.runMode, pc,
+                     info);
+        return;
+    }
+
+    const uint8_t entryMode = s.runMode;
+    // m16-gem5-022: hand the monitor segment over in memory (see the helper).
+    // The hmon cfx is 3; cfx_umon is 0 and its semihosting trap is >= 0x3FF00
+    // (handled above), so only a real mode hand-off matches here.
+    const bool powerToHmon = (s.cfxCode == CfxhaPower && cfxha == 3);
+    const bool hmonToBody = (s.cfxCode == 3 && cfxha == 0);
+    if (powerToHmon || hmonToBody)
+        nodeFlushDAtHandoff(s);
+
+    bool entered = false;
+    const uint64_t vec =
+        nodeCfxEnter(s, CauseCfxTrap, cfxha, pc, info, true, &entered);
+    if (entered)
+        clearReservationOnEntry(tc);
+    setPc(tc, entered ? vec : pc + 4);
+    s.traceForce = true;
+    if (entered && s.cfxCode == cfxha)
+        nodeFrameBlockAsync(s, ci, entryMode);
+}
+
+bool
+nodeEscape(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint32_t byteOffset)
+{
+    const uint64_t imms18 = (byteOffset >> 2) & 0x3FFFF;
+    const uint64_t info = (uint64_t(0x7E) << 24) |
+                          (uint64_t(cfxha & 0x3F) << 18) | imms18;
+    const Addr pc = currentPc(tc);
+
+    if (imms18 & ~0x1ULL) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return true;
+    }
+    if (nodeCfxReserved(cfxha)) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return true;
+    }
+    const int ci = nodeCfxIndex(s.cfxCode);
+    if (ci < 0 || cfxha != s.cfxCode || s.cfx[ci].causeId == 0) {
+        nodeCfxRaise(tc, s, CauseCfxEsc, s.cfxCode, pc, info);
+        return true;
+    }
+
+    // step 1: restore the monitor's global interrupt mask (D9)
+    const int mon = s.cfx[ci].savedIntrMonitor & 0x3;
+    s.cfx[mon].globalCfxIntrMask = s.cfx[ci].savedGlobalIntrMask;
+    // step 2: restore the previous run mode and current cfx from the frame (no
+    // cfx-mask layer is restored; the trap saved only globalCfxIntrMask).
+    // Without the cfx restore a frame that received a nested async delivery
+    // could never escape: step 6 of the nested entry moved cfxCode to the
+    // delivered cfx, so this escape's cfxha check would fail with CFXESC
+    // (DADAO-12 §5.3 step 0/2).
+    s.runMode = s.cfx[ci].prevRunMode & 0x3;
+    s.cfxCode = static_cast<uint8_t>(s.cfx[ci].prevCfxCode & 0x3F);
+    // step 3: increment the escape counter
+    s.cfx[ci].escapeNum++;
+    // step 4: return to cause_ip + (imms18 << 2)
+    setPc(tc, s.cfx[ci].causeIp + uint64_t(byteOffset));
+    s.traceForce = true;
+    return true;
+}
+
+bool
+nodeCfxRead(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint8_t cg,
+            uint8_t rc, uint64_t &out, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (nodeCfxReserved(cfxha)) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return true;
+    }
+    const int ci = nodeCfxIndex(cfxha);
+    if (ci < 0) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+    if (nodePermDenied(s, cfxha, 2)) {
+        nodeCfxRaise(tc, s, CauseCfxPerm | SubNcfxPerm, s.runMode, pc,
+                     info);
+        return true;
+    }
+    if (delegDenied(s, ci, cg)) {
+        nodeCfxRaise(tc, s, CauseCfxPerm | SubNcfxPerm, s.runMode, pc,
+                     info);
+        return true;
+    }
+    // cfx_cache (cfx5) keeps the generic cg0-cg7 rows (trap vector, frame,
+    // both-axis masks; contract-see §3) and adds its own cg8 register face.
+    // The permission and delegation checks above therefore run *before*
+    // cfx5's register decode (m16-gem5-024); every other cg8 rc is still
+    // CFXREG inside cacheRegRead (CACHE-04).
+    if (cfxha == CfxhaCache && cg == 8) {
+        cacheRegRead(tc, s, cg, rc, out, info);
+        return true;
+    }
+
+    if (cg == 15 && cfxha == CfxhaPmem) {
+        uint64_t value = 0;
+        if (!dmaRegRead(s, rc, &value)) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        out = value;
+        return true;
+    }
+    if (cg == 10 && cfxha == CfxhaTime) {
+        uint64_t value = 0;
+        if (!timeRegRead(s, rc, &value)) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        out = value;
+        return true;
+    }
+    if (cg == 8 && cfxha == CfxhaHart) {
+        uint64_t value = 0;
+        if (!hartRegRead(s, rc, &value)) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        out = value;
+        return true;
+    }
+    if (cg == 7) {
+        out = cg7SpaceReg(s, cfxha, rc);
+        return true;
+    }
+
+    uint64_t *p = cfxRegPtr(s, ci, cg, rc, false);
+    if (p == nullptr) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+    out = *p;
+    return true;
+}
+
+bool
+nodeCfxWrite(ThreadContext *tc, NodeState &s, uint8_t cfxha, uint8_t cg,
+             uint8_t rc, uint64_t val, uint64_t instWord)
+{
+    const Addr pc = currentPc(tc);
+    const uint64_t info = instWord;
+
+    if (nodeCfxReserved(cfxha)) {
+        nodeCfxRaise(tc, s, CauseIlli, s.runMode, pc, info);
+        return true;
+    }
+    const int ci = nodeCfxIndex(cfxha);
+    if (ci < 0) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+    if (nodePermDenied(s, cfxha, 2)) {
+        nodeCfxRaise(tc, s, CauseCfxPerm | SubNcfxPerm, s.runMode, pc,
+                     info);
+        return true;
+    }
+    if (delegDenied(s, ci, cg)) {
+        nodeCfxRaise(tc, s, CauseCfxPerm | SubNcfxPerm, s.runMode, pc,
+                     info);
+        return true;
+    }
+    // cfx_cache (cfx5) cg8 register face, after the two-axis checks; other cg
+    // values keep the generic rows (m16-gem5-024, contract-see §3).
+    if (cfxha == CfxhaCache && cg == 8) {
+        cacheRegWrite(tc, s, cg, rc, val, info);
+        return true;
+    }
+
+    if (cg == 15 && cfxha == CfxhaPmem) {
+        if (!dmaRegWrite(tc, s, rc, val)) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        return true;
+    }
+    if (cg == 10 && cfxha == CfxhaTime) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+    if (cg == 8 && cfxha == CfxhaHart) {
+        if (!hartRegWrite(tc, s, rc, val)) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        return true;
+    }
+    if (cg == 7) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+
+    uint64_t *p = cfxRegPtr(s, ci, cg, rc, true);
+    if (p == nullptr) {
+        nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+        return true;
+    }
+
+    if (p == &s.ptbr) {
+        s.ptbr = val & NodePtbrMask;
+    } else if (p == &s.ptwEnable) {
+        s.ptwEnable = val & 1ULL;
+    } else if (p == &s.tlbAsid) {
+        s.tlbAsid = val & 0xFFFFULL;
+    } else if (p == &s.tlbStart) {
+        s.tlbStart = val & NodeVaMask;
+    } else if (p == &s.tlbSize) {
+        s.tlbSize = val & NodeVaMask;
+    } else if (p == &s.tlbControl) {
+        uint64_t errPa = 0;
+        const int ret = tlbControlExec(s, val, &errPa);
+        if (ret == 1) {
+            nodeCfxRaise(tc, s, CauseCfxReg, s.runMode, pc, info);
+            return true;
+        }
+        if (ret == 2) {
+            nodeCfxRaise(tc, s, CauseCfxMem | SubAdwbFail, s.runMode, pc,
+                         errPa);
+            return true;
+        }
+    } else if (cg == 3 && rc == 12) {
+        *p = val | (1ULL << 3);
+    } else {
+        *p = val;
+    }
+    return true;
+}
