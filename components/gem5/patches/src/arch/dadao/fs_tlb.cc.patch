new file mode 100644
index 0000000..e6c75ef
--- /dev/null
+++ b/src/arch/dadao/fs_tlb.cc
@@ -0,0 +1,105 @@
+// DADAO FS TLB -- identity translation with Machine-v5-Tiny segment rules.
+#include "arch/dadao/fs_tlb.hh"
+
+#include "arch/dadao/fs_machine.hh"
+#include "arch/dadao/isa.hh"
+#include "arch/dadao/tiny_cfx.hh"
+#include "cpu/thread_context.hh"
+#include "sim/faults.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+Fault
+FsTLB::translate(const RequestPtr &req, ThreadContext *tc,
+                 BaseMMU::Mode mode) const
+{
+    const Addr vaddr = req->getVaddr();
+    const Addr size = req->getSize();
+
+    // Instruction fetch must be 4-byte aligned (IALIGN).  gem5 masks the
+    // fetch address to the decoder alignment before the request; the
+    // unmodified instruction address is carried as req->pc.
+    const Addr instPc = (tc != nullptr) ? tc->pcState().instAddr() : 0;
+    if (mode == BaseMMU::Execute) {
+        const Addr pc = req->hasPC() ? req->getPC() : MaxAddr;
+        const Addr ip = (pc != MaxAddr) ? pc : vaddr;
+        if ((vaddr & 0x3) != 0 || (pc != MaxAddr && (pc & 0x3) != 0)) {
+            // spec/Machine-v5 §4.4: the illegal IP is both the faulting IP
+            // and the recorded cause_ip/cause_info (no next-IP write-back).
+            return machineFaultAt(FaultIALIGN, ip, ip);
+        }
+    }
+
+    const bool rom = inSegment(romBase, romSize, vaddr, size);
+    const bool sram = inSegment(sramBase, sramSize, vaddr, size);
+    const bool hmon = inSegment(hmonBase, hmonSize, vaddr, size);
+
+    if (!rom && !sram && !hmon) {
+        // Any other address (addr[47:42] == 0, the gap, cfxha 63 outside the
+        // BootROM/SRAM, or cfxha 3 outside the hmon SRAM) is CFXMEM on both
+        // the fetch and the data path (spec/Machine-v5 §1.2).
+        const Addr ip = (mode == BaseMMU::Execute) ? vaddr : instPc;
+        return machineFaultAt(FaultCFXMEM, ip, vaddr);
+    }
+
+    if (rom && mode == BaseMMU::Write) {
+        // BootROM is read/execute only; a store is ILLI (ADR-0004 D5.6).
+        return machineFaultAt(FaultILLI, instPc, vaddr);
+    }
+
+    // Direct ld/st/fetch into an implemented cfx's internal space is subject
+    // to the cfxmem / cfxexe source masks (two-axis permission, ADR-0045 D6):
+    // a denial is CFXPERM, not CFXMEM.
+    if (tc != nullptr) {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        const int kind = (mode == BaseMMU::Execute) ? 3 : 1;
+        if (isa != nullptr && isa->tinyState().active &&
+            tinyAccessDenied(isa->tinyState(), vaddr, kind)) {
+            return machineFaultAt(FaultCfxPerm, instPc, vaddr);
+        }
+    }
+
+    req->setPaddr(vaddr);
+    return NoFault;
+}
+
+void
+FsTLB::demapPage(Addr vaddr, uint64_t asn)
+{
+    // No TLB entries: identity translation is recomputed every access.
+}
+
+Fault
+FsTLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
+                       BaseMMU::Mode mode)
+{
+    return translate(req, tc, mode);
+}
+
+void
+FsTLB::translateTiming(const RequestPtr &req, ThreadContext *tc,
+                       BaseMMU::Translation *translation, BaseMMU::Mode mode)
+{
+    translation->finish(translate(req, tc, mode), req, tc, mode);
+}
+
+Fault
+FsTLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
+                           BaseMMU::Mode mode)
+{
+    return translate(req, tc, mode);
+}
+
+Fault
+FsTLB::finalizePhysical(const RequestPtr &req, ThreadContext *tc,
+                        BaseMMU::Mode mode) const
+{
+    return NoFault;
+}
+
+} // namespace DadaoISA
+} // namespace gem5
