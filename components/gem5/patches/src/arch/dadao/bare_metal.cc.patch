+{
+BareMetal::BareMetal(const Params &p) : Workload(p)
+{
+    if (p.application.empty())
+        return;
+
+    application.reset(loader::createObjectFile(p.application));
+    fatal_if(!application, "Cannot parse DADAO ELF %s", p.application);
+    fatal_if(application->getArch() != loader::Dadao,
+            "ELF %s is not a valid DADAO object", p.application);
+    fatal_if(application->getByteOrder() != ByteOrder::big,
+            "DADAO ELF %s is not big-endian", p.application);
+
+    const Addr ram_base = p.ram_base;
+    const uint64_t ram_size = p.ram_size;
+    auto in_ram = [ram_base, ram_size](Addr base, uint64_t size) {
+        return base >= ram_base && size <= ram_size &&
+               base - ram_base <= ram_size - size;
+    };
+
+    applicationImage = application->buildImage();
+    fatal_if(applicationImage.segments().empty(),
+            "DADAO ELF %s has no PT_LOAD segments", p.application);
+    for (const auto &segment : applicationImage.segments()) {
+        fatal_if(!in_ram(segment.base, segment.size),
+                "DADAO ELF segment %s [%#x, %#x) is outside Machine-01 RAM",
+                segment.name, segment.base, segment.base + segment.size);
+    }
+    fatal_if(!in_ram(application->entryPoint(), 1),
+            "DADAO ELF entry %#x is outside Machine-01 RAM",
+            application->entryPoint());
+    symbols = application->symtab();
+}
+
+void
+BareMetal::initState()
+{
+    Workload::initState();
+    const auto &p = params();
+    std::ifstream image(p.bootrom, std::ios::binary);
+    fatal_if(!image, "Cannot open DADAO boot ROM %s", p.bootrom);
+    const std::vector<uint8_t> bytes{
+        std::istreambuf_iterator<char>(image), std::istreambuf_iterator<char>()};
+    fatal_if(bytes.empty() || bytes.size() > 65536,
+            "DADAO boot ROM must contain 1..65536 bytes");
+    system->physProxy.writeBlob(p.image_addr, bytes.data(), bytes.size());
+    fatal_if(application && !applicationImage.write(system->physProxy),
+            "Could not load DADAO ELF PT_LOAD segments");
+
+    for (auto *tc : system->threads) {
+        tc->pcState(PCState(p.initial_pc));
+        tc->setReg(floatRegClass[0], FcsrReset);
+        tc->setReg(intRegClass[int_reg::RbBase], p.initial_pc);
+        tc->setReg(intRegClass[int_reg::RdBase + 1], p.initial_rd1);
+        tc->activate();
+    }
+}
+
+uint64_t
+BareMetal::readRd(unsigned index) const
+{
+    fatal_if(index >= 64, "DADAO rd index out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->getReg(intRegClass[int_reg::RdBase + index]);
+}
+
+void
+BareMetal::writeRd(unsigned index, uint64_t value)
+{
+    fatal_if(index == 0 || index >= 64, "DADAO rd destination out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    (*system->threads.begin())->setReg(intRegClass[int_reg::RdBase + index],
+            value);
+}
+
+uint64_t
+BareMetal::readRb(unsigned index) const
+{
+    fatal_if(index >= 64, "DADAO rb index out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->getReg(intRegClass[int_reg::RbBase + index]);
+}
+
+void
+BareMetal::writeRb(unsigned index, uint64_t value)
+{
+    fatal_if(index == 0 || index >= 64, "DADAO rb destination out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    (*system->threads.begin())->setReg(intRegClass[int_reg::RbBase + index],
+            value);
+}
+
+uint64_t
+BareMetal::readRa(unsigned index) const
+{
+    fatal_if(index >= 64, "DADAO ra index out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->getReg(intRegClass[int_reg::RaBase + index]);
+}
+
+void
+BareMetal::writeRa(unsigned index, uint64_t value)
+{
+    fatal_if(index >= 64, "DADAO ra destination out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    if (index == 0)
+        value &= 0x003fffffffffffffULL;
+    (*system->threads.begin())->setReg(intRegClass[int_reg::RaBase + index],
+            value);
+}
+
+uint64_t
+BareMetal::readRf(unsigned index) const
+{
+    fatal_if(index >= 64, "DADAO rf index out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->getReg(floatRegClass[index]);
+}
+
+uint64_t
+BareMetal::readMemory(Addr address, unsigned size) const
+{
+    fatal_if(size != 1 && size != 2 && size != 4 && size != 8,
+            "DADAO memory read size must be 1, 2, 4, or 8");
+    uint8_t bytes[8] = {};
+    system->physProxy.readBlob(address, bytes, size);
+    uint64_t value = 0;
+    for (unsigned i = 0; i < size; ++i)
+        value = (value << 8) | bytes[i];
+    return value;
+}
+
+void
+BareMetal::writeMemory(Addr address, uint64_t value, unsigned size)
+{
+    fatal_if(size != 1 && size != 2 && size != 4 && size != 8,
+            "DADAO memory write size must be 1, 2, 4, or 8");
+    uint8_t bytes[8] = {};
+    for (unsigned i = 0; i < size; ++i)
+        bytes[size - i - 1] = value >> (i * 8);
+    system->physProxy.writeBlob(address, bytes, size);
+}
+
+uint64_t
+BareMetal::readMode() const
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->readMiscRegNoEffect(misc_reg::Mode);
+}
+
+uint64_t
+BareMetal::readFcsr() const
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->readMiscRegNoEffect(misc_reg::Fcsr);
+}
+
+void
+BareMetal::writeFcsr(uint64_t value)
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    (*system->threads.begin())->setMiscRegNoEffect(misc_reg::Fcsr, value);
+}
+
+void
+BareMetal::writeRf0(uint64_t value)
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *tc = *system->threads.begin();
+    tc->setReg(floatRegClass[0], FcsrReset | (value & FcsrWritable));
+}
+
+Addr
+BareMetal::readPc() const
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    return (*system->threads.begin())->pcState().instAddr();
+}
+
+void
+BareMetal::setPc(Addr value)
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *tc = *system->threads.begin();
+    tc->pcState(PCState(value));
+    tc->setReg(intRegClass[int_reg::RbBase], value);
+}
+
+void
+BareMetal::setMode(uint64_t value)
+{
+    fatal_if(value > 3, "DADAO mode out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    (*system->threads.begin())->setMiscRegNoEffect(misc_reg::Mode, value);
+}
+
+void
+BareMetal::setCurrentCfx(uint64_t value)
+{
+    fatal_if(value >= 64, "DADAO cfx code out of range");
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *isa = dynamic_cast<ISA *>((*system->threads.begin())->getIsaPtr());
+    fatal_if(!isa, "DADAO ISA unavailable");
+    isa->setCurrentCfx(value);
+}
+
+uint64_t
+BareMetal::readCurrentCfx() const
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *isa = dynamic_cast<ISA *>((*system->threads.begin())->getIsaPtr());
+    fatal_if(!isa, "DADAO ISA unavailable");
+    return isa->getCurrentCfx();
+}
+
+uint64_t
+BareMetal::readCfxReg(unsigned cfx, unsigned cg, unsigned rc) const
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *isa = dynamic_cast<ISA *>((*system->threads.begin())->getIsaPtr());
+    fatal_if(!isa, "DADAO ISA unavailable");
+    return isa->readCfxReg(cfx, cg, rc);
+}
+
+void
+BareMetal::writeCfxReg(
+        unsigned cfx, unsigned cg, unsigned rc, uint64_t value)
+{
+    fatal_if(system->threads.empty(), "DADAO has no thread");
+    auto *isa = dynamic_cast<ISA *>((*system->threads.begin())->getIsaPtr());
+    fatal_if(!isa, "DADAO ISA unavailable");
+    isa->writeCfxReg(cfx, cg, rc, value);
+}
