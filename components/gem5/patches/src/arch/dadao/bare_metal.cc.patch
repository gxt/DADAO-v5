+#include "arch/dadao/bare_metal.hh"
+
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+#include "arch/dadao/pcstate.hh"
+#include "arch/dadao/regs/float.hh"
+#include "arch/dadao/regs/int.hh"
+#include "arch/dadao/regs/misc.hh"
