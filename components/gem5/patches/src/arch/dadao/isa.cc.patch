+// cfxha order of the fixed register dump (spec/DADAO-12 §1).
+constexpr int kTraceCfxha[9] = {0, 1, 2, 3, 4, 15, 32, 34, 63};
+
+/** Runtime inputs of one dynamic cycle row (m16-gem5-004).  False means the
+ *  class has no executable model in this milestone (memory ranges); the hook
+ *  then keeps the one-cycle placeholder instead of guessing. */
+bool
+fillDynamicState(const DadaoISAInst::DadaoInst &inst,
+                 const wuming::CycleRow &row, ThreadContext *tc, Addr instAddr,
+                 wuming::DynamicState &state)
+{
+    const std::string_view dyn(row.dynamic);
+    const std::string_view mnemonic(row.mnemonic);
+    if (dyn == "ras-kind") {
+        // `state.rasMem` is set by the hook from the MRPTR before/after diff;
+        // a shallow stack uses RegRAS even though MRPTR is non-zero.
+        return tc != nullptr;
+    }
+    if (dyn == "trap-target")
+        return inst.fieldValue("immu18", state.immu18) &&
+               inst.fieldValue("cfxha", state.cfxha);
+    if (dyn == "range") {
+        if (mnemonic == "escape")
+            return inst.fieldValue("imms18", state.imms18);
+        // C class (one `ld`/`st`): the model evaluates the document's solved
+        // element+beat model at one element, which needs no runtime input
+        // (m16-gem5-006; see wuming_latency.hh |dynamicCycles|).
+        return wuming::memoryRow(row);
+    }
+    if (dyn == "exponent-diff") {
+        if (tc == nullptr)
+            return false;
+        uint64_t reg1 = 0, reg2 = 0;
+        if (!inst.fieldValue("rfhc", reg1) || !inst.fieldValue("rfhd", reg2))
+            return false;
+        const RegVal a =
+            tc->getReg(RegId(floatRegClass, static_cast<RegIndex>(reg1)));
+        const RegVal b =
+            tc->getReg(RegId(floatRegClass, static_cast<RegIndex>(reg2)));
+        state.expDiff = wuming::fpExponentDiff(a, b, mnemonic == "forem");
+        return true;
+    }
+    if (dyn == "N" || dyn == "beats") {
+        // Block transfer (D ldm/stm, D′ register copy): the element count is
+        // the decoded immu6 field (1..63, already legality-checked), so the
+        // policy can expand one cycle per element (plus, for the memory forms,
+        // one bus beat per 8-byte element group).  Only the timing is
+        // per-element; execute() still moves the whole block as one
+        // StaticInst, so simInsts counts one instruction per architectural
+        // instruction (see DadaoISA.py).
+        uint64_t count = 0;
+        if (!inst.fieldValue("immu6", count))
+            return false;
+        state.elements = static_cast<unsigned>(count);
+        if ((row.classMask & wuming::kDClassMask) == 0)
+            return true; // D′ register copy: instruction-side only, no beats
+        // D memory forms: the bus beats are counted from the group's start
+        // address (m16-gem5-018), so the policy needs the EA.  It is the same
+        // EA the exec core forms -- rb[rbhb] + rd[rdhc] (SimRISC-01 §1/§2) --
+        // and both registers still hold their pre-instruction values here:
+        // `ldm` rejects a destination block that overlaps its address
+        // register, and `stm` writes no register at all.  `rb0` is not a
+        // register but the current IP, which is why the hook is handed the
+        // address of the instruction that just executed.
+        if (tc == nullptr)
+            return false;
+        uint64_t base = 0, off = 0;
+        if (!inst.fieldValue("rbhb", base) || !inst.fieldValue("rdhc", off))
+            return false;
+        if (base >= 64 || off >= 64)
+            return false;
+        const RegVal baseValue =
+            base == 0
+                ? instAddr
+                : tc->getReg(RegId(intRegClass,
+                                   int_reg::RbBase +
+                                       static_cast<RegIndex>(base)));
+        const RegVal offValue =
+            off == 0 ? 0
+                     : tc->getReg(RegId(intRegClass,
+                                        int_reg::RdBase +
+                                            static_cast<RegIndex>(off)));
+        // The group's start EA.  The policy only reads its low three bits
+        // (the beat phase); the exec core's 48-bit virtual wrap (exec/b1.cc)
+        // is a multiple of 8, so it cannot change them.
+        state.addr = baseValue + offValue;
+        return true;
+    }
+    return true; // mul-config: the optional TimingExpr is handled by the hook
+}
