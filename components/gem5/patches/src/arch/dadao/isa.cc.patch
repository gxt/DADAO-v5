+RegClass vecRegClass(VecRegClass, VecRegClassName, 1, debug::VecRegs);
+RegClass vecElemClass(VecElemClass, VecElemClassName, 1, debug::VecRegs);
+RegClass vecPredRegClass(VecPredRegClass, VecPredRegClassName, 1,
+        debug::VecPredRegs);
+RegClass matRegClass(MatRegClass, MatRegClassName, 0, debug::MatRegs);
+RegClass ccRegClass(CCRegClass, CCRegClassName, 0, debug::CCRegs);
+
+// cfxha order of the fixed register dump (spec/DADAO-12 §1).
+constexpr int kTraceCfxha[9] = {0, 1, 2, 3, 4, 15, 32, 34, 63};
+
+} // anonymous namespace
+
+ISA::ISA(const Params &p) : BaseISA(p, "dadao")
+{
+    _regClasses = {&intRegClass, &floatRegClass, &vecRegClass,
+        &vecElemClass, &vecPredRegClass, &matRegClass, &ccRegClass,
+        &miscRegClass};
+}
+
+ISA::~ISA()
+{
+    nodeFreeEvents(node);
+    if (traceFile != nullptr)
+        std::fclose(traceFile);
+}
+
+void
+ISA::clear()
+{
+    // Architectural GPRs are cleared by the CPU's register file reset; the
+    // only ISA-private state is the B6 reservation slot.
+    clearReservations();
+}
+
+std::vector<ISA *> ISA::holders;
+
+void
+ISA::setReservation(Addr addr, unsigned width)
+{
+    if (!reservationValid)
+        holders.push_back(this);
+    reservationValid = true;
+    reservationAddr = addr;
+    reservationWidth = width;
+}
+
+bool
+ISA::hasReservation(Addr addr, unsigned width) const
+{
+    return reservationValid && reservationAddr == addr &&
+           reservationWidth == width;
+}
+
+void
+ISA::clearReservations()
+{
+    if (reservationValid) {
+        for (auto it = holders.begin(); it != holders.end(); ++it) {
+            if (*it == this) {
+                holders.erase(it);
+                break;
+            }
+        }
+    }
+    reservationValid = false;
+    reservationAddr = 0;
+    reservationWidth = 0;
+}
+
+bool
+ISA::anyReservationHeld()
+{
+    return !holders.empty();
+}
+
+const std::vector<ISA *> &
+ISA::reservationHolders()
+{
+    return holders;
+}
+
+RegVal
+ISA::readMiscRegNoEffect(RegIndex idx) const
+{
+    panic("DADAO B0: misc register %d read before the cfx/mode model",
+          idx);
+    return 0; // unreachable; panic is not marked [[noreturn]]
+}
+
+RegVal
+ISA::readMiscReg(RegIndex idx)
+{
+    return readMiscRegNoEffect(idx);
+}
+
+void
+ISA::setMiscRegNoEffect(RegIndex idx, RegVal val)
+{
+    panic("DADAO B0: misc register %d write (%#x) before the cfx model",
+          idx, val);
+}
+
+void
+ISA::setMiscReg(RegIndex idx, RegVal val)
+{
+    setMiscRegNoEffect(idx, val);
+}
+
+bool
+ISA::inUserMode() const
+{
+    // G1 SE runs user code only; the Tiny FS machine runs in its nominal
+    // hypv/cfxha-63 mode and has no path into user mode.  The Node machine
+    // reports the current run mode.
+    if (isFsMachine(tc)) {
+        if (node.active)
+            return (node.runMode & 0x3) == NodeUser;
+        return false;
+    }
+    return true;
+}
+
+void
+ISA::traceInstruction(Addr pc, unsigned mode, bool control)
+{
+    if (traceFile == nullptr)
+        return;
+
+    const bool dump = !traceStarted || tracePrevControl || node.traceForce ||
+                      pc != tracePrevPc + 4;
+    traceStarted = true;
+    tracePrevPc = pc;
+    tracePrevControl = control;
+    node.traceForce = false;
+    if (!dump)
+        return;
+
+    // QEMU `-d cpu` compatible state dump (the arch drivers parse these lines
+    // verbatim; fields are spec/DADAO-12 §3 registers plus PTW state).
+    std::FILE *f = traceFile;
+    auto rd = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass, int_reg::RdBase + i)));
+    };
+    auto rb = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass, int_reg::RbBase + i)));
+    };
+    auto ra = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass, int_reg::RaBase + i)));
+    };
+    auto rf = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(floatRegClass, i)));
+    };
+
+    std::fprintf(f, "\nPC: %016llx\n\n",
+                 static_cast<unsigned long long>(pc));
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RD[%02d]: %016llx  ", i, i == 0 ? 0ULL : rd(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RB[%02d]: %016llx  ", i, i == 0 ? pc : rb(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RF[%02d]: %016llx  ", i, rf(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RA[%02d]: %016llx  ", i, ra(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+
+    std::fprintf(f, "MODE: %u\n", mode);
+    std::fprintf(f, "CFXCODE: %u\n", unsigned(node.cfxCode));
+    std::fprintf(f, "PTBR: %016llx PTW_ENABLE: %u\n",
+                 static_cast<unsigned long long>(node.ptbr),
+                 unsigned(node.ptwEnable & 1));
+    std::fprintf(f, "TLBASID: %04llx TLBSTART: %016llx TLBSIZE: %016llx\n",
+                 static_cast<unsigned long long>(node.tlbAsid & 0xFFFF),
+                 static_cast<unsigned long long>(node.tlbStart),
+                 static_cast<unsigned long long>(node.tlbSize));
+
+    for (int i = 0; i < 9; ++i) {
+        const NodeCfxRegs &r = node.cfx[i];
+        const int ha = kTraceCfxha[i];
+        std::fprintf(f, "CFX%02d ID:%016llx VER:%016llx TRAPN:%016llx "
+                     "SYNCN:%016llx ASYNCN:%016llx ESCN:%016llx SCRN:%016llx "
+                     "GIM:%016llx\n", ha,
+                     static_cast<unsigned long long>(r.cfxId),
+                     static_cast<unsigned long long>(r.version),
+                     static_cast<unsigned long long>(r.trapNum),
+                     static_cast<unsigned long long>(r.excpSyncNum),
+                     static_cast<unsigned long long>(r.excpAsyncNum),
+                     static_cast<unsigned long long>(r.escapeNum),
+                     static_cast<unsigned long long>(r.scratchRegsNum),
+                     static_cast<unsigned long long>(r.globalCfxIntrMask));
+        std::fprintf(f, "CFX%02d PREVM:%016llx CID:%016llx "
+                     "CIP:%016llx CINFO:%016llx PEND:%016llx\n", ha,
+                     static_cast<unsigned long long>(r.prevRunMode),
+                     static_cast<unsigned long long>(r.causeId),
+                     static_cast<unsigned long long>(r.causeIp),
+                     static_cast<unsigned long long>(r.causeInfo),
+                     static_cast<unsigned long long>(r.pending));
+        for (int m = 0; m < 4; ++m) {
+            const NodeCfxMode &mr = r.mode[m];
+            std::fprintf(f, "CFX%02d M%d SWMODE:%016llx "
+                         "VEC:%016llx TRAPMASK:%016llx MEMMASK:%016llx "
+                         "REGMASK:%016llx EXEMASK:%016llx INTRMASK:%016llx\n",
+                         ha, m,
+                         static_cast<unsigned long long>(mr.switchRunMode),
+                         static_cast<unsigned long long>(mr.excpVector),
+                         static_cast<unsigned long long>(mr.cfxtrap),
+                         static_cast<unsigned long long>(mr.cfxmem),
+                         static_cast<unsigned long long>(mr.cfxreg),
+                         static_cast<unsigned long long>(mr.cfxexe),
+                         static_cast<unsigned long long>(mr.cfxIntrMask));
+        }
+        for (int j = 0; j < 4; ++j) {
+            std::fprintf(f, "CFX%02d SCR%d:%016llx\n", ha, j,
+                         static_cast<unsigned long long>(r.scratch[j]));
+        }
+    }
+    std::fprintf(f, "\n");
+    std::fflush(f);
+}
+
+void
+ISA::resetThread()
+{
+    FsWorkload *fs = asFsWorkload(tc);
+    panic_if(fs == nullptr,
+             "DADAO ISA: resetThread() is only valid for the FS machine");
+
+    // Reset values frozen by spec/Machine-v5 §1: PC = rb0 = reset vector,
+    // every other GPR/RA is zero, rf0 is the FCSR reset constant (GEM5-014t
+    // §3) and rf1-rf63 are zero.  The platform never pre-sets SP.
+    for (const auto &id : intRegClass)
+        tc->setReg(id, RegVal(0));
+    for (const auto &id : floatRegClass)
+        tc->setReg(id, RegVal(0));
+
+    tc->setReg(RegId(floatRegClass, 0), 0x7FF800007FC00000ULL);
+    tc->pcState(PCState(fs->getEntry()));
+    clearReservations();
+
+    if (fs->nodeProfile()) {
+        nodeResetState(node, tc, fs->romBase(), fs->romSize(), fs->ramBase(),
+                       fs->ramSize(), fs->pmemBase());
+        tiny = TinyState();
+    } else {
+        node.active = false;
+        tinyResetState(tiny, tc, fs->romBase(), fs->romSize(),
+                       fs->sramBase(), fs->sramSize(), fs->hmonBase(),
+                       fs->hmonSize());
+    }
+
+    if (traceFile == nullptr && !fs->traceCpuPath().empty()) {
+        traceFile = std::fopen(fs->traceCpuPath().c_str(), "w");
+        fatal_if(traceFile == nullptr, "DADAO ISA: cannot open --trace-cpu %s",
+                 fs->traceCpuPath());
+    }
+}
+
+void
+ISA::copyRegsFrom(ThreadContext *src)
+{
+    for (const auto &id : intRegClass)
+        tc->setReg(id, src->getReg(id));
+    for (const auto &id : floatRegClass)
+        tc->setReg(id, src->getReg(id));
+    tc->pcState(src->pcState());
+}
