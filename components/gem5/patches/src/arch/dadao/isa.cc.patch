+
+ISA::ISA(const Params &p)
+    : BaseISA(p, "dadao"),
+      ADD_STAT(dataMemReads,
+               "guest data-memory reads retired by the exec cores"),
+      ADD_STAT(dataMemWrites,
+               "guest data-memory writes retired by the exec cores"),
+      wumingCycles(p.enable_wuming_cycles),
+      wumingMulExpr(p.wuming_mul_expr),
+      cfxITagsStore(p.cfx_itags),
+      cfxDTagsStore(p.cfx_dtags)
+{
+    _regClasses = {&intRegClass, &floatRegClass, &vecRegClass,
+        &vecElemClass, &vecPredRegClass, &matRegClass, &ccRegClass,
+        &miscRegClass};
+}
+
+ISA::~ISA()
+{
+    nodeFreeEvents(node);
+    if (traceFile != nullptr)
+        std::fclose(traceFile);
+}
+
+void
+ISA::clear()
+{
+    // Architectural GPRs are cleared by the CPU's register file reset; the
+    // ISA-private state is the B6 reservation slot and the hidden RegRAS ring
+    // base (reset 0, ADR-0012 D7.5).
+    clearReservations();
+    rasBaseIdx = 0;
+}
+
+void
+ISA::serialize(CheckpointOut &cp) const
+{
+    BaseISA::serialize(cp);
+    // The RA register file is saved by the thread context as physical slots,
+    // so the ring base must be saved with it or a restore would reinterpret
+    // the logical view (ADR-0012 D7.5).
+    SERIALIZE_SCALAR(rasBaseIdx);
+}
+
+void
+ISA::unserialize(CheckpointIn &cp)
+{
+    BaseISA::unserialize(cp);
+    UNSERIALIZE_SCALAR(rasBaseIdx);
+    panic_if(rasBaseIdx >= 63,
+             "DADAO ISA: checkpoint RegRAS ring base %u is outside 0..62",
+             rasBaseIdx);
+}
+
+std::vector<ISA *> ISA::holders;
+
+void
+ISA::setReservation(Addr addr, unsigned width)
+{
+    if (!reservationValid)
+        holders.push_back(this);
+    reservationValid = true;
+    reservationAddr = addr;
+    reservationWidth = width;
+}
+
+bool
+ISA::hasReservation(Addr addr, unsigned width) const
+{
+    return reservationValid && reservationAddr == addr &&
+           reservationWidth == width;
+}
+
+void
+ISA::clearReservations()
+{
+    if (reservationValid) {
+        for (auto it = holders.begin(); it != holders.end(); ++it) {
+            if (*it == this) {
+                holders.erase(it);
+                break;
+            }
+        }
+    }
+    reservationValid = false;
+    reservationAddr = 0;
+    reservationWidth = 0;
+}
+
+bool
+ISA::anyReservationHeld()
+{
+    return !holders.empty();
+}
+
+const std::vector<ISA *> &
+ISA::reservationHolders()
+{
+    return holders;
+}
+
+RegVal
+ISA::readMiscRegNoEffect(RegIndex idx) const
+{
+    panic("DADAO B0: misc register %d read before the cfx/mode model",
+          idx);
+    return 0; // unreachable; panic is not marked [[noreturn]]
+}
+
+RegVal
+ISA::readMiscReg(RegIndex idx)
+{
+    return readMiscRegNoEffect(idx);
+}
+
+void
+ISA::setMiscRegNoEffect(RegIndex idx, RegVal val)
+{
+    panic("DADAO B0: misc register %d write (%#x) before the cfx model",
+          idx, val);
+}
+
+void
+ISA::setMiscReg(RegIndex idx, RegVal val)
+{
+    setMiscRegNoEffect(idx, val);
+}
+
+bool
+ISA::inUserMode() const
+{
+    // G1 SE runs user code only; the Tiny FS machine runs in its nominal
+    // hypv/cfxha-63 mode and has no path into user mode.  The Node machine
+    // reports the current run mode.
+    if (isFsMachine(tc)) {
+        if (node.active)
+            return (node.runMode & 0x3) == NodeUser;
+        return false;
+    }
+    return true;
+}
+
+Cycles
+ISA::extraExecLatency(const StaticInst *inst) const
+{
+    if (!wumingCycles || inst == nullptr)
+        return Cycles(0);
+
+    // The hook is handed the generic StaticInst; only DADAO instructions carry
+    // a contract id, and anything else keeps the upstream one-cycle model.
+    const auto *dadao = dynamic_cast<const DadaoISAInst::DadaoInst *>(inst);
+    if (dadao == nullptr)
+        return Cycles(0);
+    const char *id = dadao->contractId();
+    if (id == nullptr)
+        return Cycles(0);
+    const wuming::CycleRow *row = wuming::byId(std::string_view(id));
+    if (row == nullptr)
+        return Cycles(0);
+
+    // RAS kind: the document's MemRAS figures are the overflow/underflow
+    // paths, i.e. the call/ret that actually touched MemRAS.  Compare the
+    // architectural MRPTR before and after the instruction instead of merely
+    // testing MRPTR != 0 (a shallow stack still uses RegRAS).
+    uint64_t mrptr = 0;
+    bool rasHistory = false;
+    if (tc != nullptr) {
+        const RegVal ra0 = tc->getReg(RegId(intRegClass, int_reg::RaBase));
+        mrptr = ra0 & 0x0000ffffffffffffULL;
+        rasHistory = wumingRasSeen;
+    }
+    const bool mrptrDropped = rasHistory && mrptr < wumingLastMrptr;
+    const bool mrptrGrew = rasHistory && mrptr > wumingLastMrptr;
+
+    unsigned total = 0;
+    const std::string_view dyn(row->dynamic);
+    const std::string_view mnemonic(row->mnemonic);
+    if (wuming::provisional(*row)) {
+        // Provisional rows (推断 / 未测 / 待实测, user ruling 2026-11-14) never
+        // drive the timing model: gem5 keeps its one-cycle execute()
+        // placeholder.  The RAS bookkeeping below still runs so that a later
+        // call/ret sees the same MRPTR sequence it saw before this gate.
+        total = 0;
+    } else if (dyn == "mul-config" && wumingMulExpr != nullptr) {
+        // B1/B2 latency is a hardware configuration (R2): evaluate the gem5
+        // TimingExpr the platform attached (m16-gem5-004 uses a literal 1/2/3).
+        StaticInstPtr self(const_cast<StaticInst *>(inst));
+        TimingExprEvalContext context(self, tc, nullptr);
+        total = static_cast<unsigned>(wumingMulExpr->eval(context));
+    } else if (mnemonic == "swym") {
+        uint64_t immu18 = 0;
+        if (dadao->fieldValue("immu18", immu18))
+            total = wuming::swymCycles(*row, immu18);
+    } else if (!dyn.empty()) {
+        wuming::DynamicState state;
+        state.rasMem = mnemonic == "call" ? mrptrDropped
+                     : mnemonic == "ret"  ? mrptrGrew : false;
+        if (fillDynamicState(*dadao, *row, tc, wumingInstAddr, state))
+            total = wuming::dynamicCycles(*row, state);
+    } else {
+        total = wuming::staticCycles(*row);
+    }
+
+    if (tc != nullptr) {
+        wumingLastMrptr = mrptr;
+        wumingRasSeen = true;
+    }
+    return Cycles(wuming::extraFromTotal(total));
+}
+
+void
+ISA::traceInstruction(Addr pc, unsigned mode, bool control)
+{
+    if (traceFile == nullptr)
+        return;
+
+    const bool dump = !traceStarted || tracePrevControl || node.traceForce ||
+                      pc != tracePrevPc + 4;
+    traceStarted = true;
+    tracePrevPc = pc;
+    tracePrevControl = control;
+    node.traceForce = false;
+    if (!dump)
+        return;
+
+    // QEMU `-d cpu` compatible state dump (the arch drivers parse these lines
+    // verbatim; fields are spec/DADAO-12 §3 registers plus PTW state).
+    std::FILE *f = traceFile;
+    auto rd = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass, int_reg::RdBase + i)));
+    };
+    auto rb = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass, int_reg::RbBase + i)));
+    };
+    auto ra = [&](int i) {
+        // Architectural (logical) view over the hidden ring base: the same
+        // dump QEMU emits, so a full 64-slot compare is layout-independent
+        // (ADR-0012 D7.5).
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(intRegClass,
+                             int_reg::RaBase + DadaoISA::exec::ras::phys(
+                                 rasBaseIdx, unsigned(i)))));
+    };
+    auto rf = [&](int i) {
+        return static_cast<unsigned long long>(
+            tc->getReg(RegId(floatRegClass, i)));
+    };
+
+    std::fprintf(f, "\nPC: %016llx\n\n",
+                 static_cast<unsigned long long>(pc));
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RD[%02d]: %016llx  ", i, i == 0 ? 0ULL : rd(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RB[%02d]: %016llx  ", i, i == 0 ? pc : rb(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RF[%02d]: %016llx  ", i, rf(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+    for (int i = 0; i < 64; ++i) {
+        std::fprintf(f, "RA[%02d]: %016llx  ", i, ra(i));
+        if ((i % 4) == 3)
+            std::fprintf(f, "\n");
+    }
+    std::fprintf(f, "\n");
+
+    std::fprintf(f, "MODE: %u\n", mode);
+    std::fprintf(f, "CFXCODE: %u\n", unsigned(node.cfxCode));
+    std::fprintf(f, "PTBR: %016llx PTW_ENABLE: %u\n",
+                 static_cast<unsigned long long>(node.ptbr),
+                 unsigned(node.ptwEnable & 1));
+    std::fprintf(f, "TLBASID: %04llx TLBSTART: %016llx TLBSIZE: %016llx\n",
+                 static_cast<unsigned long long>(node.tlbAsid & 0xFFFF),
+                 static_cast<unsigned long long>(node.tlbStart),
+                 static_cast<unsigned long long>(node.tlbSize));
+
+    for (int i = 0; i < 9; ++i) {
+        const NodeCfxRegs &r = node.cfx[i];
+        const int ha = kTraceCfxha[i];
+        std::fprintf(f, "CFX%02d ID:%016llx VER:%016llx TRAPN:%016llx "
+                     "SYNCN:%016llx ASYNCN:%016llx ESCN:%016llx SCRN:%016llx "
+                     "GIM:%016llx\n", ha,
+                     static_cast<unsigned long long>(r.cfxId),
+                     static_cast<unsigned long long>(r.version),
+                     static_cast<unsigned long long>(r.trapNum),
+                     static_cast<unsigned long long>(r.excpSyncNum),
+                     static_cast<unsigned long long>(r.excpAsyncNum),
+                     static_cast<unsigned long long>(r.escapeNum),
+                     static_cast<unsigned long long>(r.scratchRegsNum),
+                     static_cast<unsigned long long>(r.asyncIntrMask));
+        std::fprintf(f, "CFX%02d PREVM:%016llx PREVCFX:%016llx "
+                     "CIP:%016llx PREVIM:%016llx CID:%016llx "
+                     "CINFO:%016llx\n", ha,
+                     static_cast<unsigned long long>(r.prevRunMode),
+                     static_cast<unsigned long long>(r.prevCfxCode),
+                     static_cast<unsigned long long>(r.prevIp),
+                     static_cast<unsigned long long>(r.prevIntrMask),
+                     static_cast<unsigned long long>(r.causeId),
+                     static_cast<unsigned long long>(r.causeInfo));
+        std::fprintf(f, "CFX%02d ESCRM:%016llx ESCCFX:%016llx "
+                     "ESCIP:%016llx ESCIM:%016llx\n", ha,
+                     static_cast<unsigned long long>(r.escapeRunMode),
+                     static_cast<unsigned long long>(r.escapeCfxCode),
+                     static_cast<unsigned long long>(r.escapeIp),
+                     static_cast<unsigned long long>(r.escapeIntrMask));
+        for (int m = 0; m < 4; ++m) {
+            const NodeCfxMode &mr = r.mode[m];
+            std::fprintf(f, "CFX%02d M%d SWMODE:%016llx "
+                         "VEC:%016llx TRAPMASK:%016llx MEMMASK:%016llx "
+                         "REGMASK:%016llx EXEMASK:%016llx\n",
+                         ha, m,
+                         static_cast<unsigned long long>(mr.switchRunMode),
+                         static_cast<unsigned long long>(mr.excpVector),
+                         static_cast<unsigned long long>(mr.cfxtrap),
+                         static_cast<unsigned long long>(mr.cfxmem),
+                         static_cast<unsigned long long>(mr.cfxreg),
+                         static_cast<unsigned long long>(mr.cfxexe));
+        }
+        for (int j = 0; j < 4; ++j) {
+            std::fprintf(f, "CFX%02d SCR%d:%016llx\n", ha, j,
+                         static_cast<unsigned long long>(r.scratch[j]));
+        }
+    }
+    // cfx_hart cg15 async capture buffer (spec/DADAO-12 §4.7).
+    std::fprintf(f, "ASYNC PREVM:%016llx PREVCFX:%016llx CIP:%016llx "
+                 "PREVIM:%016llx FRAME:%016llx PEND:%016llx VEC:%016llx "
+                 "SWM:%016llx\n",
+                 static_cast<unsigned long long>(node.asyncPrevRunMode),
+                 static_cast<unsigned long long>(node.asyncPrevCfxCode),
+                 static_cast<unsigned long long>(node.asyncPrevIp),
+                 static_cast<unsigned long long>(node.asyncPrevIntrMask),
+                 static_cast<unsigned long long>(node.asyncSrcFrame),
+                 static_cast<unsigned long long>(nodeAsyncPendingSummary(node)),
+                 static_cast<unsigned long long>(node.asyncExcpVector),
+                 static_cast<unsigned long long>(node.asyncSwitchRunMode));
+    std::fprintf(f, "\n");
+    std::fflush(f);
+}
+
+void
+ISA::resetThread()
+{
+    FsWorkload *fs = asFsWorkload(tc);
+    panic_if(fs == nullptr,
+             "DADAO ISA: resetThread() is only valid for the FS machine");
+
+    // Reset values frozen by spec/Kaiwu §1: PC = rb0 = reset vector,
+    // every other GPR/RA is zero, rf0 is the FCSR reset constant (GEM5-014t
+    // §3) and rf1-rf63 are zero.  The platform never pre-sets SP.
+    for (const auto &id : intRegClass)
+        tc->setReg(id, RegVal(0));
+    for (const auto &id : floatRegClass)
+        tc->setReg(id, RegVal(0));
+    // All RA data slots are zero and RACNT = 0, so the hidden ring base is
+    // back at its reset value too (ADR-0012 D7.5).
+    rasBaseIdx = 0;
+
+    tc->setReg(RegId(floatRegClass, 0), 0x7FF800007FC00000ULL);
+    tc->pcState(PCState(fs->getEntry()));
+    clearReservations();
+
+    if (fs->nodeProfile()) {
+        // cfx_cache (cfx5) reports the classic L1 caches: bit0 = I, bit1 = D
+        // (contract CACHE-06).  fs.py sets the tag stores only with --caches,
+        // so `cache-model=off` makes cache_exist read 0 while cfx5 itself
+        // stays implemented (CACHE-27 `cache-model` dimension; m16-gem5-023).
+        const uint8_t cacheExist = (cfxITagsStore != nullptr ? 0x1 : 0x0) |
+                                   (cfxDTagsStore != nullptr ? 0x2 : 0x0);
+        nodeResetState(node, tc, fs->romBase(), fs->romSize(), fs->ramBase(),
+                       fs->ramSize(), fs->pmemBase(), cacheExist);
+        tiny = TinyState();
+    } else {
+        node.active = false;
+        tinyResetState(tiny, tc, fs->romBase(), fs->romSize(),
+                       fs->sramBase(), fs->sramSize(), fs->hmonBase(),
+                       fs->hmonSize());
+    }
+
+    if (traceFile == nullptr && !fs->traceCpuPath().empty()) {
+        traceFile = std::fopen(fs->traceCpuPath().c_str(), "w");
+        fatal_if(traceFile == nullptr, "DADAO ISA: cannot open --trace-cpu %s",
+                 fs->traceCpuPath());
+    }
+}
+
+void
+ISA::copyRegsFrom(ThreadContext *src)
+{
+    for (const auto &id : intRegClass)
+        tc->setReg(id, src->getReg(id));
+    for (const auto &id : floatRegClass)
+        tc->setReg(id, src->getReg(id));
+    tc->pcState(src->pcState());
+    // The RA registers above are physical slots; the ring base must travel
+    // with them or the logical RA view would change on a copy (D7.5).
+    auto *srcIsa = dynamic_cast<DadaoISA::ISA *>(src->getIsaPtr());
+    if (srcIsa != nullptr)
+        rasBaseIdx = srcIsa->rasBase();
+}
