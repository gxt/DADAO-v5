+#ifndef __ARCH_DADAO_BARE_METAL_HH__
+#define __ARCH_DADAO_BARE_METAL_HH__
+
+#include <memory>
+
+#include "arch/dadao/semihosting.hh"
+#include "base/loader/memory_image.hh"
+#include "base/loader/object_file.hh"
+#include "params/DadaoBareMetal.hh"
+#include "sim/workload.hh"
+
+namespace gem5::DadaoISA
+{
+class BareMetal : public Workload
+{
+  private:
+    loader::SymbolTable symbols;
+    std::unique_ptr<loader::ObjectFile> application;
+    loader::MemoryImage applicationImage;
+
+  public:
+    PARAMS(DadaoBareMetal);
+    BareMetal(const Params &p);
+    void initState() override;
+    Addr getEntry() const override { return params().reset_addr; }
+    ByteOrder byteOrder() const override { return ByteOrder::big; }
+    loader::Arch getArch() const override { return loader::Dadao; }
+    SimObject *getSemihosting() const override
+    { return params().semihosting; }
+    const loader::SymbolTable &symtab(ThreadContext *) override
+    { return symbols; }
+    bool insertSymbol(const loader::Symbol &s) override
+    { return symbols.insert(s); }
+    uint64_t readRd(unsigned index) const;
+    void writeRd(unsigned index, uint64_t value);
+    uint64_t readRb(unsigned index) const;
+    void writeRb(unsigned index, uint64_t value);
+    uint64_t readRa(unsigned index) const;
+    void writeRa(unsigned index, uint64_t value);
+    uint64_t readRf(unsigned index) const;
+    uint64_t readMemory(Addr address, unsigned size) const;
+    void writeMemory(Addr address, uint64_t value, unsigned size);
+    uint64_t readMode() const;
+    uint64_t readFcsr() const;
+    void writeFcsr(uint64_t value);
+    void writeRf0(uint64_t value);
+    Addr readPc() const;
+    void setPc(Addr value);
+    void setMode(uint64_t value);
+    void setCurrentCfx(uint64_t value);
+    uint64_t readCurrentCfx() const;
+    uint64_t readCfxReg(unsigned cfx, unsigned cg, unsigned rc) const;
+    void writeCfxReg(
+            unsigned cfx, unsigned cg, unsigned rc, uint64_t value);
+};
+}
+
+#endif
