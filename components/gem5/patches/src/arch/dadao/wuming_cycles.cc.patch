+byId(std::string_view id)
+{
+    std::size_t lo = 0;
+    std::size_t hi = rowCount();
+    while (lo < hi) {
+        const std::size_t mid = lo + (hi - lo) / 2;
+        const int cmp = std::string_view(kRows[mid].id).compare(id);
+        if (cmp == 0)
+            return &kRows[mid];
+        if (cmp < 0)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return nullptr;
+}
+
+const char *
+className(CycleClass klass)
+{
+    const unsigned index = static_cast<unsigned>(klass);
+    return index < kNumClasses ? kClassNames[index] : "?";
+}
+
+const char *
+rowClasses(const CycleRow &row)
+{
+    // "A3/A4" / "F/G1/G2": one literal per class mask actually used.
+    switch (row.classMask) {
+    case 1u: return "A";
+    case 2u: return "A2";
+    case 12u: return "A3/A4";
+    case 16u: return "B1";
+    case 32u: return "B2";
+    case 64u: return "B3";
+    case 128u: return "B4";
+    case 256u: return "B5";
+    case 512u: return "C";
+    case 1024u: return "D";
+    case 2048u: return "D′";
+    case 4096u: return "E";
+    case 57344u: return "F/G1/G2";
+    case 65536u: return "G3";
+    case 131072u: return "G4";
+    default:
+        return "?";
+    }
+}
