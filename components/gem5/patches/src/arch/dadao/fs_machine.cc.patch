+// DADAO FS machine fault implementation.
+#include "arch/dadao/fs_machine.hh"
+
+#include <memory>
+
+#include "arch/dadao/fs_workload.hh"
+#include "arch/dadao/isa.hh"
+#include "base/cprintf.hh"
+#include "cpu/thread_context.hh"
+#include "sim/sim_exit.hh"
+#include "sim/system.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+namespace
+{
+
+// The first fault locks the exit code: later faults (a second access in the
+// same instruction, a fault raised while unwinding) must not overwrite it.
+bool faultRaised = false;
+
+/** Current run mode for the monitor segment.  Tiny has no cfx/run-mode switch
+ *  (spec/Machine-v5 §2: it executes nominally in hypv); Node exposes the live
+ *  mode of its architectural state. */
+uint8_t
+currentRunMode(ThreadContext *tc)
+{
+    if (tc != nullptr) {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        if (isa != nullptr && isa->nodeState().active)
+            return isa->nodeState().runMode & 0x3;
+    }
+    return 3;  // nominal hypv (Tiny)
+}
+
+} // anonymous namespace
+
+const char *
+machineFaultName(uint8_t cause)
+{
+    switch (cause) {
+      case FaultCfxTrap:
+        return "CFXTRAP";
+      case FaultCfxMem:
+        return "CFXMEM";
+      case FaultCfxReg:
+        return "CFXREG";
+      case FaultCfxEsc:
+        return "CFXESC";
+      case FaultCfxPerm:
+        return "CFXPERM";
+      case FaultIlli:
+        return "ILLI";
+      case FaultUndi:
+        return "UNDI";
+      case FaultRasof:
+        return "RASOF";
+      case FaultRasuf:
+        return "RASUF";
+      case FaultMalign:
+        return "MALIGN";
+      case FaultIalign:
+        return "IALIGN";
+      default:
+        return "UNKNOWN";
+    }
+}
+
+FsWorkload *
+asFsWorkload(ThreadContext *tc)
+{
+    if (tc == nullptr)
+        return nullptr;
+    System *system = tc->getSystemPtr();
+    if (system == nullptr)
+        return nullptr;
+    return dynamic_cast<FsWorkload *>(system->workload);
+}
+
+bool
+isFsMachine(ThreadContext *tc)
+{
+    return asFsWorkload(tc) != nullptr;
+}
+
+void
+MachineFault::invoke(ThreadContext *tc, const StaticInstPtr &)
+{
+    if (faultRaised)
+        return;
+    faultRaised = true;
+
+    const uint8_t code = machineFaultExitCode(cause, currentRunMode(tc),
+                                              targetCfxha);
+
+    // Guest-visible cause name: the config script recognises the prefix and
+    // propagates the low 8 bits to the host exit status.
+    exitSimLoopNow(csprintf("DADAO_FS_FAULT_%s", machineFaultName(cause)), code);
+}
+
+Fault
+machineFault(uint8_t cause)
+{
+    return std::make_shared<MachineFault>(cause);
+}
+
+Fault
+machineFaultToCfx(uint8_t cause, uint8_t cfxha)
+{
+    return std::make_shared<MachineFault>(cause, cfxha);
+}
+
+} // namespace DadaoISA
+} // namespace gem5
