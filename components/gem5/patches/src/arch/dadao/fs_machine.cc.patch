+// DADAO FS machine fault implementation.
+#include "arch/dadao/fs_machine.hh"
+
+#include <memory>
+
+#include "arch/dadao/fs_workload.hh"
+#include "arch/dadao/isa.hh"
+#include "arch/dadao/node_cfx.hh"
+#include "arch/dadao/tiny_cfx.hh"
+#include "base/cprintf.hh"
+#include "base/logging.hh"
+#include "cpu/thread_context.hh"
+#include "sim/sim_exit.hh"
+#include "sim/system.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+namespace
+{
+
+// The first fault locks the exit code: later faults (a second access in the
+// same instruction, a fault raised while unwinding) must not overwrite it.
+bool faultRaised = false;
+
+/** Current run mode for the monitor segment.  Tiny has no cfx/run-mode switch
+ *  (spec/Kaiwu §2: it executes nominally in hypv); Node exposes the live
+ *  mode of its architectural state. */
+uint8_t
+currentRunMode(ThreadContext *tc)
+{
+    if (tc != nullptr) {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        if (isa != nullptr && isa->nodeState().active)
+            return isa->nodeState().runMode & 0x3;
+    }
+    return 3;  // nominal hypv (Tiny)
+}
+
+} // anonymous namespace
+
+const char *
+machineFaultName(uint8_t cause)
+{
+    switch (cause) {
+      case FaultCfxTrap:
+        return "CFXTRAP";
+      case FaultCfxMem:
+        return "CFXMEM";
+      case FaultCfxReg:
+        return "CFXREG";
+      case FaultCfxEsc:
+        return "CFXESC";
+      case FaultCfxPerm:
+        return "CFXPERM";
+      case FaultIlli:
+        return "ILLI";
+      case FaultUndi:
+        return "UNDI";
+      case FaultRasof:
+        return "RASOF";
+      case FaultRasuf:
+        return "RASUF";
+      case FaultMalign:
+        return "MALIGN";
+      case FaultIalign:
+        return "IALIGN";
+      default:
+        return "UNKNOWN";
+    }
+}
+
+FsWorkload *
+asFsWorkload(ThreadContext *tc)
+{
+    if (tc == nullptr)
+        return nullptr;
+    System *system = tc->getSystemPtr();
+    if (system == nullptr)
+        return nullptr;
+    return dynamic_cast<FsWorkload *>(system->workload);
+}
+
+bool
+isFsMachine(ThreadContext *tc)
+{
+    return asFsWorkload(tc) != nullptr;
+}
+
+void
+checkCauseId(uint64_t causeId)
+{
+    const uint64_t cls = causeId & 0xFFFFULL;
+    const uint64_t sub = causeId & (CauseSubWyde2 | CauseSubWyde3);
+    const uint64_t own = (cls == (1ULL << FaultCfxMem)) ? CauseSubWyde3
+                      : (cls == (1ULL << FaultCfxPerm)) ? CauseSubWyde2
+                      : 0;
+    bool ok = (causeId & CauseReserved16) == 0;
+
+    if (own != 0) {
+        // §6.1.1: exactly one sub-cause bit, inside the class's own wyde.
+        ok = ok && sub != 0 && (sub & (sub - 1)) == 0 && (sub & ~own) == 0;
+    } else {
+        // Every other class carries no sub-cause at all (ADR-0056 D2).
+        ok = ok && sub == 0;
+    }
+    if (!ok) {
+        fatal("DADAO: malformed excp_cause_id %#llx (big class in [15:0], "
+              "CFXMEM sub-cause in [63:48], CFXPERM in [47:32]; the other "
+              "wyde and [31:16] must be 0 -- contract-see §6.1.1)", causeId);
+    }
+}
+
+void
+MachineFault::invoke(ThreadContext *tc, const StaticInstPtr &)
+{
+    // Both FS profiles are model-1 machines: a synchronous exception enters
+    // the current run-mode monitor (spec/DADAO-12 §5.2; Kaiwu §4.4 for Tiny).
+    // Only when the monitor vector cannot be entered does the machine stop
+    // with the §7.1 code below.
+    if (tc != nullptr) {
+        auto *isa = dynamic_cast<ISA *>(tc->getIsaPtr());
+        if (isa != nullptr && isa->tinyState().active) {
+            const Addr ip = causeIp ? causeIp : tc->pcState().instAddr();
+            if (tinyCfxRaise(tc, isa->tinyState(),
+                             (1ULL << cause) | causeSub, targetCfxha, ip,
+                             causeInfo, /*fromFault=*/true))
+                return;
+        }
+        if (isa != nullptr && isa->nodeState().active) {
+            NodeState &node = isa->nodeState();
+            const Addr ip = causeIp ? causeIp : tc->pcState().instAddr();
+            const int target = (targetCfxha >= 0)
+                ? targetCfxha : int(node.runMode & 0x3);
+            nodeSyncEnter(tc, node, (1ULL << cause) | causeSub, target, ip,
+                          causeInfo);
+            return;
+        }
+    }
+
+    machineFaultExit(cause, currentRunMode(tc), targetCfxha);
+}
+
+void
+machineFaultExit(uint8_t cause, uint8_t runMode, int targetCfxha)
+{
+    if (faultRaised)
+        return;
+    faultRaised = true;
+
+    const uint8_t code = machineFaultExitCode(cause, runMode, targetCfxha);
+
+    // Guest-visible cause name: the config script recognises the prefix and
+    // propagates the low 8 bits to the host exit status.
+    exitSimLoopNow(csprintf("DADAO_FS_FAULT_%s", machineFaultName(cause)), code);
+}
+
+Fault
+machineFault(uint8_t cause)
+{
+    return std::make_shared<MachineFault>(cause);
+}
+
+Fault
+machineFaultAt(uint8_t cause, Addr causeIp, uint64_t causeInfo,
+               uint64_t causeSub)
+{
+    return std::make_shared<MachineFault>(cause, -1, causeIp, causeInfo,
+                                          causeSub);
+}
+
+Fault
+machineFaultToCfx(uint8_t cause, uint8_t cfxha)
+{
+    return std::make_shared<MachineFault>(cause, cfxha);
+}
+
+} // namespace DadaoISA
+} // namespace gem5
