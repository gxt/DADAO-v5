+// DADAO SE MMU: instruction/data TLB pair over the host page table.
+#ifndef __ARCH_DADAO_MMU_HH__
+#define __ARCH_DADAO_MMU_HH__
+
+#include "arch/dadao/page_size.hh"
+#include "arch/dadao/tlb.hh"
+#include "arch/generic/mmu.hh"
+#include "params/DadaoMMU.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+class MMU : public BaseMMU
+{
+  public:
+    using Params = DadaoMMUParams;
+
+    explicit MMU(const Params &p) : BaseMMU(p) {}
+
+    TranslationGenPtr
+    translateFunctional(Addr start, Addr size, ThreadContext *tc, Mode mode,
+                        Request::Flags flags) override
+    {
+        // Required by SETranslatingPortProxy (image load, argv/stack setup and
+        // guest pointer reads); the base class would panic.
+        return TranslationGenPtr(new MMUTranslationGen(
+                PageBytes, start, size, tc, this, mode, flags));
+    }
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_MMU_HH__
