--- /dev/null
+++ b/src/arch/dadao/tlb.hh
@@ -0,0 +1,66 @@
+#ifndef __ARCH_DADAO_TLB_HH__
+#define __ARCH_DADAO_TLB_HH__
+
+#include "arch/generic/tlb.hh"
+#include "arch/dadao/faults.hh"
+#include "params/DadaoTLB.hh"
+
+namespace gem5::DadaoISA
+{
+// Machine-01 initially uses physical addresses. CFX permission and fault
+// routing are added with the test-machine integration task.
+class TLB : public BaseTLB
+{
+  public:
+    using Params = DadaoTLBParams;
+    TLB(const Params &p) : BaseTLB(p) {}
+    void demapPage(Addr, uint64_t) override {}
+    void flushAll() override {}
+    void takeOverFrom(BaseTLB *) override {}
+    Fault translateAtomic(const RequestPtr &req, ThreadContext *,
+            BaseMMU::Mode mode) override
+    {
+        constexpr Addr AddressMask = 0xffffffffffffULL;
+        constexpr Addr RamBase = 0xfc0000000000ULL;
+        constexpr uint64_t RamSize = 16 * 1024 * 1024;
+        constexpr Addr RomBase = 0xffffffff0000ULL;
+        constexpr uint64_t RomSize = 64 * 1024;
+        // gem5 rounds the fetch address to the decoder word boundary, while
+        // Request::getPC retains the architectural instruction pointer.
+        const Addr instruction_pc = req->hasPC() ? req->getPC() :
+                                   req->getVaddr();
+        if (mode == BaseMMU::Execute && (instruction_pc & 3))
+            return std::make_shared<MachineFault>(
+                    "IALIGN", 0x8d, 0, instruction_pc);
+        const Addr address = (mode == BaseMMU::Execute ?
+                instruction_pc : req->getVaddr()) & AddressMask;
+        const uint64_t size = mode == BaseMMU::Execute ? 4 : req->getSize();
+        auto in_range = [address, size](Addr base, uint64_t length) {
+            return address >= base && size <= length &&
+                   address - base <= length - size;
+        };
+        if (!in_range(RamBase, RamSize) && !in_range(RomBase, RomSize)) {
+            if (((address >> 42) & 0x3f) == 0) {
+                return std::make_shared<MachineFault>(
+                        "CFXMEM", 0x81, RegVal(1) << 1, address, 0);
+            }
+            return std::make_shared<MachineFault>("UNMAPPED", 0x87);
+        }
+        req->setPaddr(address);
+        return NoFault;
+    }
+    void translateTiming(const RequestPtr &req, ThreadContext *tc,
+            BaseMMU::Translation *translation, BaseMMU::Mode mode) override
+    {
+        translation->finish(translateAtomic(req, tc, mode), req, tc, mode);
+    }
+    Fault translateFunctional(const RequestPtr &req, ThreadContext *tc,
+            BaseMMU::Mode mode) override
+    { return translateAtomic(req, tc, mode); }
+    Fault finalizePhysical(const RequestPtr &, ThreadContext *,
+            BaseMMU::Mode) const override
+    { return NoFault; }
+};
+}
+
+#endif
