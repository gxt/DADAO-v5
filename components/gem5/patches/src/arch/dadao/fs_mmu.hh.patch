+// DADAO FS MMU: instruction/data TLB pair over the Tiny identity map.
+//
+// A separate SimObject from the SE DADAOMMU: the TLBs are DadaoFsTlb (segment
+// checks) instead of the SE host-page-table pass-through, and there is no PTW.
+#ifndef __ARCH_DADAO_FS_MMU_HH__
+#define __ARCH_DADAO_FS_MMU_HH__
+
+#include "arch/dadao/page_size.hh"
+#include "arch/generic/mmu.hh"
+#include "params/DadaoFsMMU.hh"
+
+namespace gem5
+{
+
+namespace DadaoISA
+{
+
+class FsMMU : public BaseMMU
+{
+  public:
+    using Params = DadaoFsMMUParams;
+
+    explicit FsMMU(const Params &p) : BaseMMU(p) {}
+
+    TranslationGenPtr
+    translateFunctional(Addr start, Addr size, ThreadContext *tc, Mode mode,
+                        Request::Flags flags) override
+    {
+        // Used by the semihosting TranslatingPortProxy (guest pointer reads
+        // and writes).  Page granularity matches the 64 KiB segments.
+        return TranslationGenPtr(new MMUTranslationGen(
+                PageBytes, start, size, tc, this, mode, flags));
+    }
+};
+
+} // namespace DadaoISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_FS_MMU_HH__
