+#!/usr/bin/env python3
+# DADAO syscall-emulation configuration, timing memory system (m16-gem5-006).
+#
+# Same guest set-up as configs/dadao/se.py (that file is unchanged and stays
+# the AtomicSimpleCPU reference), but the CPU is a DADAO TimingSimpleCPU behind
+# a NoncoherentXBar and one flat SimpleMemory.
+#
+# The memory-system latencies are *not* written here: they are read from the
+# ``memory_system:`` block of the generated cycle table
+# (tools/gem5/wuming_cycles.yaml), which tools/gem5/gen_wuming_cycles.py parses
+# out of docs/core-wuming-cycle-model.md.  ``make check-wuming-cycles`` fails as
+# soon as that block drifts from the document, so a hand-copied latency cannot
+# come back unnoticed.
+#
+# Scope note (m16-gem5-006): the DADAO exec cores read memory synchronously in
+# the middle of execute(), which a timed access cannot provide; the data path
+# therefore reaches the same memory through a functional access
+# (src/arch/dadao/inst.cc) and the ld/st round trip is charged by the wuming
+# cycle model.  The memory system here is real for instruction fetch (and for
+# any future cache model), and ``--wuming-cycles`` turns the per-instruction
+# model on.
+
+import argparse
+import os
+import shlex
+import sys
+
+import m5
+from m5.objects import *
+from m5.objects.BaseTimingSimpleCPU import BaseTimingSimpleCPU
+from m5.objects.DadaoCPU import DadaoCPU
+from m5.objects.DadaoMMU import DadaoMMU
+
+
+class DadaoTimingSimpleCPU(BaseTimingSimpleCPU, DadaoCPU):
+    mmu = DadaoMMU()
+
+
+EXIT_CAUSE = "exiting with last active thread context"
+
+# The clock the derived latencies are expressed in; the cycle table counts
+# cycles, and one cycle is one nanosecond here.
+CLOCK = "1GHz"
+CYCLE_NS = 1.0
+
+
+def parse_redirect(spec):
+    """Parse one --redirect APP=HOST value."""
+    app, sep, host = spec.partition("=")
+    if not sep or not app or not host:
+        raise argparse.ArgumentTypeError(f"expected APP=HOST, got {spec!r}")
+    return (app, host)
+
+
+def read_memory_system(path):
+    """Read the ``memory_system:`` block of the generated cycle table.
+
+    The file is generated and gated, so a deliberately small parser is enough;
+    it fails loudly on a missing key instead of falling back to a default.
+    """
+    wanted = ("mem_latency", "xbar_latency", "fetch_beats",
+              "sram_round_trip", "beat_bytes")
+    found = {}
+    inside = False
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            if not line.strip() or line.lstrip().startswith("#"):
+                continue
+            if not line[0].isspace():
+                inside = line.split(":", 1)[0].strip() == "memory_system"
+                continue
+            if not inside:
+                continue
+            key, _, value = line.strip().partition(":")
+            key = key.strip()
+            if key in wanted:
+                found[key] = value.strip()
+    missing = [k for k in wanted if k not in found]
+    if missing:
+        sys.exit(f"{path}: memory_system 段缺少 {missing}；请重跑 "
+                 f"tools/gem5/gen_wuming_cycles.py")
+    return {k: int(v) for k, v in found.items()}
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", required=True,
+                        help="DADAO ELF to run (ET_EXEC)")
+    parser.add_argument("--args", default="",
+                        help="guest argv[1:], split like a shell would")
+    parser.add_argument("--env", action="append", default=[],
+                        help="guest environment entry K=V (repeatable)")
+    parser.add_argument("--interp-dir", default=None,
+                        help="host directory prefix for the PT_INTERP path")
+    parser.add_argument("--mem-size", default="256MiB")
+    parser.add_argument("--max-stack", default="8MiB")
+    parser.add_argument("--guest-stdin", default="/dev/stdin")
+    parser.add_argument("--guest-stdout", default="/dev/stdout")
+    parser.add_argument("--guest-stderr", default="/dev/stderr")
+    parser.add_argument("--cwd", default=None)
+    parser.add_argument("--max-insts", type=int, default=0,
+                        help="safety cap; hitting it is NOT a guest exit")
+    parser.add_argument("--num-threads", type=int, default=1,
+                        help="thread contexts (one process per context)")
+    parser.add_argument("--cycle-table", default=None,
+                        help="generated cycle table that carries the "
+                             "memory_system latencies "
+                             "(tools/gem5/wuming_cycles.yaml)")
+    parser.add_argument("--mem-latency", type=int, default=None,
+                        help="SimpleMemory round trip in cycles; default from "
+                             "the cycle table")
+    parser.add_argument("--xbar-latency", type=int, default=None,
+                        help="NonCoherentXBar latency in cycles; default from "
+                             "the cycle table")
+    parser.add_argument("--beat-bytes", type=int, default=None,
+                        help="bus width in bytes; default from the cycle table "
+                             "(the doc's 8-byte beat)")
+    parser.add_argument("--wuming-cycles", action="store_true",
+                        help="enable the wuming cycle table (DadaoISA "
+                             "enable_wuming_cycles); off = upstream 1-cycle")
+    parser.add_argument("--mem-base", default="0",
+                        help="physical base of the flat memory (default 0). A "
+                             "Kaiwu-Tiny image is linked at the Tiny SRAM "
+                             "base, so a same-ELF comparison against the "
+                             "chipyard harness passes that base here")
+    parser.add_argument("--semihost", choices=("off", "on"), default="off",
+                        help="serve the Kaiwu-Tiny semihosting trap "
+                             "(`trap cfx<any>, 0x3FFxx`) in SE mode; off keeps "
+                             "the SE trap path exactly as it was")
+    parser.add_argument("--semihost-argv",
+                        default="",
+                        help="SYS_GET_CMDLINE answer, split like a shell would")
+    parser.add_argument("--console-out", default="",
+                        help="file for the semihosting console; empty = the "
+                             "simulator's stdout")
+    parser.add_argument("--redirect", action="append", default=[],
+                        type=parse_redirect, metavar="APP=HOST",
+                        help="serve guest path prefix APP from host directory "
+                             "HOST (repeatable)")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    mem_cycles = args.mem_latency
+    xbar_cycles = args.xbar_latency
+    beat_bytes = None
+    if mem_cycles is None or xbar_cycles is None or args.beat_bytes is None:
+        if args.cycle_table is None:
+            sys.exit("se_timing.py: --cycle-table is required unless both "
+                     "--mem-latency and --xbar-latency are given (no "
+                     "hand-copied latency default)")
+        table = read_memory_system(args.cycle_table)
+        if mem_cycles is None:
+            mem_cycles = table["mem_latency"]
+        if xbar_cycles is None:
+            xbar_cycles = table["xbar_latency"]
+        beat_bytes = table["beat_bytes"]
+    if args.beat_bytes is not None:
+        beat_bytes = args.beat_bytes
+
+    def latency(cycles):
+        return f"{cycles * CYCLE_NS:g}ns"
+
+    system = System()
+    system.mem_mode = "timing"
+    mem_base = int(str(args.mem_base), 0)
+    if mem_base == 0:
+        mem_range = AddrRange(args.mem_size)
+    else:
+        # An explicit base: the flat memory has to cover the image's link
+        # window, which for a Kaiwu-Tiny ELF is the Tiny SRAM base.
+        size = AddrRange(args.mem_size).size()
+        mem_range = AddrRange(mem_base, mem_base + size)
+    system.mem_ranges = [mem_range]
+    system.cache_line_size = 64
+    system.multi_thread = args.num_threads > 1
+
+    system.voltage_domain = VoltageDomain()
+    system.clk_domain = SrcClockDomain(clock=CLOCK,
+                                       voltage_domain=system.voltage_domain)
+
+    system.membus = NoncoherentXBar(frontend_latency=xbar_cycles,
+                                    forward_latency=xbar_cycles,
+                                    response_latency=xbar_cycles,
+                                    width=beat_bytes)
+    system.mem = SimpleMemory(range=mem_range,
+                              latency=latency(mem_cycles))
+    system.mem.port = system.membus.mem_side_ports
+    # The system port is what carries functional accesses (ELF load, argv/
+    # stack set-up, syscall copyin/copyout and the exec cores' functional data
+    # path) into this memory system.
+    system.system_port = system.membus.cpu_side_ports
+
+    if args.semihost == "on":
+        system.workload = DadaoSEWorkload(
+            semihosting=DadaoSemihosting(
+                cmd_line=args.semihost_argv,
+                console_out=args.console_out,
+                semihost_system_native=False,
+            ))
+    else:
+        system.workload = DadaoSEWorkload()
+
+    if args.interp_dir:
+        from m5.core import setInterpDir
+        setInterpDir(args.interp_dir)
+
+    process = Process()
+    process.executable = args.binary
+    process.cmd = [args.binary] + shlex.split(args.args)
+    process.env = list(args.env)
+    process.input = args.guest_stdin
+    process.output = args.guest_stdout
+    process.errout = args.guest_stderr
+    process.cwd = args.cwd if args.cwd is not None else os.getcwd()
+    process.maxStackSize = args.max_stack
+
+    if args.redirect:
+        system.redirect_paths = [
+            RedirectPath(app_path=app, host_paths=[host])
+            for app, host in args.redirect
+        ]
+
+    system.cpu = DadaoTimingSimpleCPU(numThreads=args.num_threads)
+    system.cpu.workload = [process] * args.num_threads
+    system.cpu.createInterruptController()
+    system.cpu.icache_port = system.membus.cpu_side_ports
+    system.cpu.dcache_port = system.membus.cpu_side_ports
+    system.cpu.createThreads()
+
+    if args.wuming_cycles:
+        # createThreads() builds the per-thread ISA vector; set the parameters
+        # before m5.instantiate() constructs the C++ objects.
+        for isa in system.cpu.isa:
+            isa.enable_wuming_cycles = True
+
+    if args.max_insts > 0:
+        system.cpu.max_insts_any_thread = args.max_insts
+
+    print(f"GEM5_MEM_SYSTEM=NoncoherentXBar(xbar={xbar_cycles}cyc)"
+          f"+SimpleMemory(mem={mem_cycles}cyc)", file=sys.stderr)
+
+    root = Root(full_system=False, system=system)
+    m5.instantiate()
+
+    exit_event = m5.simulate()
+    cause = exit_event.getCause()
+    print(f"GEM5_EXIT_CAUSE={cause}", file=sys.stderr)
+    # A semihosting SYS_EXIT ends the simulation with `semi:<ADP code>`; the
+    # guest's own exit code is the event's code (m16-gem5-007).
+    if cause != EXIT_CAUSE and not cause.startswith("semi:"):
+        print(f"gem5 SE timing: simulation ended without a guest exit: {cause}",
+              file=sys.stderr)
+        sys.exit(125)
+
+    sys.exit(exit_event.getCode())
+
+
+if __name__ == "__m5_main__":
+    main()
