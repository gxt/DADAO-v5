+#!/usr/bin/env python3
+# DADAO FS configuration (GEM5-015t Tiny, GEM5-016t Vast).
+#
+# One AtomicSimpleCPU, no caches and no timing.  The profile selects the
+# machine geometry; every constant below is the single source passed to the
+# workload, the TLB and the memories, and `--dump-geometry` prints the values
+# actually in force (they must equal tests/shared/machine-profiles.yaml).
+#
+#   tiny: 64 KiB BootROM + 8 MiB SRAM + 64 KiB hmon SRAM, identity segment
+#         checks, cfx63 power + cfx3 hmon, no PTW.
+#   vast: 4 MiB BootROM + 2 GiB PA RAM + hmon/smon/pmem SRAM, PTW identity
+#         map, cfx register file/monitor, cfx_pmem DMA, cfx_time/cfx_hart.
+
+import argparse
+import shlex
+import sys
+
+import m5
+from m5.objects import *
+
+LAST_THREAD_CAUSE = "exiting with last active thread context"
+FAULT_PREFIX = "DADAO_FS_FAULT_"
+SEMI_PREFIX = "semi:"
+NON_GUEST_EXIT = 125
+
+PROFILES = {
+    # Machine-v5-Tiny (spec/Machine-v5 §1.1; machine-profiles.yaml tiny).
+    "tiny": {
+        "bootrom_base": 0xFFFF_FFFF_0000,
+        "bootrom_size": 0x1_0000,
+        "reset_pc": 0xFFFF_FFFF_0000,
+        "ram_base": 0xFFFF_FF00_0000,
+        "ram_size": 0x80_0000,
+        "kernel_base": 0xFFFF_FF01_0000,
+        "kernel_reserved": 0x100,
+        "entry": 0xFFFF_FF01_0100,
+        "sp": 0xFFFF_FF7E_FF00,
+        "hmon": (0x0FFF_0000_0000, 0x1_0000),
+        "smon": None,
+        "pmem": None,
+        "exit_block": 0xFFFF_FF7E_0000,
+    },
+    # Machine-v5-Vast (spec/Machine-v5 §1.1; machine-profiles.yaml vast).
+    "vast": {
+        "bootrom_base": 0xFFFF_FFC0_0000,
+        "bootrom_size": 0x40_0000,
+        "reset_pc": 0xFFFF_FFFF_0000,
+        "ram_base": 0x0000_0000_0000,
+        "ram_size": 0x8000_0000,
+        "kernel_base": 0x0000_0000_0010_0000,
+        "kernel_reserved": 0x0,
+        "entry": 0x0000_0000_0010_0000,
+        "sp": 0x0000_0000_7FFF_0000,
+        "hmon": (0x0FFF_0000_0000, 0x1_0000),
+        "smon": (0x0BFF_0000_0000, 0x1_0000),
+        "pmem": (0x83FF_0000_0000, 0x1_0000),
+        "exit_block": 0x7FFD_0000,
+    },
+}
+
+# The C++ FsWorkload keeps the machine id in its own spelling
+# (src/arch/dadao/fs_workload.cc: "tiny" | "node").  The Python profile name
+# is not passed through, so a profile rename here never changes that id.
+WORKLOAD_PROFILES = {"tiny": "tiny", "vast": "node"}
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--profile", choices=("tiny", "vast"),
+                        default="tiny",
+                        help="FS machine profile (default tiny)")
+    parser.add_argument("--kernel", default="",
+                        help="raw or ET_EXEC DADAO ELF image (tiny: required)")
+    parser.add_argument("--bootrom", default="",
+                        help="flat BootROM image (required for a Vast run)")
+    parser.add_argument("--semihost", choices=("on", "off"), default="on",
+                        help="enable semihosting services")
+    parser.add_argument("--semihost-argv", default="",
+                        help="guest command line reported by SYS_GET_CMDLINE")
+    parser.add_argument("--semihost-arg", action="append", default=[],
+                        help="append one guest command-line argument")
+    parser.add_argument("--semihost-system", choices=("deny", "native"),
+                        default="deny",
+                        help="SYS_SYSTEM policy (deny by default)")
+    parser.add_argument("--console-out", default="",
+                        help="host file for SYS_WRITEC/SYS_WRITE0 "
+                             "(default: stdout)")
+    parser.add_argument("--trace-cpu", default="",
+                        help="write a QEMU `-d cpu` compatible PC:/MODE: trace")
+    parser.add_argument("--max-ticks", type=int, default=0,
+                        help="safety cap; hitting it is NOT a guest exit")
+    parser.add_argument("--dump-geometry", action="store_true",
+                        help="print the effective geometry and exit")
+    parser.add_argument("--dump-semihost-services", action="store_true",
+                        help="print the C++ semihosting service table and exit")
+    return parser.parse_args()
+
+
+def guest_argv(args):
+    argv = shlex.split(args.semihost_argv)
+    argv.extend(args.semihost_arg)
+    return argv
+
+
+def geometry_lines(name, g):
+    if name == "vast":
+        return [
+            ("bootrom_base", g["bootrom_base"]),
+            ("bootrom_size", g["bootrom_size"]),
+            ("reset_pc", g["reset_pc"]),
+            ("ram_base", g["ram_base"]),
+            ("ram_size", g["ram_size"]),
+            ("ram_end", g["ram_base"] + g["ram_size"] - 1),
+            ("entry", g["entry"]),
+            ("sp", g["sp"]),
+            ("kernel_base", g["kernel_base"]),
+            ("kernel_reserved", g["kernel_reserved"]),
+            ("hmon_base", g["hmon"][0]),
+            ("hmon_size", g["hmon"][1]),
+            ("smon_base", g["smon"][0]),
+            ("smon_size", g["smon"][1]),
+            ("pmem_base", g["pmem"][0]),
+            ("pmem_size", g["pmem"][1]),
+            ("exit_block", g["exit_block"]),
+        ]
+    # GEM5-015t tiny keys, plus the M13 hmon SRAM geometry.
+    return [
+        ("bootrom_base", g["bootrom_base"]),
+        ("bootrom_size", g["bootrom_size"]),
+        ("sram_base", g["ram_base"]),
+        ("sram_size", g["ram_size"]),
+        ("hmon_base", g["hmon"][0]),
+        ("hmon_size", g["hmon"][1]),
+        ("reset_pc", g["reset_pc"]),
+        ("kernel_base", g["kernel_base"]),
+        ("kernel_reserved", g["kernel_reserved"]),
+        ("entry", g["entry"]),
+        ("sp", g["sp"]),
+    ]
+
+
+def build(args, g):
+    system = System()
+    system.mem_mode = "atomic"
+    system.cache_line_size = 64
+
+    voltage = VoltageDomain()
+    system.clk_domain = SrcClockDomain(clock="1GHz", voltage_domain=voltage)
+
+    system.membus = SystemXBar()
+    system.system_port = system.membus.cpu_side_ports
+
+    ranges = []
+
+    def add_memory(obj_name, base, size):
+        memory = SimpleMemory(range=AddrRange(base, size=size))
+        memory.port = system.membus.mem_side_ports
+        setattr(system, obj_name, memory)
+        ranges.append(AddrRange(base, size=size))
+
+    add_memory("rom", g["bootrom_base"], g["bootrom_size"])
+    if args.profile == "vast":
+        add_memory("ram", g["ram_base"], g["ram_size"])
+        add_memory("hmon", g["hmon"][0], g["hmon"][1])
+        add_memory("smon", g["smon"][0], g["smon"][1])
+        add_memory("pmem", g["pmem"][0], g["pmem"][1])
+    else:
+        add_memory("sram", g["ram_base"], g["ram_size"])
+        add_memory("hmon", g["hmon"][0], g["hmon"][1])
+    system.mem_ranges = ranges
+
+    semihosting = NULL
+    if args.semihost == "on":
+        semihosting = DadaoSemihosting(
+            cmd_line=" ".join(guest_argv(args)),
+            console_out=args.console_out,
+            semihost_system_native=(args.semihost_system == "native"),
+        )
+
+    system.workload = DadaoFsWorkload(
+        profile=WORKLOAD_PROFILES[args.profile],
+        bootrom=args.bootrom,
+        kernel=args.kernel,
+        semihosting=semihosting,
+        trace_cpu=args.trace_cpu,
+        rom_base=g["bootrom_base"],
+        rom_size=g["bootrom_size"],
+        sram_base=g["ram_base"],
+        sram_size=g["ram_size"],
+        hmon_base=g["hmon"][0] if g["hmon"] else 0,
+        hmon_size=g["hmon"][1] if g["hmon"] else 0,
+        ram_base=g["ram_base"] if args.profile == "vast" else 0,
+        ram_size=g["ram_size"] if args.profile == "vast" else 0,
+        pmem_base=g["pmem"][0] if g["pmem"] else 0,
+        kernel_base=g["kernel_base"],
+        kernel_reserved=g["kernel_reserved"],
+        reset_pc=g["reset_pc"],
+        entry=g["entry"],
+        sp=g["sp"],
+    )
+
+    if args.profile == "vast":
+        mmu = DadaoNodeMMU()
+        for tb in (mmu.itb, mmu.dtb):
+            tb.rom_base = g["bootrom_base"]
+            tb.rom_size = g["bootrom_size"]
+            tb.ram_base = g["ram_base"]
+            tb.ram_size = g["ram_size"]
+            tb.hmon_base = g["hmon"][0]
+            tb.hmon_size = g["hmon"][1]
+            tb.smon_base = g["smon"][0]
+            tb.smon_size = g["smon"][1]
+            tb.pmem_base = g["pmem"][0]
+            tb.pmem_size = g["pmem"][1]
+        system.cpu = DadaoNodeAtomicSimpleCPU()
+    else:
+        mmu = DadaoFsMMU()
+        for tb in (mmu.itb, mmu.dtb):
+            tb.rom_base = g["bootrom_base"]
+            tb.rom_size = g["bootrom_size"]
+            tb.sram_base = g["ram_base"]
+            tb.sram_size = g["ram_size"]
+            tb.hmon_base = g["hmon"][0]
+            tb.hmon_size = g["hmon"][1]
+        system.cpu = DadaoFsAtomicSimpleCPU()
+
+    system.cpu.mmu = mmu
+    system.cpu.createInterruptController()
+    system.cpu.icache_port = system.membus.cpu_side_ports
+    system.cpu.dcache_port = system.membus.cpu_side_ports
+    system.cpu.createThreads()
+
+    return system, semihosting
+
+
+def main():
+    args = parse_args()
+    g = PROFILES[args.profile]
+
+    if args.dump_geometry:
+        for key, value in geometry_lines(args.profile, g):
+            print(f"GEM5_GEOMETRY {key}={int(value):#x}")
+        return 0
+
+    system, semihosting = build(args, g)
+
+    root = Root(full_system=True, system=system)
+    m5.instantiate()
+
+    if args.dump_semihost_services:
+        if semihosting is NULL:
+            print("GEM5_SEMIHOST_SERVICES=")
+        else:
+            print(f"GEM5_SEMIHOST_SERVICES={semihosting.dumpServices()}")
+        return 0
+
+    if args.max_ticks > 0:
+        exit_event = m5.simulate(args.max_ticks)
+    else:
+        exit_event = m5.simulate()
+    cause = exit_event.getCause()
+    print(f"GEM5_EXIT_CAUSE={cause}", file=sys.stderr)
+    print(f"GEM5_EXIT_CODE={exit_event.getCode()}", file=sys.stderr)
+
+    guest_exit = (cause == LAST_THREAD_CAUSE or
+                  cause.startswith(SEMI_PREFIX) or
+                  cause.startswith(FAULT_PREFIX))
+    if not guest_exit:
+        # A non-guest stop (max ticks, panic, ...) must never be mistaken for
+        # the guest's own status.
+        print(f"gem5 FS: simulation ended without a guest exit: {cause}",
+              file=sys.stderr)
+        return NON_GUEST_EXIT
+
+    return exit_event.getCode() & 0xFF
+
+
+if __name__ == "__m5_main__":
+    sys.exit(main())
