+#!/usr/bin/env python3
+# DADAO syscall-emulation configuration (GEM5-014t).
+#
+# A deliberately small classic-style SE configuration: one AtomicSimpleCPU, one
+# flat SimpleMemory starting at physical address 0, and the DADAO SE workload.
+# Guest virtual addresses are the ELF p_vaddr values; translation is done by
+# the DADAO SE TLB through the host page table.  The FS machine model (boot ROM,
+# memory window, page-table walker) is not part of this configuration.
+
+import argparse
+import os
+import shlex
+import sys
+
+import m5
+from m5.objects import *
+
+
+EXIT_CAUSE = "exiting with last active thread context"
+
+
+def parse_redirect(spec):
+    """Parse one --redirect APP=HOST value."""
+    app, sep, host = spec.partition("=")
+    if not sep or not app or not host:
+        raise argparse.ArgumentTypeError(
+            f"expected APP=HOST, got {spec!r}")
+    return (app, host)
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--binary", required=True,
+                        help="DADAO ELF to run (ET_EXEC; a PT_INTERP "
+                             "interpreter is loaded when --interp-dir is given)")
+    parser.add_argument("--args", default="",
+                        help="guest argv[1:], split like a shell would")
+    parser.add_argument("--env", action="append", default=[],
+                        help="guest environment entry K=V (repeatable)")
+    parser.add_argument("--interp-dir", default=None,
+                        help="host directory prefix for the PT_INTERP path "
+                             "(m5.core.setInterpDir): the guest interpreter "
+                             "/lib/ld-musl-dadao.so.1 is opened as "
+                             "<dir>/lib/ld-musl-dadao.so.1.  Only needed for a "
+                             "dynamically linked binary")
+    parser.add_argument("--redirect", action="append", default=[],
+                        type=parse_redirect, metavar="APP=HOST",
+                        help="serve guest path prefix APP from host directory "
+                             "HOST (System.redirect_paths; repeatable).  This "
+                             "is the guest root the QEMU side gets from -L")
+    parser.add_argument("--mem-size", default="256MiB",
+                        help="size of the single physical memory range")
+    parser.add_argument("--max-stack", default="8MiB",
+                        help="maximum stack size handed to the process")
+    parser.add_argument("--guest-stdin", default="/dev/stdin",
+                        help="host file backing guest fd 0")
+    parser.add_argument("--guest-stdout", default="/dev/stdout",
+                        help="host file backing guest fd 1")
+    parser.add_argument("--guest-stderr", default="/dev/stderr",
+                        help="host file backing guest fd 2")
+    parser.add_argument("--cwd", default=None,
+                        help="guest current working directory")
+    parser.add_argument("--max-insts", type=int, default=0,
+                        help="safety cap; hitting it is NOT a guest exit")
+    parser.add_argument("--num-threads", type=int, default=64,
+                        help="thread contexts: one is the initial process and "
+                             "one is needed for every live thread (clone "
+                             "CLONE_THREAD) or fork(2)/clone(2) child "
+                             "(GEM5-025t/GEM5-026t).  The corpus reaches 11 "
+                             "live threads (pthread_cond-smasher) and ~100 "
+                             "short-lived fork children (raise-race), so the "
+                             "default is 64")
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+
+    system = System()
+    system.mem_mode = "atomic"
+    system.mem_ranges = [AddrRange(args.mem_size)]
+    system.cache_line_size = 64
+    # More than one thread context is what makes fork(2)/clone(2) possible: the
+    # child runs on a free context of the same CPU (GEM5-025t).
+    system.multi_thread = args.num_threads > 1
+
+    # The CPU is a ClockedObject, so the system needs a clock domain.
+    system.voltage_domain = VoltageDomain()
+    system.clk_domain = SrcClockDomain(clock="1GHz",
+                                       voltage_domain=system.voltage_domain)
+
+    system.membus = SystemXBar()
+    system.mem = SimpleMemory(range=AddrRange(args.mem_size))
+    system.mem.port = system.membus.mem_side_ports
+    system.system_port = system.membus.cpu_side_ports
+
+    system.workload = DadaoSEWorkload()
+
+    # Dynamic executables (ET_EXEC + PT_INTERP, GEM5-027t): the interpreter is
+    # opened on the host while the Process is constructed (ElfObject parses
+    # PT_INTERP in its constructor), so the prefix must be installed first.
+    if args.interp_dir:
+        from m5.core import setInterpDir
+        setInterpDir(args.interp_dir)
+
+    process = Process()
+    # argv[0] is the exact --binary string, so cross-checking against
+    # qemu-dadao can pass the same string on both sides.
+    process.executable = args.binary
+    process.cmd = [args.binary] + shlex.split(args.args)
+    process.env = list(args.env)
+    process.input = args.guest_stdin
+    process.output = args.guest_stdout
+    process.errout = args.guest_stderr
+    process.cwd = args.cwd if args.cwd is not None else os.getcwd()
+    process.maxStackSize = args.max_stack
+
+    # Guest-root path redirection: every guest open() under APP is served from
+    # HOST (the same mapping qemu-dadao gets from -L).
+    if args.redirect:
+        system.redirect_paths = [
+            RedirectPath(app_path=app, host_paths=[host])
+            for app, host in args.redirect
+        ]
+
+    system.cpu = DadaoAtomicSimpleCPU(numThreads=args.num_threads)
+    # SE associates one Process with each thread context.  They all start on
+    # the initial process; fork(2)/clone(2) moves a free context to the child
+    # (GEM5-025t).
+    system.cpu.workload = [process] * args.num_threads
+    system.cpu.createInterruptController()
+    system.cpu.icache_port = system.membus.cpu_side_ports
+    system.cpu.dcache_port = system.membus.cpu_side_ports
+    system.cpu.createThreads()
+
+    if args.max_insts > 0:
+        system.cpu.max_insts_any_thread = args.max_insts
+
+    root = Root(full_system=False, system=system)
+    m5.instantiate()
+
+    exit_event = m5.simulate()
+    cause = exit_event.getCause()
+    # Evidence hook: the exit cause is host-side information, never guest
+    # output, so it goes to stderr.
+    print(f"GEM5_EXIT_CAUSE={cause}", file=sys.stderr)
+    if cause != EXIT_CAUSE:
+        # A non-guest exit (max-insts, panic unwinding, ...) must never be
+        # mistaken for the guest's own status.
+        print(f"gem5 SE: simulation ended without a guest exit: {cause}",
+              file=sys.stderr)
+        sys.exit(125)
+
+    sys.exit(exit_event.getCode())
+
+
+if __name__ == "__m5_main__":
+    main()
