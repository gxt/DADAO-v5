+//===-- DADAOInstrInfo.td - DADAO Instruction defs -----*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DADAO M1 instruction definitions (178 instructions).
+// Auto-generated from contracts/opcodes.yaml by tools/llvm/generate_instrinfo.py.
+// DO NOT EDIT MANUALLY.
+//
+// Each def binds its operands to the format class's bits<> fields via
+// `let` statements (e.g. let ra = rdha; let imm12 = imms12;).
+//
+//===----------------------------------------------------------------------===//
+
+include "DADAOInstrFormats.td"
+
+//===----------------------------------------------------------------------===//
+// Operand types
+//===----------------------------------------------------------------------===//
+
+// 12-bit signed immediate (rrii: hc[5:0]+hd[5:0])
+def imms12 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeSImm12";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 12-bit unsigned immediate (rrii)
+def immu12 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeUImm12";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 18-bit signed immediate (riii: hb[5:0]+hc[5:0]+hd[5:0])
+def imms18 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeSImm18";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 18-bit unsigned immediate (oiii)
+def immu18 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeUImm18";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 16-bit unsigned immediate (rwii: hb[3:0]+hc+hd)
+def immu16 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeUImm16";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 6-bit unsigned immediate (rrri/orri: hd[5:0])
+def immu6 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeUImm6";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 24-bit signed immediate (iiii: ha+hb+hc+hd)
+def imms24 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeSImm24";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 24-bit unsigned immediate (iiii, swym)
+def immu24 : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeUImm24";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+// 2-bit wyde-position (rwii: hb[5:4])
+def wydepos : Operand<i64> {
+  let EncoderMethod = "";  // LLVM-006t adds
+  let DecoderMethod = "DecodeWydePos";  // LLVM-008t implements
+  let PrintMethod = "";
+  let MIOperandInfo = (ops);
+}
+
+//===----------------------------------------------------------------------===//
+// M1 instruction definitions (178 total)
+//===----------------------------------------------------------------------===//
+
+// --- rrii format (21 instructions) ---
+
+def ld_ub_rd : DADAORrii<"ld.ub"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x10;
+  let Pattern = [];
+}
+
+def ld_uw_rd : DADAORrii<"ld.uw"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x11;
+  let Pattern = [];
+}
+
+def ld_ut_rd : DADAORrii<"ld.ut"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x12;
+  let Pattern = [];
+}
+
+def ld_sb_rd : DADAORrii<"ld.sb"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x13;
+  let Pattern = [];
+}
+
+def ld_sw_rd : DADAORrii<"ld.sw"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x14;
+  let Pattern = [];
+}
+
+def ld_st_rd : DADAORrii<"ld.st"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x15;
+  let Pattern = [];
+}
+
+def st_b_rd : DADAORrii<"st.b"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRD:$ra, GPRB:$rb, imms12:$imm12);
+  let op = 0x18;
+  let Pattern = [];
+}
+
+def st_w_rd : DADAORrii<"st.w"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRD:$ra, GPRB:$rb, imms12:$imm12);
+  let op = 0x19;
+  let Pattern = [];
+}
+
+def st_t_rd : DADAORrii<"st.t"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRD:$ra, GPRB:$rb, imms12:$imm12);
+  let op = 0x1A;
+  let Pattern = [];
+}
+
+def ld_o_rd : DADAORrii<"ld.o"> {
+  let OutOperandList = (outs GPRD:$ra);
+  let InOperandList = (ins GPRB:$rb, imms12:$imm12);
+  let op = 0x20;
+  let Pattern = [];
+}
+
+def st_o_rd : DADAORrii<"st.o"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRD:$ra, GPRB:$rb, imms12:$imm12);
+  let op = 0x21;
+  let Pattern = [];
