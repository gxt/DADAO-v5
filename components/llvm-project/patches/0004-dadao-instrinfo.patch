 add_public_tablegen_target(DADAOCommonTableGen)
 
 add_llvm_target(DADAOCodeGen
   DADAOFrameLowering.cpp
+  DADAOInstrInfo.cpp
   DADAORegisterInfo.cpp
   DADAOTargetMachine.cpp
 
