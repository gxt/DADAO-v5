@@ -0,0 +1,98 @@
+//===-- DADAOMCTargetDesc.cpp - DADAO Target Descriptions -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file provides DADAO specific target descriptions.
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOMCTargetDesc.h"
+#include "DADAOMCAsmInfo.h"
+#include "TargetInfo/DADAOTargetInfo.h"
+#include "llvm/MC/MCInstPrinter.h"
+#include "llvm/MC/MCInstrAnalysis.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+
+using namespace llvm;
+
+static MCStreamer *createMCStreamer(const Triple &T, MCContext &Context,
+                                   std::unique_ptr<MCAsmBackend> &&MAB,
+                                   std::unique_ptr<MCObjectWriter> &&OW,
+                                   std::unique_ptr<MCCodeEmitter> &&Emitter) {
+  return createELFStreamer(Context, std::move(MAB), std::move(OW),
+                           std::move(Emitter));
+}
+
+// Minimal MCInstPrinter stub: llvm-mc requires a non-null printer or it
+// crashes at runtime.  We provide one that just prints raw bytes.
+namespace {
+class DADAOMCInstPrinter : public MCInstPrinter {
+public:
+  DADAOMCInstPrinter(const MCAsmInfo &MAI, const MCInstrInfo &MII,
+                     const MCRegisterInfo &MRI)
+      : MCInstPrinter(MAI, MII, MRI) {}
+
+  void printInst(const MCInst *MI, uint64_t Address, StringRef Annot,
+                 const MCSubtargetInfo &STI, raw_ostream &O) override {
+    // Stub: print nothing for now.
+    O << "\t/* dadao instruction */";
+  }
+
+  void printRegName(raw_ostream &OS, MCRegister Reg) override {
+    OS << getRegisterName(Reg);
+  }
+
+  static const char *getRegisterName(MCRegister Reg) {
+    return "<unknown>";
+  }
+
+  // Required by MCInstPrinter (pure virtual).
+  std::pair<const char *, uint64_t>
+  getMnemonic(const MCInst &MI) const override {
+    return {"<unknown>", 0};
+  }
+};
+} // end anonymous namespace
+
+static MCInstPrinter *createDadaoMCInstPrinter(const Triple & /*T*/,
+                                               unsigned SyntaxVariant,
+                                               const MCAsmInfo &MAI,
+                                               const MCInstrInfo &MII,
+                                               const MCRegisterInfo &MRI) {
+  return new DADAOMCInstPrinter(MAI, MII, MRI);
+}
+
+// Minimal MCRegisterInfo stub: llvm-mc --triple=dadao-unknown-elf calls
+// TargetRegistry::LookupTarget which requires RegisterMCRegInfo to have been
+// called; without it we hit "Unable to create target register info!" assert.
+// No actual registers are defined (no .td); this is an empty object.
+static MCRegisterInfo *createDadaoMCRegInfo(const Triple & /*TT*/) {
+  auto *X = new MCRegisterInfo();
+  return X;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeDADAOTargetMC() {
+  // Register the MC asm info.
+  RegisterMCAsmInfo<DADAOMCAsmInfo> X(getTheDadaoTarget());
+
+  // Register the MC register info (empty stub; no registers defined).
+  TargetRegistry::RegisterMCRegInfo(getTheDadaoTarget(),
+                                    createDadaoMCRegInfo);
+
+  // Register the MCInstPrinter (required by llvm-mc at runtime).
+  TargetRegistry::RegisterMCInstPrinter(getTheDadaoTarget(),
+                                        createDadaoMCInstPrinter);
+
+  // Register the ELF streamer.
+  TargetRegistry::RegisterELFStreamer(getTheDadaoTarget(), createMCStreamer);
+}
