 llvm/lib/Target/DADAO/DADAORegisterInfo.h     |  39 ++++
 llvm/lib/Target/DADAO/DADAORegisterInfo.td    | 181 ++++++++++++++++++
 llvm/lib/Target/DADAO/DADAOTargetMachine.cpp  |   8 +-
 llvm/lib/Target/DADAO/DADAOTargetMachine.h    |  11 +-
 .../DADAO/MCTargetDesc/DADAOMCTargetDesc.cpp  |  19 +-
