+//===--- BuiltinsDADAO.def - DADAO Builtin function database ----*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines the DADAO-specific builtin function database.  Users of
+// this file must define the BUILTIN macro to make use of this information.
+//
+//===----------------------------------------------------------------------===//
+
+// GF(2) carry-less multiply (ADR-0035; LLVM-122t): 64x64 -> 128 bits, i.e.
+// `clmul.o {hi, lo}, a, b` -- one instruction, no joining shifts/ors (the
+// backend lowers the i128 result through llvm.dadao.clmul.wide).
+BUILTIN(__builtin_dadao_clmul, "ULLLiULLiULLi", "nc")
+
+// IEEE 754 remainder (LLVM-126t; contract-fp.md §5): `forem`/`ftrem`, one
+// instruction, no libcall.  Overloaded on the argument type (double or float);
+// the prototype below is a placeholder -- Sema's custom check
+// (CheckTSBuiltinFunctionCall, Triple::dadao) sets the real result type from
+// the argument, and CodeGen picks llvm.dadao.remainder.f32/f64 from it.
+// Semantics: x - n*y with n the nearest integer (ties to even).  This is NOT
+// `frem`; use `remainder()`/`__builtin_dadao_remainder`, never fmod.
+BUILTIN(__builtin_dadao_remainder, "d.", "nct")
