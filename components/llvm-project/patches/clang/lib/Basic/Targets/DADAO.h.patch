+//===--- DADAO.h - Declare DADAO target feature support --------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file declares the DADAO TargetInfo object.
+//
+// DADAO is a 64-bit big-endian, freestanding (ELF, no libc/OS) target.  The
+// scalar type model follows spec/DADAO-21 §数据表示 §Fundamental Types and the
+// contract in .tao/contracts/contract-abi.md §1.7/§4.9.  The DataLayout is
+// deliberately *derived from the triple* (never a literal here) so that clang
+// and the DADAO backend (DADAOTargetMachine -> Triple::computeDataLayout) can
+// never drift (ADR-0018 §C9 D1).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_CLANG_LIB_BASIC_TARGETS_DADAO_H
+#define LLVM_CLANG_LIB_BASIC_TARGETS_DADAO_H
+
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Basic/TargetOptions.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/TargetParser/Triple.h"
+
+namespace clang {
+namespace targets {
+
+class LLVM_LIBRARY_VISIBILITY DADAOTargetInfo : public TargetInfo {
+public:
+  DADAOTargetInfo(const llvm::Triple &Triple, const TargetOptions &)
+      : TargetInfo(Triple) {
+    // 64-bit big-endian (spec/DADAO-21 §数据表示; ADR-0018 C9).
+    BigEndian = true;
+    // Thread-local storage is supported (LLVM-100t): TLS was pulled into the
+    // target's scope by ADR-0025 D5 / contract-dynlink.md §7, and the backend
+    // lowers `GlobalTLSAddress` for the static (local-exec) model -- address =
+    // TP(rb3) + TPOFF, contract-abi.md §1.3.  Dynamic TLS (DTPMOD/DTPREL/TPREL,
+    // `D2`) is still out of scope; the driver defaults the model to local-exec
+    // and the backend rejects position-independent TLS with a diagnostic.
+    TLSSupported = true;
+    // '{' / '}' are ordinary characters for the DADAO assembly syntax.
+    NoAsmVariants = true;
+
+    // LP64 scalar model (spec/DADAO-21 §数据表示 §Fundamental Types).
+    LongWidth = LongAlign = 64;
+    PointerWidth = PointerAlign = 64;
+    IntMaxType = Int64Type = SignedLong;
+    IntPtrType = PtrDiffType = SignedLong;
+    SizeType = UnsignedLong;
+    SigAtomicType = SignedLong;
+    // `wchar_t` is the C library's `int` (musl DADAO port
+    // arch/dadao/bits/alltypes.h.in:29 `TYPEDEF int wchar_t;`).  `wint_t` is
+    // musl's `unsigned` (include/alltypes.h.in:37), so the two differ.
+    WCharType = SignedInt;
+    WIntType = UnsignedInt;
+
+    // `_Atomic` support (LLVM-121t).  The backend implements 1/2/4/8-byte
+    // atomics itself (lr/sc retry loops + explicit fences) and reports
+    // setMaxAtomicSizeInBitsSupported(64), so clang must agree: without this,
+    // MaxAtomicInlineWidth stays 0 and every atomic access is diagnosed as
+    // "large atomic operation ... exceeds the max lock-free size (0 bytes)".
+    MaxAtomicPromoteWidth = MaxAtomicInlineWidth = 64;
+
+    // `long double` is IEEE binary128 (ADR-0030 D1): 16 bytes, 16-byte
+    // aligned, 113-bit significand.  All arithmetic is compiler-rt soft float
+    // (`__addtf3` ..., ADR-0030 D3); the backend only carries the value as two
+    // 64-bit register halves (ADR-0030 D2).
+    LongDoubleWidth = LongDoubleAlign = 128;
+    LongDoubleFormat = &llvm::APFloat::IEEEquad();
+
+    // `__float128` (and the `_Float128` spelling where the language mode
+    // accepts it) is available and uses the same binary128 format (ADR-0030
+    // Context fact 2: the compiler-rt TF sources and the musl `_l`
+    // implementations both need the keyword to name the same type).
+    HasFloat128 = true;
+    Float128Format = &llvm::APFloat::IEEEquad();
+
+    // Maximum scalar alignment.  With a 16-byte scalar and the S128 stack
+    // alignment of the DADAO DataLayout (ADR-0018 C9/contract-abi §4.9), a
+    // 16-byte suitable alignment keeps over-aligned locals (and therefore the
+    // binary128 argument/return slots they live in) naturally aligned.
+    SuitableAlign = 128;
+
+    // Derive the DataLayout from the triple so it is byte-identical to the
+    // backend's (llvm/lib/TargetParser/TargetDataLayout.cpp, case
+    // Triple::dadao: "E-m:e-p:64:64-i64:64-i128:128-n8:16:32:64-S128").
+    resetDataLayout();
+  }
+
+  void getTargetDefines(const LangOptions &Opts,
+                        MacroBuilder &Builder) const override;
+
+  // Minimal feature set: the target itself, nothing else.
+  bool hasFeature(StringRef Feature) const override {
+    return Feature == "dadao";
+  }
+
+  llvm::SmallVector<Builtin::InfosShard> getTargetBuiltins() const override;
+
+  BuiltinVaListKind getBuiltinVaListKind() const override {
+    return TargetInfo::DADAOBuiltinVaList;
+  }
+
+  std::string_view getClobbers() const override { return ""; }
+
+  bool validateAsmConstraint(const char *&Name,
+                             TargetInfo::ConstraintInfo &Info) const override {
+    return false;
+  }
+
+  ArrayRef<const char *> getGCCRegNames() const override;
+  ArrayRef<GCCRegAlias> getGCCRegAliases() const override;
+};
+
+} // namespace targets
+} // namespace clang
+
+#endif // LLVM_CLANG_LIB_BASIC_TARGETS_DADAO_H
