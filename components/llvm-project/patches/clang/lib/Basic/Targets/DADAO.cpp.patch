+#include "DADAO.h"
+#include "clang/Basic/MacroBuilder.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/ADT/Twine.h"
+
+#include <string>
+#include <vector>
+
+using namespace clang;
+using namespace clang::targets;
+
+void DADAOTargetInfo::getTargetDefines(const LangOptions &Opts,
+                                       MacroBuilder &Builder) const {
+  // Architecture identity.  Everything else (__ELF__ for ELF objects, the
+  // LP64/sizeof/byte-order macro family, __SIZE_TYPE__/__PTRDIFF_TYPE__, …) is
+  // derived automatically from the triple + scalar model set in the header, so
+  // it is not duplicated here.
+  Builder.defineMacro("__dadao__");
+  Builder.defineMacro("__DADAO__");
+}
+
+ArrayRef<const char *> DADAOTargetInfo::getGCCRegNames() const {
+  // Four banks of 64 registers each (contract-abi.md §1.1 / §1.2 / §1.3 / §1.4).
+  // Built once; the backing std::strings live for the process lifetime.
+  static const std::vector<std::string> Names = [] {
+    std::vector<std::string> V;
+    for (const char *Bank : {"rd", "rb", "rf", "ra"})
+      for (int I = 0; I < 64; ++I)
+        V.push_back(std::string(Bank) + std::to_string(I));
+    return V;
+  }();
+  static const std::vector<const char *> Ptrs = [&] {
+    std::vector<const char *> P;
+    P.reserve(Names.size());
+    for (const std::string &S : Names)
+      P.push_back(S.c_str());
+    return P;
+  }();
+  return ArrayRef<const char *>(Ptrs);
+}
+
+ArrayRef<TargetInfo::GCCRegAlias> DADAOTargetInfo::getGCCRegAliases() const {
+  // ABI names for the architecturally named registers (contract-abi.md §1.2 /
+  // §1.3 / §1.5).  These are accepted wherever clang names a register (e.g.
+  // `register ... asm("rbsp")`).
+  static const TargetInfo::GCCRegAlias GCCRegAliases[] = {
+      {{"rdzero"}, "rd0"}, {{"rderrno"}, "rd1"}, {{"rbip"}, "rb0"},
+      {{"rbsp"}, "rb1"},   {{"rbgp"}, "rb2"},    {{"rbtp"}, "rb3"},
+      {{"rbfp"}, "rb63"},  {{"rasp"}, "ra63"},
+  };
+  return llvm::ArrayRef(GCCRegAliases);
+}
