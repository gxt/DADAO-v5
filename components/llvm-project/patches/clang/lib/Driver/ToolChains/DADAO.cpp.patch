+#include "DADAO.h"
+#include "clang/Driver/CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/InputInfo.h"
+#include "clang/Options/Options.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Support/Path.h"
+
+using namespace clang::driver;
+using namespace clang::driver::toolchains;
+using namespace clang::driver::tools;
+using namespace clang;
+using namespace llvm::opt;
+
+DADAOToolChain::DADAOToolChain(const Driver &D, const llvm::Triple &Triple,
+                               const ArgList &Args)
+    : Generic_ELF(D, Triple, Args) {
+  // clang/llc/ld.lld/llvm-mc live together in the install root's cross-toolchain
+  // bin/ (ADR-0016 D3/D4); make that bin/ the first place the driver looks.
+  getProgramPaths().push_back(getDriver().Dir);
+}
+
+std::string DADAOToolChain::computeSysRoot() const {
+  if (!getDriver().SysRoot.empty())
+    return getDriver().SysRoot;
+
+  // ADR-0016 D5: the target sysroot is a sibling of the host cross-toolchain.
+  // With clang installed at <root>/cross-toolchain/bin/clang, the sysroot is
+  // <root>/dadao-unknown-elf.
+  SmallString<128> Dir(getDriver().Dir);
+  llvm::sys::path::append(Dir, "..", "..", "dadao-unknown-elf");
+  if (llvm::sys::fs::exists(Dir))
+    return std::string(Dir);
+  return {};
+}
+
+void DADAOToolChain::addClangWarningOptions(ArgStringList &CC1Args) const {
+  // ADR-0031 D8b: `va_arg` with a type that does not match the default
+  // argument promotions (`va_arg(ap, float)`, `va_arg(ap, char)`) is definite
+  // undefined behavior; make it an error by default.  A user supplied
+  // `-Wno-error=varargs` comes later on the command line and downgrades it.
+  CC1Args.push_back("-Werror=varargs");
+}
+
+void DADAOToolChain::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                               ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  // Compiler-provided freestanding headers (stddef.h, stdint.h, ...).
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> Dir(getDriver().ResourceDir);
+    llvm::sys::path::append(Dir, "include");
+    addSystemInclude(DriverArgs, CC1Args, Dir.str());
+  }
+
+  if (DriverArgs.hasArg(options::OPT_nostdlibinc))
+    return;
+
+  std::string SysRoot = computeSysRoot();
+  if (!SysRoot.empty()) {
+    SmallString<128> Dir(SysRoot);
+    llvm::sys::path::append(Dir, "include");
+    addSystemInclude(DriverArgs, CC1Args, Dir.str());
+  }
+}
+
+Tool *DADAOToolChain::buildLinker() const {
+  return new tools::dadao::Linker(*this);
+}
+
+void DADAOToolChain::addClangTargetOptions(const ArgList &DriverArgs,
+                                           ArgStringList &CC1Args, BoundArch,
+                                           Action::OffloadKind) const {
+  // Do not fall back to the host's /usr/include search paths; only the
+  // freestanding builtin headers and the target sysroot (added above) apply.
+  CC1Args.push_back("-nostdsysteminc");
+}
+
+void dadao::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                 const InputInfo &Output,
+                                 const InputInfoList &Inputs,
+                                 const ArgList &Args,
+                                 const char *LinkingOutput) const {
+  const ToolChain &TC = getToolChain();
+  ArgStringList CmdArgs;
+
+  // DADAO is freestanding (ADR-0016 D5): no CRT objects and no C library are
+  // added implicitly.  Linker-script/-L/-e/-u/-r flags are forwarded directly;
+  // the driver itself already hands `-Wl,<arg>` / `-Xlinker <arg>` through to
+  // the linker command, so they are not repeated here.
+  //
+  // `-shared` / `-static` / `-pie` are different: the *driver* consumes them
+  // (they are MachineOutputFlags deciding the output kind), so they never reach
+  // the linker through the `-Wl,` path above and nothing would forward them.
+  // Dropping them silently is exactly the ISS-239 bug -- `clang -shared` then
+  // only warns `-Wunused-command-line-argument` and links an ET_EXEC with no
+  // `.dynamic` section, so a shared-object build looks successful while
+  // producing an executable (a "not supported" case must fail loudly, not
+  // quietly change the output kind).  Forward the three flags verbatim; ld.lld
+  // validates their combinations itself (`-shared` + `-pie` etc.).
+  Args.addAllArgs(CmdArgs,
+                  {options::OPT_T, options::OPT_L, options::OPT_e,
+                   options::OPT_u, options::OPT_s, options::OPT_r,
+                   options::OPT_shared, options::OPT_static, options::OPT_pie});
+  TC.AddFilePathLibArgs(Args, CmdArgs);
+  AddLinkerInputs(TC, Inputs, Args, CmdArgs, JA);
+
+  // Compiler builtins (ADR-0027 D5, ISS-262).  The independent DADAO
+  // compiler-rt builtins archive is the *default* runtime library (see
+  // GetDefaultRuntimeLibType()), so it is appended after the user inputs even
+  // without any `-rtlib` flag: libcalls must be resolved by the toolchain, not
+  // by hand.  It is looked up through ToolChain::getCompilerRT, i.e. the same
+  // path that `-print-libgcc-file-name` reports.  `-rtlib=libgcc` still opts
+  // out (nothing is appended and `-print-libgcc-file-name` reports libgcc.a).
+  //
+  // Suppression follows the GNU driver (`Gnu.cpp`: AddRunTimeLibs sits under
+  // `!hasArg(nostdlib, r)` and `!hasArg(nodefaultlibs)`): `-nostdlib`,
+  // `-nodefaultlibs` and `-r` mean "no default libraries" and must not get the
+  // archive.  `-shared` is *not* such a switch -- upstream links the runtime
+  // library into shared objects too, since their libcalls cannot be resolved at
+  // load time -- so the archive is added there as well.  `-nostdlib++` only
+  // gates the C++ standard library (`CommonArgs.cpp`), not the runtime library.
+  if (TC.GetRuntimeLibType(Args) == ToolChain::RLT_CompilerRT &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs,
+                   options::OPT_r))
+    CmdArgs.push_back(
+        TC.getCompilerRTArgString(Args, "builtins", ToolChain::FT_Static));
+
+  CmdArgs.push_back("-o");
+  CmdArgs.push_back(Output.getFilename());
+
+  std::string Linker = TC.GetProgramPath("ld.lld");
+  C.addCommand(std::make_unique<Command>(
+      JA, *this, ResponseFileSupport::AtFileCurCP(), Args.MakeArgString(Linker),
+      CmdArgs, Inputs, Output));
+}
