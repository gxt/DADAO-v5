+#ifndef LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_DADAO_H
+#define LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_DADAO_H
+
+#include "Gnu.h"
+#include "clang/Driver/InputInfo.h"
+#include "clang/Driver/Tool.h"
+#include "clang/Driver/ToolChain.h"
+#include "llvm/Option/Option.h"
+
+namespace clang {
+namespace driver {
+namespace toolchains {
+
+/// DADAO freestanding (bare-metal ELF) toolchain.  There is no libc and no OS;
+/// the only jobs the driver must serve are `clang -c` (integrated assembler)
+/// and linking with `ld.lld` against the target sysroot (ADR-0016 D5).
+class LLVM_LIBRARY_VISIBILITY DADAOToolChain : public Generic_ELF {
+public:
+  DADAOToolChain(const Driver &D, const llvm::Triple &Triple,
+                 const llvm::opt::ArgList &Args);
+
+  void
+  AddClangSystemIncludeArgs(const llvm::opt::ArgList &DriverArgs,
+                            llvm::opt::ArgStringList &CC1Args) const override;
+  // D8b (ADR-0031): -Wvarargs is an error by default (va_arg with a type that
+  // does not match the default argument promotions is definite UB); a user
+  // supplied -Wno-error=varargs appears later on the command line and wins.
+  void addClangWarningOptions(llvm::opt::ArgStringList &CC1Args) const override;
+  void addClangTargetOptions(const llvm::opt::ArgList &DriverArgs,
+                             llvm::opt::ArgStringList &CC1Args, BoundArch BA,
+                             Action::OffloadKind DeviceOffloadKind) const override;
+
+  // Position independence (LLVM-094t): the default stays static (M4 bare-metal
+  // path), but -fPIC/-fPIE are honoured instead of being silently ignored.
+  // Forcing static here (isPICDefaultForced() == true) made `clang -fPIC` emit
+  // *static* code -- an absolute-address materialization that cannot be loaded
+  // at a non-zero base -- while still exiting 0.  Both flags select
+  // Reloc::PIC_ (PIE-ness is a clang PIELevel, not a relocation model), which
+  // is the only position-independent model the DADAO ABI maps onto
+  // (contract-dynlink.md §2-§3, ADR-0026 D5).
+  bool isPICDefault() const override { return false; }
+  bool isPIEDefault(const llvm::opt::ArgList &) const override { return false; }
+  bool isPICDefaultForced() const override { return false; }
+  UnwindLibType GetUnwindLibType(const llvm::opt::ArgList &) const override {
+    return UNW_None;
+  }
+  // Runtime library default (ADR-0027 D5 / ISS-262): link the independent DADAO
+  // compiler-rt builtins archive unless the user asks for `-rtlib=libgcc`
+  // (which selects the absent libgcc path and appends nothing).
+  RuntimeLibType GetDefaultRuntimeLibType() const override {
+    return ToolChain::RLT_CompilerRT;
+  }
+  bool isBareMetal() const override { return true; }
+  bool isCrossCompiling() const override { return true; }
+  bool HasNativeLLVMSupport() const override { return true; }
+  bool SupportsProfiling() const override { return false; }
+
+protected:
+  Tool *buildLinker() const override;
+
+private:
+  std::string computeSysRoot() const override;
+};
+
+} // end namespace toolchains
+
+namespace tools {
+namespace dadao {
+
+class LLVM_LIBRARY_VISIBILITY Linker final : public Tool {
+public:
+  Linker(const ToolChain &TC) : Tool("DADAO::Linker", "ld.lld", TC) {}
+  bool hasIntegratedCPP() const override { return false; }
+  bool isLinkJob() const override { return true; }
+  void ConstructJob(Compilation &C, const JobAction &JA,
+                    const InputInfo &Output, const InputInfoList &Inputs,
+                    const llvm::opt::ArgList &TCArgs,
+                    const char *LinkingOutput) const override;
+};
+
+} // end namespace dadao
+} // end namespace tools
+} // end namespace driver
+} // end namespace clang
+
+#endif // LLVM_CLANG_LIB_DRIVER_TOOLCHAINS_DADAO_H
