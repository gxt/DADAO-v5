+namespace {
+class DADAO final : public TargetInfo {
+public:
+  DADAO(Ctx &ctx) : TargetInfo(ctx) {
+    // DADAO has no IRELATIVE-style (symbol-based) relocation: "recompile with
+    // -fPIC" would otherwise be triggered for every R_DADAO_ABS48 because the
+    // default iRelSymbolicRel sentinel is 0 and 0 is R_DADAO_NONE.  Use the
+    // R_DADAO_NUM count value as a sentinel that never matches a real reloc
+    // (ADR-0019 D10/D12: R_DADAO_NUM = 16).
+    iRelSymbolicRel = R_DADAO_NUM;
+    defaultMaxPageSize = 0x10000;  // DADAO page = 64 KiB (DADAO-12 §2.2.2)
+
+    // Dynamic relocation types (ADR-0019 D10, contract-dynlink.md §4.3).
+    // A slot holding an absolute 48-bit symbol address reuses ABS48 in its data
+    // form; there is no separate GLOB_DAT (contract-dynlink.md §4.3).
+    symbolicRel = R_DADAO_ABS48;
+    gotRel = R_DADAO_ABS48;
+    pltRel = R_DADAO_JUMP_SLOT;
+    relativeRel = R_DADAO_RELATIVE;
+    copyRel = R_DADAO_COPY;
+
+    // TLS dynamic relocation types (LLVM-117t; contract-dynlink.md §4.3,
+    // ADR-0019 D10): 10 = module TLS id, 11 = module-relative offset, 12 =
+    // TP-relative offset.  These name the *slot content* kinds, which is what
+    // lld's generic TLS GOT machinery would use; the DADAO compiler emits the
+    // slots itself, so scanSection() below applies the same three types to the
+    // input records instead (nothing here sets NEEDS_TLSIE/NEEDS_TLSGD).
+    tlsModuleIndexRel = R_DADAO_TLS_DTPMOD;
+    tlsOffsetRel = R_DADAO_TLS_DTPREL;
+    tlsGotRel = R_DADAO_TLS_TPREL;
+
+    // PLT: eager binding only (ADR-0026 D6).  The loader fills every .got.plt
+    // slot before the program starts, so there is no lazy resolver and hence no
+    // PLT header (PltSection::writeTo calls writePltHeader() into the buffer and
+    // then starts the entries at headerSize == 0).  gotPltHeaderEntriesNum
+    // keeps the psABI GOT[0]/GOT[1] reservation: index 0 names .dynamic, index
+    // 1 is unused without lazy binding.
+    //
+    // Entry size 12 = the three instructions of writePlt, i.e. one 4-byte
+    // instruction word per entry slot (ADR-0029 D5).  There is no in-entry data
+    // slot any more: the stub's PC-relative hi/lo pair reaches ±512 MiB, so the
+    // entry no longer has to carry the `.got.plt` distance in a constant.
+    pltEntrySize = 12;
+    pltHeaderSize = 0;
+    gotPltHeaderEntriesNum = 2;
+  }
+
+  uint32_t calcEFlags() const override;
+  RelExpr getRelExpr(RelType type, const Symbol &s,
+                     const uint8_t *loc) const override;
+  RelType getDynRel(RelType type) const override;
+  void writeGotPltHeader(uint8_t *buf) const override;
+  void writeGotPlt(uint8_t *buf, const Symbol &s) const override;
+  void writePlt(uint8_t *buf, const Symbol &sym,
+                uint64_t pltEntryAddr) const override;
+  void relocate(uint8_t *loc, const Relocation &rel,
+                uint64_t val) const override;
+  void relocateAlloc(InputSection &sec, uint8_t *buf) const override;
+  void scanSection(InputSectionBase &sec, unsigned shard) override;
+
+private:
+  void relocateInSection(uint8_t *loc, const Relocation &rel, uint64_t val,
+                         bool isExec) const;
+  template <class ELFT>
+  void scanSection1(InputSectionBase &sec, unsigned shard);
+  template <class ELFT, class RelTy>
+  void scanSectionImpl(InputSectionBase &sec, Relocs<RelTy> rels,
+                       unsigned shard);
+};
+} // namespace
+
+// Pairing lookup for the PC-relative hi/lo pair (ADR-0029 D2/D3,
+// contract-elf.md §3.1/§3.2).
+//
+// The low record is not an address of its own: its symbol+addend carry the
+// *pairing information*, i.e. they locate the `aip.si` site whose record is the
+// high half (the RISC-V `%pcrel_lo(label)` convention -- the assembler folds the
+// site label into section symbol + addend = site address, and a named local
+// label would resolve to the same section offset, so both shapes work here).
+// Both halves then share the same P = that site address; the low half's own
+// instruction address never enters the formula, which is why it cannot be
+// resolved from the low record alone.
+//
+// Every way of failing is an error: pairing information that does not point into
+// a section / points into a different section / has no high record / reaches a
+// high record that is not a `aip.si`.  Staying silent would encode a wrong
+// address (ADR-0019 D6; ADR-0029 D3).
+static const Relocation *findPcrelHi(Ctx &ctx, const InputSection &sec,
+                                     const Relocation &loRel) {
+  const auto *d = dyn_cast<Defined>(loRel.sym);
+  if (!d || !d->section) {
+    Err(ctx) << sec.getLocation(loRel.offset)
+             << ": R_DADAO_PCREL_LO pairing information does not point into a "
+                "section (expected the paired `aip.si` site)";
+    return nullptr;
+  }
+  if (d->section != &sec) {
+    Err(ctx) << sec.getLocation(loRel.offset)
+             << ": R_DADAO_PCREL_LO pairing information points into section '"
+             << d->section->name << "' instead of '" << sec.name << "'";
+    return nullptr;
+  }
+  const uint64_t site = d->value + loRel.addend;
+  for (const Relocation &rel : sec.relocs()) {
+    if (rel.offset != site)
+      continue;
+    if (rel.type != R_DADAO_PCREL_HI) {
+      Err(ctx) << sec.getLocation(loRel.offset)
+               << ": R_DADAO_PCREL_LO pairs with relocation " << rel.type
+               << " at the site; expected R_DADAO_PCREL_HI";
+      return nullptr;
+    }
+    // "落点不符" (landing mismatch, contract-elf.md §3.2): the site must
+    // really be an `aip.si` (op 8-bit = 0x5A), i.e. the high field must live
+    // in an imms18 (contract-elf.md §2.2/§3.2).  The instruction-word test
+    // doubles as a guard against a site label that landed in data or in the
+    // middle of an instruction.
+    const uint32_t siteInsn =
+        read32be(sec.content().data() + rel.offset);
+    if ((siteInsn >> 24) != 0x5A) {
+      Err(ctx) << sec.getLocation(loRel.offset)
+               << ": R_DADAO_PCREL_LO points at the PC-relative high half of "
+                  "location 0x"
+               << utohexstr(site) << ", which is not a `aip.si` instruction "
+                                    "(opcode 0x"
+               << utohexstr(siteInsn >> 24) << ")";
+      return nullptr;
+    }
+    return &rel;
+  }
+  Err(ctx) << sec.getLocation(loRel.offset)
+           << ": R_DADAO_PCREL_LO points at offset 0x" << utohexstr(site)
+           << " without an associated R_DADAO_PCREL_HI relocation";
+  return nullptr;
+}
+
+// PLT entry layout (pltEntrySize == 12, see writePlt): three 4-byte
+// instructions, no in-entry constant (ADR-0029 D5).
+
+static uint32_t getEFlags(Ctx &ctx, InputFile *f) {
+  return cast<ObjFile<ELF64BE>>(f)->getObj().getHeader().e_flags;
+}
+
+uint32_t DADAO::calcEFlags() const {
+  // The object/ABI format version is 1 in bits 0–7; bits 8–31 are reserved and
+  // must be zero.  A consumer must reject any other value (contract-elf.md
+  // §1.3, ADR-0003 §D1).  The linked ET_EXEC carries e_flags = 0x1.
+  for (InputFile *f : ctx.objectFiles) {
+    uint32_t eflags = getEFlags(ctx, f);
+    if (eflags != 0x1)
+      Err(ctx) << f << ": unsupported DADAO e_flags 0x" << utohexstr(eflags)
+               << "; expected 0x1 (ABI version 1, reserved bits clear)";
+  }
+  return 0x1;
+}
+
+RelExpr DADAO::getRelExpr(RelType type, const Symbol &s,
+                          const uint8_t *loc) const {
+  // Structures the first implementation must not emit are rejected here, at
+  // scan time, so that the user sees a diagnostic instead of a silently broken
+  // output (ADR-0026 D7②, contract-dynlink.md §10②).
+  //
+  //  * GNU IFUNC: the resolver machinery (`.iplt` + IRELATIVE) is not
+  //    implemented (ipltEntrySize == 0, iRelativeRel == 0).  An IFUNC
+  //    reference would otherwise produce an empty/invalid PLT entry whose
+  //    IRELATIVE relocation has type 0 == R_DADAO_NONE, i.e. a silent no-op.
+  if (s.isGnuIFunc())
+    Err(ctx) << getErrorLoc(ctx, loc) << "GNU IFUNC symbol '" << s.getName()
+             << "' is not supported (no `.iplt`/IRELATIVE; ADR-0026 D7②)";
+  //  * Copy relocation (`R_DADAO_COPY`): rejected where lld decides it is
+  //    needed (Relocations.cpp, `NEEDS_COPY`) -- the rejection site is the copy
+  //    relocation itself, not this hook, because a relocation against an object
+  //    defined in a DSO is perfectly legal here when it has a dynamic form
+  //    (`getDynRel() != 0`, e.g. the ABS48 GOT-slot form).
+  switch (type) {
+  case R_DADAO_ABS48:
+    // Absolute 48-bit address (S + A); never PC-relative.
+    return R_ABS;
+  case R_DADAO_REL26:
+    // `call` / `jump` (iiii).  Modelled as R_PLT_PC so that a call to a
+    // preemptible or imported function is routed through a PLT entry (a shared
+    // object cannot encode the final address in a PC-relative field).  lld
+    // lowers R_PLT_PC back to R_PC for non-preemptible symbols, so ordinary
+    // intra-module branches are unaffected (Relocations.cpp `fromPlt`).
+    return R_PLT_PC;
+  case R_DADAO_REL20:
+  case R_DADAO_REL14:
+  case R_DADAO_REL12:
+    // PC-relative.  For REL20/14 the field is a (S + A - P) >> 2 word offset;
+    // for REL12 it is the raw byte offset S + A - P (rb0 reads the current
+    // instruction address, contract-elf.md §3.1 / ADR-0021 §D1).
+    return R_PC;
+  case R_DADAO_ABS12:
+    // Base-relative symbol displacement: S + A (byte offset, imms12).
+    return R_ABS;
+  case R_DADAO_PCREL_HI:
+  case R_DADAO_PCREL_LO:
+    // PC-relative hi/lo pair (ADR-0029 D2/D4).
+    //
+    // The high record's own value is S + A - P (P = the `aip.si` site), so it
+    // is an ordinary PC-relative relocation and is modelled as R_PC; its target
+    // is the GOT slot the assembler/compiler named.
+    //
+    // The low record is *also* reported as R_PC (it is a PC-relative byte
+    // residual), but its value is not taken from its own symbol: relocateAlloc
+    // resolves it through the pairing information (findPcrelHi) and reuses the
+    // high half's S + A - P, since both halves must use the same P
+    // (contract-elf.md §3.1).  Reporting R_PC is what keeps the pair a static
+    // link-time constant in PIC links too (R_PC is a "sym - position"
+    // expression), so no dynamic relocation is created for it.
+    //
+    // A preemptible symbol cannot be encoded here: the pair patches instruction
+    // fields in the module's own text, which no loader can do (there is no
+    // dynamic relocation type for it, and an interposable address is not a
+    // link-time constant).  Fail loudly instead of emitting a dynamic record
+    // that would be ignored (ADR-0026 D7②, ADR-0029 D3).
+    if (s.isPreemptible)
+      Err(ctx) << getErrorLoc(ctx, loc) << "relocation " << type
+               << " against preemptible symbol '" << s.getName()
+               << "' cannot be encoded: the PC-relative hi/lo pair patched into "
+                  "instructions must resolve at link time (ADR-0029 D2/D3); "
+                  "reference the symbol's GOT slot instead";
+    return R_PC;
+  case R_DADAO_COPY:
+  case R_DADAO_TLSDESC:
+    // Numbered by ADR-0019 D10 but **not emitted** by this implementation; a
+    // silent skip (or a silent zero) would only surface at load time, so fail
+    // loudly at scan time (ADR-0026 D7②, contract-dynlink.md §10②).
+    Err(ctx) << getErrorLoc(ctx, loc) << "relocation type " << type
+             << " is not emitted by the DADAO linker (ADR-0026 D7②)";
+    return R_NONE;
+  case R_DADAO_TLS_DTPMOD:
+  case R_DADAO_TLS_DTPREL:
+  case R_DADAO_TLS_TPREL:
+    // TLS slot contents (LLVM-117t; contract-dynlink.md §4.3).  These records
+    // are produced by the compiler for its `.got` slots and are consumed by
+    // scanSection() below, which decides whether the slot is a link-time
+    // constant or needs a dynamic relocation; the generic expression path is
+    // never asked for them.  Returning R_NONE here keeps this hook honest
+    // without reintroducing the old blanket rejection.
+    return R_NONE;
+  default:
+    Err(ctx) << getErrorLoc(ctx, loc) << "unknown relocation (" << type.v
+             << ") against symbol " << &s;
+    return R_NONE;
+  }
+}
+
+RelType DADAO::getDynRel(RelType type) const {
+  // An input relocation that carries an absolute 48-bit address in a data/GOT
+  // slot has to be resolved at load time unless the symbol is non-preemptible
+  // (in which case lld turns it into a RELATIVE relocation, see
+  // Relocations.cpp processAux()).  The dynamic type is ABS48 itself: the data
+  // form is shared by symbol and GOT slots (contract-dynlink.md §4.3).
+  if (type == R_DADAO_ABS48)
+    return R_DADAO_ABS48;
+  return 0;
+}
+
+void DADAO::writeGotPltHeader(uint8_t *buf) const {
+  // GOT[0] names the .dynamic section (psABI convention); GOT[1] is only used
+  // by lazy resolvers, which DADAO does not have (ADR-0026 D6).
+  write64be(buf, ctx.in.dynamic ? ctx.in.dynamic->getVA() : 0);
+  write64be(buf + 8, 0);
+}
+
+void DADAO::writeGotPlt(uint8_t *buf, const Symbol &s) const {
+  // Eager binding: the loader overwrites every PLT slot with the resolved
+  // address before the program starts, so there is no resolver back-pointer to
+  // store here (unlike lazy-binding targets).  Write a deterministic zero.
+  write64be(buf, 0);
+}
+
+void DADAO::writePlt(uint8_t *buf, const Symbol &sym,
+                     uint64_t pltEntryAddr) const {
+  // Eager PLT entry (ADR-0026 D6): three instructions / 12 bytes, no in-entry
+  // data slot (ADR-0029 D5).  The stub forms the slot address PC-relatively
+  // through the auipc-style pair and jumps to the value loaded from it:
+  //
+  //   +0   aip.si rb4, hi         ; rb4 = IP + (hi << 12)  (hi = 4 KiB blocks)
+  //   +4   ld.o    rb4, [rb4, lo]  ; rb4 = *(rb4 + lo) = *(slot)
+  //   +8   jump    [rb4, rd0, 0]   ; jump to the resolved address
+  //
+  // The linker synthesizes the entry -- it owns both ends of the distance -- so
+  // it computes hi/lo itself and no relocation record is involved, exactly as
+  // ADR-0028 D7 prescribed for the removed data-slot form (ADR-0029 D5).  Here
+  // P = the entry address = the `aip.si` site, and the 18-bit high field gives
+  // the pair a ±512 MiB reach.  That reach is what makes the in-entry constant
+  // unnecessary: `.plt` and `.got.plt` live in different segments and their
+  // distance is a link-time constant far beyond the 12-bit immediate the old
+  // form had to work around by carrying it inside the entry (and beyond the
+  // ±2 KiB of DADAO's only single-instruction PC-relative access, `ld.o` with
+  // base rb0 -- see ADR-0029 D3/D4).
+  //
+  // rb4 is a spec temporary register (rb4-rb7, caller-saved), so the stub
+  // clobbers nothing that a caller or callee relies on; it never touches RB
+  // other than rb4, RegRAS or SP, so the return address pushed by the caller's
+  // `call` is popped correctly by the callee's `ret`.  rb4 is allocatable and
+  // not reserved (rb0-rb3 = IP/SP/GP/TP), so it may appear as a destination.
+  assert((pltEntryAddr % 4) == 0 && "PLT entry must be 4-byte aligned");
+
+  // P = the aip.si site, so this is the same "distance to the slot" the pair
+  // encodes at run time (contract-elf.md §3.1).  The +0x800 rounds the high
+  // field to the nearest 4 KiB multiple so the residual always fits the signed
+  // 12-bit low field.
+  const int64_t disp = static_cast<int64_t>(sym.getGotPltVA(ctx) - pltEntryAddr);
+  const int64_t hi = (disp + 0x800) >> 12;
+  const int64_t lo = disp - (hi << 12);
+  if (!isInt<18>(hi) || !isInt<12>(lo)) {
+    // Out of reach is a link-time error, never a truncated stub (ADR-0019 D6,
+    // ADR-0029 D3).
+    Err(ctx) << "PLT entry for " << &sym
+             << " is out of the +/-512 MiB reach of the PC-relative stub "
+                "(ADR-0029 D3/D5)";
+    return;
+  }
+
+  // aip.si rb4, imms18: op 0x5A, ha (dst) = rb4 at bits[23:18], imms18 at
+  // bits[17:0] (DADAORiii, contract-isa.md §2).  The field is the 4 KiB block
+  // count (the assembler-level operand is the byte value: imms30 = hi << 12).
+  write32be(buf + 0,
+            0x5A000000u | (4u << 18) | (static_cast<uint32_t>(hi) & 0x3FFFFu));
+  // ld.o rb4, [rb4, imms12]: op 0x22, ha (dst) = rb4 at bits[23:18], hb (base)
+  // = rb4 at bits[17:12], imms12 at bits[11:0] (DADAORrii).  The pair's `rbX`
+  // is the same register as the high half's destination (ADR-0029 D4).
+  write32be(buf + 4, 0x22000000u | (4u << 18) | (4u << 12) |
+                         (static_cast<uint32_t>(lo) & 0xFFFu));
+  // jump [rb4, rd0, 0]: op 0x71, rbha = rb4, rdhb = rd0 (reads 0), imms12 = 0.
+  write32be(buf + 8, 0x71000000u | (4u << 18));
+}
+
+void DADAO::relocateInSection(uint8_t *loc, const Relocation &rel,
+                              uint64_t val, bool isExec) const {
+  // A PC-relative branch/jump/call to an *undefined weak* symbol (LLVM-085t).
+  //
+  // ELF weak semantics give such a symbol the value 0, and that displacement
+  // cannot be encoded from P: the DADAO image lives at 0xFC00_0000_0000, so
+  // "distance to 0" is ~2^47, far outside the 26-bit field.  No veneer fixes
+  // this either -- a thunk reachable from P cannot reach address 0 itself.
+  //
+  // Resolve the *place* instead, following the RISC-V convention for
+  // relative-only ISAs: the branch target is P + A itself, i.e. the
+  // instruction becomes a self-loop.  A stray call to an unimplemented weak
+  // hook (picolibc uses this for optional platform hooks such as
+  // `_user_strerror` / `gettimeofday` / `arc4random_abort`, all guarded by
+  // `&sym == 0`) is then visible as a hang instead of silently overflowing the
+  // immediate field.
+  //
+  // REL26 sites may be `call`, and DADAO `call` pushes a return address on the
+  // RegRAS that the never-defined callee can never pop -- an enclosing `ret`
+  // would pop that stale entry and corrupt the return chain.  The instruction
+  // is therefore rewritten to the non-calling `jump` form, i.e.
+  // `call [rb0, 0]` becomes `jump [rb0, 0]`.
+  //
+  // The exception covers exactly the undefined-weak case: a strong or defined
+  // symbol that is out of range is still a link-time error (contract-elf.md
+  // §3.2, ADR-0019 §D6).  Non-branch PC-relative relocations (REL12) keep the
+  // strict path.
+  //
+  // The test is `isUndefined()`, not `isUndefWeak()`: lld converts the binding
+  // of a *hidden* undefined symbol to local, so `isWeak()` is then false even
+  // though such a reference is an undefined weak reference in source.  This
+  // mirrors lld's own cross-target handling (`InputSection.cpp`, the R_PC case:
+  // ARM/AArch64/PPC/RISC-V all branch on `sym->isUndefined()`).  A *strong*
+  // undefined symbol never benefits: lld rejects it earlier with the ordinary
+  // "undefined symbol" error, and a defined-but-far symbol still fails the
+  // range check below.
+  //
+  // The rewrite is restricted to `rel.expr == R_PC`: in a dynamic link an
+  // undefined function is reached through its PLT entry (R_PLT_PC, see
+  // getRelExpr), and `val` there is the PLT address, not a symbol address --
+  // rewriting that to a self-loop would discard a perfectly resolvable call.
+  const bool undefBranch =
+      rel.expr == R_PC && rel.sym->isUndefined() &&
+      (rel.type == R_DADAO_REL26 || rel.type == R_DADAO_REL20 ||
+       rel.type == R_DADAO_REL14);
+  if (undefBranch)
+    val = static_cast<uint64_t>(rel.addend); // target = P + A (self-loop)
+  switch (rel.type) {
+  case R_DADAO_REL26:
+  case R_DADAO_REL20:
+  case R_DADAO_REL14: {
+    // field = (S + A - P) >> 2  (word offset; no -4 in v5).
+    int64_t disp = static_cast<int64_t>(val);
+    if (disp & 0x3) {
+      Err(ctx) << getErrorLoc(ctx, loc) << "improper alignment for relocation "
+               << rel.type << ": 0x" << utohexstr(static_cast<uint64_t>(disp))
+               << " is not a multiple of 4";
+      return;
+    }
+    int64_t imm = disp >> 2;
+
+    unsigned width;
+    uint32_t mask;
+    switch (rel.type) {
+    case R_DADAO_REL26:
+      width = 24; // imms24
+      mask = 0x00FFFFFFu;
+      break;
+    case R_DADAO_REL20:
+      width = 18; // imms18
+      mask = 0x0003FFFFu;
+      break;
+    default:
+      width = 12; // imms12
+      mask = 0x00000FFFu;
+      break;
+    }
+    // Out of range => link-time error (no truncation / wrap).
+    checkInt(ctx, loc, imm, width, rel);
+
+    uint32_t insn = read32be(loc);
+    if (undefBranch && rel.type == R_DADAO_REL26) {
+      // Undefined weak call: drop the RegRAS push by rewriting the opcode
+      // call-iiii (0x74) -> jump-iiii (0x70) (contracts/opcodes.yaml:
+      // call_iiii_ra op 0x74 / jump_iiii_rb op 0x70; both mask 0xFF000000).
+      uint32_t op = insn & 0xFF000000u;
+      if (op == 0x74000000u)
+        insn = (insn & 0x00FFFFFFu) | 0x70000000u;
+      else if (op != 0x70000000u) {
+        Err(ctx) << getErrorLoc(ctx, loc) << "undefined weak R_DADAO_REL26 on a "
+                    "non call/jump instruction (opcode 0x"
+                 << utohexstr(op) << ")";
+        return;
+      }
+    }
+    insn = (insn & ~mask) | (static_cast<uint32_t>(imm) & mask);
+    write32be(loc, insn);
+    return;
+  }
+  case R_DADAO_ABS48:
+    // Absolute address must fit in 48 bits (the address space is 48-bit).
+    checkIntUInt(ctx, loc, val, 48, rel);
+    if (isExec) {
+      // Instruction path: write the 16-bit wyde selected by the instruction's
+      // wyde-position wp (hb[5:4] = bits[17:16]); opcode and register fields
+      // are preserved.
+      uint32_t insn = read32be(loc);
+      unsigned wp = (insn >> 16) & 0x3;
+      uint32_t slice = static_cast<uint32_t>(val >> (16 * wp)) & 0xFFFFu;
+      insn = (insn & 0xFFFF0000u) | slice;
+      write32be(loc, insn);
+    } else {
+      // Data path: a single 8-byte absolute address field, big-endian with the
+      // top 16 bits zero (48-bit address; contract-elf.md §3.1 / ADR-0019 §D2).
+      // checkIntUInt above already proved val < 2^48, so masking is explicit
+      // documentation of the invariant.
+      write64be(loc, val & 0x0000FFFFFFFFFFFFULL);
+    }
+    return;
+  case R_DADAO_JUMP_SLOT:
+  case R_DADAO_RELATIVE:
+    // Dynamic slots in .got.plt / .got: both are single 8-byte fields holding an
+    // absolute 48-bit address, so the data form of ABS48 applies verbatim
+    // (contract-dynlink.md §4.3: `JUMP_SLOT` = S + A, `RELATIVE` = B + A, both
+    // unsigned 48-bit).  lld only reaches this through the addend-writing path
+    // (--apply-dynamic-relocs) or a static-PIE link; the loader is otherwise
+    // the one that applies these.
+    checkIntUInt(ctx, loc, val, 48, rel);
+    write64be(loc, val & 0x0000FFFFFFFFFFFFULL);
+    return;
+  case R_DADAO_COPY:
+  case R_DADAO_TLSDESC:
+    // Reserved by ADR-0019 D10, but this implementation must not emit them: a
+    // silent skip (or a silent zero) would only surface at load time.  Fail
+    // loudly instead (ADR-0026 D7②, contract-dynlink.md §10②).
+    Err(ctx) << getErrorLoc(ctx, loc) << "relocation type " << rel.type
+             << " is not emitted by the DADAO linker (ADR-0026 D7)";
+    return;
+  case R_DADAO_TLS_DTPMOD:
+  case R_DADAO_TLS_DTPREL:
+  case R_DADAO_TLS_TPREL: {
+    // Dynamic TLS slot contents (LLVM-117t; contract-dynlink.md §4.3): a single
+    // 8-byte field per slot, big-endian like every other data slot.
+    //
+    //   10 DTPMOD = the module's TLS id (loader-assigned, >= 1)
+    //   11 DTPREL = DTPOFF(sym) + A, two's complement
+    //   12 TPREL  = TPOFF(sym) + A, two's complement (may be negative)
+    //
+    // The two offset classes are signed: writing them masked to 48 bits would
+    // turn a negative TPOFF into a huge positive one, so the value is written
+    // as a sign-extended 64-bit two's complement and only *range-checked* to
+    // 48 bits (contract-dynlink.md §4.3/§10③: an out-of-range TP + TPOFF is an
+    // error, never a wrap).
+    if (rel.type == R_DADAO_TLS_DTPMOD) {
+      checkIntUInt(ctx, loc, val, 48, rel);
+      write64be(loc, val);
+      return;
+    }
+    const int64_t disp = static_cast<int64_t>(val);
+    checkInt(ctx, loc, disp, 48, rel);
+    write64be(loc, static_cast<uint64_t>(disp));
+    return;
+  }
+  case R_DADAO_REL12:
+  case R_DADAO_ABS12: {
+    // ld.*/st.* symbol displacement: a single in-place imms12 BYTE offset
+    // (Inst{11:0}; rrii hc[5:0]+hd[5:0]).  REL12 is PC-relative (val = S + A -
+    // P), ABS12 is base-relative (val = S + A); neither is shifted by 2.
+    // Out of the signed 12-bit range (-2048..+2047) => link-time error, no
+    // truncation / wrap (contract-elf.md §3.2, ADR-0021 §D3).
+    int64_t disp = static_cast<int64_t>(val);
+    checkInt(ctx, loc, disp, 12, rel);
+    uint32_t insn = read32be(loc);
+    insn = (insn & ~0x00000FFFu) | (static_cast<uint32_t>(disp) & 0x00000FFFu);
+    write32be(loc, insn);
+    return;
+  }
+  case R_DADAO_PCREL_HI:
+  case R_DADAO_PCREL_LO: {
+    // PC-relative hi/lo pair (ADR-0029 D2; contract-elf.md §3.1/§3.2).
+    //
+    //   field(hi) = ((S + A - P) + 0x800) >> 12   [aip.si imms18, rounded]
+    //   field(lo) = (S + A - P) - (field(hi) << 12)   [ld.o imms12, signed]
+    //
+    // Both halves see the same val = S + A - P with P = the `aip.si` site: for
+    // the high half val comes from its own record, for the low half from the
+    // paired high record (see relocateAlloc/findPcrelHi).  The +0x800 rounding
+    // is what makes the residual fit the signed 12-bit low field -- truncation
+    // would reach +4095 and overflow it (ADR-0029 D2).
+    const int64_t disp = static_cast<int64_t>(val);
+    const int64_t hi = (disp + 0x800) >> 12;
+    const int64_t lo = disp - (hi << 12);
+
+    if (rel.type == R_DADAO_PCREL_HI) {
+      // "越界" (out of range, contract-elf.md §3.2): the high field must fit
+      // imms18 (18-bit signed) -- also the ±512 MiB reach limit of the pair
+      // (ADR-0029 D3).
+      checkInt(ctx, loc, hi, 18, rel);
+      uint32_t insn = read32be(loc);
+      // "落点不符" (landing mismatch, contract-elf.md §3.2): the high half
+      // only exists in `aip.si`'s imms18 (op 0x5A, bits[17:0]); anywhere else
+      // there is no field to patch.
+      if ((insn >> 24) != 0x5A) {
+        Err(ctx) << getErrorLoc(ctx, loc)
+                 << "R_DADAO_PCREL_HI is not at an `aip.si` site (opcode 0x"
+                 << utohexstr(insn >> 24) << "); the high field is the "
+                 << "imms18 of `aip.si` (ADR-0029 D2/§3.2)";
+        return;
+      }
+      insn = (insn & ~0x0003FFFFu) | (static_cast<uint32_t>(hi) & 0x0003FFFFu);
+      write32be(loc, insn);
+      return;
+    }
+
+    // "越界" (out of range, contract-elf.md §3.2): the residual must fit the
+    // signed 12-bit low field (it does by construction; checked so an
+    // inconsistency is never silently masked).
+    checkInt(ctx, loc, lo, 12, rel);
+    uint32_t insn = read32be(loc);
+    // "落点不符" (landing mismatch, contract-elf.md §3.2): the low half lives
+    // in the imms12 of the paired `ld.o`/`st.o` base-register form (op 0x22 /
+    // 0x23), whose base is the same rbX the high half wrote (ADR-0029 D4).
+    const unsigned op = insn >> 24;
+    if (op != 0x22 && op != 0x23) {
+      Err(ctx) << getErrorLoc(ctx, loc)
+               << "R_DADAO_PCREL_LO is not at a paired `ld.o`/`st.o` site "
+                  "(opcode 0x"
+               << utohexstr(op) << "); the low field is that instruction's "
+               << "imms12 (ADR-0029 D2/§3.2)";
+      return;
+    }
+    insn = (insn & ~0x00000FFFu) | (static_cast<uint32_t>(lo) & 0x00000FFFu);
+    write32be(loc, insn);
+    return;
+  }
+  default:
+    Err(ctx) << getErrorLoc(ctx, loc) << "unknown relocation (" << rel.type.v
+             << ") against symbol " << rel.sym;
+    return;
+  }
+}
+
+void DADAO::relocate(uint8_t *loc, const Relocation &rel, uint64_t val) const {
+  // Entry point used by relocateNoSym()/non-alloc sections.  DADAO ABS48
+  // relocations in allocatable sections go through relocateAlloc() below,
+  // which knows whether the target section is executable.
+  //
+  // The PC-relative hi/lo pair patches instruction fields, so it can only live
+  // in an allocatable executable section: reaching this path (non-alloc, e.g.
+  // `.debug_*` or a data section) means the pair is malformed -- report it
+  // rather than patch an arbitrary byte (ADR-0029 D3, contract-elf.md §3.2).
+  if (rel.type == R_DADAO_PCREL_HI || rel.type == R_DADAO_PCREL_LO) {
+    Err(ctx) << getErrorLoc(ctx, loc) << "relocation " << rel.type
+             << " is only valid in an executable section (the PC-relative "
+                "pair patches `aip.si`/`ld.o` instruction fields)";
+    return;
+  }
+  relocateInSection(loc, rel, val, /*isExec=*/false);
+}
+
+void DADAO::relocateAlloc(InputSection &sec, uint8_t *buf) const {
+  uint64_t secAddr = sec.getOutputSection()->addr + sec.outSecOff;
+  const bool isExec = (sec.flags & SHF_EXECINSTR) != 0;
+  for (const Relocation &rel : sec.relocs()) {
+    if (rel.expr == R_RELAX_HINT)
+      continue;
+    uint8_t *loc = buf + rel.offset;
+    if (rel.type == R_DADAO_PCREL_LO) {
+      // The low half's value is the *high* half's S + A - P: both halves share
+      // P = the `aip.si` site address, so the low record's own symbol (the
+      // pairing site) is a pointer to the high record, not a data target
+      // (contract-elf.md §3.1).  Computing its own val (site - low address)
+      // would encode the wrong residual, so the paired high record is looked
+      // up first and its value -- which is exactly S + A - P with the right P
+      // -- is reused.
+      if (const Relocation *hi = findPcrelHi(ctx, sec, rel)) {
+        const uint64_t val =
+            sec.getRelocTargetVA(ctx, *hi, secAddr + hi->offset);
+        relocateInSection(loc, rel, val, isExec);
+      }
+      continue;
+    }
+    uint64_t val = sec.getRelocTargetVA(ctx, rel, secAddr + rel.offset);
+    relocateInSection(loc, rel, val, isExec);
+  }
+}
+
+//===----------------------------------------------------------------------===//
+// TLS data relocations in compiler-emitted `.got` slots (LLVM-117t)
+//===----------------------------------------------------------------------===//
+//
+// DADAO's compiler owns its `.got`: the slots are input-section data fields with
+// a relocation record, not linker-synthesized entries (LLVM-094t).  For TLS the
+// record types are the *dynamic* types 10/11/12 themselves, so the generic
+// expression path (`getRelExpr` + `isStaticLinkTimeConstant`) cannot classify
+// them -- it would fold every one of them as a link-time constant, which is
+// wrong for a shared object (contract-dynlink.md §4.3):
+//
+//   10 DTPMOD = module tls_id            -- loader-assigned, >= 1
+//   11 DTPREL = DTPOFF(sym) + A          -- module-relative
+//   12 TPREL  = TPOFF(sym) + A           -- TP-relative, may be negative
+//
+// The rules below mirror what lld's own TLS GOT machinery does for other
+// targets, with the frozen formulas above:
+//
+//   * DTPREL is a link-time constant for a defined, non-preemptible symbol
+//     (the offset inside its own module's TLS block does not move), so it is
+//     written by relocateAlloc() in every output kind.
+//   * DTPMOD / TPREL are link-time constants only when the output is not
+//     shared: the main executable is the first TLS module, so its id is 1
+//     (musl ldso/dynlink.c: `app.tls_id = tls_cnt = 1`) and its static TLS
+//     offset is what the linker just assigned (getTlsTpOffset).
+//   * In a shared object -- or for a preemptible symbol -- the loader owns the
+//     value, so a dynamic relocation is emitted: symbol-less with the addend
+//     carrying DTPOFF when the symbol is local to this module (musl adds the
+//     module's own tls_id / tls.offset), otherwise against the symbol so the
+//     loader resolves the *defining* module.
+static void scanTLSSlot(Ctx &ctx, InputSectionBase &sec, Symbol &sym,
+                        RelType type, uint64_t offset, int64_t addend) {
+  // The slot must be a writable data field: a TLS module id / offset can only
+  // live in data, and a read-only or executable section would make the loader
+  // write into text (contract-dynlink.md §4.3).
+  if (((sec.flags & SHF_WRITE) == 0) || ((sec.flags & SHF_EXECINSTR) != 0)) {
+    Err(ctx) << sec.getLocation(offset) << ": relocation " << type
+             << " needs a writable data slot (the compiler's `.got` slot); "
+                "TLS offsets never live in an instruction field "
+                "(contract-dynlink.md §4.3)";
+    return;
+  }
+  if (!sym.isTls()) {
+    Err(ctx) << sec.getLocation(offset) << ": relocation " << type
+             << " is only valid against an STT_TLS symbol, but '" << &sym
+             << "' is not thread-local (contract-dynlink.md §4.3)";
+    return;
+  }
+
+  if (!sym.isPreemptible) {
+    if (type == R_DADAO_TLS_DTPREL) {
+      // DTPOFF(sym) + A: module-relative, hence a link-time constant in a
+      // shared object too (only the block's placement moves).
+      sec.addReloc({R_DTPREL, type, offset, addend, &sym});
+      return;
+    }
+    if (!ctx.arg.shared) {
+      if (type == R_DADAO_TLS_DTPMOD)
+        // The executable is TLS module 1 (musl ldso/dynlink.c).
+        sec.addReloc({R_ADDEND, type, offset, /*addend=*/1, &sym});
+      else
+        // R_TPREL resolves through getTlsTpOffset(): DTPOFF + alignment
+        // padding, i.e. exactly musl's static TLS layout (§7).
+        sec.addReloc({R_TPREL, type, offset, addend, &sym});
+      return;
+    }
+    // Shared object, local symbol: the record cannot name a dynamic symbol
+    // (a local STT_TLS symbol is not in .dynsym), so the value travels as the
+    // addend and the loader supplies the module part (musl: REL_DTPMOD writes
+    // the module's own tls_id, REL_TPOFF adds the module's own tls.offset).
+    ctx.in.relaDyn->addAddendOnlyRelocIfNonPreemptible(
+        type, sec, offset, sym, ctx.target->symbolicRel);
+    return;
+  }
+
+  // Preemptible: the definition may be in another module, so the loader must
+  // resolve the symbol and use that module's id / offset.
+  ctx.in.relaDyn->addSymbolReloc(type, sec, offset, sym, addend);
+}
+
+template <class ELFT, class RelTy>
+void DADAO::scanSectionImpl(InputSectionBase &sec, Relocs<RelTy> rels,
+                            unsigned shard) {
+  RelocScan rs(ctx, &sec, shard);
+  sec.relocations.reserve(rels.size());
+
+  for (auto it = rels.begin(); it != rels.end(); ++it) {
+    RelType type = it->getType(false);
+    int64_t addend = rs.getAddend<ELFT>(*it, type);
+    switch (type) {
+    case R_DADAO_TLS_DTPMOD:
+    case R_DADAO_TLS_DTPREL:
+    case R_DADAO_TLS_TPREL: {
+      Symbol &sym = sec.getFile<ELFT>()->getSymbol(it->getSymbol(false));
+      scanTLSSlot(ctx, sec, sym, type, it->r_offset, addend);
+      continue;
+    }
+    default:
+      break;
+    }
+    // Everything else -- including the PC-relative hi/lo pair that reaches the
+    // slot -- keeps the generic scan (scan() reports undefined symbols, sets
+    // NEEDS_GOT/NEEDS_PLT and hands the record to process()).
+    rs.scan<ELFT, RelTy>(it, type, addend);
+  }
+}
+
+template <class ELFT>
+void DADAO::scanSection1(InputSectionBase &sec, unsigned shard) {
+  const RelsOrRelas<ELFT> rels = sec.template relsOrRelas<ELFT>();
+  if (rels.areRelocsCrel())
+    scanSectionImpl<ELFT>(sec, rels.crels, shard);
+  else if (rels.areRelocsRel())
+    scanSectionImpl<ELFT>(sec, rels.rels, shard);
+  else
+    scanSectionImpl<ELFT>(sec, rels.relas, shard);
+}
+
+void DADAO::scanSection(InputSectionBase &sec, unsigned shard) {
+  invokeELFT(scanSection1, sec, shard);
+}
+
+void elf::setDADAOTargetInfo(Ctx &ctx) { ctx.target.reset(new DADAO(ctx)); }
