From e23e76dfe419ec01e54a8f275995017fdb26633a Mon Sep 17 00:00:00 2001
From: Guan Xuetao <gxt@pku.edu.cn>
Date: Tue, 22 Sep 2026 06:59:22 +0000
Subject: [PATCH] DADAO: Fix wyde-position operand parsing (wpN tokens)

Accept wp0/wp1/wp2/wp3 as aliases for numeric 0-3 in wyde-position
operands. Reject wp4+ and other invalid tokens with proper diagnostics.
Add isWydePosImm predicate to validate range [0,3] for numeric literals.

Bug: wp2 etc. were treated as undefined symbols, silently encoding as wp0.
Fix: parse wpN tokens in AsmParser, add DADAOWydePosAsmOperand with range predicate.

LLVM-013t
---
 .../Target/DADAO/AsmParser/DADAOAsmParser.cpp | 44 +++++++++++++++++++
 llvm/lib/Target/DADAO/DADAOInstrInfo.td       | 11 ++++-
 2 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/llvm/lib/Target/DADAO/AsmParser/DADAOAsmParser.cpp b/llvm/lib/Target/DADAO/AsmParser/DADAOAsmParser.cpp
index 57e823353..a382b4fac 100644
--- a/llvm/lib/Target/DADAO/AsmParser/DADAOAsmParser.cpp
+++ b/llvm/lib/Target/DADAO/AsmParser/DADAOAsmParser.cpp
@@ -139,6 +139,15 @@ public:
       break;
     }
   }
+
+  // Predicate for wyde-position: immediate in range [0, 3].
+  bool isWydePosImm() const {
+    if (Kind != kImmediate)
+      return false;
+    if (ImmExpr)
+      return false;
+    return ImmVal >= 0 && ImmVal <= 3;
+  }
 };
 
 // The DADAO target assembly parser.
@@ -179,6 +188,7 @@ private:
                                  SMLoc &EndLoc);
   bool parseOperand(OperandVector &Operands);
   bool parseImmediate(OperandVector &Operands);
+  bool parseWydePosToken(OperandVector &Operands);
   static unsigned matchRegisterName(StringRef Name);
 };
 
@@ -258,10 +268,44 @@ bool DADAOAsmParser::parseImmediate(OperandVector &Operands) {
   return false;
 }
 
+// Try to parse a wyde-position token (wp0/wp1/wp2/wp3).
+// Returns true if the current token is a wp-prefixed identifier (consumed or
+// errored). Returns false if the token is not wp-prefixed (caller continues
+// with normal parse path).
+bool DADAOAsmParser::parseWydePosToken(OperandVector &Operands) {
+  const AsmToken &Tok = getParser().getTok();
+  if (Tok.isNot(AsmToken::Identifier))
+    return false;
+
+  StringRef Name = Tok.getString();
+  if (Name.size() < 3 || !Name.starts_with("wp"))
+    return false;
+
+  // The token starts with "wp". Try to parse the numeric suffix.
+  unsigned N;
+  if (Name.substr(2).getAsInteger(10, N) || N > 3) {
+    // wp4, wpfoo, wp, etc. — invalid wyde-position
+    SMLoc Loc = Tok.getLoc();
+    getParser().Lex();
+    return Error(Loc, "invalid wyde-position; expected wp0, wp1, wp2, or wp3");
+  }
+
+  // Valid wpN (N = 0..3): convert to immediate N.
+  SMLoc StartLoc = Tok.getLoc();
+  SMLoc EndLoc = Tok.getEndLoc();
+  getParser().Lex();
+  Operands.push_back(DADAOOperand::createImm(N, StartLoc, EndLoc));
+  return true;
+}
+
 bool DADAOAsmParser::parseOperand(OperandVector &Operands) {
   const AsmToken &Tok = getParser().getTok();
 
   if (Tok.is(AsmToken::Identifier)) {
+    // Try wyde-position token first (wp0/wp1/wp2/wp3).
+    if (parseWydePosToken(Operands))
+      return false;
+
     unsigned RegNo = matchRegisterName(Tok.getString());
     if (RegNo) {
       SMLoc StartLoc = Tok.getLoc();
diff --git a/llvm/lib/Target/DADAO/DADAOInstrInfo.td b/llvm/lib/Target/DADAO/DADAOInstrInfo.td
index c6bdbef82..7c6f302ef 100644
--- a/llvm/lib/Target/DADAO/DADAOInstrInfo.td
+++ b/llvm/lib/Target/DADAO/DADAOInstrInfo.td
@@ -28,6 +28,15 @@ def DADAOImmAsmOperand : AsmOperandClass {
   let PredicateMethod = "isImm";
 }
 
+// Wyde-position operand (rwii format): 2-bit value 0-3, also accepts wp0-wp3.
+def DADAOWydePosAsmOperand : AsmOperandClass {
+  let Name = "DADAOWydePos";
+  let RenderMethod = "addImmOperands";
+  let DiagnosticType = "InvalidImmediate";
+  let PredicateMethod = "isWydePosImm";
+  let SuperClasses = [DADAOImmAsmOperand];
+}
+
 //===----------------------------------------------------------------------===//
 // Operand types
 //===----------------------------------------------------------------------===//
@@ -106,7 +115,7 @@ def immu24 : Operand<i64> {
 
 // 2-bit wyde-position (rwii: hb[5:4])
 def wydepos : Operand<i64> {
-  let ParserMatchClass = DADAOImmAsmOperand;
+  let ParserMatchClass = DADAOWydePosAsmOperand;
   let EncoderMethod = "";  // Handled by C++ getMachineOpValue()
   let DecoderMethod = "DecodeWydePos";  // LLVM-007t implements
   let PrintMethod = "printOperand";
