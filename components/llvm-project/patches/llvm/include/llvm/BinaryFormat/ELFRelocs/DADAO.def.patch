diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def
new file mode 100644
index 000000000..c09de10f5
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def
@@ -0,0 +1,20 @@
+
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// Absolute 48-bit address built by a set.zw/or.w/andn.w wyde sequence.
+// One relocation per instruction; the wyde-position (wp, hb[5:4]) selects
+// which 16-bit slice of (S + A) the instruction carries.
+ELF_RELOC(R_DADAO_ABS48, 0)
+// PC-relative word offset for call/jump (imms24 field, 26 effective bits).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL26, 1)
+// PC-relative word offset for br.n/br.nn/br.z/br.nz/br.p/br.np (imms18).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL20, 2)
+// PC-relative word offset for br.eq/br.ne (imms12).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL14, 3)
+// Number of relocation types (not a relocation).
+ELF_RELOC(R_DADAO_NUM, 4)
