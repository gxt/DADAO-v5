diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def
new file mode 100644
index 000000000..10d76ed6d
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/DADAO.def
@@ -0,0 +1,82 @@
+
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// DADAO relocation types.  Numbering = ADR-0019 D10 / contract-dynlink.md §4.3
+// (final, dense, no gaps; the legacy Dadao.def numbering is not reused).
+//
+//   0      no-op placeholder (not part of dynamic-section semantics)
+//   1-5    static types (contract-elf.md §2.2)
+//   6      absolute 48-bit address (data/GOT slot or instruction wyde series)
+//   7-13   dynamic / TLS types (contract-dynlink.md §4.3)
+//   14-15  PC-relative hi/lo pair for aip.si + ld.o (contract-elf.md §2.2)
+//   16     type count (R_DADAO_NUM)
+ELF_RELOC(R_DADAO_NONE, 0)
+// PC-relative word offset for call/jump (imms24 field, 26 effective bits).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL26, 1)
+// PC-relative word offset for br.n/br.nn/br.z/br.nz/br.p/br.np (imms18).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL20, 2)
+// PC-relative word offset for br.eq/br.ne (imms12).
+// field = (S + A - P) >> 2.
+ELF_RELOC(R_DADAO_REL14, 3)
+// Byte offset for ld.*/st.* symbol displacement with base rb0 (rrii imms12).
+// rb0 reads the address of the current instruction, so the displacement is
+// PC-relative: field = S + A - P, in BYTES (no >>2; contract-elf.md §3.1).
+ELF_RELOC(R_DADAO_REL12, 4)
+// Byte offset for ld.*/st.* symbol displacement with base rb1..rb63 (imms12).
+// The base is a general register, so the displacement is base-relative
+// (absolute): field = S + A, in BYTES (no >>2; contract-elf.md §3.1).
+ELF_RELOC(R_DADAO_ABS12, 5)
+// Absolute 48-bit address, unsigned.  Two encodings share the type
+// (contract-dynlink.md §4.3):
+//   * data: a single 8-byte field (data symbol address / GOT slot content);
+//   * instruction: one relocation per instruction of a set.zw/or.w/andn.w
+//     wyde series; the wyde-position (wp, hb[5:4]) selects which 16-bit slice
+//     of (S + A) the instruction carries.
+// Dynamic use (data form) maps to the musl REL_SYMBOLIC / REL_GOT categories;
+// there is no separate GLOB_DAT type.
+ELF_RELOC(R_DADAO_ABS48, 6)
+// PLT GOT slot: a single 8-byte field.  field = S + A (unsigned 48 bits);
+// musl category REL_PLT.
+ELF_RELOC(R_DADAO_JUMP_SLOT, 7)
+// Relative relocation: a single 8-byte field.  field = B + A (unsigned 48
+// bits, B = load bias); musl category REL_RELATIVE.
+ELF_RELOC(R_DADAO_RELATIVE, 8)
+// Runtime copy of a symbol definition.  musl category REL_COPY.  Reserved but
+// **not emitted** by this implementation: encountering one is an explicit
+// error (ADR-0026 D7②, contract-dynlink.md §10②).
+ELF_RELOC(R_DADAO_COPY, 9)
+// TLS module id (8-byte slot); musl category REL_DTPMOD.
+ELF_RELOC(R_DADAO_TLS_DTPMOD, 10)
+// TLS module-relative offset; field = DTPOFF(sym) + A (two's complement);
+// musl category REL_DTPOFF.
+ELF_RELOC(R_DADAO_TLS_DTPREL, 11)
+// TLS TP-relative offset; field = TPOFF(sym) + A (two's complement, may be
+// negative); musl category REL_TPOFF.
+ELF_RELOC(R_DADAO_TLS_TPREL, 12)
+// TLS descriptor (two slots: resolver address, then its argument).  musl
+// category REL_TLSDESC.  Reserved but **not emitted** by this implementation:
+// encountering one is an explicit error (ADR-0026 D7②).
+ELF_RELOC(R_DADAO_TLSDESC, 13)
+// PC-relative high part for `aip.si rbX, <sym>` (riii imms18 field): the
+// +0x800 rounding makes the low part (below) fit a signed 12-bit field, so the
+// two halves always reconstruct the same address (contract-elf.md §3.1,
+// ADR-0029 D2).  P is the aip.si site address (rb0 reads the address of the
+// current instruction), shared by both halves -- NOT each instruction's own
+// address.  value = (S + A - P + 0x800) >> 12.
+ELF_RELOC(R_DADAO_PCREL_HI, 14)
+// PC-relative low part for the paired `ld.o rbX, [rbX, imms12]` (rrii imms12
+// field, signed bytes): value = (S + A - P) - (high part << 12), which is in
+// [-2048, +2047] by construction.  The record carries the pairing information
+// pointing back at the aip.si site (the explicit RISC-V `%pcrel_lo(label)`
+// form: the record's symbol/addend locate the hi instruction), so the linker
+// recovers the already-computed high part of that site instead of recomputing
+// it from a second P (contract-elf.md §3.1/§3.2, ADR-0029 D2/D3).
+ELF_RELOC(R_DADAO_PCREL_LO, 15)
+// Number of relocation types (not a relocation).  Frozen at 16
+// (ADR-0019 D10/D12 / contract-dynlink.md §4.4); the numbering is dense with
+// no gaps (14/15 above fill the range left by the withdrawn REL32).
+ELF_RELOC(R_DADAO_NUM, 16)
