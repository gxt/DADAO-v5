+
+#include "DADAOTargetMachine.h"
+#include "DADAO.h"
+#include "DADAOSubtarget.h"
+#include "TargetInfo/DADAOTargetInfo.h"
+
+#include "llvm/CodeGen/TargetLoweringObjectFileImpl.h"
+#include "llvm/CodeGen/Passes.h"
+#include "llvm/CodeGen/TargetPassConfig.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/PassRegistry.h"
+#include "llvm/Support/Compiler.h"
+
+using namespace llvm;
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeDADAOTarget() {
+  // Register the target machine.
+  RegisterTargetMachine<DADAOTargetMachine> X(getTheDadaoTarget());
+
+  auto *PR = PassRegistry::getPassRegistry();
+  initializeDADAODAGToDAGISelLegacyPass(*PR);
+  initializeDADAOAsmPrinterPass(*PR);
+}
+
+namespace {
+
+class DADAOPassConfig : public TargetPassConfig {
+public:
+  DADAOPassConfig(DADAOTargetMachine &TM, PassManagerBase &PM)
+      : TargetPassConfig(TM, PM) {}
+
+  DADAOTargetMachine &getDADAOTargetMachine() const {
+    return getTM<DADAOTargetMachine>();
+  }
+
+  bool addInstSelector() override {
+    addPass(createDADAOISelDag(getDADAOTargetMachine()));
+    return false;
+  }
+
+  void addPreEmitPass() override {
+    // Relax conditional branches whose target does not fit the branch
+    // immediate (LLVM-071t).  A br.eq/br.ne reaches only a 12-bit word offset,
+    // so a large function body (e.g. Embench nsichneu -O2) can push the target
+    // out of range; BranchRelaxation then rewrites such a branch into the
+    // "island" form -- a short conditional branch over an unconditional `jump`
+    // (24-bit) to the far target -- using the DADAOInstrInfo branch hooks
+    // (isBranchOffsetInRange / analyzeBranch / insertBranch / removeBranch).
+    // This keeps every branch encoded within the existing MC fixup widths
+    // (DADAO_FK_PCRel_12/24) instead of failing at assembly time.
+    addPass(&BranchRelaxationPassID);
+  }
+};
+
+} // end anonymous namespace
+
+DADAOTargetMachine::DADAOTargetMachine(
+    const Target &T, const Triple &TT, StringRef CPU, StringRef FS,
+    const TargetOptions &Options, std::optional<Reloc::Model> RM,
+    std::optional<CodeModel::Model> CM, CodeGenOptLevel OL, bool JIT)
+    : CodeGenTargetMachineImpl(T, TT.computeDataLayout(), TT, CPU, FS, Options,
+                               RM.value_or(Reloc::Static),
+                               CM.value_or(CodeModel::Small), OL),
+      TLOF(std::make_unique<TargetLoweringObjectFileELF>()),
+      Subtarget(TT, CPU, FS, *this) {
+  initAsmInfo();
+}
+
+DADAOTargetMachine::~DADAOTargetMachine() = default;
+
+const DADAOSubtarget *
+DADAOTargetMachine::getSubtargetImpl(const Function &F) const {
+  Attribute CPUAttr = F.getFnAttribute("target-cpu");
+  Attribute FSAttr = F.getFnAttribute("target-features");
+
+  auto CPU = CPUAttr.isValid() ? CPUAttr.getValueAsString().str() : TargetCPU;
+  auto FS = FSAttr.isValid() ? FSAttr.getValueAsString().str() : TargetFS;
+
+  auto &I = SubtargetMap[CPU + FS];
+  if (!I)
+    I = std::make_unique<DADAOSubtarget>(TargetTriple, CPU, FS, *this);
+  return I.get();
+}
+
+TargetPassConfig *DADAOTargetMachine::createPassConfig(PassManagerBase &PM) {
+  return new DADAOPassConfig(*this, PM);
+}
