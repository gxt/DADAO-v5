+namespace {
+
+// Relocation model selection (LLVM-094t).  The DADAO ABI defines exactly two
+// models:
+//   * `Static` -- the M4 bare-metal path (VA = PA, absolute 48-bit address
+//     materialization), and the default when no -fPIC/-fPIE is given;
+//   * `PIC_`   -- position-independent code: every global address is taken
+//     from a GOT slot addressed PC-relatively through `rb0` + a link-time
+//     constant displacement, with no global-pointer register reserved
+//     (contract-dynlink.md §2-§3, ADR-0026 D5).  Both `-fPIC` and `-fPIE`
+//     select this model (clang carries PIE-ness as a PIELevel, not as a
+//     relocation model), so there is no separate `PIE` model to accept.
+// `ROPI`/`RWPI`/`ROPI_RWPI` would change the data addressing model (read-only /
+// read-write segment split) which the v5 baseline does not define, and
+// `DynamicNoPIC` is the Darwin "dynamic data, static code" model, which has no
+// meaning for this ELF ABI.  Both are rejected loudly rather than silently
+// lowered as static code (contract-dynlink.md §2).
+Reloc::Model selectRelocModel(std::optional<Reloc::Model> RM) {
+  const Reloc::Model M = RM.value_or(Reloc::Static);
+  switch (M) {
+  case Reloc::Static:
+  case Reloc::PIC_:
+    return M;
+  case Reloc::DynamicNoPIC:
+  case Reloc::ROPI:
+  case Reloc::RWPI:
+  case Reloc::ROPI_RWPI:
+    report_fatal_error("DADAO: unsupported relocation model (only static and "
+                       "PIC are defined; ROPI/RWPI and dynamic-no-pic have no "
+                       "ABI definition)");
+  }
+  llvm_unreachable("unknown relocation model");
+}
+
+// Code model selection (LLVM-131t, ADR-0036 D1/D2).  The DADAO ABI defines
+// exactly two models:
+//   * `default` (`CodeModel::Small`, also accepted as `-mcmodel=small` and as
+//     the absence of the option) -- one image whose code is within a single
+//     REL26 reach (a direct `call`/`jump` reaches +/-32 MiB); data is absolute
+//     (ABS48 / PCREL) and therefore unrestricted;
+//   * `large` -- code anywhere: a direct call/jump target that cannot be
+//     reached PC-relatively is materialized as a 48-bit absolute address and
+//     called/jumped indirectly (D5; the lowering lives in LowerCall).
+// `medium` and `kernel` split code/data placement, which the DADAO ABI has no
+// use for (data is already absolute -- ADR-0036 D2), and `tiny` needs a shared
+// base register the ABI does not define.  Those are rejected loudly rather
+// than silently lowered as one of the two real models, so an `llc
+// -code-model=medium` (or a frontend that skips the driver check) cannot look
+// like it worked.
+CodeModel::Model selectCodeModel(std::optional<CodeModel::Model> CM) {
+  const CodeModel::Model M = CM.value_or(CodeModel::Small);
+  switch (M) {
+  case CodeModel::Small:
+  case CodeModel::Large:
+    return M;
+  case CodeModel::Tiny:
+  case CodeModel::Kernel:
+  case CodeModel::Medium:
+    report_fatal_error("DADAO: unsupported code model (only 'default'/'small' "
+                       "and 'large' are defined; medium/kernel/tiny have no "
+                       "meaning for this ABI)");
+  }
+  llvm_unreachable("unknown code model");
+}
