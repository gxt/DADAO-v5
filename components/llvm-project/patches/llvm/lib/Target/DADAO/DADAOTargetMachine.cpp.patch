+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeDADAOTarget() {
+  // Register the target machine.
+  RegisterTargetMachine<DADAOTargetMachine> X(getTheDadaoTarget());
+
+  auto *PR = PassRegistry::getPassRegistry();
+  initializeDADAODAGToDAGISelLegacyPass(*PR);
+  initializeDADAOAsmPrinterPass(*PR);
+  initializeDADAOLoadStoreOptPass(*PR);
+}
