diff --git a/llvm/lib/Target/DADAO/DADAOCodeGen.td b/llvm/lib/Target/DADAO/DADAOCodeGen.td
new file mode 100644
index 000000000..5fd44eb83
--- /dev/null
+++ b/llvm/lib/Target/DADAO/DADAOCodeGen.td
@@ -0,0 +1,190 @@
+//===-- DADAOCodeGen.td - DADAO CodeGen TableGen defs -------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// SelectionDAG target nodes, CodeGen-only pseudo instructions and i64 ISel
+// patterns for the DADAO M3 backend (LLVM-033t skeleton; LLVM-035t i64
+// arithmetic/constants; LLVM-036t scalar load/store).
+//
+// The instruction definitions in DADAOInstrInfo.td are generated from
+// contracts/opcodes.yaml and carry no patterns.  This file adds the CodeGen
+// glue: `llc -march=dadao -stop-after=finalize-isel` can lower scalar
+// add/sub/mul/and/or/xor/shift/div/rem, 64-bit constants and scalar
+// load/store to MIR.
+//
+// The real `ret` instruction (ret_riii) is expanded later (LLVM-040t); here a
+// CodeGen-only pseudo terminates the function so the MIR can be inspected.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// SelectionDAG target nodes
+//===----------------------------------------------------------------------===//
+
+// Return terminator produced by DADAOTargetLowering::LowerReturn.  Operands:
+//   chain, [return-value registers...], [glue]
+// Matched by RET_PSEUDO below.
+def DADAORetGlue : SDNode<"DADAOISD::RET_GLUE", SDTNone,
+                          [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;
+
+//===----------------------------------------------------------------------===//
+// CodeGen-only pseudo instruction base
+//===----------------------------------------------------------------------===//
+
+class DADAOPseudo<dag outs, dag ins, list<dag> pattern> : Instruction {
+  let Namespace = "DADAO";
+  let OutOperandList = outs;
+  let InOperandList = ins;
+  let AsmString = "";
+  let Pattern = pattern;
+  let isPseudo = 1;
+  let isCodeGenOnly = 1;
+  let Size = 4;
+}
+
+// Function return terminator.  The return value has already been placed in
+// rd31 (scalar) / rb31 (pointer) by LowerReturn via CopyToReg, so no operands
+// are needed here.  Expansion to the real `ret rd0, 0` is LLVM-040t.
+let isReturn = 1, isTerminator = 1, isBarrier = 1 in
+def RET_PSEUDO : DADAOPseudo<(outs), (ins), [(DADAORetGlue)]>;
+
+//===----------------------------------------------------------------------===//
+// i64 arithmetic pseudos (LLVM-035t)
+//
+// The rrrr add/sub/mul instructions are 128-bit (two destinations): rdha holds
+// the high 64 bits, rdhb the low 64.  CodeGen only needs the low 64 bits, so
+// the selector matches these single-result pseudos and expandPostRAPseudo
+// rewrites them to `add.uo/sub.uo/mul.uo rd0, dst, a, b` (rdha = rd0 discards
+// the high half; ADR-0018 C12 / contract-isa.md §6.1.1).  Selecting the real
+// two-result instruction directly is not expressible as a TableGen pattern
+// (the high result has no DAG value), hence the pseudo indirection.
+//===----------------------------------------------------------------------===//
+
+// Signed immediate that fits the 18-bit `add.si`/riii field (§6.1.3).
+def simm18imm : ImmLeaf<i64, [{ return isInt<18>(Imm); }]>;
+
+def ADD_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (add GPRD:$a, GPRD:$b))]>;
+def SUB_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (sub GPRD:$a, GPRD:$b))]>;
+def MUL_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (mul GPRD:$a, GPRD:$b))]>;
+
+// In-place 18-bit immediate add: `add.si rd, imm18` (contract-isa.md
+// §6.1.3).  Expanded to a bank copy (rd2rd) into the result followed by
+// `add.si dst, imm`; the copy is skipped when RA has coalesced dst == src.
+def ADD_IMM_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$src, i64imm:$imm),
+                                 [(set GPRD:$dst, (add GPRD:$src, simm18imm:$imm))]>;
+
+// Large i64 constant materialization (C12, ADR-0018): `set.zw`/`set.ow`
+// basis + `or.w`/`andn.w` fixes, no constant pool (M3 has no .rodata).
+// Expanded by expandPostRAPseudo; the operand is the raw 64-bit value.
+def CONST_WYDE : DADAOPseudo<(outs GPRD:$dst), (ins i64imm:$val), []>;
+
+//===----------------------------------------------------------------------===//
+// Single-result i64 patterns (orrr, contract-isa.md §6.3–§6.4, §7)
+//
+// These instructions have exactly one destination, so they can be selected
+// directly by TableGen without a pseudo.  Pointer/address arithmetic (C14) is
+// handled bank-aware in DADAOISelDAGToDAG (ptr − ptr -> sub.o rd, rb, rb).
+//===----------------------------------------------------------------------===//
+
+def : Pat<(and GPRD:$a, GPRD:$b), (and_o GPRD:$a, GPRD:$b)>;
+def : Pat<(or GPRD:$a, GPRD:$b), (or_o GPRD:$a, GPRD:$b)>;
+def : Pat<(xor GPRD:$a, GPRD:$b), (xor_o GPRD:$a, GPRD:$b)>;
+
+// Variable shift amount (orrr): shamt is rdhc low 6 bits (§6.4.1).
+def : Pat<(shl GPRD:$a, GPRD:$b), (shl_uo_orrr GPRD:$a, GPRD:$b)>;
+def : Pat<(srl GPRD:$a, GPRD:$b), (shr_uo_orrr GPRD:$a, GPRD:$b)>;
+def : Pat<(sra GPRD:$a, GPRD:$b), (shr_so_orrr GPRD:$a, GPRD:$b)>;
+
+// 64-bit div/rem (orrr): rdhb = rdhc / rdhb ... (contract-isa.md §6.1.5).
+// DADAO returns defined values for the div-by-zero / INT_MIN/-1 cases that are
+// UB in LLVM IR, so the mapping is safe.
+def : Pat<(udiv GPRD:$a, GPRD:$b), (div_uo GPRD:$a, GPRD:$b)>;
+def : Pat<(sdiv GPRD:$a, GPRD:$b), (div_so GPRD:$a, GPRD:$b)>;
+def : Pat<(urem GPRD:$a, GPRD:$b), (rem_uo GPRD:$a, GPRD:$b)>;
+def : Pat<(srem GPRD:$a, GPRD:$b), (rem_so GPRD:$a, GPRD:$b)>;
+
+//===----------------------------------------------------------------------===//
+// Scalar load/store (LLVM-036t; C13/C14, ADR-0018)
+//
+// Address = GPRB base + sign-extended 12-bit immediate (contract-isa.md
+// §3.1.1, C14 D3).  The base is forced into GPRB (C14 D5: RB is the base
+// bank).  Offsets that do not fit simm12 are not folded into these patterns;
+// the DAG keeps a separate 64-bit add which the generic i64 arithmetic
+// patterns (ADD_IMM_PSEUDO / ADD_PSEUDO) materialize, after which the address
+// is moved into GPRB.  Correct, though not yet the single-instruction
+// `add.o` (C14 D1) form.
+//
+// Narrow accesses are big-endian.  `ld.ub/uw/ut` zero-extend and `ld.sb/sw/st`
+// sign-extend, each writing all 64 bits (SPEC-069t value semantics); stores
+// `st.b/w/t` write the low 8/16/32 bits (contract-isa.md §3.1.1).  The load
+// extension and truncating-store actions are marked Legal in
+// DADAOTargetLowering so the extload/truncstore nodes reach ISel.  Because the
+// target is big-endian, the byte offsets produced by DAGCombine (e.g.
+// ReduceLoadWidth narrowing a wide load plus shift) are BE-derived; matching
+// them via `(add base, simm12)` is what avoids the 0628 DL-068a silent
+// miscompile.
+//===----------------------------------------------------------------------===//
+
+// Signed 12-bit offset matching the `imms12` operand.
+def simm12imm : ImmLeaf<i64, [{ return isInt<12>(Imm); }]>;
+
+// 64-bit load/store (ld.o / st.o, RD variants).
+def : Pat<(load GPRB:$base), (ld_o_rd GPRB:$base, 0)>;
+def : Pat<(load (add GPRB:$base, simm12imm:$off)),
+          (ld_o_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(store GPRD:$val, GPRB:$base), (st_o_rd GPRD:$val, GPRB:$base, 0)>;
+def : Pat<(store GPRD:$val, (add GPRB:$base, simm12imm:$off)),
+          (st_o_rd GPRD:$val, GPRB:$base, simm12imm:$off)>;
+
+// i8: zero/any extension -> ld.ub, sign extension -> ld.sb, truncating store
+// -> st.b.
+def : Pat<(i64 (extloadi8 GPRB:$base)), (ld_ub_rd GPRB:$base, 0)>;
+def : Pat<(i64 (extloadi8 (add GPRB:$base, simm12imm:$off))),
+          (ld_ub_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (zextloadi8 GPRB:$base)), (ld_ub_rd GPRB:$base, 0)>;
+def : Pat<(i64 (zextloadi8 (add GPRB:$base, simm12imm:$off))),
+          (ld_ub_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (sextloadi8 GPRB:$base)), (ld_sb_rd GPRB:$base, 0)>;
+def : Pat<(i64 (sextloadi8 (add GPRB:$base, simm12imm:$off))),
+          (ld_sb_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(truncstorei8 GPRD:$val, GPRB:$base),
+          (st_b_rd GPRD:$val, GPRB:$base, 0)>;
+def : Pat<(truncstorei8 GPRD:$val, (add GPRB:$base, simm12imm:$off)),
+          (st_b_rd GPRD:$val, GPRB:$base, simm12imm:$off)>;
+
+// i16 (wyde): ld.uw / ld.sw / st.w.
+def : Pat<(i64 (extloadi16 GPRB:$base)), (ld_uw_rd GPRB:$base, 0)>;
+def : Pat<(i64 (extloadi16 (add GPRB:$base, simm12imm:$off))),
+          (ld_uw_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (zextloadi16 GPRB:$base)), (ld_uw_rd GPRB:$base, 0)>;
+def : Pat<(i64 (zextloadi16 (add GPRB:$base, simm12imm:$off))),
+          (ld_uw_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (sextloadi16 GPRB:$base)), (ld_sw_rd GPRB:$base, 0)>;
+def : Pat<(i64 (sextloadi16 (add GPRB:$base, simm12imm:$off))),
+          (ld_sw_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(truncstorei16 GPRD:$val, GPRB:$base),
+          (st_w_rd GPRD:$val, GPRB:$base, 0)>;
+def : Pat<(truncstorei16 GPRD:$val, (add GPRB:$base, simm12imm:$off)),
+          (st_w_rd GPRD:$val, GPRB:$base, simm12imm:$off)>;
+
+// i32 (tetra): ld.ut / ld.st / st.t.
+def : Pat<(i64 (extloadi32 GPRB:$base)), (ld_ut_rd GPRB:$base, 0)>;
+def : Pat<(i64 (extloadi32 (add GPRB:$base, simm12imm:$off))),
+          (ld_ut_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (zextloadi32 GPRB:$base)), (ld_ut_rd GPRB:$base, 0)>;
+def : Pat<(i64 (zextloadi32 (add GPRB:$base, simm12imm:$off))),
+          (ld_ut_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(i64 (sextloadi32 GPRB:$base)), (ld_st_rd GPRB:$base, 0)>;
+def : Pat<(i64 (sextloadi32 (add GPRB:$base, simm12imm:$off))),
+          (ld_st_rd GPRB:$base, simm12imm:$off)>;
+def : Pat<(truncstorei32 GPRD:$val, GPRB:$base),
+          (st_t_rd GPRD:$val, GPRB:$base, 0)>;
+def : Pat<(truncstorei32 GPRD:$val, (add GPRB:$base, simm12imm:$off)),
+          (st_t_rd GPRD:$val, GPRB:$base, simm12imm:$off)>;
