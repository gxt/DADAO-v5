+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// SelectionDAG target nodes, CodeGen-only pseudo instructions and i64 ISel
+// patterns for the DADAO M3 backend (LLVM-033t skeleton; LLVM-035t i64
+// arithmetic/constants; LLVM-036t scalar load/store; LLVM-037t compare/branch;
+// LLVM-047t signed narrow-integer sign_extend_inreg).
+//
+// The instruction definitions in DADAOInstrInfo.td are generated from
+// contracts/opcodes.yaml and carry no patterns.  This file adds the CodeGen
+// glue: `llc -march=dadao -stop-after=finalize-isel` can lower scalar
+// add/sub/mul/and/or/xor/shift/div/rem, signed narrow-integer extension,
+// 64-bit constants, scalar load/store and integer compare+branch to MIR.
+//
+// The real `ret` instruction (ret_riii) is expanded later (LLVM-040t); here a
+// CodeGen-only pseudo terminates the function so the MIR can be inspected.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// SelectionDAG target nodes
+//===----------------------------------------------------------------------===//
+
+// Return terminator produced by DADAOTargetLowering::LowerReturn.  Operands:
+//   chain, [return-value registers...], [glue]
+// Matched by RET_PSEUDO below.
+def DADAORetGlue : SDNode<"DADAOISD::RET_GLUE", SDTNone,
+                          [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;
+
+//===----------------------------------------------------------------------===//
+// Direct call (LowerCall -> DADAOISD::CALL) and the call-frame pseudos
+// (C16, ADR-0018)
+//
+// Operands: chain, callee, [RegisterMask], [argument Registers...], [glue].
+//   - the callee is a TargetGlobalAddress / TargetExternalSymbol (indirect
+//     calls are deferred to M4);
+//   - the RegisterMask operand is getCallPreservedMask (must include
+//     rb32..rb63, ML-004c);
+//   - the RegisterSDNode operands are the live-in argument registers of this
+//     call site; InstrEmitter turns them into implicit-use MachineOperands,
+//     and the RegisterMaskSDNode into a regmask MachineOperand.
+// DADAOISelDAGToDAG carries all of these onto call_iiii (no TableGen pattern:
+// the variadic operand set cannot be expressed as a fixed TableGen pattern).
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOCall : SDTypeProfile<0, -1, [SDTCisVT<0, i64>]>;
+
+def DADAOCall : SDNode<"DADAOISD::CALL", SDT_DADAOCall,
+                       [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue, SDNPVariadic]>;
+
+// CALLSEQ_START/END -> ADJCALLSTACKDOWN/UP.  The outgoing stack-argument area
+// is either reserved in the prologue (SP-only: hasReservedCallFrame) or
+// adjusted around the call (FP); TargetFrameLowering::eliminateCallFramePseudoInstr
+// handles both (LLVM-039t).
+def SDT_DADAOCallSeqStart : SDCallSeqStart<[SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+def SDT_DADAOCallSeqEnd : SDCallSeqEnd<[SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+
+def DADAOCallSeqStart : SDNode<"ISD::CALLSEQ_START", SDT_DADAOCallSeqStart,
+                               [SDNPHasChain, SDNPOutGlue]>;
+def DADAOCallSeqEnd : SDNode<"ISD::CALLSEQ_END", SDT_DADAOCallSeqEnd,
+                             [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue]>;
+
+//===----------------------------------------------------------------------===//
+// Tail call (LLVM-074t)
+//
+// Operands: chain, callee, [RegisterMask], [argument Registers...], [glue]
+// (the same shape as DADAOCall).  Produced by LowerCall for an eligible tail
+// call (all arguments in registers, non-variadic); selected to TAILJMP
+// (direct) / TAILJMPIND (indirect) by DADAOISelDAGToDAG.
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOTail : SDTypeProfile<0, -1, [SDTCisVT<0, i64>]>;
+def DADAOTail : SDNode<"DADAOISD::TAIL", SDT_DADAOTail,
+                       [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue, SDNPVariadic]>;
+
+
+//===----------------------------------------------------------------------===//
+// Compare / branch target nodes (LLVM-037t; C17, ADR-0018)
+//
+// DADAO has no condition flags (CZSO removed): a comparison computes a value
+// (-1/0/1) into a general register, and a branch tests that register against
+// zero (br.n/nn/z/nz/p/np) or compares two registers directly (br.eq/ne).
+// The comparison result is therefore an ordinary i64 value in a *virtual*
+// register — no fixed condition register, no compare/branch fusion (C17).
+//
+//   DADAOCmp / DADAOCmpU : (lhs, rhs) -> i64   signed / unsigned compare
+//   DADAOBrz/nz/n/nn/p/np: (chain, val, dest)  branch on val vs zero
+//   DADAOBreq / DADAOBrne: (chain, lhs, rhs, dest) two-register branch
+//
+// None of the compare nodes is marked SDNPCommutative: cmp is order sensitive
+// (sign(lhs-rhs) != sign(rhs-lhs)); the 0628 DL-058a/b lesson.
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOBr1 : SDTypeProfile<0, 2,
+    [SDTCisVT<0, i64>, SDTCisVT<1, OtherVT>]>;
+def SDT_DADAOBr2 : SDTypeProfile<0, 3,
+    [SDTCisVT<0, i64>, SDTCisVT<1, i64>, SDTCisVT<2, OtherVT>]>;
+
+def DADAOCmp  : SDNode<"DADAOISD::CMP",  SDTIntBinOp>;
+def DADAOCmpU : SDNode<"DADAOISD::CMPU", SDTIntBinOp>;
+
+// Floating-point compare (M6, LLVM-066t): result i64 in {-1, 0, 1} ordered, or a
+// positive NaN value for unordered (contract-fp.md §8).  Operands share the
+// same FP type (f64 -> foqcmp, f32 -> ftqcmp).
+def SDT_DADAOFCmp : SDTypeProfile<1, 2, [SDTCisVT<0, i64>, SDTCisSameAs<1, 2>]>;
+def DADAOFCmp : SDNode<"DADAOISD::FCMP", SDT_DADAOFCmp>;
+
+def DADAOBrz  : SDNode<"DADAOISD::BRZ",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnz : SDNode<"DADAOISD::BRNZ", SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrn  : SDNode<"DADAOISD::BRN",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnn : SDNode<"DADAOISD::BRNN", SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrp  : SDNode<"DADAOISD::BRP",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnp : SDNode<"DADAOISD::BRNP", SDT_DADAOBr1, [SDNPHasChain]>;
+
+def DADAOBreq : SDNode<"DADAOISD::BREQ", SDT_DADAOBr2, [SDNPHasChain]>;
+def DADAOBrne : SDNode<"DADAOISD::BRNE", SDT_DADAOBr2, [SDNPHasChain]>;
+
+// Dense switch dispatch (LLVM-072t, ISS-177/G3): (chain, index, TargetJumpTable).
+// Lowered from ISD::BR_JT by DADAOTargetLowering::LowerBR_JT; the custom
+// selector (DADAOISelDAGToDAG::Select) expands it into the jump-table
+// materialize/load/indirect-jump sequence.  Both the index and the jump-table
+// leaf are i64 (pointer-typed) values.
+def SDT_DADAOBrJT : SDTypeProfile<0, 2, [SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+def DADAOBrJT : SDNode<"DADAOISD::BR_JT", SDT_DADAOBrJT, [SDNPHasChain]>;
+
+// Conditional assignment (LLVM-069t; contract-isa.md §6.5): (cond, true, false)
+// -> selected value, all i64.  CS_N tests cond < 0, CS_Z cond == 0, CS_P
+// cond > 0; the two arms are selected explicitly, so <=0 / >=0 reuse a test
+// with the arms swapped.  Produced by LowerSETCC / LowerSELECT_CC / LowerSELECT
+// and selected to the cs.n / cs.z / cs.p conditional-assign instructions.
+def SDT_DADAOCS : SDTypeProfile<1, 3, [SDTCisSameAs<0, 1>, SDTCisSameAs<0, 2>,
+                                       SDTCisSameAs<0, 3>, SDTCisInt<0>]>;
+def DADAOCSN : SDNode<"DADAOISD::CS_N", SDT_DADAOCS>;
+def DADAOCSZ : SDNode<"DADAOISD::CS_Z", SDT_DADAOCS>;
+def DADAOCSP : SDNode<"DADAOISD::CS_P", SDT_DADAOCS>;
+
+//===----------------------------------------------------------------------===//
+// CodeGen-only pseudo instruction base
+//===----------------------------------------------------------------------===//
+
+class DADAOPseudo<dag outs, dag ins, list<dag> pattern> : Instruction {
+  let Namespace = "DADAO";
+  let OutOperandList = outs;
+  let InOperandList = ins;
+  let AsmString = "";
+  let Pattern = pattern;
+  let isPseudo = 1;
+  let isCodeGenOnly = 1;
+  let Size = 4;
+}
+
+// Tail-jump instructions (LLVM-074t).  These encode exactly like `jump-iiii`
+// / `jump-rrii` (same opcode field) but are declared isCall/isReturn -- a
+// tail-call terminator that has no successors -- and, crucially, NOT isBranch:
+// their target is a symbol, so BranchRelaxation must never treat them as a
+// branch with a basic-block destination (that would assert in
+// TargetInstrInfo::getBranchDestBlock).  isCodeGenOnly keeps them out of the
+// asm matcher (the `jump` mnemonic is still used when printing).  The block is
+// a return block (isReturn), so PrologEpilogInserter emits the standard
+// epilogue (callee-saved restores + SP/FP teardown) immediately before the
+// jump; the jump pushes no return address, so the callee's `ret` pops the
+// caller's RegRAS entry (contract-isa.md §8.3/§8.4) and the frame is torn down
+// exactly as for a normal `ret`.
+let isCall = 1, isReturn = 1, isTerminator = 1, isBarrier = 1,
+    isCodeGenOnly = 1 in {
+def tailjmp_iiii : DADAOIiii<"jump"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins brtarget24:$imm24);
+  let op = 0x70;
+  let Pattern = [];
+}
+def tailjmp_rrii : DADAORrii<"jump"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRB:$ra, GPRD:$rb, imms12:$imm12);
+  let op = 0x71;
+  let Pattern = [];
+}
+}
+
+// Function return terminator.  The return value has already been placed in
+// rd8 (scalar) / rb8 (pointer) by LowerReturn via CopyToReg, so no operands
+// are needed here.  Expansion to the real `ret rd0, 0` is LLVM-040t.
+let isReturn = 1, isTerminator = 1, isBarrier = 1 in
+def RET_PSEUDO : DADAOPseudo<(outs), (ins), [(DADAORetGlue)]>;
+
+// Call frame adjustment pseudos (LLVM-039t).  They implicitly use/def SP: the
+// CodeGen must know they may modify the stack pointer before prolog-epilog
+// rewriting, and FinalizeISel sets AdjustsStack when it sees one.  Registered
+// as the call-frame setup/destroy opcodes in DADAOInstrInfo's constructor;
+// expanded/eliminated by DADAOFrameLowering::eliminateCallFramePseudoInstr.
+let Defs = [rb1], Uses = [rb1] in {
+def ADJCALLSTACKDOWN : DADAOPseudo<(outs), (ins i64imm:$amt1, i64imm:$amt2),
+                                   [(DADAOCallSeqStart timm:$amt1, timm:$amt2)]>;
+def ADJCALLSTACKUP : DADAOPseudo<(outs), (ins i64imm:$amt1, i64imm:$amt2),
+                                 [(DADAOCallSeqEnd timm:$amt1, timm:$amt2)]>;
+}
+
+
+//===----------------------------------------------------------------------===//
+// i64 arithmetic pseudos (LLVM-035t)
+//
+// The rrrr add/sub/mul instructions are 128-bit (two destinations): rdha holds
+// the high 64 bits, rdhb the low 64.  CodeGen only needs the low 64 bits, so
+// the selector matches these single-result pseudos and expandPostRAPseudo
+// rewrites them to `add.uo/sub.uo/mul.uo rd0, dst, a, b` (rdha = rd0 discards
+// the high half; ADR-0018 C12 / contract-isa.md §6.1.1).  Selecting the real
+// two-result instruction directly is not expressible as a TableGen pattern
+// (the high result has no DAG value), hence the pseudo indirection.
+//===----------------------------------------------------------------------===//
+
+// Signed immediate that fits the 18-bit `add.si`/riii field (§6.1.3).
+def simm18imm : ImmLeaf<i64, [{ return isInt<18>(Imm); }]>;
+
+def ADD_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (add GPRD:$a, GPRD:$b))]>;
+def SUB_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (sub GPRD:$a, GPRD:$b))]>;
+
+// Negation (ISS-159): `neg x` (i64) must lower to the real `sub.so {rd0, dst},
+// rd0, src` (contract-isa.md §6.6), not `sub.uo` + narrow extension.  sub.so is
+// a two-result rrrr (rdha = high 64 bits, rdhb = low 64 bits), which cannot be
+// expressed as a single-result TableGen pattern, so a single-result pseudo is
+// matched and expanded post-RA (the high half goes to the hardwired-zero rd0).
+def NEG_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$src), []>;
+def MUL_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (mul GPRD:$a, GPRD:$b))]>;
+
+// High half of a 64x64 unsigned product (LLVM-073t, ISS-176 / G2).  `mulhu`
+// reaches ISel because i64 MULHU is Legal by default, but the backend had no
+// pattern for it, so a non-power-of-two unsigned division (`a*b/3`, lowered by
+// TargetLowering::BuildUDIV to a magic-constant multiply) aborted with
+// "Cannot select: ... mulhu".  DADAO's `mul.uo` produces the full 128-bit
+// product (contract-isa.md §6.1.4: rdha:rdhb = rdhc x rdhd), so the high half
+// alone is `mul.uo dst, rd0, a, b` (rdhb = rd0 discards the low half).  A
+// two-result rrrr instruction is not expressible as a single-result TableGen
+// pattern, hence the pseudo indirection (mirrors MUL_PSEUDO).
+def MULHU_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                               [(set GPRD:$dst, (mulhu GPRD:$a, GPRD:$b))]>;
+
+// Full 64x64 -> 128 unsigned product (ISD::UMUL_LOHI), e.g. the `unsigned
+// __int128` multiply in aha-mont64's mulul64.  The node's results are
+// (low, high) -- ISDOpcodes.h SMUL_LOHI/UMUL_LOHI; TargetLowering::
+// expandDIVREMByConstant binds Result.getValue(0)=Lo, getValue(1)=Hi -- while
+// mul.uo's def order is (rdha=high, rdhb=low), so the pseudo lists (lo, hi) and
+// expandPostRAPseudo reorders to the instruction's (high, low).
+def UMUL_LOHI_PSEUDO : DADAOPseudo<(outs GPRD:$lo, GPRD:$hi),
+                                   (ins GPRD:$a, GPRD:$b),
+                                   [(set GPRD:$lo, GPRD:$hi,
+                                     (umullohi GPRD:$a, GPRD:$b))]>;
+
+// High half of a 64x64 signed product (LLVM-076t, ISS-185).  `mulhs` reaches
+// ISel because i64 MULHS is Legal by default, but the backend had no pattern
+// for it, so a non-power-of-two signed division (`a*b/3`, lowered by
+// TargetLowering::BuildSDIV to a magic-constant multiply) aborted with
+// "Cannot select: ... mulhs".  DADAO's `mul.so` produces the full 128-bit
+// signed product (contract-isa.md §6.1.4: rdha:rdhb = rdhc x rdhd), so the high
+// half alone is `mul.so dst, rd0, a, b` (rdhb = rd0 discards the low half).  A
+// two-result rrrr instruction is not expressible as a single-result TableGen
+// pattern, hence the pseudo indirection (mirrors MULHU_PSEUDO).
+def MULHS_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                               [(set GPRD:$dst, (mulhs GPRD:$a, GPRD:$b))]>;
+
+// Full 64x64 -> 128 signed product (ISD::SMUL_LOHI), e.g. the `__int128`
+// multiply.  Like UMUL_LOHI the node's results are (low, high) --
+// ISDOpcodes.h; TargetLowering::expandDIVREMByConstant binds getValue(0)=Lo,
+// getValue(1)=Hi -- while mul.so's def order is (rdha=high, rdhb=low), so the
+// pseudo lists (lo, hi) and expandPostRAPseudo reorders to the instruction's
+// (high, low).
+def SMUL_LOHI_PSEUDO : DADAOPseudo<(outs GPRD:$lo, GPRD:$hi),
+                                   (ins GPRD:$a, GPRD:$b),
+                                   [(set GPRD:$lo, GPRD:$hi,
+                                     (smullohi GPRD:$a, GPRD:$b))]>;
+
+// In-place 18-bit immediate add: `add.si rd, imm18` (contract-isa.md
+// §6.1.3).  Expanded to a bank copy (rd2rd) into the result followed by
+// `add.si dst, imm`; the copy is skipped when RA has coalesced dst == src.
+def ADD_IMM_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$src, i64imm:$imm),
+                                 [(set GPRD:$dst, (add GPRD:$src, simm18imm:$imm))]>;
+
+// Large i64 constant materialization (C12, ADR-0018): `set.zw`/`set.ow`
+// basis + `or.w`/`andn.w` fixes, no constant pool (M3 has no .rodata).
+// Expanded by expandPostRAPseudo; the operand is the raw 64-bit value.
+def CONST_WYDE : DADAOPseudo<(outs GPRD:$dst), (ins i64imm:$val), []>;
+
+// Frame address materialization (LLVM-038t, ADR-0018 C7/C8): a frame object
+// address that is used as a *value* (not folded into the address of a
+// load/store) is materialized into a GPRB register.  The operand is a target
+// frame index that DADAORegisterInfo::eliminateFrameIndex rewrites into
+// `rb2rb + add.si` with the PrologEpilogInserter-resolved frame offset.
+def FRAME_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins i64imm:$fi), []>;
+
+// Absolute global-address materialization (LLVM-055t).  The operand is a
+// TargetGlobalAddress and the result lives in GPRB (the address bank, C1/C2,
+// ADR-0018).  It is expanded post-RA by DADAOInstrInfo::expandPostRAPseudo into
+// the fixed 3-slice absolute sequence
+//   set.zw rb, wp0, sym ; or.w rb, wp1, sym ; or.w rb, wp2, sym
+// (ADR-0019 D4/D5: a 48-bit address needs at most 3 wydes; relaxation is
+// disabled, so exactly 3 slices are always emitted).  The symbol operand makes
+// the DADAO MCCodeEmitter attach R_DADAO_ABS48 to each slice; the linker picks
+// the 16-bit slice from the instruction's wyde-position.  ABS48 is absolute and
+// is never resolved in place, so every slice becomes a relocation even for a
+// same-section symbol (the section base is only known at link time).
+def GLOBAL_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+// Jump-table address materialization (LLVM-072t, ISS-177/G3).  The operand is a
+// TargetJumpTable leaf (InstrEmitter -> MO_JumpTableIndex, i.e. the function's
+// local jump-table label).  Expanded post-RA to the same fixed 3-slice absolute
+// sequence as GLOBAL_ADDR (set.zw rb, wp0 ; or.w rb, wp1 ; or.w rb, wp2), each
+// instruction carrying the jump-table symbol so the MCCodeEmitter attaches
+// R_DADAO_ABS48.  The result lives in GPRB (the address bank).
+def JT_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+//===----------------------------------------------------------------------===//
+// Single-result i64 patterns (orrr, contract-isa.md §6.3–§6.4, §7)
+//
+// These instructions have exactly one destination, so they can be selected
+// directly by TableGen without a pseudo.  Pointer/address arithmetic (C14) is
+// handled bank-aware in DADAOISelDAGToDAG (ptr − ptr -> sub.o rd, rb, rb).
+//===----------------------------------------------------------------------===//
+
+def : Pat<(and GPRD:$a, GPRD:$b), (and_o GPRD:$a, GPRD:$b)>;
+def : Pat<(or GPRD:$a, GPRD:$b), (or_o GPRD:$a, GPRD:$b)>;
+def : Pat<(xor GPRD:$a, GPRD:$b), (xor_o GPRD:$a, GPRD:$b)>;
+
+// Bitwise NOT (ISS-159): `not x` = `xor x, -1` lowers to `xnor.o rd, rc, rd0`
+// (contract-isa.md §6.3: a source of rd0 turns xnor into a one's complement),
+// not `xor.o` + a materialized -1 constant.
+def : Pat<(not GPRD:$a), (xnor_o GPRD:$a, rd0)>;
+
+// Integer negation (ISS-159): `sub 0, x` (i64) lowers to the real
+// `sub.so {rd0, dst}, rd0, src` via NEG_PSEUDO (expanded post-RA).  Narrow
+// `neg iN` is the sign-extended narrow subtraction `sub.sb/sw/st dst, rd0, src`
+// (contract-isa.md §10.6/§11.6/§12.6), matched through the sign_extend_inreg
+// that legalization wraps around the promoted sub.
+def : Pat<(i64 (sub 0, GPRD:$a)), (NEG_PSEUDO GPRD:$a)>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i8)), (sub_sb rd0, GPRD:$a)>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i16)), (sub_sw rd0, GPRD:$a)>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i32)), (sub_st rd0, GPRD:$a)>;
+
+// Variable shift amount (orrr): shamt is rdhc low 6 bits (§6.4.1).
+def : Pat<(shl GPRD:$a, GPRD:$b), (shl_uo_orrr GPRD:$a, GPRD:$b)>;
+def : Pat<(srl GPRD:$a, GPRD:$b), (shr_uo_orrr GPRD:$a, GPRD:$b)>;
+def : Pat<(sra GPRD:$a, GPRD:$b), (shr_so_orrr GPRD:$a, GPRD:$b)>;
+
+// 64-bit div/rem (orrr): rdhb = rdhc / rdhb ... (contract-isa.md §6.1.5).
+// DADAO returns defined values for the div-by-zero / INT_MIN/-1 cases that are
+// UB in LLVM IR, so the mapping is safe.
+def : Pat<(udiv GPRD:$a, GPRD:$b), (div_uo GPRD:$a, GPRD:$b)>;
+def : Pat<(sdiv GPRD:$a, GPRD:$b), (div_so GPRD:$a, GPRD:$b)>;
+def : Pat<(urem GPRD:$a, GPRD:$b), (rem_uo GPRD:$a, GPRD:$b)>;
+def : Pat<(srem GPRD:$a, GPRD:$b), (rem_so GPRD:$a, GPRD:$b)>;
+
+//===----------------------------------------------------------------------===//
+// Signed narrow-integer extension: sign_extend_inreg (LLVM-047t; C4/C13)
+//
+// Narrow (i8/i16/i32) integer values live in 64-bit virtual registers (no
+// sub-registers; C13 D1, ADR-0018), so a signed narrow formal argument
+// (`i8/i16/i32 signext`, C4) or an explicit `sext i8/i16/i32 to i64` is
+// legalised to `sign_extend_inreg` on an i64 value: replicate the low N bits
+// and sign-extend from bit N-1 up to bit 63.
+//
+// `ext.so rdhb, rdhc, hd` (orri; contract-isa.md §6.4.2) is exactly that:
+//   rdhb[hd:0] = rdhc[hd:0];  rdhb[63:hd+1] = sign_extend(rdhc[hd])
+// with hd = 7/15/31 selecting a signed i8/i16/i32.  One instruction, no
+// constant pool, and never a zero-extension stand-in (C4 D2 / C5 D2).
+//===----------------------------------------------------------------------===//
+
+def : Pat<(i64 (sext_inreg GPRD:$src, i8)),  (ext_so_orri GPRD:$src, 7)>;
+def : Pat<(i64 (sext_inreg GPRD:$src, i16)), (ext_so_orri GPRD:$src, 15)>;
+def : Pat<(i64 (sext_inreg GPRD:$src, i32)), (ext_so_orri GPRD:$src, 31)>;
+// i1 (LLVM-077t, ISS-186): the promoted `sextload i1` from a sign-extending
+// load legalises to `zextload i8` + `sign_extend_inreg i64, i1` (LegalizeDAG),
+// and an explicit `sext i1` also lands here.  hd = 0 sign-extends from bit 0,
+// i.e. the low bit selects 0 / -1, exactly a signed boolean.
+def : Pat<(i64 (sext_inreg GPRD:$src, i1)), (ext_so_orri GPRD:$src, 0)>;
+
+//===----------------------------------------------------------------------===//
+// Scalar load/store (LLVM-036t; C13/C14, ADR-0018; frame indices LLVM-038t)
+//
+// Address = GPRB base + sign-extended 12-bit immediate (contract-isa.md
+// §3.1.1, C14 D3).  The base is forced into GPRB (C14 D5: RB is the base
+// bank).  The address is matched by the DADAOAddr complex pattern (SelectAddr
+// in DADAOISelDAGToDAG) which folds `base + simm12` and, crucially, keeps a
+// *frame index* in the base position so PrologEpilogInserter can resolve it to
+// `[rbsp/rbfp, offset]` (ADR-0018 C7/C8, LLVM-038t).  Offsets that do not fit
+// simm12 are not folded; the DAG keeps a separate 64-bit add which the generic
+// i64 arithmetic patterns (ADD_IMM_PSEUDO / ADD_PSEUDO) materialize.
+//
+// Narrow accesses are big-endian.  `ld.ub/uw/ut` zero-extend and `ld.sb/sw/st`
+// sign-extend, each writing all 64 bits (SPEC-069t value semantics); stores
+// `st.b/w/t` write the low 8/16/32 bits (contract-isa.md §3.1.1).  The load
+// extension and truncating-store actions are marked Legal in
+// DADAOTargetLowering so the extload/truncstore nodes reach ISel.  Because the
+// target is big-endian, the byte offsets produced by DAGCombine (e.g.
+// ReduceLoadWidth narrowing a wide load plus shift) are BE-derived; matching
+// them via `(add base, simm12)` is what avoids the 0628 DL-068a silent
+// miscompile.
+//===----------------------------------------------------------------------===//
+
+// Signed 12-bit offset matching the `imms12` operand.
+def simm12imm : ImmLeaf<i64, [{ return isInt<12>(Imm); }]>;
+
+// Address operand: a GPRB base plus a sign-extended 12-bit offset.  The
+// SelectAddr C++ matcher accepts a bare frame index as the base (offset 0) as
+// well, so the load/store carries an MO_FrameIndex that PEI rewrites.
+def DADAOAddr : ComplexPattern<i64, 2, "SelectAddr">;
+
+class DADAOLdPat<PatFrag LoadOp, Instruction Inst>
+    : Pat<(i64 (LoadOp (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (Inst GPRB:$base, simm12imm:$off)>;
+
+class DADAOStPat<PatFrag StoreOp, Instruction Inst>
+    : Pat<(StoreOp GPRD:$val, (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (Inst GPRD:$val, GPRB:$base, simm12imm:$off)>;
+
+// 64-bit load/store (ld.o / st.o, RD variants).
+def : DADAOLdPat<load, ld_o_rd>;
+def : DADAOStPat<store, st_o_rd>;
+
+// i8: zero/any extension -> ld.ub, sign extension -> ld.sb, truncating store
+// -> st.b.
+def : DADAOLdPat<extloadi8, ld_ub_rd>;
+def : DADAOLdPat<zextloadi8, ld_ub_rd>;
+def : DADAOLdPat<sextloadi8, ld_sb_rd>;
+def : DADAOStPat<truncstorei8, st_b_rd>;
+
+// i16 (wyde): ld.uw / ld.sw / st.w.
+def : DADAOLdPat<extloadi16, ld_uw_rd>;
+def : DADAOLdPat<zextloadi16, ld_uw_rd>;
+def : DADAOLdPat<sextloadi16, ld_sw_rd>;
+def : DADAOStPat<truncstorei16, st_w_rd>;
+
+// i32 (tetra): ld.ut / ld.st / st.t.
+def : DADAOLdPat<extloadi32, ld_ut_rd>;
+def : DADAOLdPat<zextloadi32, ld_ut_rd>;
+def : DADAOLdPat<sextloadi32, ld_st_rd>;
+def : DADAOStPat<truncstorei32, st_t_rd>;
+
+//===----------------------------------------------------------------------===//
+// Compare / branch selection (LLVM-037t; C17/C14, ADR-0018)
+//
+// The comparisons are lowered by DADAOTargetLowering::LowerBR_CC to
+// DADAOCmp/DADAOCmpU (result -1/0/1 in i64) plus a zero-test branch, or to a
+// direct two-register branch for ==/!= (C17: `==`/`!=` use br.eq/ne, saving
+// the cmp).  The compare result is an ordinary GPRD value, so the only
+// unusual constraint is that the branch and its compare are two separate
+// instructions (no flags / no fusion).
+//
+// Immediate compares: cmp.si (signed, imms12) / cmp.ui (unsigned, immu12).
+// Register compares: cmp.so / cmp.uo.  Pointer compares use the RB form
+// cmp.uo rd, rb, rb (C14 D2).  Branch immediate is PC-relative (see brtarget*
+// in DADAOInstrInfo.td); the fixup shifts right by 2 (word offset).
+//===----------------------------------------------------------------------===//
+
+// Unsigned 12-bit immediate matching the `immu12` operand.
+def immu12imm : ImmLeaf<i64, [{ return isUInt<12>(Imm); }]>;
+
+// Signed compares -> cmp.so (reg,reg) / cmp.si (reg,imm).
+def : Pat<(DADAOCmp GPRD:$l, GPRD:$r), (cmp_so GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmp GPRD:$l, simm12imm:$r), (cmp_si_rd GPRD:$l, simm12imm:$r)>;
+
+// Unsigned compares -> cmp.uo (reg,reg) / cmp.ui (reg,imm).
+// Pointer compares (cmp.uo rd, rb, rb; C14 D2) and the RB-variant zero-test
+// branches (br.z/nz {rb}; C17) are selected bank-aware in DADAOISelDAGToDAG
+// (the TableGen matcher does not discriminate register classes for i64
+// operands -- it would insert a GPRB->GPRD copy, as LLVM-035t found).
+def : Pat<(DADAOCmpU GPRD:$l, GPRD:$r), (cmp_uo GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmpU GPRD:$l, immu12imm:$r), (cmp_ui_rd GPRD:$l, immu12imm:$r)>;
+
+// Zero-test branches on a GPRD value.
+def : Pat<(DADAOBrz  GPRD:$v, bb:$d), (br_z_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnz GPRD:$v, bb:$d), (br_nz_rd GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrn  GPRD:$v, bb:$d), (br_n_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnn GPRD:$v, bb:$d), (br_nn_rd GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrp  GPRD:$v, bb:$d), (br_p_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnp GPRD:$v, bb:$d), (br_np_rd GPRD:$v, bb:$d)>;
+
+// Two-register ==/!= branches (C17: no compare needed).
+def : Pat<(DADAOBreq GPRD:$l, GPRD:$r, bb:$d), (br_eq_rd GPRD:$l, GPRD:$r, bb:$d)>;
+def : Pat<(DADAOBrne GPRD:$l, GPRD:$r, bb:$d), (br_ne_rd GPRD:$l, GPRD:$r, bb:$d)>;
+
+// Conditional assignment (LLVM-069t; contract-isa.md §6.5).  The arms are
+// typed i64 leaves (like the FP selectcc patterns below) so both a register
+// and a constant arm are accepted; a constant arm is materialised into GPRD
+// (CONST_WYDE) like any other register operand.
+def : Pat<(DADAOCSN i64:$c, i64:$t, i64:$f), (cs_n_rd i64:$c, i64:$t, i64:$f)>;
+def : Pat<(DADAOCSZ i64:$c, i64:$t, i64:$f), (cs_z_rd i64:$c, i64:$t, i64:$f)>;
+def : Pat<(DADAOCSP i64:$c, i64:$t, i64:$f), (cs_p_rd i64:$c, i64:$t, i64:$f)>;
+
+// Unconditional branch -> jump (iiii, PC-relative 24-bit).
+def : Pat<(br bb:$d), (jump_iiii bb:$d)>;
+
+//===----------------------------------------------------------------------===//
+// Floating-point CodeGen (M6, LLVM-066t; contract-abi.md §4/§6, contract-fp.md)
+//
+// FP values live in the RF bank (GPRF, 64-bit; f32 in the low 32 bits).  The
+// f64 instructions (fo*) operate on octa float, the f32 instructions (ft*) on
+// tetra float.  rf0 (FCSR) is a legal *source* only (an FP-op destination of
+// rf0 is an ILLI form), which is exactly what the fabs patterns exploit.
+//===----------------------------------------------------------------------===//
+
+// --- f64 (fo): arithmetic / sqrt / neg / abs (orrr, orri) ---
+def : Pat<(fadd f64:$a, f64:$b), (foadd_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fsub f64:$a, f64:$b), (fosub_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fmul f64:$a, f64:$b), (fomul_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fdiv f64:$a, f64:$b), (fodiv_orrr_rf f64:$a, f64:$b)>;
+// rootn(x, 2): the only legal n (contract-fp.md §6).
+def : Pat<(fsqrt f64:$a), (foroot_orri_rf f64:$a, 2)>;
+// fneg(x) = sgnn(x, x) (contract-fp.md §7: sgnn with rfHC == rfHD negates).
+def : Pat<(fneg f64:$a), (fosgnn_orrr_rf f64:$a, f64:$a)>;
+// NB: fabs via `sgnj(x, rf0)` is NOT expressed as a TableGen pattern: rf0 lives
+// in the two-typed GPRF class (f64/f32), so a bare physical-register operand in
+// the pattern result is ambiguous.  fabs stays Expand (a libcall); the
+// freestanding tests do not use it.
+
+// --- f32 (ft): arithmetic / sqrt / neg / abs ---
+def : Pat<(fadd f32:$a, f32:$b), (ftadd_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fsub f32:$a, f32:$b), (ftsub_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fmul f32:$a, f32:$b), (ftmul_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fdiv f32:$a, f32:$b), (ftdiv_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fsqrt f32:$a), (ftroot_orri_rf f32:$a, 2)>;
+def : Pat<(fneg f32:$a), (ftsgnn_orrr_rf f32:$a, f32:$a)>;
+
+// --- FP compare: DADAOISD::FCMP -> foqcmp / ftqcmp (orrr; result in GPRD) ---
+def : Pat<(DADAOFCmp f64:$l, f64:$r), (foqcmp_orrr_rf f64:$l, f64:$r)>;
+def : Pat<(DADAOFCmp f32:$l, f32:$r), (ftqcmp_orrr_rf f32:$l, f32:$r)>;
+
+// --- FP select_cc -> DADAO cs.* conditional assign (contract-isa.md §6.5) ---
+// A `select` on an FP condition *whose result is FP* reaches ISel as SELECT_CC
+// (no FP setcc-as-value in this backend) and is matched here; the FCMP result
+// rc is -1/0/1 for ordered results and a positive NaN for unordered, so every
+// C predicate is one cs test (cs.n/cs.z/cs.p) with possible operand and/or
+// true/false swapping; `>`/`>=` swap the compare operands (rc' = cmp(b, a)).
+// An FP condition selecting *integer* arms (i64 result) is lowered uniformly
+// by DADAOTargetLowering::LowerCmpSelect (LLVM-069t), so it has no pattern
+// here.
+multiclass DADAOFPSelCC<Instruction Cmp, ValueType CmpVT, ValueType ValVT,
+                        Instruction CsN, Instruction CsZ, Instruction CsP> {
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOLT),
+            (CsN (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOLE),
+            (CsP (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOGT),
+            (CsN (Cmp CmpVT:$b, CmpVT:$a), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOGE),
+            (CsP (Cmp CmpVT:$b, CmpVT:$a), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOEQ),
+            (CsZ (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUNE),
+            (CsZ (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUGT),
+            (CsP (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUGE),
+            (CsN (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETULT),
+            (CsP (Cmp CmpVT:$b, CmpVT:$a), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETULE),
+            (CsN (Cmp CmpVT:$b, CmpVT:$a), ValVT:$f, ValVT:$t)>;
+}
+
+defm FPSelCC_f64_rf
+    : DADAOFPSelCC<foqcmp_orrr_rf, f64, f64, cs_n_rrrr_rf, cs_z_rrrr_rf,
+                   cs_p_rrrr_rf>;
+defm FPSelCC_f32_rf
+    : DADAOFPSelCC<ftqcmp_orrr_rf, f32, f32, cs_n_rrrr_rf, cs_z_rrrr_rf,
+                   cs_p_rrrr_rf>;
+
+// --- FP loads/stores (RF bank; ld.t/st.t 4B, ld.o/st.o 8B) ---
+def : Pat<(f64 (load (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (ld_o_rrii_rf GPRB:$base, simm12imm:$off)>;
+def : Pat<(store f64:$val, (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (st_o_rrii_rf f64:$val, GPRB:$base, simm12imm:$off)>;
+def : Pat<(f32 (load (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (ld_t_rrii_rf GPRB:$base, simm12imm:$off)>;
+def : Pat<(store f32:$val, (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (st_t_rrii_rf f32:$val, GPRB:$base, simm12imm:$off)>;
+
+// --- FP format conversions (orri; immu6 = 1 register) ---
+// fpext f32->f64 = ft2fo ; fptrunc f64->f32 = fo2ft (contract-fp.md §2).
+def : Pat<(f64 (fpextend f32:$a)), (ft2fo_orri_rf f32:$a, 1)>;
+def : Pat<(f32 (fpround f64:$a)), (fo2ft_orri_rf f64:$a, 1)>;
+
+// --- FP <-> integer conversions (orri; the int side is always i64) ---
+// fp_to_sint / fp_to_uint -> i octa (fo2io/ft2io for octa floats; signed i,
+// unsigned u).  A narrower (i32/i16/i8) integer result is promoted to i64 by
+// the type legalizer and truncated afterwards.
+def : Pat<(i64 (fp_to_sint f64:$a)), (fo2io_orri_rf f64:$a, 1)>;
+def : Pat<(i64 (fp_to_sint f32:$a)), (ft2io_orri_rf f32:$a, 1)>;
+def : Pat<(i64 (fp_to_uint f64:$a)), (fo2uo_orri_rf f64:$a, 1)>;
+def : Pat<(i64 (fp_to_uint f32:$a)), (ft2uo_orri_rf f32:$a, 1)>;
+// sint_to_fp / uint_to_fp <- i octa (io2fo/uo2fo).  A narrower integer source
+// is promoted to i64 before the conversion, so only the i64 patterns are
+// reachable.
+def : Pat<(f64 (sint_to_fp GPRD:$a)), (io2fo_orri_rf GPRD:$a, 1)>;
+def : Pat<(f32 (sint_to_fp GPRD:$a)), (io2ft_orri_rf GPRD:$a, 1)>;
+def : Pat<(f64 (uint_to_fp GPRD:$a)), (uo2fo_orri_rf GPRD:$a, 1)>;
+def : Pat<(f32 (uint_to_fp GPRD:$a)), (uo2ft_orri_rf GPRD:$a, 1)>;
