+//===-- DADAOCodeGen.td - DADAO CodeGen TableGen defs -------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// SelectionDAG target nodes, CodeGen-only pseudo instructions and i64 ISel
+// patterns for the DADAO M3 backend (LLVM-033t skeleton; LLVM-035t i64
+// arithmetic/constants; LLVM-036t scalar load/store; LLVM-037t compare/branch;
+// LLVM-047t signed narrow-integer sign_extend_inreg).
+//
+// The instruction definitions in DADAOInstrInfo.td are generated from
+// contracts/opcodes.yaml and carry no patterns.  This file adds the CodeGen
+// glue: `llc -march=dadao -stop-after=finalize-isel` can lower scalar
+// add/sub/mul/and/or/xor/shift/div/rem, signed narrow-integer extension,
+// 64-bit constants, scalar load/store and integer compare+branch to MIR.
+//
+// The real `ret` instruction (ret_riii) is expanded later (LLVM-040t); here a
+// CodeGen-only pseudo terminates the function so the MIR can be inspected.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// SelectionDAG target nodes
+//===----------------------------------------------------------------------===//
+
+// Return terminator produced by DADAOTargetLowering::LowerReturn.  Operands:
+//   chain, [return-value registers...], [glue]
+// Matched by RET_PSEUDO below.
+def DADAORetGlue : SDNode<"DADAOISD::RET_GLUE", SDTNone,
+                          [SDNPHasChain, SDNPOptInGlue, SDNPVariadic]>;
+
+//===----------------------------------------------------------------------===//
+// Direct call (LowerCall -> DADAOISD::CALL) and the call-frame pseudos
+// (C16, ADR-0018)
+//
+// Operands: chain, callee, [RegisterMask], [argument Registers...], [glue].
+//   - the callee is a TargetGlobalAddress / TargetExternalSymbol (indirect
+//     calls are deferred to M4);
+//   - the RegisterMask operand is getCallPreservedMask (must include
+//     rb32..rb63, ML-004c);
+//   - the RegisterSDNode operands are the live-in argument registers of this
+//     call site; InstrEmitter turns them into implicit-use MachineOperands,
+//     and the RegisterMaskSDNode into a regmask MachineOperand.
+// DADAOISelDAGToDAG carries all of these onto call_iiii (no TableGen pattern:
+// the variadic operand set cannot be expressed as a fixed TableGen pattern).
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOCall : SDTypeProfile<0, -1, [SDTCisVT<0, i64>]>;
+
+def DADAOCall : SDNode<"DADAOISD::CALL", SDT_DADAOCall,
+                       [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue, SDNPVariadic]>;
+
+// CALLSEQ_START/END -> ADJCALLSTACKDOWN/UP.  The outgoing stack-argument area
+// is either reserved in the prologue (SP-only: hasReservedCallFrame) or
+// adjusted around the call (FP); TargetFrameLowering::eliminateCallFramePseudoInstr
+// handles both (LLVM-039t).
+def SDT_DADAOCallSeqStart : SDCallSeqStart<[SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+def SDT_DADAOCallSeqEnd : SDCallSeqEnd<[SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+
+def DADAOCallSeqStart : SDNode<"ISD::CALLSEQ_START", SDT_DADAOCallSeqStart,
+                               [SDNPHasChain, SDNPOutGlue]>;
+def DADAOCallSeqEnd : SDNode<"ISD::CALLSEQ_END", SDT_DADAOCallSeqEnd,
+                             [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue]>;
+
+//===----------------------------------------------------------------------===//
+// Tail call (LLVM-074t)
+//
+// Operands: chain, callee, [RegisterMask], [argument Registers...], [glue]
+// (the same shape as DADAOCall).  Produced by LowerCall for an eligible tail
+// call (all arguments in registers, non-variadic); selected to TAILJMP
+// (direct) / TAILJMPIND (indirect) by DADAOISelDAGToDAG.
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOTail : SDTypeProfile<0, -1, [SDTCisVT<0, i64>]>;
+def DADAOTail : SDNode<"DADAOISD::TAIL", SDT_DADAOTail,
+                       [SDNPHasChain, SDNPOptInGlue, SDNPOutGlue, SDNPVariadic]>;
+
+
+//===----------------------------------------------------------------------===//
+// Compare / branch target nodes (LLVM-037t; C17, ADR-0018)
+//
+// DADAO has no condition flags (CZSO removed): a comparison computes a value
+// (-1/0/1) into a general register, and a branch tests that register against
+// zero (br.n/nn/z/nz/p/np) or compares two registers directly (br.eq/ne).
+// The comparison result is therefore an ordinary i64 value in a *virtual*
+// register — no fixed condition register, no compare/branch fusion (C17).
+//
+//   DADAOCmp / DADAOCmpU : (lhs, rhs) -> i64   signed / unsigned compare
+//   DADAOBrz/nz/n/nn/p/np: (chain, val, dest)  branch on val vs zero
+//   DADAOBreq / DADAOBrne: (chain, lhs, rhs, dest) two-register branch
+//
+// None of the compare nodes is marked SDNPCommutative: cmp is order sensitive
+// (sign(lhs-rhs) != sign(rhs-lhs)); the 0628 DL-058a/b lesson.
+//===----------------------------------------------------------------------===//
+
+def SDT_DADAOBr1 : SDTypeProfile<0, 2,
+    [SDTCisVT<0, i64>, SDTCisVT<1, OtherVT>]>;
+def SDT_DADAOBr2 : SDTypeProfile<0, 3,
+    [SDTCisVT<0, i64>, SDTCisVT<1, i64>, SDTCisVT<2, OtherVT>]>;
+
+// Integer compare: result is always the 64-bit {-1,0,1} value (getSetCCResultType
+// returns i64, and the branch tests it), while the two operands share one
+// integer type -- i64 for the octa cmp.si/cmp.ui/cmp.so/cmp.uo forms, or a
+// narrow i8/i16/i32 since LLVM-127t (cmp.{sb,sw,st,ub,uw,ut}).  The narrow cmp
+// instructions truncate their sources to their own width, so the operand type
+// is what selects the instruction.
+def SDT_DADAOCmp : SDTypeProfile<1, 2,
+    [SDTCisVT<0, i64>, SDTCisSameAs<1, 2>, SDTCisInt<1>]>;
+def DADAOCmp  : SDNode<"DADAOISD::CMP",  SDT_DADAOCmp>;
+def DADAOCmpU : SDNode<"DADAOISD::CMPU", SDT_DADAOCmp>;
+
+// Floating-point compare (M6, LLVM-066t): result i64 in {-1, 0, 1} ordered, or a
+// positive NaN value for unordered (contract-fp.md §8).  Operands share the
+// same FP type (f64 -> foqcmp, f32 -> ftqcmp).
+def SDT_DADAOFCmp : SDTypeProfile<1, 2, [SDTCisVT<0, i64>, SDTCisSameAs<1, 2>]>;
+def DADAOFCmp : SDNode<"DADAOISD::FCMP", SDT_DADAOFCmp>;
+
+// Floating-point classification (LLVM-126t, contract-fp.md §9): the result is
+// the 10-bit one-hot class word in GPRD; the operand is f32/f64.
+def SDT_DADAOFClass : SDTypeProfile<1, 1, [SDTCisVT<0, i64>, SDTCisFP<1>]>;
+def DADAOFClass : SDNode<"DADAOISD::FCLASS", SDT_DADAOFClass>;
+
+// IEEE 754 scaleB (LLVM-126t, contract-fp.md §5): both operands are the same FP
+// type, and the second is an integer-valued FP number.
+def SDT_DADAOScalb : SDTypeProfile<1, 2,
+    [SDTCisSameAs<0, 1>, SDTCisSameAs<0, 2>]>;
+def DADAOScalb : SDNode<"DADAOISD::SCALB", SDT_DADAOScalb>;
+
+def DADAOBrz  : SDNode<"DADAOISD::BRZ",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnz : SDNode<"DADAOISD::BRNZ", SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrn  : SDNode<"DADAOISD::BRN",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnn : SDNode<"DADAOISD::BRNN", SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrp  : SDNode<"DADAOISD::BRP",  SDT_DADAOBr1, [SDNPHasChain]>;
+def DADAOBrnp : SDNode<"DADAOISD::BRNP", SDT_DADAOBr1, [SDNPHasChain]>;
+
+def DADAOBreq : SDNode<"DADAOISD::BREQ", SDT_DADAOBr2, [SDNPHasChain]>;
+def DADAOBrne : SDNode<"DADAOISD::BRNE", SDT_DADAOBr2, [SDNPHasChain]>;
+
+// Dense switch dispatch (LLVM-072t, ISS-177/G3): (chain, index, TargetJumpTable).
+// Lowered from ISD::BR_JT by DADAOTargetLowering::LowerBR_JT; the custom
+// selector (DADAOISelDAGToDAG::Select) expands it into the jump-table
+// materialize/load/indirect-jump sequence.  Both the index and the jump-table
+// leaf are i64 (pointer-typed) values.
+def SDT_DADAOBrJT : SDTypeProfile<0, 2, [SDTCisVT<0, i64>, SDTCisVT<1, i64>]>;
+def DADAOBrJT : SDNode<"DADAOISD::BR_JT", SDT_DADAOBrJT, [SDNPHasChain]>;
+
+// Indirect branch (LLVM-102t, `indirectbr` / C `goto *p`): (chain, target).
+// Lowered from ISD::BRIND by DADAOTargetLowering::LowerBRIND, which first
+// copies the target (a C data value, RD bank) into a GPRB virtual register;
+// the custom selector emits `jump rbtarget, rd0, 0` (contract-isa.md §8.3).
+def SDT_DADAOBrInd : SDTypeProfile<0, 1, [SDTCisVT<0, i64>]>;
+def DADAOBrInd : SDNode<"DADAOISD::BRIND", SDT_DADAOBrInd, [SDNPHasChain]>;
+
+// Conditional assignment (LLVM-069t / LLVM-079t; contract-isa.md §6.5): (cond,
+// true, false) -> selected value.  The condition is always an i64 comparison
+// result (a cmp* {-1,0,1} or an fp compare result); the two arms share their
+// type, which is also the node's result type -- i64 for integer arms
+// (cs.*_rd) and f64/f32 for FP arms (cs.*_rrrr_rf, LLVM-079t).  Produced by
+// LowerSETCC / LowerSELECT_CC / LowerSELECT.
+def SDT_DADAOCS : SDTypeProfile<1, 3, [SDTCisSameAs<0, 2>, SDTCisSameAs<0, 3>,
+                                       SDTCisVT<1, i64>]>;
+def DADAOCSN : SDNode<"DADAOISD::CS_N", SDT_DADAOCS>;
+def DADAOCSZ : SDNode<"DADAOISD::CS_Z", SDT_DADAOCS>;
+def DADAOCSP : SDNode<"DADAOISD::CS_P", SDT_DADAOCS>;
+
+//===----------------------------------------------------------------------===//
+// CodeGen-only pseudo instruction base
+//===----------------------------------------------------------------------===//
+
+class DADAOPseudo<dag outs, dag ins, list<dag> pattern> : Instruction {
+  let Namespace = "DADAO";
+  let OutOperandList = outs;
+  let InOperandList = ins;
+  let AsmString = "";
+  let Pattern = pattern;
+  let isPseudo = 1;
+  let isCodeGenOnly = 1;
+  let Size = 4;
+}
+
+// Tail-jump instructions (LLVM-074t).  These encode exactly like `jump-iiii`
+// / `jump-rrii` (same opcode field) but are declared isCall/isReturn -- a
+// tail-call terminator that has no successors -- and, crucially, NOT isBranch:
+// their target is a symbol, so BranchRelaxation must never treat them as a
+// branch with a basic-block destination (that would assert in
+// TargetInstrInfo::getBranchDestBlock).  isCodeGenOnly keeps them out of the
+// asm matcher (the `jump` mnemonic is still used when printing).  The block is
+// a return block (isReturn), so PrologEpilogInserter emits the standard
+// epilogue (callee-saved restores + SP/FP teardown) immediately before the
+// jump; the jump pushes no return address, so the callee's `ret` pops the
+// caller's RegRAS entry (contract-isa.md §8.3/§8.4) and the frame is torn down
+// exactly as for a normal `ret`.
+let isCall = 1, isReturn = 1, isTerminator = 1, isBarrier = 1,
+    isCodeGenOnly = 1 in {
+def tailjmp_iiii : DADAOIiii<"jump"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins brtarget24:$imm24);
+  let op = 0x70;
+  let Pattern = [];
+}
+def tailjmp_rrii : DADAORrii<"jump"> {
+  let OutOperandList = (outs );
+  let InOperandList = (ins GPRB:$ra, GPRD:$rb, imms12:$imm12);
+  let op = 0x71;
+  let Pattern = [];
+}
+}
+
+// Function return terminator.  The return value has already been placed in
+// rd8 (scalar) / rb8 (pointer) by LowerReturn via CopyToReg, so no operands
+// are needed here.  Expansion to the real `ret rd0, 0` is LLVM-040t.
+let isReturn = 1, isTerminator = 1, isBarrier = 1 in
+def RET_PSEUDO : DADAOPseudo<(outs), (ins), [(DADAORetGlue)]>;
+
+// Call frame adjustment pseudos (LLVM-039t).  They implicitly use/def SP: the
+// CodeGen must know they may modify the stack pointer before prolog-epilog
+// rewriting, and FinalizeISel sets AdjustsStack when it sees one.  Registered
+// as the call-frame setup/destroy opcodes in DADAOInstrInfo's constructor;
+// expanded/eliminated by DADAOFrameLowering::eliminateCallFramePseudoInstr.
+let Defs = [rb1], Uses = [rb1] in {
+def ADJCALLSTACKDOWN : DADAOPseudo<(outs), (ins i64imm:$amt1, i64imm:$amt2),
+                                   [(DADAOCallSeqStart timm:$amt1, timm:$amt2)]>;
+def ADJCALLSTACKUP : DADAOPseudo<(outs), (ins i64imm:$amt1, i64imm:$amt2),
+                                 [(DADAOCallSeqEnd timm:$amt1, timm:$amt2)]>;
+}
+
+
+//===----------------------------------------------------------------------===//
+// i64 arithmetic pseudos (LLVM-035t)
+//
+// The rrrr add/sub/mul instructions are 128-bit (two destinations): rdha holds
+// the high 64 bits, rdhb the low 64.  CodeGen only needs the low 64 bits, so
+// the selector matches these single-result pseudos and expandPostRAPseudo
+// rewrites them to `add.uo/sub.uo/mul.uo rd0, dst, a, b` (rdha = rd0 discards
+// the high half; ADR-0018 C12 / contract-isa.md §6.1.1).  Selecting the real
+// two-result instruction directly is not expressible as a TableGen pattern
+// (the high result has no DAG value), hence the pseudo indirection.
+//===----------------------------------------------------------------------===//
+
+// Signed immediate that fits the 18-bit `add.si`/riii field (§6.1.3).
+def simm18imm : ImmLeaf<i64, [{ return isInt<18>(Imm); }]>;
+
+def ADD_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (add (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+def SUB_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (sub (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// Negation (ISS-159): `neg x` (i64) must lower to the real `sub.so {rd0, dst},
+// rd0, src` (contract-isa.md §6.6), not `sub.uo` + narrow extension.  sub.so is
+// a two-result rrrr (rdha = high 64 bits, rdhb = low 64 bits), which cannot be
+// expressed as a single-result TableGen pattern, so a single-result pseudo is
+// matched and expanded post-RA (the high half goes to the hardwired-zero rd0).
+def NEG_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$src), []>;
+def MUL_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                             [(set GPRD:$dst, (mul (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// High half of a 64x64 unsigned product (LLVM-073t, ISS-176 / G2).  `mulhu`
+// reaches ISel because i64 MULHU is Legal by default, but the backend had no
+// pattern for it, so a non-power-of-two unsigned division (`a*b/3`, lowered by
+// TargetLowering::BuildUDIV to a magic-constant multiply) aborted with
+// "Cannot select: ... mulhu".  DADAO's `mul.uo` produces the full 128-bit
+// product (contract-isa.md §6.1.4: rdha:rdhb = rdhc x rdhd), so the high half
+// alone is `mul.uo dst, rd0, a, b` (rdhb = rd0 discards the low half).  A
+// two-result rrrr instruction is not expressible as a single-result TableGen
+// pattern, hence the pseudo indirection (mirrors MUL_PSEUDO).
+def MULHU_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                               [(set GPRD:$dst, (mulhu (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// Full 64x64 -> 128 unsigned product (ISD::UMUL_LOHI), e.g. the `unsigned
+// __int128` multiply in aha-mont64's mulul64.  The node's results are
+// (low, high) -- ISDOpcodes.h SMUL_LOHI/UMUL_LOHI; TargetLowering::
+// expandDIVREMByConstant binds Result.getValue(0)=Lo, getValue(1)=Hi -- while
+// mul.uo's def order is (rdha=high, rdhb=low), so the pseudo lists (lo, hi) and
+// expandPostRAPseudo reorders to the instruction's (high, low).
+def UMUL_LOHI_PSEUDO : DADAOPseudo<(outs GPRD:$lo, GPRD:$hi),
+                                   (ins GPRD:$a, GPRD:$b),
+                                   [(set GPRD:$lo, GPRD:$hi,
+                                     (umullohi (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// High half of a 64x64 signed product (LLVM-076t, ISS-185).  `mulhs` reaches
+// ISel because i64 MULHS is Legal by default, but the backend had no pattern
+// for it, so a non-power-of-two signed division (`a*b/3`, lowered by
+// TargetLowering::BuildSDIV to a magic-constant multiply) aborted with
+// "Cannot select: ... mulhs".  DADAO's `mul.so` produces the full 128-bit
+// signed product (contract-isa.md §6.1.4: rdha:rdhb = rdhc x rdhd), so the high
+// half alone is `mul.so dst, rd0, a, b` (rdhb = rd0 discards the low half).  A
+// two-result rrrr instruction is not expressible as a single-result TableGen
+// pattern, hence the pseudo indirection (mirrors MULHU_PSEUDO).
+def MULHS_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                               [(set GPRD:$dst, (mulhs (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// Full 64x64 -> 128 signed product (ISD::SMUL_LOHI), e.g. the `__int128`
+// multiply.  Like UMUL_LOHI the node's results are (low, high) --
+// ISDOpcodes.h; TargetLowering::expandDIVREMByConstant binds getValue(0)=Lo,
+// getValue(1)=Hi -- while mul.so's def order is (rdha=high, rdhb=low), so the
+// pseudo lists (lo, hi) and expandPostRAPseudo reorders to the instruction's
+// (high, low).
+def SMUL_LOHI_PSEUDO : DADAOPseudo<(outs GPRD:$lo, GPRD:$hi),
+                                   (ins GPRD:$a, GPRD:$b),
+                                   [(set GPRD:$lo, GPRD:$hi,
+                                     (smullohi (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+
+// GF(2) carry-less multiply (ADR-0035; LLVM-122t).  `clmul.o {rdha, rdhb},
+// rdhc, rdhd` has rdha = high 64 bits and rdhb = low 64 bits of the 128-bit
+// product, exactly like mul.uo/mul.so, so the three compiler-visible shapes are
+// the same three shapes the multiply needs:
+//
+//   * low half only -- ISD::CLMUL (`llvm.clmul`, low 64 bits) -> the `rd0`
+//     high destination: `clmul.o rd0, dst, a, b`;
+//   * high half only -- `llvm.dadao.clmul.hi` -> `clmul.o dst, rd0, a, b`;
+//   * both halves -- `llvm.dadao.clmul` -> `clmul.o {hi, lo}, a, b`.
+//
+// Why pseudos: rd0 is not an ordinary virtual register, so no DAG pattern can
+// bind a destination to it (same reasoning as MULHU_PSEUDO above).  The pair
+// form has two results, and TableGen matches target intrinsics through
+// INTRINSIC_WO_CHAIN, where a multi-result pattern is not expressible; it is
+// therefore selected by hand (DADAOISelDAGToDAG.cpp, `int_dadao_clmul` and
+// DADAOISD::CLMUL).
+def CLMUL_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                               [(set GPRD:$dst, (clmul (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+def CLMULHI_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$a, GPRD:$b),
+                                 [(set GPRD:$dst,
+                                   (int_dadao_clmul_hi (i64 GPRD:$a), (i64 GPRD:$b)))]>;
+// (lo, hi) -- the instruction's def order is (rdha = high, rdhb = low), so
+// expandPostRAPseudo reorders, mirroring UMUL_LOHI_PSEUDO.
+def CLMUL_LOHI_PSEUDO : DADAOPseudo<(outs GPRD:$lo, GPRD:$hi),
+                                    (ins GPRD:$a, GPRD:$b), []>;
+
+// FCSR rounding-mode writes (LLVM-126t; contract-fp.md §1/§13).  Writing rf0
+// needs a *fixed* destination (the FCSR), which no DAG pattern can bind -- rf0
+// is not an ordinary virtual register, the same reason rd0 needs a pseudo -- so
+// both forms are pseudos with an implicit rf0 def, expanded in FinalizeISel:
+//   * constant mode: one `set.w {rf0}, wp2, hw`.  The FCSR write mask limits a
+//     wp2 write to rf0[33:32], so the accrued flags in wp0 are untouched;
+//   * dynamic mode: one `rd2rf {rf0}, {rd}`, where the lowering already merged
+//     the new mode into a copy of the old FCSR (flags preserved).
+def SET_FCSR_RM_PSEUDO : DADAOPseudo<(outs), (ins immu16:$imm), []> {
+  let Defs = [rf0];
+  let hasSideEffects = 1;
+  let usesCustomInserter = 1;
+}
+def SET_FCSR_PSEUDO : DADAOPseudo<(outs), (ins GPRD:$val), []> {
+  let Defs = [rf0];
+  let hasSideEffects = 1;
+  let usesCustomInserter = 1;
+}
+
+// In-place 18-bit immediate add: `add.si rd, imm18` (contract-isa.md
+// §6.1.3).  Expanded to a bank copy (rd2rd) into the result followed by
+// `add.si dst, imm`; the copy is skipped when RA has coalesced dst == src.
+def ADD_IMM_PSEUDO : DADAOPseudo<(outs GPRD:$dst), (ins GPRD:$src, i64imm:$imm),
+                                 [(set GPRD:$dst, (add GPRD:$src, simm18imm:$imm))]>;
+
+// Large i64 constant materialization (C12, ADR-0018): `set.zw`/`set.ow`
+// basis + `or.w`/`andn.w` fixes, no constant pool (M3 has no .rodata).
+// Expanded by expandPostRAPseudo; the operand is the raw 64-bit value.
+def CONST_WYDE : DADAOPseudo<(outs GPRD:$dst), (ins i64imm:$val), []>;
+
+// Frame address materialization (LLVM-038t, ADR-0018 C7/C8): a frame object
+// address that is used as a *value* (not folded into the address of a
+// load/store) is materialized into a GPRB register.  The operand is a target
+// frame index that DADAORegisterInfo::eliminateFrameIndex rewrites into
+// `rb2rb + add.si` with the PrologEpilogInserter-resolved frame offset.
+def FRAME_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins i64imm:$fi), []>;
+
+// Absolute global-address materialization (LLVM-055t).  The operand is a
+// TargetGlobalAddress and the result lives in GPRB (the address bank, C1/C2,
+// ADR-0018).  It is expanded post-RA by DADAOInstrInfo::expandPostRAPseudo into
+// the fixed 3-slice absolute sequence
+//   set.zw rb, wp0, sym ; or.w rb, wp1, sym ; or.w rb, wp2, sym
+// (ADR-0019 D4/D5: a 48-bit address needs at most 3 wydes; relaxation is
+// disabled, so exactly 3 slices are always emitted).  The symbol operand makes
+// the DADAO MCCodeEmitter attach R_DADAO_ABS48 to each slice; the linker picks
+// the 16-bit slice from the instruction's wyde-position.  ABS48 is absolute and
+// is never resolved in place, so every slice becomes a relocation even for a
+// same-section symbol (the section base is only known at link time).
+def GLOBAL_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+// Local-exec TLS offset materialization (LLVM-100t).  The operand is the
+// TargetGlobalAddress of a `__thread` object and the result is TPOFF(sym) in
+// GPRD (a *data* value: the following `add.o rb, rb3, rd` adds it to the thread
+// pointer).  Expanded post-RA into the same fixed 3-slice sequence as
+// GLOBAL_ADDR, but writing the data bank:
+//   set.zw rd, wp0, sym ; or.w rd, wp1, sym ; or.w rd, wp2, sym
+// Each slice carries R_DADAO_ABS48 against the STT_TLS symbol; for such a
+// symbol the linker's S is the TLS-block offset, i.e. exactly TPOFF here
+// (TLS_ABOVE_TP, GAP_ABOVE_TP 0, TP_OFFSET 0; contract-dynlink.md §4.3/§7).
+def TLS_OFFSET : DADAOPseudo<(outs GPRD:$dst), (ins unknown:$sym), []>;
+
+// Jump-table address materialization (LLVM-072t, ISS-177/G3).  The operand is a
+// TargetJumpTable leaf (InstrEmitter -> MO_JumpTableIndex, i.e. the function's
+// local jump-table label).  Expanded post-RA to the same fixed 3-slice absolute
+// sequence as GLOBAL_ADDR (set.zw rb, wp0 ; or.w rb, wp1 ; or.w rb, wp2), each
+// instruction carrying the jump-table symbol so the MCCodeEmitter attaches
+// R_DADAO_ABS48.  The result lives in GPRB (the address bank).
+def JT_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+// Block-address materialization (LLVM-102t): the address of a basic block
+// whose address is taken (`&&label`, LLVM `blockaddress`) used as a *value*.
+// The operand is a TargetBlockAddress leaf (InstrEmitter -> MO_BlockAddress,
+// resolved by MCInstLower to the symbol AsmPrinter::GetBlockAddressSymbol
+// defines in front of the block).  Expanded post-RA to the same fixed 3-slice
+// absolute sequence as GLOBAL_ADDR, each slice carrying R_DADAO_ABS48; the
+// result lives in GPRB (the address bank), so feeding it to BRIND needs no
+// bank move.
+def BLOCK_ADDR : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+// PC-relative GOT-slot load (ADR-0029 D4/D5): the PIC address of a global
+// object -- and, under PIC, the base of its jump table -- is taken out of the
+// symbol's `.got` slot through the auipc-style hi/lo pair
+//   aip.si rbX, <slot>                   ; R_DADAO_PCREL_HI
+//   ld.o    rbX, [rbX, %pcrel_lo(site)]  ; R_DADAO_PCREL_LO
+//   -> rbX = *(slot) = the symbol's address
+// Two instructions and **no extra register**: the same rbX carries the high
+// part, is the load base and receives the loaded address (ADR-0029 D4; no GP
+// register is reserved, ADR-0026 D5 / ADR-0018 C6).  Only the 18-bit high part
+// bounds the reach, i.e. ±512 MiB -- independent of the `.got`/`.text` layout
+// (ADR-0029 D3), which is what makes the old ±2 KiB `[rb0, slot]` form
+// unnecessary.
+//
+// The operand is the *slot* (a TargetGlobalAddress / TargetJumpTable carrying
+// MO_GOT_ADDR, which DADAOMCInstLower resolves to the `.got` label).  The pair
+// is materialized by DADAOInstrInfo::expandPostRAPseudo, which is also what
+// creates the pairing label for the low half: SelectionDAG carries no symbol
+// for "the address of the following instruction", so the label is attached to
+// the `aip.si` MachineInstr afterwards (setPreInstrSymbol).  The result lives
+// in GPRB (the address bank); rb0 is a reserved register, so the destination
+// can never be the PC alias.  It is a load (the expansion's second instruction
+// reads the slot), hence mayLoad.
+let mayLoad = 1 in
+def PCREL_LOAD : DADAOPseudo<(outs GPRB:$dst), (ins unknown:$sym), []>;
+
+//===----------------------------------------------------------------------===//
+// Single-result i64 patterns (orrr, contract-isa.md §6.3–§6.4, §7)
+//
+// These instructions have exactly one destination, so they can be selected
+// directly by TableGen without a pseudo.  Pointer/address arithmetic (C14) is
+// handled bank-aware in DADAOISelDAGToDAG (ptr − ptr -> sub.o rd, rb, rb).
+//===----------------------------------------------------------------------===//
+
+def : Pat<(and (i64 GPRD:$a), (i64 GPRD:$b)), (and_o (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(or (i64 GPRD:$a), (i64 GPRD:$b)), (or_o (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(xor (i64 GPRD:$a), (i64 GPRD:$b)), (xor_o (i64 GPRD:$a), (i64 GPRD:$b))>;
+
+// Narrow AND/OR/XOR never reach ISel: the operations stay Promote for i8/i16/
+// i32 (there is no narrow logical instruction since SPEC-069t), so the
+// legalizer widens them to i64 and the patterns above select.
+
+// Bitwise NOT (ISS-159): `not x` = `xor x, -1` lowers to `xnor.o rd, rc, rd0`
+// (contract-isa.md §6.3: a source of rd0 turns xnor into a one's complement),
+// not `xor.o` + a materialized -1 constant.
+def : Pat<(not (i64 GPRD:$a)), (xnor_o (i64 GPRD:$a), (i64 rd0))>;
+
+// Integer negation (ISS-159): `sub 0, x` (i64) lowers to the real
+// `sub.so {rd0, dst}, rd0, src` via NEG_PSEUDO (expanded post-RA).  Since
+// LLVM-127t a narrow `neg iN` is a legal iN subtraction with a zero constant
+// and is folded by the custom selector to `sub.sb/sw/st dst, rd0, src`
+// (contract-isa.md §10.5/§11.5/§12.5); the patterns below keep covering the
+// promoted `sign_extend_inreg (sub 0, x)` shape used by i64 code.
+def : Pat<(i64 (sub 0, GPRD:$a)), (NEG_PSEUDO (i64 GPRD:$a))>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i8)), (sub_sb (i64 rd0), (i64 GPRD:$a))>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i16)), (sub_sw (i64 rd0), (i64 GPRD:$a))>;
+def : Pat<(i64 (sext_inreg (sub 0, GPRD:$a), i32)), (sub_st (i64 rd0), (i64 GPRD:$a))>;
+
+// Unsigned 6-bit immediate matching the `immu6` operand (shift/rotate amount;
+// 0..63).  Used by the immediate (orri) rotate pattern below.
+def immu6imm : ImmLeaf<i64, [{ return isUInt<6>(Imm); }]>;
+
+// Variable shift amount (orrr): shamt is rdhc low 6 bits (§6.4.1).
+def : Pat<(shl (i64 GPRD:$a), (i64 GPRD:$b)), (shl_o_orrr (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(srl (i64 GPRD:$a), (i64 GPRD:$b)), (shr_uo_orrr (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(sra (i64 GPRD:$a), (i64 GPRD:$b)), (shr_so_orrr (i64 GPRD:$a), (i64 GPRD:$b))>;
+
+// Rotate left (ADR-0032 D4 as amended 2026-10-19 / LLVM-116t): the ISA's
+// single-direction rotate is `rol`, and ISD::ROTL selects it directly.  The
+// immediate form (orri) is one instruction when the amount fits immu6; the
+// register form (orrr) takes rdHD[5:0], i.e. the amount modulo 64 -- the same
+// low-6-bit convention as the shifts above.  ISD::ROTR is custom-lowered to
+// ROTL in DADAOISelLowering (rotr(x,n) = rol(x, (-n) mod 64)).
+def : Pat<(rotl (i64 GPRD:$a), immu6imm:$b), (rol_o_orri (i64 GPRD:$a), immu6imm:$b)>;
+def : Pat<(rotl (i64 GPRD:$a), (i64 GPRD:$b)), (rol_o_orrr (i64 GPRD:$a), (i64 GPRD:$b))>;
+
+// Bit scan / population count / whole-word reversal (LLVM-128t; ADR-0012
+// D10/D11, contract-isa.md §6.4.3/§6.4.4).  These seven instructions have
+// `immu6 hd` as a *width parameter*, not a shift amount:
+//
+//   ctlz/cttz/ctpop rd, rs, hd   -- valid-bit upper bound rdHC[hd:0]; an
+//        all-zero field yields hd+1 for ctlz/cttz and 0 for ctpop.
+//   rev.o/t/w/b rd, rs, k        -- k is a one-hot element size; k = 8 gives
+//        the byte swap (bswap64/32/16) and rev.o k = 1 the 64-bit bitreverse.
+//
+// i64 is the full-width case: hd = 63 selects bits [63:0], which makes the ISA
+// result identical to the LLVM node, zero included (ctlz(0) = cttz(0) = 64, the
+// *defined* variants; the *_ZERO_POISON nodes are mapped too, since a poison
+// result may be any value and 64 is one of them).  The narrow widths have their
+// own `hd = 31/15/7` patterns right below (LLVM-127t).
+def : Pat<(i64 (ctlz (i64 GPRD:$x))), (ctlz_orri_rd (i64 GPRD:$x), 63)>;
+def : Pat<(i64 (ctlz_zero_poison (i64 GPRD:$x))), (ctlz_orri_rd (i64 GPRD:$x), 63)>;
+def : Pat<(i64 (cttz (i64 GPRD:$x))), (cttz_orri_rd (i64 GPRD:$x), 63)>;
+def : Pat<(i64 (cttz_zero_poison (i64 GPRD:$x))), (cttz_orri_rd (i64 GPRD:$x), 63)>;
+def : Pat<(i64 (ctpop (i64 GPRD:$x))), (ctpop_orri_rd (i64 GPRD:$x), 63)>;
+
+// Narrow bit counts (LLVM-127t; ISS-187): `hd` is the valid-bit upper bound, so
+// hd = 31/15/7 is exactly the i32/i16/i8 operation -- one instruction, and the
+// defined all-zero result is W (ctlz/cttz) / 0 (ctpop).
+def : Pat<(i32 (ctlz (i32 GPRD:$x))), (ctlz_orri_rd (i32 GPRD:$x), 31)>;
+def : Pat<(i16 (ctlz (i16 GPRD:$x))), (ctlz_orri_rd (i16 GPRD:$x), 15)>;
+def : Pat<(i8 (ctlz (i8 GPRD:$x))), (ctlz_orri_rd (i8 GPRD:$x), 7)>;
+def : Pat<(i32 (ctlz_zero_poison (i32 GPRD:$x))),
+          (ctlz_orri_rd (i32 GPRD:$x), 31)>;
+def : Pat<(i16 (ctlz_zero_poison (i16 GPRD:$x))),
+          (ctlz_orri_rd (i16 GPRD:$x), 15)>;
+def : Pat<(i8 (ctlz_zero_poison (i8 GPRD:$x))),
+          (ctlz_orri_rd (i8 GPRD:$x), 7)>;
+def : Pat<(i32 (cttz (i32 GPRD:$x))), (cttz_orri_rd (i32 GPRD:$x), 31)>;
+def : Pat<(i16 (cttz (i16 GPRD:$x))), (cttz_orri_rd (i16 GPRD:$x), 15)>;
+def : Pat<(i8 (cttz (i8 GPRD:$x))), (cttz_orri_rd (i8 GPRD:$x), 7)>;
+def : Pat<(i32 (cttz_zero_poison (i32 GPRD:$x))),
+          (cttz_orri_rd (i32 GPRD:$x), 31)>;
+def : Pat<(i16 (cttz_zero_poison (i16 GPRD:$x))),
+          (cttz_orri_rd (i16 GPRD:$x), 15)>;
+def : Pat<(i8 (cttz_zero_poison (i8 GPRD:$x))),
+          (cttz_orri_rd (i8 GPRD:$x), 7)>;
+def : Pat<(i32 (ctpop (i32 GPRD:$x))), (ctpop_orri_rd (i32 GPRD:$x), 31)>;
+def : Pat<(i16 (ctpop (i16 GPRD:$x))), (ctpop_orri_rd (i16 GPRD:$x), 15)>;
+def : Pat<(i8 (ctpop (i8 GPRD:$x))), (ctpop_orri_rd (i8 GPRD:$x), 7)>;
+
+// bswap64 = rev.o with k = 8 (reverse the eight 8-bit elements of the block);
+// bitreverse64 = rev.o with k = 1.  Since LLVM-127t i32/i16 are legal types, so
+// bswap32 is a direct `rev.t` pattern and bswap16 a direct `rev.w` one (below).
+def : Pat<(i64 (bswap (i64 GPRD:$x))), (rev_o_orri_rd (i64 GPRD:$x), 8)>;
+def : Pat<(i64 (bitreverse (i64 GPRD:$x))), (rev_o_orri_rd (i64 GPRD:$x), 1)>;
+
+// 64-bit div/rem (orrr): rdhb = rdhc / rdhb ... (contract-isa.md §6.1.5).
+// DADAO returns defined values for the div-by-zero / INT_MIN/-1 cases that are
+// UB in LLVM IR, so the mapping is safe.
+def : Pat<(udiv (i64 GPRD:$a), (i64 GPRD:$b)), (div_uo (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(sdiv (i64 GPRD:$a), (i64 GPRD:$b)), (div_so (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(urem (i64 GPRD:$a), (i64 GPRD:$b)), (rem_uo (i64 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(srem (i64 GPRD:$a), (i64 GPRD:$b)), (rem_so (i64 GPRD:$a), (i64 GPRD:$b))>;
+
+//===----------------------------------------------------------------------===//
+// Narrow integer patterns (LLVM-127t; contract-isa.md §10/§11/§12)
+//
+// The narrow add/sub/mul/div/rem instructions take one destination and write
+// the 64-bit canonical extension themselves: `.s*` sign-extends, `.u*`
+// zero-extends (contract-isa.md §10.1.1/§11.1.1/§12.1.1, §6.1.5).  LLVM's
+// ADD/SUB/MUL are sign-agnostic, so the `.s*` form is used: the low N bits are
+// the result and the upper half is the canonical sign extension; a consumer
+// that needs the unsigned value extends explicitly (ext.uo below).  DIV/REM do
+// carry signedness, so UDIV/UREM use the `.u*` and SDIV/SREM the `.s*` form.
+//===----------------------------------------------------------------------===//
+
+def : Pat<(i32 (add (i32 GPRD:$a), (i32 GPRD:$b))), (add_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (add (i16 GPRD:$a), (i16 GPRD:$b))), (add_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (add (i8 GPRD:$a), (i8 GPRD:$b))), (add_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i32 (sub (i32 GPRD:$a), (i32 GPRD:$b))), (sub_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (sub (i16 GPRD:$a), (i16 GPRD:$b))), (sub_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (sub (i8 GPRD:$a), (i8 GPRD:$b))), (sub_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i32 (mul (i32 GPRD:$a), (i32 GPRD:$b))), (mul_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (mul (i16 GPRD:$a), (i16 GPRD:$b))), (mul_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (mul (i8 GPRD:$a), (i8 GPRD:$b))), (mul_sb GPRD:$a, GPRD:$b)>;
+
+def : Pat<(i32 (udiv (i32 GPRD:$a), (i32 GPRD:$b))), (div_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (udiv (i16 GPRD:$a), (i16 GPRD:$b))), (div_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (udiv (i8 GPRD:$a), (i8 GPRD:$b))), (div_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i32 (sdiv (i32 GPRD:$a), (i32 GPRD:$b))), (div_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (sdiv (i16 GPRD:$a), (i16 GPRD:$b))), (div_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (sdiv (i8 GPRD:$a), (i8 GPRD:$b))), (div_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i32 (urem (i32 GPRD:$a), (i32 GPRD:$b))), (rem_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (urem (i16 GPRD:$a), (i16 GPRD:$b))), (rem_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (urem (i8 GPRD:$a), (i8 GPRD:$b))), (rem_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i32 (srem (i32 GPRD:$a), (i32 GPRD:$b))), (rem_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i16 (srem (i16 GPRD:$a), (i16 GPRD:$b))), (rem_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i8 (srem (i8 GPRD:$a), (i8 GPRD:$b))), (rem_sb GPRD:$a, GPRD:$b)>;
+
+// LLVM-132t: when a narrow producer is consumed immediately by an exact
+// i64 extension, select the producer variant whose ISA result already has the
+// requested canonical high bits.  These patterns are deliberately restricted
+// to i64 consumers: a bare narrow value still has no defined upper half, and
+// ABI argument/return extensions remain in the calling-convention lowering.
+// Direction-mismatched pairs are not listed and therefore retain ext.so/ext.uo.
+def : Pat<(i64 (sext (i32 (add (i32 GPRD:$a), (i32 GPRD:$b))))), (add_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (add (i32 GPRD:$a), (i32 GPRD:$b))))), (add_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i32 (sub (i32 GPRD:$a), (i32 GPRD:$b))))), (sub_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (sub (i32 GPRD:$a), (i32 GPRD:$b))))), (sub_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i32 (mul (i32 GPRD:$a), (i32 GPRD:$b))))), (mul_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (mul (i32 GPRD:$a), (i32 GPRD:$b))))), (mul_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (udiv (i32 GPRD:$a), (i32 GPRD:$b))))), (div_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (urem (i32 GPRD:$a), (i32 GPRD:$b))))), (rem_ut GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i32 (sdiv (i32 GPRD:$a), (i32 GPRD:$b))))), (div_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i32 (srem (i32 GPRD:$a), (i32 GPRD:$b))))), (rem_st GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i16 (add (i16 GPRD:$a), (i16 GPRD:$b))))), (add_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i16 (add (i16 GPRD:$a), (i16 GPRD:$b))))), (add_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i16 (sub (i16 GPRD:$a), (i16 GPRD:$b))))), (sub_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i16 (sub (i16 GPRD:$a), (i16 GPRD:$b))))), (sub_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i16 (mul (i16 GPRD:$a), (i16 GPRD:$b))))), (mul_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i16 (mul (i16 GPRD:$a), (i16 GPRD:$b))))), (mul_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i16 (udiv (i16 GPRD:$a), (i16 GPRD:$b))))), (div_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i16 (urem (i16 GPRD:$a), (i16 GPRD:$b))))), (rem_uw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i16 (sdiv (i16 GPRD:$a), (i16 GPRD:$b))))), (div_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i16 (srem (i16 GPRD:$a), (i16 GPRD:$b))))), (rem_sw GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i8 (add (i8 GPRD:$a), (i8 GPRD:$b))))), (add_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i8 (add (i8 GPRD:$a), (i8 GPRD:$b))))), (add_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i8 (sub (i8 GPRD:$a), (i8 GPRD:$b))))), (sub_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i8 (sub (i8 GPRD:$a), (i8 GPRD:$b))))), (sub_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i8 (mul (i8 GPRD:$a), (i8 GPRD:$b))))), (mul_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i8 (mul (i8 GPRD:$a), (i8 GPRD:$b))))), (mul_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i8 (udiv (i8 GPRD:$a), (i8 GPRD:$b))))), (div_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i8 (urem (i8 GPRD:$a), (i8 GPRD:$b))))), (rem_ub GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i8 (sdiv (i8 GPRD:$a), (i8 GPRD:$b))))), (div_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (sext (i8 (srem (i8 GPRD:$a), (i8 GPRD:$b))))), (rem_sb GPRD:$a, GPRD:$b)>;
+def : Pat<(i64 (zext (i32 (shl (i32 GPRD:$a), (i64 GPRD:$b))))), (shl_t_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (zext (i32 (srl (i32 GPRD:$a), (i64 GPRD:$b))))), (shr_ut_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (sext (i32 (sra (i32 GPRD:$a), (i64 GPRD:$b))))), (shr_st_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (zext (i16 (shl (i16 GPRD:$a), (i64 GPRD:$b))))), (shl_w_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (zext (i16 (srl (i16 GPRD:$a), (i64 GPRD:$b))))), (shr_uw_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (sext (i16 (sra (i16 GPRD:$a), (i64 GPRD:$b))))), (shr_sw_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (zext (i8 (shl (i8 GPRD:$a), (i64 GPRD:$b))))), (shl_b_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (zext (i8 (srl (i8 GPRD:$a), (i64 GPRD:$b))))), (shr_ub_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i64 (sext (i8 (sra (i8 GPRD:$a), (i64 GPRD:$b))))), (shr_sb_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+// Narrow shifts, register form.  The orrr form takes rdHD[log2(W)-1:0], i.e.
+// the shift amount modulo the width.  A *constant* amount is folded to the
+// one-instruction orri form in DADAOISelDAGToDAG::Select (a TableGen immediate
+// leaf cannot be used: the DAG shift amount has the narrow type while the
+// `immu6` operand is i64).  The orri form requires immu6 <= W-1 (else ILLI), so
+// the selector only folds amounts in range; LLVM shifts by >= W are poison
+// anyway.  `shl.*` zero-extends its result, `shr.s*` sign-extends, `shr.u*`
+// zero-extends (contract-isa.md §10.4.1/§11.4.1/§12.4.1).
+def : Pat<(i32 (shl (i32 GPRD:$a), (i64 GPRD:$b))), (shl_t_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i16 (shl (i16 GPRD:$a), (i64 GPRD:$b))), (shl_w_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i8 (shl (i8 GPRD:$a), (i64 GPRD:$b))), (shl_b_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i32 (srl (i32 GPRD:$a), (i64 GPRD:$b))), (shr_ut_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i16 (srl (i16 GPRD:$a), (i64 GPRD:$b))), (shr_uw_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i8 (srl (i8 GPRD:$a), (i64 GPRD:$b))), (shr_ub_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i32 (sra (i32 GPRD:$a), (i64 GPRD:$b))), (shr_st_orrr (i32 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i16 (sra (i16 GPRD:$a), (i64 GPRD:$b))), (shr_sw_orrr (i16 GPRD:$a), (i64 GPRD:$b))>;
+def : Pat<(i8 (sra (i8 GPRD:$a), (i64 GPRD:$b))), (shr_sb_orrr (i8 GPRD:$a), (i64 GPRD:$b))>;
+
+// Narrow byte swaps (bswap.i8 is an identity and never reaches ISel).
+def : Pat<(i32 (bswap (i32 GPRD:$x))), (rev_t_orri_rd GPRD:$x, 8)>;
+def : Pat<(i16 (bswap (i16 GPRD:$x))), (rev_w_orri_rd GPRD:$x, 8)>;
+
+//===----------------------------------------------------------------------===//
+// Explicit narrow extensions and truncations (LLVM-127t; contract-abi.md §4.2)
+//
+// `ext.uo rdhb, rdhc, hd` copies bits [hd:0] and zero-fills [63:hd+1];
+// `ext.so` sign-fills instead (contract-isa.md §6.4.2).  Both therefore also
+// perform a truncation to hd+1 bits when the result type is narrower.  One
+// instruction per extend/truncate, and the zero-extending form is what makes a
+// `uint32_t` argument canonical (contract-abi §4.2 "保持符号位不变" for signed,
+// zero extension for unsigned).
+//
+// extend: every narrow -> wider combination (the result may be i64 or a wider
+// narrow type).  ANY_EXTEND needs no defined upper half, so the zero-extending
+// form is a valid implementation.
+//===----------------------------------------------------------------------===//
+
+def : Pat<(i64 (zext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i64 (zext (i16 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i64 (zext (i32 GPRD:$s))), (ext_uo_orri GPRD:$s, 31)>;
+def : Pat<(i32 (zext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i32 (zext (i16 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i16 (zext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+
+def : Pat<(i64 (anyext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i64 (anyext (i16 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i64 (anyext (i32 GPRD:$s))), (ext_uo_orri GPRD:$s, 31)>;
+def : Pat<(i32 (anyext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i32 (anyext (i16 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i16 (anyext (i8 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+
+def : Pat<(i64 (sext (i8 GPRD:$s))),  (ext_so_orri GPRD:$s, 7)>;
+def : Pat<(i64 (sext (i16 GPRD:$s))), (ext_so_orri GPRD:$s, 15)>;
+def : Pat<(i64 (sext (i32 GPRD:$s))), (ext_so_orri GPRD:$s, 31)>;
+def : Pat<(i32 (sext (i8 GPRD:$s))),  (ext_so_orri GPRD:$s, 7)>;
+def : Pat<(i32 (sext (i16 GPRD:$s))), (ext_so_orri GPRD:$s, 15)>;
+def : Pat<(i16 (sext (i8 GPRD:$s))),  (ext_so_orri GPRD:$s, 7)>;
+
+// truncate: `ext.uo` keeps the low bits and zero-fills the rest, which is a
+// valid iN value (no defined upper half).
+def : Pat<(i32 (trunc (i64 GPRD:$s))), (ext_uo_orri GPRD:$s, 31)>;
+def : Pat<(i16 (trunc (i64 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i8 (trunc (i64 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i16 (trunc (i32 GPRD:$s))), (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i8 (trunc (i32 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i8 (trunc (i16 GPRD:$s))),  (ext_uo_orri GPRD:$s, 7)>;
+
+// `(zext (trunc X))` is folded by DAGCombine into an AND with a width mask;
+// selecting it as one ext.uo keeps a `(uint32_t)` cast to one instruction
+// instead of materialising the mask and AND-ing.
+def : Pat<(i64 (and (i64 GPRD:$s), (i64 255))),
+          (ext_uo_orri GPRD:$s, 7)>;
+def : Pat<(i64 (and (i64 GPRD:$s), (i64 65535))),
+          (ext_uo_orri GPRD:$s, 15)>;
+def : Pat<(i64 (and (i64 GPRD:$s), (i64 4294967295))),
+          (ext_uo_orri GPRD:$s, 31)>;
+
+// FP <-> i32 bitcasts: the bank block moves copy 64 bits unchanged, and only
+// the low 32 bits of an f32 are significant (contract-fp.md §12), so one
+// rd2rf / rf2rd is the whole bitcast.  (i64 <-> f64 is handled above.)
+def : Pat<(f32 (bitconvert i32:$a)), (rd2rf_orri_rf i32:$a, 1)>;
+def : Pat<(i32 (bitconvert f32:$a)), (rf2rd_orri_rf f32:$a, 1)>;
+
+//===----------------------------------------------------------------------===//
+// Signed narrow-integer extension: sign_extend_inreg (LLVM-047t; C4/C13)
+//
+// Narrow (i8/i16/i32) integer values live in 64-bit virtual registers (no
+// sub-registers; C13 D1, ADR-0018), so a signed narrow formal argument
+// (`i8/i16/i32 signext`, C4) or an explicit `sext i8/i16/i32 to i64` is
+// legalised to `sign_extend_inreg` on an i64 value: replicate the low N bits
+// and sign-extend from bit N-1 up to bit 63.
+//
+// `ext.so rdhb, rdhc, hd` (orri; contract-isa.md §6.4.2) is exactly that:
+//   rdhb[hd:0] = rdhc[hd:0];  rdhb[63:hd+1] = sign_extend(rdhc[hd])
+// with hd = 7/15/31 selecting a signed i8/i16/i32.  One instruction, no
+// constant pool, and never a zero-extension stand-in (C4 D2 / C5 D2).
+//===----------------------------------------------------------------------===//
+
+def : Pat<(i64 (sext_inreg GPRD:$src, i8)),  (ext_so_orri GPRD:$src, 7)>;
+def : Pat<(i64 (sext_inreg GPRD:$src, i16)), (ext_so_orri GPRD:$src, 15)>;
+def : Pat<(i64 (sext_inreg GPRD:$src, i32)), (ext_so_orri GPRD:$src, 31)>;
+// i1 (LLVM-077t, ISS-186): the promoted `sextload i1` from a sign-extending
+// load legalises to `zextload i8` + `sign_extend_inreg i64, i1` (LegalizeDAG),
+// and an explicit `sext i1` also lands here.  hd = 0 sign-extends from bit 0,
+// i.e. the low bit selects 0 / -1, exactly a signed boolean.
+def : Pat<(i64 (sext_inreg GPRD:$src, i1)), (ext_so_orri GPRD:$src, 0)>;
+// The narrow-result forms of the same i1 case: a 0/1 boolean used as an i8/i16/
+// i32 (e.g. `(a > 0) - (b > 0)` in wcwidth), selected as `ext.so hd = 0`.
+def : Pat<(i32 (sext_inreg (i32 GPRD:$src), i1)),
+          (ext_so_orri (i32 GPRD:$src), 0)>;
+def : Pat<(i16 (sext_inreg (i16 GPRD:$src), i1)),
+          (ext_so_orri (i16 GPRD:$src), 0)>;
+def : Pat<(i8 (sext_inreg (i8 GPRD:$src), i1)),
+          (ext_so_orri (i8 GPRD:$src), 0)>;
+
+// Narrow-result sign_extend_inreg (LLVM-127t): DAGCombine produces these on an
+// i8/i16/i32 value, and `ext.so` sign-fills the whole register, which includes
+// the correct iN result.  (The i64-result forms above stay the common case.)
+def : Pat<(i32 (sext_inreg (i32 GPRD:$src), i8)),
+          (ext_so_orri (i32 GPRD:$src), 7)>;
+def : Pat<(i32 (sext_inreg (i32 GPRD:$src), i16)),
+          (ext_so_orri (i32 GPRD:$src), 15)>;
+def : Pat<(i16 (sext_inreg (i16 GPRD:$src), i8)),
+          (ext_so_orri (i16 GPRD:$src), 7)>;
+
+//===----------------------------------------------------------------------===//
+// Scalar load/store (LLVM-036t; C13/C14, ADR-0018; frame indices LLVM-038t)
+//
+// Address = GPRB base + sign-extended 12-bit immediate (contract-isa.md
+// §3.1.1, C14 D3).  The base is forced into GPRB (C14 D5: RB is the base
+// bank).  The address is matched by the DADAOAddr complex pattern (SelectAddr
+// in DADAOISelDAGToDAG) which folds `base + simm12` and, crucially, keeps a
+// *frame index* in the base position so PrologEpilogInserter can resolve it to
+// `[rbsp/rb2 (FP), offset]` (ADR-0018 C7/C8, LLVM-038t).  Offsets that do not fit
+// simm12 are not folded; the DAG keeps a separate 64-bit add which the generic
+// i64 arithmetic patterns (ADD_IMM_PSEUDO / ADD_PSEUDO) materialize.
+//
+// Narrow accesses are big-endian.  `ld.ub/uw/ut` zero-extend and `ld.sb/sw/st`
+// sign-extend, each writing all 64 bits (SPEC-069t value semantics); stores
+// `st.b/w/t` write the low 8/16/32 bits (contract-isa.md §3.1.1).  The load
+// extension and truncating-store actions are marked Legal in
+// DADAOTargetLowering so the extload/truncstore nodes reach ISel.  Because the
+// target is big-endian, the byte offsets produced by DAGCombine (e.g.
+// ReduceLoadWidth narrowing a wide load plus shift) are BE-derived; matching
+// them via `(add base, simm12)` is what avoids the 0628 DL-068a silent
+// miscompile.
+//===----------------------------------------------------------------------===//
+
+// Signed 12-bit offset matching the `imms12` operand.
+def simm12imm : ImmLeaf<i64, [{ return isInt<12>(Imm); }]>;
+
+// Address operand: a GPRB base plus a sign-extended 12-bit offset.  The
+// SelectAddr C++ matcher accepts a bare frame index as the base (offset 0) as
+// well, so the load/store carries an MO_FrameIndex that PEI rewrites.
+def DADAOAddr : ComplexPattern<i64, 2, "SelectAddr">;
+
+class DADAOLdPat<PatFrag LoadOp, Instruction Inst, ValueType VT = i64>
+    : Pat<(VT (LoadOp (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (Inst GPRB:$base, simm12imm:$off)>;
+
+// The value type is explicit: since LLVM-127t four integer widths are legal, so
+// an untyped GPRD operand no longer determines the store's value type.  A
+// truncating store may still see a *wider* value (i64 -> i32, i32 -> i8, ...),
+// hence one instance per (value type, memory type) pair that can occur.
+class DADAOStPat<PatFrag StoreOp, Instruction Inst, ValueType VT>
+    : Pat<(StoreOp (VT GPRD:$val), (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (Inst GPRD:$val, GPRB:$base, simm12imm:$off)>;
+
+// 64-bit load/store (ld.o / st.o, RD variants) and the extloads to i64.
+def : DADAOLdPat<load, ld_o_rd>;
+def : DADAOStPat<store, st_o_rd, i64>;
+
+// i8: zero/any extension -> ld.ub, sign extension -> ld.sb, truncating store
+// -> st.b.
+def : DADAOLdPat<extloadi8, ld_ub_rd>;
+def : DADAOLdPat<zextloadi8, ld_ub_rd>;
+def : DADAOLdPat<sextloadi8, ld_sb_rd>;
+def : DADAOStPat<truncstorei8, st_b_rd, i64>;
+def : DADAOStPat<truncstorei8, st_b_rd, i32>;
+def : DADAOStPat<truncstorei8, st_b_rd, i16>;
+
+// i16 (wyde): ld.uw / ld.sw / st.w.
+def : DADAOLdPat<extloadi16, ld_uw_rd>;
+def : DADAOLdPat<zextloadi16, ld_uw_rd>;
+def : DADAOLdPat<sextloadi16, ld_sw_rd>;
+def : DADAOStPat<truncstorei16, st_w_rd, i64>;
+def : DADAOStPat<truncstorei16, st_w_rd, i32>;
+
+// i32 (tetra): ld.ut / ld.st / st.t.
+def : DADAOLdPat<extloadi32, ld_ut_rd>;
+def : DADAOLdPat<zextloadi32, ld_ut_rd>;
+def : DADAOLdPat<sextloadi32, ld_st_rd>;
+def : DADAOStPat<truncstorei32, st_t_rd, i64>;
+
+// --- narrow-result accesses (LLVM-127t) ------------------------------------
+// With i8/i16/i32 legal, an access whose result stays narrow -- a plain load or
+// a narrowing load extension -- has to be selected at that width:
+//   ld.ub / ld.uw / ld.ut  zero-extend (used for load/zextload/any-extload),
+//   ld.sb / ld.sw / ld.st  sign-extend (sextload),
+//   st.b / st.w / st.t     write the low 8/16/32 bits (plain stores).
+// The chosen instruction writes all 64 bits, so the (undefined) upper half of
+// a narrow value is harmless.
+def : DADAOLdPat<load, ld_ub_rd, i8>;
+def : DADAOLdPat<load, ld_uw_rd, i16>;
+def : DADAOLdPat<load, ld_ut_rd, i32>;
+def : DADAOStPat<store, st_b_rd, i8>;
+def : DADAOStPat<store, st_w_rd, i16>;
+def : DADAOStPat<store, st_t_rd, i32>;
+
+def : DADAOLdPat<extloadi8, ld_ub_rd, i16>;
+def : DADAOLdPat<extloadi8, ld_ub_rd, i32>;
+def : DADAOLdPat<zextloadi8, ld_ub_rd, i16>;
+def : DADAOLdPat<zextloadi8, ld_ub_rd, i32>;
+def : DADAOLdPat<sextloadi8, ld_sb_rd, i16>;
+def : DADAOLdPat<sextloadi8, ld_sb_rd, i32>;
+
+def : DADAOLdPat<extloadi16, ld_uw_rd, i32>;
+def : DADAOLdPat<zextloadi16, ld_uw_rd, i32>;
+def : DADAOLdPat<sextloadi16, ld_sw_rd, i32>;
+
+//===----------------------------------------------------------------------===//
+// Compare / branch selection (LLVM-037t; C17/C14, ADR-0018)
+//
+// The comparisons are lowered by DADAOTargetLowering::LowerBR_CC to
+// DADAOCmp/DADAOCmpU (result -1/0/1 in i64) plus a zero-test branch, or to a
+// direct two-register branch for ==/!= (C17: `==`/`!=` use br.eq/ne, saving
+// the cmp).  The compare result is an ordinary GPRD value, so the only
+// unusual constraint is that the branch and its compare are two separate
+// instructions (no flags / no fusion).
+//
+// Immediate compares: cmp.si (signed, imms12) / cmp.ui (unsigned, immu12).
+// Register compares: cmp.so / cmp.uo.  Pointer compares use the RB form
+// cmp.uo rd, rb, rb (C14 D2).  Branch immediate is PC-relative (see brtarget*
+// in DADAOInstrInfo.td); the fixup shifts right by 2 (word offset).
+//===----------------------------------------------------------------------===//
+
+// Unsigned 12-bit immediate matching the `immu12` operand.
+def immu12imm : ImmLeaf<i64, [{ return isUInt<12>(Imm); }]>;
+
+// Signed compares -> cmp.so (reg,reg) / cmp.si (reg,imm).
+def : Pat<(DADAOCmp (i64 GPRD:$l), (i64 GPRD:$r)),
+          (cmp_so GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmp (i64 GPRD:$l), simm12imm:$r),
+          (cmp_si_rd GPRD:$l, simm12imm:$r)>;
+
+// Unsigned compares -> cmp.uo (reg,reg) / cmp.ui (reg,imm).
+// Pointer compares (cmp.uo rd, rb, rb; C14 D2) and the RB-variant zero-test
+// branches (br.z/nz {rb}; C17) are selected bank-aware in DADAOISelDAGToDAG
+// (the TableGen matcher does not discriminate register classes for i64
+// operands -- it would insert a GPRB->GPRD copy, as LLVM-035t found).
+def : Pat<(DADAOCmpU (i64 GPRD:$l), (i64 GPRD:$r)),
+          (cmp_uo GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmpU (i64 GPRD:$l), immu12imm:$r),
+          (cmp_ui_rd GPRD:$l, immu12imm:$r)>;
+
+// Narrow compares (LLVM-127t): cmp.{st,sw,sb} / cmp.{ut,uw,ub}.  The
+// instructions have no immediate form, so a constant operand is materialised
+// into a GPRD register like any other value.  The result is still the i64
+// {-1,0,1} value consumed by br.*/cs.*.
+def : Pat<(DADAOCmp (i32 GPRD:$l), (i32 GPRD:$r)),
+          (cmp_st GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmp (i16 GPRD:$l), (i16 GPRD:$r)),
+          (cmp_sw GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmp (i8 GPRD:$l), (i8 GPRD:$r)),
+          (cmp_sb GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmpU (i32 GPRD:$l), (i32 GPRD:$r)),
+          (cmp_ut GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmpU (i16 GPRD:$l), (i16 GPRD:$r)),
+          (cmp_uw GPRD:$l, GPRD:$r)>;
+def : Pat<(DADAOCmpU (i8 GPRD:$l), (i8 GPRD:$r)),
+          (cmp_ub GPRD:$l, GPRD:$r)>;
+
+// Zero-test branches on a GPRD value.
+def : Pat<(DADAOBrz  GPRD:$v, bb:$d), (br_z_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnz GPRD:$v, bb:$d), (br_nz_rd GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrn  GPRD:$v, bb:$d), (br_n_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnn GPRD:$v, bb:$d), (br_nn_rd GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrp  GPRD:$v, bb:$d), (br_p_rd  GPRD:$v, bb:$d)>;
+def : Pat<(DADAOBrnp GPRD:$v, bb:$d), (br_np_rd GPRD:$v, bb:$d)>;
+
+// Two-register ==/!= branches (C17: no compare needed).
+def : Pat<(DADAOBreq GPRD:$l, GPRD:$r, bb:$d), (br_eq_rd GPRD:$l, GPRD:$r, bb:$d)>;
+def : Pat<(DADAOBrne GPRD:$l, GPRD:$r, bb:$d), (br_ne_rd GPRD:$l, GPRD:$r, bb:$d)>;
+
+// Conditional assignment (LLVM-069t; contract-isa.md §6.5).  The arms are
+// typed i64 leaves (like the FP selectcc patterns below) so both a register
+// and a constant arm are accepted; a constant arm is materialised into GPRD
+// (CONST_WYDE) like any other register operand.
+def : Pat<(DADAOCSN i64:$c, i64:$t, i64:$f), (cs_n_rd i64:$c, i64:$t, i64:$f)>;
+def : Pat<(DADAOCSZ i64:$c, i64:$t, i64:$f), (cs_z_rd i64:$c, i64:$t, i64:$f)>;
+def : Pat<(DADAOCSP i64:$c, i64:$t, i64:$f), (cs_p_rd i64:$c, i64:$t, i64:$f)>;
+
+// Narrow integer arms (LLVM-127t): a `select` / `select_cc` on i8/i16/i32
+// values uses the same cs.*_rd instruction; the arm type is the node's result
+// type, so one pattern per width.
+def : Pat<(DADAOCSN i64:$c, (i32 GPRD:$t), (i32 GPRD:$f)),
+          (cs_n_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSZ i64:$c, (i32 GPRD:$t), (i32 GPRD:$f)),
+          (cs_z_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSP i64:$c, (i32 GPRD:$t), (i32 GPRD:$f)),
+          (cs_p_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSN i64:$c, (i16 GPRD:$t), (i16 GPRD:$f)),
+          (cs_n_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSZ i64:$c, (i16 GPRD:$t), (i16 GPRD:$f)),
+          (cs_z_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSP i64:$c, (i16 GPRD:$t), (i16 GPRD:$f)),
+          (cs_p_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSN i64:$c, (i8 GPRD:$t), (i8 GPRD:$f)),
+          (cs_n_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSZ i64:$c, (i8 GPRD:$t), (i8 GPRD:$f)),
+          (cs_z_rd i64:$c, GPRD:$t, GPRD:$f)>;
+def : Pat<(DADAOCSP i64:$c, (i8 GPRD:$t), (i8 GPRD:$f)),
+          (cs_p_rd i64:$c, GPRD:$t, GPRD:$f)>;
+
+// FP arms (LLVM-079t): the same cs.n/z/p tests but selecting an rf destination
+// from two rf sources (cs.*_rrrr_rf; contract-isa.md §6.5).  The condition is
+// still an rd value, so this covers both an fp compare (foqcmp/ftqcmp) and an
+// integer cmp* feeding an FP-armed select (`d = (n < 0) ? a : b`), the two
+// mixed cases the plain cs.*_rd / DADAOFPSelCC patterns do not match.
+def : Pat<(DADAOCSN i64:$c, f64:$t, f64:$f),
+          (cs_n_rrrr_rf i64:$c, f64:$t, f64:$f)>;
+def : Pat<(DADAOCSZ i64:$c, f64:$t, f64:$f),
+          (cs_z_rrrr_rf i64:$c, f64:$t, f64:$f)>;
+def : Pat<(DADAOCSP i64:$c, f64:$t, f64:$f),
+          (cs_p_rrrr_rf i64:$c, f64:$t, f64:$f)>;
+def : Pat<(DADAOCSN i64:$c, f32:$t, f32:$f),
+          (cs_n_rrrr_rf i64:$c, f32:$t, f32:$f)>;
+def : Pat<(DADAOCSZ i64:$c, f32:$t, f32:$f),
+          (cs_z_rrrr_rf i64:$c, f32:$t, f32:$f)>;
+def : Pat<(DADAOCSP i64:$c, f32:$t, f32:$f),
+          (cs_p_rrrr_rf i64:$c, f32:$t, f32:$f)>;
+
+// Unconditional branch -> jump (iiii, PC-relative 24-bit).
+def : Pat<(br bb:$d), (jump_iiii bb:$d)>;
+
+//===----------------------------------------------------------------------===//
+// Floating-point CodeGen (M6, LLVM-066t; contract-abi.md §4/§6, contract-fp.md)
+//
+// FP values live in the RF bank (GPRF, 64-bit; f32 in the low 32 bits).  The
+// f64 instructions (fo*) operate on octa float, the f32 instructions (ft*) on
+// tetra float.  rf0 (FCSR) is a legal *source* only (an FP-op destination of
+// rf0 is an ILLI form), which is exactly what the fabs patterns exploit.
+//===----------------------------------------------------------------------===//
+
+// --- f64 (fo): arithmetic / sqrt / neg / abs (orrr, orri) ---
+def : Pat<(fadd f64:$a, f64:$b), (foadd_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fsub f64:$a, f64:$b), (fosub_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fmul f64:$a, f64:$b), (fomul_orrr_rf f64:$a, f64:$b)>;
+// Fused multiply-add (LLVM-123t; contract-fp.md §fma = SimRISC-07 §2.5):
+// `fofma dst, a, b, c` is `dst = a * b + c` with ONE rounding, so ISD::FMA --
+// which is exactly "a*b+c rounded once" -- maps 1:1 onto it, four operands and
+// all.  There is no 2-address tie: the destination is a fourth register, so
+// neither an independent fma(a,b,c) nor a loop accumulator needs a copy.
+// `ISD::FMA` is Legal in DADAOISelLowering.cpp; `llvm.fmuladd` reaches the same
+// node because isFMAFasterThanFMulAndFAdd() is true (see there).  Do NOT
+// replace this with fomul+foadd: that double-rounds and is not `llvm.fma`
+// semantics (if a future subtarget switch ever disables FMA, `llvm.fma` must
+// become a libm `fma` call, never this two-step sequence).
+def : Pat<(fma f64:$a, f64:$b, f64:$c), (fofma_rrrr_rf f64:$a, f64:$b, f64:$c)>;
+def : Pat<(fdiv f64:$a, f64:$b), (fodiv_orrr_rf f64:$a, f64:$b)>;
+// rootn(x, 2): the only legal n (contract-fp.md §6).
+def : Pat<(fsqrt f64:$a), (foroot_orri_rf f64:$a, 2)>;
+// fneg(x) = sgnn(x, x) (contract-fp.md §7: sgnn with rfHC == rfHD negates).
+def : Pat<(fneg f64:$a), (fosgnn_orrr_rf f64:$a, f64:$a)>;
+// copysign(a, b) = sgnj(a, b) (contract-fp.md §7: sgnj(rfHC, rfHD) =
+// copySign(rfHC, rfHD)).  fabs(x) = sgnj(x, +0.0): the sign bit of the sign
+// source is all-zero, so the copied sign is positive and the result is the
+// magnitude of x (contract-fp.md §7).  The +0.0 sign source is the all-zero bit
+// pattern moved RD->RF with `rd2rf {rfN}, {rd0}` (rd0 is hardwired zero,
+// contract-isa.md; rd2rf is the RD<->RF block move, contract-fp.md §12) --
+// no constant pool.  Both fabs and copysign therefore select one ISA
+// instruction (LLVM-080t P1) instead of the generic bit-manipulation sequence.
+def : Pat<(fcopysign f64:$a, f64:$b), (fosgnj_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fabs f64:$a),
+          (fosgnj_orrr_rf f64:$a, (rd2rf_orri_rf (i64 rd0), 1))>;
+
+// --- f32 (ft): arithmetic / sqrt / neg / abs ---
+def : Pat<(fadd f32:$a, f32:$b), (ftadd_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fsub f32:$a, f32:$b), (ftsub_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fmul f32:$a, f32:$b), (ftmul_orrr_rf f32:$a, f32:$b)>;
+// f32 fused multiply-add: same 1:1 ISD::FMA mapping as the f64 block above.
+def : Pat<(fma f32:$a, f32:$b, f32:$c), (ftfma_rrrr_rf f32:$a, f32:$b, f32:$c)>;
+def : Pat<(fdiv f32:$a, f32:$b), (ftdiv_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fsqrt f32:$a), (ftroot_orri_rf f32:$a, 2)>;
+def : Pat<(fneg f32:$a), (ftsgnn_orrr_rf f32:$a, f32:$a)>;
+// f32 sign injection (LLVM-126t): same mapping as the f64 block -- copysign is
+// `ftsgnj(a, b)`, fabs is `ftsgnj(x, +0.0)` with the all-zero bit pattern moved
+// RD->RF by rd2rf (rd0 is hardwired zero, so the sign source is +0.0).
+def : Pat<(fcopysign f32:$a, f32:$b), (ftsgnj_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fabs f32:$a),
+          (ftsgnj_orrr_rf f32:$a, (rd2rf_orri_rf (i64 rd0), 1))>;
+
+// --- min/max: minimumNumber/maximumNumber (ftmin/ftmax/fomin/fomax) ---
+// LLVM-124t (M9; contract-fp.md §minmax = SimRISC-07 §2.4).  The ISA's
+// `fomin`/`fomax` (`ftmin`/`ftmax` for f32) ARE IEEE 754-2019
+// minimumNumber/maximumNumber, so the DAG nodes with exactly those semantics
+// map 1:1:
+//   * FMINNUM_IEEE / FMAXNUM_IEEE  -> fomin / fomax (and ftmin / ftmax);
+//   * FMINIMUMNUM / FMAXIMUMNUM    -> the same instructions (2019
+//     minimumNumber/maximumNumber, sNaN raises NV and yields the number).
+// Single NaN (qNaN or sNaN) returns the other operand, double NaN returns the
+// canonical qNaN and -0 < +0 -- all per contract-fp.md §minmax, i.e. the whole
+// `MinMaxMustRespectOrderedZero` burden is already met by the instruction.
+// NOT matched here: FMINNUM/FMAXNUM (lowered Custom -> the *_IEEE nodes
+// below, DADAOISelLowering.cpp) and FMINIMUM/FMAXIMUM (still Expand: LLVM
+// derives them from FMINNUM_IEEE + a SETUO NaN select; there is no
+// NaN-propagating hardware form, contract-fp.md §minmax 负向约束).
+def : Pat<(fminnum_ieee f64:$a, f64:$b), (fomin_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fmaxnum_ieee f64:$a, f64:$b), (fomax_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fminimumnum f64:$a, f64:$b), (fomin_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fmaximumnum f64:$a, f64:$b), (fomax_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(fminnum_ieee f32:$a, f32:$b), (ftmin_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fmaxnum_ieee f32:$a, f32:$b), (ftmax_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fminimumnum f32:$a, f32:$b), (ftmin_orrr_rf f32:$a, f32:$b)>;
+def : Pat<(fmaximumnum f32:$a, f32:$b), (ftmax_orrr_rf f32:$a, f32:$b)>;
+
+// --- Rounding family: roundToIntegral (ftrnd/fornd, orri) ---
+// LLVM-125t (M9; contract-fp.md §roundint = SimRISC-07 §2.3).  One ISA
+// instruction per DAG node; `immu6` is a six-way one-hot *mode selector*, NOT
+// an element count:
+//   0x01 roundToIntegralTiesToEven   (llvm.roundeven / C23 roundeven)
+//   0x02 roundToIntegralTiesToAway   (llvm.round)
+//   0x04 roundToIntegralTowardZero   (llvm.trunc)
+//   0x08 roundToIntegralTowardPositive (llvm.ceil)
+//   0x10 roundToIntegralTowardNegative (llvm.floor)
+//   0x20 roundToIntegralExact        (llvm.rint / llvm.nearbyint)
+// The 5 static modes ignore rf0[33:32]; only 0x20 reads it (RNE/RTZ/RDN/RUP).
+// KNOWN DEVIATION: the ISA has no nearbyint variant that suppresses the
+// inexact flag, so llvm.nearbyint takes 0x20 like llvm.rint and may set NX
+// (rf0[4]) when the result differs from the input.  Values are identical:
+// DADAO FP raises no exceptions/traps, NX is only an FCSR status bit, and in
+// LLVM's non-strict mode both intrinsics are IntrNoMem+IntrSpeculatable, so
+// the flag is not observable (SPEC-161t; contract-fp.md §roundint).
+// These instructions are still `scope: excluded` in contracts/opcodes.yaml, so
+// execution ILLIs until SPEC-162t flips them; selection is implemented here so
+// the flip needs no CodeGen change.
+def : Pat<(froundeven f64:$a), (fornd_orri_rf f64:$a, 1)>;
+def : Pat<(fround f64:$a), (fornd_orri_rf f64:$a, 2)>;
+def : Pat<(ftrunc f64:$a), (fornd_orri_rf f64:$a, 4)>;
+def : Pat<(fceil f64:$a), (fornd_orri_rf f64:$a, 8)>;
+def : Pat<(ffloor f64:$a), (fornd_orri_rf f64:$a, 16)>;
+def : Pat<(frint f64:$a), (fornd_orri_rf f64:$a, 32)>;
+def : Pat<(fnearbyint f64:$a), (fornd_orri_rf f64:$a, 32)>;
+def : Pat<(froundeven f32:$a), (ftrnd_orri_rf f32:$a, 1)>;
+def : Pat<(fround f32:$a), (ftrnd_orri_rf f32:$a, 2)>;
+def : Pat<(ftrunc f32:$a), (ftrnd_orri_rf f32:$a, 4)>;
+def : Pat<(fceil f32:$a), (ftrnd_orri_rf f32:$a, 8)>;
+def : Pat<(ffloor f32:$a), (ftrnd_orri_rf f32:$a, 16)>;
+def : Pat<(frint f32:$a), (ftrnd_orri_rf f32:$a, 32)>;
+def : Pat<(fnearbyint f32:$a), (ftrnd_orri_rf f32:$a, 32)>;
+
+// --- FP compare: DADAOISD::FCMP -> foqcmp / ftqcmp (orrr; result in GPRD) ---
+def : Pat<(DADAOFCmp f64:$l, f64:$r), (foqcmp_orrr_rf f64:$l, f64:$r)>;
+def : Pat<(DADAOFCmp f32:$l, f32:$r), (ftqcmp_orrr_rf f32:$l, f32:$r)>;
+
+// --- FP classification: is.fpclass -> focls / ftcls (orri, result in GPRD) ---
+// LLVM-126t (contract-fp.md §9).  The instruction writes a 10-bit one-hot class
+// mask with exactly LLVM's FPClassTest bit order (SPEC-156t), so the lowering
+// only has to AND the mask (or compare the word for a single-class test).
+def : Pat<(DADAOFClass f64:$a), (focls_orri_rf f64:$a, 1)>;
+def : Pat<(DADAOFClass f32:$a), (ftcls_orri_rf f32:$a, 1)>;
+
+// --- FP scaleB: ldexp -> fosclb / ftsclb (orrr) ---
+// LLVM-126t (contract-fp.md §5): the exponent is an integer-valued FP operand,
+// so the lowering converts the i32 exponent with io2fo/it2ft first.
+def : Pat<(DADAOScalb f64:$x, f64:$n), (fosclb_orrr_rf f64:$x, f64:$n)>;
+def : Pat<(DADAOScalb f32:$x, f32:$n), (ftsclb_orrr_rf f32:$x, f32:$n)>;
+
+// --- IEEE remainder: __builtin_dadao_remainder -> forem / ftrem (orrr) ---
+// LLVM-126t / user ruling 2026-10-23.  `forem`/`ftrem` are IEEE 754 remainder
+// (quotient to nearest, ties to even), which is NOT `frem` (libm fmod: the
+// remainder takes the dividend's sign), so the intrinsic is the only way to
+// reach the instruction; ISD::FREM stays Expand -> fmod libcall.
+def : Pat<(int_dadao_remainder_f64 f64:$a, f64:$b),
+          (forem_orrr_rf f64:$a, f64:$b)>;
+def : Pat<(int_dadao_remainder_f32 f32:$a, f32:$b),
+          (ftrem_orrr_rf f32:$a, f32:$b)>;
+
+// --- FP select_cc -> DADAO cs.* conditional assign (contract-isa.md §6.5) ---
+// A `select` on an FP condition *whose result is FP* reaches ISel as SELECT_CC
+// (no FP setcc-as-value in this backend) and is matched here; the FCMP result
+// rc is -1/0/1 for ordered results and a positive NaN for unordered, so every
+// C predicate is one cs test (cs.n/cs.z/cs.p) with possible operand and/or
+// true/false swapping; `>`/`>=` swap the compare operands (rc' = cmp(b, a)).
+// An FP condition selecting *integer* arms (i64 result) is lowered uniformly
+// by DADAOTargetLowering::LowerCmpSelect (LLVM-069t), so it has no pattern
+// here.
+multiclass DADAOFPSelCC<Instruction Cmp, ValueType CmpVT, ValueType ValVT,
+                        Instruction CsN, Instruction CsZ, Instruction CsP> {
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOLT),
+            (CsN (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOLE),
+            (CsP (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOGT),
+            (CsN (Cmp CmpVT:$b, CmpVT:$a), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOGE),
+            (CsP (Cmp CmpVT:$b, CmpVT:$a), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETOEQ),
+            (CsZ (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUNE),
+            (CsZ (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUGT),
+            (CsP (Cmp CmpVT:$a, CmpVT:$b), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUGE),
+            (CsN (Cmp CmpVT:$a, CmpVT:$b), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETULT),
+            (CsP (Cmp CmpVT:$b, CmpVT:$a), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETULE),
+            (CsN (Cmp CmpVT:$b, CmpVT:$a), ValVT:$f, ValVT:$t)>;
+  // LLVM-084t (ISS-193 (a)): unordered-family predicates.  The FP compare result
+  // is -1/0/1 when ordered and a positive qNaN whose integer value exceeds them
+  // when unordered (contract-fp.md §8), so `cmp.si rd, rc, 1` gives the
+  // unordered flag (< 0/== 0 ordered, > 0 unordered).  SETUO/SETO are one cs.p
+  // on it; SETONE/SETUEQ combine it with the not-equal / equal cs test through
+  // and.o / or.o (contract-isa.md §6.1/§6.5).  These mirror the custom lowering
+  // in DADAOISelLowering (LowerCmpSelect) as the post-legalisation fallback.
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUO),
+            (CsP (cmp_si_rd (Cmp CmpVT:$a, CmpVT:$b), 1), ValVT:$t, ValVT:$f)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETO),
+            (CsP (cmp_si_rd (Cmp CmpVT:$a, CmpVT:$b), 1), ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETONE),
+            (CsZ (and_o (cs_p_rd (cmp_si_rd (Cmp CmpVT:$a, CmpVT:$b), 1), (i64 0), (i64 1)),
+                       (cs_z_rd (Cmp CmpVT:$a, CmpVT:$b), (i64 0), (i64 1))),
+                 ValVT:$f, ValVT:$t)>;
+  def : Pat<(selectcc CmpVT:$a, CmpVT:$b, ValVT:$t, ValVT:$f, SETUEQ),
+            (CsZ (or_o (cs_p_rd (cmp_si_rd (Cmp CmpVT:$a, CmpVT:$b), 1), (i64 1), (i64 0)),
+                      (cs_z_rd (Cmp CmpVT:$a, CmpVT:$b), (i64 1), (i64 0))),
+                 ValVT:$f, ValVT:$t)>;
+}
+
+defm FPSelCC_f64_rf
+    : DADAOFPSelCC<foqcmp_orrr_rf, f64, f64, cs_n_rrrr_rf, cs_z_rrrr_rf,
+                   cs_p_rrrr_rf>;
+defm FPSelCC_f32_rf
+    : DADAOFPSelCC<ftqcmp_orrr_rf, f32, f32, cs_n_rrrr_rf, cs_z_rrrr_rf,
+                   cs_p_rrrr_rf>;
+
+// --- FP loads/stores (RF bank; ld.t/st.t 4B, ld.o/st.o 8B) ---
+def : Pat<(f64 (load (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (ld_o_rrii_rf GPRB:$base, simm12imm:$off)>;
+def : Pat<(store f64:$val, (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (st_o_rrii_rf f64:$val, GPRB:$base, simm12imm:$off)>;
+def : Pat<(f32 (load (DADAOAddr GPRB:$base, simm12imm:$off))),
+          (ld_t_rrii_rf GPRB:$base, simm12imm:$off)>;
+def : Pat<(store f32:$val, (DADAOAddr GPRB:$base, simm12imm:$off)),
+          (st_t_rrii_rf f32:$val, GPRB:$base, simm12imm:$off)>;
+
+// --- FP format conversions (orri; immu6 = 1 register) ---
+// fpext f32->f64 = ft2fo ; fptrunc f64->f32 = fo2ft (contract-fp.md §2).
+def : Pat<(f64 (fpextend f32:$a)), (ft2fo_orri_rf f32:$a, 1)>;
+def : Pat<(f32 (fpround f64:$a)), (fo2ft_orri_rf f64:$a, 1)>;
+
+// --- FP <-> integer conversions (orri; the int side is always i64) ---
+// fp_to_sint / fp_to_uint -> i octa (fo2io/ft2io for octa floats; signed i,
+// unsigned u).  A narrower (i32/i16/i8) integer result is promoted to i64 by
+// the type legalizer and truncated afterwards.
+def : Pat<(i64 (fp_to_sint f64:$a)), (fo2io_orri_rf f64:$a, 1)>;
+def : Pat<(i64 (fp_to_sint f32:$a)), (ft2io_orri_rf f32:$a, 1)>;
+def : Pat<(i64 (fp_to_uint f64:$a)), (fo2uo_orri_rf f64:$a, 1)>;
+def : Pat<(i64 (fp_to_uint f32:$a)), (ft2uo_orri_rf f32:$a, 1)>;
+// sint_to_fp / uint_to_fp <- i octa (io2fo/uo2fo).  A narrower integer source
+// is promoted to i64 before the conversion, so only the i64 patterns are
+// reachable.
+def : Pat<(f64 (sint_to_fp (i64 GPRD:$a))), (io2fo_orri_rf (i64 GPRD:$a), 1)>;
+def : Pat<(f32 (sint_to_fp (i64 GPRD:$a))), (io2ft_orri_rf (i64 GPRD:$a), 1)>;
+def : Pat<(f64 (uint_to_fp (i64 GPRD:$a))), (uo2fo_orri_rf (i64 GPRD:$a), 1)>;
+def : Pat<(f32 (uint_to_fp (i64 GPRD:$a))), (uo2ft_orri_rf (i64 GPRD:$a), 1)>;
+
+// --- FP <-> integer bitcast (LLVM-079t) ---
+// `rd2rf` / `rf2rd` are the RD<->RF block moves (contract-fp.md §12): they copy
+// 64 bits unchanged, which is exactly a bitcast (no numeric conversion).  This
+// is what `double`<->`uint64_t` type punning lowers to -- and also the middle
+// step of the *generic* fabs/copysign/... expansions (bitcast to i64, mask,
+// bitcast back).
+def : Pat<(f64 (bitconvert i64:$a)), (rd2rf_orri_rf i64:$a, 1)>;
+def : Pat<(i64 (bitconvert f64:$a)), (rf2rd_orri_rf f64:$a, 1)>;
+
+//===----------------------------------------------------------------------===//
+// Atomic compare-and-swap pseudos (LLVM-121t; ADR-0034 D3-D6)
+//
+// There is no AMO in the ISA (ISS-294): every atomic read-modify-write and
+// every cmpxchg is a `lr`/`sc` retry loop.  The loop is built by the target's
+// custom inserter (DADAOTargetLowering::EmitInstrWithCustomInserter, the PPC
+// `emitAtomicCmpSwapHardware` shape) because it needs new basic blocks, and
+// FinalizeISel runs that hook before register allocation:
+//
+//   thisMBB:
+//     <prologue>
+//     fallthrough -> loop
+//   loop:                                  (loop1MBB)
+//     lr.<w>.an  dst, [ptr]
+//     br.ne {dst, cmp}?, [rb0, done]       ; value changed -> CAS failed
+//     sc.<w>.ar  ok, new, [ptr]
+//     br.nz {ok}?, [rb0, loop]             ; reservation lost -> retry
+//   done:                                  (exitMBB = the rest of thisMBB)
+//
+// The success flag is not part of the pseudo: it is exactly `dst == cmp`, so
+// the lowering (DADAOISelLowering::LowerOperation, ATOMIC_CMP_SWAP_WITH_SUCCESS)
+// computes it with a SETCC after the node, keeping one definition per virtual
+// register in the expansion.
+//
+// One pseudo per access width: the ISA has native 1/2/4/8-byte lr/sc and the
+// address only has to be aligned to that width (ADR-0034 D6 as revised
+// 2026-10-21), so a byte/halfword CAS never has to touch the neighbouring
+// bytes of the containing word.
+//===----------------------------------------------------------------------===//
+
+class DADAOAtomicCmpSwapPseudo<dag ins>
+    : DADAOPseudo<(outs GPRD:$dst), ins, []> {
+  let usesCustomInserter = 1;
+  let hasSideEffects = 1;
+  let mayLoad = 1;
+  let mayStore = 1;
