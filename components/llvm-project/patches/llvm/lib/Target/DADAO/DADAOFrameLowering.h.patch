+//===-- DADAOFrameLowering.h - Define frame lowering for DADAO -*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DADAO frame lowering for M3 (LLVM-038t, ADR-0018 C7/C8):
+//   - SP-only by default (frame register rb1); a frame pointer (rb2) is built
+//     only when hasFPImpl holds (var-sized objects / frame address taken /
+//     stack realignment / -fno-omit-frame-pointer).
+//   - prologue/epilogue adjust SP with `add.si` (in-place, 18-bit immediate)
+//     and save/restore the old FP with `st.o`/`ld.o`.
+//   - callee-saved register sets (CSR) are LLVM-039t; this task only reserves
+//     the frame structure for them.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_DADAO_DADAOFRAMELOWERING_H
+#define LLVM_LIB_TARGET_DADAO_DADAOFRAMELOWERING_H
+
+#include "llvm/CodeGen/TargetFrameLowering.h"
+
+namespace llvm {
+
+class DADAOFrameLowering : public TargetFrameLowering {
+public:
+  explicit DADAOFrameLowering()
+      : TargetFrameLowering(StackGrowsDown,
+                            /*StackAlignment=*/Align(8),
+                            /*LocalAreaOffset=*/0) {}
+
+  void emitPrologue(MachineFunction &MF, MachineBasicBlock &MBB) const override;
+
+  void emitEpilogue(MachineFunction &MF, MachineBasicBlock &MBB) const override;
+
+  /// hasFPImpl (ADR-0018 C7 D1): standard conditional form.  Default SP-only;
+  /// build FP = rb2 for variable-sized objects, taken frame address, stack
+  /// realignment or when frame pointer elimination is disabled.
+  bool hasFPImpl(const MachineFunction &MF) const override;
+
+  /// getFrameIndexReference (ADR-0018 C7/C8).  With FP, objects are indexed
+  /// directly from the entry SP (FP points at the entry SP); SP-only adds the
+  /// frame size back because SP has been decremented by it.
+  StackOffset getFrameIndexReference(const MachineFunction &MF, int FI,
+                                     Register &FrameReg) const override;
+
+  /// Finalize the total frame size (8-byte aligned; contract-abi.md §2.2).
+  void determineFrameLayout(MachineFunction &MF) const;
+
+  /// Reserve the fixed slot used to save the old frame pointer (only when FP
+  /// is built).  Runs before PEI assigns object offsets.
+  void processFunctionBeforeFrameFinalized(MachineFunction &MF,
+                                           RegScavenger *RS = nullptr) const override;
+
+private:
+  /// Emit `add.si reg, <amount>` (splitting into chunks when the amount does
+  /// not fit the 18-bit immediate field).
+  void emitAddImm(MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI,
+                  const DebugLoc &DL, Register Reg, int64_t Amount,
+                  bool IsEpilogue) const;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_DADAOFRAMELOWERING_H
