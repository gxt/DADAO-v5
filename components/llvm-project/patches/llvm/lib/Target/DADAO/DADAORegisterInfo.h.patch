+#ifndef LLVM_LIB_TARGET_DADAO_DADAOREGISTERINFO_H
+#define LLVM_LIB_TARGET_DADAO_DADAOREGISTERINFO_H
+
+#include "llvm/CodeGen/TargetRegisterInfo.h"
+
+#define GET_REGINFO_HEADER
+#include "DADAOGenRegisterInfo.inc"
+
+namespace llvm {
+
+struct DADAOTargetMachine;
+
+class DADAORegisterInfo : public DADAOGenRegisterInfo {
+public:
+  DADAORegisterInfo();
+
+  const uint16_t *
+  getCalleeSavedRegs(const MachineFunction *MF) const override;
+
+  BitVector getReservedRegs(const MachineFunction &MF) const override;
+
+  bool eliminateFrameIndex(MachineBasicBlock::iterator MI, int SPAdj,
+                           unsigned FIOperandNum,
+                           RegScavenger *RS) const override;
+
+  Register getFrameRegister(const MachineFunction &MF) const override;
+
+  /// The frame index / spill code uses RegScavenger to materialize large
+  /// (out-of-simm12) frame offsets in a scratch register, so the register
+  /// scavenger must be enabled (LLVM-038t).
+  bool requiresRegisterScavenging(const MachineFunction &MF) const override {
+    return true;
+  }
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_DADAOREGISTERINFO_H
