+//===----------------------------------------------------------------------===//
+//
+// This file contains code to lower DADAO MachineInstrs to their corresponding
+// MCInst records (LLVM-040t).  The operand kinds CodeGen produces for the M3
+// scalar subset are registers, immediates, basic-block targets (branches) and
+// global/external symbols (direct calls); the symbol operands become plain
+// MCSymbolRefExpr expressions, which the DADAO MCCodeEmitter turns into
+// PC-relative fixups (DADAO_FK_PCRel_12/18/24).
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOMCInstLower.h"
+
+#include "DADAO.h"
+#include "DADAOAsmPrinter.h"
+#include "MCTargetDesc/DADAOMCAsmInfo.h"
+
+#include "llvm/CodeGen/AsmPrinter.h"
+#include "llvm/CodeGen/MachineBasicBlock.h"
+#include "llvm/CodeGen/MachineInstr.h"
+#include "llvm/CodeGen/MachineOperand.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace llvm;
+
+DADAOMCInstLower::DADAOMCInstLower(MCContext &Ctx, const DADAOAsmPrinter &AP)
+    : Ctx(Ctx), Printer(AP) {}
+
+MCSymbol *
+DADAOMCInstLower::GetSymbolFromOperand(const MachineOperand &MO) const {
+  assert((MO.isGlobal() || MO.isSymbol() || MO.isMBB()) &&
+         "Not a symbol reference");
+
+  if (MO.isGlobal()) {
+    // Plain symbol reference (no target flag / variant kind in M3): a direct
+    // call target only.  getSymbolPreferLocal keeps the plain name for a
+    // non-PIE static module (it is what the definition is emitted under).
+    // Note: an MO_GOT_ADDR reference (PIC, LLVM-094t) is resolved in
+    // LowerOperand instead, because the slot's data field already carries the
+    // operand offset.
+    return Printer.getSymbolPreferLocal(*MO.getGlobal());
+  }
+  if (MO.isMBB())
+    return MO.getMBB()->getSymbol();
+  // External symbol (a declared-but-not-defined callee).
+  return Printer.GetExternalSymbolSymbol(MO.getSymbolName());
+}
+
+MCOperand
+DADAOMCInstLower::LowerSymbolOperand(const MachineOperand &MO,
+                                     MCSymbol *Sym) const {
+  const MCExpr *Expr = MCSymbolRefExpr::create(Sym, Ctx);
+
+  if (!MO.isMBB() && MO.getOffset())
+    Expr = MCBinaryExpr::createAdd(
+        Expr, MCConstantExpr::create(MO.getOffset(), Ctx), Ctx);
+
+  return MCOperand::createExpr(Expr);
+}
+
+std::optional<MCOperand>
+DADAOMCInstLower::LowerOperand(const MachineOperand &MO) const {
+  switch (MO.getType()) {
+  default:
+    report_fatal_error("DADAO: unsupported machine operand in the AsmPrinter");
+  case MachineOperand::MO_Register:
+    // Implicit uses/defs (the argument/return registers of a call, the
+    // return-value register on RET) are liveness information only and have no
+    // place in the instruction encoding.
+    if (MO.isImplicit())
+      return std::nullopt;
+    return MCOperand::createReg(MO.getReg());
+  case MachineOperand::MO_RegisterMask:
+    // Call-clobber mask (getCallPreservedMask); not an MCInst operand.
+    return std::nullopt;
+  case MachineOperand::MO_Immediate:
+    return MCOperand::createImm(MO.getImm());
+  case MachineOperand::MO_MachineBasicBlock:
+  case MachineOperand::MO_GlobalAddress:
+    // PIC GOT reference (LLVM-094t; reached through the `aip.si`/`ld.o` pair
+    // since ADR-0029 D4): the operand denotes the symbol's GOT slot and the
+    // slot's data field already carries `sym + offset`, so the instruction
+    // operand must be the bare slot label (adding the offset here would load
+    // from inside the slot).  It is the *high* half's target; the emitter picks
+    // R_DADAO_PCREL_HI from the `aip.si` opcode plus a bare symbol.
+    if (MO.getTargetFlags() & DADAO::MO_GOT_ADDR)
+      return MCOperand::createExpr(MCSymbolRefExpr::create(
+          Printer.getGOTSlotSymbol(MO.getGlobal(), MO.getOffset()), Ctx));
+    return LowerSymbolOperand(MO, GetSymbolFromOperand(MO));
+  case MachineOperand::MO_ExternalSymbol:
+    return LowerSymbolOperand(MO, GetSymbolFromOperand(MO));
+  case MachineOperand::MO_BlockAddress:
+    // Address of a basic block (`&&label`, LLVM-102t): the BLOCK_ADDR
+    // materialization carries one MO_BlockAddress per slice.  AsmPrinter has
+    // already defined the label (GetBlockAddressSymbol) in front of the block;
+    // the operand offset travels in the expression (r_addend) like any other
+    // symbol.
+    return LowerSymbolOperand(MO,
+                              Printer.GetBlockAddressSymbol(MO.getBlockAddress()));
+  case MachineOperand::MO_JumpTableIndex:
+    // Jump-table label (LLVM-072t, ISS-177/G3): the local symbol emitted in
+    // front of the table by AsmPrinter::emitJumpTableInfo.  Used by the
+    // JT_ADDR materialization (set.zw/or.w -> R_DADAO_ABS48) and, under PIC
+    // (LLVM-094t), by the GOT slot holding the table base (the instruction then
+    // carries the *slot* label and the table label goes into `.got`).
+    if (MO.getTargetFlags() & DADAO::MO_GOT_ADDR)
+      return MCOperand::createExpr(MCSymbolRefExpr::create(
+          Printer.getGOTSlotSymbolForJumpTable(MO.getIndex()), Ctx));
+    return MCOperand::createExpr(
+        MCSymbolRefExpr::create(Printer.GetJTISymbol(MO.getIndex()), Ctx));
+  case MachineOperand::MO_MCSymbol:
+    // Low half of a PC-relative hi/lo pair (ADR-0029 D2/D4): the operand names
+    // the *pairing site* -- the temporary label DADAOInstrInfo::
+    // expandPostRAPseudo emits in front of the paired `aip.si` -- not a data
+    // target, so it is wrapped in the `%pcrel_lo(...)` specifier (RISC-V's
+    // `%pcrel_lo(label)` form).  The emitter turns that into R_DADAO_PCREL_LO,
+    // and the ELF writer folds the local label into section symbol + addend =
+    // site address, which is the pairing information the linker needs
+    // (contract-elf.md §3.1/§3.2).  A bare MO_MCSymbol use (jump-table labels)
+    // keeps the plain expression as before.
+    if (MO.getTargetFlags() & DADAO::MO_PCREL_LO)
+      return MCOperand::createExpr(MCSpecifierExpr::create(
+          MO.getMCSymbol(), DADAO::S_PCREL_LO, Ctx));
+    return LowerSymbolOperand(MO, MO.getMCSymbol());
+  }
+}
+
+void DADAOMCInstLower::Lower(const MachineInstr *MI, MCInst &OutMI) const {
+  OutMI.setOpcode(MI->getOpcode());
+
+  for (const MachineOperand &MO : MI->operands()) {
+    std::optional<MCOperand> MCOp = LowerOperand(MO);
+    if (MCOp)
+      OutMI.addOperand(*MCOp);
+  }
+}
