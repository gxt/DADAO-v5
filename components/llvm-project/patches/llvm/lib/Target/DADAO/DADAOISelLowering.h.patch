+//===----------------------------------------------------------------------===//
+//
+// This file defines the interfaces that DADAO uses to lower LLVM code into a
+// selection DAG.  M3: i64 register class registration, minimal
+// LowerReturn/LowerFormalArguments (LLVM-033t), and integer compare/branch
+// lowering to cmp* + br.* (LLVM-037t; C17/C14).  The SelectionDAG framework is
+// the M3 choice (C11, ADR-0018).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_DADAO_DADAOISELLOWERING_H
+#define LLVM_LIB_TARGET_DADAO_DADAOISELLOWERING_H
+
+#include "llvm/CodeGen/TargetLowering.h"
+
+namespace llvm {
+
+class DADAOSubtarget;
+class DADAOTargetMachine;
+
+namespace DADAOISD {
+
+enum NodeType : unsigned {
+  FIRST_NUMBER = ISD::BUILTIN_OP_END,
+
+  /// Return terminator: (chain, [return-value registers...], [glue]).
+  /// Produced by LowerReturn, matched by the RET_PSEUDO instruction
+  /// (see DADAOCodeGen.td).
+  RET_GLUE,
+
+  /// Direct call: (chain, callee, [regmask], [argument registers...], [glue]).
+  /// Produced by LowerCall, selected to call_iiii (LLVM-039t).
+  CALL,
+
+  /// Tail call (real tail-jump): (chain, callee, [regmask],
+  /// [argument registers...], [glue]).  Produced by LowerCall when a tail call
+  /// is eligible (LLVM-074t: all arguments in registers, non-variadic);
+  /// selected to TAILJMP/TAILJMPIND.  The pseudo is isReturn, so PEI emits the
+  /// standard epilogue before it, and the jump reuses the caller's RegRAS
+  /// return address (contract-isa.md §8.3/§8.4: a plain `jump` does not push
+  /// a return address, so the callee's `ret` returns to our caller).
+  TAIL,
+
+  /// Signed / unsigned compare: (lhs, rhs) -> i64 in {-1, 0, 1}.
+  /// No condition flags (C17); the result is an ordinary data register value.
+  CMP,
+  CMPU,
+
+  /// Floating-point compare: (lhs, rhs) -> i64.  The DADAO FP compare writes
+  /// -1 / 0 / 1 for ordered results (lhs <, ==, > rhs) and a positive NaN value
+  /// for unordered; the result feeds the same br.* machinery as CMP (M6,
+  /// LLVM-066t; contract-fp.md §8).
+  FCMP,
+
+  /// Branch on a compare result (or any value) against zero:
+  ///   (chain, val, dest).  val < 0 / <= 0 / > 0 / >= 0 / == 0 / != 0.
+  BRN,
+  BRNP,
+  BRP,
+  BRNN,
+  BRZ,
+  BRNZ,
+
+  /// Two-register ==/!= branch: (chain, lhs, rhs, dest).  C17: used directly
+  /// for integer ==/!= so no compare instruction is needed.
+  BREQ,
+  BRNE,
+
+  /// Conditional assignment (contract-isa.md §6.5): (cond, true, false) -> i64,
+  /// selected to cs.n / cs.z / cs.p.  CS_N takes the true arm when cond < 0,
+  /// CS_Z when cond == 0 and CS_P when cond > 0.  Produced by LowerSETCC (to
+  /// turn the cmp* result {-1,0,1} into the C boolean 0/1), LowerSELECT_CC and
+  /// LowerSELECT (LLVM-069t).  A compare whose result feeds an FP select can
+  /// drive the same nodes (the FP setcc stage of LowerCmpSelect), which is why
+  /// the FP side no longer carries its own selectcc patterns for i64 results.
+  CS_N,
+  CS_Z,
+  CS_P,
+
+  /// Dense switch dispatch (LLVM-072t, ISS-177/G3).  Lowered from ISD::BR_JT:
+  /// (chain, index, TargetJumpTable).  Selected by DADAOISelDAGToDAG to load an
+  /// entry from the read-only jump table and jump through it (jump_rrii); the
+  /// table itself is emitted by the generic AsmPrinter as one 8-byte absolute
+  /// address per case (EK_BlockAddress -> R_DADAO_ABS48).
+  BR_JT,
+
+  /// Indirect branch (LLVM-102t; `indirectbr`, i.e. C `goto *p`).  Lowered
+  /// from ISD::BRIND: (chain, target) where target is the i64 address in the
+  /// GPRB bank (a GPRB virtual register created by LowerBRIND).  Selected by
+  /// DADAOISelDAGToDAG to `jump rbtarget, rd0, 0` (contract-isa.md §8.3:
+  /// Addr = rbha + rdhb + (imms12 << 2), rd0 supplies the zero offset).
+  BRIND,
+
+  /// Local-exec TLS address (LLVM-100t): (TargetGlobalAddress) -> i64 in GPRB.
+  /// The address of a `__thread` object is TP + TPOFF, with TP = `rb3`
+  /// (contract-abi.md §1.3) and TPOFF the symbol's TLS-block offset
+  /// (contract-dynlink.md §4.3/§7: TLS_ABOVE_TP, GAP_ABOVE_TP 0, TP_OFFSET 0
+  /// => TPOFF(sym) == DTPOFF(sym) == the linker's value for the STT_TLS
+  /// symbol).  Selected by DADAOISelDAGToDAG to TLS_OFFSET (the ABS48
+  /// materialization of TPOFF, in GPRD) plus `add.o rb, rb3, rd`.
+  TLS_ADDR,
+
+  /// Initial-exec TLS address (LLVM-117t): (TargetGlobalAddress carrying
+  /// MO_GOT_ADDR|MO_TLS_TPREL) -> i64 in GPRB.  The offset from TP is not a
+  /// link-time constant in a shared object, so it is loaded from a `.got` slot
+  /// whose data field is fixed up by the loader (R_DADAO_TLS_TPREL, type 12)
+  /// and then added to `rb3`.  Selected to PCREL_LOAD + `rb2rd` + `add.o`.
+  TLS_IE_ADDR,
+
+  /// Global-dynamic TLS index address (LLVM-117t): (TargetGlobalAddress
+  /// carrying MO_GOT_ADDR|MO_TLS_GD) -> i64 in GPRB, the address of the
+  /// `tls_index` pair `{tls_id, DTPOFF}` passed to `__tls_get_addr`
+  /// (contract-dynlink.md §4.3: types 10 and 11).  Selected to PCREL_LOAD.
+  TLS_GD_ADDR,
+
+  /// Memory barrier (LLVM-121t): (chain, TargetConstant immu18) -> chain.
+  /// Produced by LowerATOMIC_FENCE, selected to `fence`.  The immediate is the
+  /// ADR-0034 D2 `fm`/`pred`/`succ` bit pattern, so the ordering -> bits
+  /// mapping lives in the lowering and is asserted by the lit tests.
+  FENCE,
+
+  /// Atomic compare-and-swap retry loop (LLVM-121t): (chain, ptr, cmp, new,
+  /// TargetConstant width) -> (old value, chain).  `width` selects the lr/sc
+  /// width class (0 = b, 1 = w, 2 = t, 3 = o); the selector turns the node into
+  /// the ATOMIC_CMP_SWAP_PSEUDO_{B,W,T,O} pseudo and the custom inserter emits
+  /// the lr/sc loop (DADAOCodeGen.td).
+  ATOMIC_CMP_SWAP,
+
+  /// GF(2) carry-less multiply (ADR-0035; LLVM-122t): (a, b) -> (low 64, high
+  /// 64).  Produced by ReplaceNodeResults when `llvm.dadao.clmul.wide` arrives
+  /// with its i128 result (i128 is not legal, so the type legalizer splits it);
+  /// selected by DADAOISelDAGToDAG to CLMUL_LOHI_PSEUDO -> one `clmul.o`.
+  CLMUL,
+};
+
+} // namespace DADAOISD
+
+class DADAOTargetLowering : public TargetLowering {
+public:
+  explicit DADAOTargetLowering(const DADAOTargetMachine &TM,
+                               const DADAOSubtarget &STI);
+
+  const char *getTargetNodeName(unsigned Opcode) const override;
+
+  /// SetCC result type (LLVM-105t).  DADAO has no vector registers, so vector
+  /// values are always split by the type legalizer; its widening/scalarizing
+  /// paths nevertheless ask the target for the SETCC result type of a vector
+  /// operand.  The generic implementation asserts ("No default SetCC type for
+  /// vectors!") and every scalar-only target overrides it, so do the same:
+  /// lanes keep their integer element type (SETCC yields 0/-1 per lane) and
+  /// the vector is then split into scalar i64 compares.  For scalars the
+  /// result is the pointer-sized i64 the custom SETCC lowering produces.
+  EVT getSetCCResultType(const DataLayout &DL, LLVMContext &Context,
+                         EVT VT) const override;
+
+  /// Jump-table entry encoding (LLVM-094t).  The generic implementation switches
+  /// to `EK_LabelDifference32` (32-bit label differences) as soon as the module
+  /// is position independent, but the DADAO relocation set has no 32-bit data
+  /// relocation and no label-difference type (ADR-0019 D2/D8: ABS48 is the only
+  /// data form; offset classes are instruction fields) -- a 4-byte relocatable
+  /// field is rejected by the assembler.  Keep the absolute 8-byte entry
+  /// (`EK_BlockAddress` -> R_DADAO_ABS48 data field) for static and PIC alike:
+  /// the entry is data, so an absolute address there is allowed even under PIC
+  /// (contract-dynlink.md §4.3), and only the *table base* moves behind a GOT
+  /// slot (ADR-0026 D5).  A shared object fixes those entries up at load time.
+  unsigned getJumpTableEncoding() const override;
+
+  /// Inline-assembly register constraints (ISS-193(e), LLVM-086t).  The DADAO
+  /// register banks are not interchangeable, so a lone `"r"` constrains to a
+  /// register class; map it to the data bank (GPRD), the canonical i64 class
+  /// registered with `addRegisterClass` in the constructor.  Every other
+  /// constraint falls back to the generic TargetLowering implementation.
+  std::pair<unsigned, const TargetRegisterClass *>
+  getRegForInlineAsmConstraint(const TargetRegisterInfo *TRI,
+                               StringRef Constraint, MVT VT) const override;
+
+  /// Inline-assembly memory constraints (ISS-197 / LLVM-119t).  `"V"` is the
+  /// one constraint letter the generic implementation classifies as memory
+  /// (C_Memory) without a matching `InlineAsm::ConstraintCode` — it would reach
+  /// SelectionDAGBuilder and trip its "Failed to convert memory constraint
+  /// code to constraint id" assertion (a crash, not a diagnostic).  This target
+  /// does not support non-offsettable memory operands, so report it as unknown
+  /// and let the ordinary "unknown asm constraint" diagnostic name it.
+  TargetLowering::ConstraintType
+  getConstraintType(StringRef Constraint) const override;
+
+  /// M6 (contract-abi.md §6.1): a function's return can be lowered only if each
+  /// return bank (rd/rb) carries at most K = 8 values; otherwise the return is
+  /// demoted to a hidden sret pointer by SelectionDAGBuilder.
+  bool CanLowerReturn(CallingConv::ID CallConv, MachineFunction &MF,
+                      bool IsVarArg,
+                      const SmallVectorImpl<ISD::OutputArg> &Outs,
+                      LLVMContext &Context, const Type *RetTy) const override;
+
+  /// ADR-0031 D4/D6 (caller side): an aggregate argument is one allocation
+  /// group.  HFA/HPA leaf runs and the 8-byte blocks of a general aggregate
+  /// must be assigned all-or-nothing; a 16-byte general aggregate additionally
+  /// needs an even-aligned register pair.  Returning true makes
+  /// SelectionDAGBuilder tag the pieces with InConsecutiveRegs / ...Last so
+  /// DADAOTargetLowering can re-assign the whole group after the generic CC.
+  bool functionArgumentNeedsConsecutiveRegisters(
+      Type *Ty, CallingConv::ID CallConv, bool isVarArg,
+      const DataLayout &DL) const override;
+
+  SDValue
+  LowerFormalArguments(SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+                       const SmallVectorImpl<ISD::InputArg> &Ins,
+                       const SDLoc &DL, SelectionDAG &DAG,
+                       SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerReturn(SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+                      const SmallVectorImpl<ISD::OutputArg> &Outs,
+                      const SmallVectorImpl<SDValue> &OutVals, const SDLoc &DL,
+                      SelectionDAG &DAG) const override;
+
+  /// Direct call lowering (LLVM-039t): assign argument locations via CC_DADAO,
+  /// emit CALLSEQ_START/END, the DADAOISD::CALL node (with getCallPreservedMask
+  /// as a RegisterMask operand) and LowerCallResult.
+  SDValue LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                    SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerOperation(SDValue Op, SelectionDAG &DAG) const override;
+
+  /// Custom result legalization (LLVM-122t / LLVM-128t).  Two uses:
+  ///   - `llvm.dadao.clmul.wide`: its result is i128, which is not a legal
+  ///     DADAO type, and the generic type legalizer has no expansion for an
+  ///     INTRINSIC_WO_CHAIN node.  Replaced by a BUILD_PAIR over
+  ///     DADAOISD::CLMUL (low, high), so the pair reaches ISel as two i64
+  ///     values and the whole operation stays a single `clmul.o`.
+  ///   - `bswap i32`: i32 is not a legal type either; emitting the native
+  ///     `rev.t` here keeps a 32-bit byte swap at one instruction instead of
+  ///     the promoted `srl(bswap i64, 32)` pair.
+  void ReplaceNodeResults(SDNode *N, SmallVectorImpl<SDValue> &Results,
+                          SelectionDAG &DAG) const override;
+
+  /// Bit scans define the zero input in hardware (LLVM-128t): `ctlz`/`cttz`
+  /// with `hd = 63` return 64 for 0 (contract-isa.md §6.4.4), so speculating
+  /// one is always cheap.  Without this override CodeGenPrepare's
+  /// `despeculateCountZeros` wraps every *defined* `ctlz`/`cttz` in a
+  /// `x == 0 ? 64 : ctlz_zero_poison(x)` check -- three extra instructions
+  /// for a case the ISA already answers.
+  bool isCheapToSpeculateCttz(Type *) const override { return true; }
+  bool isCheapToSpeculateCtlz(Type *) const override { return true; }
+
+  /// `llvm.fmuladd` fusion (LLVM-123t).  SelectionDAGBuilder turns the
+  /// `llvm.fmuladd` intrinsic (and `fmuladd`-contracted `a*b+c`) into a single
+  /// ISD::FMA exactly when this hook says fusing is profitable/equally cheap.
+  /// The ISA's `fofma`/`ftfma` ARE one instruction (four operands, single
+  /// rounding), so fusing is strictly better than fmul+fadd on both counts --
+  /// and `llvm.fmuladd` explicitly permits it.  `llvm.fma` does not depend on
+  /// this hook (it is always ISD::FMA).
+  bool isFMAFasterThanFMulAndFAdd(const MachineFunction &MF,
+                                  EVT VT) const override;
+
+  /// Atomic ordering support (LLVM-121t, ADR-0034).  DADAO is a weak memory
+  /// model whose only atomics are `lr`/`sc`, and the ISA has no AMO: atomic
+  /// loads/stores are ordinary narrow/wide accesses bracketed by `fence`
+  /// (AtomicExpandPass inserts the fences at IR level, see emitLeadingFence /
+  /// emitTrailingFence), while every RMW and cmpxchg reduces to a `lr`/`sc`
+  /// retry loop.  Returning true here is what makes the pass lower an atomic
+  /// load/store to a plain access + `fence` instead of a `__atomic_*` libcall.
+  bool shouldInsertFencesForAtomic(const Instruction *I) const override;
+
+  /// Every integer atomicrmw (`add/sub/and/or/xor/xchg/nand/min/max/umin/
+  /// umax`, i8..i64) is expanded into a cmpxchg loop in IR, which then reaches
+  /// the DAG as ATOMIC_CMP_SWAP_WITH_SUCCESS and is lowered to the lr/sc loop
+  /// (DADAOCodeGen.td: ATOMIC_CMP_SWAP_PSEUDO_*).  There is no AMO and no
+  /// "__atomic_*" runtime in the toolchain, so nothing may fall back to a
+  /// libcall.
+  AtomicExpansionKind
+  shouldExpandAtomicRMWInIR(const AtomicRMWInst *RMW) const override;
+
+  /// Expand the lr/sc CAS pseudos into the retry loop (LLVM-121t).  The hook
+  /// runs in FinalizeISel (before register allocation), which is where new
+  /// basic blocks can still be created; the loop body only contains lr/sc,
+  /// two branches and (at worst) register spills, all of which leave the
+  /// reservation semantics intact (a lost reservation is retried).
+  MachineBasicBlock *EmitInstrWithCustomInserter(MachineInstr &MI,
+                                                 MachineBasicBlock *MBB) const override;
+
+private:
+  /// Copy call results out of the return registers (RetCC_DADAO) into virtual
+  /// registers (LLVM-039t).
+  SDValue LowerCallResult(SDValue Chain, SDValue InGlue,
+                          CallingConv::ID CallConv, bool IsVarArg,
+                          const SmallVectorImpl<ISD::InputArg> &Ins,
+                          const SDLoc &DL, SelectionDAG &DAG,
+                          SmallVectorImpl<SDValue> &InVals) const;
+
+  /// Lower an integer compare+branch to DADAO cmp* + br.* (C17, ADR-0018).
+  SDValue LowerBR_CC(SDValue Chain, ISD::CondCode CC, SDValue LHS, SDValue RHS,
+                     SDValue Dest, const SDLoc &DL, SelectionDAG &DAG) const;
+  SDValue LowerBRCOND(SDValue Op, SelectionDAG &DAG) const;
+
+  /// Compare-as-value lowering (LLVM-069t).  `icmp` used as a value (SETCC
+  /// surviving the i1 -> i64 promotion) selects constants 1/0; a ternary /
+  /// if-conversion SELECT_CC selects its two arms.  Both compute a cmp* result
+  /// (-1/0/1) and normalise it through cs.* (contract-isa.md §6.2/§6.5).
+  SDValue LowerSETCC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSELECT_CC(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerSELECT(SDValue Op, SelectionDAG &DAG) const;
+
+  /// Shared driver for SETCC / SELECT_CC: emit the compare (CMP/CMPU for
+  /// integers, FCMP for floating point, both yielding {-1,0,1}) and a cs.*
+  /// conditional assignment picking True/False (contract-isa.md §6.5).
+  SDValue LowerCmpSelect(ISD::CondCode CC, SDValue LHS, SDValue RHS,
+                         SDValue True, SDValue False, const SDLoc &DL,
+                         SelectionDAG &DAG) const;
+
+  /// Lower a dense `switch` (ISD::BR_JT) to a DADAOISD::BR_JT node carrying the
+  /// jump-table index and the (TargetJumpTable) table symbol (LLVM-072t,
+  /// ISS-177/G3); the indirect load+jump is selected in DADAOISelDAGToDAG.
+  SDValue LowerBR_JT(SDValue Op, SelectionDAG &DAG) const;
+
+  /// Lower an indirect branch (ISD::BRIND, LLVM-102t) to a DADAOISD::BRIND
+  /// node whose target operand is a GPRB virtual register.  The address is a
+  /// C data value (function pointer / `&&label`, contract-isa.md §8.3: the
+  /// rrii base must be an RB register), so it is copied into GPRB with
+  /// CopyToReg (RD->RB becomes `rd2rb`); the selector then emits
+  /// `jump rbtarget, rd0, 0`.  `rb0` is the IP and cannot be the base.
+  SDValue LowerBRIND(SDValue Op, SelectionDAG &DAG) const;
+
+  /// Local-exec TLS address lowering (LLVM-100t).  `ISD::GlobalTLSAddress`
+  /// becomes DADAOISD::TLS_ADDR carrying the TargetGlobalAddress; the selector
+  /// materializes the symbol's TPOFF (an R_DADAO_ABS48 sequence on the STT_TLS
+  /// symbol) and adds TP (`rb3`).  Only the local-exec model is implemented:
+  /// global-dynamic / local-dynamic / initial-exec need the dynamic TLS
+  /// relocations 10/11/12 (`D2`, M9+/LLVM-117t) and are rejected with a
+  /// diagnostic (contract-dynlink.md §10②: unsupported => explicit error).
+  SDValue LowerGlobalTLSAddress(SDValue Op, SelectionDAG &DAG) const;
+
+  /// `llvm.thread.pointer` (`__builtin_thread_pointer`) reads the thread
+  /// pointer register.  DADAO's TP is `rb3` (contract-abi.md §1.3), reserved
+  /// and never allocated, so the lowering is a CopyFromReg of that physical
+  /// register.
+  SDValue getThreadPointer(const SDLoc &DL, SelectionDAG &DAG) const;
+
+  /// Intrinsic lowering entry point for ISD::INTRINSIC_WO_CHAIN (LLVM-100t:
+  /// only `llvm.thread.pointer` is handled; anything else returns an empty
+  /// SDValue so the legalizer keeps the generic path).
+  SDValue LowerINTRINSIC_WO_CHAIN(SDValue Op, SelectionDAG &DAG) const;
+
+  /// Atomic lowering (LLVM-121t, ADR-0034 D2/D6).
+  ///
+  ///   ISD::ATOMIC_FENCE -> DADAOISD::FENCE carrying the `fm`/`pred`/`succ`
+  ///     immediate; the ordering mapping is:
+  ///       acquire            -> pred R,        succ R|W    = 0x043
+  ///       release            -> pred R|W,      succ W      = 0x0C2
+  ///       acq_rel / seq_cst  -> pred R|W|I|O,  succ R|W|I|O = 0x3CF
+  ///       monotonic/unordered-> no instruction (the chain is returned as is)
+  ///   ISD::ATOMIC_LOAD / ISD::ATOMIC_STORE -> an ordinary extending load /
+  ///     truncating store (the fences were already inserted by AtomicExpand).
+  ///   ISD::ATOMIC_CMP_SWAP_WITH_SUCCESS -> DADAOISD::ATOMIC_CMP_SWAP (the
+  ///     lr/sc retry loop) plus a SETCC producing the success flag.
+  SDValue LowerATOMIC_FENCE(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerATOMIC_LOAD(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerATOMIC_STORE(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerATOMIC_CMP_SWAP_WITH_SUCCESS(SDValue Op,
+                                            SelectionDAG &DAG) const;
+
+  /// Varargs lowering (M6, contract-abi.md §6 / spec DADAO-21 §可变参数).  The
+  /// caller writes every argument into a contiguous 8-byte-slot save area at
+  /// incoming SP; va_start points just past the named arguments and va_arg
+  /// walks the slots one at a time.
+  SDValue LowerVASTART(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerVAARG(SDValue Op, SelectionDAG &DAG) const;
+  SDValue LowerVACOPY(SDValue Op, SelectionDAG &DAG) const;
+
+  /// ISD::FMINNUM / ISD::FMAXNUM (LLVM-124t, contract-fp.md §minmax): rewrite to
+  /// the well-defined FMINNUM_IEEE / FMAXNUM_IEEE, which the ISA instructions
+  /// `ftmin`/`ftmax`/`fomin`/`fomax` implement exactly.  Unlike LLVM's generic
+  /// expansion this inserts no FCANONICALIZE (LangRef leaves minnum's sNaN
+  /// result non-deterministic, and canonicalising would suppress the NV flag
+  /// that contract-fp.md §minmax requires on an sNaN input).
+  SDValue LowerMinMaxNum(SDValue Op, SelectionDAG &DAG) const;
+
+  /// True if V is an i64 value held in the GPRB (pointer/address) bank, i.e. a
+  /// CopyFromReg of a GPRB virtual register created by LowerFormalArguments.
+  bool isPointerBankValue(SDValue V, const SelectionDAG &DAG) const;
+};
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_DADAOISELLOWERING_H
