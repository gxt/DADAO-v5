+//===----------------------------------------------------------------------===//
+// Register name matching.
+//===----------------------------------------------------------------------===//
+
+unsigned DADAOAsmParser::matchRegisterName(StringRef Name) {
+  if (Name.starts_with("rd")) {
+    unsigned Num;
+    if (!Name.substr(2).getAsInteger(10, Num) && Num < 64)
+      return DADAO::rd0 + Num;
+  }
+  if (Name.starts_with("rb")) {
+    unsigned Num;
+    if (!Name.substr(2).getAsInteger(10, Num) && Num < 64)
+      return DADAO::rb0 + Num;
+  }
+  if (Name.starts_with("rf")) {
+    unsigned Num;
+    if (!Name.substr(2).getAsInteger(10, Num) && Num < 64)
+      return DADAO::rf0 + Num;
+  }
+  if (Name.starts_with("ra")) {
+    unsigned Num;
+    if (!Name.substr(2).getAsInteger(10, Num) && Num < 64)
+      return DADAO::ra0 + Num;
+  }
+  return 0;
+}
+
+bool DADAOAsmParser::isRegBankPrefix(StringRef Name) {
+  return Name.starts_with("rd") || Name.starts_with("rb") ||
+         Name.starts_with("rf") || Name.starts_with("ra");
+}
+
+//===----------------------------------------------------------------------===//
+// Register parsing.
+//===----------------------------------------------------------------------===//
+
+ParseStatus DADAOAsmParser::parseRegisterImpl(MCRegister &Reg, SMLoc &StartLoc,
+                                               SMLoc &EndLoc) {
+  const AsmToken &Tok = getParser().getTok();
+  if (Tok.isNot(AsmToken::Identifier))
+    return ParseStatus::NoMatch;
+
+  StringRef Name = Tok.getString();
+  unsigned RegNo = matchRegisterName(Name);
+  if (RegNo == 0)
+    return ParseStatus::NoMatch;
+
+  Reg = RegNo;
+  StartLoc = Tok.getLoc();
+  EndLoc = Tok.getEndLoc();
+  getParser().Lex();
+  return ParseStatus::Success;
+}
+
+bool DADAOAsmParser::parseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                                    SMLoc &EndLoc) {
+  return parseRegisterImpl(Reg, StartLoc, EndLoc).isFailure();
+}
+
+ParseStatus DADAOAsmParser::tryParseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                                              SMLoc &EndLoc) {
+  return parseRegisterImpl(Reg, StartLoc, EndLoc);
+}
+
+//===----------------------------------------------------------------------===//
+// Immediate parsing.
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseImmediate(OperandVector &Operands) {
+  const AsmToken &Tok = getParser().getTok();
+  SMLoc StartLoc = Tok.getLoc();
+
+  const MCExpr *Expr;
+  SMLoc EndLoc;
+  if (getParser().parseExpression(Expr, EndLoc))
+    return true;
+
+  int64_t Val;
+  if (Expr->evaluateAsAbsolute(Val)) {
+    Operands.push_back(DADAOOperand::createImm(Val, StartLoc, EndLoc));
+  } else {
+    Operands.push_back(DADAOOperand::createImmExpr(Expr, StartLoc, EndLoc));
+  }
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// Wyde-position token (wp0/wp1/wp2/wp3).
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseWydePosToken(OperandVector &Operands) {
+  const AsmToken &Tok = getParser().getTok();
+  if (Tok.isNot(AsmToken::Identifier))
+    return false;
+
+  StringRef Name = Tok.getString();
+  if (Name.size() < 3 || !Name.starts_with("wp"))
+    return false;
+
+  unsigned N;
+  if (Name.substr(2).getAsInteger(10, N) || N > 3) {
+    SMLoc Loc = Tok.getLoc();
+    getParser().Lex();
+    return Error(Loc, "invalid wyde-position; expected wp0, wp1, wp2, or wp3");
+  }
+
+  SMLoc StartLoc = Tok.getLoc();
+  SMLoc EndLoc = Tok.getEndLoc();
+  getParser().Lex();
+  Operands.push_back(DADAOOperand::createWydePos(N, StartLoc, EndLoc));
+  return true;
+}
+
+//===----------------------------------------------------------------------===//
+// Register group parsing: {reg}, {r1:r2}, {r1, r2}, {r1, r2}?
+//
+// Syntax (assembly-language.md §4):
+//   {rd8}            — single register (count=1)
+//   {rd8:rd11}       — range (count = end-start+1)
+//   {rd8, rd9}       — register pair (dual-purpose, no ?)
+//   {rd8, rd0}?      — condition group (has ?)
+//   {rd3}?           — single condition (has ?)
+//
+// After parsing, the operand is one of:
+//   kRegGroup      — range or single (decomposed later)
+//   kRegGroupCond  — condition group (decomposed later)
+//   kRegPair       — dual-purpose pair (decomposed later)
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseRegGroup(OperandVector &Operands) {
+  const AsmToken &LBrace = getParser().getTok();
+  SMLoc StartLoc = LBrace.getLoc();
+
+  if (LBrace.isNot(AsmToken::LCurly))
+    return false;
+  getParser().Lex(); // consume '{'
+
+  SmallVector<MCRegister, 4> Regs;
+  bool HasColon = false;
+
+  // Parse first register.
+  MCRegister First;
+  SMLoc RStart, REnd;
+  if (parseRegisterImpl(First, RStart, REnd).isFailure())
+    return Error(getParser().getTok().getLoc(),
+                 "expected register name in register group");
+  Regs.push_back(First);
+
+  // Check what follows: ':', ',', or '}'.
+  const AsmToken &Next = getParser().getTok();
+  if (Next.is(AsmToken::Colon)) {
+    // Range: {start:end}
+    HasColon = true;
+    getParser().Lex(); // consume ':'
+    MCRegister Last;
+    if (parseRegisterImpl(Last, RStart, REnd).isFailure())
+      return Error(getParser().getTok().getLoc(),
+                   "expected register name after ':' in register group");
+    Regs.push_back(Last);
+
+    if (!getParser().getTok().is(AsmToken::RCurly))
+      return Error(getParser().getTok().getLoc(),
+                   "expected '}' to close register group");
+    getParser().Lex(); // consume '}'
+
+    // Compute count from range.
+    unsigned StartIdx = First.id() - DADAO::rd0;
+    unsigned EndIdx = Last.id() - DADAO::rd0;
+    // All register banks are contiguous, so the difference works for any bank.
+    if (EndIdx < StartIdx)
+      return Error(RStart, "invalid register range: end < start");
+    unsigned Count = EndIdx - StartIdx + 1;
+    if (Count > 64)
+      return Error(RStart, "register range too large");
+
+    SMLoc EndLoc = getParser().getTok().getLoc();
+    Operands.push_back(
+        DADAOOperand::createRegGroup(Regs, Count, StartLoc, EndLoc));
+    return false; // success
+  }
+
+  if (Next.is(AsmToken::Comma)) {
+    // Comma-separated: either pair ({r1, r2}) or condition ({r1, r2}? or {r1}?).
+    // Parse additional registers separated by commas.
+    while (getParser().getTok().is(AsmToken::Comma)) {
+      getParser().Lex(); // consume ','
+      MCRegister Reg;
+      if (parseRegisterImpl(Reg, RStart, REnd).isFailure())
+        return Error(getParser().getTok().getLoc(),
+                     "expected register name in register group");
+      Regs.push_back(Reg);
+    }
+  }
+
+  // Expect '}'.
+  if (!getParser().getTok().is(AsmToken::RCurly))
+    return Error(getParser().getTok().getLoc(),
+                 "expected '}' to close register group");
+  getParser().Lex(); // consume '}'
+
+  SMLoc EndLoc = getParser().getTok().getLoc();
+
+  // Check for '?' after '}' (AsmToken::Question).
+  bool HasQuestion = false;
+  if (getParser().getTok().is(AsmToken::Question)) {
+    HasQuestion = true;
+    EndLoc = getParser().getTok().getEndLoc();
+    getParser().Lex(); // consume '?'
+  }
+
+  if (HasQuestion) {
+    // Condition group.
+    Operands.push_back(
+        DADAOOperand::createRegGroupCond(Regs, StartLoc, EndLoc));
+  } else if (Regs.size() == 2 && !HasColon) {
+    // Register pair (dual-purpose): exactly 2 registers, no colon, no ?.
+    Operands.push_back(
+        DADAOOperand::createRegPair(Regs[0], Regs[1], StartLoc, EndLoc));
+  } else if (Regs.size() == 1 && !HasColon) {
+    // Single register group: {rd8} (count=1).
+    SmallVector<MCRegister, 1> SingleReg(Regs.begin(), Regs.end());
+    Operands.push_back(
+        DADAOOperand::createRegGroup(SingleReg, 1, StartLoc, EndLoc));
+  } else {
+    // Multiple registers without colon or ? — not valid.
+    return Error(StartLoc,
+                 "invalid register group: use ':' for range or '?' for condition");
+  }
+
+  return false; // success
+}
+
+//===----------------------------------------------------------------------===//
+// Address expression parsing: [base, offset] or [base, reg, offset]
+//
+// Syntax (assembly-language.md §3):
+//   [rb2, 1]           — memory: base + byte offset
+//   [rb0, 16]          — iiii jump: base + byte offset (%4==0)
+//   [rb3, rd0, 64]     — rrii jump: base + reg offset + byte offset (%4==0)
+//
+// Address immediates are byte offsets (no unit suffix).
+// Validation of %4==0 and range + encoding >>2 is done in matchAndEmitInstruction.
+//
+// matchAndEmitInstruction handles stripping the base register for iiii jumps.
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseAddressExpr(OperandVector &Operands) {
+  const AsmToken &LBrack = getParser().getTok();
+  SMLoc StartLoc = LBrack.getLoc();
+
+  if (LBrack.isNot(AsmToken::LBrac))
+    return false;
+  getParser().Lex(); // consume '['
+
+  // Parse base register.
+  MCRegister Base;
+  SMLoc RStart, REnd;
+  if (parseRegisterImpl(Base, RStart, REnd).isFailure())
+    return Error(getParser().getTok().getLoc(),
+                 "expected base register in address expression");
+
+  // Expect ','.
+  if (!getParser().getTok().is(AsmToken::Comma))
+    return Error(getParser().getTok().getLoc(),
+                 "expected ',' after base register in address expression");
+  getParser().Lex(); // consume ','
+
+  // Try to parse a register (for [base, reg, offset] form).
+  MCRegister Index;
+  const AsmToken &AfterComma = getParser().getTok();
+  bool HasIndexReg = false;
+
+  if (AfterComma.is(AsmToken::Identifier) &&
+      matchRegisterName(AfterComma.getString()) != 0) {
+    SMLoc IdxStart, IdxEnd;
+    parseRegisterImpl(Index, IdxStart, IdxEnd);
+    HasIndexReg = true;
+
+    if (getParser().getTok().is(AsmToken::Comma)) {
+      getParser().Lex(); // consume ','
+    } else if (getParser().getTok().is(AsmToken::RBrac)) {
+      getParser().Lex(); // consume ']'
+      SMLoc EndLoc = getParser().getTok().getLoc();
+      Operands.push_back(DADAOOperand::createReg(Base, RStart));
+      Operands.push_back(DADAOOperand::createReg(Index, IdxStart));
+      Operands.push_back(DADAOOperand::createImm(0, EndLoc, EndLoc));
+      return false;
+    } else {
+      return Error(getParser().getTok().getLoc(),
+                   "expected ',' or ']' after register in address expression");
+    }
+  }
+
+  // Parse offset (immediate expression). Address offsets are byte values.
+  const MCExpr *OffsetExpr;
+  SMLoc ExprEnd;
+  if (getParser().parseExpression(OffsetExpr, ExprEnd))
+    return true;
+  SMLoc EndLoc = ExprEnd;
+
+  // Evaluate the expression. If non-constant (label/symbol), push as expr
+  // for fixup generation. If constant, validate and encode.
+  int64_t OffsetVal;
+  if (!OffsetExpr->evaluateAsAbsolute(OffsetVal)) {
+    // Non-constant expression — push as expr (fixup).
+    if (!getParser().getTok().is(AsmToken::RBrac))
+      return Error(getParser().getTok().getLoc(),
+                   "expected ']' to close address expression");
+    getParser().Lex(); // consume ']'
+    EndLoc = getParser().getTok().getLoc();
+    Operands.push_back(DADAOOperand::createReg(Base, RStart));
+    if (HasIndexReg)
+      Operands.push_back(DADAOOperand::createReg(Index, RStart));
+    Operands.push_back(
+        DADAOOperand::createImmExpr(OffsetExpr, StartLoc, EndLoc));
+    return false;
+  }
+
+  // Expect ']'.
+  if (!getParser().getTok().is(AsmToken::RBrac))
+    return Error(getParser().getTok().getLoc(),
+                 "expected ']' to close address expression");
+  getParser().Lex(); // consume ']'
+  EndLoc = getParser().getTok().getLoc();
+
+  // Push as flat operands: base register, [index register], byte offset.
+  Operands.push_back(DADAOOperand::createReg(Base, RStart));
+  if (HasIndexReg)
+    Operands.push_back(DADAOOperand::createReg(Index, RStart));
+  Operands.push_back(DADAOOperand::createImm(OffsetVal, StartLoc, EndLoc));
+
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// Operand parsing.
+//
+// Dispatches to the appropriate parser based on the current token:
+//   '{' → parseRegGroup()
+//   '[' → parseAddressExpr()
+//   wp* → parseWydePosToken()
+//   reg → register operand
+//   otherwise → parseImmediate()
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseOperand(OperandVector &Operands) {
+  const AsmToken &Tok = getParser().getTok();
+
+  // Register group: {...}
+  if (Tok.is(AsmToken::LCurly)) {
+    return parseRegGroup(Operands);
+  }
+
+  // Address expression: [...]
+  if (Tok.is(AsmToken::LBrac)) {
+    return parseAddressExpr(Operands);
+  }
+
+  if (Tok.is(AsmToken::Identifier)) {
+    // Try wyde-position token first (wp0/wp1/wp2/wp3).
+    if (parseWydePosToken(Operands))
+      return false;
+
+    // Try register.
+    unsigned RegNo = matchRegisterName(Tok.getString());
+    if (RegNo) {
+      SMLoc StartLoc = Tok.getLoc();
+      getParser().Lex();
+      Operands.push_back(DADAOOperand::createReg(RegNo, StartLoc));
+      return false;
+    }
+
+    // Check for '?' as a standalone token (AsmToken::Question).
+    if (Tok.is(AsmToken::Question)) {
+      return Error(Tok.getLoc(), "unexpected '?' — did you mean '{...}'?");
+    }
+  }
+
+  return parseImmediate(Operands);
+}
+
+//===----------------------------------------------------------------------===//
+// Branch-aware operand parsing.
+//
+// For br.* instructions, the address expression is the branch target offset.
+// The base register (always rb0) is implicit — not an MCInst operand.
+// This function parses the address but only pushes the offset, not the base.
+//
+// This is called from parseInstruction when the mnemonic starts with "br."
+// and the current token is '['.
+//===----------------------------------------------------------------------===//
+
+bool parseBranchAddress(OperandVector &Operands, MCAsmParser &Parser) {
+  SMLoc StartLoc = Parser.getTok().getLoc();
+  Parser.Lex(); // consume '['
+
+  // Parse base register (must be rb0 for riii, any rb for rrii).
+  // We skip it — it's implicit in the instruction encoding.
+  const AsmToken &BaseTok = Parser.getTok();
+  if (BaseTok.isNot(AsmToken::Identifier))
+    return true; // error
+  Parser.Lex(); // consume base register
+
+  // Expect ','.
+  if (!Parser.getTok().is(AsmToken::Comma))
+    return true;
+  Parser.Lex(); // consume ','
+
+  // Check for index register (rrii form: [base, reg, offset]).
+  const AsmToken &AfterComma = Parser.getTok();
+  if (AfterComma.is(AsmToken::Identifier)) {
+    StringRef Name = AfterComma.getString();
+    if (Name.starts_with("rd") || Name.starts_with("rb") ||
+        Name.starts_with("rf") || Name.starts_with("ra")) {
+      Parser.Lex(); // consume register
+      if (Parser.getTok().is(AsmToken::Comma))
+        Parser.Lex(); // consume ','
+    }
+  }
+
+  // Parse offset expression. Branch offsets are byte values.
+  const MCExpr *OffsetExpr;
+  SMLoc ExprEnd;
+  if (Parser.parseExpression(OffsetExpr, ExprEnd))
+    return true;
+
+  // Evaluate the expression. If non-constant (label/symbol), push as expr
+  // for fixup generation. If constant, validate and encode.
+  int64_t OffsetVal;
+  if (!OffsetExpr->evaluateAsAbsolute(OffsetVal)) {
+    // Non-constant expression — push as expr (fixup).
+    if (!Parser.getTok().is(AsmToken::RBrac))
+      return true;
+    Parser.Lex(); // consume ']'
+    SMLoc EndLocFinal = Parser.getTok().getLoc();
+    Operands.push_back(
+        DADAOOperand::createImmExpr(OffsetExpr, StartLoc, EndLocFinal));
+    return false;
+  }
+
+  // Expect ']'.
+  if (!Parser.getTok().is(AsmToken::RBrac))
+    return true;
+  Parser.Lex(); // consume ']'
+  SMLoc EndLocFinal = Parser.getTok().getLoc();
+
+  // Push only the offset (base register is implicit).
+  Operands.push_back(DADAOOperand::createImm(OffsetVal, StartLoc, EndLocFinal));
+
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// Instruction parsing.
+//
+// Pushes the mnemonic as a token, then parses operands separated by commas.
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::parseInstruction(ParseInstructionInfo &Info,
+                                       StringRef Name, SMLoc NameLoc,
+                                       OperandVector &Operands) {
+  Operands.push_back(DADAOOperand::createToken(Name, NameLoc));
+  if (getParser().getTok().isNot(AsmToken::EndOfStatement)) {
+    // For br.* instructions, the second operand is an address expression
+    // that represents the branch target. The base register is implicit,
+    // so we use a special parser that only pushes the offset.
+    if (Name.starts_with("br.")) {
+      // First operand: register group {cond}?.
+      if (parseOperand(Operands))
+        return true;
+      // Expect ','.
+      if (getParser().getTok().is(AsmToken::Comma)) {
+        getParser().Lex(); // consume ','
+      }
+      // Second operand: address expression (branch target).
+      if (getParser().getTok().is(AsmToken::LBrac)) {
+        if (parseBranchAddress(Operands, getParser()))
+          return true;
+      } else {
+        // Fallback: parse as regular operand.
+        if (parseOperand(Operands))
+          return true;
+      }
+    } else if (Name.starts_with("ldm.") || Name.starts_with("stm.")) {
+      // ldm/stm: {dst:start}, [rb, rc]
+      // First operand: register group.
+      if (parseOperand(Operands))
+        return true;
+      // Expect ','.
+      if (getParser().getTok().is(AsmToken::Comma))
+        getParser().Lex();
+      // Second operand: [rb, rc] — parse as two registers, NOT as address.
+      if (getParser().getTok().is(AsmToken::LBrac)) {
+        getParser().Lex(); // consume '['
+        // Parse base register (rb).
+        if (parseOperand(Operands))
+          return true;
+        // Expect ','.
+        if (getParser().getTok().is(AsmToken::Comma))
+          getParser().Lex();
+        // Parse index register (rc).
+        if (parseOperand(Operands))
+          return true;
+        // Expect ']'.
+        if (getParser().getTok().is(AsmToken::RBrac))
+          getParser().Lex();
+      }
+    } else {
+      // Normal instruction: parse operands sequentially.
+      if (parseOperand(Operands)) {
+        return true;
+      }
+
+      while (getParser().getTok().is(AsmToken::Comma)) {
+        getParser().Lex();
+        if (parseOperand(Operands))
+          return true;
+      }
+    }
+  }
+
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// Data directives: .dd.b08 / .dd.w16 / .dd.t32 / .dd.o64
+//
+// DADAO data-length directives use Knuth/MMIX length names (spec/DADAO-11
+// §汇编兼容性 §指导符; contract-asm.md §7): .dd.b08 = 1 byte, .dd.w16 = 2 bytes,
+// .dd.t32 = 4 bytes, .dd.o64 = 8 bytes.  Values are emitted in the target byte
+// order (big endian; contract-elf.md §1.1).  Each directive accepts a comma-
+// separated list of expressions.
+//
+// GAS `.octa` is 16 bytes while DADAO's octa is 8 bytes, so the GAS directive
+// MUST NOT be used (contract-asm.md §7); it is rejected explicitly here (the
+// generic parser would otherwise accept it).  `.word` is not a known directive
+// and keeps its existing "unknown directive" rejection.
+//===----------------------------------------------------------------------===//
+
+ParseStatus DADAOAsmParser::parseDirective(AsmToken DirectiveID) {
+  StringRef ID = DirectiveID.getString();
+
+  // GAS `.octa` (16-byte octa) MUST NOT be used: DADAO's octa is 8 bytes
+  // (contract-asm.md §7 / DADAO-11 §指导符).  Point at the DADAO spelling.
+  if (ID == ".octa")
+    return Error(DirectiveID.getLoc(),
+                 "unsupported directive '.octa' (GAS 16-byte octa); DADAO's "
+                 "octa is 8 bytes -- use '.dd.o64'");
+
+  unsigned Size;
+  if (ID == ".dd.b08")
+    Size = 1;
+  else if (ID == ".dd.w16")
+    Size = 2;
+  else if (ID == ".dd.t32")
+    Size = 4;
+  else if (ID == ".dd.o64")
+    Size = 8;
+  else
+    return ParseStatus::NoMatch;
+
+  return parseDDDirective(Size, DirectiveID.getLoc());
+}
+
+ParseStatus DADAOAsmParser::parseDDDirective(unsigned Size, SMLoc Loc) {
+  MCAsmParser &Parser = getParser();
+  do {
+    SMLoc ValueLoc = Parser.getTok().getLoc();
+    const MCExpr *Value;
+    if (Parser.parseExpression(Value))
+      return ParseStatus::Failure;
+
+    // A relocatable (symbol / cross-section) operand of a data directive needs
+    // an absolute data relocation.  Only the 8-byte field can carry a DADAO
+    // 48-bit address (R_DADAO_ABS48, ADR-0019 §D2); narrower fields are
+    // rejected explicitly rather than silently truncated (contract-asm.md §9).
+    int64_t AbsValue;
+    if (Size != 8 &&
+        !Value->evaluateAsAbsolute(AbsValue,
+                                   Parser.getStreamer().getAssemblerPtr()))
+      return Error(ValueLoc,
+                   "relocatable operand in '.dd.b08/.dd.w16/.dd.t32' is not "
+                   "supported (a DADAO address needs an 8-byte field; use "
+                   "'.dd.o64')");
+
+    getParser().getStreamer().emitValue(Value, Size, ValueLoc);
+  } while (Parser.getTok().is(AsmToken::Comma) && (Parser.Lex(), true));
+
+  return ParseStatus::Success;
+}
+
+// FP block mnemonics (scope: fp) whose orri form carries a single immu6 that
+// encodes the element count shared by both `{start:end}` groups.  `rd2rf` and
+// `rf2rd` are FP block moves too and are handled alongside these 22 mnemonics
+// at the two call sites below.
+static bool isFPBlockMnemonic(StringRef Mnem) {
+  return Mnem == "ft2fo" || Mnem == "fo2ft" || Mnem == "ft2ft" ||
+         Mnem == "fo2fo" || Mnem == "ft2it" || Mnem == "ft2io" ||
+         Mnem == "ft2ut" || Mnem == "ft2uo" || Mnem == "fo2it" ||
+         Mnem == "fo2io" || Mnem == "fo2ut" || Mnem == "fo2uo" ||
+         Mnem == "it2ft" || Mnem == "io2ft" || Mnem == "ut2ft" ||
+         Mnem == "uo2ft" || Mnem == "it2fo" || Mnem == "io2fo" ||
+         Mnem == "ut2fo" || Mnem == "uo2fo" || Mnem == "ftcls" ||
+         Mnem == "focls";
+}
+
+// FP instructions subject to the `dst_rf0` rule (SPEC-088t) whose destination
+// operand immediately follows the mnemonic: the 16 scalar orrr arith/sign
+// instructions plus the 14 orri RF-destination convert/root instructions.
+// `rd2rf` and the RF loads/stores (ld.*/ldm.*/stm.*) are intentionally NOT
+// listed: there rf0 as a destination is legal (FCSR write mask).  The
+// convert_f2i / classify / compare groups have an RD destination and are not
+// listed either.
+static bool isFPDstRfMnemonic(StringRef M) {
+  return M == "ftadd" || M == "ftsub" || M == "ftmul" || M == "ftdiv" ||
+         M == "ftrem" || M == "ftsclb" || M == "ftsgnj" || M == "ftsgnn" ||
+         M == "foadd" || M == "fosub" || M == "fomul" || M == "fodiv" ||
+         M == "forem" || M == "fosclb" || M == "fosgnj" || M == "fosgnn" ||
+         M == "ft2fo" || M == "fo2ft" || M == "ft2ft" || M == "fo2fo" ||
+         M == "it2ft" || M == "io2ft" || M == "ut2ft" || M == "uo2ft" ||
+         M == "it2fo" || M == "io2fo" || M == "ut2fo" || M == "uo2fo" ||
+         M == "ftroot" || M == "foroot";
+}
+
+// FP instructions subject to the `dst_rd0` rule (SPEC-089t) whose destination
+// is an RD register, i.e. `rd0` is illegal.  These are the 15 FP rd-destination
+// forms: convert_f2i (8), classify (2), compare (4) and rf2rd (1).  rf2rd's
+// destination is an RD register; rd2rf's destination is RF (rf0 legal) and is
+// NOT listed.
+static bool isFPDstRdMnemonic(StringRef M) {
+  return M == "ft2it" || M == "ft2io" || M == "ft2ut" || M == "ft2uo" ||
+         M == "fo2it" || M == "fo2io" || M == "fo2ut" || M == "fo2uo" ||
+         M == "ftcls" || M == "focls" ||
+         M == "ftqcmp" || M == "ftscmp" || M == "foqcmp" || M == "foscmp" ||
+         M == "rf2rd";
+}
+
+// FP convert_ff instructions (SPEC-088t `mreg_range_overlap`): two same-bank
+// RF `{start:end}` groups that share one immu6 element count and must not
+// overlap (any intersection, including complete coincidence, is illegal).
+static bool isFPConvertFFMnemonic(StringRef M) {
+  return M == "ft2fo" || M == "fo2ft" || M == "ft2ft" || M == "fo2fo";
+}
+
+// FP multi-register instructions subject to `mreg_range_overflow` (SPEC-088t):
+// every `{start:end}` group they carry is checked for an element count > 63.
+// The four FP ldm.*/stm.* forms are handled separately because their mnemonic
+// is shared with the M1 RD forms, which are out of this task's scope.
+static bool isFPMregMnemonic(StringRef M) {
+  return isFPConvertFFMnemonic(M) || M == "ft2it" || M == "ft2io" ||
+         M == "ft2ut" || M == "ft2uo" || M == "fo2it" || M == "fo2io" ||
+         M == "fo2ut" || M == "fo2uo" || M == "it2ft" || M == "io2ft" ||
+         M == "ut2ft" || M == "uo2ft" || M == "it2fo" || M == "io2fo" ||
+         M == "ut2fo" || M == "uo2fo" || M == "ftcls" || M == "focls" ||
+         M == "rd2rf" || M == "rf2rd";
+}
+
+// M1 block moves that carry *two* `{start:end}` groups sharing a single immu6
+// element count (ISS-104): the same-bank rd2rd/rb2rb and the cross-bank
+// rd2rb/rb2rd/rd2ra/ra2rd (contract-isa.md §3.3.2/§3.3.3).  Both written groups
+// must therefore have the same size.
+static bool isM1BlockMnemonic(StringRef M) {
+  return M == "rd2rd" || M == "rb2rb" || M == "rd2rb" || M == "rb2rd" ||
+         M == "rd2ra" || M == "ra2rd";
+}
+
+// M1 multi-register instructions subject to `mreg_range_overflow`: the ldm.*/
+// stm.* loads/stores (RD, RB and RA destinations) and the orri block moves.  A
+// written `{start:end}` group may hold at most a full bank (64 registers), but
+// the shared immu6 count field only covers 1..63, so a count-64 group such as
+// `{rd0:rd63}` (ISS-106) would silently truncate to immu6 = 0.  ldm.t/stm.t are
+// RF-only (scope: fp) and are handled with the FP groups instead.
+static bool isM1MregMnemonic(StringRef M) {
+  return M == "ldm.ub" || M == "ldm.uw" || M == "ldm.ut" ||
+         M == "ldm.sb" || M == "ldm.sw" || M == "ldm.st" ||
+         M == "ldm.o" || M == "stm.b" || M == "stm.w" ||
+         M == "stm.t" || M == "stm.o" || isM1BlockMnemonic(M);
+}
+
+// orri block moves / floating-point format conversions that carry *two*
+// `{start:end}` groups sharing one immu6 element count: the 8 register copies
+// (ra2rd/rb2rb/rb2rd/rd2ra/rd2rb/rd2rd/rd2rf/rf2rd) and the 20 FP conversions
+// (contract-asm.md §4.2).  Classify (ftcls/focls) also has two groups, but it
+// is deliberately excluded: the spec's multi-to-single scope is 8+20.  The
+// FP root instructions are excluded too (their immu6 is the root order n, not
+// a register count).
+static bool isMultiToSingleOrriMnemonic(StringRef M) {
+  return M == "ra2rd" || M == "rb2rb" || M == "rb2rd" || M == "rd2ra" ||
+         M == "rd2rb" || M == "rd2rd" || M == "rd2rf" || M == "rf2rd" ||
+         (isFPBlockMnemonic(M) && M != "ftcls" && M != "focls");
+}
+
+// Element width (bytes) of a multi-register load/store mnemonic, i.e. the
+// amount the offset register advances between consecutive elements
+// (contract-isa.md §3.1.2: ".dd" widths b=1/w=2/t=4/o=8, signed/unsigned alike).
+static unsigned ldmStmElemWidth(StringRef M) {
+  if (M.ends_with(".ub") || M.ends_with(".sb") || M.ends_with(".b"))
+    return 1;
+  if (M.ends_with(".uw") || M.ends_with(".sw") || M.ends_with(".w"))
+    return 2;
+  if (M.ends_with(".ut") || M.ends_with(".st") || M.ends_with(".t"))
+    return 4;
+  if (M.ends_with(".o"))
+    return 8;
+  return 0;
+}
+
+// First register of a flat register operand or of a `{start:end}` group;
+// returns the no-register sentinel (0) for any other operand kind.
+static MCRegister firstRegisterOf(const DADAOOperand *Op) {
+  if (!Op)
+    return MCRegister();
+  if (Op->Kind == DADAOOperand::kRegister)
+    return Op->getReg();
+  if (Op->Kind == DADAOOperand::kRegGroup && !Op->getRegList().empty())
+    return Op->getRegList()[0];
+  return MCRegister();
+}
+
+// True iff the register belongs to the RF bank (rf0..rf63).
+static bool isRFRegister(MCRegister R) {
+  return R.id() >= DADAO::rf0 && R.id() <= DADAO::rf63;
+}
+
+// Register-bank predicates used by pseudo-instruction expansion.
+static bool isGPRDRegister(MCRegister R) {
+  return R.id() >= DADAO::rd0 && R.id() <= DADAO::rd63;
+}
+static bool isGPRBRegister(MCRegister R) {
+  return R.id() >= DADAO::rb0 && R.id() <= DADAO::rb63;
+}
+static bool isGPRARegister(MCRegister R) {
+  return R.id() >= DADAO::ra0 && R.id() <= DADAO::ra63;
+}
+
+// Build a single-register `{r}` group operand (range of length 1).  The pseudo
+// expansions are single-register block moves, so the shared immu6 count is 1.
+static std::unique_ptr<DADAOOperand> singleRegGroup(MCRegister R, SMLoc L) {
+  SmallVector<MCRegister, 1> Regs{R};
+  return DADAOOperand::createRegGroup(Regs, 1, L, L);
+}
+
+//===----------------------------------------------------------------------===//
+// Pseudo-instruction expansion (ADR-0013 D11 / spec/Toolchain-01 §6).
+//
+// The eight retained synthetic pseudo-forms are expanded here, in the front
+// end, into real hardware instructions; pseudo text never reaches the printer
+// or the disassembler.  Each expanded instruction is fed back through
+// matchAndEmitInstruction so the existing legality checks and the auto-
+// generated matcher apply unchanged.
+//
+//   set.rd rd, imm64 : constant -> minimal set.zw/set.ow + or.w/andn.w
+//                      symbol   -> fixed 3 slices (wp2/wp1/wp0) + ABS48
+//   set.rd rd, rs    : rb2rd / rf2rd / ra2rd / rd2rd
+//   set.rb rb, imm64 : set.zw-rb + or.w-rb (no set.ow-rb; all-ones = 4 insns)
+//   set.rb rb, rs    : rd2rb / rb2rb
+//   set.ft rf, imm32 : 2x set.w (never touches the high 32 bits)
+//   set.ft rf, rs    : rd2rf / ft2ft
+//   set.fo rf, imm64 : imm==0 -> rd2rf from rd0; else 4x set.w
+//   set.fo rf, rs    : rd2rf / fo2fo
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::expandPseudoInstruction(
+    SMLoc IDLoc, StringRef Mnem, OperandVector &Operands, MCStreamer &Out,
+    unsigned &Opcode, uint64_t &ErrorInfo, bool MatchingInlineAsm) {
+  if (Operands.size() != 3)
+    return Error(IDLoc,
+                 "'" + Mnem.str() + "' requires exactly two operands");
+
+  auto *Dst = static_cast<DADAOOperand *>(Operands[1].get());
+  auto *Src = static_cast<DADAOOperand *>(Operands[2].get());
+  if (!Dst || !Src)
+    return Error(IDLoc, "invalid operand for '" + Mnem.str() + "'");
+  SMLoc DstLoc = Operands[1]->getStartLoc();
+  SMLoc SrcLoc = Operands[2]->getStartLoc();
+
+  if (Dst->Kind != DADAOOperand::kRegister)
+    return Error(DstLoc, "invalid '" + Mnem.str() +
+                             "': destination must be a register");
+  MCRegister DstReg = Dst->getReg();
+
+  // The destination bank is fixed by the pseudo mnemonic.
+  bool DstOK = (Mnem == "set.rd")
+                   ? isGPRDRegister(DstReg)
+                   : (Mnem == "set.rb")
+                         ? isGPRBRegister(DstReg)
+                         : /* set.ft / set.fo */ isRFRegister(DstReg);
+  if (!DstOK)
+    return Error(DstLoc, "invalid '" + Mnem.str() +
+                             "': destination register is in the wrong bank");
+
+  // Emit one already-expanded instruction through the normal path so that all
+  // existing checks (block counts, overlap, RF/RD destination rules, matching)
+  // apply exactly as if the real instruction had been written by hand.
+  auto emitSub = [&](OperandVector &SubOps) -> bool {
+    return matchAndEmitInstruction(IDLoc, Opcode, SubOps, Out, ErrorInfo,
+                                   MatchingInlineAsm);
+  };
+  auto emitRegInst = [&](StringRef Real, MCRegister A, MCRegister B) -> bool {
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> SubOps;
+    SubOps.push_back(DADAOOperand::createToken(Real, IDLoc));
+    SubOps.push_back(singleRegGroup(A, DstLoc));
+    SubOps.push_back(singleRegGroup(B, SrcLoc));
+    return emitSub(SubOps);
+  };
+  auto emitWii = [&](StringRef Real, unsigned Wp, int64_t Val) -> bool {
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> SubOps;
+    SubOps.push_back(DADAOOperand::createToken(Real, IDLoc));
+    SubOps.push_back(DADAOOperand::createReg(DstReg, DstLoc));
+    SubOps.push_back(DADAOOperand::createWydePos(Wp, SrcLoc, SrcLoc));
+    SubOps.push_back(
+        DADAOOperand::createImm(Val & 0xFFFF, SrcLoc, Operands[2]->getEndLoc()));
+    return emitSub(SubOps);
+  };
+  auto emitWiiExpr = [&](StringRef Real, unsigned Wp, const MCExpr *E) -> bool {
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> SubOps;
+    SubOps.push_back(DADAOOperand::createToken(Real, IDLoc));
+    SubOps.push_back(DADAOOperand::createReg(DstReg, DstLoc));
+    SubOps.push_back(DADAOOperand::createWydePos(Wp, SrcLoc, SrcLoc));
+    SubOps.push_back(
+        DADAOOperand::createImmExpr(E, SrcLoc, Operands[2]->getEndLoc()));
+    return emitSub(SubOps);
+  };
+
+  // --- Register-source form ------------------------------------------------
+  if (Src->Kind == DADAOOperand::kRegister) {
+    MCRegister S = Src->getReg();
+    StringRef Real;
+    if (Mnem == "set.rd") {
+      if (isGPRBRegister(S))      Real = "rb2rd";
+      else if (isRFRegister(S))   Real = "rf2rd";
+      else if (isGPRARegister(S)) Real = "ra2rd";
+      else if (isGPRDRegister(S)) Real = "rd2rd";
+    } else if (Mnem == "set.rb") {
+      if (isGPRDRegister(S))      Real = "rd2rb";
+      else if (isGPRBRegister(S)) Real = "rb2rb";
+    } else if (Mnem == "set.ft") {
+      if (isGPRDRegister(S))      Real = "rd2rf";
+      else if (isRFRegister(S))   Real = "ft2ft";
+    } else { // set.fo
+      if (isGPRDRegister(S))      Real = "rd2rf";
+      else if (isRFRegister(S))   Real = "fo2fo";
+    }
+    if (Real.empty())
+      return Error(SrcLoc, "invalid '" + Mnem.str() +
+                               "': unsupported source register bank");
+    return emitRegInst(Real, DstReg, S);
+  }
+
+  // --- Immediate / symbol form ---------------------------------------------
+  if (Src->Kind != DADAOOperand::kImmediate)
+    return Error(SrcLoc, "invalid '" + Mnem.str() +
+                             "': expected a register or an immediate");
+
+  const MCExpr *SymExpr = Src->getImmExpr();
+  int64_t Imm = Src->getImm();
+
+  // Symbol / relocatable: fixed 3 slices + R_DADAO_ABS48.  A DADAO address is
+  // 48 bits, so the slices are wp2/wp1/wp0; set.zw seeds the high slice and
+  // zeroes the remaining bits.  Only set.rd/set.rb materialize addresses.
+  if (SymExpr) {
+    if (Mnem == "set.ft" || Mnem == "set.fo")
+      return Error(SrcLoc, "invalid '" + Mnem.str() +
+                               "': a symbol/relocatable operand is not "
+                               "supported (only set.rd/set.rb)");
+    if (emitWiiExpr("set.zw", 2, SymExpr))
+      return true;
+    if (emitWiiExpr("or.w", 1, SymExpr))
+      return true;
+    if (emitWiiExpr("or.w", 0, SymExpr))
+      return true;
+    return false;
+  }
+
+  // set.ft: exactly two set.w, low tetra only.  set.ft never uses rd2rf (that
+  // would clear the high 32 bits).
+  if (Mnem == "set.ft") {
+    if (!isUInt<32>(Imm) && !isInt<32>(Imm))
+      return Error(SrcLoc,
+                   "immediate out of range for 'set.ft' (must fit in 32 bits)");
+    uint32_t V32 = static_cast<uint32_t>(static_cast<uint64_t>(Imm));
+    if (emitWii("set.w", 1, (V32 >> 16) & 0xFFFF))
+      return true;
+    return emitWii("set.w", 0, V32 & 0xFFFF);
+  }
+
+  // set.fo: zero is materialized from rd0 (constant zero) with one rd2rf;
+  // otherwise four set.w cover the full octa.
+  if (Mnem == "set.fo") {
+    uint64_t V = static_cast<uint64_t>(Imm);
+    if (V == 0)
+      return emitRegInst("rd2rf", DstReg, DADAO::rd0);
+    for (int I = 3; I >= 0; --I)
+      if (emitWii("set.w", I, (V >> (16 * I)) & 0xFFFF))
+        return true;
+    return false;
+  }
+
+  // set.rd / set.rb constants: minimize the instruction count over the 4
+  // wydes.  A seed instruction (set.zw fills the other wydes with 0, set.ow
+  // with 0xFFFF) fixes one wyde; each remaining wyde needs one correction
+  // (or.w to set bits when the fill is 0, andn.w to clear bits when 0xFFFF).
+  // The seed is the highest-index wyde differing from the fill (wp0 if all
+  // match); corrections are emitted high-to-low.
+  uint64_t V = static_cast<uint64_t>(Imm);
+  uint16_t W[4];
+  for (int I = 0; I < 4; ++I)
+    W[I] = (V >> (16 * I)) & 0xFFFF;
+
+  // set.rb has no set.ow-rb variant: always seed with set.zw (fill 0).
+  if (Mnem == "set.rb") {
+    unsigned Base = 0;
+    for (int I = 3; I >= 0; --I)
+      if (W[I] != 0) {
+        Base = I;
+        break;
+      }
+    if (emitWii("set.zw", Base, W[Base]))
+      return true;
+    for (int I = 3; I >= 0; --I)
+      if (I != static_cast<int>(Base) && W[I] != 0)
+        if (emitWii("or.w", I, W[I]))
+          return true;
+    return false;
+  }
+
+  // set.rd: choose the cheaper fill (set.zw vs set.ow); ties prefer set.zw.
+  int Nz = 0, Nf = 0;
+  for (int I = 0; I < 4; ++I) {
+    if (W[I] != 0)
+      ++Nz;
+    if (W[I] != 0xFFFF)
+      ++Nf;
+  }
+  int CostZw = Nz > 0 ? Nz : 1;
+  int CostOw = Nf > 0 ? Nf : 1;
+  if (CostZw <= CostOw) {
+    unsigned Base = 0;
+    for (int I = 3; I >= 0; --I)
+      if (W[I] != 0) {
+        Base = I;
+        break;
+      }
+    if (emitWii("set.zw", Base, W[Base]))
+      return true;
+    for (int I = 3; I >= 0; --I)
+      if (I != static_cast<int>(Base) && W[I] != 0)
+        if (emitWii("or.w", I, W[I]))
+          return true;
+  } else {
+    unsigned Base = 0;
+    for (int I = 3; I >= 0; --I)
+      if (W[I] != 0xFFFF) {
+        Base = I;
+        break;
+      }
+    if (emitWii("set.ow", Base, W[Base]))
+      return true;
+    for (int I = 3; I >= 0; --I)
+      if (I != static_cast<int>(Base) && W[I] != 0xFFFF)
+        if (emitWii("andn.w", I, (~W[I]) & 0xFFFF))
+          return true;
+  }
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// -multiple-to-single expansion (spec/DADAO-11 §汇编器选项; contract-asm §8).
+//
+// When the option is enabled, a multi-register instruction is converted into a
+// series of single-register instructions that keep the same mnemonic:
+//
+//   ldm.*/stm.* (rrri) : {d0:dN-1}, [rb, rc]
+//                        -> N x {di}, [rb, rc], advancing the offset register
+//                           with `add.si rc, +W` between elements and a final
+//                           `add.si rc, -(N-1)*W` restoring it
+//                           (W = element width of the mnemonic).
+//   orri block moves / : {d0:dN-1}, {s0:sN-1}  ->  N x {di}, {si}
+//   FP format converts
+//
+// The original multi-register instruction has already passed the static checks
+// above, so illegal ranges/overlaps are still rejected first.  Four cases
+// cannot be expanded safely and are rejected here (hard errors):
+//   * rb0 base — PC-relative, and each expanded instruction has a different
+//     address, so the effective address would change;
+//   * rd0 as the offset register — `add.si rd0` cannot change it;
+//   * the offset register lies inside the accessed range — the expansion would
+//     overwrite the value it needs to keep advancing;
+//   * an ldm.* base inside the written destination range — the group is written
+//     element by element, so the base would be overwritten before later reads.
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::expandMultiRegisterInstruction(
+    SMLoc IDLoc, StringRef Mnem, OperandVector &Operands, MCStreamer &Out,
+    unsigned &Opcode, uint64_t &ErrorInfo, bool MatchingInlineAsm) {
+  auto emit = [&](OperandVector &SubOps) -> bool {
+    return matchAndEmitInstruction(IDLoc, Opcode, SubOps, Out, ErrorInfo,
+                                   MatchingInlineAsm);
+  };
+
+  if (Mnem.starts_with("ldm.") || Mnem.starts_with("stm.")) {
+    // Operand layout (parseInstruction): Token, {d0:dN-1}, rb, rc.
+    auto *G = static_cast<DADAOOperand *>(Operands[1].get());
+    MCRegister First = G->getRegList()[0];
+    MCRegister Base = static_cast<DADAOOperand *>(Operands[2].get())->getReg();
+    MCRegister Offset = static_cast<DADAOOperand *>(Operands[3].get())->getReg();
+    unsigned Count = G->getGroupCount();
+    SMLoc Loc = G->getStartLoc();
+
+    if (Base == DADAO::rb0)
+      return Error(IDLoc,
+                   "'-multiple-to-single' cannot expand '" + Mnem.str() +
+                       "': base register rb0 is PC-relative, but the expansion "
+                       "changes the instruction address");
+    if (Offset == DADAO::rd0)
+      return Error(IDLoc,
+                   "'-multiple-to-single' cannot expand '" + Mnem.str() +
+                       "': the offset register rd0 cannot be advanced");
+    if (Offset.id() >= First.id() && Offset.id() < First.id() + Count)
+      return Error(IDLoc,
+                   "'-multiple-to-single' cannot expand '" + Mnem.str() +
+                       "': the offset register is inside the accessed register "
+                       "range");
+    // ldm.* writes each element of the group in turn, and every element re-reads
+    // the base for its address, so a base inside the (written) destination group
+    // would be overwritten before a later element reads it.  The ISA allows this
+    // case (addresses use the original base), but the expansion cannot preserve
+    // it.  stm.* only reads its group, so a base inside it is harmless.
+    if (Mnem.starts_with("ldm.") && Base.id() >= First.id() &&
+        Base.id() < First.id() + Count)
+      return Error(IDLoc,
+                   "'-multiple-to-single' cannot expand '" + Mnem.str() +
+                       "': the base register is inside the written destination "
+                       "register range");
+
+    unsigned W = ldmStmElemWidth(Mnem);
+    for (unsigned I = 0; I < Count; ++I) {
+      if (I > 0) {
+        SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> AddOps;
+        AddOps.push_back(DADAOOperand::createToken("add.si", IDLoc));
+        AddOps.push_back(DADAOOperand::createReg(Offset, Loc));
+        AddOps.push_back(DADAOOperand::createImm(W, Loc, Loc));
+        if (emit(AddOps))
+          return true;
+      }
+      SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> SubOps;
+      SubOps.push_back(DADAOOperand::createToken(Mnem, IDLoc));
+      SubOps.push_back(singleRegGroup(MCRegister(First.id() + I), Loc));
+      SubOps.push_back(DADAOOperand::createReg(Base, Loc));
+      SubOps.push_back(DADAOOperand::createReg(Offset, Loc));
+      if (emit(SubOps))
+        return true;
+    }
+
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> RestoreOps;
+    RestoreOps.push_back(DADAOOperand::createToken("add.si", IDLoc));
+    RestoreOps.push_back(DADAOOperand::createReg(Offset, Loc));
+    RestoreOps.push_back(DADAOOperand::createImm(
+        -static_cast<int64_t>(W) * (Count - 1), Loc, Loc));
+    return emit(RestoreOps);
+  }
+
+  // orri block move / FP conversion: Token, {d0:dN-1}, {s0:sN-1}.
+  auto *DstG = static_cast<DADAOOperand *>(Operands[1].get());
+  auto *SrcG = static_cast<DADAOOperand *>(Operands[2].get());
+  MCRegister DstFirst = DstG->getRegList()[0];
+  MCRegister SrcFirst = SrcG->getRegList()[0];
+  unsigned Count = DstG->getGroupCount();
+  SMLoc Loc = DstG->getStartLoc();
+  for (unsigned I = 0; I < Count; ++I) {
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> SubOps;
+    SubOps.push_back(DADAOOperand::createToken(Mnem, IDLoc));
+    SubOps.push_back(singleRegGroup(MCRegister(DstFirst.id() + I), Loc));
+    SubOps.push_back(singleRegGroup(MCRegister(SrcFirst.id() + I), Loc));
+    if (emit(SubOps))
+      return true;
+  }
+  return false;
+}
+
+//===----------------------------------------------------------------------===//
+// matchAndEmitInstruction — decompose complex operands and match.
+//
+// Complex operands (register groups, register pairs, addresses) are decomposed
+// into the flat register/immediate operands that the auto-generated
+// MatchInstructionImpl expects.
+//
+// Decomposition rules:
+//   kRegPair      → push both registers as individual operands
+//   kRegGroupCond → push all registers as individual operands
+//   kRegGroup     → push first register, then count (as last operand)
+//   kAddress      → push base register [and index register], then offset.
+//                   For iiii jump/call (mnemonic "jump"/"call" with exactly
+//                   2 address components), strip the base register since
+//                   iiii format only needs the immediate offset.
+//===----------------------------------------------------------------------===//
+
+bool DADAOAsmParser::matchAndEmitInstruction(SMLoc IDLoc, unsigned &Opcode,
+                                              OperandVector &Operands,
+                                              MCStreamer &Out,
+                                              uint64_t &ErrorInfo,
+                                              bool MatchingInlineAsm) {
+  // Synthetic pseudo-instructions (ADR-0013 D11): expand here into real
+  // hardware instructions before any of the real-instruction checks run.
+  if (Operands.size() >= 1 && Operands[0]->isToken()) {
+    StringRef Mnem = static_cast<DADAOOperand *>(Operands[0].get())->getToken();
+    if (Mnem == "set.rd" || Mnem == "set.rb" || Mnem == "set.ft" ||
+        Mnem == "set.fo")
+      return expandPseudoInstruction(IDLoc, Mnem, Operands, Out, Opcode,
+                                     ErrorInfo, MatchingInlineAsm);
+  }
+
+  // Reject old flat syntax for dual-purpose rrrr instructions.
+  // add.uo rd8, rd9, rd10, rd11 → must use add.uo {rd8, rd9}, rd10, rd11
+  // Only applies to rrrr format (4 operands), not orrr format (3 operands).
+  if (Operands.size() >= 2) {
+    auto *FirstOp = static_cast<DADAOOperand *>(Operands[1].get());
+    if (FirstOp && FirstOp->Kind == DADAOOperand::kRegister) {
+      auto *TokOp = static_cast<DADAOOperand *>(Operands[0].get());
+      if (TokOp && TokOp->isToken()) {
+        StringRef Mnem = TokOp->getToken();
+        // Only reject for rrrr format (5 operands: token + 4 regs)
+        if (Operands.size() == 5 &&
+            (Mnem == "add.uo" || Mnem == "add.so" ||
+             Mnem == "sub.uo" || Mnem == "sub.so" ||
+             Mnem == "mul.uo" || Mnem == "mul.so")) {
+          return Error(Operands[1]->getStartLoc(),
+                       "old syntax not accepted; use '{" "}' for dual-purpose "
+                       "destination registers, e.g., add.uo {rd8, rd9}, rd10, rd11");
+        }
+      }
+    }
+  }
+
+  // Static legality check for mreg_range_overflow (ISS-106 / SPEC-088t;
+  // SimRISC-01 §存取RD寄存器 / §存取RF寄存器 / SimRISC-02 §寄存器组之间块赋值 /
+  // SimRISC-07 §格式转换指令): a `{start:end}` group in a multi-register
+  // instruction may name up to a full bank (64 registers), but the shared immu6
+  // field is only 6 bits (0..63), so `{rd0:rd63}` (M1 RD) and `{rf0:rf63}` (FP)
+  // — both count 64 — would silently truncate to 0 (the illegal `mreg_zero`
+  // encoding).  Reject any group whose element count exceeds 63, for the FP
+  // multi-register mnemonics and for the M1 RD/RB/RA ones (ldm.*/stm.*, shared
+  // ldm.o/stm.o included, plus the orri block moves).  This runs before the
+  // LLVM-029t "group counts differ" hardening below so that the specific
+  // `mreg_range_overflow` rule is reported when both would apply.
+  if (Operands.size() >= 2) {
+    auto *TokOp = static_cast<DADAOOperand *>(Operands[0].get());
+    if (TokOp && TokOp->isToken()) {
+      StringRef Mnem = TokOp->getToken();
+      bool CheckAllGroups = isFPMregMnemonic(Mnem) || isM1MregMnemonic(Mnem);
+      bool CheckRFGroups = Mnem == "ldm.t" || Mnem == "stm.t";
+      if (CheckAllGroups || CheckRFGroups) {
+        for (size_t I = 1; I < Operands.size(); ++I) {
+          auto *G = static_cast<DADAOOperand *>(Operands[I].get());
+          if (!G || G->Kind != DADAOOperand::kRegGroup)
+            continue;
+          if (CheckRFGroups && !isRFRegister(firstRegisterOf(G)))
+            continue;
+          if (G->getGroupCount() > 63)
+            return Error(G->getStartLoc(),
+                         "invalid '" + Mnem.str() +
+                             "': register range too long "
+                             "(mreg_range_overflow); element count must be "
+                             "1..63");
+        }
+      }
+    }
+  }
+
+  // Static legality check for mreg_range_overlap (SPEC-088t;
+  // SimRISC-02 §寄存器组之间块赋值): `rd2rd` and `rb2rb` copy a block of
+  // registers *within the same bank*, so the source range and the destination
+  // range may overlap.  Any intersection (including complete coincidence) makes
+  // the instruction illegal, and the assembler MUST hard-error (Error level,
+  // never a warning).  Cross-bank block moves (ra2rd/rd2ra/rd2rb/rb2rd) and
+  // RD<->RF moves cannot overlap by construction, so they are not checked here.
+  // This runs *before* the complex-operand decomposition below, which keeps
+  // only the first register of each group and would lose the range sizes.
+  if (Operands.size() == 3) {
+    auto *TokOp = static_cast<DADAOOperand *>(Operands[0].get());
+    auto *DstOp = static_cast<DADAOOperand *>(Operands[1].get());
+    auto *SrcOp = static_cast<DADAOOperand *>(Operands[2].get());
+    if (TokOp && TokOp->isToken() && DstOp && SrcOp &&
+        DstOp->Kind == DADAOOperand::kRegGroup &&
+        SrcOp->Kind == DADAOOperand::kRegGroup) {
+      StringRef Mnem = TokOp->getToken();
+      if (Mnem == "rd2rd" || Mnem == "rb2rb") {
+        // {start:end} is contiguous within the bank (see parseRegGroup), so the
+        // half-open interval [start, start+count) intersects [s, s+count2) iff
+        // start < s+count2 && s < start+count.
+        unsigned DstStart = DstOp->getRegList()[0].id();
+        unsigned SrcStart = SrcOp->getRegList()[0].id();
+        unsigned DstEnd = DstStart + DstOp->getGroupCount();
+        unsigned SrcEnd = SrcStart + SrcOp->getGroupCount();
+        if (DstStart < SrcEnd && SrcStart < DstEnd)
+          return Error(DstOp->getStartLoc(),
+                       "invalid '" + Mnem.str() + "': source and destination "
+                       "register ranges overlap (mreg_range_overlap); source "
+                       "and destination must be disjoint");
+      }
+
+      // Hardening for block instructions (LLVM-029t, extended by ISS-104): the
+      // orri conversion / classify / rd2rf / rf2rd forms and the M1
+      // rd2rd/rb2rb/rd2rb/rb2rd/rd2ra/ra2rd forms carry a *single* immu6 that
+      // encodes the element count shared by both `{start:end}` groups.  If the
+      // two written groups have different sizes the instruction is ill-formed,
+      // so reject it with a hard error instead of silently taking one of the
+      // two counts (previously the last group won).
+      if ((isFPBlockMnemonic(Mnem) || Mnem == "rd2rf" || Mnem == "rf2rd" ||
+           isM1BlockMnemonic(Mnem)) &&
+          DstOp->getGroupCount() != SrcOp->getGroupCount())
+        return Error(DstOp->getStartLoc(),
+                     "invalid '" + Mnem.str() + "': source and destination "
+                     "register group counts differ (they share a single immu6 "
+                     "element count)");
+    }
+  }
+
+  // Static legality checks for FP (scope: fp) instructions (SPEC-088t;
+  // contracts/legality_rules.yaml).  All are hard errors (Error level, never a
+  // warning) and run *before* the decomposition below, which keeps only the
+  // first register of each group and would lose the ranges/counts.
+  if (Operands.size() >= 2) {
+    auto *TokOp = static_cast<DADAOOperand *>(Operands[0].get());
+    if (TokOp && TokOp->isToken()) {
+      StringRef Mnem = TokOp->getToken();
+
+      // mreg_range_overlap: the two same-bank RF `{start:end}` groups of a
+      // convert_ff instruction share one immu6 element count and must be
+      // disjoint.  Any intersection (including complete coincidence) is
+      // illegal (SimRISC-07 §格式转换指令; same rule as rd2rd/rb2rb).
+      if (isFPConvertFFMnemonic(Mnem) && Operands.size() == 3) {
+        auto *DstOp = static_cast<DADAOOperand *>(Operands[1].get());
+        auto *SrcOp = static_cast<DADAOOperand *>(Operands[2].get());
+        if (DstOp && SrcOp && DstOp->Kind == DADAOOperand::kRegGroup &&
+            SrcOp->Kind == DADAOOperand::kRegGroup) {
+          // {start:end} is contiguous within the bank (see parseRegGroup), so
+          // [start, start+count) intersects [s, s+count2) iff
+          // start < s+count2 && s < start+count.
+          unsigned DstStart = firstRegisterOf(DstOp).id();
+          unsigned SrcStart = firstRegisterOf(SrcOp).id();
+          unsigned DstEnd = DstStart + DstOp->getGroupCount();
+          unsigned SrcEnd = SrcStart + SrcOp->getGroupCount();
+          if (DstStart < SrcEnd && SrcStart < DstEnd)
+            return Error(DstOp->getStartLoc(),
+                         "invalid '" + Mnem.str() + "': source and destination "
+                         "register ranges overlap (mreg_range_overlap); source "
+                         "and destination must be disjoint");
+        }
+      }
+    }
+  }
+
+  // -multiple-to-single (spec/DADAO-11 §汇编器选项; contract-asm §8): expand a
+  // multi-register instruction into single-register instructions.  The flag is
+  // set by llvm-mc's `-multiple-to-single` (MCTargetOptions; see llvm-mc.cpp)
+  // and read here via getTargetOptions().  Placed after the static checks above
+  // (so illegal ranges/overlaps are still reported on the original) and before
+  // the decomposition below (which keeps only the first register of each
+  // group).  Default off -> behaviour unchanged.
+  if (getTargetOptions().DADAOMultipleToSingle && !Operands.empty() &&
+      Operands[0]->isToken()) {
+    StringRef Mnem = static_cast<DADAOOperand *>(Operands[0].get())->getToken();
+    bool Applies = false;
+    if ((Mnem.starts_with("ldm.") || Mnem.starts_with("stm.")) &&
+        Operands.size() == 4) {
+      auto *G = static_cast<DADAOOperand *>(Operands[1].get());
+      Applies = G->Kind == DADAOOperand::kRegGroup && G->getGroupCount() > 1;
+    } else if (isMultiToSingleOrriMnemonic(Mnem) && Operands.size() == 3) {
+      auto *D = static_cast<DADAOOperand *>(Operands[1].get());
+      auto *S = static_cast<DADAOOperand *>(Operands[2].get());
+      Applies = D->Kind == DADAOOperand::kRegGroup &&
+                S->Kind == DADAOOperand::kRegGroup && D->getGroupCount() > 1;
+    }
+    if (Applies)
+      return expandMultiRegisterInstruction(IDLoc, Mnem, Operands, Out, Opcode,
+                                            ErrorInfo, MatchingInlineAsm);
+  }
+
+  // Decompose complex operands into flat operands.
+  SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> Flat;
+  StringRef Mnemonic;
+  unsigned SavedGroupCount = 0;  // Saved count from kRegGroup operand.
+  SMLoc GroupLoc;
+
+  for (size_t I = 0; I < Operands.size(); ++I) {
+    auto &Op = Operands[I];
+
+    if (Op->isToken()) {
+      Mnemonic = static_cast<DADAOOperand *>(Op.get())->getToken();
+      Flat.push_back(std::move(Operands[I]));
+      continue;
+    }
+
+    auto *DOp = static_cast<DADAOOperand *>(Op.get());
+    switch (DOp->Kind) {
+      case DADAOOperand::kRegPair:
+        // Dual-purpose: {rd8, rd9} → rd8, rd9
+        for (MCRegister R : DOp->getRegList())
+          Flat.push_back(DADAOOperand::createReg(R, DOp->getStartLoc()));
+        break;
+
+      case DADAOOperand::kRegGroupCond:
+        // Condition: {rd8, rd0}? → rd8, rd0
+        for (MCRegister R : DOp->getRegList())
+          Flat.push_back(DADAOOperand::createReg(R, DOp->getStartLoc()));
+        break;
+
+      case DADAOOperand::kRegGroup: {
+        // Range/single: {rd8:rd10} → rd8 (first reg)
+        // Save count for later use (ldm/stm, ra2rd, etc.)
+        SavedGroupCount = DOp->getGroupCount();
+        GroupLoc = DOp->getStartLoc();
+        ArrayRef<MCRegister> RL = DOp->getRegList();
+        if (!RL.empty())
+          Flat.push_back(DADAOOperand::createReg(RL[0], DOp->getStartLoc()));
+        break;
+      }
+
+      case DADAOOperand::kAddress: {
+        // Address: [base, offset] → base, offset
+        //          [base, index, offset] → base, index, offset
+        MCRegister Base = DOp->getAddrBase();
+        MCRegister Index = DOp->getAddrIndex();
+
+        // Push base register (may be stripped later for iiii jumps).
+        Flat.push_back(DADAOOperand::createReg(Base, DOp->getStartLoc()));
+
+        // Push index register if present.
+        if (Index.isValid())
+          Flat.push_back(DADAOOperand::createReg(Index, DOp->getStartLoc()));
+
+        // Push offset.
+        if (DOp->getAddrOffsetExpr())
+          Flat.push_back(DADAOOperand::createImmExpr(
+              DOp->getAddrOffsetExpr(), DOp->getStartLoc(), DOp->getEndLoc()));
+        else
+          Flat.push_back(DADAOOperand::createImm(
+              DOp->getAddrOffset(), DOp->getStartLoc(), DOp->getEndLoc()));
+        break;
+      }
+
+      default:
+        Flat.push_back(std::move(Operands[I]));
+        break;
+      }
+  }
+
+  // For iiii jump/call: [rb0, imm] → only push imm (strip base register).
+  // The mnemonic is "jump" or "call" and we have exactly 3 flat operands:
+  // Token, Reg(base), Imm(offset). Strip the base register.
+  // Note: br.* instructions are handled separately in parseInstruction.
+  if ((Mnemonic == "jump" || Mnemonic == "call") && Flat.size() == 3 &&
+      Flat[1]->isReg() && Flat[2]->isImm()) {
+    SmallVector<std::unique_ptr<MCParsedAsmOperand>, 8> Iiii;
+    Iiii.push_back(std::move(Flat[0])); // Token
+    Iiii.push_back(std::move(Flat[2])); // Imm (offset)
+    Flat = std::move(Iiii);
+  }
+
+  // For rrii jump/call: [rb, rd, imm] → keep all (base is in encoding).
+  // After decomposition: Token, rb(base), rd(offset_reg), imm(offset).
+  // These are already in the correct order for rrii matching.
+
+  // For rrri ldm/stm and orri block (ra2rd, etc.):
+  // Append the saved group count as the last operand.
+  if (SavedGroupCount > 0 &&
+      (Mnemonic.starts_with("ldm.") || Mnemonic.starts_with("stm.") ||
+       Mnemonic == "ra2rd" || Mnemonic == "rb2rb" || Mnemonic == "rb2rd" ||
+       Mnemonic == "rd2ra" || Mnemonic == "rd2rb" || Mnemonic == "rd2rd" ||
+       Mnemonic == "rd2rf" || Mnemonic == "rf2rd" ||
+       isFPBlockMnemonic(Mnemonic))) {
+    Flat.push_back(DADAOOperand::createImm(SavedGroupCount, GroupLoc, GroupLoc));
+  }
+
+  // For rrii memory: ld.ub rd, [rb, imm] → rd, rb, imm (already flat).
+  // For rrii jump: jump [rb, rd, imm] → Token, rb, rd, imm (already flat).
+  // These are handled by the general decomposition above.
+
+  // For iiii jump/call with expression offset: bypass auto-generated matcher.
+  // The matcher's converter loses the ImmExpr pointer during operand movement.
+  if ((Mnemonic == "jump" || Mnemonic == "call") && Flat.size() == 2 &&
+      Flat[1]->isImm()) {
+    auto *DOp = static_cast<DADAOOperand *>(Flat[1].get());
+    if (DOp->getImmExpr()) {
+      unsigned Opcode = (Mnemonic == "jump") ? DADAO::jump_iiii : DADAO::call_iiii;
+      MCInst Inst;
+      Inst.setOpcode(Opcode);
+      Inst.addOperand(MCOperand::createExpr(DOp->getImmExpr()));
+      Out.emitInstruction(Inst, getSTI());
+      return false;
+    }
+    int64_t ByteOff = DOp->getImm();
+    if (ByteOff % 4 != 0)
+      return Error(Flat[1]->getStartLoc(),
+                   "jump/call offset must be a multiple of 4 bytes");
+    int64_t Encoded = ByteOff >> 2;
+    if (Encoded < -8388608 || Encoded > 8388607)
+      return Error(Flat[1]->getStartLoc(),
+                   "jump/call offset out of range");
+    Flat[1] = DADAOOperand::createImm(Encoded, Flat[1]->getStartLoc(),
+                                       Flat[1]->getEndLoc());
+  }
+
+  // For riii br.* with expression offset: bypass matcher.  Unlike the numeric
+  // offset path (which funnels through MatchInstructionImpl and is therefore
+  // bank-aware), this bypass builds the MCInst directly and must pick the
+  // variant itself: `br.z`/`br.nz` have both an RD (GPRD) and an RB (GPRB)
+  // variant, while `br.n`/`br.nn`/`br.p`/`br.np` only have the RD variant.
+  // Selecting purely from the mnemonic silently mis-encodes `br.z {rbN}?` /
+  // `br.nz {rbN}?` as the RD variant (op 0x6A/0x6B) even though the operand is
+  // a base register; the hardware then tests the wrong bank.
+  if (Mnemonic.starts_with("br.") && Flat.size() == 3 && Flat[2]->isImm()) {
+    auto *DOp = static_cast<DADAOOperand *>(Flat[2].get());
+    if (DOp->getImmExpr()) {
+      MCRegister Reg = static_cast<DADAOOperand *>(Flat[1].get())->getReg();
+      const MCRegisterInfo *RI = getContext().getRegisterInfo();
+      bool IsGPRB = RI->getRegClass(DADAO::GPRBRegClassID).contains(Reg);
+      bool IsGPRD = RI->getRegClass(DADAO::GPRDRegClassID).contains(Reg);
+
+      // Map mnemonic + operand bank to opcode.  0 means "no variant accepts
+      // this operand", mirroring the matcher's rejection of e.g. an RF/RA
+      // operand or an RB operand on a single-variant branch.
+      unsigned Opcode;
+      if (Mnemonic == "br.z")
+        Opcode = IsGPRB ? DADAO::br_z_rb : (IsGPRD ? DADAO::br_z_rd : 0);
+      else if (Mnemonic == "br.nz")
+        Opcode = IsGPRB ? DADAO::br_nz_rb : (IsGPRD ? DADAO::br_nz_rd : 0);
+      else if (Mnemonic == "br.n")
+        Opcode = IsGPRD ? DADAO::br_n_rd : 0;
+      else if (Mnemonic == "br.nn")
+        Opcode = IsGPRD ? DADAO::br_nn_rd : 0;
+      else if (Mnemonic == "br.p")
+        Opcode = IsGPRD ? DADAO::br_p_rd : 0;
+      else if (Mnemonic == "br.np")
+        Opcode = IsGPRD ? DADAO::br_np_rd : 0;
+      else
+        return Error(IDLoc, "unrecognized branch mnemonic");
+      if (Opcode == 0)
+        return Error(Flat[1]->getStartLoc(),
+                     "invalid operand for '" + Mnemonic.str() + "'");
+
+      MCInst Inst;
+      Inst.setOpcode(Opcode);
+      Inst.addOperand(MCOperand::createReg(Reg));
+      Inst.addOperand(MCOperand::createExpr(DOp->getImmExpr()));
+      Out.emitInstruction(Inst, getSTI());
+      return false;
+    }
+    int64_t ByteOff = DOp->getImm();
+    if (ByteOff % 4 != 0)
+      return Error(Flat[2]->getStartLoc(),
+                   "branch offset must be a multiple of 4 bytes");
+    int64_t Encoded = ByteOff >> 2;
+    if (Encoded < -131072 || Encoded > 131071)
+      return Error(Flat[2]->getStartLoc(),
+                   "branch offset out of range");
+    Flat[2] = DADAOOperand::createImm(Encoded, Flat[2]->getStartLoc(),
+                                       Flat[2]->getEndLoc());
+  }
+
+  // For rrii br.*/jump/call with expression offset: bypass matcher.
+  if ((Mnemonic == "jump" || Mnemonic == "call" ||
+       Mnemonic.starts_with("br.")) && Flat.size() == 4 && Flat[3]->isImm()) {
+    auto *DOp = static_cast<DADAOOperand *>(Flat[3].get());
+    if (DOp->getImmExpr()) {
+      unsigned Opcode;
+      if (Mnemonic == "jump") Opcode = DADAO::jump_rrii;
+      else if (Mnemonic == "call") Opcode = DADAO::call_rrii;
+      else if (Mnemonic == "br.eq") Opcode = DADAO::br_eq_rd;
+      else if (Mnemonic == "br.ne") Opcode = DADAO::br_ne_rd;
+      else return Error(IDLoc, "unrecognized branch/jump mnemonic");
+      MCInst Inst;
+      Inst.setOpcode(Opcode);
+      Inst.addOperand(MCOperand::createReg(
+          static_cast<DADAOOperand *>(Flat[1].get())->getReg()));
+      Inst.addOperand(MCOperand::createReg(
+          static_cast<DADAOOperand *>(Flat[2].get())->getReg()));
+      Inst.addOperand(MCOperand::createExpr(DOp->getImmExpr()));
+      Out.emitInstruction(Inst, getSTI());
+      return false;
+    }
+    int64_t ByteOff = DOp->getImm();
+    if (ByteOff % 4 != 0)
+      return Error(Flat[3]->getStartLoc(),
+                   "branch/jump offset must be a multiple of 4 bytes");
+    int64_t Encoded = ByteOff >> 2;
+    if (Encoded < -2048 || Encoded > 2047)
+      return Error(Flat[3]->getStartLoc(),
+                   "branch/jump offset out of range");
+    Flat[3] = DADAOOperand::createImm(Encoded, Flat[3]->getStartLoc(),
+                                       Flat[3]->getEndLoc());
+  }
+
+  // Static legality checks for FP instructions (SPEC-088t): `dst_rf0` (rf0 is
+  // the FCSR and cannot be an FP destination; rf0 as a source is legal) and
+  // `encode_fp_root_n` (ftroot/foroot only support n == 2).  Operand positions
+  // follow the assembly operand order:
+  //   scalar orrr / orri convert / root : destination = Flat[1];
+  //   cs.n/cs.z/cs.p (one condition reg) : destination = Flat[2];
+  //   cs.eq/cs.ne (two condition regs)   : destination = Flat[3].
+  if (isFPDstRfMnemonic(Mnemonic) && Flat.size() >= 2 && Flat[1]->isReg() &&
+      Flat[1]->getReg() == DADAO::rf0)
+    return Error(Flat[1]->getStartLoc(),
+                 "invalid '" + Mnemonic.str() +
+                     "': rf0 is the FCSR and cannot be a floating-point "
+                     "destination (dst_rf0)");
+
+  if ((Mnemonic == "cs.n" || Mnemonic == "cs.z" || Mnemonic == "cs.p") &&
+      Flat.size() >= 3 && Flat[2]->isReg() && Flat[2]->getReg() == DADAO::rf0)
+    return Error(Flat[2]->getStartLoc(),
+                 "invalid '" + Mnemonic.str() +
+                     "': rf0 is the FCSR and cannot be a floating-point "
+                     "destination (dst_rf0)");
+
+  if ((Mnemonic == "cs.eq" || Mnemonic == "cs.ne") && Flat.size() >= 4 &&
+      Flat[3]->isReg() && Flat[3]->getReg() == DADAO::rf0)
+    return Error(Flat[3]->getStartLoc(),
+                 "invalid '" + Mnemonic.str() +
+                     "': rf0 is the FCSR and cannot be a floating-point "
+                     "destination (dst_rf0)");
+
+  // `dst_rd0` (SPEC-089t): the FP rd-destination forms (convert_f2i 8,
+  // classify 2, compare 4, rf2rd 1) must not write rd0 (the hard-wired zero
+  // register).  The destination start register is Flat[1] for both the orri
+  // group forms and the orrr single-destination compare (see decomposition).
+  if (isFPDstRdMnemonic(Mnemonic) && Flat.size() >= 2 && Flat[1]->isReg() &&
+      Flat[1]->getReg() == DADAO::rd0)
+    return Error(Flat[1]->getStartLoc(),
+                 "invalid '" + Mnemonic.str() +
+                     "': rd0 is the hard-wired zero register and cannot be a "
+                     "destination (dst_rd0)");
+
+  if ((Mnemonic == "ftroot" || Mnemonic == "foroot") && Flat.size() >= 4 &&
+      Flat[3]->isImm()) {
+    // A non-constant operand (symbol/relocation) is also Kind == kImmediate
+    // (see createImmExpr) and cannot be proven to be 2, so it is rejected too.
+    auto *NOp = static_cast<DADAOOperand *>(Flat[3].get());
+    if (NOp->getImmExpr() != nullptr || NOp->getImm() != 2)
+      return Error(Flat[3]->getStartLoc(),
+                   "invalid '" + Mnemonic.str() +
+                       "': root order n must be the constant 2 "
+                       "(encode_fp_root_n)");
+  }
+
+  // Static legality check for `ret` (SPEC-083t; SimRISC-06 §函数返回):
+  // `ret rdHA, imms18` with rdHA == rd0 requires imms18 == 0; otherwise the
+  // instruction is illegal.  This is a static (assemble-time) rule and MUST be
+  // a hard error (Error level), never a warning.  Applies to `ret` only.
+  // A non-constant operand (symbol/relocation) cannot be proven to be 0, so it
+  // is rejected as well (otherwise the illegal encoding would silently reach
+  // the linker).
+  if (Mnemonic == "ret" && Flat.size() == 3 && Flat[1]->isReg()) {
+    MCRegister RdHA = Flat[1]->getReg();
+    if (RdHA == DADAO::rd0) {
+      // Note: a symbol/relocatable operand is also Kind == kImmediate (see
+      // createImmExpr), so it is distinguished by a non-null ImmExpr.
+      auto *ImmOp = static_cast<DADAOOperand *>(Flat[2].get());
+      bool IsZero = Flat[2]->isImm() && ImmOp->getImmExpr() == nullptr &&
+                    ImmOp->getImm() == 0;
+      if (!IsZero)
+        return Error(Flat[2]->getStartLoc(),
+                     "invalid 'ret': rdHA is rd0, so imms18 must be the "
+                     "constant 0 (use 'ret rd0, 0')");
+    }
+  }
+
+  MCInst Inst;
+  unsigned MatchResult =
+      MatchInstructionImpl(Flat, Inst, ErrorInfo, MatchingInlineAsm);
+
+  switch (MatchResult) {
+  case Match_Success:
+    Out.emitInstruction(Inst, getSTI());
+    return false;
+  case Match_MissingFeature:
+    return Error(IDLoc, "instruction requires a CPU feature not present");
+  case Match_MnemonicFail:
+    return Error(IDLoc, "unrecognized instruction mnemonic");
+  case Match_InvalidOperand: {
+    SMLoc ErrorLoc = IDLoc;
+    if (ErrorInfo < Flat.size())
+      ErrorLoc = Flat[ErrorInfo]->getStartLoc();
+    return Error(ErrorLoc, "invalid operand for instruction");
+  }
+  case Match_InvalidTiedOperand:
+    return Error(IDLoc, "invalid tied operand");
+  default:
+    return Error(IDLoc, "unknown assembly matching error");
+  }
+}
+
+} // end anonymous namespace
+
+extern "C" LLVM_EXTERNAL_VISIBILITY void LLVMInitializeDADAOAsmParser() {
+  RegisterMCAsmParser<DADAOAsmParser> X(getTheDadaoTarget());
+}
