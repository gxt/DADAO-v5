+//===----------------------------------------------------------------------===//
+// DADAOOperand — represents a parsed assembly operand.
+//
+// In addition to the basic kinds (token, register, immediate), we add:
+//   kRegGroup     — {rd8:rd11} or {rd8} (decomposed to flat operands)
+//   kRegGroupCond — {rd8, rd0}? or {rd3}? (condition marker)
+//   kRegPair      — {rd8, rd9} (dual-purpose, no ?)
+//   kAddress      — [rb2, 1] or [rb0, 16] or [rb3, rd0, 64]
+//
+// At matchAndEmitInstruction time, complex operands are decomposed into
+// the flat register/immediate operands expected by the auto-generated
+// AsmMatcher (MatchInstructionImpl).
+//===----------------------------------------------------------------------===//
+
+class DADAOOperand : public MCParsedAsmOperand {
+public:
+  enum KindTy {
+    kToken,
+    kRegister,
+    kImmediate,
+    kRegGroup,      // {start:end} or {single}
+    kRegGroupCond,  // {...}?
+    kRegPair,       // {rd, rd} (no ?)
+    kAddress        // [base, offset] or [base, reg, offset]
+  } Kind;
+
+private:
+  SMLoc StartLoc, EndLoc;
+  StringRef Tok;
+  MCRegister RegNo;
+  int64_t ImmVal;
+  const MCExpr *ImmExpr;
+
+  // For kRegGroup / kRegGroupCond / kRegPair: list of registers.
+  SmallVector<MCRegister, 4> RegList;
+  // For kRegGroup: count (range size) — computed from start:end.
+  unsigned GroupCount;
+  // For kAddress: base register, optional index register, offset.
+  MCRegister AddrBase;
+  MCRegister AddrIndex; // 0 if not present
+  int64_t AddrOffset;
+  const MCExpr *AddrOffsetExpr;
+
+public:
+  DADAOOperand(KindTy K)
+      : Kind(K), ImmVal(0), ImmExpr(nullptr), GroupCount(0),
+        AddrOffset(0), AddrOffsetExpr(nullptr) {}
+
+  // Factory methods for basic kinds.
+  static std::unique_ptr<DADAOOperand> createToken(StringRef T, SMLoc L) {
+    auto Op = std::make_unique<DADAOOperand>(kToken);
+    Op->Tok = T;
+    Op->StartLoc = L;
+    Op->EndLoc = SMLoc::getFromPointer(L.getPointer() + T.size());
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand> createReg(MCRegister Reg, SMLoc L) {
+    auto Op = std::make_unique<DADAOOperand>(kRegister);
+    Op->RegNo = Reg;
+    Op->StartLoc = L;
+    Op->EndLoc = L;
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand> createImm(int64_t Val, SMLoc L,
+                                                  SMLoc E) {
+    auto Op = std::make_unique<DADAOOperand>(kImmediate);
+    Op->ImmVal = Val;
+    Op->StartLoc = L;
+    Op->EndLoc = E;
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand> createImmExpr(const MCExpr *E, SMLoc L,
+                                                      SMLoc EL) {
+    auto Op = std::make_unique<DADAOOperand>(kImmediate);
+    Op->ImmExpr = E;
+    Op->ImmVal = 0;
+    Op->StartLoc = L;
+    Op->EndLoc = EL;
+    return Op;
+  }
+
+  // Factory for register group: {start:end} or {single}.
+  static std::unique_ptr<DADAOOperand>
+  createRegGroup(SmallVectorImpl<MCRegister> &Regs, unsigned Count,
+                 SMLoc Start, SMLoc End) {
+    auto Op = std::make_unique<DADAOOperand>(kRegGroup);
+    Op->RegList.assign(Regs.begin(), Regs.end());
+    Op->GroupCount = Count;
+    Op->StartLoc = Start;
+    Op->EndLoc = End;
+    return Op;
+  }
+
+  // Factory for condition register group: {...}?.
+  static std::unique_ptr<DADAOOperand>
+  createRegGroupCond(SmallVectorImpl<MCRegister> &Regs, SMLoc Start,
+                     SMLoc End) {
+    auto Op = std::make_unique<DADAOOperand>(kRegGroupCond);
+    Op->RegList.assign(Regs.begin(), Regs.end());
+    Op->StartLoc = Start;
+    Op->EndLoc = End;
+    return Op;
+  }
+
+  // Factory for register pair: {rd, rd} (no ?).
+  static std::unique_ptr<DADAOOperand>
+  createRegPair(MCRegister R1, MCRegister R2, SMLoc Start, SMLoc End) {
+    auto Op = std::make_unique<DADAOOperand>(kRegPair);
+    Op->RegList.push_back(R1);
+    Op->RegList.push_back(R2);
+    Op->StartLoc = Start;
+    Op->EndLoc = End;
+    return Op;
+  }
+
+  // Factory for address expression: [base, offset] or [base, reg, offset].
+  static std::unique_ptr<DADAOOperand>
+  createAddress(MCRegister Base, MCRegister Index, int64_t Offset,
+                SMLoc Start, SMLoc End) {
+    auto Op = std::make_unique<DADAOOperand>(kAddress);
+    Op->AddrBase = Base;
+    Op->AddrIndex = Index;
+    Op->AddrOffset = Offset;
+    Op->StartLoc = Start;
+    Op->EndLoc = End;
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand>
+  createAddress(MCRegister Base, MCRegister Index, const MCExpr *OffsetExpr,
+                SMLoc Start, SMLoc End) {
+    auto Op = std::make_unique<DADAOOperand>(kAddress);
+    Op->AddrBase = Base;
+    Op->AddrIndex = Index;
+    Op->AddrOffsetExpr = OffsetExpr;
+    Op->AddrOffset = 0;
+    Op->StartLoc = Start;
+    Op->EndLoc = End;
+    return Op;
+  }
+
+  // Accessors.
+  StringRef getToken() const { return Tok; }
+  MCRegister getReg() const override { return RegNo; }
+  int64_t getImm() const { return ImmVal; }
+  const MCExpr *getImmExpr() const { return ImmExpr; }
+  ArrayRef<MCRegister> getRegList() const { return RegList; }
+  unsigned getGroupCount() const { return GroupCount; }
+  MCRegister getAddrBase() const { return AddrBase; }
+  MCRegister getAddrIndex() const { return AddrIndex; }
+  int64_t getAddrOffset() const { return AddrOffset; }
+  const MCExpr *getAddrOffsetExpr() const { return AddrOffsetExpr; }
+
+  // MCParsedAsmOperand interface.
+  bool isToken() const override { return Kind == kToken; }
+  bool isReg() const override { return Kind == kRegister; }
+  bool isImm() const override { return Kind == kImmediate; }
+  bool isMem() const override { return false; }
+
+  SMLoc getStartLoc() const override { return StartLoc; }
+  SMLoc getEndLoc() const override { return EndLoc; }
+
+  void addRegOperands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    Inst.addOperand(MCOperand::createReg(getReg()));
+  }
+
+  void addImmOperands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    if (ImmExpr) {
+      Inst.addOperand(MCOperand::createExpr(ImmExpr));
+    } else {
+      Inst.addOperand(MCOperand::createImm(getImm()));
+    }
+  }
+
+  void print(raw_ostream &OS, const MCAsmInfo &) const override {
+    switch (Kind) {
+    case kToken:       OS << "Token:" << Tok; break;
+    case kRegister:    OS << "Reg:" << RegNo; break;
+    case kImmediate:   if (ImmExpr) OS << "ImmExpr"; else OS << "Imm:" << ImmVal; break;
+    case kRegGroup:    OS << "RegGroup:" << RegList.size(); break;
+    case kRegGroupCond: OS << "RegGroupCond:" << RegList.size(); break;
+    case kRegPair:     OS << "RegPair"; break;
+    case kAddress:     OS << "Address"; break;
+    }
+  }
+
+  // Predicate for wyde-position: immediate in range [0, 3].
+  bool isWydePosImm() const {
+    if (Kind != kImmediate)
+      return false;
+    if (ImmExpr)
+      return false;
+    return ImmVal >= 0 && ImmVal <= 3;
+  }
+};
+
+//===----------------------------------------------------------------------===//
+// DADAOAsmParser
+//===----------------------------------------------------------------------===//
+
+class DADAOAsmParser : public MCTargetAsmParser {
+public:
+  DADAOAsmParser(const MCSubtargetInfo &STI, MCAsmParser &Parser,
+                 const MCInstrInfo &MII)
+      : MCTargetAsmParser(STI, MII) {
+    setAvailableFeatures(FeatureBitset());
+  }
+
+#define GET_ASSEMBLER_HEADER
+#include "DADAOGenAsmMatcher.inc"
+
+  enum {
+#define GET_OPERAND_DIAGNOSTIC_TYPES
+#include "DADAOGenAsmMatcher.inc"
+  };
+
+  // MCTargetAsmParser interface.
+  bool parseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                     SMLoc &EndLoc) override;
+  ParseStatus tryParseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                                SMLoc &EndLoc) override;
+
+  bool parseInstruction(ParseInstructionInfo &Info, StringRef Name,
+                        SMLoc NameLoc, OperandVector &Operands) override;
+
+  bool matchAndEmitInstruction(SMLoc IDLoc, unsigned &Opcode,
+                                OperandVector &Operands, MCStreamer &Out,
+                                uint64_t &ErrorInfo,
+                                bool MatchingInlineAsm) override;
+
+private:
+  ParseStatus parseRegisterImpl(MCRegister &Reg, SMLoc &StartLoc,
+                                 SMLoc &EndLoc);
+  bool parseOperand(OperandVector &Operands);
+  bool parseImmediate(OperandVector &Operands);
+  bool parseWydePosToken(OperandVector &Operands);
+  bool parseRegGroup(OperandVector &Operands);
+  bool parseAddressExpr(OperandVector &Operands);
+  static unsigned matchRegisterName(StringRef Name);
+  static bool isRegBankPrefix(StringRef Name);
+};
