+//
+// New assembly syntax (assembly-language.md):
+//   Register groups: {rd8}, {rd8:rd11}, {rd8, rd9}, {rd8, rd0}?
+//   Address expressions: [rb2, 1], [rb0, 16], [rb3, rd0, 64]
+//   Address immediates are byte offsets (no unit suffix); must be %4==0
+//   Condition marker '?': after }
