+//===-- DADAOCallingConv.td - DADAO Calling Conventions ---*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DADAO M3 scalar calling convention (contract-abi.md §4, ADR-0018 C4/C5/C6):
+//
+//   - Integer/scalar arguments -> rd16..rd31; pointer/address arguments ->
+//     rb16..rb31.  The two banks are counted *independently* starting at 16
+//     (contract-abi.md §4.1); there is no shared slot numbering.
+//   - DADAO is a 64-bit target, so both integers and pointers are legalized
+//     to the same MVT (i64).  CCIfPtr checks ArgFlags.isPointer() (set by
+//     SelectionDAGBuilder from the original IR type) rather than the value
+//     type (ADR-0018 C2 D2); this is how the pointer/integer split is made.
+//   - The CCIfPtr rules MUST precede the CCIfType<[i64]> rules: CCState
+//     evaluates top-to-bottom and stops at the first matching predicate, so
+//     a pointer (VT == i64) would otherwise match the integer rule first.
+//   - Narrow (<8B) scalars are promoted to 8B (contract-abi.md §4.2); the
+//     caller materializes the sign/zero extension (C4 D2).
+//   - The overflow area is a single shared stack area ordered by global
+//     declaration sequence (C4 D1): CCAssignToStack shares one monotonically
+//     increasing byte offset across all rules in the same CCState, so the
+//     pointer and integer stack rules naturally interleave in argument order.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// Argument / call calling convention (CC_DADAO)
+//===----------------------------------------------------------------------===//
+
+def CC_DADAO : CallingConv<[
+  // Hidden sret pointer (M6, contract-abi.md §6.1): the first address
+  // argument, passed in rb16; subsequent address arguments start at rb17
+  // (the later CCIfPtr rule skips the already-allocated rb16).  It must be
+  // listed first and use CCIfSRet (not CCIfPtr): the callee-side sret
+  // argument synthesized by SelectionDAGBuilder carries only the "sret"
+  // flag, not "pointer", so CCIfPtr would miss it and it would fall into the
+  // integer bank.
+  CCIfSRet<CCIfType<[i64], CCAssignToReg<[rb16]>>>,
+
+  // Promote i8/i16/i32 arguments to i64 (contract-abi.md §4.2).
+  CCIfType<[i8, i16, i32], CCPromoteToType<i64>>,
+
+  // Floating-point arguments -> RF bank (rf16..rf31), independent count
+  // (contract-abi.md §4.1/§6.4; M6, LLVM-066t).  HFA elements (all f32 or all
+  // f64, <= 8 of them) flatten to individual floating-point scalars upstream,
+  // so each element is assigned one RF slot here, starting at rf16.
+  CCIfType<[f32, f64], CCAssignToReg<[rf16, rf17, rf18, rf19, rf20, rf21,
+                                       rf22, rf23, rf24, rf25, rf26, rf27,
+                                       rf28, rf29, rf30, rf31]>>,
+  CCIfType<[f32, f64], CCAssignToStack<8, 8>>,
+
+  // Pointer/address arguments -> RB bank (rb16..rb31), independent count.
+  // byval (>64B aggregate passed indirectly, contract-abi.md §6.4) is a
+  // pointer argument and is routed here too.
+  CCIfPtr<CCAssignToReg<[rb16, rb17, rb18, rb19, rb20, rb21, rb22, rb23,
+                         rb24, rb25, rb26, rb27, rb28, rb29, rb30, rb31]>>,
+  CCIfPtr<CCAssignToStack<8, 8>>,
+
+  // Integer/scalar arguments -> RD bank (rd16..rd31), independent count.
+  CCIfType<[i64], CCAssignToReg<[rd16, rd17, rd18, rd19, rd20, rd21, rd22,
+                                 rd23, rd24, rd25, rd26, rd27, rd28, rd29,
+                                 rd30, rd31]>>,
+  CCIfType<[i64], CCAssignToStack<8, 8>>,
+]>;
+
+//===----------------------------------------------------------------------===//
+// Return-value calling convention (RetCC_DADAO)
+//===----------------------------------------------------------------------===//
+
+def RetCC_DADAO : CallingConv<[
+  // Narrow returns are canonicalized by the callee (contract-abi.md §4.4, C5).
+  CCIfType<[i8, i16, i32], CCPromoteToType<i64>>,
+
+  // Floating-point return -> rf8..rf15 (M6, contract-abi.md §4.4/§6.1).  The
+  // first FP return lands in rf8, the next in rf9, ...; HFA results likewise.
+  CCIfType<[f32, f64], CCAssignToReg<[rf8, rf9, rf10, rf11, rf12, rf13, rf14,
+                                       rf15]>>,
+
+  // Pointer return -> rb8..rb15 (M6, contract-abi.md §6.1): the first pointer
+  // return lands in rb8, the next in rb9, ...  Each bank is counted
+  // independently; exceeding 8 in any bank is handled by CanLowerReturn, which
+  // demotes the whole return to an sret pointer.  There is deliberately NO
+  // stack fallback here, so an exhausted bank leaves the value unassigned
+  // (CanLowerReturn / CheckReturn then reports "cannot lower return").
+  CCIfPtr<CCAssignToReg<[rb8, rb9, rb10, rb11, rb12, rb13, rb14, rb15]>>,
+
+  // Integer/scalar return -> rd8..rd15 (M6, contract-abi.md §6.1).
+  CCIfType<[i64], CCAssignToReg<[rd8, rd9, rd10, rd11, rd12, rd13, rd14,
+                                 rd15]>>,
+]>;
+
+//===----------------------------------------------------------------------===//
+// Callee-saved registers / call-preserved mask
+//
+// CSR = rd32..rd63 ∪ rb32..rb63 ∪ rf32..rf63 (contract-abi.md §4.5, C6;
+// RF 口径 M6/LLVM-066t).  rb63 is included:
+// it is ALWAYS callee-saved — as FP when hasFP (saved to its own dedicated
+// slot, st.o rb63, [sp, -8]), otherwise as an ordinary general callee-saved
+// register.  SP (rb1) is NOT part of the generic CSR (it is maintained
+// symmetrically by the prologue/epilogue).  The caller-saved set
+// (rd4–rd31 / rb4–rb31) is the complement of the preserved mask plus the
+// non-allocatable registers.
+// The generated `CSR_SaveList` feeds DADAORegisterInfo::getCalleeSavedRegs and
+// `CSR_RegMask` feeds getCallPreservedMask (which must include rb32..rb63,
+// else GPRB callee-saved values get silently clobbered across calls — ML-004c,
+// ADR-0018 C16).
+//
+// NB (contract-isa.md §15.1, rule `mreg_range_overflow`): an `ldm.*`/`stm.*`
+// batch range must satisfy `start + immu6 <= 64`.  Many of these CSR registers
+// may be saved with one `stm.o`; rb63 is the highest RB number, so it may only
+// be the range END (or a singleton) — never the start of a multi-register
+// range ({rb32..rb63}, start 32 + immu6 32 = 64, is legal).  DADAOFrameLowering
+// keeps this rule (see emitCalleeSavedRegs).
+//===----------------------------------------------------------------------===//
+
+def CSR : CalleeSavedRegs<(add (sequence "rd%u", 32, 63),
+                               (sequence "rb%u", 32, 63),
+                               (sequence "rf%u", 32, 63))>;
