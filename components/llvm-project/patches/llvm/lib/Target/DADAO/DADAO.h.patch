+//===----------------------------------------------------------------------===//
+// DADAO instruction format kinds.
+// Encoded in TSFlags bits [3:0] of each instruction definition.
+// Used by printer and disassembler to select the correct output syntax.
+//===----------------------------------------------------------------------===//
+
+namespace llvm {
+namespace DADAO {
+
+/// True when `-dadao-disable-ldm-stm` turned every multi-register transfer
+/// (`ldm`/`stm`) off: the callee-saved batching in DADAOFrameLowering and the
+/// post-RA load/store merge both consult this single switch (LLVM-129t).
+bool ldmStmDisabled();
+
+//===----------------------------------------------------------------------===//
+// Target flags carried on a symbol operand (LLVM-094t; ADR-0029 for the pair).
+//===----------------------------------------------------------------------===//
+
+enum TargetFlags : unsigned {
+  MO_NO_FLAG = 0,
+  // The operand denotes the *GOT slot* of the symbol rather than the symbol
+  // itself: position-independent code (-fPIC / -fPIE) loads the slot with a
+  // PC-relative access and the slot's 8-byte data field is fixed up at load
+  // time, so no link-time absolute address ever reaches the instruction stream
+  // and no global-pointer register is reserved (contract-dynlink.md §3,
+  // ADR-0026 D5).  The AsmPrinter defines one slot per referenced symbol in
+  // `.got`; the access is recorded as R_DADAO_REL12 (before ADR-0029) or as the
+  // PC-relative hi/lo pair R_DADAO_PCREL_HI/_LO (since ADR-0029 D4: the pair is
+  // what reaches ±512 MiB instead of the ±2 KiB of a bare `[rb0, slot]`).
+  MO_GOT_ADDR = 1,
+  // The operand is the *pairing site* of the low half of a PC-relative hi/lo
+  // address formation, not a data target: it is an MO_MCSymbol naming the
+  // temporary label emitted in front of the paired `aip.si` (ADR-0029 D2, the
+  // RISC-V `%pcrel_lo(label)` form).  DADAOMCInstLower wraps it in the
+  // `%pcrel_lo(...)` specifier so the emitter selects R_DADAO_PCREL_LO and the
+  // record's symbol+addend locate the high instruction (contract-elf.md §3.1).
+  // Created by DADAOInstrInfo::expandPostRAPseudo together with the label.
+  MO_PCREL_LO = 2,
+
+  // TLS slot kinds (LLVM-117t; contract-dynlink.md §4.3/§7).  The operand still
+  // denotes the *slot* (MO_GOT_ADDR is set as well); these bits select what the
+  // slot's 8-byte data field carries and hence which R_DADAO_TLS_* relocation
+  // the ELF writer records:
+  //   MO_TLS_TPREL -- `%tls_tprel(sym)`: TPOFF(sym) + A (type 12).  Used by the
+  //     initial-exec model, where the offset from TP is loaded from the slot
+  //     and added to rb3.
+  //   MO_TLS_GD -- the operand is the *address* of the two-word `tls_index`
+  //     pair {DTPMOD, DTPREL} this module needs for the global-dynamic model:
+  //     the printer emits the pair (types 10 and 11) plus one 8-byte pointer
+  //     slot holding the pair's address, and the instruction loads that pointer
+  //     (one PC-relative hi/lo pair) to pass it to __tls_get_addr.
+  MO_TLS_TPREL = 4,
+  MO_TLS_GD = 8,
+};
+
+enum FormatKind : uint8_t {
+  FK_rrrr = 0,  // four registers: add.uo, cs.n, cs.eq, ...
+  FK_rrri = 1,  // three regs + imm6: ldm.*, stm.*
+  FK_rrii = 2,  // two regs + imm12: ld.*, st.*, br.eq, br.ne, jump-rrii
+  FK_riii = 3,  // one reg + imm18: add.si, br.*, ret
+  FK_iiii = 4,  // imm24 only: jump-iiii, call-iiii
+  FK_rwii = 5,  // reg + wydepos + imm16: set.zw, or.w, ...
+  FK_orrr = 6,  // opx + three regs: and.o, or.o, ...
+  FK_orri = 7,  // opx + two regs + imm6: ext.*, shr.*, ra2rd, ...
+  FK_oiii = 8,  // opx + imm18: fence, swym
+  FK_crrr = 9,  // cfx code + cg + rc + rd: cfx2rd, cfx2rc
+  FK_ciii = 10, // cfx code + imm18: trap, escape
+};
+
+} // namespace DADAO
