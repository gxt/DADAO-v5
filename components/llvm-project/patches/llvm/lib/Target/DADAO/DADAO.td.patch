+//===----------------------------------------------------------------------===//
+//
+// This is the top-level TableGen definition file for the DADAO target.
+//
+//===----------------------------------------------------------------------===//
+
+include "llvm/Target/Target.td"
+
+include "DADAORegisterInfo.td"
+include "DADAOCallingConv.td"
+include "DADAOInstrInfo.td"
+include "DADAOCodeGen.td"
+
+//===----------------------------------------------------------------------===//
+// Instruction set definition
+//===----------------------------------------------------------------------===//
+
+def DADAOInstrInfo : InstrInfo;
+
+//===----------------------------------------------------------------------===//
+// Pointer-like register class for pseudo-instructions
+//===----------------------------------------------------------------------===//
+
+defm : RemapAllTargetPseudoPointerOperands<GPRB>;
+
+//===----------------------------------------------------------------------===//
+// Declare the target which we are implementing
+//===----------------------------------------------------------------------===//
+
+def DADAO : Target {
+  let InstructionSet = DADAOInstrInfo;
+}
