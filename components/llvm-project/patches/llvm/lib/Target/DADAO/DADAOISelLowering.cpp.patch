+std::pair<unsigned, const TargetRegisterClass *>
+DADAOTargetLowering::getRegForInlineAsmConstraint(
+    const TargetRegisterInfo *TRI, StringRef Constraint, MVT VT) const {
+  // ISS-193(e) / LLVM-086t: the four DADAO banks are not interchangeable --
+  // integer values inside an asm body live in the data bank, pointers in the
+  // base bank, and only the explicit rd2rb / rb2rd instructions cross them --
+  // so a lone "r" must name a register class.  The generic implementation only
+  // understands brace-enclosed physical-register names, hence the override.
+  //
+  // "r" -> the data bank (GPRD): it is the canonical i64 class, registered as
+  // the type handler for i64 in the constructor (addRegisterClass(MVT::i64,
+  // GPRDRegClass)), so it is exactly what SelectionDAG creates an i64 virtual
+  // register in.  The allocator entry point is the full class, not
+  // GPRD_Allocatable: the reserved members rd0-rd3 are removed by
+  // DADAORegisterInfo::getReservedRegs, not by the class (DADAORegisterInfo.td
+  // "双保险"; the _Allocatable subset only affects getMinimalPhysRegClass
+  // determinism).
+  //
+  // Only "r" is mapped (LLVM-086t scope: unlock, do not define an inline-asm
+  // constraint convention); every other constraint keeps the generic handling.
+  if (Constraint.size() == 1 && Constraint[0] == 'r')
+    return std::make_pair(0u, &DADAO::GPRDRegClass);
+
+  return TargetLowering::getRegForInlineAsmConstraint(TRI, Constraint, VT);
+}
+
+bool DADAOTargetLowering::CanLowerReturn(
+    CallingConv::ID /*CallConv*/, MachineFunction & /*MF*/, bool /*IsVarArg*/,
+    const SmallVectorImpl<ISD::OutputArg> &Outs, LLVMContext & /*Context*/,
+    const Type * /*RetTy*/) const {
+  // M6 (contract-abi.md §6.1): the return registers are rd8..rd15 / rb8..rb15,
+  // i.e. at most K = 8 values per bank.  Each bank is counted independently;
+  // as soon as any bank would need a 9th value the whole return is demoted to
+  // a hidden sret pointer (SelectionDAGBuilder inserts it as the first address
+  // argument, which lands in rb16 through CC_DADAO's CCIfSRet rule).
+  //
+  // Outs here comes from GetReturnInfo (FunctionLoweringInfo::CanLowerReturn
+  // and SelectionDAGBuilder::LowerCallTo), whose ArgFlags do *not* carry the
+  // pointer bit; the per-element OrigTy is the authoritative bank witness
+  // (GetReturnInfo sets OrigTy to the flattened element type).  The three
+  // return banks rd/rb/rf (contract-abi.md §6.1) are counted independently.
+  unsigned NumInt = 0, NumPtr = 0, NumFP = 0;
+  for (const ISD::OutputArg &Arg : Outs) {
+    const Type *Ty = Arg.OrigTy;
+    if (Ty && Ty->isPointerTy()) {
+      if (++NumPtr > 8)
+        return false;
+    } else if (Ty && Ty->isFloatingPointTy()) {
+      // rf8..rf15 (M6, contract-abi.md §4.4/§6.1, LLVM-066t).
+      if (++NumFP > 8)
+        return false;
+    } else {
+      if (++NumInt > 8)
+        return false;
+    }
+  }
+  return true;
+}
+
+
+//===----------------------------------------------------------------------===//
+// ADR-0031 D4/D6 caller-side argument groups
+//===----------------------------------------------------------------------===//
+
+namespace {
+
+/// Bank of one already-analysed argument piece.  Pointers, sret and byval
+/// pointers use RB; f32/f64 use RF; everything else uses RD.
+unsigned dadaoBankOf(const ISD::ArgFlagsTy &Flags, MVT LocVT) {
+  if (Flags.isPointer() || Flags.isSRet() || Flags.isByVal() ||
+      Flags.isByRef() || Flags.isPreallocated())
+    return 1; // RB
+  if (LocVT == MVT::f32 || LocVT == MVT::f64)
+    return 2; // RF
+  return 0;   // RD
+}
+
+MCRegister dadaoRegFor(unsigned Bank, unsigned Slot) {
+  const unsigned Base =
+      Bank == 0 ? unsigned(DADAO::rd0)
+                : (Bank == 1 ? unsigned(DADAO::rb0) : unsigned(DADAO::rf0));
+  return MCRegister(Base + Slot);
+}
+
+/// Re-assign every argument piece with whole-group semantics (ADR-0031 D4/D6).
+///
+/// The generic TableGen CC (CC_DADAO) allocates one piece at a time and cannot
+/// see argument groups.  SelectionDAGBuilder tags the pieces of one source
+/// argument with InConsecutiveRegs (and the last with ...Last) when
+/// functionArgumentNeedsConsecutiveRegisters() returns true, so this pass can
+/// re-run the allocation with the full group:
+///
+///   * a group fits only if ALL its slots are free in its bank; otherwise the
+///     whole group goes to the shared stack area and the bank cursor and the
+///     remaining count do not move (no splitting -- D4);
+///   * a 16-byte general aggregate (RD, two blocks) additionally needs an
+///     even-aligned pair: an odd cursor first skips one slot (D6), and if that
+///     leaves fewer than two slots the whole value goes to the stack without
+///     skipping or advancing;
+///   * a 16-byte value in the stack area (f128 or the two-block RD group,
+///     which also covers the 9..15-byte corner the backend cannot tell apart)
+///     occupies two 8-byte slots and is 16-byte aligned: an offset that is
+///     8 (mod 16) first skips one slot (ADR-0031 D7).  The returned stack size
+///     therefore includes that padding.
+///
+/// Both the call side (LowerCall) and the callee side (LowerFormalArguments)
+/// call this, so caller and callee agree; clang's va_arg implements the same
+/// rule at run time (parity of rd_next + rd_left and alignment of va.stack).
+template <typename ArgT>
+uint64_t reassignDADAOArgLocs(ArrayRef<ArgT> Args,
+                              SmallVectorImpl<CCValAssign> &Locs) {
+  assert(Args.size() == Locs.size() && "argument/location count mismatch");
+  unsigned NextSlot[3] = {16, 16, 16};
+  uint64_t StackOff = 0;
+
+  for (unsigned I = 0, E = Locs.size(); I != E;) {
+    // f128 halves are not tagged with InConsecutiveRegs (fp128 is a scalar
+    // type); they are recognised by the marker added in markF128Halves and
+    // must be re-allocated as one even RF pair (ADR-0031 D6).
+    const bool IsF128Start = Args[I].OrigTy &&
+                             Args[I].OrigTy->isFP128Ty() &&
+                             Args[I].Flags.isSplit() &&
+                             !Args[I].Flags.isSplitEnd();
+    if (IsF128Start) {
+      if (I + 1 >= E || !Args[I + 1].OrigTy ||
+          !Args[I + 1].OrigTy->isFP128Ty())
+        report_fatal_error("DADAO: unpaired binary128 argument half");
+      unsigned Next = NextSlot[2];
+      bool Fits = false, Skip = false;
+      if (Next & 1) {
+        Fits = (Next + 3 <= 32);
+        Skip = Fits;
+      } else {
+        Fits = (Next + 2 <= 32);
+      }
+      if (Fits) {
+        if (Skip)
+          ++Next;
+        Locs[I].convertToReg(dadaoRegFor(2, Next));
+        Locs[I + 1].convertToReg(dadaoRegFor(2, Next + 1));
+        NextSlot[2] = Next + 2;
+      } else {
+        // ADR-0031 D7: a 16-byte value occupies two 8-byte slots and must be
+        // 16-byte aligned on the stack; skip one slot when the cursor is odd.
+        StackOff = alignTo(StackOff, 16);
+        Locs[I].convertToMem(StackOff);
+        Locs[I + 1].convertToMem(StackOff + 8);
+        StackOff += 16;
+      }
+      I += 2;
+      continue;
+    }
+
+    if (!Args[I].Flags.isInConsecutiveRegs()) {
+      const unsigned Bank = dadaoBankOf(Args[I].Flags, Locs[I].getLocVT());
+      if (NextSlot[Bank] < 32)
+        Locs[I].convertToReg(dadaoRegFor(Bank, NextSlot[Bank]++));
+      else {
+        Locs[I].convertToMem(StackOff);
+        StackOff += 8;
+      }
+      ++I;
+      continue;
+    }
+
+    unsigned J = I;
+    while (J != E && !Args[J].Flags.isInConsecutiveRegsLast())
+      ++J;
+    if (J == E)
+      report_fatal_error("DADAO: argument group has no end marker");
+
+    const unsigned Count = J - I + 1;
+    const unsigned Bank = dadaoBankOf(Args[I].Flags, Locs[I].getLocVT());
+    for (unsigned K = 1; K < Count; ++K)
+      if (dadaoBankOf(Args[I + K].Flags, Locs[I + K].getLocVT()) != Bank)
+        report_fatal_error("DADAO: argument group spans register banks");
+
+    // A two-block general aggregate (RD) needs an even-aligned pair (16-byte
+    // values per D6; the 9..15-byte corner uses the same convention so caller
+    // and va_arg agree).  HFA/HPA groups are all-or-nothing but have no pair
+    // rule.  f128 was handled above as an RF pair.
+    const bool Pair = Count == 2 && Bank == 0;
+    unsigned Next = NextSlot[Bank];
+    bool Fits = false;
+    bool Skip = false;
+    if (Pair) {
+      if (Next & 1) {
+        Fits = (Next + 3 <= 32);
+        Skip = Fits; // skip the odd slot, then take the even pair
+      } else {
+        Fits = (Next + 2 <= 32);
+      }
+    } else {
+      Fits = (Next + Count <= 32);
+    }
+
+    if (Fits) {
+      if (Skip)
+        ++Next;
+      for (unsigned K = 0; K < Count; ++K)
+        Locs[I + K].convertToReg(dadaoRegFor(Bank, Next + K));
+      NextSlot[Bank] = Next + Count;
+    } else {
+      // ADR-0031 D7: the two-block RD group is a 16-byte value; keep it
+      // 16-byte aligned in the stack area (skip one 8-byte slot if needed).
+      // Larger groups, HFA and HPA keep the plain 8-byte slot packing.
+      if (Pair) {
+        StackOff = alignTo(StackOff, 16);
+      }
+      for (unsigned K = 0; K < Count; ++K)
+        Locs[I + K].convertToMem(StackOff + 8 * K);
+      StackOff += 8 * Count;
+      // Cursor and remaining count deliberately unchanged (D4).
+    }
+    I = J + 1;
+  }
+  return StackOff;
+}
+
+/// True if Ty is one allocation group for DADAO: an HFA, an HPA, or a general
+/// aggregate coerced by clang to 8-byte blocks ([N x i64]).
+bool isDADAOArgGroupType(Type *Ty, const DataLayout &DL) {
+  if (!Ty->isAggregateType())
+    return false;
+
+  SmallVector<Type *, 8> Leaves;
+  bool Ok = true;
+  std::function<void(Type *)> Flatten = [&](Type *T) {
+    if (!Ok)
+      return;
+    if (auto *AT = dyn_cast<ArrayType>(T)) {
+      if (AT->getNumElements() == 0 || AT->getNumElements() > 8) {
+        Ok = false;
+        return;
+      }
+      for (uint64_t N = 0; N != AT->getNumElements() && Ok; ++N)
+        Flatten(AT->getElementType());
+      return;
+    }
+    if (auto *ST = dyn_cast<StructType>(T)) {
+      for (Type *Elem : ST->elements())
+        Flatten(Elem);
+      return;
+    }
+    Leaves.push_back(T);
+  };
+  Flatten(Ty);
+  if (!Ok || Leaves.empty() || Leaves.size() > 8)
+    return false;
+
+  const uint64_t Size = DL.getTypeAllocSize(Ty);
+  Type *Leaf0 = Leaves[0];
+  const bool AllPtr = llvm::all_of(Leaves, [](Type *T) {
+    return T->isPointerTy();
+  });
+  const bool AllFloat = (Leaf0->isFloatTy() || Leaf0->isDoubleTy()) &&
+                        llvm::all_of(Leaves, [&](Type *T) { return T == Leaf0; });
+  const bool AllI64 = Leaf0->isIntegerTy(64) &&
+                      llvm::all_of(Leaves, [](Type *T) {
+                        return T->isIntegerTy(64);
+                      });
+  if (AllPtr && Size == Leaves.size() * 8)
+    return true; // HPA
+  if (AllFloat &&
+      Size == Leaves.size() * DL.getTypeAllocSize(Leaf0))
+    return true; // HFA
+  if (AllI64 && Size == Leaves.size() * 8)
+    return true; // general aggregate blocks
+  return false;
+}
+
+} // end anonymous namespace
+
+bool DADAOTargetLowering::functionArgumentNeedsConsecutiveRegisters(
+    Type *Ty, CallingConv::ID /*CallConv*/, bool /*isVarArg*/,
+    const DataLayout &DL) const {
+  return isDADAOArgGroupType(Ty, DL);
+}
+
+SDValue DADAOTargetLowering::LowerFormalArguments(
+    SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+    const SmallVectorImpl<ISD::InputArg> &Ins, const SDLoc &DL,
+    SelectionDAG &DAG, SmallVectorImpl<SDValue> &InVals) const {
+  // M3 scalar calling convention (contract-abi.md §4, ADR-0018 C4/C2):
+  //   - scalar args -> rd16..rd31, pointer args -> rb16..rb31, each bank
+  //     counted independently (CC_DADAO);
+  //   - register-exhausted args come from the shared, declaration-ordered
+  //     stack area at incoming_sp + 0 (C4 D1);
+  //   - the caller has already canonicalised a narrow (<8B) argument (C4 D2),
+  //     so the callee only records the asserted extension.
+  // M6 (contract-abi.md §6): varargs, byval (>64B aggregate passed indirectly)
+  // and sret (hidden return pointer) are all supported.  byval and sret arrive
+  // as pointer arguments and CC_DADAO routes them to the RB bank (sret via the
+  // CCIfSRet rule to rb16); nest remains unsupported.
+  if (CallConv != CallingConv::C && CallConv != CallingConv::Fast)
+    report_fatal_error("DADAO: only the C calling convention is supported");
+  for (const ISD::InputArg &Arg : Ins)
+    if (Arg.Flags.isNest())
+      report_fatal_error("DADAO: nest arguments are not supported");
+
+  MachineFunction &MF = DAG.getMachineFunction();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  MachineRegisterInfo &RegInfo = MF.getRegInfo();
+
+  SmallVector<CCValAssign, 16> ArgLocs;
+  CCState CCInfo(CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext());
+  CCInfo.AnalyzeFormalArguments(markF128Halves<ISD::InputArg>(Ins), CC_DADAO);
+  // Whole-group re-assignment (ADR-0031 D4/D6): aggregates are all-or-nothing
+  // per bank and an exactly-16-byte general aggregate (or f128) is an
+  // even-aligned pair.
+  const uint64_t ArgStackSize =
+      reassignDADAOArgLocs<ISD::InputArg>(Ins, ArgLocs);
+
+  for (unsigned i = 0, e = ArgLocs.size(); i != e; ++i) {
+    CCValAssign &VA = ArgLocs[i];
+    const EVT LocVT = VA.getLocVT();
+    if (LocVT != MVT::i64 && LocVT != MVT::f32 && LocVT != MVT::f64)
+      report_fatal_error(
+          "DADAO: only scalar/pointer/floating-point arguments are supported");
+
+    SDValue ArgValue;
+    if (VA.isRegLoc()) {
+      // Bank comes from the register CC_DADAO actually assigned (rb* for
+      // pointers, rd* for scalars, rf* for floating point); the vreg class must
+      // match it so the register allocator cannot put a value in the wrong bank
+      // (C1/C2; FP: contract-abi.md §4.1).  A binary128 half is a 64-bit
+      // integer part even though it lives in an RF slot (LLVM-106t): keep it in
+      // GPRD so the later integer operations on the halves need no extra bank
+      // move (`rf2rd` is inserted by copyPhysReg).
+      const bool IsF128Half = VA.getValVT() == MVT::f128;
+      const TargetRegisterClass *RC =
+          IsF128Half                                           ? &DADAO::GPRDRegClass
+          : DADAO::GPRBRegClass.contains(VA.getLocReg())       ? &DADAO::GPRBRegClass
+          : DADAO::GPRFRegClass.contains(VA.getLocReg())       ? &DADAO::GPRFRegClass
+                                                               : &DADAO::GPRDRegClass;
+      Register VReg = RegInfo.createVirtualRegister(RC);
+      RegInfo.addLiveIn(VA.getLocReg(), VReg);
+      ArgValue = DAG.getCopyFromReg(Chain, DL, VReg, LocVT);
+      Chain = ArgValue.getValue(1);
+    } else {
+      assert(VA.isMemLoc() && "expected a register or stack argument");
+      // Shared stack overflow area: incoming_sp + LocMemOffset (C4 D1).  The
+      // fixed object offset is relative to the entry SP; PEI resolves it.
+      int FI = MFI.CreateFixedObject(8, VA.getLocMemOffset(),
+                                     /*IsImmutable=*/true);
+      SDValue FIN = DAG.getFrameIndex(FI, getPointerTy(DAG.getDataLayout()));
+      SDValue L = DAG.getLoad(LocVT, DL, Chain, FIN,
+                              MachinePointerInfo::getFixedStack(MF, FI));
+      Chain = L.getValue(1);
+      ArgValue = L.getValue(0);
+    }
+
+    // The caller canonicalised a narrow (<8B) argument; record the asserted
+    // extension and truncate back to the IR type (C4 D2).
+    if (VA.getLocInfo() == CCValAssign::SExt)
+      ArgValue = DAG.getNode(ISD::AssertSext, DL, LocVT, ArgValue,
+                             DAG.getValueType(VA.getValVT()));
+    else if (VA.getLocInfo() == CCValAssign::ZExt)
+      ArgValue = DAG.getNode(ISD::AssertZext, DL, LocVT, ArgValue,
+                             DAG.getValueType(VA.getValVT()));
+    if (VA.getLocInfo() != CCValAssign::Full)
+      ArgValue = DAG.getNode(ISD::TRUNCATE, DL, VA.getValVT(), ArgValue);
+
+    InVals.push_back(ArgValue);
+  }
+
+  // Variadic register save area (ADR-0031 D2).  A variadic callee snapshots
+  // the slots of each argument bank that were NOT consumed by named arguments,
+  // with one `stm.o` per bank, at function entry.  The area is 16-byte aligned;
+  // the RD region is shifted by one slot when `start` is odd so that the
+  // address of slot `start` has bit 3 == (start & 1).  va_arg uses that bit to
+  // detect an odd cursor for the 16-byte even/odd pairing rule (D6) without
+  // carrying the start index in the va_list.
+  if (IsVarArg) {
+    auto *Info = MF.getInfo<DADAOMachineFunctionInfo>();
+    const TargetRegisterInfo *TRI = MF.getSubtarget().getRegisterInfo();
+    for (const CCValAssign &VA : ArgLocs) {
+      if (!VA.isRegLoc())
+        continue;
+      const Register R = VA.getLocReg();
+      const unsigned NextSlot = TRI->getEncodingValue(R) + 1;
+      if (DADAO::GPRBRegClass.contains(R))
+        Info->VarArgStartRB = std::max(Info->VarArgStartRB, NextSlot);
+      else if (DADAO::GPRFRegClass.contains(R))
+        Info->VarArgStartRF = std::max(Info->VarArgStartRF, NextSlot);
+      else
+        Info->VarArgStartRD = std::max(Info->VarArgStartRD, NextSlot);
+    }
+    Info->VarArgPadRD = Info->VarArgStartRD & 1;
+    Info->VarArgStackOffset = ArgStackSize;
+
+    if (Info->SaveSize() != 0) {
+      const MVT PtrVT = getPointerTy(DAG.getDataLayout());
+      Info->VarArgSaveFI =
+          MFI.CreateStackObject(Info->SaveSize(), Align(16), /*isSpillSlot=*/false);
+      SDValue Base = DAG.getFrameIndex(Info->VarArgSaveFI, PtrVT);
+
+      auto SaveBank = [&](unsigned Opc, unsigned First, unsigned Count,
+                          unsigned Off) {
+        if (Count == 0)
+          return;
+        SDValue BankBase =
+            Off ? DAG.getNode(ISD::ADD, DL, PtrVT, Base,
+                              DAG.getConstant(Off, DL, PtrVT))
+                : Base;
+        SmallVector<SDValue, 20> Ops;
+        Ops.push_back(DAG.getRegister(First, MVT::i64));
+        Ops.push_back(BankBase);
+        Ops.push_back(DAG.getRegister(DADAO::rd0, MVT::i64));
+        Ops.push_back(DAG.getTargetConstant(Count, DL, MVT::i64));
+        // The range partners are implicit uses; they must be declared live-in
+        // even when no named argument used them, or the verifier rejects the
+        // read of an undefined physical register.
+        if (!RegInfo.isLiveIn(First))
+          RegInfo.addLiveIn(First);
+        for (unsigned I = 1; I != Count; ++I) {
+          const Register R(First + I);
+          Ops.push_back(DAG.getRegister(R, MVT::i64));
+          if (!RegInfo.isLiveIn(R))
+            RegInfo.addLiveIn(R);
+        }
+        Ops.push_back(Chain);
+        Chain = SDValue(DAG.getMachineNode(Opc, DL, MVT::Other, Ops), 0);
+      };
+
+      SaveBank(DADAO::stm_o_rd, DADAO::rd16 + (Info->VarArgStartRD - 16),
+               Info->RDLeft(), Info->RDOffset());
+      SaveBank(DADAO::stm_o_rb, DADAO::rb16 + (Info->VarArgStartRB - 16),
+               Info->RBLeft(), Info->RBOffset());
+      SaveBank(DADAO::stm_o_rrri_rf, DADAO::rf16 + (Info->VarArgStartRF - 16),
+               Info->RFLeft(), Info->RFOffset());
+    }
+  }
+  return Chain;
+}
+
+SDValue DADAOTargetLowering::LowerReturn(
+    SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+    const SmallVectorImpl<ISD::OutputArg> &Outs,
+    const SmallVectorImpl<SDValue> &OutVals, const SDLoc &DL,
+    SelectionDAG &DAG) const {
+  // M6 scalar/multi returns (contract-abi.md §4.4/§6.1, ADR-0018 C5):
+  //   - integer/scalar -> rd8..rd15, pointer -> rb8..rb15 (first value at
+  //     index 8, each subsequent value +1 in its own bank);
+  //   - a narrow (<8B) return value is canonicalised by the callee; the caller
+  //     does not truncate (C5 D2).
+  // Whether the values fit the return registers (K = 8 per bank) is decided by
+  // CanLowerReturn; a return that does not fit was already demoted to sret, so
+  // here every value must be a register.
+
+  SmallVector<CCValAssign, 16> RVLocs;
+  CCState CCInfo(CallConv, IsVarArg, DAG.getMachineFunction(), RVLocs,
+                 *DAG.getContext());
+  CCInfo.AnalyzeReturn(markF128Halves<ISD::OutputArg>(Outs), RetCC_DADAO);
+
+  SDValue Glue;
+  SmallVector<SDValue, 4> RetOps(1, Chain);
+  for (unsigned i = 0, e = RVLocs.size(); i != e; ++i) {
+    CCValAssign &VA = RVLocs[i];
+    if (!VA.isRegLoc())
+      report_fatal_error(
+          "DADAO: only register return values are supported in M3");
+
+    SDValue Val = OutVals[i];
+    // Callee-side canonical extension of a narrow return value (C5 D2).
+    if (VA.getLocInfo() == CCValAssign::SExt)
+      Val = DAG.getNode(ISD::SIGN_EXTEND, DL, VA.getLocVT(), Val);
+    else if (VA.getLocInfo() == CCValAssign::ZExt)
+      Val = DAG.getNode(ISD::ZERO_EXTEND, DL, VA.getLocVT(), Val);
+    else if (VA.getLocInfo() == CCValAssign::AExt)
+      Val = DAG.getNode(ISD::ANY_EXTEND, DL, VA.getLocVT(), Val);
+
+    Chain = DAG.getCopyToReg(Chain, DL, VA.getLocReg(), Val, Glue);
+    Glue = Chain.getValue(1);
+    RetOps.push_back(DAG.getRegister(VA.getLocReg(), VA.getLocVT()));
+  }
+  RetOps[0] = Chain;
+  if (Glue.getNode())
+    RetOps.push_back(Glue);
+
+  return DAG.getNode(DADAOISD::RET_GLUE, DL, MVT::Other, RetOps);
+}
+
+SDValue DADAOTargetLowering::LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                                       SmallVectorImpl<SDValue> &InVals) const {
+  // M6 call lowering (contract-abi.md §4/§6, ADR-0018 C4/C16):
+  //   - arguments assigned by CC_DADAO (bank split, shared overflow area);
+  //   - sret/byval arrive as pointer arguments and are routed to the RB bank;
+  //   - a direct callee is a target global/external symbol (call_iiii); an
+  //     indirect callee (function pointer) is materialized into GPRB and
+  //     selected to call_rrii (Addr = rbha + rdhb + (imms12 << 2));
+  //   - a variadic call writes no save area: the callee snapshots the unused
+  //     argument registers itself (ADR-0031 D2), so only the normal shared
+  //     overflow stack area carries memory arguments;
+  //   - CALLSEQ_START/END bracket the outgoing argument area;
+  //   - the DADAOISD::CALL node carries the call-preserved mask
+  //     (getCallPreservedMask: includes rb32..rb63, ML-004c) and the live-in
+  //     argument registers of this call site (DL-065a).
+  SelectionDAG &DAG = CLI.DAG;
+  const SDLoc &DL = CLI.DL;
+  SmallVectorImpl<ISD::OutputArg> &Outs = CLI.Outs;
+  SmallVectorImpl<SDValue> &OutVals = CLI.OutVals;
+  SmallVectorImpl<ISD::InputArg> &Ins = CLI.Ins;
+  SDValue Chain = CLI.Chain;
+  SDValue Callee = CLI.Callee;
+  CallingConv::ID CallConv = CLI.CallConv;
+  bool IsVarArg = CLI.IsVarArg;
+
+  if (CallConv != CallingConv::C && CallConv != CallingConv::Fast)
+    report_fatal_error("DADAO: only the C calling convention is supported");
+  for (const ISD::OutputArg &Arg : Outs)
+    if (Arg.Flags.isNest())
+      report_fatal_error("DADAO: nest arguments are not supported");
+
+  MachineFunction &MF = DAG.getMachineFunction();
+
+  SmallVector<CCValAssign, 16> ArgLocs;
+  CCState CCInfo(CallConv, IsVarArg, MF, ArgLocs, *DAG.getContext());
+  CCInfo.AnalyzeCallOperands(markF128Halves<ISD::OutputArg>(Outs), CC_DADAO);
+  // Whole-group re-assignment (ADR-0031 D4/D6); this also yields the final
+  // stack size (the generic CC counted the pieces one by one).
+  const uint64_t ArgStackSize =
+      reassignDADAOArgLocs<ISD::OutputArg>(Outs, ArgLocs);
+
+  // Real tail call (LLVM-074t; contract-isa.md §8.3/§8.4, contract-abi.md
+  // §2.3/§4.6).  DADAO has no tail-call instruction, but it does have a plain
+  // `jump`: a tail call is lowered as a tail-jump that (a) tears down this
+  // frame and (b) jumps to the callee *without* pushing a return address, so
+  // the callee's `ret` pops the *caller's* RegRAS entry.  The frame teardown is
+  // not emitted here -- the selected tail-jump instruction (tailjmp_iiii /
+  // tailjmp_rrii) is isReturn, so PEI emits the standard epilogue before it.
+  // Only tail calls whose arguments all live in registers and in no memory of
+  // *this* frame are eligible (see the eligibility loop below).
+  if (CLI.IsTailCall) {
+    // Eligibility (LLVM-074t).  A tail-jump leaves SP at the caller's frame, so
+    // any argument that needs memory in *this* frame is unsafe:
+    //   - an out-of-register (stack) argument needs the outgoing argument area
+    //     of this frame (a variadic tail call is rejected outright);
+    //   - a `byval` argument is a pointer to a caller-local copy, and an
+    //     `Indirect` (large aggregate) argument is a pointer to a caller-local
+    //     temporary -- both become dangling once the epilogue deallocates the
+    //     frame (same guards as RISCV/AArch64);
+    //   - an `sret` argument (callee returns through a pointer) points into the
+    //     caller's frame too.
+    bool Eligible = !IsVarArg && ArgStackSize == 0;
+    for (const ISD::OutputArg &Arg : Outs)
+      if (Arg.Flags.isByVal() || Arg.Flags.isSRet())
+        Eligible = false;
+    for (const CCValAssign &VA : ArgLocs)
+      if (VA.getLocInfo() == CCValAssign::Indirect)
+        Eligible = false;
+    // The return value is forwarded in registers: a tail-jump runs no code of
+    // ours after the callee's `ret`, so the callee's return registers become
+    // this function's own by construction and there is no place left for a
+    // bank move.  The two must therefore be identical (contract-abi.md §4.4:
+    // a pointer result is returned in rb8, an integer result in rd8, and a
+    // pointer return does not go through rd8; §4.6 the call's Defs are
+    // rb8-rb15/rd8-rd15).  Otherwise demote to a plain call + return, which
+    // inserts the move (ISS-256 ②: shmat() == `(void *)syscall(...)` returns
+    // an i64 from __syscall_ret in rd8 as a `void *` in rb8 -- the tail-jump
+    // left the caller reading a stale rb8).
+    if (Eligible) {
+      SmallVector<CCValAssign, 16> CalleeRets;
+      CCState CalleeRetCC(CallConv, IsVarArg, MF, CalleeRets,
+                          *DAG.getContext());
+      CalleeRetCC.AnalyzeCallResult(markF128Halves<ISD::InputArg>(Ins),
+                                    RetCC_DADAO);
+      const Function &F = MF.getFunction();
+      SmallVector<ISD::OutputArg, 4> SelfOuts;
+      GetReturnInfo(CallConv, F.getReturnType(), F.getAttributes(), SelfOuts,
+                    *this, DAG.getDataLayout());
+      // GetReturnInfo does not record the pointer bit; SelectionDAGBuilder::
+      // visitRet adds it from the returned IR type (and only when the whole
+      // return type is a pointer), so mirror that here or RetCC_DADAO would
+      // put a pointer return in rd8 and the comparison would be blind.
+      if (F.getReturnType()->isPointerTy())
+        for (ISD::OutputArg &O : SelfOuts)
+          O.Flags.setPointer();
+      SmallVector<CCValAssign, 16> SelfRets;
+      CCState SelfRetCC(CallConv, F.isVarArg(), MF, SelfRets,
+                        *DAG.getContext());
+      SelfRetCC.AnalyzeReturn(markF128Halves<ISD::OutputArg>(SelfOuts),
+                              RetCC_DADAO);
+      Eligible = CalleeRets.size() == SelfRets.size();
+      for (unsigned i = 0, e = CalleeRets.size(); Eligible && i != e; ++i)
+        Eligible = CalleeRets[i].isRegLoc() && SelfRets[i].isRegLoc() &&
+                   CalleeRets[i].getLocReg() == SelfRets[i].getLocReg() &&
+                   CalleeRets[i].getLocVT() == SelfRets[i].getLocVT() &&
+                   CalleeRets[i].getLocInfo() == SelfRets[i].getLocInfo();
+    }
+    if (Eligible) {
+      // Copy the outgoing register arguments (glued), materialising the
+      // caller-side sign/zero extension exactly as the normal path (C4 D2).
+      SDValue ArgGlue;
+      SmallVector<std::pair<Register, SDValue>, 8> TailRegs;
+      for (unsigned i = 0, e = ArgLocs.size(); i != e; ++i) {
+        CCValAssign &VA = ArgLocs[i];
+        SDValue Arg = OutVals[i];
+        switch (VA.getLocInfo()) {
+        case CCValAssign::Full:
+          break;
+        case CCValAssign::SExt:
+          Arg = DAG.getNode(ISD::SIGN_EXTEND, DL, VA.getLocVT(), Arg);
+          break;
+        case CCValAssign::ZExt:
+          Arg = DAG.getNode(ISD::ZERO_EXTEND, DL, VA.getLocVT(), Arg);
+          break;
+        case CCValAssign::AExt:
+          Arg = DAG.getNode(ISD::ANY_EXTEND, DL, VA.getLocVT(), Arg);
+          break;
+        default:
+          llvm_unreachable("DADAO: unsupported argument location info");
+        }
+        assert(VA.isRegLoc() && "tail call with an out-of-register argument");
+        Chain = DAG.getCopyToReg(Chain, DL, VA.getLocReg(), Arg, ArgGlue);
+        ArgGlue = Chain.getValue(1);
+        TailRegs.push_back(std::make_pair(VA.getLocReg(), Arg));
+      }
+
+      // Callee operand: a target global/external symbol (direct) or a GPRB
+      // virtual register holding the target address (indirect), as in CALL.
+      SDValue CalleeOp;
+      if (auto *G = dyn_cast<GlobalAddressSDNode>(Callee)) {
+        CalleeOp = DAG.getTargetGlobalAddress(G->getGlobal(), DL, MVT::i64);
+      } else if (auto *E = dyn_cast<ExternalSymbolSDNode>(Callee)) {
+        CalleeOp = DAG.getTargetExternalSymbol(E->getSymbol(), MVT::i64);
+      } else {
+        Register TargetReg =
+            MF.getRegInfo().createVirtualRegister(&DADAO::GPRBRegClass);
+        Chain = DAG.getCopyToReg(Chain, DL, TargetReg, Callee, ArgGlue);
+        ArgGlue = Chain.getValue(1);
+        CalleeOp = DAG.getRegister(TargetReg, MVT::i64);
+      }
+
+      const TargetRegisterInfo *TRI = MF.getSubtarget().getRegisterInfo();
+      const uint32_t *Mask = TRI->getCallPreservedMask(MF, CallConv);
+      assert(Mask &&
+             "DADAO: missing call-preserved mask for the calling convention");
+
+      SDVTList NodeTys = DAG.getVTList(MVT::Other, MVT::Glue);
+      SmallVector<SDValue, 8> TailOps;
+      TailOps.push_back(Chain);
+      TailOps.push_back(CalleeOp);
+      TailOps.push_back(DAG.getRegisterMask(Mask));
+      for (auto &Reg : TailRegs)
+        TailOps.push_back(
+            DAG.getRegister(Reg.first, Reg.second.getValueType()));
+      if (ArgGlue.getNode())
+        TailOps.push_back(ArgGlue);
+      return DAG.getNode(DADAOISD::TAIL, DL, NodeTys, TailOps);
+    }
+
+    // Not eligible: a `musttail` call promises to reuse the frame, so it cannot
+    // be silently demoted -- fail loudly.  A plain (hint-only) `tail` may be
+    // demoted to an ordinary call+return (TargetLowering::CallLoweringInfo::
+    // IsTailCall is documented to be cleared by LowerCall implementations);
+    // that is correct, just not the tail-call optimisation (LLVM-070t).
+    if (CLI.CB && CLI.CB->isMustTailCall())
+      report_fatal_error("DADAO: 'musttail' call cannot be lowered: the tail "
+                         "call needs stack arguments, is variadic, or has a "
+                         "byval/indirect/sret argument");
+    CLI.IsTailCall = false;
+  }
+
+  // The caller writes no variadic save area (ADR-0031 D2): the callee
+  // snapshots the argument registers itself, so a variadic call is an ordinary
+  // call whose only extra memory is the usual shared overflow stack area.
+  // ADR-0031 D7 / ADR-0018 C9 D3 (contract-abi.md §2.2): every `call` executes
+  // with SP 16-byte aligned, so the caller-side outgoing area always rounds up
+  // to 16 bytes.  The value is the *call frame* size only: the callee's
+  // ArgStackSize is the va_start offset and stays exact (LLVM-111t F3).
+  const uint64_t NumBytes = alignTo(ArgStackSize, 16);
+  Chain = DAG.getCALLSEQ_START(Chain, NumBytes, 0, DL);
+
+  SmallVector<std::pair<Register, SDValue>, 8> RegsToPass;
+  SmallVector<SDValue, 8> MemOpChains;
+  for (unsigned i = 0, e = ArgLocs.size(); i != e; ++i) {
+    CCValAssign &VA = ArgLocs[i];
+    SDValue Arg = OutVals[i];
+
+    // The caller materialises the sign/zero extension of a narrow argument
+    // (C4 D2); the callee may assume the register is canonical.
+    switch (VA.getLocInfo()) {
+    case CCValAssign::Full:
+      break;
+    case CCValAssign::SExt:
+      Arg = DAG.getNode(ISD::SIGN_EXTEND, DL, VA.getLocVT(), Arg);
+      break;
+    case CCValAssign::ZExt:
+      Arg = DAG.getNode(ISD::ZERO_EXTEND, DL, VA.getLocVT(), Arg);
+      break;
+    case CCValAssign::AExt:
+      Arg = DAG.getNode(ISD::ANY_EXTEND, DL, VA.getLocVT(), Arg);
+      break;
+    default:
+      llvm_unreachable("DADAO: unsupported argument location info");
+    }
+
+    if (VA.isRegLoc()) {
+      RegsToPass.push_back(std::make_pair(VA.getLocReg(), Arg));
+      continue;
+    }
+
+    assert(VA.isMemLoc() && "expected a register or stack argument");
+    // Outgoing stack argument: SP + getLocMemOffset().  The Address complex
+    // pattern folds `SP + simm12` into `[rbsp, off]`.
+    SDValue StackPtr = DAG.getRegister(DADAO::rb1, MVT::i64);
+    SDValue DstAddr = DAG.getNode(
+        ISD::ADD, DL, MVT::i64, StackPtr,
+        DAG.getIntPtrConstant(VA.getLocMemOffset(), DL));
+    MemOpChains.push_back(DAG.getStore(
+        Chain, DL, Arg, DstAddr,
+        MachinePointerInfo::getStack(MF, VA.getLocMemOffset())));
+  }
+
+  if (!MemOpChains.empty())
+    Chain = DAG.getNode(ISD::TokenFactor, DL, MVT::Other, MemOpChains);
+
+  // Copy the outgoing register arguments, chained by glue (DL-065a: these
+  // become the call's implicit uses).
+  SDValue ArgGlue;
+  for (auto &Reg : RegsToPass) {
+    Chain = DAG.getCopyToReg(Chain, DL, Reg.first, Reg.second, ArgGlue);
+    ArgGlue = Chain.getValue(1);
+  }
+
+  // Turn the callee into the call operand: a target global/external symbol for
+  // a direct call, or a GPRB virtual register for an indirect one.
+  SDValue CalleeOp;
+  if (auto *G = dyn_cast<GlobalAddressSDNode>(Callee)) {
+    CalleeOp = DAG.getTargetGlobalAddress(G->getGlobal(), DL, MVT::i64);
+  } else if (auto *E = dyn_cast<ExternalSymbolSDNode>(Callee)) {
+    CalleeOp = DAG.getTargetExternalSymbol(E->getSymbol(), MVT::i64);
+  } else {
+    // Indirect call: materialize the target address into a GPRB register so
+    // call_rrii's base operand (rb) is satisfied.
+    Register TargetReg =
+        MF.getRegInfo().createVirtualRegister(&DADAO::GPRBRegClass);
+    Chain = DAG.getCopyToReg(Chain, DL, TargetReg, Callee, ArgGlue);
+    ArgGlue = Chain.getValue(1);
+    CalleeOp = DAG.getRegister(TargetReg, MVT::i64);
+  }
+
+  const TargetRegisterInfo *TRI = MF.getSubtarget().getRegisterInfo();
+  const uint32_t *Mask = TRI->getCallPreservedMask(MF, CallConv);
+  assert(Mask && "DADAO: missing call-preserved mask for the calling convention");
+
+  SDVTList NodeTys = DAG.getVTList(MVT::Other, MVT::Glue);
+  SmallVector<SDValue, 8> CallOps;
+  CallOps.push_back(Chain);
+  CallOps.push_back(CalleeOp);
+  // Call-clobbered set (inv: preserved includes rb32..rb63, C16/ML-004c).
+  CallOps.push_back(DAG.getRegisterMask(Mask));
+  // The live-in argument registers of this call site (InstrEmitter turns these
+  // RegisterSDNodes into implicit-use operands).
+  for (auto &Reg : RegsToPass)
+    CallOps.push_back(DAG.getRegister(Reg.first, Reg.second.getValueType()));
+  if (ArgGlue.getNode())
+    CallOps.push_back(ArgGlue);
+
+  Chain = DAG.getNode(DADAOISD::CALL, DL, NodeTys, CallOps);
+  SDValue Glue = Chain.getValue(1);
+
+  Chain = DAG.getCALLSEQ_END(Chain, NumBytes, 0, Glue, DL);
+  Glue = Chain.getValue(1);
+
+  return LowerCallResult(Chain, Glue, CallConv, IsVarArg, Ins, DL, DAG, InVals);
+}
+
+SDValue DADAOTargetLowering::LowerCallResult(
+    SDValue Chain, SDValue InGlue, CallingConv::ID CallConv, bool IsVarArg,
+    const SmallVectorImpl<ISD::InputArg> &Ins, const SDLoc &DL,
+    SelectionDAG &DAG, SmallVectorImpl<SDValue> &InVals) const {
+  SmallVector<CCValAssign, 16> RVLocs;
+  CCState CCInfo(CallConv, IsVarArg, DAG.getMachineFunction(), RVLocs,
+                 *DAG.getContext());
+  CCInfo.AnalyzeCallResult(markF128Halves<ISD::InputArg>(Ins), RetCC_DADAO);
+
+  for (unsigned i = 0, e = RVLocs.size(); i != e; ++i) {
+    CCValAssign &VA = RVLocs[i];
+    if (!VA.isRegLoc())
+      report_fatal_error(
+          "DADAO: only register call results are supported in M3");
+    SDValue Copy =
+        DAG.getCopyFromReg(Chain, DL, VA.getLocReg(), VA.getLocVT(), InGlue);
+    Chain = Copy.getValue(1);
+    InGlue = Copy.getValue(2);
+    SDValue Val = Copy.getValue(0);
+    // The callee canonicalised a narrow return value; the caller only
+    // truncates to the IR type (C5 D2: caller does not re-extend).  A
+    // binary128 half is a 64-bit integer part (ValVT is only the marker); the
+    // generic getCopyFromParts below reassembles the two halves into f128.
+    if (VA.getValVT() != VA.getLocVT() && VA.getValVT() != MVT::f128)
+      Val = DAG.getNode(ISD::TRUNCATE, DL, VA.getValVT(), Val);
+    InVals.push_back(Val);
+  }
+  return Chain;
+}
+
+bool DADAOTargetLowering::isPointerBankValue(SDValue V,
+                                             const SelectionDAG &DAG) const {
+  // Pointers are legalized to i64 (C2) and only carry their bank in the virtual
+  // register created for the formal argument (LowerFormalArguments).  At
+  // lowering time a pointer argument therefore appears as a CopyFromReg of a
+  // GPRB virtual register; that register class is the bank witness.
+  if (V.getOpcode() != ISD::CopyFromReg)
+    return false;
+  const auto *RegNode = cast<RegisterSDNode>(V.getOperand(1));
+  const Register R = RegNode->getReg();
+  if (!R.isVirtual())
+    return false;
+  const MachineRegisterInfo &MRI = DAG.getMachineFunction().getRegInfo();
+  return MRI.getRegClass(R) == &DADAO::GPRBRegClass;
+}
+
+SDValue DADAOTargetLowering::LowerOperation(SDValue Op,
+                                            SelectionDAG &DAG) const {
+  switch (Op.getOpcode()) {
+  case ISD::BR_CC:
+    return LowerBR_CC(Op.getOperand(0),
+                      cast<CondCodeSDNode>(Op.getOperand(1))->get(),
+                      Op.getOperand(2), Op.getOperand(3), Op.getOperand(4),
+                      SDLoc(Op), DAG);
+  case ISD::BRCOND:
+    return LowerBRCOND(Op, DAG);
+  case ISD::SETCC:
+    return LowerSETCC(Op, DAG);
+  case ISD::SELECT_CC:
+    return LowerSELECT_CC(Op, DAG);
+  case ISD::SELECT:
+    return LowerSELECT(Op, DAG);
+  case ISD::VASTART:
+    return LowerVASTART(Op, DAG);
+  case ISD::VAARG:
+    return LowerVAARG(Op, DAG);
+  case ISD::VACOPY:
+    return LowerVACOPY(Op, DAG);
+  case ISD::BR_JT:
+    return LowerBR_JT(Op, DAG);
+  case ISD::BRIND:
+    return LowerBRIND(Op, DAG);
+  case ISD::SHL_PARTS:
+  case ISD::SRL_PARTS:
+  case ISD::SRA_PARTS: {
+    // INFRA-079t: expand a two-register (i128) shift into i64 shift/and/or/
+    // select operations (see the Custom action in the constructor).
+    SDValue Lo, Hi;
+    expandShiftParts(Op.getNode(), Lo, Hi, DAG);
+    return DAG.getMergeValues({Lo, Hi}, SDLoc(Op));
+  }
+  default:
+    return SDValue();
+  }
+}
+
+SDValue DADAOTargetLowering::LowerVASTART(SDValue Op,
+                                          SelectionDAG &DAG) const {
+  // `llvm.va_start(ptr %ap)` (spec DADAO-21 §3.3, ADR-0031 D1/D2).  Fill the
+  // seven-field va_list from the callee's register save area:
+  //   [0] rd_next  [1] rb_next  [2] rf_next
+  //   [3] rd_left  [4] rb_left  [5] rf_left
+  //   [6] stack_next (= incoming_sp = rb2 + 8)
+  // The frame layout and the per-bank start slots were computed in
+  // LowerFormalArguments (DADAOMachineFunctionInfo).
+  MachineFunction &MF = DAG.getMachineFunction();
+  auto *Info = MF.getInfo<DADAOMachineFunctionInfo>();
+  const DataLayout &DLayout = DAG.getDataLayout();
+  const MVT PtrVT = getPointerTy(DLayout);
+  const SDLoc DL(Op);
+  const Value *SV = cast<SrcValueSDNode>(Op.getOperand(2))->getValue();
+  SDValue Chain = Op.getOperand(0);
+  SDValue VAList = Op.getOperand(1);
+
+  // First variadic stack slot: incoming_sp + (named stack bytes).  Named
+  // arguments that overflow share the same declaration-ordered stack area, so
+  // they always form a prefix of it (contract-abi.md §4.3, ADR-0031 D4).
+  if (Info->VarArgStackFI < 0)
+    Info->VarArgStackFI = MF.getFrameInfo().CreateFixedObject(
+        /*Size=*/8, /*Offset=*/static_cast<int64_t>(Info->VarArgStackOffset),
+        /*IsImmutable=*/true);
+  SDValue StackNext = DAG.getFrameIndex(Info->VarArgStackFI, PtrVT);
+
+  SDValue SaveBase;
+  if (Info->VarArgSaveFI >= 0)
+    SaveBase = DAG.getFrameIndex(Info->VarArgSaveFI, PtrVT);
+  else
+    // Every bank was already exhausted by the named arguments: left == 0, so
+    // the cursors are never dereferenced.  Point them at incoming_sp.
+    SaveBase = StackNext;
+
+  auto StoreField = [&](unsigned Index, SDValue Value) {
+    SDValue Addr = DAG.getNode(
+        ISD::ADD, DL, PtrVT, VAList,
+        DAG.getConstant(static_cast<int64_t>(Index) * 8, DL, PtrVT));
+    Chain = DAG.getStore(Chain, DL, Value, Addr,
+                         MachinePointerInfo(SV, Index * 8), Align(8));
+  };
+
+  const unsigned Pad = Info->VarArgPadRD;
+  SDValue RDNext = Pad ? DAG.getNode(ISD::ADD, DL, PtrVT, SaveBase,
+                                     DAG.getConstant(8, DL, PtrVT))
+                       : SaveBase;
+  SDValue RBNext = DAG.getNode(
+      ISD::ADD, DL, PtrVT, SaveBase,
+      DAG.getConstant(static_cast<int64_t>(Info->RBOffset()), DL, PtrVT));
+  SDValue RFNext = DAG.getNode(
+      ISD::ADD, DL, PtrVT, SaveBase,
+      DAG.getConstant(static_cast<int64_t>(Info->RFOffset()), DL, PtrVT));
+
+  StoreField(0, RDNext);
+  StoreField(1, RBNext);
+  StoreField(2, RFNext);
+  StoreField(3, DAG.getConstant(Info->RDLeft(), DL, MVT::i64));
+  StoreField(4, DAG.getConstant(Info->RBLeft(), DL, MVT::i64));
+  StoreField(5, DAG.getConstant(Info->RFLeft(), DL, MVT::i64));
+  StoreField(6, StackNext);
+  return Chain;
+}
+
+SDValue DADAOTargetLowering::LowerVAARG(SDValue Op, SelectionDAG &DAG) const {
+  // clang expands `va_arg` itself (it owns the type classification and emits
+  // the five-step cursor/stack sequence of spec §3.3), so the generic
+  // `llvm.va_arg` intrinsic must not be silently lowered with a layout it does
+  // not match.  Fail loudly instead (an unsupported feature must be explicit).
+  report_fatal_error(
+      "DADAO: llvm.va_arg is not used by the DADAO ABI; clang expands "
+      "va_arg directly (seven-field va_list, spec DADAO-21 §3.3)");
+}
+
+SDValue DADAOTargetLowering::LowerVACOPY(SDValue Op, SelectionDAG &DAG) const {
+  // va_copy = copy the whole 56-byte seven-field structure (D1).
+  const SDLoc DL(Op);
+  const Value *DestSV = cast<SrcValueSDNode>(Op.getOperand(3))->getValue();
+  const Value *SrcSV = cast<SrcValueSDNode>(Op.getOperand(4))->getValue();
+  return DAG.getMemcpy(Op.getOperand(0), DL, Op.getOperand(1), Op.getOperand(2),
+                       DAG.getConstant(56, DL, MVT::i32), Align(8), Align(8),
+                       /*isVolatile=*/false, /*AlwaysInline=*/false,
+                       /*MF=*/nullptr, /*AAInfo=*/std::nullopt,
+                       MachinePointerInfo(DestSV), MachinePointerInfo(SrcSV));
+}
+
+SDValue DADAOTargetLowering::LowerBRCOND(SDValue Op, SelectionDAG &DAG) const {
+  SDValue Chain = Op.getOperand(0);
+  SDValue CondV = Op.getOperand(1);
+  SDValue Dest = Op.getOperand(2);
+  SDLoc DL(Op);
+
+  // `br (icmp ...)` / `br (fcmp ...)` reaches us as SETCC + BRCOND
+  // (SelectionDAGBuilder no longer builds BR_CC directly).  Fold the setcc back
+  // into a compare + branch.  The integer path (i64) and the FP path
+  // (f32/f64, M6/LLVM-066t) are both handled by LowerBR_CC.
+  if (CondV.getOpcode() == ISD::SETCC) {
+    const EVT OpVT = CondV.getOperand(0).getValueType();
+    if (OpVT == MVT::i64 || OpVT == MVT::f32 || OpVT == MVT::f64) {
+      ISD::CondCode CC = cast<CondCodeSDNode>(CondV.getOperand(2))->get();
+      return LowerBR_CC(Chain, CC, CondV.getOperand(0), CondV.getOperand(1),
+                        Dest, DL, DAG);
+    }
+  }
+
+  // Generic `br i1 %c`: test the low bit against zero (setne 0).  Zero-extend
+  // so the high bits do not poison the != 0 test.
+  SDValue Cond = CondV;
+  if (Cond.getValueType() != MVT::i64)
+    Cond = DAG.getZExtOrTrunc(Cond, DL, MVT::i64);
+  return LowerBR_CC(Chain, ISD::SETNE, Cond, DAG.getConstant(0, DL, MVT::i64),
+                    Dest, DL, DAG);
+}
+
+SDValue DADAOTargetLowering::LowerBR_JT(SDValue Op, SelectionDAG &DAG) const {
+  // Dense switch dispatch (LLVM-072t, ISS-177/G3).  The jump table itself is
+  // emitted by the generic AsmPrinter: EK_BlockAddress entries (one 8-byte
+  // absolute case address each) in a read-only data section, each `.quad LBB`
+  // becoming an R_DADAO_ABS48 field.  All this hook has to do is retag the
+  // ISD::BR_JT node so the custom selector (DADAOISelDAGToDAG::Select) can emit
+  // the materialize-index-load-jump sequence; the table symbol travels as a
+  // TargetJumpTable leaf, which InstrEmitter turns into an MO_JumpTableIndex.
+  SDLoc DL(Op);
+  SDValue Chain = Op.getOperand(0);
+  auto *JT = cast<JumpTableSDNode>(Op.getOperand(1));
+  SDValue Index = Op.getOperand(2);
+  SDValue TargetJT = DAG.getTargetJumpTable(JT->getIndex(), MVT::i64);
+  return DAG.getNode(DADAOISD::BR_JT, DL, MVT::Other, Chain, Index, TargetJT);
+}
+
+SDValue DADAOTargetLowering::LowerBRIND(SDValue Op, SelectionDAG &DAG) const {
+  // Indirect branch (`goto *p`, LLVM-102t).  The rrii jump form is
+  //   Addr = rbha + rdhb + (imms12 << 2)            (contract-isa.md §8.3)
+  // i.e. the base must come from the RB bank, and rb0 is the IP (read as the
+  // current instruction address), so it cannot serve as the base either.  The
+  // BRIND target, on the other hand, is ordinary C data: a function pointer or
+  // `&&label` value lives in the RD bank (rd0 is the hardwired zero).  Copy it
+  // into a GPRB virtual register through CopyToReg: when the value arrives in
+  // GPRD this becomes a cross-bank `rd2rb` (copyPhysReg), and when it is
+  // already a GPRB value (e.g. the BLOCK_ADDR materialization of a label
+  // address) it stays a same-bank `rb2rb`.  The selector then emits
+  //   jump rbtarget, rd0, 0
+  // with rd0 supplying the zero offset, so the address is exactly the computed
+  // target -- never a PC-relative `jump imms24`.
+  //
+  // This path is deliberately separate from ISD::BR_JT: the switch dispatch
+  // loads its case address from the jump table as part of its own sequence
+  // (DADAOISD::BR_JT), whereas here the target is already a value.
+  SDLoc DL(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue Target = Op.getOperand(1);
+  MachineFunction &MF = DAG.getMachineFunction();
+  Register TargetReg =
+      MF.getRegInfo().createVirtualRegister(&DADAO::GPRBRegClass);
+  Chain = DAG.getCopyToReg(Chain, DL, TargetReg, Target);
+  SDValue TargetRB = DAG.getRegister(TargetReg, MVT::i64);
+  return DAG.getNode(DADAOISD::BRIND, DL, MVT::Other, Chain, TargetRB);
+}
+
+SDValue DADAOTargetLowering::LowerBR_CC(SDValue Chain, ISD::CondCode CC,
+                                        SDValue LHS, SDValue RHS, SDValue Dest,
+                                        const SDLoc &DL,
+                                        SelectionDAG &DAG) const {
+  auto IsZero = [](SDValue V) {
+    if (auto *C = dyn_cast<ConstantSDNode>(V))
+      return C->isZero();
+    return false;
+  };
+  auto Cmp = [&](bool Unsigned) {
+    return DAG.getNode(Unsigned ? DADAOISD::CMPU : DADAOISD::CMP, DL, MVT::i64,
+                       LHS, RHS);
+  };
+  auto BrOn = [&](DADAOISD::NodeType Op, SDValue Val) {
+    return DAG.getNode(Op, DL, MVT::Other, Chain, Val, Dest);
+  };
+  // Emit a compare + zero-test branch.  A constant RHS that fits the cmp*
+  // 12-bit immediate is folded into cmp.si/cmp.ui; a larger constant is
+  // materialised into a GPRD register (CONST_WYDE, C12 / ADR-0018) and compared
+  // with the register-register form cmp.so/cmp.uo (contract-isa.md §6.2).  The
+  // same DADAOISD::CMP/CMPU node carries either shape: ISel picks the immediate
+  // pattern when the constant fits and the register pattern otherwise, so a
+  // large constant is never rejected here.
+  auto CmpThenBranch = [&](bool Unsigned, DADAOISD::NodeType Op) {
+    return BrOn(Op, Cmp(Unsigned));
+  };
+
+  // --- Floating-point compare + branch (M6, LLVM-066t) ---
+  // The DADAO FP compare writes -1 / 0 / 1 for ordered results (lhs <, ==, > rhs)
+  // and a positive NaN value for unordered (contract-fp.md §8).  The same
+  // register zero-test branches then implement the C predicates; `>`/`>=` are
+  // expressed by swapping the operands into `<`/`<=`, and the unordered /
+  // ordered / ordered-not-equal predicates add one `cmp rd, rc, 1` (LLVM-084t,
+  // ISS-193 (a)).  A condition outside this set still fails loudly rather than
+  // silently miscompile.
+  if (LHS.getValueType().isFloatingPoint()) {
+    auto FCmp = [&](SDValue A, SDValue B) {
+      return DAG.getNode(DADAOISD::FCMP, DL, MVT::i64, A, B);
+    };
+    // Predicates outside the plain 4-way sign test (unordered / ordered /
+    // ordered-not-equal) need one extra integer compare.  The FP compare writes
+    // a *positive* qNaN value for unordered (contract-fp.md §8: ordered results
+    // are exactly -1/0/1) whose integer value exceeds those, so `cmp rd, rc, 1`
+    // separates ordered (rc <= 1) from unordered (rc > 1).  Every step is an
+    // existing ISA instruction: foqcmp/ftqcmp (FCMP) + cmp.si + br.*/cs.*
+    // (contract-isa.md §6.2/§6.5).
+    auto One = DAG.getConstant(1, DL, MVT::i64);
+    auto Zero = DAG.getConstant(0, DL, MVT::i64);
+    // < 0 / == 0 / > 0 three-way flag; > 0 means unordered (either operand NaN).
+    auto Unordered = [&](SDValue A, SDValue B) {
+      return DAG.getNode(DADAOISD::CMP, DL, MVT::i64, FCmp(A, B), One);
+    };
+    switch (CC) {
+    case ISD::SETOEQ: // == : rc == 0              (unordered NaN -> not 0)
+      return BrOn(DADAOISD::BRZ, FCmp(LHS, RHS));
+    case ISD::SETUNE: // != : rc != 0              (unordered NaN -> true)
+      return BrOn(DADAOISD::BRNZ, FCmp(LHS, RHS));
+    case ISD::SETOLT: // <  : rc < 0
+      return BrOn(DADAOISD::BRN, FCmp(LHS, RHS));
+    case ISD::SETOLE: // <= : rc <= 0
+      return BrOn(DADAOISD::BRNP, FCmp(LHS, RHS));
+    case ISD::SETOGT: // >  : ordered (rhs < lhs)
+      return BrOn(DADAOISD::BRN, FCmp(RHS, LHS));
+    case ISD::SETOGE: // >= : ordered (rhs <= lhs)
+      return BrOn(DADAOISD::BRNP, FCmp(RHS, LHS));
+    case ISD::SETUGT: // unordered or >  : rc > 0
+      return BrOn(DADAOISD::BRP, FCmp(LHS, RHS));
+    case ISD::SETUGE: // unordered or >= : rc >= 0
+      return BrOn(DADAOISD::BRNN, FCmp(LHS, RHS));
+    case ISD::SETULT: // unordered or <  : (= ugt(rhs, lhs))
+      return BrOn(DADAOISD::BRP, FCmp(RHS, LHS));
+    case ISD::SETULE: // unordered or <= : (= uge(rhs, lhs))
+      return BrOn(DADAOISD::BRNN, FCmp(RHS, LHS));
+    case ISD::SETUO: // unordered (isnan(a) | isnan(b)) : rc > 1
+      return BrOn(DADAOISD::BRP, Unordered(LHS, RHS));
+    case ISD::SETO: // ordered (neither NaN) : rc <= 1
+      return BrOn(DADAOISD::BRNP, Unordered(LHS, RHS));
+    case ISD::SETONE: { // ordered and != : ordered(rc) & (rc != 0)
+      SDValue Ord = DAG.getNode(DADAOISD::CS_P, DL, MVT::i64,
+                                Unordered(LHS, RHS), Zero, One);
+      SDValue Ne = DAG.getNode(DADAOISD::CS_Z, DL, MVT::i64, FCmp(LHS, RHS),
+                               Zero, One);
+      return BrOn(DADAOISD::BRNZ,
+                  DAG.getNode(ISD::AND, DL, MVT::i64, Ord, Ne));
+    }
+    case ISD::SETUEQ: { // unordered or == : unordered(rc) | (rc == 0)
+      SDValue Un = DAG.getNode(DADAOISD::CS_P, DL, MVT::i64,
+                               Unordered(LHS, RHS), One, Zero);
+      SDValue Eq = DAG.getNode(DADAOISD::CS_Z, DL, MVT::i64, FCmp(LHS, RHS),
+                               One, Zero);
+      return BrOn(DADAOISD::BRNZ,
+                  DAG.getNode(ISD::OR, DL, MVT::i64, Un, Eq));
+    }
+    // The "don't care" cond codes (ISDOpcodes.h CondCode: "undefined if the
+    // input is a nan") reach an FP branch when the DAG already knows the
+    // operands are ordered (e.g. `fmul nnan`).  Lower them as their ordered
+    // counterparts -- the unordered case is undefined, so the ordered result is
+    // a valid choice and no extra test is needed.
+    case ISD::SETEQ:  // ==  (unordered undefined) : rc == 0
+      return BrOn(DADAOISD::BRZ, FCmp(LHS, RHS));
+    case ISD::SETNE:  // !=  : rc != 0
+      return BrOn(DADAOISD::BRNZ, FCmp(LHS, RHS));
+    case ISD::SETLT:  // <   : rc < 0
+      return BrOn(DADAOISD::BRN, FCmp(LHS, RHS));
+    case ISD::SETLE:  // <=  : rc <= 0
+      return BrOn(DADAOISD::BRNP, FCmp(LHS, RHS));
+    case ISD::SETGT:  // >   : (rhs < lhs)
+      return BrOn(DADAOISD::BRN, FCmp(RHS, LHS));
+    case ISD::SETGE:  // >=  : (rhs <= lhs)
+      return BrOn(DADAOISD::BRNP, FCmp(RHS, LHS));
+    default:
+      report_fatal_error(
+          "DADAO: unsupported floating-point branch condition");
+    }
+  }
+
+  switch (CC) {
+  default:
+    report_fatal_error("DADAO: unsupported integer branch condition");
+  case ISD::SETEQ:
+  case ISD::SETNE: {
+    const bool IsEQ = CC == ISD::SETEQ;
+    const DADAOISD::NodeType BrZ = IsEQ ? DADAOISD::BRZ : DADAOISD::BRNZ;
+    // Equality is symmetric: swap so the non-constant operand is on the left.
+    if (isa<ConstantSDNode>(LHS) && !isa<ConstantSDNode>(RHS))
+      std::swap(LHS, RHS);
+    // x == 0 / p == NULL: a single zero-test branch (br.z {rb} for pointers;
+    // C17).  Also covers `0 == x`.
+    if (IsZero(RHS))
+      return BrOn(BrZ, LHS);
+    // Pointer vs pointer: cmp.uo rd, rb, rb + br.z/nz (C14 D2 / C17 `p==q`).
+    if (isPointerBankValue(LHS, DAG) || isPointerBankValue(RHS, DAG))
+      return BrOn(BrZ, Cmp(/*Unsigned=*/true));
+    // Two integers in registers: br.eq/ne directly (C17: no cmp needed).
+    if (!isa<ConstantSDNode>(LHS) && !isa<ConstantSDNode>(RHS))
+      return DAG.getNode(IsEQ ? DADAOISD::BREQ : DADAOISD::BRNE, DL, MVT::Other,
+                         Chain, LHS, RHS, Dest);
+    // Non-zero constant: choose cmp.si/cmp.ui so the constant is reproduced
+    // exactly, then br.z/nz (--- but prefer the format that fits).
+    {
+      const auto *C = cast<ConstantSDNode>(RHS);
+      const bool FitsU = isUInt<12>(C->getZExtValue());
+      return CmpThenBranch(/*Unsigned=*/FitsU, BrZ);
+    }
+  }
+  case ISD::SETLT:
+    return CmpThenBranch(/*Unsigned=*/false, DADAOISD::BRN);
+  case ISD::SETLE:
+    return CmpThenBranch(/*Unsigned=*/false, DADAOISD::BRNP);
+  case ISD::SETGT:
+    return CmpThenBranch(/*Unsigned=*/false, DADAOISD::BRP);
+  case ISD::SETGE:
+    return CmpThenBranch(/*Unsigned=*/false, DADAOISD::BRNN);
+  case ISD::SETULT:
+    return CmpThenBranch(/*Unsigned=*/true, DADAOISD::BRN);
+  case ISD::SETULE:
+    return CmpThenBranch(/*Unsigned=*/true, DADAOISD::BRNP);
+  case ISD::SETUGT:
+    return CmpThenBranch(/*Unsigned=*/true, DADAOISD::BRP);
+  case ISD::SETUGE:
+    return CmpThenBranch(/*Unsigned=*/true, DADAOISD::BRNN);
+  }
+  llvm_unreachable("DADAO: unreachable branch condition");
+}
+
+SDValue DADAOTargetLowering::LowerCmpSelect(ISD::CondCode CC, SDValue LHS,
+                                            SDValue RHS, SDValue True,
+                                            SDValue False, const SDLoc &DL,
+                                            SelectionDAG &DAG) const {
+  // cs.* conditional assignment (contract-isa.md §6.5): the three tests cover
+  // cond < 0 / == 0 / > 0 with the two arms selected explicitly, so <=0 / >=0
+  // reuse a test with the arms swapped.  The result type is the arms' type: i64
+  // for integer arms (cs.*_rd) and f64/f32 for FP arms (cs.*_rrrr_rf); the
+  // condition is always an i64 comparison result (LLVM-079t).
+  auto Select = [&](DADAOISD::NodeType Cs, SDValue Cond, SDValue T, SDValue F) {
+    return DAG.getNode(Cs, DL, T.getValueType(), Cond, T, F);
+  };
+
+  // --- Floating-point compare selecting integer arms (M6 uniform path) ---
+  // The FP compare result is -1/0/1 for ordered results and a positive NaN for
+  // unordered (contract-fp.md §8), so every C predicate is one cs test, with
+  // possible operand and/or arm swapping; `>`/`>=` compare the operands the
+  // other way round (rc' = cmp(rhs, lhs)).
+  if (LHS.getValueType().isFloatingPoint()) {
+    auto FCmp = [&](SDValue A, SDValue B) {
+      return DAG.getNode(DADAOISD::FCMP, DL, MVT::i64, A, B);
+    };
+    // See LowerBR_CC: `cmp rd, rc, 1` separates ordered (rc <= 1) from unordered
+    // (the positive qNaN the FP compare writes for NaN operands, rc > 1); the
+    // unordered/ordered/ordered-not-equal predicates then combine that flag with
+    // the equal sign test via cs.* + and/or (all existing ISA instructions).
+    auto One = DAG.getConstant(1, DL, MVT::i64);
+    auto Zero = DAG.getConstant(0, DL, MVT::i64);
+    auto Unordered = [&](SDValue A, SDValue B) {
+      return DAG.getNode(DADAOISD::CMP, DL, MVT::i64, FCmp(A, B), One);
+    };
+    switch (CC) {
+    case ISD::SETOEQ: // ==  : rc == 0
+      return Select(DADAOISD::CS_Z, FCmp(LHS, RHS), True, False);
+    case ISD::SETUNE: // !=  : rc != 0
+      return Select(DADAOISD::CS_Z, FCmp(LHS, RHS), False, True);
+    case ISD::SETOLT: // <   : rc < 0
+      return Select(DADAOISD::CS_N, FCmp(LHS, RHS), True, False);
+    case ISD::SETOLE: // <=  : rc <= 0
+      return Select(DADAOISD::CS_P, FCmp(LHS, RHS), False, True);
+    case ISD::SETOGT: // >   : (rhs < lhs)
+      return Select(DADAOISD::CS_N, FCmp(RHS, LHS), True, False);
+    case ISD::SETOGE: // >=  : (rhs <= lhs)
+      return Select(DADAOISD::CS_P, FCmp(RHS, LHS), False, True);
+    case ISD::SETUGT: // unordered or >  : rc > 0
+      return Select(DADAOISD::CS_P, FCmp(LHS, RHS), True, False);
+    case ISD::SETUGE: // unordered or >= : rc >= 0
+      return Select(DADAOISD::CS_N, FCmp(LHS, RHS), False, True);
+    case ISD::SETULT: // unordered or <  : (= ugt(rhs, lhs))
+      return Select(DADAOISD::CS_P, FCmp(RHS, LHS), True, False);
+    case ISD::SETULE: // unordered or <= : (= uge(rhs, lhs))
+      return Select(DADAOISD::CS_N, FCmp(RHS, LHS), False, True);
+    case ISD::SETUO: // unordered : rc > 1
+      return Select(DADAOISD::CS_P, Unordered(LHS, RHS), True, False);
+    case ISD::SETO: // ordered : rc <= 1
+      return Select(DADAOISD::CS_P, Unordered(LHS, RHS), False, True);
+    case ISD::SETONE: { // ordered and != : ordered(rc) & (rc != 0)
+      SDValue Ord = DAG.getNode(DADAOISD::CS_P, DL, MVT::i64,
+                                Unordered(LHS, RHS), Zero, One);
+      SDValue Ne = DAG.getNode(DADAOISD::CS_Z, DL, MVT::i64, FCmp(LHS, RHS),
+                               Zero, One);
+      SDValue Pred = DAG.getNode(ISD::AND, DL, MVT::i64, Ord, Ne);
+      return Select(DADAOISD::CS_Z, Pred, False, True);
+    }
+    case ISD::SETUEQ: { // unordered or == : unordered(rc) | (rc == 0)
+      SDValue Un = DAG.getNode(DADAOISD::CS_P, DL, MVT::i64,
+                               Unordered(LHS, RHS), One, Zero);
+      SDValue Eq = DAG.getNode(DADAOISD::CS_Z, DL, MVT::i64, FCmp(LHS, RHS),
+                               One, Zero);
+      SDValue Pred = DAG.getNode(ISD::OR, DL, MVT::i64, Un, Eq);
+      return Select(DADAOISD::CS_Z, Pred, False, True);
+    }
+    // See LowerBR_CC: the "don't care if unordered" cond codes lower to their
+    // ordered counterparts.
+    case ISD::SETEQ: // ==  : rc == 0
+      return Select(DADAOISD::CS_Z, FCmp(LHS, RHS), True, False);
+    case ISD::SETNE: // !=  : rc != 0
+      return Select(DADAOISD::CS_Z, FCmp(LHS, RHS), False, True);
+    case ISD::SETLT: // <   : rc < 0
+      return Select(DADAOISD::CS_N, FCmp(LHS, RHS), True, False);
+    case ISD::SETLE: // <=  : rc <= 0
+      return Select(DADAOISD::CS_P, FCmp(LHS, RHS), False, True);
+    case ISD::SETGT: // >   : (rhs < lhs)
+      return Select(DADAOISD::CS_N, FCmp(RHS, LHS), True, False);
+    case ISD::SETGE: // >=  : (rhs <= lhs)
+      return Select(DADAOISD::CS_P, FCmp(RHS, LHS), False, True);
+    default:
+      report_fatal_error(
+          "DADAO: unsupported floating-point select/setcc condition");
+    }
+  }
+
+  if (LHS.getValueType() != MVT::i64)
+    report_fatal_error("DADAO: unsupported setcc/select_cc operand type");
+
+  // Canonicalise so a constant is on the right (the cmp* immediate formats
+  // take the constant in rdhb).
+  if (isa<ConstantSDNode>(LHS) && !isa<ConstantSDNode>(RHS)) {
+    std::swap(LHS, RHS);
+    CC = ISD::getSetCCSwappedOperands(CC);
+  }
+
+  bool Unsigned = CC == ISD::SETULT || CC == ISD::SETULE ||
+                  CC == ISD::SETUGT || CC == ISD::SETUGE;
+  // == / != are order- and format-independent, so pick the cmp format whose
+  // 12-bit immediate the constant fits (mirrors LowerBR_CC); the ordered
+  // predicates keep the format fixed by the (un)signedness of the CC.
+  if (auto *C = dyn_cast<ConstantSDNode>(RHS))
+    if (CC == ISD::SETEQ || CC == ISD::SETNE)
+      Unsigned = isUInt<12>(C->getZExtValue());
+  // A constant RHS that does not fit the cmp* 12-bit immediate is not rejected:
+  // ISel materialises it into a GPRD register (CONST_WYDE, C12 / ADR-0018) and
+  // uses the register-register cmp.so/cmp.uo form (contract-isa.md §6.2).
+
+  SDValue Cmp = DAG.getNode(Unsigned ? DADAOISD::CMPU : DADAOISD::CMP, DL,
+                            MVT::i64, LHS, RHS);
+  switch (CC) {
+  case ISD::SETEQ: // == : rc == 0
+    return Select(DADAOISD::CS_Z, Cmp, True, False);
+  case ISD::SETNE: // != : rc != 0
+    return Select(DADAOISD::CS_Z, Cmp, False, True);
+  case ISD::SETLT:
+  case ISD::SETULT: // <  : rc < 0
+    return Select(DADAOISD::CS_N, Cmp, True, False);
+  case ISD::SETLE:
+  case ISD::SETULE: // <= : not (rc > 0)
+    return Select(DADAOISD::CS_P, Cmp, False, True);
+  case ISD::SETGT:
+  case ISD::SETUGT: // >  : rc > 0
+    return Select(DADAOISD::CS_P, Cmp, True, False);
+  case ISD::SETGE:
+  case ISD::SETUGE: // >= : not (rc < 0)
+    return Select(DADAOISD::CS_N, Cmp, False, True);
+  default:
+    report_fatal_error("DADAO: unsupported integer setcc/select_cc condition");
+  }
+  llvm_unreachable("DADAO: unreachable compare condition");
+}
+
+SDValue DADAOTargetLowering::LowerSETCC(SDValue Op, SelectionDAG &DAG) const {
+  // Integer `icmp` used as a value: compare into {-1,0,1} then select 1/0
+  // (the promoted i1 result is a 0/1 i64; contract-isa.md §6.2/§6.5).
+  const SDLoc DL(Op);
+  SDValue One = DAG.getConstant(1, DL, MVT::i64);
+  SDValue Zero = DAG.getConstant(0, DL, MVT::i64);
+  return LowerCmpSelect(cast<CondCodeSDNode>(Op.getOperand(2))->get(),
+                        Op.getOperand(0), Op.getOperand(1), One, Zero, DL, DAG);
+}
+
+SDValue DADAOTargetLowering::LowerSELECT_CC(SDValue Op,
+                                            SelectionDAG &DAG) const {
+  const SDLoc DL(Op);
+  return LowerCmpSelect(cast<CondCodeSDNode>(Op.getOperand(4))->get(),
+                        Op.getOperand(0), Op.getOperand(1), Op.getOperand(2),
+                        Op.getOperand(3), DL, DAG);
+}
+
+SDValue DADAOTargetLowering::LowerSELECT(SDValue Op,
+                                         SelectionDAG &DAG) const {
+  // `select cond, true, false` with a non-setcc condition: a false condition
+  // is exactly 0 (ZeroOrOne boolean content), so cs.z picks the false arm.
+  // The arms may be integer (cs.*_rd) or FP (cs.*_rrrr_rf, LLVM-079t), so the
+  // node's result type is the arms' type.
+  const SDLoc DL(Op);
+  SDValue Cond = Op.getOperand(0);
+  if (Cond.getValueType() != MVT::i64)
+    Cond = DAG.getZExtOrTrunc(Cond, DL, MVT::i64);
+  return DAG.getNode(DADAOISD::CS_Z, DL, Op.getOperand(2).getValueType(), Cond,
+                     Op.getOperand(2), Op.getOperand(1));
+}
