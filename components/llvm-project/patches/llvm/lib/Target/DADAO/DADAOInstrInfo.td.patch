+// --- crrr/ciii format (privileged cfx; scope: excluded; MC layer only) ---
+// LLVM-060t: op/format per contracts/opcodes.yaml.  MC assemble/disassemble
+// without semantics (execution traps with ILLI, see SimRISC-11 §寄存器传输指令).
+// No CodeGen patterns (Pattern = []): these stay out of M1 codegen.
+//
+// Both crrr defs share the operand layout [rdhd, cfxha, cghb, rchc]; for
+// cfx2rc rdhd is architecturally a source, but the MC layer only encodes /
+// decodes the field value, so a uniform layout keeps printer/disassembler
+// symmetric (cf. ld.ub / st.b sharing one layout).
+
+def cfx2rd_crrr : DADAOCrrr<"cfx2rd"> {
+  let OutOperandList = (outs GPRD:$rdhd);
+  let InOperandList = (ins cfxCfxha:$cfxha, cfxCg:$cghb, cfxRc:$rchc);
+  let op = 0x7A;
+  let Pattern = [];
+}
+
+def cfx2rc_crrr : DADAOCrrr<"cfx2rc"> {
+  let OutOperandList = (outs GPRD:$rdhd);
