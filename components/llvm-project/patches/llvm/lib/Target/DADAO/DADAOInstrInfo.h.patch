+//===-- DADAOInstrInfo.h - DADAO Instruction Info ---------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DADAO instruction info. Includes the TableGen-generated instruction info
+// table (DADAOGenInstrInfo.inc) so that it participates in compilation.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_DADAO_DADAOINSTRINFO_H
+#define LLVM_LIB_TARGET_DADAO_DADAOINSTRINFO_H
+
+#include "llvm/CodeGen/TargetInstrInfo.h"
+
+// Include register info enums (RegClassIDs) and header so that
+// DADAOGenInstrInfo.inc can reference DADAO::GPRDRegClassID etc.
+#define GET_REGINFO_ENUM
+#include "DADAOGenRegisterInfo.inc"
+
+#define GET_INSTRINFO_HEADER
+#include "DADAOGenInstrInfo.inc"
+
+namespace llvm {
+
+class DADAOInstrInfo : public DADAOGenInstrInfo {
+public:
+  explicit DADAOInstrInfo(const TargetSubtargetInfo &STI,
+                          const TargetRegisterInfo &TRI,
+                          unsigned CFSetupOpcode = ~0u,
+                          unsigned CFDestroyOpcode = ~0u,
+                          unsigned CatchRetOpcode = ~0u,
+                          unsigned ReturnOpcode = ~0u);
+
+  /// Emit a register-to-register move, choosing the DADAO bank-copy
+  /// instruction that matches the source and destination banks (C3,
+  /// ADR-0018): rd2rd (RD->RD), rb2rb (RB->RB), rd2rb (RD->RB),
+  /// rb2rd (RB->RD).
+  void copyPhysReg(MachineBasicBlock &MBB, MachineBasicBlock::iterator MI,
+                   const DebugLoc &DL, Register DestReg, Register SrcReg,
+                   bool KillSrc, bool RenamableDest = false,
+                   bool RenamableSrc = false) const override;
+  // Avoid hiding any other TargetInstrInfo::copyPhysReg overloads.
+  using TargetInstrInfo::copyPhysReg;
+
+  /// Expand the CodeGen-only pseudos (LLVM-035t/LLVM-040t):
+  /// RET_PSEUDO -> `ret rd0, 0`; ADD_PSEUDO/SUB_PSEUDO/MUL_PSEUDO ->
+  /// rrrr add.uo/sub.uo/mul.uo with rdha = rd0 (the low 64 bits are rdhb);
+  /// ADD_IMM_PSEUDO -> rd2rd + add.si; CONST_WYDE -> a set.zw/set.ow basis
+  /// plus or.w/andn.w wyde fixes (C12, ADR-0018).
+  bool expandPostRAPseudo(MachineInstr &MI) const override;
+
+  /// Materialize a 64-bit immediate into a GPRD register with the fixed
+  /// set.zw / or.w wyde-slice sequence (C12, ADR-0018): the lowest nonzero
+  /// wyde is set with `set.zw` (which zeroes the other 48 bits), the remaining
+  /// nonzero wydes are OR-ed in with `or.w`.  Works for any 64-bit value
+  /// (positive or negative) because the raw wyde bits are written verbatim.
+  /// Used by the large-frame addressing (ADR-0018 C7 D4 form 3) to build an
+  /// out-of-simm18 frame offset in a scratch register.  \p Value must be
+  /// nonzero (zero needs no materialization).
+  void materializeImm64(MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI,
+                        const DebugLoc &DL, Register DstReg, int64_t Value,
+                        MachineInstr::MIFlag Flag = MachineInstr::NoFlags) const;
+
+  /// Register spilling to / reloading from a stack slot (LLVM-038t).  The
+  /// access is emitted as a `st.o`/`ld.o` with a frame index as the base, the
+  /// bank selected from the spilled register class (C16 D3, ADR-0018); PEI
+  /// resolves the frame index to `[rbsp/rbfp, offset]`.
+  void storeRegToStackSlot(MachineBasicBlock &MBB,
+                           MachineBasicBlock::iterator MI, Register SrcReg,
+                           bool isKill, int FrameIndex,
+                           const TargetRegisterClass *RC, Register VReg,
+                           MachineInstr::MIFlag Flags = MachineInstr::NoFlags)
+      const override;
+
+  void loadRegFromStackSlot(MachineBasicBlock &MBB,
+                            MachineBasicBlock::iterator MI, Register DestReg,
+                            int FrameIndex, const TargetRegisterClass *RC,
+                            Register VReg, unsigned SubReg,
+                            MachineInstr::MIFlag Flags = MachineInstr::NoFlags)
+      const override;
+
+  /// CFG branch support (LLVM-059t / ISS-158).  Recognise the DADAO branch
+  /// shapes emitted by CodeGen -- a conditional `br_*` (fall-through) and/or
+  /// an unconditional `jump_iiii` -- and fill in TBB/FBB/Cond per the base
+  /// class contract.  Returns true ("cannot analyze") for anything else, e.g.
+  /// a block ending in `ret` or an unsupported branch form.
+  bool analyzeBranch(MachineBasicBlock &MBB, MachineBasicBlock *&TBB,
+                     MachineBasicBlock *&FBB,
+                     SmallVectorImpl<MachineOperand> &Cond,
+                     bool AllowModify = false) const override;
+
+  /// Remove the branch code at the end of \p MBB (LLVM-059t).
+  unsigned removeBranch(MachineBasicBlock &MBB,
+                        int *BytesRemoved = nullptr) const override;
+
+  /// Insert an unconditional branch to \p TBB (and, when \p Cond is non-empty
+  /// and \p FBB is non-null, a conditional branch to \p TBB followed by an
+  /// unconditional branch to \p FBB) at the end of \p MBB (LLVM-059t).
+  /// \p Cond follows the analyzeBranch convention: Cond[0] = Imm(opcode) of a
+  /// conditional branch, Cond[1..] = its non-target explicit operands; the
+  /// branch target is always the last explicit operand.
+  unsigned insertBranch(MachineBasicBlock &MBB, MachineBasicBlock *TBB,
+                        MachineBasicBlock *FBB, ArrayRef<MachineOperand> Cond,
+                        const DebugLoc &DL,
+                        int *BytesAdded = nullptr) const override;
+
+  /// Return the destination block of a DADAO branch (always the last explicit
+  /// operand; LLVM-059t).
+  MachineBasicBlock *getBranchDestBlock(const MachineInstr &MI) const override;
+
+  /// Size in bytes of a DADAO instruction.  Required by removeBranch /
+  /// insertBranch to report BytesRemoved / BytesAdded; every DADAO
+  /// instruction is a fixed 4 bytes (DADAOInstrFormats.td).  (LLVM-059t)
+  unsigned getInstSizeInBytes(const MachineInstr &MI) const override;
+
+  /// Return true iff a PC-relative branch of opcode \p BranchOpc can reach a
+  /// target \p BrOffset bytes away.  \p BrOffset is measured from the branch
+  /// instruction itself and is a BYTE offset; the DADAO branch immediates hold
+  /// a WORD offset (`imms << 2`, contract-isa.md §8.1/§8.2), so the field width
+  /// applies to `BrOffset / 4`.  Consulted by the BranchRelaxation pass
+  /// (LLVM-071t) so an out-of-range br.eq/br.ne is relaxed (a short inverted
+  /// branch over a long `jump`) instead of failing at assembly time.
+  /// `jump`/`call` cover a 24-bit word field and are treated as always in range
+  /// here; the assembler still validates the field and reports an error if a
+  /// function ever exceeds it.  DADAO deliberately does *not* override
+  /// reverseBranchCondition: BranchRelaxation then relaxes a conditional branch
+  /// via the "island" form (an inserted block reached by a short branch that
+  /// jumps on), which keeps BranchFolder's existing CFG shape unchanged.
+  bool isBranchOffsetInRange(unsigned BranchOpc,
+                             int64_t BrOffset) const override;
+
+private:
+  /// Return true iff \p Opcode is one of the DADAO conditional branches whose
+  /// operand layout is understood by analyzeBranch / insertBranch (LLVM-059t).
+  /// Any other conditional branch must make analyzeBranch report "cannot
+  /// analyze" rather than silently mis-model the CFG.
+  static bool isSupportedCondBranchOpcode(unsigned Opcode);
+};
+
+} // end namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_DADAOINSTRINFO_H
