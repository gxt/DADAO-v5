+//
+// DADAO DAG-to-DAG instruction selector (M3 skeleton, LLVM-033t; i64
+// arithmetic, LLVM-035t; compare/branch, LLVM-037t).  It wires the
+// TableGen-generated matcher (DADAOGenDAGISel.inc) and additionally handles
+// the nodes that cannot be expressed reliably as TableGen patterns:
+//   - ISD::Constant  -> CONST_WYDE pseudo (64-bit materialization, C12)
+//   - ptr + offset   -> add.o rb, rb, rd (bank-aware, C14 / ADR-0018)
+//   - ptr − ptr      -> sub.o rd, rb, rb (bank-aware, C14 / ADR-0018)
+//   - pointer cmp    -> cmp.uo rd, rb, rb (C14 D2 / C17)
+//   - p == NULL      -> br.z/br.nz {rb} (C17)
+// The bank-sensitive cases are handled here because the TableGen matcher does
+// not discriminate register classes on i64 operands (it inserts a GPRB->GPRD
+// copy instead).
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOISelLowering.h"
+#include "DADAOSubtarget.h"
+#include "DADAOTargetMachine.h"
+#include "DADAO.h"
+
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/SelectionDAG.h"
+#include "llvm/CodeGen/SelectionDAGISel.h"
+#include "llvm/CodeGen/SelectionDAGNodes.h"
+#include "llvm/Support/Debug.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/MathExtras.h"
+
+// Instruction opcodes (DADAO::RET_PSEUDO, ...) used by the generated matcher.
+#define GET_INSTRINFO_ENUM
+#include "DADAOGenInstrInfo.inc"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "dadao-isel"
+#define PASS_NAME "DADAO DAG->DAG Pattern Instruction Selection"
+
+namespace {
+
+class DADAODAGToDAGISel : public SelectionDAGISel {
+public:
+  DADAODAGToDAGISel() = delete;
+
+  explicit DADAODAGToDAGISel(DADAOTargetMachine &TM)
+      : SelectionDAGISel(TM) {}
+
+  void Select(SDNode *N) override;
+
+  // Address matcher for the load/store patterns (DADAOAddr complex pattern):
+  // folds `base + simm12` and keeps a frame index as the base operand so
+  // PrologEpilogInserter can resolve it (LLVM-038t).
+  bool SelectAddr(SDValue Addr, SDValue &Base, SDValue &Offset);
+
+private:
+  // i64 constant materialization (CONST_WYDE pseudo, C12 / ADR-0018).
+  void SelectConstant(SDNode *N);
+  // ptr + offset selection to add.o rb, rb, rd (C14 / ADR-0018).
+  void SelectPointerAdd(SDNode *N, SDValue Base, SDValue Offset);
+  // ptr − ptr selection to sub.o rd, rb, rb (C14 / ADR-0018).
+  void SelectPointerSub(SDNode *N);
+  // True if V is an i64 value currently held in the GPRB (pointer/address)
+  // bank, i.e. a CopyFromReg of a GPRB virtual register created by
+  // LowerFormalArguments for a pointer argument, a frame address
+  // materialized for a value use (FRAME_ADDR), or the result of a pointer add
+  // already selected to add.o (C1/C2/C14, ADR-0018).
+  bool isPointerBankValue(SDValue V) const;
+
+// Include the pieces autogenerated from the target description.
+#include "DADAOGenDAGISel.inc"
+};
+
+class DADAODAGToDAGISelLegacy : public SelectionDAGISelLegacy {
+public:
+  static char ID;
+  explicit DADAODAGToDAGISelLegacy(DADAOTargetMachine &TM)
+      : SelectionDAGISelLegacy(ID, std::make_unique<DADAODAGToDAGISel>(TM)) {}
+};
+
+char DADAODAGToDAGISelLegacy::ID;
+
+} // end anonymous namespace
+
+INITIALIZE_PASS(DADAODAGToDAGISelLegacy, DEBUG_TYPE, PASS_NAME, false, false)
+
+bool DADAODAGToDAGISel::isPointerBankValue(SDValue V) const {
+  // Pointers are legalized to i64 (C2) and only carry their bank in the
+  // virtual register created for the formal argument (LowerFormalArguments).
+  // At ISel time a pointer argument therefore appears as a CopyFromReg of a
+  // GPRB virtual register; that register class is the bank witness.
+  if (V.getOpcode() == ISD::CopyFromReg) {
+    const auto *RegNode = cast<RegisterSDNode>(V.getOperand(1));
+    const Register R = RegNode->getReg();
+    if (!R.isVirtual())
+      return false;
+    return MF->getRegInfo().getRegClass(R) == &DADAO::GPRBRegClass;
+  }
+  // An unselected i64 add is pointer-bank exactly when it will itself be
+  // selected to add.o: exactly one of its operands is pointer-bank.  ISel
+  // visits users before operands, so a chained GEP's inner add is still a raw
+  // ISD::ADD when the outer add is selected; this keeps the chain on the
+  // single-instruction path.  The test mirrors the selection rule below, so a
+  // node classified pointer-bank here really does become a GPRB add.o result.
+  if (V.getOpcode() == ISD::ADD && V.getValueType() == MVT::i64) {
+    const bool B0 = isPointerBankValue(V.getOperand(0));
+    const bool B1 = isPointerBankValue(V.getOperand(1));
+    return B0 != B1;
+  }
+  // A frame object address (alloca / stack slot used as a pointer value).
+  // ISel visits users before operands, so this is still a raw ISD::FrameIndex
+  // here; it is later materialized to FRAME_ADDR (GPRB, LLVM-038t) and the
+  // ReplaceNode updates our operand in place.
+  if (V.getOpcode() == ISD::FrameIndex)
+    return true;
+  // The address of a global/static object (LLVM-055t) is by definition a
+  // pointer-bank value; it is materialized to GLOBAL_ADDR (GPRB) below.
+  if (V.getOpcode() == ISD::GlobalAddress)
+    return true;
+  // Machine nodes whose result already lives in the GPRB bank: a frame object
+  // address materialized for a *value* use (FRAME_ADDR, LLVM-038t, e.g. an
+  // alloca used as a pointer) and the result of a pointer add already selected
+  // to add.o (chained GEPs).  Keeping these on the single-instruction path is
+  // what turns `base + offset` into one add.o instead of `rb2rd` + GPRD add +
+  // `rd2rb`.
+  if (V.getNode()->isMachineOpcode()) {
+    switch (V.getMachineOpcode()) {
+    case DADAO::FRAME_ADDR:
+    case DADAO::add_o_bbd:
+      return true;
+    default:
+      return false;
+    }
+  }
+  return false;
+}
+
+void DADAODAGToDAGISel::SelectConstant(SDNode *Node) {
+  const auto *C = cast<ConstantSDNode>(Node);
+  const SDLoc DL(Node);
+  // Materialize any i64 constant through CONST_WYDE (C12: set.zw/set.ow +
+  // or.w/andn.w, no constant pool).  The pseudo is expanded post-RA.
+  SDValue Val = CurDAG->getTargetConstant(C->getSExtValue(), DL, MVT::i64);
+  SDNode *M = CurDAG->getMachineNode(DADAO::CONST_WYDE, DL, MVT::i64, Val);
+  ReplaceNode(Node, M);
+}
+
+void DADAODAGToDAGISel::SelectPointerAdd(SDNode *N, SDValue Base,
+                                         SDValue Offset) {
+  const SDLoc DL(N);
+  // add.o rb, rb, rd: base in GPRB, offset in GPRD, result in GPRB
+  // (contract-isa.md §7.1; ADR-0012 D9.3: bbd = (rb dst, rb, rd)).
+  SDNode *M = CurDAG->getMachineNode(DADAO::add_o_bbd, DL, MVT::i64, Base,
+                                     Offset);
+  ReplaceNode(N, M);
+}
+
+void DADAODAGToDAGISel::SelectPointerSub(SDNode *N) {
+  const SDLoc DL(N);
+  // sub.o rd, rb, rb: two GPRB operands, GPRD result (LLVM-043t MC).
+  SDNode *M = CurDAG->getMachineNode(DADAO::sub_o_dbb, DL, MVT::i64,
+                                     N->getOperand(0), N->getOperand(1));
+  ReplaceNode(N, M);
+}
+
+bool DADAODAGToDAGISel::SelectAddr(SDValue Addr, SDValue &Base,
+                                   SDValue &Offset) {
+  const SDLoc DL(Addr);
+  const EVT VT = Addr.getValueType();
+
+  // A frame index stays in the base operand position; PrologEpilogInserter's
+  // eliminateFrameIndex later turns it into `[rbsp/rbfp, offset]`
+  // (ADR-0018 C7/C8, LLVM-038t).
+  if (auto *FIN = dyn_cast<FrameIndexSDNode>(Addr)) {
+    Base = CurDAG->getTargetFrameIndex(FIN->getIndex(), VT);
+    Offset = CurDAG->getTargetConstant(0, DL, VT);
+    return true;
+  }
+
+  // base + sign-extended 12-bit offset (folded into the memory immediate).
+  if (CurDAG->isBaseWithConstantOffset(Addr)) {
+    int64_t CVal = cast<ConstantSDNode>(Addr.getOperand(1))->getSExtValue();
+    if (isInt<12>(CVal)) {
+      SDValue B = Addr.getOperand(0);
+      if (auto *FIN = dyn_cast<FrameIndexSDNode>(B))
+        B = CurDAG->getTargetFrameIndex(FIN->getIndex(), VT);
+      Base = B;
+      Offset = CurDAG->getSignedTargetConstant(CVal, DL, VT);
+      return true;
+    }
+  }
+
+  // Plain base register (e.g. a pointer argument in GPRB).
+  Base = Addr;
+  Offset = CurDAG->getTargetConstant(0, DL, VT);
+  return true;
+}
+
+void DADAODAGToDAGISel::Select(SDNode *Node) {
+  if (Node->isMachineOpcode()) {
+    Node->setNodeId(-1);
+    return; // Already selected.
+  }
+
+  switch (Node->getOpcode()) {
+  case ISD::Constant:
+    if (Node->getValueType(0) == MVT::i64) {
+      SelectConstant(Node);
+      return;
+    }
+    break;
+  case ISD::FrameIndex: {
+    // A frame object address used as a value (not folded into a load/store
+    // address by SelectAddr): materialize it into a GPRB register.  The target
+    // frame index is resolved by eliminateFrameIndex (LLVM-038t).
+    auto *FIN = cast<FrameIndexSDNode>(Node);
+    SDValue TFI = CurDAG->getTargetFrameIndex(FIN->getIndex(), MVT::i64);
+    SDNode *M = CurDAG->getMachineNode(DADAO::FRAME_ADDR, SDLoc(Node),
+                                       MVT::i64, TFI);
+    ReplaceNode(Node, M);
+    return;
+  }
+  case ISD::GlobalAddress: {
+    // Absolute 48-bit address of a global/static object (LLVM-055t).  Fold any
+    // constant offset into the TargetGlobalAddress addend (carried as the RELA
+    // r_addend) so the address is materialized by the fixed 3-slice
+    // set.zw/or.w sequence (GLOBAL_ADDR).  The MC layer records each slice as
+    // R_DADAO_ABS48; because ABS48 is absolute it is *never* resolved in place
+    // (ADR-0019 D4/D7) -- a same-section absolute address is still a
+    // relocation, the section base being unknown until link time.
+    auto *GA = cast<GlobalAddressSDNode>(Node);
+    SDValue Sym = CurDAG->getTargetGlobalAddress(
+        GA->getGlobal(), SDLoc(Node), MVT::i64, GA->getOffset());
+    SDNode *M =
+        CurDAG->getMachineNode(DADAO::GLOBAL_ADDR, SDLoc(Node), MVT::i64, Sym);
+    ReplaceNode(Node, M);
+    return;
+  }
+  case ISD::ADD:
+    // Bank-aware ptr + offset (C14 D1 / ADR-0018): add.o rb, rb, rd is exactly
+    // base(rb) + offset(rd) -> rb (contract-isa.md §7.1; ADR-0012 D9.3).  When
+    // exactly one operand is a pointer-bank value, use it as the base and keep
+    // the result in GPRB; the other operand (the offset) stays a GPRD value.
+    // A plain i64 add whose operands are both data values falls through to the
+    // ADD_PSEUDO pattern.  When *both* operands are in GPRB (address + address,
+    // which C14 D5 does not model) we also fall back: add.o takes only one RB
+    // operand.
+    if (Node->getValueType(0) == MVT::i64) {
+      const bool Base0 = isPointerBankValue(Node->getOperand(0));
+      const bool Base1 = isPointerBankValue(Node->getOperand(1));
+      if (Base0 != Base1) {
+        SDValue Base = Base0 ? Node->getOperand(0) : Node->getOperand(1);
+        SDValue Offset = Base0 ? Node->getOperand(1) : Node->getOperand(0);
+        SelectPointerAdd(Node, Base, Offset);
+        return;
+      }
+    }
+    break;
+  case ISD::SUB:
+    // Bank-aware ptr − ptr (C14 / ADR-0018): when both operands are still in
+    // the GPRB bank, select the single sub.o rd, rb, rb.  A plain i64
+    // subtraction falls through to the SUB_PSEUDO pattern.
+    if (Node->getValueType(0) == MVT::i64 &&
+        isPointerBankValue(Node->getOperand(0)) &&
+        isPointerBankValue(Node->getOperand(1))) {
+      SelectPointerSub(Node);
+      return;
+    }
+    break;
+  case DADAOISD::CALL: {
+    // Call (LLVM-039t direct; M6 adds indirect): the DADAOISD::CALL operands
+    // are chain, callee, [RegisterMask], [argument Registers...], [glue].
+    // A direct callee is a TargetGlobalAddress/TargetExternalSymbol and is
+    // selected to call_iiii (PC-relative 24-bit).  An indirect callee is a
+    // Register (the target address, already in GPRB) and is selected to
+    // call_rrii with Addr = rbha + rdhb + (imms12 << 2), rdhb = rd0, imm = 0.
+    // The remaining register/regmask operands are carried through so
+    // InstrEmitter marks the exact live-in argument registers implicit-use and
+    // attaches the call-clobber mask (DL-065a, ML-004c).  Chain/glue must
+    // trail the operand list (InstrEmitter::AddOperand invariant).
+    SDValue Callee = Node->getOperand(1);
+    const bool Direct = Callee.getOpcode() == ISD::TargetGlobalAddress ||
+                        Callee.getOpcode() == ISD::TargetExternalSymbol;
+    if (!Direct && Callee.getOpcode() != ISD::Register)
+      report_fatal_error("DADAO: unsupported call callee");
+
+    const SDLoc DLC(Node);
+    SDValue Chain = Node->getOperand(0);
+    const unsigned NumOps = Node->getNumOperands();
+    const bool HasGlue =
+        NumOps > 2 && Node->getOperand(NumOps - 1).getValueType() == MVT::Glue;
+    const unsigned NumExtra = NumOps - 2 - (HasGlue ? 1 : 0);
+
+    SmallVector<SDValue, 8> Ops;
+    if (Direct) {
+      Ops.push_back(Callee);
+    } else {
+      // call_rrii rbTarget, rd0, 0
+      Ops.push_back(Callee);
+      Ops.push_back(CurDAG->getRegister(DADAO::rd0, MVT::i64));
+      Ops.push_back(CurDAG->getTargetConstant(0, DLC, MVT::i64));
+    }
+    for (unsigned i = 0; i < NumExtra; ++i)
+      Ops.push_back(Node->getOperand(2 + i));
+    Ops.push_back(Chain);
+    if (HasGlue)
+      Ops.push_back(Node->getOperand(NumOps - 1));
+
+    MachineSDNode *Call = CurDAG->getMachineNode(
+        Direct ? DADAO::call_iiii : DADAO::call_rrii, DLC, MVT::Other,
+        MVT::Glue, Ops);
+    ReplaceNode(Node, Call);
+    return;
+  }
+  case DADAOISD::CMPU:
+    // Pointer comparison (C14 D2 / C17 `p == q`): cmp.uo rd, rb, rb when both
+    // operands are in the GPRB bank.  Integer compares fall through to the
+    // GPRD cmp_uo/cmp_ui patterns.
+    if (isPointerBankValue(Node->getOperand(0)) &&
+        isPointerBankValue(Node->getOperand(1))) {
+      SDNode *M = CurDAG->getMachineNode(DADAO::cmp_uo_dbb, SDLoc(Node),
+                                         MVT::i64, Node->getOperand(0),
+                                         Node->getOperand(1));
+      ReplaceNode(Node, M);
+      return;
+    }
+    break;
+  case DADAOISD::BRZ:
+  case DADAOISD::BRNZ:
+    // Zero-test on a pointer (C17 `p == NULL`): br.z/br.nz {rb} is a single
+    // instruction, so keep the operand in the RB bank instead of copying it
+    // to GPRD for the plain br.z/br.nz rd form.
+    if (isPointerBankValue(Node->getOperand(1))) {
+      const unsigned Opc = Node->getOpcode() == DADAOISD::BRZ
+                               ? DADAO::br_z_rb
+                               : DADAO::br_nz_rb;
+      // The input chain is carried as the machine node's last operand (as the
+      // generated matcher does for chained nodes).
+      CurDAG->SelectNodeTo(Node, Opc, MVT::Other, Node->getOperand(1),
+                           Node->getOperand(2), Node->getOperand(0));
+      return;
+    }
+    break;
+  default:
+    break;
+  }
+
+  SelectCode(Node);
+}
+
+FunctionPass *llvm::createDADAOISelDag(DADAOTargetMachine &TM) {
+  return new DADAODAGToDAGISelLegacy(TM);
+}
