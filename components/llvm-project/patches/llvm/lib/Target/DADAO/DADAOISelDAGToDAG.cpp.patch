+//===----------------------------------------------------------------------===//
+//
+// DADAO DAG-to-DAG instruction selector (M3 skeleton, LLVM-033t; i64
+// arithmetic, LLVM-035t).  It wires the TableGen-generated matcher
+// (DADAOGenDAGISel.inc) and additionally handles the two nodes that cannot be
+// expressed as TableGen patterns:
+//   - ISD::Constant  -> CONST_WYDE pseudo (64-bit materialization, C12)
+//   - ptr − ptr      -> sub.o rd, rb, rb (bank-aware, C14 / ADR-0018)
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOISelLowering.h"
+#include "DADAOSubtarget.h"
+#include "DADAOTargetMachine.h"
+#include "DADAO.h"
+
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineRegisterInfo.h"
+#include "llvm/CodeGen/SelectionDAGISel.h"
+#include "llvm/CodeGen/SelectionDAGNodes.h"
+#include "llvm/Support/Debug.h"
+
+// Instruction opcodes (DADAO::RET_PSEUDO, ...) used by the generated matcher.
+#define GET_INSTRINFO_ENUM
+#include "DADAOGenInstrInfo.inc"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "dadao-isel"
+#define PASS_NAME "DADAO DAG->DAG Pattern Instruction Selection"
+
+namespace {
+
+class DADAODAGToDAGISel : public SelectionDAGISel {
+public:
+  DADAODAGToDAGISel() = delete;
+
+  explicit DADAODAGToDAGISel(DADAOTargetMachine &TM)
+      : SelectionDAGISel(TM) {}
+
+  void Select(SDNode *N) override;
+
+private:
+  // i64 constant materialization (CONST_WYDE pseudo, C12 / ADR-0018).
+  void SelectConstant(SDNode *N);
+  // ptr − ptr selection to sub.o rd, rb, rb (C14 / ADR-0018).
+  void SelectPointerSub(SDNode *N);
+  // True if V is an i64 value currently held in the GPRB (pointer/address)
+  // bank, i.e. a CopyFromReg of a GPRB virtual register created by
+  // LowerFormalArguments for a pointer argument (C1/C2, ADR-0018).
+  bool isPointerBankValue(SDValue V) const;
+
+// Include the pieces autogenerated from the target description.
+#include "DADAOGenDAGISel.inc"
+};
+
+class DADAODAGToDAGISelLegacy : public SelectionDAGISelLegacy {
+public:
+  static char ID;
+  explicit DADAODAGToDAGISelLegacy(DADAOTargetMachine &TM)
+      : SelectionDAGISelLegacy(ID, std::make_unique<DADAODAGToDAGISel>(TM)) {}
+};
+
+char DADAODAGToDAGISelLegacy::ID;
+
+} // end anonymous namespace
+
+INITIALIZE_PASS(DADAODAGToDAGISelLegacy, DEBUG_TYPE, PASS_NAME, false, false)
+
+bool DADAODAGToDAGISel::isPointerBankValue(SDValue V) const {
+  // Pointers are legalized to i64 (C2) and only carry their bank in the
+  // virtual register created for the formal argument (LowerFormalArguments).
+  // At ISel time a pointer argument therefore appears as a CopyFromReg of a
+  // GPRB virtual register; that register class is the bank witness.
+  if (V.getOpcode() != ISD::CopyFromReg)
+    return false;
+  const auto *RegNode = cast<RegisterSDNode>(V.getOperand(1));
+  const Register R = RegNode->getReg();
+  if (!R.isVirtual())
+    return false;
+  return MF->getRegInfo().getRegClass(R) == &DADAO::GPRBRegClass;
+}
+
+void DADAODAGToDAGISel::SelectConstant(SDNode *Node) {
+  const auto *C = cast<ConstantSDNode>(Node);
+  const SDLoc DL(Node);
+  // Materialize any i64 constant through CONST_WYDE (C12: set.zw/set.ow +
+  // or.w/andn.w, no constant pool).  The pseudo is expanded post-RA.
+  SDValue Val = CurDAG->getTargetConstant(C->getSExtValue(), DL, MVT::i64);
+  SDNode *M = CurDAG->getMachineNode(DADAO::CONST_WYDE, DL, MVT::i64, Val);
+  ReplaceNode(Node, M);
+}
+
+void DADAODAGToDAGISel::SelectPointerSub(SDNode *N) {
+  const SDLoc DL(N);
+  // sub.o rd, rb, rb: two GPRB operands, GPRD result (LLVM-043t MC).
+  SDNode *M = CurDAG->getMachineNode(DADAO::sub_o_dbb, DL, MVT::i64,
+                                     N->getOperand(0), N->getOperand(1));
+  ReplaceNode(N, M);
+}
+
+void DADAODAGToDAGISel::Select(SDNode *Node) {
+  if (Node->isMachineOpcode()) {
+    Node->setNodeId(-1);
+    return; // Already selected.
+  }
+
+  switch (Node->getOpcode()) {
+  case ISD::Constant:
+    if (Node->getValueType(0) == MVT::i64) {
+      SelectConstant(Node);
+      return;
+    }
+    break;
+  case ISD::SUB:
+    // Bank-aware ptr − ptr (C14 / ADR-0018): when both operands are still in
+    // the GPRB bank, select the single sub.o rd, rb, rb.  A plain i64
+    // subtraction falls through to the SUB_PSEUDO pattern.
+    if (Node->getValueType(0) == MVT::i64 &&
+        isPointerBankValue(Node->getOperand(0)) &&
+        isPointerBankValue(Node->getOperand(1))) {
+      SelectPointerSub(Node);
+      return;
+    }
+    break;
+  default:
+    break;
+  }
+
+  SelectCode(Node);
+}
+
+FunctionPass *llvm::createDADAOISelDag(DADAOTargetMachine &TM) {
+  return new DADAODAGToDAGISelLegacy(TM);
+}
