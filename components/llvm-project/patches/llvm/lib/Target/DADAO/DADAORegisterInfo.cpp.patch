+const MCPhysReg *
+DADAORegisterInfo::getCalleeSavedRegs(const MachineFunction * /*MF*/) const {
+  // CSR = rd32..rd63 ∪ rb32..rb63 (contract-abi.md §4.5, ADR-0018 C6).
+  // SP (rb1) is not part of the generic CSR (maintained symmetrically by the
+  // prologue/epilogue).  FP (rb63) is *always* callee-saved: when hasFP it is
+  // saved by the prologue to its own dedicated slot (st.o rb63, [sp, -8]);
+  // otherwise it is an ordinary CSR member and spilled like any other.
+  //
+  // The list is returned in DESCENDING register order (see below).  The set is
+  // exactly CSR = rd32..rd63 ∪ rb32..rb63 (contract-abi.md §4.5, C6); only the
+  // order differs, so getCallPreservedMask's CSR_RegMask (order-independent)
+  // is unchanged.
+  //
+  // NB (contract-isa.md §15.1, rule `mreg_range_overflow`): the `ldm.*`/`stm.*`
+  // immediate encodes a contiguous register range that must satisfy
+  // `start + immu6 <= 64` (no wrap, no truncation).  rb63 is the highest RB
+  // number, so it may only appear as the *last* element (or a singleton) of a
+  // batch range, never as the start of a multi-register range.  A batch
+  // {rb32..rb63} (start = 32, immu6 = 32 -> 32 + 32 = 64) is legal.
+  //
+  // DESCENDING order (highest register first) makes the PEI-assigned spill
+  // slots ascend with register number, so a contiguous register run occupies
+  // consecutive ascending offsets and can be covered by one stm.o/ldm.o
+  // (DADAOFrameLowering::emitCalleeSavedRegs), which maps register i to
+  // base + offset + i*8.  With the natural ascending order the offsets descend
+  // and no single-range batch is possible.
+  static const MCPhysReg ReversedCSR[] = {
+#define CSR_ENTRY(reg) DADAO::reg,
+      CSR_ENTRY(rb63) CSR_ENTRY(rb62) CSR_ENTRY(rb61) CSR_ENTRY(rb60)
+      CSR_ENTRY(rb59) CSR_ENTRY(rb58) CSR_ENTRY(rb57) CSR_ENTRY(rb56)
+      CSR_ENTRY(rb55) CSR_ENTRY(rb54) CSR_ENTRY(rb53) CSR_ENTRY(rb52)
+      CSR_ENTRY(rb51) CSR_ENTRY(rb50) CSR_ENTRY(rb49) CSR_ENTRY(rb48)
+      CSR_ENTRY(rb47) CSR_ENTRY(rb46) CSR_ENTRY(rb45) CSR_ENTRY(rb44)
+      CSR_ENTRY(rb43) CSR_ENTRY(rb42) CSR_ENTRY(rb41) CSR_ENTRY(rb40)
+      CSR_ENTRY(rb39) CSR_ENTRY(rb38) CSR_ENTRY(rb37) CSR_ENTRY(rb36)
+      CSR_ENTRY(rb35) CSR_ENTRY(rb34) CSR_ENTRY(rb33) CSR_ENTRY(rb32)
+      CSR_ENTRY(rd63) CSR_ENTRY(rd62) CSR_ENTRY(rd61) CSR_ENTRY(rd60)
+      CSR_ENTRY(rd59) CSR_ENTRY(rd58) CSR_ENTRY(rd57) CSR_ENTRY(rd56)
+      CSR_ENTRY(rd55) CSR_ENTRY(rd54) CSR_ENTRY(rd53) CSR_ENTRY(rd52)
+      CSR_ENTRY(rd51) CSR_ENTRY(rd50) CSR_ENTRY(rd49) CSR_ENTRY(rd48)
+      CSR_ENTRY(rd47) CSR_ENTRY(rd46) CSR_ENTRY(rd45) CSR_ENTRY(rd44)
+      CSR_ENTRY(rd43) CSR_ENTRY(rd42) CSR_ENTRY(rd41) CSR_ENTRY(rd40)
+      CSR_ENTRY(rd39) CSR_ENTRY(rd38) CSR_ENTRY(rd37) CSR_ENTRY(rd36)
+      CSR_ENTRY(rd35) CSR_ENTRY(rd34) CSR_ENTRY(rd33) CSR_ENTRY(rd32)
+#undef CSR_ENTRY
+      0};
+  return ReversedCSR;
+}
+
+const uint32_t *
+DADAORegisterInfo::getCallPreservedMask(const MachineFunction & /*MF*/,
+                                        CallingConv::ID /*CC*/) const {
+  // Call-preserved set = CSR.  It MUST include rb32..rb63: otherwise a GPRB
+  // (address-bank) callee-saved value computed before a call would be silently
+  // clobbered (ML-004c, ADR-0018 C16).  Attached as the call instruction's
+  // RegisterMask operand by LowerCall.
+  return CSR_RegMask;
+}
+
+BitVector
+DADAORegisterInfo::getReservedRegs(const MachineFunction &MF) const {
+  BitVector Reserved(getNumRegs());
+  // rd0 = hardwired zero (contract-isa.md §1.3.1)
+  Reserved.set(DADAO::rd0);
+  // rb0 = PC (contract-isa.md §1.3.2)
+  Reserved.set(DADAO::rb0);
+  // rb1 = SP (contract-abi.md §2.1)
+  Reserved.set(DADAO::rb1);
+  // rb2 = GP (global pointer), rb3 = TP (thread pointer): reserved, not
+  // allocatable (contract-abi.md §1.6; ADR-0018 C7 D6 rev. 2026-10-09).
+  Reserved.set(DADAO::rb2);
+  Reserved.set(DADAO::rb3);
+  // rd1 = error number (rderrno); rd2–rd3 = reserved (debug/test only).
+  // rd4–rd7 are temporary (caller-saved) and allocatable.
+  for (unsigned i = DADAO::rd1; i <= DADAO::rd3; ++i)
+    Reserved.set(i);
+  // FP (rb63) is CONDITIONALLY reserved: reserve it iff this function builds a
+  // frame pointer.  Otherwise rb63 is a general callee-saved register.
+  //
+  // INVARIANT: this must use the *same* hasFP(MF) test as getFrameRegister, on
+  // the *same* MachineFunction — otherwise the allocator and the frame layout
+  // would disagree on whether rb63 is the FP (a mismatch silently corrupts the
+  // frame).  Both call TFI->hasFP(MF); hasFPImpl's inputs (var-sized objects /
+  // frame address taken / stack realignment / -fno-omit-frame-pointer) are
+  // finalized by SelectionDAG before reserved regs are frozen, so the answer is
+  // stable across RA and PEI.
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+  if (TFI->hasFP(MF))
+    Reserved.set(DADAO::rb63);
+  // RF and RA are entirely non-allocatable in M1
+  for (unsigned i = DADAO::rf0; i <= DADAO::rf63; ++i)
+    Reserved.set(i);
+  for (unsigned i = DADAO::ra0; i <= DADAO::ra63; ++i)
+    Reserved.set(i);
+  return Reserved;
+}
+
+bool DADAORegisterInfo::eliminateFrameIndex(
+    MachineBasicBlock::iterator II, int SPAdj, unsigned FIOperandNum,
+    RegScavenger *RS) const {
+  assert(SPAdj == 0 && "DADAO does not use SP-relative call frame pseudos yet");
+  MachineInstr &MI = *II;
+  MachineBasicBlock &MBB = *MI.getParent();
+  MachineFunction &MF = *MBB.getParent();
+  const DADAOSubtarget &ST = MF.getSubtarget<DADAOSubtarget>();
+  const DADAOInstrInfo &TII = *ST.getInstrInfo();
+  const DADAOFrameLowering *TFI = ST.getFrameLowering();
+  const DebugLoc &DL = MI.getDebugLoc();
+
+  assert(MI.getOperand(FIOperandNum).isFI() &&
+         "eliminateFrameIndex: expected a frame index operand");
+  const int FI = MI.getOperand(FIOperandNum).getIndex();
+
+  // ADR-0018 C7 D4 form 3 (large frame): materialize an out-of-simm18 byte
+  // offset in a scavenged GPRD scratch and fold it into the frame register
+  // with `add.o`:
+  //   set.zw/or.w scratchRD, <offset>      ; 64-bit offset constant
+  //   add.o scratchRB, <frame reg>, scratchRD
+  // Returns the GPRB register holding base + offset.  Used when the offset is
+  // outside the simm18 `add.si` range of form 2, so it covers any frame size
+  // (ISS-138).  Both scratch registers are marked used so a second scavenge
+  // cannot hand out the same physical register twice.
+  auto materializeLargeOffset = [&](Register FrameReg, int64_t Offset) {
+    assert(RS && "large frame offsets require register scavenging");
+    Register ScratchRD = RS->scavengeRegisterBackwards(
+        DADAO::GPRD_AllocatableRegClass, II, /*RestoreAfter=*/false, SPAdj);
+    if (!ScratchRD)
+      report_fatal_error("DADAO: unable to scavenge a data register for a "
+                         "large frame offset");
+    RS->setRegUsed(ScratchRD);
+    TII.materializeImm64(MBB, II, DL, ScratchRD, Offset);
+
+    Register ScratchRB = RS->scavengeRegisterBackwards(
+        DADAO::GPRB_AllocatableRegClass, II, /*RestoreAfter=*/false, SPAdj);
+    if (!ScratchRB)
+      report_fatal_error("DADAO: unable to scavenge an address register for a "
+                         "large frame offset");
+    RS->setRegUsed(ScratchRB);
+    BuildMI(MBB, II, DL, TII.get(DADAO::add_o_bbd), ScratchRB)
+        .addReg(FrameReg)
+        .addReg(ScratchRD, RegState::Kill);
+    return ScratchRB;
+  };
+
+  if (MI.getOpcode() == DADAO::FRAME_ADDR) {
+    // Materialize a frame address into the destination GPRB register.
+    Register Dst = MI.getOperand(0).getReg();
+    Register FrameReg;
+    StackOffset SO = TFI->getFrameIndexReference(MF, FI, FrameReg);
+    const int64_t Offset = SO.getFixed() + SPAdj;
+    if (isInt<18>(Offset)) {
+      // Form 2: rb2rb dst, <frame reg>; add.si dst, <offset> (in place, ±128K).
+      if (Dst != FrameReg)
+        BuildMI(MBB, II, DL, TII.get(DADAO::rb2rb), Dst)
+            .addReg(FrameReg)
+            .addImm(1);
+      if (Offset != 0)
+        BuildMI(MBB, II, DL, TII.get(DADAO::add_si_rb), Dst).addImm(Offset);
+    } else {
+      // Form 3: constant + add.o, then copy into the destination bank slot.
+      Register ScratchRB = materializeLargeOffset(FrameReg, Offset);
+      if (Dst != ScratchRB)
+        BuildMI(MBB, II, DL, TII.get(DADAO::rb2rb), Dst)
+            .addReg(ScratchRB)
+            .addImm(1);
+    }
+    MI.eraseFromParent();
+    return true;
+  }
+
+  // Load/store (including the RA spill/reload instructions from
+  // storeRegToStackSlot/loadRegFromStackSlot): operand FIOperandNum is the
+  // GPRB base and FIOperandNum+1 the simm12 offset.
+  Register FrameReg;
+  StackOffset SO = TFI->getFrameIndexReference(MF, FI, FrameReg);
+  const int64_t FrameOffset = SO.getFixed() + SPAdj;
+  assert(FIOperandNum + 1 < MI.getNumOperands() &&
+         "eliminateFrameIndex: missing offset operand");
+  const int64_t GEPOffset = MI.getOperand(FIOperandNum + 1).getImm();
+  const int64_t Total = FrameOffset + GEPOffset;
+
+  if (isInt<12>(Total)) {
+    // The whole address fits `[base, simm12]`: fold it directly (form 1).
+    MI.getOperand(FIOperandNum).ChangeToRegister(FrameReg, /*isDef=*/false);
+    MI.getOperand(FIOperandNum + 1).ChangeToImmediate(Total);
+    return false;
+  }
+
+  // The offset does not fit the load/store immediate.
+  if (!RS)
+    report_fatal_error("DADAO: frame offset needs a scratch register but no "
+                       "register scavenger is available");
+
+  Register Scratch;
+  if (isInt<18>(Total)) {
+    // Form 2: materialize the address in a scavenged RB register:
+    //   rb2rb scratch, <frame reg>
+    //   add.si scratch, <offset>          (in place, ±128K)
+    Scratch = RS->scavengeRegisterBackwards(DADAO::GPRBRegClass, II,
+                                            /*RestoreAfter=*/false, SPAdj);
+    if (!Scratch)
+      report_fatal_error("DADAO: unable to scavenge a register for a large "
+                         "frame offset");
+    RS->setRegUsed(Scratch);
+    BuildMI(MBB, II, DL, TII.get(DADAO::rb2rb), Scratch)
+        .addReg(FrameReg)
+        .addImm(1);
+    BuildMI(MBB, II, DL, TII.get(DADAO::add_si_rb), Scratch).addImm(Total);
+  } else {
+    // Form 3: constant + add.o (any offset, including beyond ±128K).
+    Scratch = materializeLargeOffset(FrameReg, Total);
+  }
+  MI.getOperand(FIOperandNum).ChangeToRegister(Scratch, /*isDef=*/false);
+  MI.getOperand(FIOperandNum + 1).ChangeToImmediate(0);
+  return false;
+}
+
+Register
+DADAORegisterInfo::getFrameRegister(const MachineFunction &MF) const {
+  // ADR-0018 C7 D3/C7 D6 rev. 2026-10-09: `hasFP ? rb63 : rb1`.
+  // Keep this hasFP(MF) test identical to getReservedRegs' rb63 reservation.
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+  return TFI->hasFP(MF) ? DADAO::rb63 : DADAO::rb1; // FP = rb63, SP = rb1
+}
