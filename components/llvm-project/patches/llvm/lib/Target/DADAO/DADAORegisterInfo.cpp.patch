+// Register enum (DADAO::rd0, DADAO::rb1, ...) comes from DADAOInstrInfo.h's
+// GET_REGINFO_ENUM.  The instruction opcode enum used by eliminateFrameIndex
+// (DADAO::add_si_rb, DADAO::rb2rb, ...) needs GET_INSTRINFO_ENUM here.
+#define GET_INSTRINFO_ENUM
+#include "DADAOGenInstrInfo.inc"
+#undef GET_INSTRINFO_ENUM
