+using namespace llvm;
+
+DADAORegisterInfo::DADAORegisterInfo()
+    : DADAOGenRegisterInfo(DADAO::RBSP /* RA = SP */) {}
+
+const MCPhysReg *
+DADAORegisterInfo::getCalleeSavedRegs(const MachineFunction * /*MF*/) const {
+  // CSR = rd32..rd63 ∪ rb32..rb63 (contract-abi.md §4.5, ADR-0018 C6).
+  // SP (rb1) is not part of the generic CSR (maintained symmetrically by the
+  // prologue/epilogue); FP (rb2) is reserved and saved separately.
+  return CSR_SaveList;
+}
+
+const uint32_t *
+DADAORegisterInfo::getCallPreservedMask(const MachineFunction & /*MF*/,
+                                        CallingConv::ID /*CC*/) const {
+  // Call-preserved set = CSR.  It MUST include rb32..rb63: otherwise a GPRB
+  // (address-bank) callee-saved value computed before a call would be silently
+  // clobbered (ML-004c, ADR-0018 C16).  Attached as the call instruction's
+  // RegisterMask operand by LowerCall.
+  return CSR_RegMask;
+}
+
+BitVector
+DADAORegisterInfo::getReservedRegs(const MachineFunction & /*MF*/) const {
+  BitVector Reserved(getNumRegs());
+  // rd0 = hardwired zero (contract-isa.md §1.3.1)
+  Reserved.set(DADAO::rd0);
+  // rb0 = PC (contract-isa.md §1.3.2)
+  Reserved.set(DADAO::rb0);
+  // rb1 = SP (contract-abi.md §2.1)
+  // N2 fix: use actual register enum (68), not DwarfRegAlias RBSP (2).
+  Reserved.set(DADAO::rb1);
+  // rb2 = FP (contract-abi.md §2.1)
+  // N2 fix: use actual register enum (69), not DwarfRegAlias RBFP (1).
+  Reserved.set(DADAO::rb2);
+  // rd1–rd7: rd1 = error number (Callee-saved '-' → conservative no-alloc);
+  // rd2–rd7 = reserved (compiler must not allocate). ADR-0018 C7 D6.
+  for (unsigned i = DADAO::rd1; i <= DADAO::rd7; ++i)
+    Reserved.set(i);
+  // rb3–rb7: rb3 = GP, rb4 = TP (Callee-saved '-' → conservative no-alloc);
+  // rb5–rb7 = reserved. ADR-0018 C7 D6.
+  for (unsigned i = DADAO::rb3; i <= DADAO::rb7; ++i)
+    Reserved.set(i);
+  // RF and RA are entirely non-allocatable in M1
+  for (unsigned i = DADAO::rf0; i <= DADAO::rf63; ++i)
+    Reserved.set(i);
+  for (unsigned i = DADAO::ra0; i <= DADAO::ra63; ++i)
+    Reserved.set(i);
+  return Reserved;
+}
+
+bool DADAORegisterInfo::eliminateFrameIndex(
+    MachineBasicBlock::iterator II, int SPAdj, unsigned FIOperandNum,
+    RegScavenger *RS) const {
+  assert(SPAdj == 0 && "DADAO does not use SP-relative call frame pseudos yet");
+  MachineInstr &MI = *II;
+  MachineBasicBlock &MBB = *MI.getParent();
+  MachineFunction &MF = *MBB.getParent();
+  const DADAOSubtarget &ST = MF.getSubtarget<DADAOSubtarget>();
+  const DADAOInstrInfo &TII = *ST.getInstrInfo();
+  const DADAOFrameLowering *TFI = ST.getFrameLowering();
+  const DebugLoc &DL = MI.getDebugLoc();
+
+  assert(MI.getOperand(FIOperandNum).isFI() &&
+         "eliminateFrameIndex: expected a frame index operand");
+  const int FI = MI.getOperand(FIOperandNum).getIndex();
+
+  if (MI.getOpcode() == DADAO::FRAME_ADDR) {
+    // Materialize a frame address into the destination GPRB register:
+    //   rb2rb dst, <frame reg>
+    //   add.si dst, <frame offset>        (in place; ADR-0018 C7 D4 scheme 2)
+    Register Dst = MI.getOperand(0).getReg();
+    Register FrameReg;
+    StackOffset SO = TFI->getFrameIndexReference(MF, FI, FrameReg);
+    const int64_t Offset = SO.getFixed() + SPAdj;
+    if (!isInt<18>(Offset))
+      report_fatal_error("DADAO: frame address offset out of the 18-bit "
+                         "add.si range (large-frame scheme 1 not implemented)");
+    if (Dst != FrameReg)
+      BuildMI(MBB, II, DL, TII.get(DADAO::rb2rb), Dst)
+          .addReg(FrameReg)
+          .addImm(1);
+    if (Offset != 0)
+      BuildMI(MBB, II, DL, TII.get(DADAO::add_si_rb), Dst).addImm(Offset);
+    MI.eraseFromParent();
+    return true;
+  }
+
+  // Load/store (including the RA spill/reload instructions from
+  // storeRegToStackSlot/loadRegFromStackSlot): operand FIOperandNum is the
+  // GPRB base and FIOperandNum+1 the simm12 offset.
+  Register FrameReg;
+  StackOffset SO = TFI->getFrameIndexReference(MF, FI, FrameReg);
+  const int64_t FrameOffset = SO.getFixed() + SPAdj;
+  assert(FIOperandNum + 1 < MI.getNumOperands() &&
+         "eliminateFrameIndex: missing offset operand");
+  const int64_t GEPOffset = MI.getOperand(FIOperandNum + 1).getImm();
+  const int64_t Total = FrameOffset + GEPOffset;
+
+  if (isInt<12>(Total)) {
+    // The whole address fits `[base, simm12]`: fold it directly.
+    MI.getOperand(FIOperandNum).ChangeToRegister(FrameReg, /*isDef=*/false);
+    MI.getOperand(FIOperandNum + 1).ChangeToImmediate(Total);
+    return false;
+  }
+
+  // The offset does not fit the load/store immediate.  Materialize the
+  // address in a scavenged RB register:
+  //   rb2rb scratch, <frame reg>
+  //   add.si scratch, <offset>          (in place, ±128K; scheme 2)
+  if (!RS)
+    report_fatal_error("DADAO: frame offset needs a scratch register but no "
+                       "register scavenger is available");
+  if (!isInt<18>(Total))
+    report_fatal_error("DADAO: frame offset exceeds the 18-bit add.si range "
+                       "(large-frame scheme 1 not implemented)");
+  Register Scratch = RS->scavengeRegisterBackwards(
+      DADAO::GPRBRegClass, II, /*RestoreAfter=*/false, SPAdj);
+  if (!Scratch)
+    report_fatal_error("DADAO: unable to scavenge a register for a large "
+                       "frame offset");
+  RS->setRegUsed(Scratch);
+  BuildMI(MBB, II, DL, TII.get(DADAO::rb2rb), Scratch)
+      .addReg(FrameReg)
+      .addImm(1);
+  BuildMI(MBB, II, DL, TII.get(DADAO::add_si_rb), Scratch).addImm(Total);
+  MI.getOperand(FIOperandNum).ChangeToRegister(Scratch, /*isDef=*/false);
+  MI.getOperand(FIOperandNum + 1).ChangeToImmediate(0);
+  return false;
+}
+
+Register
+DADAORegisterInfo::getFrameRegister(const MachineFunction &MF) const {
+  // ADR-0018 C7 D3: `hasFP ? rb2 : rb1` (replaces the old unconditional rb2).
+  const TargetFrameLowering *TFI = MF.getSubtarget().getFrameLowering();
+  return TFI->hasFP(MF) ? DADAO::rb2 : DADAO::rb1; // FP = rb2, SP = rb1
+}
