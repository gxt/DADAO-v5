+//===-- DADAOAsmPrinter.h - DADAO LLVM Assembly Printer --------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// DADAO assembly printer: lowers each MachineInstr to an MCInst and emits it
+// through the MC streamer (LLVM-040t).  CodeGen-only pseudos are expanded
+// before this pass (DADAOInstrInfo::expandPostRAPseudo, PrologEpilogInserter),
+// so no `*_PSEUDO` may reach emitInstruction.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_DADAO_DADAOASMPRINTER_H
+#define LLVM_LIB_TARGET_DADAO_DADAOASMPRINTER_H
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include "MCTargetDesc/DADAOMCAsmInfo.h"
+#include "llvm/MC/MCStreamer.h"
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+
+namespace llvm {
+
+class DADAOMCInstLower;
+class GlobalValue;
+class MCExpr;
+class MachineFunction;
+
+class DADAOAsmPrinter : public AsmPrinter {
+  std::unique_ptr<DADAOMCInstLower> MCInstLowering;
+
+  /// One `.got` slot: an 8-byte data field emitted once per referenced symbol
+  /// (and per referenced jump table).  `Spec` selects the recorded relocation
+  /// kind: none => R_DADAO_ABS48 (a plain absolute address, LLVM-094t); one of
+  /// the TLS specifiers => the matching R_DADAO_TLS_* dynamic relocation
+  /// (LLVM-117t; contract-dynlink.md §4.3).
+  struct GOTSlot {
+    MCSymbol *Slot;      ///< Label defined in `.got`.
+    const MCExpr *Value; ///< Slot content (`sym (+ offset)`, or the table label).
+    DADAO::Specifier Spec = DADAO::S_None; ///< Data-relocation kind.
+  };
+
+  /// Slots keyed by (global value, constant offset) and by the jump-table
+  /// label.  The jump table is keyed by its *symbol* rather than by its index:
+  /// `MachineJumpTableInfo` indices restart at 0 for every function, so two
+  /// functions with a switch each would collide on index 0 and the second one
+  /// would silently receive the first table's address.
+  /// `mutable` because the (const) MCInstLower asks for a slot while lowering
+  /// an instruction; the slots are emitted in `emitEndOfAsmFile`.
+  mutable DenseMap<std::pair<const GlobalValue *, int64_t>, GOTSlot> GOTSlots;
+  mutable DenseMap<const MCSymbol *, GOTSlot> GOTJumpTableSlots;
+  /// TLS slots (LLVM-117t).  One TPREL slot per (symbol, offset) for the
+  /// initial-exec model; for the global-dynamic model one `tls_index` pair
+  /// (module id + module offset) plus one pointer slot holding the pair's
+  /// address, which is what `__tls_get_addr` receives.
+  mutable DenseMap<std::pair<const GlobalValue *, int64_t>, GOTSlot>
+      TLSGOTSlots;
+  mutable DenseMap<const GlobalValue *, GOTSlot> TLSGDIndexSlots;
+  /// Emission order (= order of first reference), so the output is stable.
+  mutable SmallVector<GOTSlot, 8> GOTSlotOrder;
+  /// Slot-name counter.  Deliberately *not* reset per module: one MCContext may
+  /// serve several modules (LTO), and reusing a name would define a symbol
+  /// twice in the same object.
+  mutable unsigned GOTSlotNextId = 0;
+
+  MCSymbol *createGOTSlot(const MCExpr *Value,
+                          DADAO::Specifier Spec = DADAO::S_None) const;
+
+public:
+  static char ID;
+
+  DADAOAsmPrinter(TargetMachine &TM, std::unique_ptr<MCStreamer> Streamer)
+      : AsmPrinter(TM, std::move(Streamer), ID) {}
+
+  StringRef getPassName() const override { return "DADAO Assembly Printer"; }
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  void emitInstruction(const MachineInstr *MI) override;
+
+  /// Print a non-memory inline-asm operand (`%0`, `%1`, …; ISS-222 ① /
+  /// LLVM-118t).  AsmPrinter's base implementation only knows the generic
+  /// operand modifiers (`c`/`n`/`s`/`a`) and returns "unsupported" for every
+  /// plain operand, so before this override `%0` was substituted as the empty
+  /// string (`rb2rd %0, rb3, 1` -> `rb2rd , rb3, 1`).  Registers print with
+  /// their assembly name (the same `rd`/`rb`/`rf` spelling the MC printer
+  /// uses), immediates as decimal, and global/block addresses through the
+  /// usual symbol printer.
+  bool PrintAsmOperand(const MachineInstr *MI, unsigned OpNo,
+                       const char *ExtraCode, raw_ostream &O) override;
+
+  /// Print an inline-asm memory operand (ISS-197 / LLVM-119t).  The operand
+  /// was selected by DADAODAGToDAGISel::SelectInlineAsmMemoryOperand into the
+  /// pair (base register in GPRB, simm12 offset), so it prints as the DADAO
+  /// address form `[rb, off]`.  Without this override AsmPrinter's default
+  /// returns "unsupported" and the inline asm body is emitted with an empty
+  /// operand (even once selection succeeds).
+  bool PrintAsmMemoryOperand(const MachineInstr *MI, unsigned OpNo,
+                             const char *ExtraCode, raw_ostream &O) override;
+
+  /// Label of the `.got` slot that holds `GV + Offset` (PIC; LLVM-094t).
+  /// Creates the slot (and its data-field expression) on first use.  `rb0`-
+  /// relative accesses to this label become R_DADAO_REL12 relocations, so the
+  /// displacement is a link-time constant while the slot content is fixed up at
+  /// load time (contract-dynlink.md §3, ADR-0026 D5).
+  MCSymbol *getGOTSlotSymbol(const GlobalValue *GV, int64_t Offset) const;
+
+  /// Label of the `.got` slot holding the address of jump table `JTIndex`
+  /// (PIC; LLVM-094t).  The table itself is unchanged; only its base address
+  /// stops being a link-time absolute value.
+  MCSymbol *getGOTSlotSymbolForJumpTable(unsigned JTIndex) const;
+
+  /// Label of the `.got` slot holding `TPOFF(GV + Offset)` for the
+  /// initial-exec TLS model (`%tls_tprel`, R_DADAO_TLS_TPREL).  The loader
+  /// fills it in a shared object, where the module's static TLS offset is not
+  /// known at link time (contract-dynlink.md §4.3/§7).
+  MCSymbol *getTLSGOTSlotSymbol(const GlobalValue *GV, int64_t Offset) const;
+
+  /// Label of the `.got` slot holding the *address* of the `tls_index` pair
+  /// `{tls_id, DTPOFF}` that the global-dynamic model passes to
+  /// `__tls_get_addr`.  The pair itself is emitted (8-byte aligned, adjacent)
+  /// with the `%tls_dtpmod` / `%tls_dtprel` relocations.
+  MCSymbol *getTLSGDIndexSymbol(const GlobalValue *GV) const;
+
+  /// Emit the `.got` section with every referenced slot (no-op when empty).
+  void emitEndOfAsmFile(Module &M) override;
+};
+
+} // end namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_DADAOASMPRINTER_H
