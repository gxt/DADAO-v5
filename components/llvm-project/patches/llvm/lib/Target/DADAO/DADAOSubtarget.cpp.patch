+#include "DADAOSubtarget.h"
+#include "DADAOTargetMachine.h"
+
+#include "llvm/CodeGen/LibcallLoweringInfo.h"
+#include "llvm/IR/RuntimeLibcalls.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "dadao-subtarget"
+
+#define GET_SUBTARGETINFO_TARGET_DESC
+#define GET_SUBTARGETINFO_CTOR
+#include "DADAOGenSubtargetInfo.inc"
+
+DADAOSubtarget::DADAOSubtarget(const Triple &TT, StringRef CPU, StringRef FS,
+                               const DADAOTargetMachine &TM)
+    : DADAOGenSubtargetInfo(TT, CPU, /*TuneCPU=*/CPU, FS), TM(TM),
+      RegisterInfo(), InstrInfo(*this, RegisterInfo), FrameLowering(),
+      TLInfo(TM, *this) {}
+
+DADAOSubtarget::~DADAOSubtarget() = default;
+
+void DADAOSubtarget::initLibcallLoweringInfo(LibcallLoweringInfo &Info) const {
+  // M6 / INTEG-023k §A #3 (no libc): select the standard C `mem*` libcalls so
+  // an out-of-line llvm.memcpy/memset/memmove/memcmp lowers to `call memcpy`
+  // (etc.) instead of an IR loop.  Small constant-size intrinsics remain
+  // inlined by ISel up to MaxStoresPerMem* (16).  The symbols are resolved by
+  // the freestanding runtime (tests/scripts/dadao_mem_runtime.s).
+  Info.setLibcallImpl(RTLIB::MEMCPY, RTLIB::impl_memcpy);
+  Info.setLibcallImpl(RTLIB::MEMSET, RTLIB::impl_memset);
+  Info.setLibcallImpl(RTLIB::MEMMOVE, RTLIB::impl_memmove);
+  Info.setLibcallImpl(RTLIB::MEMCMP, RTLIB::impl_memcmp);
+}
