+#include "DADAOSubtarget.h"
+#include "DADAOTargetMachine.h"
+
+#include "llvm/CodeGen/LibcallLoweringInfo.h"
+#include "llvm/IR/RuntimeLibcalls.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "dadao-subtarget"
+
+#define GET_SUBTARGETINFO_TARGET_DESC
+#define GET_SUBTARGETINFO_CTOR
+#include "DADAOGenSubtargetInfo.inc"
+
+DADAOSubtarget::DADAOSubtarget(const Triple &TT, StringRef CPU, StringRef FS,
+                               const DADAOTargetMachine &TM)
+    : DADAOGenSubtargetInfo(TT, CPU, /*TuneCPU=*/CPU, FS), TM(TM),
+      RegisterInfo(), InstrInfo(*this, RegisterInfo), FrameLowering(),
+      TLInfo(TM, *this) {}
+
+DADAOSubtarget::~DADAOSubtarget() = default;
+
+void DADAOSubtarget::initLibcallLoweringInfo(LibcallLoweringInfo &Info) const {
+  // M6 / INTEG-023k §A #3 (no libc): select the standard C `mem*` libcalls so
+  // an out-of-line llvm.memcpy/memset/memmove/memcmp lowers to `call memcpy`
+  // (etc.) instead of an IR loop.  Small constant-size intrinsics remain
+  // inlined by ISel up to MaxStoresPerMem* (16).  The symbols are resolved by
+  // the freestanding runtime (tests/scripts/dadao_mem_runtime.s).
+  Info.setLibcallImpl(RTLIB::MEMCPY, RTLIB::impl_memcpy);
+  Info.setLibcallImpl(RTLIB::MEMSET, RTLIB::impl_memset);
+  Info.setLibcallImpl(RTLIB::MEMMOVE, RTLIB::impl_memmove);
+  Info.setLibcallImpl(RTLIB::MEMCMP, RTLIB::impl_memcmp);
+
+  // P1 FP rounding / min-max libcalls (LLVM-080t; INTEG-033k §裁定汇总 #6,
+  // double precision).  The ISA has no rounding-direction or min/max FP
+  // instruction (`contracts/opcodes.yaml` scope `fp` carries only
+  // convert/arith/root/sign/compare/classify — no floor/ceil/trunc/round/rint/
+  // nearbyint/fmin/fmax), so these DAG nodes are `Expand`ed to an out-of-line
+  // call to the standard C math routine (`DADAOISelLowering.cpp`).  Leaving
+  // them unregistered makes ExpandLibCall report "no libcall available for
+  // ffloor" and abort codegen (the ISS-188 picolibc gap).  The symbols are the
+  // picolibc ones (`floor`/`ceil`/...); the f64 implementations are pure
+  // bit-manipulation (libm/math/s_floor.c) and compile with the DADAO backend.
+  Info.setLibcallImpl(RTLIB::FLOOR_F64, RTLIB::impl_floor);
+  Info.setLibcallImpl(RTLIB::CEIL_F64, RTLIB::impl_ceil);
+  Info.setLibcallImpl(RTLIB::TRUNC_F64, RTLIB::impl_trunc);
+  Info.setLibcallImpl(RTLIB::ROUND_F64, RTLIB::impl_round);
+  Info.setLibcallImpl(RTLIB::RINT_F64, RTLIB::impl_rint);
+  Info.setLibcallImpl(RTLIB::NEARBYINT_F64, RTLIB::impl_nearbyint);
+  Info.setLibcallImpl(RTLIB::FMIN_F64, RTLIB::impl_fmin);
+  Info.setLibcallImpl(RTLIB::FMAX_F64, RTLIB::impl_fmax);
+
+  // LLVM-087t (ISS-193(b)): the identical f32 family.  Same rationale as the
+  // f64 block above — the ISA has no f32 rounding-direction / min-max
+  // instruction either, so `ffloor`/`fceil`/`ftrunc`/`fround`/`frint`/
+  // `fnearbyint`/`fminnum`/`fmaxnum` on f32 must lower to an out-of-line call
+  // to the standard C routine.  Without these, picolibc sources that compute on
+  // float values (libm/math/sf_*.c, libm/common/sf_*.c) abort with "no libcall
+  // available for frint/ftrunc/ffloor/flog" (ISS-193 class (b)).  The picolibc
+  // f32 implementations are defined by the `sf_*` sources and compile with the
+  // DADAO backend once the call is emitted.
+  Info.setLibcallImpl(RTLIB::FLOOR_F32, RTLIB::impl_floorf);
+  Info.setLibcallImpl(RTLIB::CEIL_F32, RTLIB::impl_ceilf);
+  Info.setLibcallImpl(RTLIB::TRUNC_F32, RTLIB::impl_truncf);
+  Info.setLibcallImpl(RTLIB::ROUND_F32, RTLIB::impl_roundf);
+  Info.setLibcallImpl(RTLIB::RINT_F32, RTLIB::impl_rintf);
+  Info.setLibcallImpl(RTLIB::NEARBYINT_F32, RTLIB::impl_nearbyintf);
+  Info.setLibcallImpl(RTLIB::FMIN_F32, RTLIB::impl_fminf);
+  Info.setLibcallImpl(RTLIB::FMAX_F32, RTLIB::impl_fmaxf);
+
+  // INFRA-079t (ADR-0027 D3): i128 division / remainder libcalls
+  // (compiler-rt `__divti3`/`__udivti3`/`__modti3`/`__umodti3`).  The ISA has no
+  // 128-bit divide, so LegalizeIntegerTypes (ExpandIntRes_SDIV/UDIV/SREM/UREM)
+  // emits an out-of-line call; with nothing registered `makeLibCall` aborts with
+  // "unsupported library call operation" (the `__divti3` class in
+  // INFRA-078t §4.2).  RTLIB defaults to `Unsupported` and
+  // `setTargetRuntimeLibcallSets` has no `else` branch, so a non-table arch like
+  // dadao must register every libcall it uses explicitly (fact #8).
+  Info.setLibcallImpl(RTLIB::SDIV_I128, RTLIB::impl___divti3);
+  Info.setLibcallImpl(RTLIB::UDIV_I128, RTLIB::impl___udivti3);
+  Info.setLibcallImpl(RTLIB::SREM_I128, RTLIB::impl___modti3);
+  Info.setLibcallImpl(RTLIB::UREM_I128, RTLIB::impl___umodti3);
+
+  // INFRA-079t (ADR-0027 D3): the eight FP <-> i128 conversions
+  // (`__fixdfti`/`__fixsfti`/`__fixunsdfti`/`__fixunssfti`,
+  // `__floattidf`/`__floattisf`/`__floatuntidf`/`__floatuntisf`).  Both
+  // directions are type-legalizer libcalls: the i128 side is split into two
+  // i64 halves (ExpandIntRes_FP_TO_XINT / ExpandIntOp_XINT_TO_FP), so without
+  // these entries the conversion aborts just like the division above.
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F64_I128, RTLIB::impl___fixdfti);
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F32_I128, RTLIB::impl___fixsfti);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F64_I128, RTLIB::impl___fixunsdfti);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F32_I128, RTLIB::impl___fixunssfti);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I128_F64, RTLIB::impl___floattidf);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I128_F32, RTLIB::impl___floattisf);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I128_F64, RTLIB::impl___floatuntidf);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I128_F32, RTLIB::impl___floatuntisf);
+
+  // LLVM-089t (ISS-193(b) residual): f32 `log`.  The ISA has no `flog`
+  // instruction either (`contracts/opcodes.yaml`, scope `fp`), so `llvm.log.f32`
+  // (opcode `flog`) must lower to an out-of-line call to the standard C `logf`.
+  // Without it, picolibc `libm/math/sf_log10.c` -- whose fdlibm body computes
+  // `log10f` from the public `logf` -- aborts codegen with "no libcall available
+  // for flog", which leaves `log10f` out of the built libc and blocks every test
+  // that calls it.  Only `LOG_F32` is registered: a live compile scan of all 707
+  // `libm/**/*.c` sources reports `flog` as the sole missing f32 math libcall
+  // (no `flog2`/`fexp`/`fpow`), so the rest of the f32 math family stays
+  // unregistered until a source actually needs it.
+  Info.setLibcallImpl(RTLIB::LOG_F32, RTLIB::impl_logf);
+
+  // LLVM-103t (ISS-267 ④): the f64 counterpart of the `LOG_F32` entry above.
+  // `llvm.log.f64` (the `flog` DAG node) also has no ISA instruction, so it must
+  // lower to an out-of-line call to the standard C `log`
+  // (RTLIB::LOG_F64 -> RTLIB::impl_log).  Without this registration the two
+  // llvm-test-suite cases that take `log` of a `double` abort codegen with
+  // "no libcall available for flog": CoMD (`random.c`) and consumer-lame
+  // (`psymodel.c`).  Only `LOG_F64` is added here: with it in place, a live
+  // compile of both programs' translation units reports `flog` as the sole
+  // missing f64 log libcall (no `exp`/`pow`/...); the rest of the f64 math
+  // family stays unregistered until a source actually needs it.
+  Info.setLibcallImpl(RTLIB::LOG_F64, RTLIB::impl_log);
+
+  // LLVM-103t: f64 `log10`, needed once `LOG_F64` unblocks the same case.  The
+  // first `flog` is gone but consumer-lame's `quantize.c` then aborts with
+  // "no libcall available for flog10", so `llvm.log10.f64` must lower to the
+  // standard C `log10` (RTLIB::LOG10_F64 -> RTLIB::impl_log10).  A live compile
+  // of every TU of both cases reports this as the only remaining missing
+  // libcall (the next consumer-lame failure is the varargs gap of LLVM-102t,
+  // not a libcall).
+  Info.setLibcallImpl(RTLIB::LOG10_F64, RTLIB::impl_log10);
+
+  // LLVM-106t (ADR-0030 D1/D3, ADR-0031 D6): IEEE binary128 soft float.
+  // `long double` is f128; with no 128-bit FP register the type legalizer
+  // turns every f128 value into i128 (two 64-bit halves) and every arithmetic
+  // / comparison / conversion into an out-of-line compiler-rt TF libcall.
+  // A non-table arch must register each libcall explicitly (see the i128 note
+  // above), otherwise makeLibCall reports "unsupported library call
+  // operation".  The names are compiler-rt's `GENERIC_TF_SOURCES` entry
+  // points (libclang_rt.builtins.a); `__negtf2` is deliberately absent: the
+  // legalizer implements FNEG as an integer XOR of the sign bit, which is
+  // exact for IEEE formats and needs no library call.
+  Info.setLibcallImpl(RTLIB::ADD_F128, RTLIB::impl___addtf3);
+  Info.setLibcallImpl(RTLIB::SUB_F128, RTLIB::impl___subtf3);
+  Info.setLibcallImpl(RTLIB::MUL_F128, RTLIB::impl___multf3);
+  Info.setLibcallImpl(RTLIB::DIV_F128, RTLIB::impl___divtf3);
+  // f32/f64 <-> binary128 conversions.
+  Info.setLibcallImpl(RTLIB::FPEXT_F32_F128, RTLIB::impl___extendsftf2);
+  Info.setLibcallImpl(RTLIB::FPEXT_F64_F128, RTLIB::impl___extenddftf2);
+  Info.setLibcallImpl(RTLIB::FPROUND_F128_F32, RTLIB::impl___trunctfsf2);
+  Info.setLibcallImpl(RTLIB::FPROUND_F128_F64, RTLIB::impl___trunctfdf2);
+  // Integer <-> binary128 conversions (the i32 forms share the i32 entry
+  // points; narrow integers are promoted to i32/i64 by the legalizer).
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F128_I32, RTLIB::impl___fixtfsi);
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F128_I64, RTLIB::impl___fixtfdi_f128);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F128_I32, RTLIB::impl___fixunstfsi_f128);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F128_I64, RTLIB::impl___fixunstfdi_f128);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I32_F128, RTLIB::impl___floatsitf);
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I64_F128, RTLIB::impl___floatditf_f128);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I32_F128, RTLIB::impl___floatunsitf);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I64_F128, RTLIB::impl___floatunditf_f128);
+  // i128 <-> binary128 (LLVM-113t; ISS-283).  The i32/i64 forms above do not
+  // cover the 128-bit integer conversions: with `long double` = binary128
+  // (ADR-0030), picolibc's strtold.c reaches `uint_to_fp (i128 -> f128)` and
+  // aborts with "unsupported library call operation" unless each is
+  // registered.  Entry points are compiler-rt's GENERIC_TF_SOURCES.
+  Info.setLibcallImpl(RTLIB::SINTTOFP_I128_F128, RTLIB::impl___floattitf_f128);
+  Info.setLibcallImpl(RTLIB::UINTTOFP_I128_F128, RTLIB::impl___floatuntitf_f128);
+  Info.setLibcallImpl(RTLIB::FPTOSINT_F128_I128, RTLIB::impl___fixtfti_f128);
+  Info.setLibcallImpl(RTLIB::FPTOUINT_F128_I128, RTLIB::impl___fixunstfti_f128);
+  // Comparisons (`softenSetCCOperands`): __eqtf2/__netf2/__getf2/__lttf2/
+  // __letf2/__gttf2/__unordtf2.
+  Info.setLibcallImpl(RTLIB::OEQ_F128, RTLIB::impl___eqtf2);
+  Info.setLibcallImpl(RTLIB::UNE_F128, RTLIB::impl___netf2);
+  Info.setLibcallImpl(RTLIB::OGE_F128, RTLIB::impl___getf2);
+  Info.setLibcallImpl(RTLIB::OLT_F128, RTLIB::impl___lttf2);
+  Info.setLibcallImpl(RTLIB::OLE_F128, RTLIB::impl___letf2);
+  Info.setLibcallImpl(RTLIB::OGT_F128, RTLIB::impl___gttf2);
+  Info.setLibcallImpl(RTLIB::UO_F128, RTLIB::impl___unordtf2);
+}
