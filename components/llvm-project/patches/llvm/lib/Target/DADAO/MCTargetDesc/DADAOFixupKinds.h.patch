+//===-- DADAOFixupKinds.h - DADAO Fixup Kind Info ---------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines the DADAO fixup kinds.
+// Each fixup kind corresponds to a specific immediate field width:
+//   DADAO_FK_PCRel_12: 12-bit signed (br.eq/br.ne rrii format)
+//   DADAO_FK_PCRel_18: 18-bit signed (br.n/br.nn/br.z/br.nz/br.p/br.np riii format)
+//   DADAO_FK_PCRel_24: 24-bit signed (call/jump iiii format)
+//   DADAO_FK_ABS48:    absolute 48-bit address (set.zw/or.w/andn.w rwii)
+//   DADAO_FK_REL12:    12-bit signed BYTE offset, PC-relative (ld.*/st.* [rb0, sym])
+//   DADAO_FK_ABS12:    12-bit signed BYTE offset, base-relative (ld.*/st.* [rbN, sym])
+//
+// All PCRel fixups: imms = (target - current) >> 2 (no +4 pipeline offset),
+// except DADAO_FK_REL12 whose imms12 holds a BYTE offset (no >>2).
+// ABS48: value = S + A, sliced by the instruction's wyde-position (wp).
+// ABS12: value = S + A (byte offset).
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOFIXUPKINDS_H
+#define LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOFIXUPKINDS_H
+
+#include "llvm/MC/MCFixup.h"
+
+namespace llvm {
+namespace DADAO {
+  // Fixup kinds for DADAO instructions.
+  enum Fixups {
+    // PC-relative fixup for rrii format branch/jump (12-bit signed immediate).
+    // Encoding: imms = (target - current) >> 2 (no +4 pipeline offset)
+    // Used by: br.eq/br.ne (imms12)
+    DADAO_FK_PCRel_12 = FirstTargetFixupKind,
+
+    // PC-relative fixup for riii format branch (18-bit signed immediate).
+    // Encoding: imms = (target - current) >> 2 (no +4 pipeline offset)
+    // Used by: br.n/br.nn/br.z/br.nz/br.p/br.np (imms18)
+    DADAO_FK_PCRel_18,
+
+    // PC-relative fixup for iiii format call/jump (24-bit signed immediate).
+    // Encoding: imms = (target - current) >> 2 (no +4 pipeline offset)
+    // Used by: call/jump (imms24)
+    DADAO_FK_PCRel_24,
+
+    // Absolute 48-bit address fixup for the rwii address-construction
+    // sequence: one 16-bit wyde of (S + A) per instruction.  The wyde position
+    // (wp, encoded in hb[5:4]) tells the linker which slice of the address this
+    // instruction carries; the addend A is carried explicitly in r_addend
+    // (RELA).  Never resolved in place: the address is only known at link time.
+    // Source: contract-elf.md §2.3, §3.1 (ADR-0019 §D3–§D5).
+    // Used by: set.zw / or.w / andn.w (rwii address construction)
+    DADAO_FK_ABS48,
+
+    // Byte displacement for a `ld.*`/`st.*` symbol offset with base rb0
+    // (rrii imms12).  rb0 reads the current instruction address, so the
+    // displacement is PC-relative: field = S + A - P, in BYTES (no >>2).
+    // The assembler picks this kind whenever the base register is rb0.
+    // Source: contract-elf.md §2.2/§3.1 (ADR-0021 §D1-D3).
+    DADAO_FK_REL12,
+
+    // Byte displacement for a `ld.*`/`st.*` symbol offset with base rb1..rb63
+    // (rrii imms12).  The base is a general register, so the displacement is
+    // base-relative (absolute): field = S + A, in BYTES (no >>2).
+    // The assembler picks this kind whenever the base register is not rb0.
+    // Source: contract-elf.md §2.2/§3.1 (ADR-0021 §D1-D3).
+    DADAO_FK_ABS12,
+
+    // Sentinel
+    LastTargetFixupKind = DADAO_FK_ABS12
+  };
+} // end namespace DADAO
+} // end namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOFIXUPKINDS_H
