+
+#ifndef LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOMCASMINFO_H
+#define LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOMCASMINFO_H
+
+#include "llvm/MC/MCAsmInfoELF.h"
+
+namespace llvm {
+class Triple;
+
+class DADAOMCAsmInfo : public MCAsmInfoELF {
+  void anchor() override;
+
+public:
+  explicit DADAOMCAsmInfo(const Triple &TheTriple,
+                          const MCTargetOptions &Options);
+
+  // Print a relocation-specifier expression: `%pcrel_hi(...)` / `%pcrel_lo(...)`
+  // (ADR-0029 D2).  Required so MCSpecifierExpr round-trips through the asm
+  // printer (`llvm-mc -filetype=asm`, MCInstPrinter::printOperand).
+  void printSpecifierExpr(raw_ostream &OS,
+                          const MCSpecifierExpr &Expr) const override;
+};
+
+namespace DADAO {
+
+// Relocation specifiers carried by MCSpecifierExpr (the `%name(expr)` assembly
+// form).  They select the relocation type of an expression operand that would
+// otherwise be ambiguous -- the explicit pairing of ADR-0029 D2/D3:
+//   %pcrel_hi(sym)   -- high part, only on `aip.si`
+//   %pcrel_lo(site)  -- low part, paired with the high part at local label
+//                       `site` (the RISC-V `%pcrel_lo(label)` form)
+// Consumers: DADAOAsmParser (parsing), DADAOMCCodeEmitter (fixup kind),
+// DADAOMCAsmInfo (printing).
+using Specifier = uint16_t;
+enum {
+  S_None,
+  S_PCREL_HI,
+  S_PCREL_LO,
+};
+
+Specifier parseSpecifierName(StringRef Name);
+StringRef getSpecifierName(Specifier S);
+
+} // namespace DADAO
+
+} // namespace llvm
+
+#endif // LLVM_LIB_TARGET_DADAO_MCTARGETDESC_DADAOMCASMINFO_H
