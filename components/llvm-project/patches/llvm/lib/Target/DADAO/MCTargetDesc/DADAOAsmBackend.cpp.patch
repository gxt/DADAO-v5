+//
+// This file implements the DADAO AsmBackend.
+// DADAO branch/jump fixup: imms = (target_byte_addr - current_byte_addr) >> 2
+// No +4 pipeline offset (contract-isa.md §8.2–§8.4); rb0 reads the PC of the
+// current instruction, so the displacement is measured from the instruction
+// itself (contract-isa.md §1.3.2).
+// Section-local labels are still resolved in place, including STB_GLOBAL
+// functions (M1 self-contained TU, contract-elf.md §6).  References to another
+// section or to undefined symbols are left unresolved and recorded as
+// relocations (M4, contract-elf.md §2–§3): the correct criterion is whether the
+// target symbol lives in the same section as the fixup, not isUndefined().
+//
+//===----------------------------------------------------------------------===//
+
+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "MCTargetDesc/DADAOFixupKinds.h"
+#include "llvm/MC/MCAsmBackend.h"
+#include "llvm/MC/MCAssembler.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCELFObjectWriter.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/MC/MCObjectWriter.h"
+#include "llvm/MC/MCSymbol.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/MCValue.h"
+#include "llvm/ADT/Twine.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/MathExtras.h"
+#include <optional>
+
+using namespace llvm;
+
+namespace {
+
+class DADAOAsmBackend : public MCAsmBackend {
+public:
+  DADAOAsmBackend() : MCAsmBackend(llvm::endianness::big) {}
+
+  std::unique_ptr<MCObjectTargetWriter>
+  createObjectTargetWriter() const override {
+    return createDadaoELFObjectWriter(ELF::ELFOSABI_NONE);
+  }
+
+  MCFixupKindInfo getFixupKindInfo(MCFixupKind Kind) const override {
+    const static MCFixupKindInfo Infos[] = {
+      // DADAO_FK_PCRel_12: 12-bit signed immediate (rrii: hc+hd)
+      // Used by br.eq/br.ne
+      {"DADAO_FK_PCRel_12", 0, 32, 0},
+      // DADAO_FK_PCRel_18: 18-bit signed immediate (riii: hb+hc+hd)
+      // Used by br.n/br.nn/br.z/br.nz/br.p/br.np
+      {"DADAO_FK_PCRel_18", 0, 32, 0},
+      // DADAO_FK_PCRel_24: 24-bit signed immediate (iiii: ha+hb+hc+hd)
+      // Used by call/jump
+      {"DADAO_FK_PCRel_24", 0, 32, 0},
+      // DADAO_FK_ABS48: one 16-bit wyde of an absolute 48-bit address
+      // (rwii: hb[3:0]+hc+hd); the wyde-position selects the slice.
+      // Used by set.zw/or.w/andn.w
+      {"DADAO_FK_ABS48", 0, 16, 0},
+      // DADAO_FK_REL12: 12-bit signed BYTE offset, PC-relative (rrii: hc+hd)
+      // Used by ld.*/st.* with base rb0
+      {"DADAO_FK_REL12", 0, 32, 0},
+      // DADAO_FK_ABS12: 12-bit signed BYTE offset, base-relative (rrii: hc+hd)
+      // Used by ld.*/st.* with base rb1..rb63
+      {"DADAO_FK_ABS12", 0, 32, 0}
+    };
+
+    if (Kind >= llvm::DADAO::DADAO_FK_PCRel_12 &&
+        Kind <= llvm::DADAO::DADAO_FK_ABS12)
+      return Infos[Kind - llvm::DADAO::DADAO_FK_PCRel_12];
+
+    return MCAsmBackend::getFixupKindInfo(Kind);
+  }
+
+  // M1 self-contained TU: section-local labels are resolved in place.
+  //
+  // The shared ELF writer (ELFObjectWriter::isSymbolRefDifferenceFullyResolved-
+  // Impl) conservatively refuses to fold a PC-relative reference to an
+  // STB_GLOBAL symbol, because such a symbol is interposable at link time in
+  // general. M1 has no linker and requires the single translation unit to be
+  // self-contained (contract-elf.md §6), so any symbol *defined in the same
+  // section* — including globally-visible functions such as `callee` — must be
+  // folded here. Otherwise the immediate stays 0 and `call`/`br` targets
+  // address 0.
+  //
+  // Returning a value from this hook tells MCAssembler::evaluateFixup to treat
+  // the fixup as resolved and to skip the writer's conservatism; the hook must
+  // compute Value itself, mirroring the default (target - PC) computation.
+  std::optional<bool> evaluateFixup(const MCFragment &F, MCFixup &Fixup,
+                                    MCValue &Target,
+                                    uint64_t &Value) override {
+    unsigned Kind = Fixup.getKind();
+    // PC-relative branch/jump kinds, and the ld/st PC-relative byte kind
+    // (DADAO_FK_REL12) which is also resolved in place when the target symbol
+    // lives in the same section.  DADAO_FK_ABS48 / DADAO_FK_ABS12 are absolute
+    // and are never folded here.
+    const bool IsPCBranch = Kind >= llvm::DADAO::DADAO_FK_PCRel_12 &&
+                            Kind <= llvm::DADAO::DADAO_FK_PCRel_24;
+    const bool IsLdstPCRel = Kind == llvm::DADAO::DADAO_FK_REL12;
+    if (!IsPCBranch && !IsLdstPCRel)
+      return std::nullopt;
+    if (!Fixup.isPCRel())
+      return std::nullopt;
+
+    const MCSymbol *Add = Target.getAddSym();
+    const MCSymbol *Sub = Target.getSubSym();
+    if (!Add || Sub || Add->isUndefined() || Add->isAbsolute())
+      return std::nullopt;
+
+    // Resolve only same-section labels; a reference to another section (or an
+    // undefined symbol) is the M4 cross-symbol case and is left unresolved.
+    if (&Add->getSection() != F.getParent())
+      return std::nullopt;
+
+    // (target - PC): the symbol's section offset minus the fixup's own address.
+    // applyFixup() then shifts right by 2 for the branch kinds (or uses the
+    // byte offset directly for DADAO_FK_REL12) and masks the immediate field.
+    uint64_t V = Target.getConstant();
+    V += Asm->getSymbolOffset(*Add);
+    V -= Asm->getFragmentOffset(F) + Fixup.getOffset();
+    Value = V;
+    return true;
+  }
+
+  void applyFixup(const MCFragment &F, const MCFixup &Fixup,
+                  const MCValue &Target, uint8_t *Data, uint64_t Value,
+                  bool IsResolved) override {
+    unsigned Kind = Fixup.getKind();
+
+    // Relocatable narrow data items (`.byte`/`.short`/`.long <sym>`, i.e.
+    // FK_Data_1/2/4): a DADAO address is 48-bit, so it can never fit in a
+    // 1/2/4-byte field and there is no narrower data relocation type
+    // (ADR-0019 §D8 forbids ABS32).  The old behaviour emitted a silent 0 with
+    // no relocation (ISS-161); now it is an explicit assembler error: no
+    // truncation, no wrap, no silent 0 (contract-elf.md §2-§4/§3.2).  Use
+    // `.dd.o64` / `.quad`, which carry the 8-byte R_DADAO_ABS48 field.
+    if (Kind == llvm::FK_Data_1 || Kind == llvm::FK_Data_2 ||
+        Kind == llvm::FK_Data_4) {
+      const unsigned NB =
+          Kind == llvm::FK_Data_1 ? 1 : Kind == llvm::FK_Data_2 ? 2 : 4;
+      if (!IsResolved) {
+        Asm->getContext().reportError(
+            Fixup.getLoc(),
+            "relocatable operand in a 1/2/4-byte data field "
+            "(.byte/.short/.long) cannot carry a 48-bit DADAO address; "
+            "use '.dd.o64'/'.quad' (8-byte field)");
+        return;
+      }
+      // A resolved (absolute) value must still fit the field width.
+      if (!isUIntN(8 * NB, Value)) {
+        Asm->getContext().reportError(
+            Fixup.getLoc(), Twine("data value 0x") +
+                                Twine::utohexstr(Value) +
+                                " does not fit in a " + Twine(NB) +
+                                "-byte field");
+        return;
+      }
+      for (unsigned I = 0; I != NB; ++I)
+        Data[I] = static_cast<uint8_t>(Value >> (8 * (NB - 1 - I)));
+      return;
+    }
+
+    // Relocatable 8-byte data items (`.dd.o64 <sym>`, `.quad <sym>`): an
+    // absolute data relocation (R_DADAO_ABS48 -- absolute, instruction or data;
+    // ADR-0019 §D2 / user ruling 2026-10-06).  An unresolved symbol is recorded
+    // as a real relocation, never a pre-link placeholder value; a resolved
+    // value is written big-endian into the 8-byte field.
+    if (Kind == llvm::FK_Data_8) {
+      if (!IsResolved) {
+        maybeAddReloc(F, Fixup, Target, Value, IsResolved);
+        return;
+      }
+      for (unsigned I = 0; I != 8; ++I)
+        Data[I] = static_cast<uint8_t>(Value >> (8 * (7 - I)));
+      return;
+    }
+
+    // Only process our custom fixup kinds.
+    if (Kind < llvm::DADAO::DADAO_FK_PCRel_12 ||
+        Kind > llvm::DADAO::DADAO_FK_ABS12)
+      return;
+
+    // M4: an unresolved fixup (target symbol in another section, or undefined)
+    // must be recorded as a relocation -- never write a pre-link placeholder
+    // value into the instruction.  contract-elf.md §2–§3 (ADR-0019 §D1/§D5).
+    if (!IsResolved) {
+      maybeAddReloc(F, Fixup, Target, Value, IsResolved);
+      return;
+    }
+
+    // ABS48 is an absolute address fixed up at link time; the assembler never
+    // resolves it in place (relaxation disabled, contract-elf.md §4).
+    if (Kind == llvm::DADAO::DADAO_FK_ABS48)
+      return;
+
+    // ld/st symbol displacement (DADAO_FK_REL12 / DADAO_FK_ABS12): both live in
+    // the rrii imms12 field, Inst{11:0}.  REL12 is PC-relative (Value = S + A -
+    // P); ABS12 is base-relative (Value = S + A).  Neither is shifted: the
+    // imms12 holds a BYTE offset (contract-elf.md §3.1, ADR-0021 §D1).  An
+    // out-of-range offset is a hard error, never a silent truncation (§3.2).
+    if (Kind == llvm::DADAO::DADAO_FK_REL12 ||
+        Kind == llvm::DADAO::DADAO_FK_ABS12) {
+      const int64_t ByteOffset = static_cast<int64_t>(Value);
+      if (!isInt<12>(ByteOffset)) {
+        Asm->getContext().reportError(
+            Fixup.getLoc(),
+            "ld/st symbol offset out of range for the 12-bit byte immediate "
+            "(-2048..+2047)");
+        return;
+      }
+      uint32_t Inst = (static_cast<uint32_t>(Data[0]) << 24) |
+                      (static_cast<uint32_t>(Data[1]) << 16) |
+                      (static_cast<uint32_t>(Data[2]) << 8) |
+                      static_cast<uint32_t>(Data[3]);
+      Inst = (Inst & ~0xFFFu) | (static_cast<uint32_t>(ByteOffset) & 0xFFFu);
+      Data[0] = (Inst >> 24) & 0xFF;
+      Data[1] = (Inst >> 16) & 0xFF;
+      Data[2] = (Inst >> 8) & 0xFF;
+      Data[3] = Inst & 0xFF;
+      return;
+    }
+
+    if (Value == 0)
+      return;  // Zero delta: no change needed
+
+    // B1 fix: MCAssembler passes Data = Contents.data() + Fixup.getOffset(),
+    // so Data already points to the start of this instruction.
+    // We must NOT add Offset again (that was the double-offset bug).
+    // Use Data[0..3] directly (like Lanai backend).
+
+    // Read existing instruction bytes (big-endian).
+    uint32_t Inst =
+        (static_cast<uint32_t>(Data[0]) << 24) |
+        (static_cast<uint32_t>(Data[1]) << 16) |
+        (static_cast<uint32_t>(Data[2]) << 8) |
+        static_cast<uint32_t>(Data[3]);
+
+    // PC-relative fixup: imms = (target - current) >> 2
+    // Value is already (target - current) when PCRel = true.
+    // We need to right-shift by 2 to get the immediate value.
+    const int64_t ByteDelta = static_cast<int64_t>(Value);
+    uint64_t ImmValue = Value >> 2;
+
+    // B2 fix: Apply the correct bitmask based on the fixup kind.
+    // The immediate field width depends on the instruction format:
+    //   PCRel_12 (rrii): 12-bit signed, mask 0xFFF
+    //   PCRel_18 (riii): 18-bit signed, mask 0x3FFFF
+    //   PCRel_24 (iiii): 24-bit signed, mask 0xFFFFFF
+    unsigned Bits;
+    uint64_t Mask;
+    switch (Kind) {
+    case llvm::DADAO::DADAO_FK_PCRel_12:
+      Bits = 12;
+      Mask = 0xFFF;
+      break;
+    case llvm::DADAO::DADAO_FK_PCRel_18:
+      Bits = 18;
+      Mask = 0x3FFFF;
+      break;
+    case llvm::DADAO::DADAO_FK_PCRel_24:
+      Bits = 24;
+      Mask = 0xFFFFFF;
+      break;
+    default:
+      return;  // Should not reach here
+    }
+
+    // Reject an out-of-range or misaligned branch displacement instead of
+    // silently truncating it (ISS-043).  The stored word offset must be a
+    // signed value that fits the immediate field width.
+    const int64_t WordOffset = ByteDelta >> 2;
+    if ((ByteDelta & 3) != 0 ||
+        !(Bits == 12 ? isInt<12>(WordOffset)
+                     : Bits == 18 ? isInt<18>(WordOffset)
+                                  : isInt<24>(WordOffset))) {
+      Asm->getContext().reportError(
+          Fixup.getLoc(),
+          Twine("branch/jump target out of range for a ") + Twine(Bits) +
+              "-bit PC-relative immediate");
+      return;
+    }
+
+    // OR in the immediate value (opcode bits are already set by the emitter).
+    Inst |= (ImmValue & Mask);
+
+    // Write back (big-endian).
+    Data[0] = (Inst >> 24) & 0xFF;
+    Data[1] = (Inst >> 16) & 0xFF;
+    Data[2] = (Inst >> 8) & 0xFF;
+    Data[3] = Inst & 0xFF;
+  }
+
+  bool writeNopData(raw_ostream &OS, uint64_t Count,
+                    const MCSubtargetInfo *STI) const override {
+    // The canonical DADAO nop is `swym 0` = 0x77880000 (oiii, big-endian;
+    // contract-isa.md §13.1/§13.3).  DADAO instructions are fixed 4-byte words,
+    // so a whole word of padding is exactly one `swym 0`.
+    //
+    // writeNopData() MUST emit *exactly* Count bytes: MCAssembler::writeFragment
+    // asserts that the stream advances by the fragment size, and an alignment
+    // fragment's size is a byte count that need not be a multiple of 4 (e.g.
+    // `.p2align` after a `.byte`, or `.align`, where the current offset is not
+    // 4-aligned).  Rounding Count up to a multiple of 4 (the pre-ISS-182 code
+    // wrote `ceil(Count/4)*4` bytes) overruns the fragment and aborts the
+    // assembler.
+    //
+    // Pad the leading bytes up to the next 4-byte boundary with zero bytes --
+    // the same byte-fill convention binutils/RISC-V use for a fixed-width ISA
+    // (RISCVAsmBackend::writeNopData) -- so that the `swym 0` words that follow
+    // are 4-byte aligned, then emit one `swym 0` per remaining whole word.
+    while (Count % 4) {
+      OS.write("\x00", 1);
+      --Count;
+    }
+    for (; Count != 0; Count -= 4)
+      OS.write("\x77\x88\x00\x00", 4);
+    return true;
+  }
+};
+
+} // end anonymous namespace
+
+MCAsmBackend *llvm::createDadaoAsmBackend(const Target & /*T*/,
+                                          const MCSubtargetInfo & /*STI*/,
+                                          const MCRegisterInfo & /*MRI*/,
+                                          const MCTargetOptions & /*Options*/) {
+  return new DADAOAsmBackend();
+}
