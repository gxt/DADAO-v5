+#include "DADAOMCTargetDesc.h"
+#include "DADAOMCAsmInfo.h"
+#include "DADAOTargetStreamer.h"
+#include "TargetInfo/DADAOTargetInfo.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCCodeEmitter.h"
+#include "llvm/MC/MCELFObjectWriter.h"
+#include "llvm/MC/MCELFStreamer.h"
+#include "llvm/MC/MCInstPrinter.h"
+#include "llvm/MC/MCInstrAnalysis.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+
+// Register enum (DADAO::rd0, DADAO::rb0, etc.) is provided by
+// DADAOMCTargetDesc.h via GET_REGINFO_ENUM.
+
+// MC descriptor tables (InitDADAOMCRegisterInfo, register descriptors).
+#define GET_REGINFO_MC_DESC
+#include "DADAOGenRegisterInfo.inc"
+
+// Subtarget info (minimal for M1).
+#define GET_SUBTARGETINFO_MC_DESC
+#include "DADAOGenSubtargetInfo.inc"
+
+using namespace llvm;
+
+// --- Target Streamer (sets e_flags in ELF header) ---
+// ADR-0003 §D1: e_flags = 0x00000001 (M1 object/ABI format version).
+// bits 0–7 = version (M1 = 1); bits 8–31 = reserved (0).
+// Source: contract-elf.md §1.3.
+
+// EF_DADAO_ABIV1: M1 object/ABI format version flag (bits 0–7 = 1).
+static constexpr unsigned EF_DADAO_ABIV1 = 0x00000001;
+
+DADAOTargetStreamer::DADAOTargetStreamer(MCStreamer &S)
+    : MCTargetStreamer(S) {
+  MCELFStreamer &ES = static_cast<MCELFStreamer &>(S);
+  ELFObjectWriter &W = ES.getWriter();
+  W.setELFHeaderEFlags(EF_DADAO_ABIV1);
+}
+
+static MCTargetStreamer *
+createDadaoObjectTargetStreamer(MCStreamer &S, const MCSubtargetInfo &STI) {
+  return new DADAOTargetStreamer(S);
+}
+
+static MCStreamer *createMCStreamer(const Triple &T, MCContext &Context,
+                                   std::unique_ptr<MCAsmBackend> &&MAB,
+                                   std::unique_ptr<MCObjectWriter> &&OW,
+                                   std::unique_ptr<MCCodeEmitter> &&Emitter) {
+  return createELFStreamer(Context, std::move(MAB), std::move(OW),
+                           std::move(Emitter));
+}
+
+// MCRegisterInfo: initialized from TableGen-generated DADAOGenRegisterInfo.
+// Replaces the empty stub from LLVM-003t with real register definitions
+// (256 RegisterDefs: 4 banks × 64 regs; see DADAORegisterInfo.td).
+// Heap-allocated (not static) to avoid destruction-order issues with
+// DenseMap/vector members inside MCRegisterInfo (Lanai convention).
+static MCRegisterInfo *createDadaoMCRegInfo(const Triple & /*TT*/) {
+  MCRegisterInfo *X = new MCRegisterInfo();
+  InitDADAOMCRegisterInfo(X, DADAO::RBSP /* RA = SP */);
+  return X;
+}
+
+// MCSubtargetInfo: minimal for M1 (no CPU/feature variants).
+static MCSubtargetInfo *createDadaoMCSubtargetInfo(const Triple &TT,
+                                                    StringRef CPU,
+                                                    StringRef FS) {
+  return createDADAOMCSubtargetInfoImpl(TT, CPU, /*TuneCPU=*/CPU, FS);
+}
+
+// MCInstrInfo: from TableGen-generated DADAOGenInstrInfo.inc.
+#define GET_INSTRINFO_MC_DESC
+#include "DADAOGenInstrInfo.inc"
+
+static MCInstrInfo *createDadaoMCInstrInfo() {
+  MCInstrInfo *X = new MCInstrInfo();
+  InitDADAOMCInstrInfo(X);
+  return X;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeDADAOTargetMC() {
+  // Register the MC asm info.
+  RegisterMCAsmInfo<DADAOMCAsmInfo> X(getTheDadaoTarget());
+
+  // Register the MC register info.
+  TargetRegistry::RegisterMCRegInfo(getTheDadaoTarget(),
+                                    createDadaoMCRegInfo);
+
+  // Register the MCSubtargetInfo.
+  TargetRegistry::RegisterMCSubtargetInfo(getTheDadaoTarget(),
+                                          createDadaoMCSubtargetInfo);
+
+  // Register the MCInstrInfo.
+  TargetRegistry::RegisterMCInstrInfo(getTheDadaoTarget(),
+                                      createDadaoMCInstrInfo);
+
+  // Register the MCInstPrinter (MCInst → text).
+  // Uses DADAOGenAsmWriter.inc via DADAOMCInstPrinter.cpp.
+  TargetRegistry::RegisterMCInstPrinter(getTheDadaoTarget(),
+                                        createDadaoMCInstPrinter);
+
+  // Register the MCCodeEmitter (MCInst → bytes).
+  // Uses DADAOGenMCCodeEmitter.inc via DADAOMCCodeEmitter.cpp.
+  TargetRegistry::RegisterMCCodeEmitter(getTheDadaoTarget(),
+                                        createDadaoMCCodeEmitter);
+
+  // Register the MCAsmBackend (fixup/nop stub).
+  // Required for ELF object writing; without it, registration crashes.
+  TargetRegistry::RegisterMCAsmBackend(getTheDadaoTarget(),
+                                       createDadaoAsmBackend);
+
+  // Register the ELF streamer.
+  TargetRegistry::RegisterELFStreamer(getTheDadaoTarget(), createMCStreamer);
+
+  // Register the ELF target streamer (sets e_flags in ELF header).
+  TargetRegistry::RegisterObjectTargetStreamer(getTheDadaoTarget(),
+                                               createDadaoObjectTargetStreamer);
+}
