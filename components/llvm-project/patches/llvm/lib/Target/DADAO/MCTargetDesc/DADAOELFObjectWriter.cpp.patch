+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCELFObjectWriter.h"
+#include "llvm/MC/MCObjectWriter.h"
+
+using namespace llvm;
+
+// EM_DADAO: project-custom machine id.
+// Source: contract-elf.md §1.1 (ADR-0003 §D1).
+// Not registered in IANA/SysV public ELF registry.
+static constexpr unsigned EM_DADAO = 0x0DA0;
+
+namespace {
+
+class DADAOELFObjectWriter : public MCELFObjectTargetWriter {
+public:
+  explicit DADAOELFObjectWriter(uint8_t OSABI)
+      : MCELFObjectTargetWriter(/*Is64Bit_=*/true, OSABI, EM_DADAO,
+                                /*HasRelocationAddend_=*/false) {}
+
+  ~DADAOELFObjectWriter() override = default;
+
+protected:
+  unsigned getRelocType(const MCFixup &Fixup, const MCValue &,
+                        bool IsPCRel) const override {
+    // Stub: M1 does not produce relocations (contract-elf.md §2).
+    // Return 0 (no relocation type defined for M1).
+    return 0;
+  }
+
+  bool needsRelocateWithSymbol(const MCValue &, unsigned Type) const override {
+    return false;
+  }
+};
+
+} // end anonymous namespace
+
+std::unique_ptr<MCObjectTargetWriter>
+llvm::createDadaoELFObjectWriter(uint8_t OSABI) {
+  return std::make_unique<DADAOELFObjectWriter>(OSABI);
+}
