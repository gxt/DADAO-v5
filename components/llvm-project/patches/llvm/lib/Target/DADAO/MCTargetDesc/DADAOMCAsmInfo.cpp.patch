+//
+// This file contains the declarations of the DADAOMCAsmInfo properties.
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOMCAsmInfo.h"
+#include "llvm/ADT/StringSwitch.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/raw_ostream.h"
+#include "llvm/TargetParser/Triple.h"
+
+using namespace llvm;
+
+void DADAOMCAsmInfo::anchor() {}
+
+DADAOMCAsmInfo::DADAOMCAsmInfo(const Triple & /*TheTriple*/,
+                                const MCTargetOptions &Options)
+    : MCAsmInfoELF(Options) {
+  // DADAO is big endian (contract-elf.md §1.1: EI_DATA = ELFDATA2MSB).
+  IsLittleEndian = false;
+
+  // Data directives (contract-asm.md §7.1 / Toolchain-01 §7.1): the ONLY data
+  // directives are the DADAO `.dd.*` set (Knuth/MMIX data lengths).  Without
+  // these overrides the backend inherits the MCAsmInfo defaults and emits the
+  // GAS names `.byte/.short/.long/.quad`, which MUST NOT be used.
+  Data8bitsDirective = "\t.dd.b08\t";
+  Data16bitsDirective = "\t.dd.w16\t";
+  Data32bitsDirective = "\t.dd.t32\t";
+  Data64bitsDirective = "\t.dd.o64\t";
+
+  // DADAO uses ';' as the comment character.
+  CommentString = ";";
+
+  // Disallow '#' as a comment character in any position (ADR-0013 D9).
+  AllowAdditionalComments = false;
+
+  // Instruction alignment: 4 bytes (contract-isa.md §2.1: 32-bit instructions).
+  MinInstAlignment = 4;
+
+  // DADAO assembly uses ".section" before ".bss".
+  UsesELFSectionDirectiveForBSS = true;
+
+  // Target supports emission of debugging information.
+  SupportsDebugInformation = true;
+}
+
+//===----------------------------------------------------------------------===//
+// Relocation specifiers (ADR-0029 D2: explicit hi/lo pairing, the RISC-V
+// `%pcrel_hi`/`%pcrel_lo` assembly form).
+//===----------------------------------------------------------------------===//
+
+DADAO::Specifier DADAO::parseSpecifierName(StringRef Name) {
+  return StringSwitch<DADAO::Specifier>(Name)
+      .Case("pcrel_hi", DADAO::S_PCREL_HI)
+      .Case("pcrel_lo", DADAO::S_PCREL_LO)
+      .Default(DADAO::S_None);
+}
+
+StringRef DADAO::getSpecifierName(Specifier S) {
+  switch (S) {
+  case DADAO::S_PCREL_HI:
+    return "pcrel_hi";
+  case DADAO::S_PCREL_LO:
+    return "pcrel_lo";
+  case DADAO::S_None:
+    break;
+  }
+  llvm_unreachable("not a %specifier() that can be printed");
+}
+
+void DADAOMCAsmInfo::printSpecifierExpr(raw_ostream &OS,
+                                        const MCSpecifierExpr &Expr) const {
+  OS << '%' << DADAO::getSpecifierName(Expr.getSpecifier()) << '(';
+  printExpr(OS, *Expr.getSubExpr());
+  OS << ')';
+}
