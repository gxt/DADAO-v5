+++ b/scripts/cross-dadao.txt
@@ -0,0 +1,52 @@
+# Meson cross-compilation file for the DADAO-v5 bare-metal target
+# (dadao-unknown-elf).  Consumed through `meson --cross-file`
+# (see the DADAO-v5 top-level `build-picolibc` target).
+#
+# The C/C++ compilers are the in-tree clang built by the LLVM module
+# (`clang -target dadao-unknown-elf`); the DADAO-v5 build driver puts the
+# install root's cross-toolchain `bin/` (with `clang`/`clang++`/`ld.lld`) on
+# PATH.  `ar`/`nm`/`strip`/`objcopy` are the host binutils: they are
+# object-format agnostic and no new external dependency is introduced.
+#
+# Target facts (contract-abi.md §1.7): 64-bit, **big-endian**.
+# `long double` is 64-bit (f64) — clang predefines `__SIZEOF_LONG_DOUBLE__=8`.
+
+[binaries]
+c = ['clang', '-target', 'dadao-unknown-elf', '-nostdlib']
+cpp = ['clang++', '-target', 'dadao-unknown-elf', '-nostdlib', '-fno-exceptions', '-fno-rtti']
+c_ld = 'ld.lld'
+cpp_ld = 'ld.lld'
+ar = 'ar'
+nm = 'nm'
+strip = 'strip'
+objcopy = 'objcopy'
+
+[host_machine]
+system = 'none'
+cpu_family = 'dadao'
+cpu = 'dadao'
+endian = 'big'
+
+[properties]
+# Do not try to run target binaries while configuring: the target is bare-metal
+# (the guest programs are executed later by qemu-system-dadao, not by meson).
+skip_sanity_check = true
+needs_exe_wrapper = true
+# Kaiwu-Tiny address map (spec/Kaiwu §1.1/§6.2.1, profile `tiny`):
+#   BootROM   0xffff_ffff_0000, 8 KiB (unused by the noflash script);
+#   main SRAM 0xffff_ff00_0000, 256 KiB:
+#     0x2000  ENTRY / raw image base (kernel_reserved = 0)
+#     0x38000 guard_lo  (not mapped; stops the heap / stack underflow)
+#     0x39000 STACK, 24 KiB, SP = 0x3F000
+#     0x3F000 MemRAS, 4 KiB (MRPTR = 0x40000)
+# The RAM region starts at the fixed entry and stops at the stack top, so the
+# generated `__stack` is exactly 0xffffff03f000; MemRAS stays outside it.  The
+# default stack reservation is guard_lo (4 KiB) + STACK (24 KiB) = 0x7000, so
+# the generated `__heap_end` is the guard base 0xffffff038000 and the heap can
+# never grow into the unmapped guard page.  These feed the generated linker
+# scripts (picolibc.ld / picolibc_noflash.ld).
+default_flash_addr = '0xffffffff0000'
+default_flash_size = '0x00002000'
+default_ram_addr   = '0xffffff002000'
+default_ram_size   = '0x0003d000'
+default_stack_size = '0x00007000'
