@@ -0,0 +1,41 @@
+# Meson cross-compilation file for the DADAO-v5 bare-metal target
+# (dadao-unknown-elf).  Consumed through `meson --cross-file`
+# (see the DADAO-v5 top-level `build-picolibc` target).
+#
+# The C/C++ compilers are the in-tree clang built by the LLVM module
+# (`clang -target dadao-unknown-elf`); the DADAO-v5 build driver puts the
+# install root's cross-toolchain `bin/` (with `clang`/`clang++`/`ld.lld`) on
+# PATH.  `ar`/`nm`/`strip`/`objcopy` are the host binutils: they are
+# object-format agnostic and no new external dependency is introduced.
+#
+# Target facts (contract-abi.md §1.7): 64-bit, **big-endian**.
+# `long double` is 64-bit (f64) — clang predefines `__SIZEOF_LONG_DOUBLE__=8`.
+
+[binaries]
+c = ['clang', '-target', 'dadao-unknown-elf', '-nostdlib']
+cpp = ['clang++', '-target', 'dadao-unknown-elf', '-nostdlib', '-fno-exceptions', '-fno-rtti']
+c_ld = 'ld.lld'
+cpp_ld = 'ld.lld'
+ar = 'ar'
+nm = 'nm'
+strip = 'strip'
+objcopy = 'objcopy'
+
+[host_machine]
+system = 'none'
+cpu_family = 'dadao'
+cpu = 'dadao'
+endian = 'big'
+
+[properties]
+# Do not try to run target binaries while configuring: the target is bare-metal
+# (the guest programs are executed later by qemu-system-dadao, not by meson).
+skip_sanity_check = true
+needs_exe_wrapper = true
+# Single RAM segment at the DADAO-v5 memory map RAM base (ADR-0004 R3 +
+# rev. 2026-10-11, contract-elf.md §5).  These feed the generated linker
+# scripts (picolibc.ld / picolibc_noflash.ld).
+default_flash_addr = '0xfc0000000000'
+default_flash_size = '0x01000000'
+default_ram_addr   = '0xfc0000000000'
+default_ram_size   = '0x01000000'
