diff --git a/picolibc.ld.in b/picolibc.ld.in
index 416eeeb..836a124 100644
--- a/picolibc.ld.in
+++ b/picolibc.ld.in
@@ -66,6 +66,14 @@ SECTIONS
 	.text : {
 
 		/* code */
+
+		/* dadao: the stack-setup stub linked as the ELF entry
+		 * (`.text.start`, e.g. the Tiny crt0 wrapper) must be the very
+		 * first code byte, so that `e_entry` equals the profile's fixed
+		 * application entry.  Any earlier-sorted input (for instance
+		 * `.text.unlikely.*` from assert) would otherwise shift it. */
+		KEEP (*(.text.start))
+		KEEP (*(.text.start.*))
 		*(.literal.unlikely .text.unlikely .literal.unlikely.* .text.unlikely.*)
 		*(.literal.startup .text.startup .literal.startup.* .text.startup.*)
 		*(SORT(.text.sorted.*))
@@ -415,10 +423,16 @@ SECTIONS
 
 @LINUX@	PROVIDE ( @PREFIX@__stack_bottom = ORIGIN(ram) + LENGTH(ram) - (DEFINED(@PREFIX@@STACK@_size) ? @PREFIX@@STACK@_size : @DEFAULT_STACK_SIZE@) );
 @LINUX@
-@LINUX@	/* Define a stack region to make sure it fits in memory */
+@LINUX@	/* Define a stack region to make sure it fits in memory.
+@LINUX@	 *
+@LINUX@	 * dadao: keep it out of every PT_LOAD (`:NONE`).  With `:ram` the single
+@LINUX@	 * loadable segment spans the whole RAM window (memsz == region length), so
+@LINUX@	 * a loader that streams the image word by word has to push megabytes of
+@LINUX@	 * zeroes.  RAM starts zeroed on dadao targets, so the stack needs no
+@LINUX@	 * segment. */
 @LINUX@	.stack @PREFIX@__stack_bottom (NOLOAD) : {
 @LINUX@		. += (DEFINED(@PREFIX@@STACK@_size) ? @PREFIX@@STACK@_size : @DEFAULT_STACK_SIZE@);
-@LINUX@	} >ram :ram
+@LINUX@	} >ram :NONE
 
 @C@	/* Throw away C++ exception handling information */
 @C@
