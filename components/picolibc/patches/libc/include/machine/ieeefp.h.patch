+/* DADAO (dadao-unknown-elf) is big-endian (DADAO-v5 contract-abi.md §1.7).
+ * clang does not predefine __FLOAT_WORD_ORDER__ for this target, so the
+ * generic detection above does not fire and the endianness must be stated
+ * explicitly here. */
+#if defined(__dadao__)
+#define __IEEE_BIG_ENDIAN
+#endif
