+ * Layout in libc/machine/dadao/setjmp.S; 162 = 64 (ra) + 1 (sp) + 32 (rd)
+ * + 32 (rb) + 32 (rf) + 1 (rb2).  sizeof(long long) keeps the buffer 8-byte
+ * aligned (required for stm.o/ldm.o).
+ */
+#define _JBTYPE long long
+#define _JBLEN  162
+#endif
