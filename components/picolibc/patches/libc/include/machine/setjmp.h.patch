+ * keeps the buffer 8-byte aligned.
+ *
+ * NOTE: setjmp/longjmp are not implemented for DADAO yet; see
+ * libc/machine/dadao/setjmp.S.  The type is declared so that <setjmp.h>
+ * compiles; a call traps loudly (abort), it does not silently succeed.
+ */
+#define _JBTYPE long long
+#define _JBLEN  66
+#endif
