+#undef __HAVE_BUILTIN_CTZLL
+#undef __HAVE_BUILTIN_FFS
+#undef __HAVE_BUILTIN_FFSL
+#undef __HAVE_BUILTIN_FFSLL
+#endif
+
 #if !__has_builtin(__builtin_expect)
 #define __builtin_expect(cond, exp) (cond)
 #endif
