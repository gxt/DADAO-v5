diff --git a/meson.build b/meson.build
index 93daa5d..f8018b4 100644
--- a/meson.build
+++ b/meson.build
@@ -1924,6 +1924,39 @@ foreach libname : libnames
   libsrcs += get_variable('src_' + libname, [])
 endforeach
 
+# DADAO port scope (INFRA-057t; minimized by INFRA-066t).  The DADAO LLVM
+# backend still cannot select a handful of DAG nodes / lower some libcalls that
+# a few sources need.  Those sources are excluded so the build is deterministic
+# instead of failing halfway.  The list below is the *minimal* set obtained by
+# compiling every source in this build (INFRA-066t); each entry, its failure
+# signature and its root cause are registered in ISS-193.  Delete entries as the
+# backend grows -- never extend the list.  LLVM-084t removed the ISS-193 (a)
+# group (FP unordered-family predicates) after the backend lowered them, and
+# LLVM-086t removed the (e) group (the inline-asm "r" constraint now accepts
+# pointer values) after the backend's getRegForInlineAsmConstraint landed.
+# LLVM-087t removed the f32 rounding / min-max subset of the (b) group
+# (sf_nearbyint / sf_scalb / sf_tgamma / srf_lgamma) after the f32 libcall
+# family (frint / ftrunc / ffloor ...) was registered.
+_dadao_backend_blocked = []
+if host_cpu_family == 'dadao'
+  _dadao_backend_blocked = [
+    # f32 `flog` libcall still missing: sf_log10.c calls the public `logf`,
+    # which clang lowers to `llvm.log.f32` (not the f64 `log64` internal used
+    # by s_log10.c); ISS-193 (b).
+    'sf_log10.c',
+    # i64 bswap not selected; ISS-193 (c).
+    'hash_page.c',
+    # truncating store (i32 store of an f64 value, 'trunc to f32') not
+    # selected; ISS-193 (d).
+    'vfscanf.c',
+    'vfwscanf.c',
+    # long-double strtod engine libcall unsupported; ISS-193 (f).
+    'atold_engine.c',
+  ]
+  message('DADAO port scope: excluding @0@ backend-blocked libc sources (ISS-193)'
+          .format(_dadao_backend_blocked.length()))
+endif
+
 foreach params : targets
   target = params['name']
   target_dir = params['dir']
@@ -1939,6 +1972,23 @@ foreach params : targets
     libsrcs_target += get_variable('src_' + libname + target, [])
   endforeach
 
+  if _dadao_backend_blocked != []
+    _dadao_filtered = []
+    foreach _s : libsrcs_target
+      _p = _s.full_path()
+      _drop = false
+      foreach _b : _dadao_backend_blocked
+        if _p.endswith('/' + _b)
+          _drop = true
+        endif
+      endforeach
+      if not _drop
+        _dadao_filtered += _s
+      endif
+    endforeach
+    libsrcs_target = _dadao_filtered
+  endif
+
   instdir = join_paths(lib_dir, target_dir)
 
   libc_name = 'c'
