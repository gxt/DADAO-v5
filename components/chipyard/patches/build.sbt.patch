diff --git a/build.sbt b/build.sbt
index f56621c..a7a2416 100644
--- a/build.sbt
+++ b/build.sbt
@@ -163,6 +163,75 @@ lazy val rocketchip = freshProject("rocketchip", rocketChipDir)
   )
 lazy val rocketLibDeps = (rocketchip / Keys.libraryDependencies)
 
+// -- DADAO "gewu" cfx register file (m16-chipyard-002) --
+// ADR-0053 D1/D2: cfx is a machine-level control plane, not a pipeline unit,
+// so it is its own generator and depends on `rocketchip` only -- never on a
+// core.  Every DADAO core (this one and later designs) reuses it by adding it
+// to its own dependency list.
+lazy val gewu = freshProject("gewu", file("generators/dadao-gewu"))
+  .dependsOn(rocketchip)
+  .settings(chiselSettings)
+  .settings(libraryDependencies ++= rocketLibDeps.value)
+  .settings(commonSettings)
+
+// -- DADAO "wuming" core (m12-chipyard-001) --
+// Kept in its own project under generators/dadao-wuming; `chipyard` depends
+// on it below so `WumingTile` / `WumingTinyConfig` end up on the generator
+// classpath used by the Verilator flow.  m16-chipyard-002: the core's cfx
+// register file lives in `gewu`, so the dependency goes `wuming -> gewu`.
+lazy val wuming = freshProject("wuming", file("generators/dadao-wuming"))
+  .dependsOn(rocketchip, gewu)
+  .settings(libraryDependencies ++= rocketLibDeps.value)
+  .settings(commonSettings)
+  .settings(
+    // m12-002: the BootROM images are checked in as *text* hex files (a
+    // component patch set cannot carry binary blobs).  Decode each into the
+    // classpath resource that `WithBootROM` names; the resources ride the
+    // wuming jar into the elaboration classpath.
+    //
+    // m12-007 made the Tiny image the fixed firmware (power stub + hmon
+    // segment + reserved + image index table, spec/Kaiwu §6.2); m19-chipyard-004
+    // re-froze it to 8 KiB from `m19-spec-002` (power@0, hmon@0x800, image index
+    // table@0x1F00).  m16-chipyard-025 adds the Vast 4 MiB image (image index
+    // table at offset 0, hmon/smon ELFs, power flat segment in the last 64 KiB,
+    // spec/Kaiwu §6.1).  Both text forms are *sparse*: `@<offset>` lines set the
+    // write offset and byte lines append, so the zero regions cost one line.
+    Compile / resourceGenerators += Def.task {
+      val hexDir = (Compile / resourceDirectory).value / "dadao" / "bootrom"
+      val imgDir = (Compile / resourceManaged).value / "dadao" / "bootrom"
+      Seq(
+        ("bootrom.tiny.hex", "bootrom.tiny.img", 8 * 1024),
+        ("bootrom.vast.hex", "bootrom.vast.img", 4 * 1024 * 1024)
+      ).map { case (hexName, imgName, size) =>
+        val hex = IO.read(hexDir / hexName)
+        val bytes = Array.fill[Byte](size)(0)
+        var pos = 0
+        hex.linesIterator.zipWithIndex.foreach { case (raw, lineno) =>
+          val line = raw.takeWhile(_ != '#').trim
+          if (line.nonEmpty) {
+            if (line.startsWith("@")) {
+              pos = Integer.parseInt(line.drop(1), 16)
+            } else {
+              val digits = line.filterNot(_.isWhitespace)
+              require(digits.length % 2 == 0,
+                s"wuming: $hexName:$lineno has an odd number of hex digits")
+              digits.grouped(2).foreach { d =>
+                require(pos >= 0 && pos < size,
+                  s"wuming: $hexName:$lineno runs past $size bytes")
+                bytes(pos) = Integer.parseInt(d, 16).toByte
+                pos += 1
+              }
+            }
+          }
+        }
+        val out = imgDir / imgName
+        IO.createDirectory(out.getParentFile)
+        IO.write(out, bytes)
+        out
+      }
+    }.taskValue
+  )
+
 
 // -- Chipyard-managed External Projects --
 
@@ -180,6 +249,7 @@ lazy val chipyard = {
       testchipip, rocketchip, boom, rocketchip_blocks, rocketchip_inclusive_cache,
       icenet, tracegen,
       constellation, barf, shuttle, rerocc,
+      wuming, gewu,
     ).map(sbt.Project.projectToRef) ++
     (if (useChisel7) Seq() else Seq(sbt.Project.projectToRef(firrtl2_bridge))) ++
     (if (useChisel7) Seq() else Seq(sbt.Project.projectToRef(dsptools), sbt.Project.projectToRef(rocket_dsp_utils)))
