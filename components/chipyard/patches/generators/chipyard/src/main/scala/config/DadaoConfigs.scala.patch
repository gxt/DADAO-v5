+// See LICENSE for license details.
+//
+// DADAO SoC configurations.
+//
+// m12-chipyard-001: `WumingTinyConfig` is the first DADAO configuration to
+// elaborate (one `wuming` tile, stock chipyard address map).
+//
+// m12-002: land the `Machine-v5-Tiny` core-internal address map from
+// `spec/Machine-v5 §1.1`:
+//
+//   BootROM    0xffff_ffff_0000, 64 KiB, reset vector = base (executable)
+//   SRAM       0xffff_ff00_0000, 8 MiB,  writable main memory  (TL slave port)
+//   hmon SRAM  0x0fff_0000_0000, 64 KiB, hmon run segment      (TL slave port)
+//
+// All three are 48-bit core-internal addresses.  The tile runs with
+// `useVM=false` (no MMU/TLB) and there is no PTW in this machine; the only
+// thing that changes versus stock chipyard is *where* the memories sit, so the
+// TileLink address map negotiates >= 48 address bits.
+//
+// m12-007: the hmon SRAM is a second, independent TL slave (`spec/Machine-v5`
+// §1.1/§6.2; user ruling 2026-11-10 "power SRAM 与 hmon SRAM 是两个不同
+// SRAM"): the power stub copies the hmon segment there at reset, the core
+// executes it, and the host loader is forbidden from writing it.
+//
+// No new upstream `AddressMap`: chipyard builds its map from the
+// `BootROMLocated` and `BankedScratchpadKey` fields, plus the `ExtMem` /
+// `ExtTLMem` backing-memory ports.  The fragment below re-points exactly those
+// fields (`components/chipyard/README.md` records the choice).
+
+package chipyard
+
+import org.chipsalliance.cde.config.Config
+import freechips.rocketchip.devices.tilelink.BootROMLocated
+import freechips.rocketchip.subsystem.{ExtMem, MBUS}
+import testchipip.soc.{BankedScratchpadKey, BankedScratchpadParams}
+
+/** `spec/Machine-v5 §1.1` — Machine-v5-Tiny core-internal address map. */
+object WumingTinyAddressMap {
+  /** BootROM: 0xffff_ffff_0000 .. 0xffff_ffff_ffff (64 KiB), reset vector = base. */
+  val bootROMBase: BigInt = BigInt("ffffffff0000", 16)
+  val bootROMSize: Int = 0x10000
+
+  /** SRAM: 0xffff_ff00_0000 .. 0xffff_ff7f_ffff (8 MiB), the only writable memory. */
+  val sramBase: BigInt = BigInt("ffffff000000", 16)
+  val sramSize: BigInt = 8 << 20
+
+  /** hmon SRAM: 0x0fff_0000_0000, 64 KiB (`spec/DADAO-12 §2.1`). */
+  val hmonBase: BigInt = BigInt("fff00000000", 16)
+  val hmonSize: BigInt = 0x10000
+
+  /**
+   * Fixed application entry (`spec/Machine-v5 §6`): `.text` starts here, the
+   * ELF `e_entry` must equal it and the power stub jumps here after the
+   * handoff.
+   */
+  val appEntry: BigInt = BigInt("ffffff010100", 16)
+
+  /**
+   * Classpath resource of the Tiny bootrom image.
+   *
+   * The image source is a *text* hex file (`dadao/bootrom/bootrom.tiny.hex` in
+   * the `wuming` generator) because a component patch set cannot carry binary
+   * blobs; the `wuming` project's `resourceGenerators` decodes it into this
+   * classpath resource at build time.  m12-007 owns the image content (the
+   * 64 KiB fixed firmware packed by `tools/testcases/arch/build_tiny_bootrom.py`).
+   */
+  val bootROMImage: String = "/dadao/bootrom/bootrom.tiny.img"
+}
+
+/**
+  * Machine-v5-Tiny memory map fragment.
+  *
+  * Replaces chipyard's stock devices instead of adding a new `AddressMap`:
+  * the BootROM geometry comes from `WithBootROM`, the SRAM replaces the
+  * default 64 KiB scratchpad, and the stock AXI/TL backing memory is removed
+  * (the SRAM *is* main memory on this machine, and Tiny has no DRAM).
+  */
+class WithDadaoTinyAddressMap extends Config((site, here, up) => {
+  // Tiny's BootROM is the *fixed firmware image* (power stub + hmon segment +
+  // reserved + image index table, `spec/Machine-v5 §6.2`), not the stock
+  // chipyard bootrom: no appended chipyard DTB.
+  case BootROMLocated(x) => up(BootROMLocated(x), site).map(_.copy(appendDTB = false))
+
+  // No backing memory behind the buses; the on-chip SRAM below is the main
+  // memory.  Both chipyard backing-memory ports must be empty.
+  case ExtMem => None
+  case ExtTLMem => None
+
+  // SRAM as an 8 MiB TL slave port on the memory bus, at the spec address.
+  // `dtsEnabled` keeps the `memory` node advertised in the generated DTS.
+  //
+  // m12-007: the hmon SRAM is a separate 64 KiB TL slave at 0x0fff_0000_0000.
+  // The power stub fills it from the BootROM image before the first `trap`
+  // into hmon; the host loader never writes it (`WumingLoadMem` enforces that).
+  case BankedScratchpadKey => Seq(
+    BankedScratchpadParams(
+      base = WumingTinyAddressMap.sramBase,
+      size = WumingTinyAddressMap.sramSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "dadao-tiny-sram",
+      dtsEnabled = true),
+    BankedScratchpadParams(
+      base = WumingTinyAddressMap.hmonBase,
+      size = WumingTinyAddressMap.hmonSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "dadao-tiny-hmon-sram",
+      dtsEnabled = false))
+})
+
+class WumingTinyConfig extends Config(
+  // BootROM geometry / reset vector / image name (`spec/Machine-v5 §1.1`).
+  new chipyard.config.WithBootROM(
+    address = WumingTinyAddressMap.bootROMBase,
+    size = WumingTinyAddressMap.bootROMSize,
+    hang = WumingTinyAddressMap.bootROMBase,
+    contentFileName = Some(WumingTinyAddressMap.bootROMImage)) ++
+  // m12-003: a program that ends in an undefined instruction is stopped by the
+  // tile cease.  m12-004 adds the semihosting responder (console + SYS_EXIT);
+  // the cease path stays for non-semihosting probes.  Expose the cease sink as
+  // a success port and drive TestDriver's `$stop` from it.
+  new chipyard.iobinders.WithWumingCeaseSuccess ++
+  new chipyard.harness.WithTraceGenSuccess ++
+  new WithDadaoTinyAddressMap ++
+  // m12-003: the `+loadmem=` loader validates ELF PT_LOAD segments against this
+  // writable window and streams them into the SRAM through the tile's TL port.
+  // Both values come from the address map above — there is no default.
+  new wuming.common.WithNWumingTiles(1, wuming.common.WumingCoreParams(
+    loadMemBase = Some(WumingTinyAddressMap.sramBase),
+    loadMemSize = Some(WumingTinyAddressMap.sramSize),
+    // m12-007: application-load contract (`spec/Machine-v5 §6`) and the hmon
+    // handoff geometry (`§6.2`, `DADAO-13 §1`) — all from the address map.
+    loadMemEntry = Some(WumingTinyAddressMap.appEntry),
+    hmonBase = Some(WumingTinyAddressMap.hmonBase),
+    hmonSize = Some(WumingTinyAddressMap.hmonSize),
+    bootromBase = Some(WumingTinyAddressMap.bootROMBase),
+    bootromSize = Some(BigInt(WumingTinyAddressMap.bootROMSize)))) ++
+  new chipyard.config.AbstractConfig)
