index 0000000..a006253
--- /dev/null
+++ b/generators/chipyard/src/main/scala/config/DadaoConfigs.scala
@@ -0,0 +1,368 @@
+// See LICENSE for license details.
+//
+// DADAO SoC configurations.
+//
+// m12-chipyard-001: `WumingTinyConfig` is the first DADAO configuration to
+// elaborate (one `wuming` tile, stock chipyard address map).
+//
+// m12-002: land the `Kaiwu-Tiny` core-internal address map from
+// `spec/Kaiwu §1.1` (sizes re-frozen by m19-chipyard-004 from `m19-spec-002`):
+//
+//   BootROM    0xffff_ffff_0000, 8 KiB,  reset vector = base (executable)
+//   SRAM       0xffff_ff00_0000, 256 KiB, writable main memory (TL slave port)
+//   hmon SRAM  0x0fff_0000_0000, 8 KiB,  hmon run segment      (TL slave port)
+//
+// All three are 48-bit core-internal addresses.  The tile runs with
+// `useVM=false` (no MMU/TLB) and there is no PTW in this machine; the only
+// thing that changes versus stock chipyard is *where* the memories sit, so the
+// TileLink address map negotiates >= 48 address bits.
+//
+// m12-007: the hmon SRAM is a second, independent TL slave (`spec/Kaiwu`
+// §1.1/§6.2; user ruling 2026-11-10 "power SRAM 与 hmon SRAM 是两个不同
+// SRAM"): the power stub copies the hmon segment there at reset, the core
+// executes it, and the host loader is forbidden from writing it.
+//
+// No new upstream `AddressMap`: chipyard builds its map from the
+// `BootROMLocated` and `BankedScratchpadKey` fields, plus the `ExtMem` /
+// `ExtTLMem` backing-memory ports.  The fragment below re-points exactly those
+// fields (`components/chipyard/README.md` records the choice).
+
+package chipyard
+
+import org.chipsalliance.cde.config.Config
+import freechips.rocketchip.devices.tilelink.BootROMLocated
+import freechips.rocketchip.subsystem.{ExtMem, MBUS, MasterPortParams, MemoryPortParams}
+import freechips.rocketchip.devices.tilelink.{CLINTKey, PLICKey}
+import testchipip.boot.TileResetCtrlKey
+import chipyard.clocking.ChipyardPRCIControlKey
+import freechips.rocketchip.util.ClockGateModelFile
+import testchipip.soc.{BankedScratchpadKey, BankedScratchpadParams}
+
+/** `spec/Kaiwu §1.1` — Kaiwu-Tiny core-internal address map.
+  *
+  * Geometry frozen by `m19-spec-002` (m19-chipyard-004): 8 KiB BootROM,
+  * 256 KiB main SRAM, 8 KiB hmon SRAM; the application entry/raw base is
+  * `MAIN_SRAM_BASE + 0x2000` (`kernel_reserved = 0`). */
+object WumingTinyAddressMap {
+  /** BootROM: 0xffff_ffff_0000 .. 0xffff_ffff_1fff (8 KiB), reset vector = base.
+    *
+    * Tiny's ROM is 8 KiB and its reset point is the ROM *start* (a profile-level
+    * deviation from the upstream >= 64 KiB / last-64-KiB rule, `spec/Kaiwu §1.1`). */
+  val bootROMBase: BigInt = BigInt("ffffffff0000", 16)
+  val bootROMSize: Int = 0x2000
+
+  /** SRAM: 0xffff_ff00_0000 .. 0xffff_ff03_ffff (256 KiB), the only writable memory. */
+  val sramBase: BigInt = BigInt("ffffff000000", 16)
+  val sramSize: BigInt = 0x4_0000
+
+  /** hmon SRAM: 0x0fff_0000_0000, 8 KiB (`spec/DADAO-12 §2.1`). */
+  val hmonBase: BigInt = BigInt("fff00000000", 16)
+  val hmonSize: BigInt = 0x2000
+
+  /**
+   * Fixed application entry (`spec/Kaiwu §6`): the raw image base, the ELF
+   * `e_entry` and the power stub's jump target are all this one address
+   * (`MAIN_SRAM_BASE + 0x2000`, `kernel_reserved = 0`).
+   */
+  val appEntry: BigInt = BigInt("ffffff002000", 16)
+
+  /**
+   * Classpath resource of the Tiny bootrom image.
+   *
+   * The image source is a *text* hex file (`dadao/bootrom/bootrom.tiny.hex` in
+   * the `wuming` generator) because a component patch set cannot carry binary
+   * blobs; the `wuming` project's `resourceGenerators` decodes it into this
+   * classpath resource at build time.  m12-007 owns the image content (the
+   * fixed firmware packed by `tools/testcases/arch/build_tiny_bootrom.py`);
+   * `m19-chipyard-004` re-froze it to 8 KiB from `m19-spec-002`: power@0x0000,
+   * hmon source@0x0800, image index table@0x1F00.
+   */
+  val bootROMImage: String = "/dadao/bootrom/bootrom.tiny.img"
+}
+
+/**
+  * Kaiwu-Tiny memory map fragment.
+  *
+  * Replaces chipyard's stock devices instead of adding a new `AddressMap`:
+  * the BootROM geometry comes from `WithBootROM`, the SRAM replaces the
+  * default 64 KiB scratchpad, and the stock AXI/TL backing memory is removed
+  * (the SRAM *is* main memory on this machine, and Tiny has no DRAM).
+  */
+class WithDadaoTinyAddressMap extends Config((site, here, up) => {
+  // Tiny's BootROM is the *fixed firmware image* (power stub + hmon segment +
+  // reserved + image index table, `spec/Kaiwu §6.2`), not the stock
+  // chipyard bootrom: no appended chipyard DTB.
+  case BootROMLocated(x) => up(BootROMLocated(x), site).map(_.copy(appendDTB = false))
+
+  // No backing memory behind the buses; the on-chip SRAM below is the main
+  // memory.  Both chipyard backing-memory ports must be empty.
+  case ExtMem => None
+  case ExtTLMem => None
+
+  // SRAM as a 256 KiB TL slave port on the memory bus, at the spec address.
+  // `dtsEnabled` keeps the `memory` node advertised in the generated DTS.
+  //
+  // m12-007: the hmon SRAM is a separate 8 KiB TL slave at 0x0fff_0000_0000.
+  // The power stub fills it from the BootROM image before the first `trap`
+  // into hmon; the host loader never writes it (`WumingLoadMem` enforces that).
+  case BankedScratchpadKey => Seq(
+    BankedScratchpadParams(
+      base = WumingTinyAddressMap.sramBase,
+      size = WumingTinyAddressMap.sramSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-tiny-sram",
+      dtsEnabled = true),
+    BankedScratchpadParams(
+      base = WumingTinyAddressMap.hmonBase,
+      size = WumingTinyAddressMap.hmonSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-tiny-hmon-sram",
+      dtsEnabled = false))
+})
+
+class WumingTinyConfig extends Config(
+  // BootROM geometry / reset vector / image name (`spec/Kaiwu §1.1`).
+  new chipyard.config.WithBootROM(
+    address = WumingTinyAddressMap.bootROMBase,
+    size = WumingTinyAddressMap.bootROMSize,
+    hang = WumingTinyAddressMap.bootROMBase,
+    contentFileName = Some(WumingTinyAddressMap.bootROMImage)) ++
+  // m12-003: a program that ends in an undefined instruction is stopped by the
+  // tile cease.  m12-004 adds the semihosting responder (console + SYS_EXIT);
+  // the cease path stays for non-semihosting probes.  Expose the cease sink as
+  // a success port and drive TestDriver's `$stop` from it.
+  new chipyard.iobinders.WithWumingCeaseSuccess ++
+  new chipyard.harness.WithTraceGenSuccess ++
+  new WithDadaoTinyAddressMap ++
+  // m12-003: the `+loadmem=` loader validates ELF PT_LOAD segments against this
+  // writable window and streams them into the SRAM through the tile's TL port.
+  // Both values come from the address map above — there is no default.
+  new wuming.common.WithNWumingTiles(1, wuming.common.WumingCoreParams(
+    loadMemBase = Some(WumingTinyAddressMap.sramBase),
+    loadMemSize = Some(WumingTinyAddressMap.sramSize),
+    // m12-007: application-load contract (`spec/Kaiwu §6`) and the hmon
+    // handoff geometry (`§6.2`, `DADAO-13 §1`) — all from the address map.
+    loadMemEntry = Some(WumingTinyAddressMap.appEntry),
+    hmonBase = Some(WumingTinyAddressMap.hmonBase),
+    hmonSize = Some(WumingTinyAddressMap.hmonSize),
+    bootromBase = Some(WumingTinyAddressMap.bootROMBase),
+    bootromSize = Some(BigInt(WumingTinyAddressMap.bootROMSize)))) ++
+  new chipyard.config.AbstractConfig)
+
+// ---------------------------------------------------------------------------
+// m16-chipyard-006: Kaiwu-Vast
+// ---------------------------------------------------------------------------
+//
+// Kaiwu-Vast is the same core as Kaiwu-Tiny plus a translated memory window
+// (`WumingCoreParams.useVM = true`, `DADAO-12` §2.2): with `cfx_ptw_enable = 0`
+// every `addr[47:42] = 0` access is plain `CFXMEM` and cfx-space
+// addresses are reached exactly as on Tiny, so the two profiles share the
+// core-internal map below and are comparable byte for byte.
+//
+// What is *not* here yet: the physical half of the Vast machine (`spec/Kaiwu §1`
+// — a 4 MiB BootROM and 2 GiB of PA RAM behind the page tables).  Only a
+// translating machine can reach that memory, so it lands with the walker
+// (`m16-chipyard-007`); until then `cfx_ptw_enable = 1` faults with the missing
+// class instead of pretending to have memory.  The map below is therefore the
+// *groundwork* map, and the two `BankedScratchpad` device names are distinct so
+// a DTS/log cannot confuse one profile with the other.
+
+/** Kaiwu-Vast address map (`m16-chipyard-006`, PA RAM `m16-chipyard-007`). */
+object WumingVastAddressMap {
+  /** BootROM: 0xffff_ffc0_0000 .. 0xffff_ffff_ffff (4 MiB, `spec/Kaiwu §3`);
+    * the reset vector is the last 64 KiB's start, 0xffff_ffff_0000
+    * (image offset 0x3f_0000).  Tiny's 8 KiB window (m19-chipyard-004) is
+    * deliberately *not* inherited: Vast keeps its own 4 MiB ROM. */
+  val bootROMBase: BigInt = BigInt("ffffffc00000", 16)
+  val bootROMSize: Int = 0x400000
+  val bootROMReset: BigInt = bootROMBase + bootROMSize - 0x10000
+  val sramBase: BigInt = WumingTinyAddressMap.sramBase
+  /** Vast's writable core-internal window: 8 MiB, unchanged by the M19 Tiny
+    * re-freeze (`spec/Kaiwu §1.1` gives Vast no core-internal SRAM of its own —
+    * this window is the Vast regression load target and stays as it was). */
+  val sramSize: BigInt = 8 << 20
+  val hmonBase: BigInt = WumingTinyAddressMap.hmonBase
+  /** Vast's hmon SRAM is 64 KiB (`spec/Kaiwu §1.1` Vast table); Tiny's is 8 KiB
+    * since `m19-spec-002`, so this value is spelled out rather than inherited. */
+  val hmonSize: BigInt = 0x10000
+  /** `cfx_smon`'s 64 KiB SRAM (`contract-see §3`; `m16-chipyard-019`). */
+  val smonBase: BigInt = BigInt("bff00000000", 16)
+  val smonSize: BigInt = BigInt(0x10000)
+  /** `cfx_pmem`'s 64 KiB SRAM (`spec/Kaiwu §1.1`, `m16-chipyard-022`):
+    * `(cfxha 32 << 42) | 0x3ff_0000_0000`. */
+  val pmemBase: BigInt = BigInt("83ff00000000", 16)
+  val pmemSize: BigInt = BigInt(0x10000)
+  /** Vast's fixed application entry: `.text` at 0xffff_ff01_0100, unchanged by
+    * the M19 Tiny re-freeze (Tiny moved to `MAIN_SRAM_BASE + 0x2000`). */
+  val appEntry: BigInt = BigInt("ffffff010100", 16)
+  /** Vast's 4 MiB image (image index table at offset 0, ELF payloads, power
+    * flat segment at 0x3f_0000); decoded from the sparse text hex by the
+    * `wuming` resource generator, exactly like Tiny's. */
+  val bootROMImage: String = "/dadao/bootrom/bootrom.vast.img"
+
+  /**
+   * Physical memory behind the page tables (`spec/Kaiwu §1.1`: PA RAM
+   * `[0, 2 GiB)`, reachable only through the translated memory window).
+   *
+   * m16-chipyard-007 lands it as the SoC's AXI4 memory port (`ExtMem`) backed
+   * by the harness `SimDRAM` black box: the host model maps the window lazily,
+   * so the 2 GiB *address* space costs nothing until a page is touched.  The
+   * walker's page-table accesses and every translated data/fetch access land
+   * here; it is also the window the host loader streams PT_LOAD segments
+   * into.
+   */
+  val paRamBase: BigInt = 0
+  val paRamSize: BigInt = 2L << 30
+
+  /** RISC-V CLINT/PLIC, kept for the SoC interrupt bus but parked outside PA
+    * RAM (the DADAO machine does not use them). */
+  val clintBase: BigInt = BigInt("ff0000000000", 16)
+  val tileResetCtrlBase: BigInt = BigInt("ff0200000000", 16)
+  val prciCtrlBase: BigInt = BigInt("ff0300000000", 16)
+  val plicBase: BigInt = BigInt("ff0100000000", 16)
+}
+
+/**
+  * Kaiwu-Vast memory map fragment.
+  *
+  * Same shape as `WithDadaoTinyAddressMap` (deliberately a separate fragment
+  * rather than a shared parameterised one: Tiny's elaboration is frozen by its
+  * regression vectors, and Vast's geometry diverges when the PA RAM lands).
+  */
+class WithDadaoVastAddressMap extends Config((site, here, up) => {
+  case BootROMLocated(x) => up(BootROMLocated(x), site).map(_.copy(appendDTB = false))
+
+  // m16-chipyard-007: PA RAM behind the page tables (`spec/Kaiwu §1.1`).
+  //
+  // It is a TileLink slave port on the memory bus, like the core-internal
+  // SRAMs — *not* an AXI4 `ExtMem` + harness `SimDRAM`.  Reasons: the DADAO
+  // machine has no host-side DRAM loader (its images are streamed by the tile's
+  // own loader, and fesvr's `load_elf` refuses a non-RISC-V ELF), and the
+  // TL slave keeps the whole machine on one bus with one address space (the
+  // walker, the loader and the core all reach PA RAM the same way).
+  case ExtMem => None
+  case ExtTLMem => None
+
+  // The RISC-V CLINT/PLIC and the inclusive LLC's control device sit inside PA
+  // RAM at their stock addresses (0x0200_0000 / 0x0c00_0000 / 0x0201_0000).
+  // The DADAO machine never accesses them (only its own windows reach a bus),
+  // but their address sets must not overlap the physical memory window, so
+  // they move to the core-internal part of the 48-bit space.
+  case CLINTKey => up(CLINTKey, site).map(_.copy(baseAddress = WumingVastAddressMap.clintBase))
+  case PLICKey => up(PLICKey, site).map(_.copy(baseAddress = WumingVastAddressMap.plicBase))
+
+  // testchipip's tile-reset control and the PRCI control block default to
+  // 0x0010_0000, inside PA RAM.  The DADAO machine never uses them (the tile
+  // comes out of reset through the loader handshake), so they move out of the
+  // way instead of being disabled — the SoC clock/reset plumbing still needs
+  // them present.
+  case TileResetCtrlKey => up(TileResetCtrlKey, site).copy(
+    address = WumingVastAddressMap.tileResetCtrlBase)
+  case ChipyardPRCIControlKey => up(ChipyardPRCIControlKey, site).copy(
+    baseAddress = WumingVastAddressMap.prciCtrlBase)
+  // The EICG clock-gate model is a simulation-only register block whose control
+  // sits at 0x0010_0000 as well; this profile does no clock gating.
+  case ClockGateModelFile => None
+
+  case BankedScratchpadKey => Seq(
+    BankedScratchpadParams(
+      base = WumingVastAddressMap.sramBase,
+      size = WumingVastAddressMap.sramSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-vast-sram",
+      dtsEnabled = true),
+    BankedScratchpadParams(
+      base = WumingVastAddressMap.hmonBase,
+      size = WumingVastAddressMap.hmonSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-vast-hmon-sram",
+      dtsEnabled = false),
+    // cfx_smon's 64 KiB SRAM (`m16-chipyard-019`, `contract-see §3`).
+    BankedScratchpadParams(
+      base = WumingVastAddressMap.smonBase,
+      size = WumingVastAddressMap.smonSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-vast-smon-sram",
+      dtsEnabled = false),
+    // cfx_pmem's 64 KiB SRAM (`m16-chipyard-022`, `spec/Kaiwu §1.1`).
+    BankedScratchpadParams(
+      base = WumingVastAddressMap.pmemBase,
+      size = WumingVastAddressMap.pmemSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-vast-pmem-sram",
+      dtsEnabled = false),
+    // PA RAM: the translated memory window (`[0, 2 GiB)`, `spec/Kaiwu §1.1`).
+    // A TLRAM slave is 2 GiB of *address* space; the backing store is the
+    // simulator's sparse heap, so untouched pages cost nothing.
+    BankedScratchpadParams(
+      base = WumingVastAddressMap.paRamBase,
+      size = WumingVastAddressMap.paRamSize,
+      busWhere = MBUS,
+      banks = 1,
+      subBanks = 1,
+      name = "kaiwu-vast-pa-ram",
+      dtsEnabled = false))
+})
+
+/** Kaiwu-Vast: one `wuming` tile with the memory window translated. */
+class WumingVastConfig extends Config(
+  new chipyard.config.WithBootROM(
+    address = WumingVastAddressMap.bootROMBase,
+    size = WumingVastAddressMap.bootROMSize,
+    hang = WumingVastAddressMap.bootROMReset,
+    contentFileName = Some(WumingVastAddressMap.bootROMImage)) ++
+  new chipyard.iobinders.WithWumingCeaseSuccess ++
+  new chipyard.harness.WithTraceGenSuccess ++
+  new WithDadaoVastAddressMap ++
+  // No inclusive LLC: the DADAO machine keeps no coherence state (its only
+  // client is the core, no caches yet) and the LLC's control device would sit
+  // at 0x0201_0000, inside PA RAM.  A broadcast manager keeps the TileLink
+  // subsystem legal without adding a coherence cache (`m16-chipyard-009/010`
+  // bring the DADAO's own caches).
+  new chipyard.config.WithBroadcastManager ++
+  // testchipip's boot-address register (0x1000) has no meaning on a machine
+  // with a fixed entry, and it would sit inside PA RAM.
+  new testchipip.boot.WithNoBootAddrReg ++
+  new testchipip.boot.WithNoCustomBootPin ++
+  // No RISC-V MMIO peripherals: the DADAO machine's console is semihosting
+  // (`spec/Kaiwu §5`) and their stock addresses are inside PA RAM.
+  new chipyard.config.WithNoUART ++
+  // The DADAO machine has no RISC-V debug module; chipyard's would sit at
+  // address 0 and collide with PA RAM (`spec/Kaiwu §1.1`: PA RAM starts at 0).
+  new chipyard.config.WithNoDebug ++
+  // The buses' built-in error devices sit at 0x3000, inside PA RAM.  The DADAO
+  // address map denies unbacked accesses in the core itself (`CFXMEM`), so the
+  // simulation-only error devices have nothing to catch.
+  new chipyard.config.WithNoBusErrorDevices ++
+  // No host debug transport: the DADAO machine is loaded through the tile's own
+  // loader (`+loadmem=`), and the stock TSI has no target on this machine.
+  new chipyard.harness.WithSerialTLTiedOff ++
+  // `WumingVastParams` supplies the same address-map values plus
+  // `useVM = true` (no defaults: an absent base is an elaboration error).
+  new wuming.common.WithNWumingTiles(1, wuming.common.WumingVastParams(
+    loadMemBase = WumingVastAddressMap.sramBase,
+    loadMemSize = WumingVastAddressMap.sramSize,
+    loadMemEntry = WumingVastAddressMap.appEntry,
+    hmonBase = WumingVastAddressMap.hmonBase,
+    hmonSize = WumingVastAddressMap.hmonSize,
+    smonBase = WumingVastAddressMap.smonBase,
+    smonSize = WumingVastAddressMap.smonSize,
+    pmemBase = WumingVastAddressMap.pmemBase,
+    pmemSize = WumingVastAddressMap.pmemSize,
+    bootromBase = WumingVastAddressMap.bootROMBase,
+    bootromSize = WumingVastAddressMap.bootROMSize,
+    paRamBase = WumingVastAddressMap.paRamBase,
+    paRamSize = WumingVastAddressMap.paRamSize)) ++
+  new chipyard.config.AbstractConfig)
