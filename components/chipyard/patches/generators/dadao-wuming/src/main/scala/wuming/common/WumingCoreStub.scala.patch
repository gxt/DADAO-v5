+// See LICENSE for license details.
+//
+// DADAO "wuming" core placeholder (m12-chipyard-001).
+//
+// Purpose: exercise the tile<->TileLink wiring with a fixed, observable
+// behaviour before any DADAO instruction execution exists.  After reset it
+// waits `startDelay` cycles, issues one PutFullData to `testAddress`, then
+// halts (and reports cease).  The real core replaces this module in m12-002.
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+import freechips.rocketchip.tilelink.{TLEdgeOut, TLBundle}
+
+class WumingCoreStub(
+  edge: TLEdgeOut,
+  params: WumingCoreParams,
+  hartidBits: Int,
+  resetVectorBits: Int
+) extends Module {
+  val io = IO(new Bundle {
+    // Client-side TileLink port (a/d only: no probes, no acquires).
+    val tl = new TLBundle(edge.bundle)
+    val hartid = Input(UInt((hartidBits max 1).W))
+    val resetVector = Input(UInt(resetVectorBits.W))
+    val halted = Output(Bool())
+  })
+
+  val tl = io.tl
+  val startDelay = 64
+  val lgSize = log2Ceil(8)
+
+  val cycle = RegInit(0.U(32.W))
+  val sIdle :: sSend :: sWait :: sDone :: Nil = Enum(4)
+  val state = RegInit(sIdle)
+
+  switch(state) {
+    is(sIdle) { when(cycle >= startDelay.U) { state := sSend } }
+    is(sSend) { when(tl.a.ready) { state := sWait } }
+    is(sWait) { when(tl.d.fire) { state := sDone } }
+    is(sDone) { }
+  }
+  cycle := cycle + 1.U
+
+  val (putLegal, putBits) =
+    edge.Put(0.U, params.testAddress.U, lgSize.U, params.testData.U)
+  tl.a.valid := state === sSend
+  tl.a.bits := putBits
+  tl.d.ready := true.B
+
+  assert(
+    state =/= sSend || putLegal,
+    "WumingCoreStub: test address is not backed by a PutFull-capable manager")
+  assert(
+    !(tl.d.valid && tl.d.bits.denied),
+    "WumingCoreStub: TileLink denied the stub access")
+
+  when(state === sIdle && cycle === (startDelay - 1).U) {
+    printf(p"WumingCoreStub: hartid=${io.hartid} reset_vector=0x${Hexadecimal(io.resetVector)}\n")
+  }
+  when(cycle >= 60.U && cycle < 90.U) {
+    printf(
+      p"WumingCoreStub: dbg cyc=$cycle state=$state aValid=${tl.a.valid} " +
+        p"aReady=${tl.a.ready} dValid=${tl.d.valid}\n")
+  }
+  when(tl.d.fire) {
+    printf(
+      p"WumingCoreStub: PutFull 0x${Hexadecimal(params.testAddress.U)} <= " +
+        p"0x${Hexadecimal(params.testData.U)} ok (cycle=${cycle})\n")
+  }
+
+  io.halted := state === sDone
+}
