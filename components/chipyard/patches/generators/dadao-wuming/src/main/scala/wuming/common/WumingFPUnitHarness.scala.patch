diff --git a/generators/dadao-wuming/src/main/scala/wuming/common/WumingFPUnitHarness.scala b/generators/dadao-wuming/src/main/scala/wuming/common/WumingFPUnitHarness.scala
new file mode 100644
index 0000000..ef11e8f
--- /dev/null
+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingFPUnitHarness.scala
@@ -0,0 +1,656 @@
+// See LICENSE for license details.
+//
+// Unit bench for the FP infrastructure (m12-chipyard-011).
+//
+// This module is **bench only**: nothing in the SoC instantiates it.  It is
+// emitted on its own (`sbt "wuming/runMain wuming.common.WumingFPUnitEmit"`)
+// and driven by `tools/chipyard/fp_unit/tb_fp_unit.cpp` under Verilator, which
+// is how the rounding primitive is compared against berkeley-hardfloat's
+// `RoundAnyRawFNToRecFN` bit for bit.  Using hardfloat here (and only here)
+// keeps the *core* free of the hardfloat dependency while still making the
+// equivalence check a real RTL/RTL comparison instead of a model comparison.
+//
+// Ops (io.op):
+//   0  recFNFromFN       ft   in = fn32              out = recFN(33)
+//   1  fNFromRecFN       ft   in = recFN(33)         out = fn32
+//   2  recFNFromFN       fo   in = fn64              out = recFN(65)
+//   3  fNFromRecFN       fo   in = recFN(65)         out = fn64
+//   4  round (8,26)->(8,24)   in = raw pack (41)     out = recFN(33)
+//   5  round (11,55)->(11,53) in = raw pack (73)     out = recFN(65)
+//   6  round (11,55)->(8,24)  in = raw pack (73)     out = recFN(33)
+//   7  round (8,26)->(11,53)  in = raw pack (41)     out = recFN(65)
+//   8  classifyFN        ft   in = fn32              out = class bits
+//   9  classifyFN        fo   in = fn64              out = class bits
+//  10  sgnj ft  in = {rfHD[63:0], rfHC[63:0]}        out = rfHB
+//  11  sgnn ft
+//  12  sgnj fo
+//  13  sgnn fo
+//  14  f2i  ft -> 32-bit integer   in = fn32        inHi[0] = signedOut
+//  15  f2i  ft -> 64-bit integer
+//  16  f2i  fo -> 32-bit integer   in = fn64
+//  17  f2i  fo -> 64-bit integer
+//  18  i2f  32-bit integer -> ft   in = int        inHi[0] = signedIn
+//  19  i2f  64-bit integer -> ft
+//  20  i2f  32-bit integer -> fo
+//  21  i2f  64-bit integer -> fo
+//  22  ft2fo (exact, SBZ)          in = fn32
+//  23  fo2ft (six directions)      in = fn64
+//  24  rounding primitive with `infiniteExc` raised (the divide-by-zero /
+//      `DZ` lane) on a normal ft input -- the m12-011 bench tied that port to
+//      0, so this op is what first exercises it
+//  25  add ft           in = a, inHi = b
+//  26  sub ft
+//  27  mul ft
+//  28  fma ft           in = a, inHi = b, inExtra = c
+//  29  add fo
+//  30  sub fo
+//  31  mul fo
+//  32  fma fo
+//  33  qcmp ft          in = a, inHi = b        (quiet compare)
+//  34  scmp ft                                  (signalling compare)
+//  35  qcmp fo
+//  36  scmp fo
+//  37  min ft
+//  38  max ft
+//  39  min fo
+//  40  max fo
+//
+//  41  fodiv (multi-cycle)     in = a, inHi = b
+//  42  fodiv fo
+//  43  foroot                  in = a
+//  44  foroot fo
+//  45  forem                   in = a, inHi = b
+//  46  forem fo
+//
+// Ops 41-46 are clocked: `io.slowStart` is a one-cycle pulse and `io.slowDone`
+// (or the hardfloat twin's `outValid`) marks the cycle whose `outLo`/`outHi`/
+// `flags` -- `hfOutLo`/`hfOutHi`/`hfFlags` -- are the result.  The TB holds the
+// clock for the combinational ops and ticks it for these.
+//
+// `hfOut`/`hfFlags` carry the hardfloat result of the same operation for ops
+// 4-7 (its raw `exceptionFlags` order: NV, DZ, OF, UF, NX), for the conversion
+// ops (already normalised) and for ops 25-36 (hardfloat's `AddRecFN`,
+// `MulRecFN`, `MulAddRecFN` and `CompareRecFN`).  The two min/max ops have no
+// hardfloat counterpart and are checked against the exact oracle only.
+// `io.flags` uses the DADAO `rf0[4:0]` order.
+//
+// The `WumingFcsr` instance is the clocked part of the bench (ops are
+// combinational, so the TB just holds the clock while evaluating them).
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+
+class WumingFPUnitHarness extends Module {
+  val io = IO(new Bundle {
+    val op = Input(UInt(6.W))
+    val mode = Input(UInt(3.W))
+    val inLo = Input(UInt(64.W))
+    val inHi = Input(UInt(64.W))
+    val inExtra = Input(UInt(64.W)) // third source of the fused multiply-add
+    val outLo = Output(UInt(64.W))
+    val outHi = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+    val hfOutLo = Output(UInt(64.W))
+    val hfOutHi = Output(UInt(64.W))
+    val hfFlags = Output(UInt(5.W))
+    val fcsrWrEn = Input(Bool())
+    val fcsrWrData = Input(UInt(64.W))
+    val fcsrFflags = Input(UInt(5.W))
+    val fcsrRead = Output(UInt(64.W))
+    // m12-014: the multi-cycle family's start pulse and completion strobes.
+    val slowStart = Input(Bool())
+    val slowDone = Output(Bool())
+    val slowBusy = Output(Bool())
+    val hfValid = Output(Bool())
+  })
+
+  /** The 128-bit bench word, split so the C++ side only deals with 64-bit
+    * values (Verilator's wide-port handling would otherwise leak into the TB).
+    */
+  val in = Cat(io.inHi, io.inLo)
+
+  // ---- encode / decode ---------------------------------------------------
+  val ftFnWidth = WumingFmt.ftExp + WumingFmt.ftSig
+  val foFnWidth = WumingFmt.foExp + WumingFmt.foSig
+  val ftRecWidth = WumingRecFN.width(WumingFmt.ftExp, WumingFmt.ftSig)
+  val foRecWidth = WumingRecFN.width(WumingFmt.foExp, WumingFmt.foSig)
+
+  // ---- rounding units (mine + hardfloat, same parameters) ---------------
+  def rawPort(ie: Int, isig: Int, pack: UInt) = {
+    // pack = sign, isZero, isInf, isNaN, sExp(ie+2), sig(isig+1)
+    val r = Wire(new WumingRawFloat(ie, isig))
+    val sigW = isig + 1
+    val expW = ie + 2
+    r.sig := pack(sigW - 1, 0)
+    r.sExp := pack(expW + sigW - 1, sigW).asSInt
+    r.isNaN := pack(expW + sigW)
+    r.isInf := pack(expW + sigW + 1)
+    r.isZero := pack(expW + sigW + 2)
+    r.sign := pack(expW + sigW + 3)
+    r
+  }
+  def rawPackWidth(ie: Int, isig: Int) = ie + 2 + isig + 1 + 4
+
+  final class RoundCfg(ie: Int, isig: Int, oe: Int, osig: Int) {
+    val mine = Module(new WumingRoundAnyRawFNToRecFN(ie, isig, oe, osig))
+    val hf = Module(new hardfloat.RoundAnyRawFNToRecFN(
+      ie, isig, oe, osig, hardfloat.consts.flRoundOpt_sigMSBitAlwaysZero))
+    val pack = rawPort(ie, isig, in)
+    mine.io.in := pack
+    hf.io.in.isNaN := pack.isNaN
+    hf.io.in.isInf := pack.isInf
+    hf.io.in.isZero := pack.isZero
+    hf.io.in.sign := pack.sign
+    hf.io.in.sExp := pack.sExp
+    hf.io.in.sig := pack.sig
+    mine.io.invalidExc := false.B
+    hf.io.invalidExc := false.B
+    mine.io.infiniteExc := false.B
+    hf.io.infiniteExc := false.B
+    mine.io.roundingMode := io.mode
+    hf.io.roundingMode := io.mode
+    // spec/SimRISC-07 §1.4: tininess is detected after rounding
+    hf.io.detectTininess := hardfloat.consts.tininess_afterRounding
+    def out: UInt = mine.io.out
+    def flags: UInt = mine.io.exceptionFlags
+    def hfO: UInt = hf.io.out
+    def hfF: UInt = hf.io.exceptionFlags
+  }
+
+  val cfgFtFt = new RoundCfg(WumingFmt.ftExp, WumingFmt.ftSig + 2,
+    WumingFmt.ftExp, WumingFmt.ftSig)
+  val cfgFoFo = new RoundCfg(WumingFmt.foExp, WumingFmt.foSig + 2,
+    WumingFmt.foExp, WumingFmt.foSig)
+  val cfgFoFt = new RoundCfg(WumingFmt.foExp, WumingFmt.foSig + 2,
+    WumingFmt.ftExp, WumingFmt.ftSig)
+  val cfgFtFo = new RoundCfg(WumingFmt.ftExp, WumingFmt.ftSig + 2,
+    WumingFmt.foExp, WumingFmt.foSig)
+
+  // ---- classify / sign injection ----------------------------------------
+  val classifyFt = WumingRecFN.classifyFN(WumingFmt.ftExp, WumingFmt.ftSig,
+    in(ftFnWidth - 1, 0))
+  val classifyFo = WumingRecFN.classifyFN(WumingFmt.foExp, WumingFmt.foSig,
+    in(foFnWidth - 1, 0))
+
+  val sgnHc = in(63, 0)
+  val sgnHd = in(127, 64)
+
+  // ---- conversions (m12-chipyard-012) ------------------------------------
+  // Mine = the production wrapper; hardfloat's `RecFNToIN` / `INToRecFN` /
+  // `RoundAnyRawFNToRecFN` next to it, with the same parameters.  The
+  // hardfloat results are normalised here so the comparison is bit-exact on
+  // both the value and the five flags: DADAO's `rf0[4:0]` order (bit0 NV ...
+  // bit4 NX) is the reverse of hardfloat's.  The `DADAO:` conversions match
+  // hardfloat value for value and flag for flag, `fo2ft` overflow included
+  // (IEEE 754-2019 §7.4 is both engines' rule since m12-chipyard-025).
+  val opKind = (io.op - 14.U)(3, 0)
+  val cvt = Module(new WumingFPConvert)
+  cvt.io.kind := opKind
+  cvt.io.mode := io.mode
+  cvt.io.in := in(63, 0)
+  cvt.io.signedOp := io.inHi(0)
+
+  val ftRec = WumingRecFN.recFNFromFN(WumingFmt.ftExp, WumingFmt.ftSig,
+    in(31, 0))
+  val foRec = WumingRecFN.recFNFromFN(WumingFmt.foExp, WumingFmt.foSig,
+    in(63, 0))
+
+  val hfF2iFt32 = Module(new hardfloat.RecFNToIN(
+    WumingFmt.ftExp, WumingFmt.ftSig, 32))
+  val hfF2iFt64 = Module(new hardfloat.RecFNToIN(
+    WumingFmt.ftExp, WumingFmt.ftSig, 64))
+  val hfF2iFo32 = Module(new hardfloat.RecFNToIN(
+    WumingFmt.foExp, WumingFmt.foSig, 32))
+  val hfF2iFo64 = Module(new hardfloat.RecFNToIN(
+    WumingFmt.foExp, WumingFmt.foSig, 64))
+  hfF2iFt32.io.in := ftRec
+  hfF2iFt64.io.in := ftRec
+  hfF2iFo32.io.in := foRec
+  hfF2iFo64.io.in := foRec
+  for (u <- Seq(hfF2iFt32, hfF2iFt64, hfF2iFo32, hfF2iFo64)) {
+    u.io.roundingMode := io.mode
+    u.io.signedOut := io.inHi(0)
+  }
+
+  val hfI2f32Ft = Module(new hardfloat.INToRecFN(32, WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfI2f64Ft = Module(new hardfloat.INToRecFN(64, WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfI2f32Fo = Module(new hardfloat.INToRecFN(32, WumingFmt.foExp, WumingFmt.foSig))
+  val hfI2f64Fo = Module(new hardfloat.INToRecFN(64, WumingFmt.foExp, WumingFmt.foSig))
+  for (u <- Seq(hfI2f32Ft, hfI2f64Ft, hfI2f32Fo, hfI2f64Fo)) {
+    u.io.signedIn := io.inHi(0)
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  }
+  hfI2f32Ft.io.in := in(31, 0)
+  hfI2f64Ft.io.in := in(63, 0)
+  hfI2f32Fo.io.in := in(31, 0)
+  hfI2f64Fo.io.in := in(63, 0)
+
+  val hfFt2fo = Module(new hardfloat.RoundAnyRawFNToRecFN(
+    WumingFmt.ftExp, WumingFmt.ftSig, WumingFmt.foExp, WumingFmt.foSig, 0))
+  val hfFo2ft = Module(new hardfloat.RoundAnyRawFNToRecFN(
+    WumingFmt.foExp, WumingFmt.foSig, WumingFmt.ftExp, WumingFmt.ftSig, 0))
+  val hfFtRaw = WumingRecFN.rawFloatFromFN(WumingFmt.ftExp, WumingFmt.ftSig, in(31, 0))
+  val hfFoRaw = WumingRecFN.rawFloatFromFN(WumingFmt.foExp, WumingFmt.foSig, in(63, 0))
+  def driveHf(u: hardfloat.RoundAnyRawFNToRecFN, raw: WumingRawFloat): Unit = {
+    u.io.in.isNaN := raw.isNaN
+    u.io.in.isInf := raw.isInf
+    u.io.in.isZero := raw.isZero
+    u.io.in.sign := raw.sign
+    u.io.in.sExp := raw.sExp
+    u.io.in.sig := raw.sig
+    u.io.invalidExc := raw.isSigNaN
+    u.io.infiniteExc := false.B
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  }
+  driveHf(hfFt2fo, hfFtRaw)
+  driveHf(hfFo2ft, hfFoRaw)
+  // hardfloat's own `RoundAnyRawFNToRecFN` result is the reference as-is
+  // (spec/SimRISC-07 §1.4 = IEEE 754-2019 §7.4); no post-processing.
+  val hfFo2ftOut = WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+    hfFo2ft.io.out).pad(64)
+
+  // The `DZ` lane: the m12-011 bench tied the primitive's `infiniteExc` to 0,
+  // so this is the first time the divide-by-zero input is compared at all.
+  val dzRounder = Module(new WumingRoundAnyRawFNToRecFN(
+    WumingFmt.ftExp, WumingFmt.ftSig, WumingFmt.ftExp, WumingFmt.ftSig))
+  val dzHf = Module(new hardfloat.RoundAnyRawFNToRecFN(
+    WumingFmt.ftExp, WumingFmt.ftSig, WumingFmt.ftExp, WumingFmt.ftSig, 0))
+  val dzRaw = WumingRecFN.rawFloatFromFN(WumingFmt.ftExp, WumingFmt.ftSig, in(31, 0))
+  dzRounder.io.in := dzRaw
+  dzRounder.io.invalidExc := false.B
+  dzRounder.io.infiniteExc := true.B
+  dzRounder.io.roundingMode := io.mode
+  dzHf.io.in.isNaN := dzRaw.isNaN
+  dzHf.io.in.isInf := dzRaw.isInf
+  dzHf.io.in.isZero := dzRaw.isZero
+  dzHf.io.in.sign := dzRaw.sign
+  dzHf.io.in.sExp := dzRaw.sExp
+  dzHf.io.in.sig := dzRaw.sig
+  dzHf.io.invalidExc := false.B
+  dzHf.io.infiniteExc := true.B
+  dzHf.io.roundingMode := io.mode
+  dzHf.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  def rev5(x: UInt): UInt = Cat(x(0), x(1), x(2), x(3), x(4))  /** hardfloat's float->integer result at the 64-bit `rd` width (DADAO signs
+    * or zero-extends the 32-bit forms).
+    */
+  def hfF2iValue(u: UInt, signed: Bool): UInt =
+    Mux(signed, u.asSInt.pad(64).asUInt, u.pad(64))
+
+  // ---- arithmetic family (m12-chipyard-013) ------------------------------
+  // Mine = `WumingFPArith` (the production unit); the hardfloat counterpart of
+  // the same operation sits next to it, so every result is an RTL/RTL
+  // comparison.  `min`/`max` have no hardfloat module and are checked against
+  // the exact oracle only.
+  val arith = Module(new WumingFPArith)
+  arith.io.a := in(63, 0)
+  arith.io.b := in(127, 64)
+  arith.io.c := io.inExtra
+  arith.io.mode := io.mode
+
+  val OP_ADD_FT = 25.U
+  val OP_SUB_FT = 26.U
+  val OP_MUL_FT = 27.U
+  val OP_FMA_FT = 28.U
+  val OP_ADD_FO = 29.U
+  val OP_SUB_FO = 30.U
+  val OP_MUL_FO = 31.U
+  val OP_FMA_FO = 32.U
+  val OP_QCMP_FT = 33.U
+  val OP_SCMP_FT = 34.U
+  val OP_QCMP_FO = 35.U
+  val OP_SCMP_FO = 36.U
+  val OP_MIN_FT = 37.U
+  val OP_MAX_FT = 38.U
+  val OP_MIN_FO = 39.U
+  val OP_MAX_FO = 40.U
+
+  val arithKind = MuxLookup(io.op, WumingFPArithOp.ADD)(Seq(
+    OP_ADD_FT -> WumingFPArithOp.ADD, OP_SUB_FT -> WumingFPArithOp.SUB,
+    OP_MUL_FT -> WumingFPArithOp.MUL, OP_FMA_FT -> WumingFPArithOp.FMA,
+    OP_ADD_FO -> WumingFPArithOp.ADD, OP_SUB_FO -> WumingFPArithOp.SUB,
+    OP_MUL_FO -> WumingFPArithOp.MUL, OP_FMA_FO -> WumingFPArithOp.FMA,
+    OP_QCMP_FT -> WumingFPArithOp.QCMP, OP_SCMP_FT -> WumingFPArithOp.SCMP,
+    OP_QCMP_FO -> WumingFPArithOp.QCMP, OP_SCMP_FO -> WumingFPArithOp.SCMP,
+    OP_MIN_FT -> WumingFPArithOp.MIN, OP_MAX_FT -> WumingFPArithOp.MAX,
+    OP_MIN_FO -> WumingFPArithOp.MIN, OP_MAX_FO -> WumingFPArithOp.MAX))
+  val arithFo = (io.op === OP_ADD_FO) || (io.op === OP_SUB_FO) ||
+    (io.op === OP_MUL_FO) || (io.op === OP_FMA_FO) ||
+    (io.op === OP_QCMP_FO) || (io.op === OP_SCMP_FO) ||
+    (io.op === OP_MIN_FO) || (io.op === OP_MAX_FO)
+  arith.io.kind := arithKind
+  arith.io.isFo := arithFo
+
+  // hardfloat counterparts, one per (operation, format).
+  val hfAddFt = Module(new hardfloat.AddRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfAddFo = Module(new hardfloat.AddRecFN(WumingFmt.foExp, WumingFmt.foSig))
+  val hfSubFt = Module(new hardfloat.AddRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfSubFo = Module(new hardfloat.AddRecFN(WumingFmt.foExp, WumingFmt.foSig))
+  val hfMulFt = Module(new hardfloat.MulRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfMulFo = Module(new hardfloat.MulRecFN(WumingFmt.foExp, WumingFmt.foSig))
+  val hfFmaFt = Module(new hardfloat.MulAddRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfFmaFo = Module(new hardfloat.MulAddRecFN(WumingFmt.foExp, WumingFmt.foSig))
+
+  def driveHfArith(
+      u: hardfloat.AddRecFN, ew: Int, sw: Int, sub: Boolean): Unit = {
+    u.io.a := WumingRecFN.recFNFromFN(ew, sw, in(ew + sw - 1, 0))
+    u.io.b := WumingRecFN.recFNFromFN(ew, sw, in(127, 64)(ew + sw - 1, 0))
+    u.io.subOp := sub.B
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  }
+  driveHfArith(hfAddFt, WumingFmt.ftExp, WumingFmt.ftSig, sub = false)
+  driveHfArith(hfAddFo, WumingFmt.foExp, WumingFmt.foSig, sub = false)
+  driveHfArith(hfSubFt, WumingFmt.ftExp, WumingFmt.ftSig, sub = true)
+  driveHfArith(hfSubFo, WumingFmt.foExp, WumingFmt.foSig, sub = true)
+  for ((u, ew, sw) <- Seq((hfMulFt, WumingFmt.ftExp, WumingFmt.ftSig),
+                            (hfMulFo, WumingFmt.foExp, WumingFmt.foSig))) {
+    u.io.a := WumingRecFN.recFNFromFN(ew, sw, in(ew + sw - 1, 0))
+    u.io.b := WumingRecFN.recFNFromFN(ew, sw, in(127, 64)(ew + sw - 1, 0))
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  }
+  for ((u, ew, sw) <- Seq((hfFmaFt, WumingFmt.ftExp, WumingFmt.ftSig),
+                            (hfFmaFo, WumingFmt.foExp, WumingFmt.foSig))) {
+    u.io.op := 0.U
+    u.io.a := WumingRecFN.recFNFromFN(ew, sw, in(ew + sw - 1, 0))
+    u.io.b := WumingRecFN.recFNFromFN(ew, sw, in(127, 64)(ew + sw - 1, 0))
+    u.io.c := WumingRecFN.recFNFromFN(ew, sw, io.inExtra(ew + sw - 1, 0))
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  }
+
+  // hardfloat's quiet compare raises NV for a signalling NaN input, and its
+  // signalling compare for any unordered pair (IEEE 754-2019 §5.6.1 / §5.11) --
+  // exactly the spec/SimRISC-07 §4 contract (m12-chipyard-024), so every
+  // compare form compares flags against its own hardfloat instance.
+  val hfCmpFtQ = Module(new hardfloat.CompareRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfCmpFtS = Module(new hardfloat.CompareRecFN(WumingFmt.ftExp, WumingFmt.ftSig))
+  val hfCmpFoQ = Module(new hardfloat.CompareRecFN(WumingFmt.foExp, WumingFmt.foSig))
+  val hfCmpFoS = Module(new hardfloat.CompareRecFN(WumingFmt.foExp, WumingFmt.foSig))
+  for ((u, ew, sw, signaling) <- Seq(
+      (hfCmpFtQ, WumingFmt.ftExp, WumingFmt.ftSig, false),
+      (hfCmpFtS, WumingFmt.ftExp, WumingFmt.ftSig, true),
+      (hfCmpFoQ, WumingFmt.foExp, WumingFmt.foSig, false),
+      (hfCmpFoS, WumingFmt.foExp, WumingFmt.foSig, true))) {
+    u.io.a := WumingRecFN.recFNFromFN(ew, sw, in(ew + sw - 1, 0))
+    u.io.b := WumingRecFN.recFNFromFN(ew, sw, in(127, 64)(ew + sw - 1, 0))
+    u.io.signaling := signaling.B
+  }
+
+  // Value of a hardfloat comparison: 1 / 0 / -1, or the NaN constant the
+  // DADAO compare returns for an unordered pair.
+  def hfCmpValue(q: hardfloat.CompareRecFN, s: hardfloat.CompareRecFN,
+      ew: Int, sw: Int): UInt = {
+    val unordered = !(q.io.lt || q.io.eq || q.io.gt)
+    val expOnes = ((BigInt(1) << ew) - 1) << (sw - 1)
+    val nanBits = Mux(q.io.signaling, (expOnes | 1).U((ew + sw).W),
+      (expOnes | (BigInt(1) << (sw - 2))).U((ew + sw).W))
+    val cmp = Mux(q.io.lt, "hffff_ffff_ffff_ffff".U,
+      Mux(q.io.gt, 1.U, 0.U))
+    Mux(unordered, nanBits.pad(64), cmp.pad(64))
+  }
+
+  val out = WireDefault(0.U(128.W))
+  val flags = WireDefault(0.U(5.W))
+  val hfOut = WireDefault(0.U(128.W))
+  val hfFlags = WireDefault(0.U(5.W))
+
+  // ---- divide / root / remainder (m12-chipyard-014) ----------------------
+  // Mine = `WumingFpSlow` (the production unit); the hardfloat twin
+  // `DivSqrtRecFN_small` sits next to it for the two operations it implements
+  // (division and square root; the IEEE remainder has no hardfloat module and
+  // is checked against the exact oracle only).
+  val OP_DIV_FT = 41.U
+  val OP_DIV_FO = 42.U
+  val OP_SQRT_FT = 43.U
+  val OP_SQRT_FO = 44.U
+  val OP_REM_FT = 45.U
+  val OP_REM_FO = 46.U
+  val slowKind = MuxLookup(io.op, WumingFpSlowKind.DIV)(Seq(
+    OP_DIV_FT -> WumingFpSlowKind.DIV, OP_DIV_FO -> WumingFpSlowKind.DIV,
+    OP_SQRT_FT -> WumingFpSlowKind.SQRT, OP_SQRT_FO -> WumingFpSlowKind.SQRT,
+    OP_REM_FT -> WumingFpSlowKind.REM, OP_REM_FO -> WumingFpSlowKind.REM))
+  val slowFo = (io.op === OP_DIV_FO) || (io.op === OP_SQRT_FO) ||
+    (io.op === OP_REM_FO)
+  val slow = Module(new WumingFpSlow)
+  slow.io.kind := slowKind
+  slow.io.isFo := slowFo
+  slow.io.mode := io.mode
+  slow.io.a := in(63, 0)
+  slow.io.b := in(127, 64)
+  slow.io.start := io.slowStart
+  io.slowDone := slow.io.done
+  io.slowBusy := slow.io.busy
+
+  val hfDivFt = Module(new hardfloat.DivSqrtRecFN_small(
+    WumingFmt.ftExp, WumingFmt.ftSig, 0))
+  val hfDivFo = Module(new hardfloat.DivSqrtRecFN_small(
+    WumingFmt.foExp, WumingFmt.foSig, 0))
+  for ((u, ew, sw) <- Seq((hfDivFt, WumingFmt.ftExp, WumingFmt.ftSig),
+                            (hfDivFo, WumingFmt.foExp, WumingFmt.foSig))) {
+    u.io.inValid := io.slowStart && (slowKind =/= WumingFpSlowKind.REM)
+    u.io.a := WumingRecFN.recFNFromFN(ew, sw, in(ew + sw - 1, 0))
+    u.io.b := WumingRecFN.recFNFromFN(ew, sw, in(127, 64)(ew + sw - 1, 0))
+    u.io.roundingMode := io.mode
+    u.io.detectTininess := hardfloat.consts.tininess_afterRounding
+    u.io.sqrtOp := slowKind === WumingFpSlowKind.SQRT
+  }
+  val hfSlowValue = Mux(slowFo,
+    WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+      hfDivFo.io.out).pad(64),
+    WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+      hfDivFt.io.out).pad(64))
+  val hfSlowFlags = Mux(slowFo,
+    rev5(hfDivFo.io.exceptionFlags), rev5(hfDivFt.io.exceptionFlags))
+  io.hfValid := Mux(slowFo,
+    hfDivFo.io.outValid_div || hfDivFo.io.outValid_sqrt,
+    hfDivFt.io.outValid_div || hfDivFt.io.outValid_sqrt)
+
+  switch(io.op) {
+    is(0.U) { out := WumingRecFN.recFNFromFN(WumingFmt.ftExp, WumingFmt.ftSig,
+      in(ftFnWidth - 1, 0)).pad(128) }
+    is(1.U) { out := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+      in(ftRecWidth - 1, 0)).pad(128) }
+    is(2.U) { out := WumingRecFN.recFNFromFN(WumingFmt.foExp, WumingFmt.foSig,
+      in(foFnWidth - 1, 0)).pad(128) }
+    is(3.U) { out := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+      in(foRecWidth - 1, 0)).pad(128) }
+    is(4.U) { out := cfgFtFt.out.pad(128); flags := cfgFtFt.flags
+              hfOut := cfgFtFt.hfO.pad(128); hfFlags := cfgFtFt.hfF }
+    is(5.U) { out := cfgFoFo.out.pad(128); flags := cfgFoFo.flags
+              hfOut := cfgFoFo.hfO.pad(128); hfFlags := cfgFoFo.hfF }
+    is(6.U) { out := cfgFoFt.out.pad(128); flags := cfgFoFt.flags
+              hfOut := cfgFoFt.hfO.pad(128); hfFlags := cfgFoFt.hfF }
+    is(7.U) { out := cfgFtFo.out.pad(128); flags := cfgFtFo.flags
+              hfOut := cfgFtFo.hfO.pad(128); hfFlags := cfgFtFo.hfF }
+    is(8.U) { out := classifyFt.pad(128) }
+    is(9.U) { out := classifyFo.pad(128) }
+    is(10.U) { out := WumingRecFN.signInject(sgnHc, sgnHd, 31, false).pad(128) }
+    is(11.U) { out := WumingRecFN.signInject(sgnHc, sgnHd, 31, true).pad(128) }
+    is(12.U) { out := WumingRecFN.signInject(sgnHc, sgnHd, 63, false).pad(128) }
+    is(13.U) { out := WumingRecFN.signInject(sgnHc, sgnHd, 63, true).pad(128) }
+    is(14.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := hfF2iValue(hfF2iFt32.io.out, io.inHi(0)).pad(128)
+      hfFlags := Cat(hfF2iFt32.io.intExceptionFlags(0), false.B, false.B,
+        false.B, hfF2iFt32.io.intExceptionFlags(2) ||
+          hfF2iFt32.io.intExceptionFlags(1))
+    }
+    is(15.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := hfF2iValue(hfF2iFt64.io.out, io.inHi(0)).pad(128)
+      hfFlags := Cat(hfF2iFt64.io.intExceptionFlags(0), false.B, false.B,
+        false.B, hfF2iFt64.io.intExceptionFlags(2) ||
+          hfF2iFt64.io.intExceptionFlags(1))
+    }
+    is(16.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := hfF2iValue(hfF2iFo32.io.out, io.inHi(0)).pad(128)
+      hfFlags := Cat(hfF2iFo32.io.intExceptionFlags(0), false.B, false.B,
+        false.B, hfF2iFo32.io.intExceptionFlags(2) ||
+          hfF2iFo32.io.intExceptionFlags(1))
+    }
+    is(17.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := hfF2iValue(hfF2iFo64.io.out, io.inHi(0)).pad(128)
+      hfFlags := Cat(hfF2iFo64.io.intExceptionFlags(0), false.B, false.B,
+        false.B, hfF2iFo64.io.intExceptionFlags(2) ||
+          hfF2iFo64.io.intExceptionFlags(1))
+    }
+    is(18.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfI2f32Ft.io.out).pad(128)
+      hfFlags := rev5(hfI2f32Ft.io.exceptionFlags)
+    }
+    is(19.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfI2f64Ft.io.out).pad(128)
+      hfFlags := rev5(hfI2f64Ft.io.exceptionFlags)
+    }
+    is(20.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfI2f32Fo.io.out).pad(128)
+      hfFlags := rev5(hfI2f32Fo.io.exceptionFlags)
+    }
+    is(21.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfI2f64Fo.io.out).pad(128)
+      hfFlags := rev5(hfI2f64Fo.io.exceptionFlags)
+    }
+    is(22.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfFt2fo.io.out).pad(128)
+      hfFlags := rev5(hfFt2fo.io.exceptionFlags)
+    }
+    is(23.U) {
+      out := cvt.io.out.pad(128); flags := cvt.io.flags
+      hfOut := hfFo2ftOut.pad(128); hfFlags := rev5(hfFo2ft.io.exceptionFlags)
+    }
+    is(24.U) {
+      out := dzRounder.io.out.pad(128); flags := dzRounder.io.exceptionFlags
+      hfOut := dzHf.io.out.pad(128); hfFlags := rev5(dzHf.io.exceptionFlags)
+    }
+    // ---- arithmetic family (m12-chipyard-013) ----------------------------
+    is(OP_ADD_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfAddFt.io.out).pad(128)
+      hfFlags := rev5(hfAddFt.io.exceptionFlags)
+    }
+    is(OP_SUB_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      // `ftsub` uses the same hardfloat adder with `subOp`; a second instance
+      // keeps the bench a pure wiring layer.
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfSubFt.io.out).pad(128)
+      hfFlags := rev5(hfSubFt.io.exceptionFlags)
+    }
+    is(OP_MUL_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfMulFt.io.out).pad(128)
+      hfFlags := rev5(hfMulFt.io.exceptionFlags)
+    }
+    is(OP_FMA_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.ftExp, WumingFmt.ftSig,
+        hfFmaFt.io.out).pad(128)
+      hfFlags := rev5(hfFmaFt.io.exceptionFlags)
+    }
+    is(OP_ADD_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfAddFo.io.out).pad(128)
+      hfFlags := rev5(hfAddFo.io.exceptionFlags)
+    }
+    is(OP_SUB_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfSubFo.io.out).pad(128)
+      hfFlags := rev5(hfSubFo.io.exceptionFlags)
+    }
+    is(OP_MUL_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfMulFo.io.out).pad(128)
+      hfFlags := rev5(hfMulFo.io.exceptionFlags)
+    }
+    is(OP_FMA_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := WumingRecFN.fNFromRecFN(WumingFmt.foExp, WumingFmt.foSig,
+        hfFmaFo.io.out).pad(128)
+      hfFlags := rev5(hfFmaFo.io.exceptionFlags)
+    }
+    is(OP_QCMP_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := hfCmpValue(hfCmpFtQ, hfCmpFtS, WumingFmt.ftExp, WumingFmt.ftSig).pad(128)
+      hfFlags := Cat(false.B, false.B, false.B, false.B,
+        hfCmpFtQ.io.exceptionFlags(4))
+    }
+    is(OP_SCMP_FT) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := hfCmpValue(hfCmpFtS, hfCmpFtS, WumingFmt.ftExp, WumingFmt.ftSig).pad(128)
+      hfFlags := Cat(false.B, false.B, false.B, false.B,
+        hfCmpFtS.io.exceptionFlags(4))
+    }
+    is(OP_QCMP_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := hfCmpValue(hfCmpFoQ, hfCmpFoS, WumingFmt.foExp, WumingFmt.foSig).pad(128)
+      hfFlags := Cat(false.B, false.B, false.B, false.B,
+        hfCmpFoQ.io.exceptionFlags(4))
+    }
+    is(OP_SCMP_FO) {
+      out := arith.io.out.pad(128); flags := arith.io.flags
+      hfOut := hfCmpValue(hfCmpFoS, hfCmpFoS, WumingFmt.foExp, WumingFmt.foSig).pad(128)
+      hfFlags := Cat(false.B, false.B, false.B, false.B,
+        hfCmpFoS.io.exceptionFlags(4))
+    }
+    is(OP_MIN_FT) { out := arith.io.out.pad(128); flags := arith.io.flags }
+    is(OP_MAX_FT) { out := arith.io.out.pad(128); flags := arith.io.flags }
+    is(OP_MIN_FO) { out := arith.io.out.pad(128); flags := arith.io.flags }
+    is(OP_MAX_FO) { out := arith.io.out.pad(128); flags := arith.io.flags }
+    // ---- divide / root / remainder (m12-chipyard-014) --------------------
+    is(OP_DIV_FT) { out := slow.io.out.pad(128); flags := slow.io.flags
+                    hfOut := hfSlowValue.pad(128); hfFlags := hfSlowFlags }
+    is(OP_DIV_FO) { out := slow.io.out.pad(128); flags := slow.io.flags
+                    hfOut := hfSlowValue.pad(128); hfFlags := hfSlowFlags }
+    is(OP_SQRT_FT) { out := slow.io.out.pad(128); flags := slow.io.flags
+                     hfOut := hfSlowValue.pad(128); hfFlags := hfSlowFlags }
+    is(OP_SQRT_FO) { out := slow.io.out.pad(128); flags := slow.io.flags
+                     hfOut := hfSlowValue.pad(128); hfFlags := hfSlowFlags }
+    // The remainder has no hardfloat module; the oracle decides.
+    is(OP_REM_FT) { out := slow.io.out.pad(128); flags := slow.io.flags }
+    is(OP_REM_FO) { out := slow.io.out.pad(128); flags := slow.io.flags }
+  }
+  io.outLo := out(63, 0)
+  io.outHi := out(127, 64)
+  io.flags := flags
+  io.hfOutLo := hfOut(63, 0)
+  io.hfOutHi := hfOut(127, 64)
+  io.hfFlags := hfFlags
+
+  val fcsr = Module(new WumingFcsr)
+  fcsr.io.writeEn := io.fcsrWrEn
+  fcsr.io.writeData := io.fcsrWrData
+  fcsr.io.fflags := io.fcsrFflags
+  io.fcsrRead := fcsr.io.read
+}
+
+/** Emits the bench as a standalone SystemVerilog model. */
+object WumingFPUnitEmit extends App {
+  val outDir = if (args.nonEmpty) args(0) else "."
+  _root_.circt.stage.ChiselStage.emitSystemVerilog(
+    new WumingFPUnitHarness,
+    Array(),
+    Array("-o", s"$outDir/WumingFPUnitHarness.sv"))
+}
