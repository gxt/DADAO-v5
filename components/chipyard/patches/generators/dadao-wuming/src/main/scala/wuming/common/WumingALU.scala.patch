index 0000000..117f8de
--- /dev/null
+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingALU.scala
@@ -0,0 +1,258 @@
+// See LICENSE for license details.
+//
+// DADAO integer ALU (m12-chipyard-005, extended by m12-chipyard-010).
+//
+// Combinational, one operation per instruction.  Semantics are taken from
+// spec/SimRISC-04 (64-bit data operations), spec/SimRISC-05 (64-bit address
+// operations), spec/SimRISC-08/09/10 (32/16/8-bit data operations) and
+// spec/SimRISC-12 §3 (bit scan / bit count); nothing is borrowed from RISC-V:
+//
+//   * arithmetic on the `rrrr` dual-destination forms produces a full 128-bit
+//     result: `hi` is the carry/borrow (unsigned variants) or the high 64 bits
+//     (signed variants); `lo` is the low 64 bits.
+//   * narrow (byte/wyde/tetra) results are written with the value semantics of
+//     the manual: zero/sign extension of the narrow result to all 64 bits.
+//   * div/rem use the spec's fixed values for divide-by-zero and for the
+//     signed INT_MIN / -1 overflow, and truncate toward zero.  The signed
+//     overflow constant is the width's INT_MIN sign-extended to 64 bits, which
+//     is exactly the SimRISC-04 table for every width.
+//   * shift/rotate amounts are the low `log2(width)` bits of `shamt`; `ext`
+//     takes the start bit in `shamt`.
+//   * `rev` reverses the unit order inside every block (spec/SimRISC-04
+//     §2.2.1); `ctpop`/`ctlz`/`cttz` operate on `source[hd:0]` where `hd` is
+//     the immediate (spec/SimRISC-12 §3); `clmul` is the GF(2) 128-bit
+//     product (spec/SimRISC-04 §1.5).
+//
+// `opWidth` is a code, not a byte count: 0 = byte (8), 1 = wyde (16),
+// 2 = tetra (32), 3 = octa (64).
+//
+// `ctpop`/`ctlz`/`cttz` and `rev` are width-agnostic by construction (no
+// `.b`/`.w`/`.t`/`.o` suffix on the mnemonic), so they ignore `opWidth`.
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+
+object WumingAluOp {
+  val ADD_U   = 0.U(6.W)
+  val ADD_S   = 1.U(6.W)
+  val SUB_U   = 2.U(6.W)
+  val SUB_S   = 3.U(6.W)
+  val ADD128_U = 4.U(6.W)
+  val ADD128_S = 5.U(6.W)
+  val SUB128_U = 6.U(6.W)
+  val SUB128_S = 7.U(6.W)
+  val MUL128_U = 8.U(6.W)
+  val MUL128_S = 9.U(6.W)
+  val MUL_U    = 10.U(6.W)
+  val MUL_S    = 11.U(6.W)
+  val DIV_U    = 12.U(6.W)
+  val DIV_S    = 13.U(6.W)
+  val REM_U    = 14.U(6.W)
+  val REM_S    = 15.U(6.W)
+  val AND      = 16.U(6.W)
+  val OR       = 17.U(6.W)
+  val XOR      = 18.U(6.W)
+  val XNOR     = 19.U(6.W)
+  val SHL      = 20.U(6.W)
+  val SHR_U    = 21.U(6.W)
+  val SHR_S    = 22.U(6.W)
+  val ROL      = 23.U(6.W)
+  val EXT_U    = 24.U(6.W)
+  val EXT_S    = 25.U(6.W)
+  val CMP_U    = 26.U(6.W)
+  val CMP_S    = 27.U(6.W)
+  val SET_ZW   = 28.U(6.W)
+  val SET_OW   = 29.U(6.W)
+  val OR_W     = 30.U(6.W)
+  val ANDN_W   = 31.U(6.W)
+  // m12-chipyard-010
+  val REV      = 32.U(6.W)
+  val CTPOP    = 33.U(6.W)
+  val CTLZ     = 34.U(6.W)
+  val CTTZ     = 35.U(6.W)
+  val CLMUL128 = 36.U(6.W)
+}
+
+class WumingALU extends Module {
+  val io = IO(new Bundle {
+    val op    = Input(UInt(6.W))
+    val opWidth = Input(UInt(2.W)) // 0 = byte, 1 = wyde, 2 = tetra, 3 = octa
+    val a     = Input(UInt(64.W))
+    val b     = Input(UInt(64.W))
+    val shamt = Input(UInt(6.W))
+    val wp    = Input(UInt(2.W))
+    val lo    = Output(UInt(64.W))
+    val hi    = Output(UInt(64.W))
+  })
+
+  // ---- width handling ---------------------------------------------------
+  // Only the low `8 << opWidth` bits of a narrow operand take part; the result
+  // is written to all 64 bits with the manual's zero/sign extension.
+  val widthMask = MuxLookup(io.opWidth, "hffffffffffffffff".U(64.W))(Seq(
+    0.U -> "h00000000000000ff".U(64.W),
+    1.U -> "h000000000000ffff".U(64.W),
+    2.U -> "h00000000ffffffff".U(64.W)))
+
+  def signOf(x: UInt): Bool = MuxLookup(io.opWidth, x(63))(Seq(
+    0.U -> x(7), 1.U -> x(15), 2.U -> x(31)))
+
+  def extVal(x: UInt, signed: Bool): UInt =
+    (x & widthMask) | Mux(signed && signOf(x), ~widthMask, 0.U(64.W))
+
+  val aU = io.a & widthMask
+  val bU = io.b & widthMask
+  val aS = extVal(io.a, true.B)
+  val bS = extVal(io.b, true.B)
+  val allOnes = "hffffffffffffffff".U(64.W)
+
+  // ---- 128-bit add/sub (rrrr) ------------------------------------------
+  val a128u = Cat(0.U(64.W), io.a)
+  val b128u = Cat(0.U(64.W), io.b)
+  val a128s = io.a.asSInt.pad(128)
+  val b128s = io.b.asSInt.pad(128)
+  val addU  = (a128u + b128u)(127, 0)
+  val subU  = (a128u - b128u)(127, 0)
+  val addS  = (a128s + b128s)(127, 0).asUInt
+  val subS  = (a128s - b128s)(127, 0).asUInt
+
+  // ---- 128-bit multiply (rrrr) -----------------------------------------
+  val mulU128 = (io.a * io.b)(127, 0)
+  val mulS128 = (io.a.asSInt * io.b.asSInt)(127, 0).asUInt
+
+  // ---- carry-less multiply (clmul.o) -----------------------------------
+  // sum over i of (b[i] ? a << i : 0) with XOR between the terms: bit i of b
+  // contributes a shifted copy, and "no carry" means the contributions are
+  // combined with XOR (spec/SimRISC-04 §1.5).
+  val clmul = (0 until 64).map { i =>
+    Mux(io.b(i), (io.a.pad(128) << i)(127, 0), 0.U(128.W))
+  }.reduce(_ ^ _)
+
+  // ---- narrow multiply --------------------------------------------------
+  val mulU = extVal((aU * bU)(63, 0), false.B)
+  val mulS = extVal((aS * bS)(63, 0).asUInt, true.B)
+
+  // ---- divide / remainder ----------------------------------------------
+  // The per-width fixed values of spec/SimRISC-04 §1.4: unsigned divide by
+  // zero returns the width mask, signed divide by zero all ones, the signed
+  // overflow returns the width's INT_MIN sign-extended, and rem returns the
+  // (extended) dividend on divide by zero and 0 on overflow.
+  val widthBits = MuxLookup(io.opWidth, 64.U(7.W))(Seq(
+    0.U -> 8.U(7.W), 1.U -> 16.U(7.W), 2.U -> 32.U(7.W)))
+  val minVal = extVal((1.U(64.W) << (widthBits - 1.U))(63, 0), true.B)
+  val sOvf = (aS === minVal) && (bS === allOnes)
+
+  val divU = Mux(bU === 0.U, widthMask, (aU / bU)(63, 0))
+  val divS = Mux(bS === 0.U, allOnes,
+    Mux(sOvf, minVal, extVal((aS.asSInt / bS.asSInt)(63, 0).asUInt, true.B)))
+  val remU = Mux(bU === 0.U, extVal(aU, false.B),
+    extVal((aU % bU)(63, 0), false.B))
+  val remS = Mux(bS === 0.U, extVal(aS, true.B),
+    Mux(sOvf, 0.U, extVal((aS.asSInt % bS.asSInt)(63, 0).asUInt, true.B)))
+
+  // ---- shifts / rotates -------------------------------------------------
+  val shMask = (widthBits - 1.U)(5, 0)
+  val sh     = io.shamt & shMask
+  val rotR   = (widthBits - sh)(5, 0)
+
+  // ---- ext --------------------------------------------------------------
+  val hd   = io.shamt
+  val mask = (~0.U(64.W)) >> (63.U - hd)
+
+  // ---- compare ----------------------------------------------------------
+  val ltU = aU < bU
+  val ltS = aS.asSInt < bS.asSInt
+  val eq  = aU === bU
+  def cmpRes(lt: Bool): UInt =
+    Mux(lt, allOnes, Mux(eq, 0.U, 1.U))
+
+  // ---- rev (block-wise unit reversal) -----------------------------------
+  // Every block of S = 8 << opWidth bits is cut into S/k units and the unit
+  // order inside the block is reversed; the unit's own bit order is kept.
+  // The block positions themselves are not swapped (so `rev.t k=8` is a pure
+  // bswap32, spec/SimRISC-08 §2.1).
+  def revBlock(x: UInt, s: Int, k: Int): UInt = {
+    val units = s / k
+    Cat((0 until (64 / s)).reverse.flatMap { b =>
+      (0 until units).map { u => x(b * s + u * k + k - 1, b * s + u * k) }
+    })
+  }
+  def revFor(s: Int, units: Seq[Int]): UInt =
+    MuxLookup(io.shamt, io.a)(units.map(k => k.U -> revBlock(io.a, s, k)))
+  val revRaw =
+    MuxLookup(io.opWidth, revFor(8, Seq(1, 2, 4)))(Seq(
+      3.U -> revFor(64, Seq(1, 2, 4, 8, 16, 32)),
+      2.U -> revFor(32, Seq(1, 2, 4, 8, 16)),
+      1.U -> revFor(16, Seq(1, 2, 4, 8))))
+
+  // ---- ctlz / cttz / ctpop (spec/SimRISC-12 §3) --------------------------
+  // The valid range is `source[hd:0]`; a zero range yields hd + 1 for the two
+  // scan instructions (defined, not undefined) and 0 for popcount.
+  val nHd     = io.shamt +& 1.U // 1..64
+  val hdBound = ((~0.U(64.W)) >> (64.U - nHd))(63, 0)
+  val hdValid = io.a & hdBound
+  val popc    = PopCount(hdValid)
+  val revBits = Cat((0 until 64).map(i => hdValid(i))) // bit 63 = source bit 0
+  val hiIdx   = 63.U - PriorityEncoder(revBits)        // highest set bit
+  val loIdx   = PriorityEncoder(hdValid)               // lowest set bit
+  val ctlzRes = Mux(hdValid === 0.U, nHd.pad(64), (io.shamt - hiIdx).pad(64))
+  val cttzRes = Mux(hdValid === 0.U, nHd.pad(64), loIdx.pad(64))
+
+  // ---- 16-bit immediate (rwii) -----------------------------------------
+  val wydeShift = io.wp << 4
+  val immWyde   = (io.b << wydeShift)(63, 0)
+  val wydeMask  = ("hffff".U(64.W) << wydeShift)(63, 0)
+
+  val lo = WireDefault(0.U(64.W))
+  val hi = WireDefault(0.U(64.W))
+
+  switch(io.op) {
+    is(WumingAluOp.ADD_U) { lo := extVal((aU + bU)(63, 0), false.B) }
+    is(WumingAluOp.ADD_S) { lo := extVal((aS + bS)(63, 0), true.B) }
+    is(WumingAluOp.SUB_U) { lo := extVal((aU - bU)(63, 0), false.B) }
+    is(WumingAluOp.SUB_S) { lo := extVal((aS - bS)(63, 0), true.B) }
+    is(WumingAluOp.ADD128_U) { hi := addU(127, 64); lo := addU(63, 0) }
+    is(WumingAluOp.ADD128_S) { hi := addS(127, 64); lo := addS(63, 0) }
+    // ZX subtract: rdHA is the borrow itself (0 or 1), not the high half of
+    // the 128-bit wrap (spec/SimRISC-04 §1.1).
+    is(WumingAluOp.SUB128_U) { hi := Mux(io.a < io.b, 1.U(64.W), 0.U(64.W)); lo := subU(63, 0) }
+    is(WumingAluOp.SUB128_S) { hi := subS(127, 64); lo := subS(63, 0) }
+    is(WumingAluOp.MUL128_U) { hi := mulU128(127, 64); lo := mulU128(63, 0) }
+    is(WumingAluOp.MUL128_S) { hi := mulS128(127, 64); lo := mulS128(63, 0) }
+    is(WumingAluOp.CLMUL128) { hi := clmul(127, 64); lo := clmul(63, 0) }
+    is(WumingAluOp.MUL_U) { lo := mulU }
+    is(WumingAluOp.MUL_S) { lo := mulS }
+    is(WumingAluOp.DIV_U) { lo := divU }
+    is(WumingAluOp.DIV_S) { lo := divS }
+    is(WumingAluOp.REM_U) { lo := remU }
+    is(WumingAluOp.REM_S) { lo := remS }
+    is(WumingAluOp.AND)   { lo := io.a & io.b }
+    is(WumingAluOp.OR)    { lo := io.a | io.b }
+    is(WumingAluOp.XOR)   { lo := io.a ^ io.b }
+    is(WumingAluOp.XNOR)  { lo := ~(io.a ^ io.b) }
+    is(WumingAluOp.SHL)   { lo := extVal((aU << sh)(63, 0), false.B) }
+    is(WumingAluOp.SHR_U) { lo := extVal((aU >> sh)(63, 0), false.B) }
+    is(WumingAluOp.SHR_S) { lo := extVal((aS.asSInt >> sh)(63, 0).asUInt, true.B) }
+    is(WumingAluOp.ROL) {
+      val r = (aU << sh)(63, 0) | (aU >> rotR)(63, 0)
+      lo := extVal(r, false.B)
+    }
+    is(WumingAluOp.EXT_U) { lo := io.a & mask }
+    is(WumingAluOp.EXT_S) {
+      lo := (io.a & mask) | Mux(io.a(hd), ~mask, 0.U(64.W))
+    }
+    is(WumingAluOp.CMP_U) { lo := cmpRes(ltU) }
+    is(WumingAluOp.CMP_S) { lo := cmpRes(ltS) }
+    is(WumingAluOp.REV)   { lo := revRaw }
+    is(WumingAluOp.CTPOP) { lo := popc.pad(64) }
+    is(WumingAluOp.CTLZ)  { lo := ctlzRes }
+    is(WumingAluOp.CTTZ)  { lo := cttzRes }
+    is(WumingAluOp.SET_ZW)  { lo := immWyde }
+    is(WumingAluOp.SET_OW)  { lo := (~wydeMask) | immWyde }
+    is(WumingAluOp.OR_W)    { lo := io.a | immWyde }
+    is(WumingAluOp.ANDN_W)  { lo := io.a & ~immWyde }
+  }
+  io.lo := lo
+  io.hi := hi
+}
