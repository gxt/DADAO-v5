diff --git a/generators/dadao-wuming/src/main/scala/wuming/common/WumingPtw.scala b/generators/dadao-wuming/src/main/scala/wuming/common/WumingPtw.scala
new file mode 100644
index 0000000..e1ced03
--- /dev/null
+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingPtw.scala
@@ -0,0 +1,592 @@
+// See LICENSE for license details.
+//
+// DADAO "wuming" page-table walker + first-level TLB (m16-chipyard-007/008).
+//
+// The walk is the two-level DADAO table of `DADAO-12` §2.2.1/§2.2.2:
+//
+//   L1 index  VA[41:29]  (8192 entries x 8 B = 64 KiB table, 512 MiB coverage)
+//   L2 index  VA[28:16]  (8192 entries x 8 B = 64 KiB table, 64 KiB coverage)
+//   offset    VA[28:0]   (superpage, 512 MiB) / VA[15:0] (normal page, 64 KiB)
+//
+// A leaf L1 entry with `SP = 1` is a 512 MiB superpage and ends the walk; the
+// `SPF` bit selected by `VA[28:26]` says whether that 64 MiB fragment is in
+// memory (§2.2.3).  A normal page is reached through the L2 table; its `GPF`
+// bit selected by `VA[15:13]` covers an 8 KiB fragment (§2.2.4).  PTEs are
+// **big endian** (§2.2.1) and every page-table access uses a physical address.
+//
+// Sub-cause selection follows `DADAO-12` §2.2.6 in spec order (missing page →
+// missing fragment → HSJU → R/W/X); the bit numbers come from
+// `gewu.GewuCauseId` (the single copy of the table, `ADR-0056`), never from
+// literals here.
+//
+// A/D is *local* (`DADAO-12` §2.2.5, `contract-tlb` TLB-13…TLB-16): a fill
+// copies the PTE's A/D into the local copy and clears the pending bits; an
+// access that finds A (or, for a store, D) clear sets the local bit **and** the
+// pending bit; a pending bit reaches memory only as an atomic OR on
+// clean/flush/replacement.  The OR is a read-modify-write of the PTE, so the I
+// and D tables can each hold pending bits for the same PTE without either
+// update clearing the other.  A write-back the bus refuses is
+// `CFXMEM [56] ADWBFAIL` with `cause_info` = the PTE physical address, and the
+// entry (with its pending bits) is kept — never silently dropped.
+//
+// `m16-chipyard-008` adds the first-level TLB: two `WumingTlb` instances (one
+// per access side, in-core and per hart, `contract-tlb` TLB-01/TLB-38).  A hit
+// answers from the cached leaf and never re-reads the PTE (TLB-07); a miss
+// walks and fills the side's table (normal pages 2x8, superpages 4, LRU).  The
+// TLB class has no D state on the instruction side.
+//
+// The walker reaches memory through the D-cache's page-table port: the core is
+// parked in `sXlate` while a translation (or a `cfx_ptw_tlb_control` command)
+// runs, and the cache holds one copy of every physical line, so a PTE write the
+// core made through the data path is immediately visible to the walk (and the
+// walk's A/D write-back is immediately visible to the core).
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+import gewu.GewuCauseId
+
+/** Page-table walker parameters, all taken from the machine address map. */
+case class WumingPtwParams(
+  /** Physical memory window a page table may live in (§2.2.1: PTBR, table
+    * pages and mapping targets must be in physical memory). */
+  paRamBase: BigInt,
+  paRamSize: BigInt,
+  /** Read-only BootROM window: a page table may be *read* there, so a
+    * clean/flush write-back to it fails as `CFXMEM [56] ADWBFAIL`
+    * (`DADAO-12` §4.5, `contract-tlb` TLB-16). */
+  romBase: BigInt,
+  romSize: BigInt,
+  /** First-level TLB geometry (user ruling 2026-11-19). */
+  tlbSets: Int = 2,
+  tlbWays: Int = 8,
+  tlbSuperEntries: Int = 4
+)
+
+/** One translation request from the core's address path. */
+class WumingPtwRequest extends Bundle {
+  /** Access address (`VA[41:0]` valid; `addr[47:42] = 0` — the core has
+    * already routed the memory window here, `contract-tlb` TLB-42). */
+  val va = UInt(64.W)
+  val isFetch = Bool()
+  val isWrite = Bool()
+}
+
+/** The walk's answer: either a physical address or a page-table fault. */
+class WumingPtwResponse extends Bundle {
+  /** `PA` formed from the leaf PTE page base and the access's page offset
+    * (§2.2.1/§2.2.2 step 4).  Only meaningful when `fault = 0`. */
+  val pa = UInt(64.W)
+  val fault = Bool()
+  /** `true` = `CFXPERM` (wyde2), `false` = `CFXMEM` (wyde3). */
+  val perm = Bool()
+  /** Wyde-local one-hot sub-cause (`GewuCauseId` index). */
+  val sub = UInt(GewuCauseId.WYDE_BITS.W)
+  /** `excp_cause_info`: the access address, or the PTE physical address for
+    * `ADWBFAIL` (`contract-tlb` TLB-33). */
+  val info = UInt(64.W)
+}
+
+/** One `cfx_ptw_tlb_control` command, already encoding-checked by the core. */
+class WumingPtwCommand extends Bundle {
+  val op = UInt(2.W)      // 1 = clean, 2 = invalid, 3 = flush (`none` never sent)
+  val scope = UInt(2.W)   // 0 = all, 1 = VA, 2 = range
+  val asidAny = Bool()
+  val start = UInt(42.W)
+  val size = UInt(64.W)
+}
+
+class WumingPtw(ptwParams: WumingPtwParams) extends Module {
+
+  val io = IO(new Bundle {
+    /** Page-table reads and A/D read-modify-writes go through the D-cache
+      * (`m16-chipyard-009`); the cache answers in address-ordered beats, so
+      * the walker never sees the bus byte order. */
+    val mem = new Bundle {
+      val req = Decoupled(new WumingCacheRequest)
+      val resp = Flipped(Valid(new WumingCacheResponse))
+    }
+    /** `inner_run_mode` selects the HSJU bit (§2.2.5). */
+    val runMode = Input(UInt(2.W))
+    /** `cfx_ptw_ptbr`: the stored `PPN[55:16]` (§4.5). */
+    val ptbr = Input(UInt(40.W))
+    /** `cfx_ptw_tlb_asid` (§4.5). */
+    val asid = Input(UInt(16.W))
+    val req = Input(Valid(new WumingPtwRequest))
+    val resp = Output(Valid(new WumingPtwResponse))
+    val cmd = Input(Valid(new WumingPtwCommand))
+    val cmdDone = Output(Valid(new Bundle {
+      val fault = Bool()
+      val info = UInt(64.W)
+    }))
+  })
+
+  private val p = ptwParams
+  private val tlbParams = WumingTlbParams(
+    sets = p.tlbSets, ways = p.tlbWays, superEntries = p.tlbSuperEntries)
+  private val tlbEntries = tlbParams.totalEntries
+  private val tlbIdxBits = math.max(1, tlbParams.idxBits)
+
+  // ---- physical windows a page table may live in -------------------------
+  private def inWindow(x: UInt, base: BigInt, size: BigInt): Bool =
+    x >= base.U(64.W) && x < (base + size).U(64.W)
+  private def inPtwMemory(pa: UInt): Bool =
+    inWindow(pa, p.paRamBase, p.paRamSize) || inWindow(pa, p.romBase, p.romSize)
+
+  // ---- the two first-level tables (in-core, per hart: TLB-01/TLB-38) -----
+  private val tlbI = Module(new WumingTlb(tlbParams.copy(instruction = true)))
+  private val tlbD = Module(new WumingTlb(tlbParams.copy(instruction = false)))
+  private val tl = Seq(tlbI, tlbD)
+  for (t <- tl) {
+    t.io.runMode := io.runMode
+    t.io.asid := io.asid
+    t.io.look.valid := false.B
+    t.io.look.bits.va := 0.U
+    t.io.look.bits.isWrite := false.B
+    t.io.touch.valid := false.B
+    t.io.touch.bits.idx := 0.U
+    t.io.touch.bits.isWrite := false.B
+    t.io.fillQuery.valid := false.B
+    t.io.fillQuery.bits.va := 0.U
+    t.io.fillQuery.bits.superpage := false.B
+    t.io.fillCommit.valid := false.B
+    t.io.fillCommit.bits := 0.U.asTypeOf(new WumingTlbFill)
+    t.io.cmdProbe.valid := false.B
+    t.io.cmdProbe.bits := 0.U.asTypeOf(new WumingTlbCmdProbe)
+    t.io.cmdClear.valid := false.B
+    t.io.cmdClear.bits := 0.U.asTypeOf(new WumingTlbCmdClear)
+    t.io.cmdKill.valid := false.B
+    t.io.cmdKill.bits := 0.U
+  }
+
+  // ---- walk / command FSM -----------------------------------------------
+  private val sIdle :: sHit :: sL1Req :: sL1Wait :: sLeafL1 :: sL2Req :: sL2Wait :: sLeafL2 :: sEvGet :: sEvGetWait :: sEvPut :: sEvPutWait :: sCmdScan :: sCmdGet :: sCmdGetWait :: sCmdPut :: sCmdPutWait :: sCmdDone :: Nil = Enum(18)
+  private val state = RegInit(sIdle)
+  // Simulation-time stamp for the A/D evidence (the core's own counter is not
+  // visible here; the host only needs the event order and its association with
+  // the PTE address).
+  private val dbgCycles = RegInit(0.U(64.W))
+  dbgCycles := dbgCycles + 1.U
+
+  // request context
+  private val reqVa = RegInit(0.U(64.W))
+  private val reqFetch = RegInit(false.B)
+  private val reqWrite = RegInit(false.B)
+
+  // leaf context
+  private val leafPte = RegInit(0.U(64.W))
+  private val leafPtePa = RegInit(0.U(64.W))
+  private val leafSuperReg = RegInit(false.B)
+  private val l2PaReg = RegInit(0.U(64.W))
+
+  // response registers (single-cycle valid, emitted from `sIdle`'s predecessor)
+  private val respValid = RegInit(false.B)
+  private val respPa = RegInit(0.U(64.W))
+  private val respFault = RegInit(false.B)
+  private val respPerm = RegInit(false.B)
+  private val respSub = RegInit(0.U(GewuCauseId.WYDE_BITS.W))
+  private val respInfo = RegInit(0.U(64.W))
+  io.resp.valid := respValid
+  io.resp.bits.pa := respPa
+  io.resp.bits.fault := respFault
+  io.resp.bits.perm := respPerm
+  io.resp.bits.sub := respSub
+  io.resp.bits.info := respInfo
+
+  // A/D write-back context (shared by the eviction and command paths; the
+  // bus sequence is identical, only the completion differs).
+  private val wbPa = RegInit(0.U(64.W))
+  private val wbCur = RegInit(0.U(64.W))
+  private val wbAPend = RegInit(false.B)
+  private val wbDPend = RegInit(false.B)
+  private val evIdx = RegInit(0.U(tlbIdxBits.W))
+  private val evVaTag = RegInit(0.U(42.W))
+  private val evPte = RegInit(0.U(64.W))
+
+  // command context
+  private val cmdOp = RegInit(0.U(2.W))
+  private val cmdScope = RegInit(0.U(2.W))
+  private val cmdAsidAny = RegInit(false.B)
+  private val cmdStart = RegInit(0.U(42.W))
+  private val cmdSize = RegInit(0.U(64.W))
+  private val cmdSide = RegInit(0.U(1.W))
+  private val cmdIdx = RegInit(0.U(tlbIdxBits.W))
+  private val cmdDoneValid = RegInit(false.B)
+  private val cmdDoneFault = RegInit(false.B)
+  private val cmdDoneInfo = RegInit(0.U(64.W))
+  io.cmdDone.valid := cmdDoneValid
+  io.cmdDone.bits.fault := cmdDoneFault
+  io.cmdDone.bits.info := cmdDoneInfo
+
+  // ---- cache-port access of one 8-byte beat ------------------------------
+  // The request is driven *combinationally* from the requesting state (which
+  // is held until `req.ready`), so it is never retracted and never carries a
+  // stale address: a register latched in the same cycle would put the
+  // previous request's address on the port for one beat.
+  private val l1PaNow = Cat(io.ptbr, 0.U(16.W)) +
+    Cat(0.U(53.W), reqVa(41, 29), 0.U(3.W))
+  private val drivingGet = state === sL1Req || state === sL2Req ||
+    state === sEvGet || state === sCmdGet
+  private val drivingPut = state === sEvPut || state === sCmdPut
+  private val drivingA = drivingGet || drivingPut
+  private val aPa = Mux(state === sL1Req, l1PaNow,
+    Mux(state === sL2Req, l2PaReg,
+      Mux(drivingA, wbPa, 0.U)))
+  private val putValue = WumingTlbRules.orValue(wbCur, wbAPend, wbDPend)
+  io.mem.req.valid := drivingA
+  io.mem.req.bits.addr := aPa
+  io.mem.req.bits.write := drivingPut
+  io.mem.req.bits.wdata := putValue
+  io.mem.req.bits.wmask := "hff".U(8.W)
+  // Address of the request actually accepted, for the PTE's own PA (the
+  // `ADWBFAIL` `cause_info` and the self-consistent A/D base).
+  private val sentPa = RegInit(0.U(64.W))
+  when(io.mem.req.fire) { sentPa := aPa }
+  private val tlFire = io.mem.resp.valid
+  private val tlFail = tlFire && io.mem.resp.bits.error
+
+  // ---- leaf helpers ------------------------------------------------------
+  private def respond(pa: UInt, fault: Bool, perm: Bool, sub: UInt, info: UInt): Unit = {
+    respValid := true.B
+    respPa := pa
+    respFault := fault
+    respPerm := perm
+    respSub := sub
+    respInfo := info
+    state := sIdle
+  }
+
+  // ---- fill plumbing -----------------------------------------------------
+  private val fillValid = WireDefault(false.B)
+  private val fillToI = WireDefault(false.B)
+  private val fillBits = WireDefault(0.U.asTypeOf(new WumingTlbFill))
+  tlbI.io.fillCommit.valid := fillValid && fillToI
+  tlbI.io.fillCommit.bits := fillBits
+  tlbD.io.fillCommit.valid := fillValid && !fillToI
+  tlbD.io.fillCommit.bits := fillBits
+  when(fillValid) {
+    printf(p"WumingPtw: tlb-fill side=${Mux(fillToI, 0.U, 1.U)} super=${fillBits.superpage} idx=${fillBits.idx} va=0x${Hexadecimal(WumingTlbRules.pageTag(fillBits.superpage, fillBits.va))} pte=0x${Hexadecimal(fillBits.pte)} aPend=${fillBits.aPend} dPend=${fillBits.dPend}\n")
+  }
+  private def commitFill(idx: UInt, va: UInt, superpage: Bool, pte: UInt, ptePa: UInt,
+                         aPend: Bool, dPend: Bool): Unit = {
+    fillValid := true.B
+    fillToI := reqFetch
+    fillBits.idx := idx
+    fillBits.superpage := superpage
+    fillBits.va := va
+    fillBits.pte := pte
+    fillBits.ptePa := ptePa
+    fillBits.asid := io.asid
+    fillBits.aPend := aPend
+    fillBits.dPend := dPend
+  }
+
+  // ---- leaf decision (shared by the L1-superpage and L2 paths) -----------
+  /**
+    * Check the leaf in spec order and either answer or start the fill.
+    *
+    * The access that triggers the fill also updates A/D (`§2.2.5`: "该规则对
+    * 「命中」与「本次访问触发填充」同样适用"), so `aPend/dPend` are the
+    * pending bits produced by *this* access.
+    */
+  private def decideLeaf(pte: UInt, superpage: Bool): Unit = {
+    val sup = superpage
+    val v = reqVa
+    val fragOk = pte(WumingTlbRules.fragBit(sup, v))
+    val hsjuOk = (pte >> (60.U + io.runMode))(0)
+    val rwxOk = Mux(reqFetch, pte(5), Mux(reqWrite, pte(6), pte(7)))
+    val hsjuSub = GewuCauseId.PERM_NUPERM.U + io.runMode
+    val rwxSub = Mux(reqFetch, GewuCauseId.PERM_NXPERM.U,
+      Mux(reqWrite, GewuCauseId.PERM_NWPERM.U, GewuCauseId.PERM_NRPERM.U))
+    val aPend = !pte(3)
+    val dPend = reqWrite && !reqFetch && !pte(2)
+    val vic = Mux(reqFetch, tlbI.io.victim, tlbD.io.victim)
+
+    when(!fragOk) {
+      respond(0.U, true.B, false.B, WumingTlbRules.missFragSub(reqFetch, sup), v)
+    }.elsewhen(!hsjuOk) {
+      respond(0.U, true.B, true.B, hsjuSub, v)
+    }.elsewhen(!rwxOk) {
+      respond(0.U, true.B, true.B, rwxSub, v)
+    }.elsewhen(!vic.valid || !vic.dirty) {
+      // Clean (or invalid) victim: install the leaf directly.
+      commitFill(vic.idx, v, sup, pte, leafPtePa, aPend, dPend)
+      respond(WumingTlbRules.pageBaseOf(pte, sup) | WumingTlbRules.pageOffset(sup, v),
+        false.B, false.B, 0.U, v)
+    }.otherwise {
+      // Replacement writes the old entry's A/D back first (§2.2.5,
+      // `contract-tlb` TLB-12/TLB-15).
+      wbPa := vic.ptePa
+      wbAPend := vic.aPend
+      wbDPend := vic.dPend
+      evIdx := vic.idx
+      evVaTag := vic.vaTag
+      evPte := vic.pte
+      leafSuperReg := sup
+      state := sEvGet
+    }
+  }
+
+  // ---- command matching --------------------------------------------------
+  private def cmdAdvance(): Unit = {
+    when(cmdIdx + 1.U === tlbEntries.U) {
+      when(cmdSide === 0.U) {
+        cmdSide := 1.U
+        cmdIdx := 0.U
+        state := sCmdScan
+      }.otherwise { state := sCmdDone }
+    }.otherwise {
+      cmdIdx := cmdIdx + 1.U
+      state := sCmdScan
+    }
+  }
+
+  private def killCurrent(): Unit = {
+    when(cmdSide === 0.U) {
+      tlbI.io.cmdKill.valid := true.B
+      tlbI.io.cmdKill.bits := cmdIdx
+    }.otherwise {
+      tlbD.io.cmdKill.valid := true.B
+      tlbD.io.cmdKill.bits := cmdIdx
+    }
+    printf(p"WumingPtw: tlb-kill side=${cmdSide} idx=${cmdIdx} op=${cmdOp}\n")
+  }
+
+  // ---- main FSM ----------------------------------------------------------
+  when(state === sIdle) {
+    respValid := false.B
+    cmdDoneValid := false.B
+    when(io.req.valid) {
+      // The core is parked while a translation runs, so a request always
+      // arrives with the walker idle.
+      reqVa := io.req.bits.va
+      reqFetch := io.req.bits.isFetch
+      reqWrite := io.req.bits.isWrite
+      state := sHit
+    }.elsewhen(io.cmd.valid) {
+      cmdOp := io.cmd.bits.op
+      cmdScope := io.cmd.bits.scope
+      cmdAsidAny := io.cmd.bits.asidAny
+      cmdStart := io.cmd.bits.start
+      cmdSize := io.cmd.bits.size
+      cmdSide := 0.U
+      cmdIdx := 0.U
+      cmdDoneFault := false.B
+      cmdDoneInfo := 0.U
+      state := sCmdScan
+    }
+  }
+
+  // ---- TLB lookup on the access's side ----------------------------------
+  tlbI.io.look.valid := state === sHit && reqFetch
+  tlbI.io.look.bits.va := reqVa
+  tlbI.io.look.bits.isWrite := false.B
+  tlbD.io.look.valid := state === sHit && !reqFetch
+  tlbD.io.look.bits.va := reqVa
+  tlbD.io.look.bits.isWrite := reqWrite
+  private val hit = Mux(reqFetch, tlbI.io.hit, tlbD.io.hit)
+  private val touchValid = state === sHit && hit.hit && !hit.fault
+  tlbI.io.touch.valid := touchValid && reqFetch
+  tlbI.io.touch.bits.idx := tlbI.io.hit.idx
+  tlbI.io.touch.bits.isWrite := false.B
+  tlbD.io.touch.valid := touchValid && !reqFetch
+  tlbD.io.touch.bits.idx := tlbD.io.hit.idx
+  tlbD.io.touch.bits.isWrite := reqWrite
+  when(state === sHit) {
+    when(!hit.hit) {
+      // Miss: walk (TLB-08).
+      state := sL1Req
+    }.elsewhen(hit.fault) {
+      respond(0.U, true.B, hit.perm, hit.sub, reqVa)
+    }.otherwise {
+      // Hit: the cached leaf answers, no PTE is read (TLB-07).
+      respond(hit.pa, false.B, false.B, 0.U, reqVa)
+    }
+  }
+
+  // L1: `PTBR` holds `PPN[55:16]`; the entry address is `PTBR + VA[41:29]*8`.
+  when(state === sL1Req) {
+    when(!inPtwMemory(l1PaNow)) {
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_NONPTW.U, reqVa)
+    }.otherwise {
+      // The read is on the A channel (combinationally) until it is accepted.
+      when(io.mem.req.ready) { state := sL1Wait }
+    }
+  }
+  when(state === sL1Wait) {
+    when(tlFail) {
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_NONPTW.U, reqVa)
+    }.elsewhen(tlFire) {
+      leafPte := io.mem.resp.bits.data
+      leafPtePa := sentPa
+      state := sLeafL1
+    }
+  }
+
+  when(state === sLeafL1) {
+    val pte = leafPte
+    when(!pte(0)) {
+      // `P = 0`: `SP = 1` is a missing superpage, `SP = 0` a missing page
+      // (`§2.2.1` step 3 / `§2.2.2` step 3).
+      respond(0.U, true.B, false.B, WumingTlbRules.missPageSub(reqFetch, pte(1)), reqVa)
+    }.elsewhen(pte(1)) {
+      // Superpage: the walk ends here, `SPF` decides the fragment.
+      decideLeaf(pte, true.B)
+    }.otherwise {
+      // L2 address = `PTE[55:16]` page + VA[28:16]*8 (§2.2.2 step 3).
+      l2PaReg := Cat(pte(55, 16), 0.U(16.W)) + Cat(0.U(53.W), reqVa(28, 16), 0.U(3.W))
+      state := sL2Req
+    }
+  }
+
+  when(state === sL2Req) {
+    when(!inPtwMemory(l2PaReg)) {
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_NONPTW.U, reqVa)
+    }.otherwise {
+      when(io.mem.req.ready) { state := sL2Wait }
+    }
+  }
+  when(state === sL2Wait) {
+    when(tlFail) {
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_NONPTW.U, reqVa)
+    }.elsewhen(tlFire) {
+      leafPte := io.mem.resp.bits.data
+      leafPtePa := sentPa
+      state := sLeafL2
+    }
+  }
+  when(state === sLeafL2) {
+    val pte = leafPte
+    when(!pte(0)) {
+      respond(0.U, true.B, false.B, WumingTlbRules.missPageSub(reqFetch, false.B), reqVa)
+    }.otherwise {
+      decideLeaf(pte, false.B)
+    }
+  }
+
+  // ---- victim fill query (combinational, while the leaf is being decided) ----
+  private val leafState = state === sLeafL1 || state === sLeafL2
+  private val fillSuper = state === sLeafL1 && leafPte(1)
+  tlbI.io.fillQuery.valid := leafState && reqFetch
+  tlbI.io.fillQuery.bits.va := reqVa
+  tlbI.io.fillQuery.bits.superpage := fillSuper
+  tlbD.io.fillQuery.valid := leafState && !reqFetch
+  tlbD.io.fillQuery.bits.va := reqVa
+  tlbD.io.fillQuery.bits.superpage := fillSuper
+
+  // ---- eviction write-back (read-modify-write OR, TLB-15) ----------------
+  when(state === sEvGet) {
+    printf(p"WumingPtw: tlb-evict side=${Mux(reqFetch, 0.U, 1.U)} super=${leafSuperReg} idx=${evIdx} va=0x${Hexadecimal(evVaTag)} pte=0x${Hexadecimal(evPte)}\n")
+    when(io.mem.req.ready) { state := sEvGetWait }
+  }
+  when(state === sEvGetWait) {
+    when(tlFail) {
+      // The write-back cannot even read the PTE: `CFXMEM [56] ADWBFAIL`,
+      // `cause_info` = the PTE physical address, victim kept (TLB-16).
+      printf(p"WumingPtw: ad-fail kind=replace pte=0x${Hexadecimal(wbPa)} cycle=${dbgCycles}\n")
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_ADWBFAIL.U, wbPa)
+    }.elsewhen(tlFire) {
+      wbCur := io.mem.resp.bits.data
+      state := sEvPut
+    }
+  }
+  when(state === sEvPut) {
+    printf(p"WumingPtw: ad-wb kind=replace pte=0x${Hexadecimal(wbPa)} value=0x${Hexadecimal(putValue)} cycle=${dbgCycles}\n")
+    when(io.mem.req.ready) { state := sEvPutWait }
+  }
+  when(state === sEvPutWait) {
+    when(tlFail) {
+      printf(p"WumingPtw: ad-fail kind=replace pte=0x${Hexadecimal(wbPa)} cycle=${dbgCycles}\n")
+      respond(0.U, true.B, false.B, GewuCauseId.MEM_ADWBFAIL.U, wbPa)
+    }.elsewhen(tlFire) {
+      // The victim's A/D are now in memory; install the leaf that was walked.
+      commitFill(evIdx, reqVa, leafSuperReg, leafPte, leafPtePa,
+        !leafPte(3), reqWrite && !reqFetch && !leafPte(2))
+      respond(WumingTlbRules.pageBaseOf(leafPte, leafSuperReg) |
+        WumingTlbRules.pageOffset(leafSuperReg, reqVa),
+        false.B, false.B, 0.U, reqVa)
+    }
+  }
+
+  // ---- commands (`cfx_ptw_tlb_control`, `contract-tlb` TLB-17/TLB-37) ----
+  //
+  // The spec's TLB has no I/D selector, so a command walks the instruction
+  // table and then the data table; `asidAny = 0` skips `G = 1` entries.  The
+  // scan is entry-granular and stops at the first write-back failure.
+  tlbI.io.cmdProbe.valid := state === sCmdScan && cmdSide === 0.U
+  tlbI.io.cmdProbe.bits.idx := cmdIdx
+  tlbI.io.cmdProbe.bits.op := cmdOp
+  tlbI.io.cmdProbe.bits.scope := cmdScope
+  tlbI.io.cmdProbe.bits.asidAny := cmdAsidAny
+  tlbI.io.cmdProbe.bits.start := cmdStart
+  tlbI.io.cmdProbe.bits.size := cmdSize
+  tlbD.io.cmdProbe.valid := state === sCmdScan && cmdSide === 1.U
+  tlbD.io.cmdProbe.bits := tlbI.io.cmdProbe.bits
+  private val cmdRes = Mux(cmdSide === 0.U, tlbI.io.cmdResult, tlbD.io.cmdResult)
+
+  when(state === sCmdScan) {
+    when(cmdRes.match_ && cmdRes.dirty && cmdOp =/= 2.U) {
+      wbPa := cmdRes.ptePa
+      wbAPend := cmdRes.aPend
+      wbDPend := cmdRes.dPend
+      state := sCmdGet
+    }.elsewhen(cmdRes.match_ && cmdOp === 2.U) {
+      // `invalid` does not write back (`§4.5`).
+      killCurrent()
+      cmdAdvance()
+    }.otherwise {
+      // `clean` of a clean entry: nothing to do.  `flush` of a clean entry:
+      // delete it.  No match: skip.
+      when(cmdRes.match_ && cmdOp === 3.U) { killCurrent() }
+      cmdAdvance()
+    }
+  }
+  when(state === sCmdGet) {
+    when(io.mem.req.ready) { state := sCmdGetWait }
+  }
+  when(state === sCmdGetWait) {
+    when(tlFail) {
+      printf(p"WumingPtw: ad-fail kind=cmd pte=0x${Hexadecimal(wbPa)} cycle=${dbgCycles}\n")
+      cmdDoneFault := true.B
+      cmdDoneInfo := wbPa
+      state := sCmdDone
+    }.elsewhen(tlFire) {
+      wbCur := io.mem.resp.bits.data
+      state := sCmdPut
+    }
+  }
+  when(state === sCmdPut) {
+    printf(p"WumingPtw: ad-wb kind=cmd op=${cmdOp} pte=0x${Hexadecimal(wbPa)} value=0x${Hexadecimal(putValue)} cycle=${dbgCycles}\n")
+    when(io.mem.req.ready) { state := sCmdPutWait }
+  }
+  when(state === sCmdPutWait) {
+    when(tlFail) {
+      // Entry-level, stop at the first failure: keep the entry untouched and
+      // report once (`contract-tlb` TLB-37).
+      printf(p"WumingPtw: ad-fail kind=cmd pte=0x${Hexadecimal(wbPa)} cycle=${dbgCycles}\n")
+      cmdDoneFault := true.B
+      cmdDoneInfo := wbPa
+      state := sCmdDone
+    }.elsewhen(tlFire) {
+      val clear = WireDefault(0.U.asTypeOf(new WumingTlbCmdClear))
+      clear.idx := cmdIdx
+      clear.pte := putValue
+      when(cmdOp === 1.U) {
+        when(cmdSide === 0.U) {
+          tlbI.io.cmdClear.valid := true.B
+          tlbI.io.cmdClear.bits := clear
+        }.otherwise {
+          tlbD.io.cmdClear.valid := true.B
+          tlbD.io.cmdClear.bits := clear
+        }
+      }
+      when(cmdOp === 3.U) { killCurrent() }
+      cmdAdvance()
+    }
+  }
+  when(state === sCmdDone) {
+    cmdDoneValid := true.B
+    state := sIdle
+  }
+}
