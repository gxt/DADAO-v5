+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingTile.scala
@@ -0,0 +1,178 @@
+// See LICENSE for license details.
+//
+// DADAO "wuming" tile skeleton (m12-chipyard-001).
+//
+// Shell option B (user, 2026-11-08): `WumingTile extends BaseTile` only to
+// borrow the wiring abstractions (hartid / reset vector / interrupt /
+// TileLink ports), while `WumingCoreParams` stays free of RISC-V fields.
+// The core inside is the integer execution core (`WumingCore`, m12-005).
+
+package wuming.common
+
+import chisel3._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.diplomacy._
+import freechips.rocketchip.interrupts._
+import freechips.rocketchip.prci.ClockCrossingType
+import freechips.rocketchip.subsystem._
+import freechips.rocketchip.tile._
+import freechips.rocketchip.tilelink._
+
+class WumingTile(
+  val wumingTileParams: WumingTileParams,
+  crossing: ClockCrossingType,
+  lookup: LookupByHartIdImpl,
+  q: Parameters
+) extends BaseTile(wumingTileParams, crossing, lookup, q)
+    with SourcesExternalNotifications {
+
+  // Private constructor ensures the altered LazyModule.p is used implicitly.
+  def this(
+    params: WumingTileParams,
+    crossing: HierarchicalElementCrossingParamsLike,
+    lookup: LookupByHartIdImpl
+  )(implicit p: Parameters) =
+    this(params, crossing.crossingType, lookup, p)
+
+  // ---- ports required by BaseTile --------------------------------------
+  // Interrupts into the tile (debug, msip, mtip; seip only with supervisor
+  // mode, which this core does not have).  Nothing inside consumes them yet:
+  // the tile-internal xbar (BaseHierarchicalElement) aggregates every source
+  // and the sink terminates the bundle -- no RISC-V interrupt controller.
+  val intInwardNode = intXbar.intnode :=* IntNameNode("wuming_int_local")
+  private val intSinkNode = IntSinkNode(IntSinkPortSimple())
+  intSinkNode := intXbar.intnode
+
+  /** No interrupt sources inside the tile (no BEU / no PLIC sources yet). */
+  val intOutwardNode: Option[IntOutwardNode] = None
+
+  // ---- the core's two TileLink master ports (m12-018) -------------------
+  // Declared here instead of inherited from a Rocket core: this is the one
+  // concrete instance of what "borrow the wiring only" means.  Fetch and data
+  // are separate client nodes (user ruling 2026-11-10: "取指和访存应该用两个
+  // tilelink，在 m12 中就拆"), so a data access can never block fetch
+  // progress.  Source IDs are client-local and the port xbar remaps them, so the
+  // two ranges do not collide.  The core uses source 0 for the demand fetch and
+  // 1..4 for the four prefetch slots on the fetch port (m12-020 widened the
+  // range from `IdRange(0, 3)`), and source 0 on the data port (see
+  // `WumingCore`).
+  val fetchMasterNode: TLClientNode = TLClientNode(Seq(TLMasterPortParameters.v1(Seq(
+    TLMasterParameters.v1(
+      name = s"WumingCoreFetch ${tileId}",
+      sourceId = IdRange(0, 5),
+      requestFifo = true)))))
+  val dataMasterNode: TLClientNode = TLClientNode(Seq(TLMasterPortParameters.v1(Seq(
+    TLMasterParameters.v1(
+      name = s"WumingCoreData ${tileId}",
+      sourceId = IdRange(0, 3),
+      requestFifo = true)))))
+
+  // ---- the +loadmem= boot loader (m12-003) ------------------------------
+  // It shares the tile's TileLink master port with the core: a tile-local TLXbar
+  // merges the two clients, so the loader's writes and readback run over the
+  // same bus path the core uses.  The core is only released once the loader has
+  // written and byte-verified the SRAM image (`bootEnable`).  Base and size come
+  // from the machine address map (no default) — see `WumingLoadMem`.
+  private val loadMemBase = wumingTileParams.wumingParams.loadMemBase.getOrElse(
+    throw new IllegalArgumentException(
+      "WumingTile: loadMemBase must be configured from the machine address map"))
+  private val loadMemSize = wumingTileParams.wumingParams.loadMemSize.getOrElse(
+    throw new IllegalArgumentException(
+      "WumingTile: loadMemSize must be configured from the machine address map"))
+  // m12-007: the loader also enforces the Tiny application-load contract
+  // (`spec/Machine-v5 §6`): the fixed entry, and "no PT_LOAD into the BootROM
+  // or the hmon SRAM" (the former would overwrite the firmware, the latter
+  // would preset hmon).  Both windows and the entry come from the address map.
+  private def required[A](opt: Option[A], what: String): A = opt.getOrElse(
+    throw new IllegalArgumentException(
+      s"WumingTile: $what must be configured from the machine address map"))
+  private val loadMemEntry = required(wumingTileParams.wumingParams.loadMemEntry, "loadMemEntry")
+  private val hmonBase = required(wumingTileParams.wumingParams.hmonBase, "hmonBase")
+  private val hmonSize = required(wumingTileParams.wumingParams.hmonSize, "hmonSize")
+  private val bootromBase = required(wumingTileParams.wumingParams.bootromBase, "bootromBase")
+  private val bootromSize = required(wumingTileParams.wumingParams.bootromSize, "bootromSize")
+  val loadMem: WumingLoadMem = LazyModule(new WumingLoadMem(WumingLoadMemParams(
+    base = loadMemBase,
+    size = loadMemSize,
+    entry = loadMemEntry,
+    bootromBase = bootromBase,
+    bootromSize = bootromSize,
+    hmonBase = hmonBase,
+    hmonSize = hmonSize)))
+
+  // m12-004: the semihosting responder is a host model (DPI) that reads guest
+  // memory over its own TL client port.  It shares the tile's port xbar with
+  // the core and the loader; the core only sees request/response wires.
+  val semi: WumingSemi = LazyModule(new WumingSemi(
+    WumingSemiParams(loadMemBase, loadMemSize)))
+
+  private val portXbar = TLXbar()
+  portXbar := fetchMasterNode
+  portXbar := dataMasterNode
+  portXbar := loadMem.node
+  portXbar := semi.node
+
+  // Master path copied from rocket-chip's TraceGenTile (the canonical custom
+  // tile in this tree): clients -> xbar -> visibilityNode -> identity -> port.
+  val masterNode: TLOutwardNode = TLIdentityNode() := visibilityNode := portXbar
+
+  /** Slave port: the tile exposes no memory of its own.  Machine-v5-Tiny main
+    * memory (the 8 MiB SRAM) is a system-level TL slave on the memory bus, not
+    * a tile-local port (m12-002, `spec/Machine-v5 §1.1`). */
+  val slaveNode: TLInwardNode = TLIdentityNode()
+
+  override lazy val module = new WumingTileModuleImp(this)
+}
+
+class WumingTileModuleImp(outer: WumingTile) extends BaseTileModuleImp(outer) {
+  val (fetchTl, fetchEdge) = outer.fetchMasterNode.out(0)
+  val (dataTl, dataEdge) = outer.dataMasterNode.out(0)
+
+  val hartidBits = outer.hartIdSinkNode.bundle.getWidth
+  val resetVectorBits = outer.resetVectorSinkNode.bundle.getWidth
+  // BaseTile itself only mixes in HasNonDiplomaticTileParameters; the
+  // diplomatically-negotiated `paddrBits` lives in HasTileParameters, which is
+  // not part of the tile class.  Read the negotiated bundle directly.
+  val paddrBits = p(TileVisibilityNodeKey).edges.out.head.bundle.addressBits
+
+  // Elaboration-time record of the negotiated physical address width -- this
+  // is the value m12-002 needs when it lands the 48-bit Tiny address map.
+  println(
+    s"WumingTile: tileId=${outer.tileId} xLen=${outer.xLen} usingVM=${outer.usingVM} " +
+      s"maxPAddrBits=${outer.maxPAddrBits} paddrBits=$paddrBits " +
+      s"hartidBits=$hartidBits resetVectorBits=$resetVectorBits")
+
+  val core = Module(new WumingCore(
+    fetchEdge, dataEdge, outer.wumingTileParams.wumingParams, hartidBits, resetVectorBits))
+  val loadMem = outer.loadMem.module
+  val semi = outer.semi.module
+
+  // Client-side handshake: the core drives a/d on both ports, the tile wires
+  // are the bus side.  The two ports share no state, so a stalled data access
+  // leaves the fetch channel free to run.
+  fetchTl.a.valid := core.io.imem.a.valid
+  fetchTl.a.bits := core.io.imem.a.bits
+  core.io.imem.a.ready := fetchTl.a.ready
+  core.io.imem.d.valid := fetchTl.d.valid
+  core.io.imem.d.bits := fetchTl.d.bits
+  fetchTl.d.ready := core.io.imem.d.ready
+
+  dataTl.a.valid := core.io.dmem.a.valid
+  dataTl.a.bits := core.io.dmem.a.bits
+  core.io.dmem.a.ready := dataTl.a.ready
+  core.io.dmem.d.valid := dataTl.d.valid
+  core.io.dmem.d.bits := dataTl.d.bits
+  dataTl.d.ready := core.io.dmem.d.ready
+
+  // Semihosting boundary: request out of the core, scalar answer back in.
+  semi.semiReq := core.io.semi.req
+  core.io.semi.resp := semi.semiResp
+
+  core.io.hartid := outer.hartIdSinkNode.bundle
+  core.io.resetVector := outer.resetVectorSinkNode.bundle
+  core.io.bootEnable := loadMem.initDone
+
+  outer.reportHalt(None)
+  outer.reportWFI(None)
+  outer.reportCease(Some(core.io.halted))
+}
