@@ -0,0 +1,470 @@
+// See LICENSE for license details.
+//
+// DADAO "wuming" tile parameters (m12-chipyard-001).
+//
+// Boundary ruling (user, 2026-11-08, option A): the Rocket *core* and its
+// RISC-V semantics (CSR / misa / PMP / MMU / TLB / exception codes) are out of
+// scope; the rocket-chip *library* (Diplomacy / TileLink / BaseTile) and
+// chipyard's simulation infrastructure stay.  `WumingCoreParams` therefore
+// does NOT extend `CoreParams` and carries no RISC-V field.
+//
+// One legacy concession is unavoidable: `BaseTile`'s public constructor takes
+// `TileParams`, and `TileParams.core` is typed `CoreParams`.  The adapter
+// below (`WumingCompatCoreParams`) fills that socket with neutral values so
+// the tile can borrow BaseTile's wiring; the core never reads it and it is
+// never treated as an ISA description.
+
+package wuming.common
+
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.subsystem._
+import freechips.rocketchip.tile._
+import freechips.rocketchip.rocket.{ICacheParams, DCacheParams, BTBParams, MulDivParams}
+import freechips.rocketchip.prci.ClockSinkParameters
+import gewu.{GewuCacheParams, GewuCfxParams, GewuHartParams, GewuParams, GewuPmemParams, GewuPtwParams, GewuTimeParams}
+
+/** DADAO core parameters: no RISC-V semantics. */
+case class WumingCoreParams(
+  bootFreqHz: BigInt = BigInt(1000000000),
+  // With useVM = false, `BaseTile.maxPAddrBits` is exactly xLen, so a 64-bit
+  // core may express any physical address the TileLink address map negotiates.
+  xLen: Int = 64,
+  retireWidth: Int = 1,
+  nLocalInterrupts: Int = 0,
+  // m12-018: fetch queue depth in 8-byte beats (user ruling 2026-11-10:
+  // 8 beats = 64 B).  Kept parameterised so later milestones can trade area
+  // for prefetch reach without touching the core.
+  fetchDepth: Int = 8,
+  // m12-003: the harness `+loadmem=` loader validates every ELF PT_LOAD
+  // against the machine's writable memory window and streams it into the
+  // tile's TL master port.  Both values must be supplied by the SoC
+  // configuration from the machine address map (`WumingTinyAddressMap`); there
+  // is deliberately no default, so a wrong/absent base is an elaboration
+  // error instead of a silently mis-placed load (`spec/Kaiwu §1.1`).
+  loadMemBase: Option[BigInt] = None,
+  loadMemSize: Option[BigInt] = None,
+  // m12-007: the fixed application entry the power stub jumps to and the host
+  // loader requires (`spec/Kaiwu §6`), the hmon SRAM base that is the
+  // reset value of `cfx_hmon_hypv_excp_vector` (`DADAO-13 §1`) and the power
+  // stub's copy target (`§6.2`), plus the BootROM window the host loader must
+  // never write.  All come from the machine address map; there is no default,
+  // so an absent value is an elaboration error instead of a silently wrong
+  // handoff.
+  loadMemEntry: Option[BigInt] = None,
+  hmonBase: Option[BigInt] = None,
+  hmonSize: Option[BigInt] = None,
+  // m16-chipyard-019: the smon SRAM base/size — reset of `cfx_smon`'s
+  // `hypv_excp_vector` and the anchor of its cg7 block 0 (`DADAO-12 §2.1`,
+  // `contract-see §3`).  Vast-only; Tiny has no smon and leaves these None.
+  smonBase: Option[BigInt] = None,
+  smonSize: Option[BigInt] = None,
+  bootromBase: Option[BigInt] = None,
+  bootromSize: Option[BigInt] = None,
+  // m16-chipyard-006: does the memory window (`addr[47:42] = 0`) translate?
+  //
+  //   * `false` (`Kaiwu-Tiny`): no `cfx_ptw` on the machine, so the window is
+  //     simply not backed and every access there is plain `CFXMEM`;
+  //   * `true` (`Kaiwu-Vast`): the window's fate is `cfx_ptw_enable`
+  //     (`DADAO-12` §2.2, `contract-tlb` §10 TLB-40…TLB-43) — 0 bypasses the
+  //     TLB and faults, 1 enters the walker.
+  //
+  // It is also what makes this machine implement `cfx_ptw`'s register face
+  // (cfx4) instead of reporting CFXREG for those rows.
+  //
+  // This is *our* field with the DADAO meaning.  The same-named rocket-chip
+  // field in `WumingCompatCoreParams` is a RISC-V-MMU wiring flag and stays
+  // `false` on both profiles (see the note there).
+  useVM: Boolean = false,
+  // m16-chipyard-007: the physical memory window the page tables live in
+  // (`spec/Kaiwu §1.1` PA RAM, `DADAO-12 §2.2.1`: PTBR, table pages and the
+  // mapping targets must be in physical memory).  Required on a translating
+  // machine: an absent window is an elaboration error, not a walk that reads
+  // nowhere.
+  paRamBase: Option[BigInt] = None,
+  paRamSize: Option[BigInt] = None,
+  // m16-chipyard-022: the `cfx_pmem` 64 KiB SRAM window in core addresses
+  // (`spec/Kaiwu §1.1`: 0x83ff_0000_0000) and its size.  Vast-only; Tiny has
+  // no cfx_pmem.
+  pmemBase: Option[BigInt] = None,
+  pmemSize: Option[BigInt] = None
+)
+
+/** `cfxha` values of the cfx this machine can implement (`DADAO-12` §3.8). */
+object WumingCfxHa {
+  /** User monitor (`DADAO-12` §4.1); `Kaiwu-Vast` only (`m16-chipyard-019`). */
+  val umon: Int = 0
+  val smon: Int = 2
+  val hmon: Int = 3
+  val power: Int = 63
+  /** Page-table walker + TLB (`DADAO-12` §4.5); `Kaiwu-Vast` only. */
+  val ptw: Int = 4
+  /** Cache maintenance (`DADAO-12` §4.6, `contract-cache`); `Kaiwu-Vast` only. */
+  val cache: Int = 5
+  /** Hart management + asynchronous frame (`DADAO-12` §4.7, `ADR-0060`); Vast only. */
+  val hart: Int = 15
+  /**
+    * Per-system global time counter (`DADAO-12` §4.10); Vast only
+    * (`m16-chipyard-023`).  Read-only, no interrupt: the per-hart timer stays in
+    * `cfx_hart`.
+    */
+  val time: Int = 34
+  /** Physical-memory management (`DADAO-12` §4.9); Vast only. */
+  val pmem: Int = 32
+}
+
+/**
+  * The `gewu` (cfx register file) parameters of this core (ADR-0053 D5).
+  *
+  * `gewu` itself carries no machine constant, so the whole cfx profile is
+  * injected here: which cfx exist, which one owns the exception frame, and the
+  * per-cfx vector base / cg7 space descriptor / source-mask reset value.  The
+  * address-map values come from `WumingCoreParams` and have no default, so a
+  * missing base is an elaboration error instead of a silently wrong handoff.
+  *
+  * The machine implements two cfx (`DADAO-12` §3.8/§2.1):
+  *   * cfx_hmon (cfx3) — the monitor: hmon SRAM base, `exists|SRAM`, `R|W|X`;
+  *     the four synchronous source masks reset to "cfx_power and itself only";
+  *   * cfx_power (cfx63) — the BootROM, `exists|ROM`, `R|X`; its masks reset
+  *     to "cfx_power and itself only" as well.
+  * `cfx_intr_mask` resets to all ones on both (no asynchronous source).
+  */
+object WumingGewuParams {
+  private def required[A](opt: Option[A], what: String): A = opt.getOrElse(
+    throw new IllegalArgumentException(
+      s"WumingGewuParams: $what must be configured from the machine address map"))
+
+  // DADAO-12 §3.1 / ADR-0045 D4: four source masks reset to "only cfx_power and
+  // itself allowed" (the self bit is ignored by hardware).  The same value is the
+  // reset of every ordinary cfx, `cfx_ptw` included.
+  private val maskInitHmon = BigInt("7ffffffffffffff7", 16)
+  private val maskInitCfx = BigInt("fffffffffffffff7", 16)
+
+  /**
+    * `cfx_time_freq` of the test machine (`DADAO-12 §4.10`, `contract-see §3`):
+    * 1 GHz — one count per nanosecond, the unit of `cfx_hart cg8 rc2 cycle` on
+    * the single-hart test machine.  The spec leaves the value to the hardware;
+    * the contract fixes this convention, so it is named here rather than left
+    * as a literal at the call site.
+    */
+  private val timeFreqHz = BigInt(1000000000)
+
+  /**
+    * The implemented cfx set: `cfx_hmon` (monitor), `cfx_power` (BootROM), plus
+    * `cfx_umon`/`cfx_smon` (the two monitors added by `m16-chipyard-019`),
+    * `cfx_ptw` and `cfx_cache` when the machine translates the memory window
+    * (`useVM`, i.e. Kaiwu-Vast).  `cfx_umon` has no internal space; `cfx_smon`
+    * describes its 64 KiB SRAM.  `cfx_ptw` has no internal space (`cg7` blocks
+    * all `exists = 0`) and no own vector, so its `vectorBase`/space fields are
+    * zero: the walk reports into the current mode's monitor, never into
+    * `cfx_ptw` (`contract-tlb` TLB-31).  `cfx_cache` likewise has no internal
+    * space/vector; its `cache_exist` value is `0b11` on Vast (CACHE-27).
+    */
+  def apply(p: WumingCoreParams): GewuParams = GewuParams(
+    cfx = Seq(
+      GewuCfxParams(
+        id = WumingCfxHa.hmon,
+        vectorBase = required(p.hmonBase, "hmonBase"),
+        spaceDesc = 0x3,
+        spaceSize = required(p.hmonSize, "hmonSize"),
+        spaceAttr = 0x7,
+        sourceMaskReset = maskInitHmon),
+      // cfx_power (`DADAO-12 §3.5`/§3.7): the common face (cg4 config/counters,
+      // cg6 scratch) is required for every non-reserved cfx (`ISS-524`).  It is
+      // opened on the translating machine only: `Kaiwu-Tiny`'s register map is
+      // a regression criterion and keeps its pre-M16 partial face (cfx3/cfx63
+      // have no `commonRows` there).  `cg7` (BootROM space) and the Tiny-only
+      // `cg8 rc1` are unaffected.
+      GewuCfxParams(
+        id = WumingCfxHa.power,
+        vectorBase = required(p.bootromBase, "bootromBase"),
+        spaceDesc = 0x5,
+        spaceSize = required(p.bootromSize, "bootromSize"),
+        spaceAttr = 0x5,
+        sourceMaskReset = maskInitCfx,
+        commonRows = p.useVM)) ++
+      (if (p.useVM) Seq(
+        // cfx0 umon (`m16-chipyard-019`): no internal space, so cg7 block 0
+        // stays `exists = 0` and `hypv_excp_vector` is platform-defined (we
+        // keep 0).  The full common face is on: mode rows cg0-cg2, cg4, cg5
+        // rc5, cg6 scratch and cg8 rc1.
+        GewuCfxParams(
+          id = WumingCfxHa.umon,
+          vectorBase = 0,
+          spaceDesc = 0,
+          spaceSize = 0,
+          spaceAttr = 0,
+          sourceMaskReset = maskInitCfx,
+          commonRows = true),
+        // cfx2 smon: 64 KiB SRAM (`contract-see §3` test-machine block), so its
+        // cg7 block 0 is `exists|SRAM`, start = internal offset
+        // 0x3ff_0000_0000, size 64 KiB, R|W|X; the hypv vector resets to the
+        // SRAM start (`DADAO-12 §3.4`).
+        GewuCfxParams(
+          id = WumingCfxHa.smon,
+          vectorBase = required(p.smonBase, "smonBase"),
+          spaceDesc = 0x3,
+          spaceSize = required(p.smonSize, "smonSize"),
+          spaceAttr = 0x7,
+          sourceMaskReset = maskInitCfx,
+          commonRows = true),
+        GewuCfxParams(
+          id = WumingCfxHa.ptw,
+          vectorBase = 0,
+          spaceDesc = 0,
+          spaceSize = 0,
+          spaceAttr = 0,
+          sourceMaskReset = maskInitCfx),
+        // cfx_cache (cfx5, `DADAO-12 §3.1`-§3.4/§3.7): the maintenance rows are
+        // cg8, but U/S reachability needs the common mode rows (`cg0`-`cg2`
+        // `*_cfxreg`, `cg3 rc12` deleg) plus the shared cg4/cg5/cg6 face
+        // (`DIV-16`).  Opening `commonRows` adds only register rows: the
+        // `cg8` maintenance semantics (`CACHE-*`) are untouched.
+        GewuCfxParams(
+          id = WumingCfxHa.cache,
+          vectorBase = 0,
+          spaceDesc = 0,
+          spaceSize = 0,
+          spaceAttr = 0,
+          sourceMaskReset = maskInitCfx,
+          commonRows = true),
+        // cfx_hart (`m16-chipyard-021`/`024`, `ADR-0061`): per-hart management
+        // (cg8) plus the seven-slot asynchronous frame (cg9).  It opts into the
+        // common mode rows so the two-axis access model of `contract-see §6.3`
+        // gives supv a `<mode>_cfxreg` mask and the `cg3 rc12` delegation
+        // bitmap; `cg8 rc1` (the running mode's async source mask) stays
+        // cfx0-cfx3 only.
+        GewuCfxParams(
+          id = WumingCfxHa.hart,
+          vectorBase = 0,
+          spaceDesc = 0,
+          spaceSize = 0,
+          spaceAttr = 0,
+          sourceMaskReset = maskInitCfx,
+          commonRows = true),
+        // cfx_pmem (`m16-chipyard-022`, `DADAO-12 §4.9`): 64 KiB SRAM at
+        // internal offset 0x3ff_0000_0000, so its cg7 block 0 is
+        // `exists|SRAM`, start = that offset, size 64 KiB, `R|W` (X = 0);
+        // it owns no exception vector and no mode rows.
+        GewuCfxParams(
+          id = WumingCfxHa.pmem,
+          vectorBase = required(p.pmemBase, "pmemBase"),
+          spaceDesc = 0x3,
+          spaceSize = required(p.pmemSize, "pmemSize"),
+          spaceAttr = 0x3,
+          sourceMaskReset = maskInitCfx,
+          // The shared face (cg0-cg3 masks/deleg, cg4 config, cg5 rc5, cg6
+          // scratch) is what makes the cfx reachable from U/S under the
+          // two-axis `cfxreg` rule (DIV-09: a cfx without `<mode>` rows is
+          // fail-closed there).  `cfx_pmem` is a system-service cfx (SBI
+          // PMEM_DMA runs from smon), so it opts in like `cfx_hart`.
+          commonRows = true),
+        // cfx_time (`m16-chipyard-023`, `DADAO-12 §4.10`): the per-system global
+        // time counter, `cg10 rc0/rc1` read-only and **no interrupt** (the
+        // per-hart timer/interrupt stays in cfx_hart).  It has no internal
+        // space and no vector, so its `vectorBase`/space fields are zero; it
+        // opts into the common mode rows so supv/user can be granted the read
+        // through its `<mode>_cfxreg` mask and `cg3 rc12` delegation
+        // (`contract-see §3`).
+        GewuCfxParams(
+          id = WumingCfxHa.time,
+          vectorBase = 0,
+          spaceDesc = 0,
+          spaceSize = 0,
+          spaceAttr = 0,
+          sourceMaskReset = maskInitCfx,
+          commonRows = true)) else Nil),
+    monitor = 0, // cfx_hmon owns the exception frame (spec/Kaiwu §4.1)
+    dataBits = 64,
+    modeBits = 2,
+    sourceMaskBits = 64,
+    // `inner_run_mode` (DADAO-12 §5.2 step 6): both profiles start in hypv.
+    runModeReset = 3,
+    // `inner_cfx_code` at reset: the reset vector is
+    // `cfx_power_hypv_excp_vector` inside the BootROM, i.e. the core starts as
+    // cfx_power (spec/Kaiwu §1).  The boot ROM hands over with `trap cfx_hmon`
+    // and the monitor's `escape` restores this value (§5.3 step 2).
+    runCfxReset = WumingCfxHa.power,
+    hypvMode = 3,
+    switchModeValue = 3,
+    // cfx_ptw's register rows exist only on the translating machine.
+    ptw = if (p.useVM) Some(GewuPtwParams(WumingCfxHa.ptw)) else None,
+    // cfx_cache's register rows exist only on Kaiwu-Vast (CACHE-27); Tiny
+    // keeps the rows undefined, i.e. CFXREG (CACHE-28).
+    cache = if (p.useVM) Some(GewuCacheParams(WumingCfxHa.cache, 0x3)) else None,
+    // `cfx_hart`'s cg8/cg9 face exists only on Kaiwu-Vast (`m16-chipyard-021`);
+    // Kaiwu-Tiny has no cfx15 and gains neither ports nor flops.
+    hart = if (p.useVM) Some(GewuHartParams(WumingCfxHa.hart, 0)) else None,
+    // `cfx_pmem` (`m16-chipyard-022`): the register face + DMA command port
+    // exist only on Kaiwu-Vast (`spec/Kaiwu §3`); its SRAM internal offset is
+    // the spec's `0x3ff_0000_0000` and every window comes from the address map.
+    pmem = if (p.useVM) Some(GewuPmemParams(
+      cfxId = WumingCfxHa.pmem,
+      sramBase = required(p.pmemBase, "pmemBase"),
+      sramSize = required(p.pmemSize, "pmemSize"),
+      sramOffset = BigInt("3ff00000000", 16),
+      paBase = required(p.paRamBase, "paRamBase"),
+      paSize = required(p.paRamSize, "paRamSize"),
+      romBase = required(p.bootromBase, "bootromBase"),
+      romSize = required(p.bootromSize, "bootromSize"))) else None,
+    // `cfx_time`'s cg10 face exists only on Kaiwu-Vast (`m16-chipyard-023`):
+    // the test machine counts at 1 GHz (`contract-see §3`: 1 count = 1 ns,
+    // `cfx_time_value` and the single hart's `cycle` share this base).  Tiny
+    // has no cfx34 and gains neither ports nor flops.
+    time = if (p.useVM) Some(GewuTimeParams(WumingCfxHa.time, timeFreqHz))
+      else None,
+    // `m16-chipyard-020`: Kaiwu-Vast runs the DADAO-12 §5.2 run-mode entry
+    // routing (U/S/H monitors, `<mode>_switch_run_mode`, two-axis `cfxreg`
+    // checks).  Kaiwu-Tiny has no U/S/J mode at all (`spec/Kaiwu §2` keeps the
+    // run mode at hypv and every non-hmon general trap is ILLI), so the flag
+    // stays off there and the pre-020 RTL behaviour is preserved bit for bit.
+    modeEntry = p.useVM)
+}
+
+/**
+  * Kaiwu-Vast core parameters (`m16-chipyard-006`).
+  *
+  * The same core as Kaiwu-Tiny plus the translated memory window
+  * (`useVM = true`) and the `cfx_ptw` register face.  The address-map values are
+  * required, not defaulted, for the same reason as Tiny's: an absent base must
+  * be an elaboration error instead of a silently misplaced load.
+  */
+object WumingVastParams {
+  def apply(
+    loadMemBase: BigInt,
+    loadMemSize: BigInt,
+    loadMemEntry: BigInt,
+    hmonBase: BigInt,
+    hmonSize: BigInt,
+    // m16-chipyard-019: cfx_smon's 64 KiB SRAM (`contract-see §3`).
+    smonBase: BigInt,
+    smonSize: BigInt,
+    // m16-chipyard-022: cfx_pmem's 64 KiB SRAM (`spec/Kaiwu §1.1`).
+    pmemBase: BigInt,
+    pmemSize: BigInt,
+    bootromBase: BigInt,
+    bootromSize: BigInt,
+    paRamBase: BigInt,
+    paRamSize: BigInt
+  ): WumingCoreParams = WumingCoreParams(
+    loadMemBase = Some(loadMemBase),
+    loadMemSize = Some(loadMemSize),
+    loadMemEntry = Some(loadMemEntry),
+    hmonBase = Some(hmonBase),
+    hmonSize = Some(hmonSize),
+    smonBase = Some(smonBase),
+    smonSize = Some(smonSize),
+    pmemBase = Some(pmemBase),
+    pmemSize = Some(pmemSize),
+    bootromBase = Some(bootromBase),
+    bootromSize = Some(bootromSize),
+    useVM = true,
+    paRamBase = Some(paRamBase),
+    paRamSize = Some(paRamSize))
+}
+
+/** Wiring-only adapter: `TileParams.core` is typed `CoreParams`. */
+private[common] case class WumingCompatCoreParams(w: WumingCoreParams) extends CoreParams {
+  val bootFreqHz = w.bootFreqHz
+  val xLen = w.xLen
+  val retireWidth = w.retireWidth
+  val nLocalInterrupts = w.nLocalInterrupts
+
+  // 字段保留、语义不用: this is rocket-chip's RISC-V-MMU wiring flag
+  // (`BaseTile.vaddrBits` = Sv39/Sv48 VA width, `Core` requires
+  // `pgLevels >= 3` for xLen = 64).  DADAO's address space is the *opposite*
+  // shape — 42-bit VA, 56-bit PA (`DADAO-12` §2.2) — so setting it aborts
+  // elaboration: `require(v == xLen || xLen > v && v > paddrBits)` in
+  // `BaseTile.vaddrBits` fails for paddrBits = 48.  It stays `false` on both
+  // profiles; the translation this machine really performs is `cfx_ptw`
+  // inside the core, driven by `WumingCoreParams.useVM` (which lives one
+  // class up and carries no RISC-V meaning).
+  val useVM = false
+  val useHypervisor = false
+  val useUser = false
+  val useSupervisor = false
+  val useDebug = false
+  val useAtomics = false
+  val useAtomicsOnlyForIO = false
+  val useCompressed = false
+  val useRVE = false
+  val useConditionalZero = false
+  val useZba = false
+  val useZbb = false
+  val useZbs = false
+  val mulDiv: Option[MulDivParams] = None
+  val fpu: Option[FPUParams] = None
+  val fetchWidth = 1
+  val decodeWidth = 1
+  val instBits = 16
+  val useNMI = false
+  val nPMPs = 0
+  val pmpGranularity = 4
+  val nBreakpoints = 0
+  val useBPWatch = false
+  val mcontextWidth = 0
+  val scontextWidth = 0
+  val nPerfCounters = 0
+  val haveBasicCounters = false
+  val haveFSDirty = false
+  val misaWritable = false
+  val haveCFlush = false
+  val nL2TLBEntries = 0
+  val nL2TLBWays = 0
+  val nPTECacheEntries = 0
+  val mtvecInit: Option[BigInt] = None
+  val mtvecWritable = false
+  val traceHasWdata = false
+  // 字段保留、语义不用: `pgLevels` is rocket-chip's RISC-V page-table depth
+  // (2 = Sv32, 3 = Sv39/Sv48) and nothing in this tile reads it.  The DADAO
+  // two-level table (L1/L2, both 8192 × 8 B = 64 KiB, `DADAO-12` §2.2.1/§2.2.2)
+  // is implemented by `cfx_ptw` inside the core, not by this field, so the value
+  // stays at the upstream-legal placeholder 3.  It cannot carry the DADAO depth:
+  // `Core` (Core.scala) requires `pgLevels >= 3` for xLen = 64 whenever the
+  // upstream `useVM` is set, and that path is unusable anyway (see the `useVM`
+  // note above).  No geometry may be derived from this field.
+  val pgLevels = 3
+  val lrscCycles = 1
+}
+
+case class WumingTileParams(
+  name: Option[String] = Some("wuming_tile"),
+  tileId: Int = 0,
+  wumingParams: WumingCoreParams = WumingCoreParams()
+) extends InstantiableTileParams[WumingTile] {
+  val core: CoreParams = WumingCompatCoreParams(wumingParams)
+  val baseName: String = name.getOrElse("wuming_tile")
+  val uniqueName: String = s"${baseName}_$tileId"
+  val icache: Option[ICacheParams] = None
+  val dcache: Option[DCacheParams] = None
+  val btb: Option[BTBParams] = None
+  val blockerCtrlAddr: Option[BigInt] = None
+  val clockSinkParams: ClockSinkParameters = ClockSinkParameters()
+  def instantiate(
+    crossing: HierarchicalElementCrossingParamsLike,
+    lookup: LookupByHartIdImpl
+  )(implicit p: Parameters): WumingTile =
+    new WumingTile(this, crossing, lookup)
+}
+
+case class WumingTileAttachParams(
+  tileParams: WumingTileParams,
+  crossingParams: HierarchicalElementCrossingParamsLike = RocketCrossingParams()
+) extends CanAttachTile {
+  type TileType = WumingTile
+}
+
+/** Attach `n` wuming tiles to the subsystem (single-core for now). */
+class WithNWumingTiles(n: Int = 1, wumingParams: WumingCoreParams = WumingCoreParams())
+    extends Config((site, here, up) => {
+  case TilesLocated(InSubsystem) =>
+    val prev = up(TilesLocated(InSubsystem), site)
+    val idOffset = up(NumTiles)
+    (0 until n).map { i =>
+      WumingTileAttachParams(
+        tileParams = WumingTileParams(tileId = i + idOffset, wumingParams = wumingParams)
+      )
+    } ++ prev
+  case NumTiles => up(NumTiles) + n
+}) {
+  require(n >= 1, "WithNWumingTiles: n must be >= 1")
+}
