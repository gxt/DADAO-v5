diff --git a/generators/dadao-wuming/src/main/scala/wuming/common/WumingCore.scala b/generators/dadao-wuming/src/main/scala/wuming/common/WumingCore.scala
new file mode 100644
index 0000000..74b5fdd
--- /dev/null
+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingCore.scala
@@ -0,0 +1,839 @@
+// See LICENSE for license details.
+//
+// DADAO "wuming" core: split fetch/data ports, 8-beat fetch queue and the
+// m12-006 multi-cycle state-machine skeleton (m12-chipyard-018).
+//
+// Structure (`.tao/knowledge/refs/m12-006-cycle-design.md` §5):
+//
+//   * two independent TileLink client ports.  `imem` carries the demand fetch
+//     plus the sequential prefetch; `dmem` carries loads/stores.  Each port
+//     owns its own A/D channel pair and its own request/response state, so a
+//     slow data access cannot stall fetch progress.
+//   * a `fetchDepth` (= 8 beats = 64 B) circular queue of consecutive beats.
+//     The prefetch walks the queue forward over the client's spare source IDs
+//     (source 0 = demand fetch, 1..4 = the four prefetch slots); a hit costs no
+//     extra cycle (`EXEC` decodes straight out of the queue).
+//   * the 12-state skeleton of §5.1: IDLE / FREQ / FWAIT / EXEC / TRAP / SEMI
+//     / EXC / MREQ / MWAIT / SLOW / FAULT / HALT.  Cycle policy R1 = C:
+//     shift/bit-field ops take two cycles (`EXEC` latches the operands,
+//     `SLOW` computes and writes back), plain arithmetic takes one.  The
+//     register file keeps its 2-write/3-read shape (R8 = 2R2W).
+//
+// Out of scope here (kept exactly as m12-005 left it): the instruction subset
+// (`ld.o`/`st.o`, `jump`, semihosting `trap`, the SimRISC-04/05/08 integer
+// families) and its fault classification.  `ldm`/`stm` are m12-chipyard-008.
+//
+// m12-chipyard-007 adds the *boot handoff* half of cfx_hmon: the CFXTRAP entry
+// produced by `trap cfx_hmon, <magic>`, the cause frame
+// (`excp_cause_id`/`excp_cause_ip`/`excp_cause_info`), `excp_vector` (cg3
+// rc10; reset value = hmon SRAM base, writes drop the low 2 bits) and `escape`
+// with the fixed 0/+4 offsets.  That is what the BootROM firmware needs
+// (spec/Machine-v5 §6.2 steps 4-8, DADAO-12 §5.2/§5.3).
+//
+// m12-chipyard-019 completes cfx_hmon and adds cfx_power's register group
+// (DADAO-13 §1/§2, DADAO-12 §3/§4.12, Machine-v5 §3/§4.4): the four
+// synchronous source masks, `cfx_intr_mask`, `switch_run_mode` (Tiny keeps
+// hypv), the cg7 space descriptors, `excp_prev_run_mode` and the five
+// synchronous fault classes (CFXMEM/ILLI/UNDI/MALIGN/IALIGN) — each one writes
+// the cause frame and jumps to `excp_vector` instead of terminating the core.
+// `cg3` is hypv-only (otherwise CFXREG) and an unsupported (cg, rc) of an
+// implemented cfx is CFXREG as well: never a silent success.  `escape`
+// restores `excp_prev_run_mode`.
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+import freechips.rocketchip.tilelink.{TLBundle, TLEdgeOut}
+
+class WumingCore(
+  fetchEdge: TLEdgeOut,
+  dataEdge: TLEdgeOut,
+  params: WumingCoreParams,
+  hartidBits: Int,
+  resetVectorBits: Int
+) extends Module {
+  require(fetchEdge.bundle.dataBits == dataEdge.bundle.dataBits,
+    "WumingCore: the fetch and data ports must negotiate the same beat width")
+  require(fetchEdge.bundle.addressBits == dataEdge.bundle.addressBits,
+    "WumingCore: the fetch and data ports must negotiate the same address width")
+
+  val io = IO(new Bundle {
+    val imem = new TLBundle(fetchEdge.bundle)
+    val dmem = new TLBundle(dataEdge.bundle)
+    val hartid = Input(UInt((hartidBits max 1).W))
+    val resetVector = Input(UInt(resetVectorBits.W))
+    val bootEnable = Input(Bool())
+    val semi = new Bundle {
+      val req = Output(new WumingSemiReq)
+      val resp = Input(new WumingSemiResp)
+    }
+    val halted = Output(Bool())
+  })
+
+  val addrBits = fetchEdge.bundle.addressBits
+  val beatBytes = fetchEdge.bundle.dataBits / 8
+  require(beatBytes == 8, "WumingCore: expected a 64-bit TileLink beat")
+  require(addrBits >= 48, "WumingCore: the Tiny address map must negotiate >= 48 bits")
+  val lgSize = log2Ceil(beatBytes).U
+
+  val fetchDepth = params.fetchDepth
+  require(fetchDepth >= 2, "WumingCore: FETCH_DEPTH must hold at least two beats")
+  private val ptrBits = log2Ceil(fetchDepth)
+  private val cntBits = log2Ceil(fetchDepth + 1)
+  private val beatBits = addrBits - 3
+  // Prefetch slots = the source IDs this port does not use for the demand
+  // fetch.  m12-020 widened `IdRange(0, 3)` to `IdRange(0, 5)`, so four
+  // prefetches can be in flight and the queue no longer drains at every beat
+  // boundary.
+  private val pfSlots = 4
+
+  // TileLink source IDs of the fetch port.  The data port is a separate client
+  // node with its own (client-local) source space, so §5.5's global numbering
+  // (0 = fetch, 1 = data, 2 = prefetch) collapses to "0 = demand fetch, the
+  // spare IDs = prefetch slots" on the fetch port.  Prefetch slot i uses
+  // source i + 1.
+  private val srcBits = fetchEdge.bundle.sourceBits
+  val FETCH_SRC = 0.U(srcBits.W)
+  val DATA_SRC = 0.U(srcBits.W)
+
+  // ---- architectural state ----------------------------------------------
+  val ip = RegInit(0.U(64.W)) // address of the instruction being executed
+
+  // ---- cfx register groups: cfx_hmon (cfx3) and cfx_power (cfx63) ----------
+  //
+  // m12-019 lands the register group the Tiny profile needs
+  // (spec/DADAO-13 §1/§2, spec/DADAO-12 §3/§4.12, spec/Machine-v5 §3):
+  //
+  //   cg3 rc0-rc3  cfxtrap / cfxmem / cfxreg / cfxexe source masks   (RW)
+  //   cg3 rc4      cfx_intr_mask                                     (RW)
+  //   cg3 rc8      switch_run_mode — Tiny: writes ignored, reads 3
+  //   cg3 rc10     excp_vector — reset = the cfx's own base; writes drop the
+  //                low 2 bits (DADAO-13 §1)
+  //   cg5 rc0      excp_prev_run_mode (RW; `escape` restores it)
+  //   cg5 rc2/rc4  excp_cause_id / excp_cause_info (hardware-written)
+  //   cg5 rc3      excp_cause_ip (RW)
+  //   cg7 rc0-63   internal space descriptors (read-only; writes are CFXREG)
+  //
+  // Every other (cg, rc) of these two cfx is not implemented on this profile
+  // and reads/writes as CFXREG — never as a silent zero (spec/Machine-v5 §3
+  // keeps `cg8 rc1` = cfx_power_ctrl unimplemented on Tiny; cg4/cg6/cg3 rc12
+  // and cg5 rc1/rc5 stay unimplemented as well).
+  //
+  // Only two cfx exist, so the state is a two-entry table: index 0 = cfx_hmon,
+  // index 1 = cfx_power.  cg3 is hypv-only (DADAO-13 §1): in any other run
+  // mode the whole cg3 row is CFXREG.
+  private val C_HMON = 3.U(6.W)
+  private val C_POWER = 63.U(6.W)
+
+  private def requiredValue[A](opt: Option[A], what: String): A = opt.getOrElse(
+    throw new IllegalArgumentException(
+      s"WumingCore: $what must be configured from the machine address map"))
+  private val hmonBaseValue = requiredValue(params.hmonBase, "hmonBase")
+  private val hmonSizeValue = requiredValue(params.hmonSize, "hmonSize")
+  private val bootromBaseValue = requiredValue(params.bootromBase, "bootromBase")
+  private val bootromSizeValue = requiredValue(params.bootromSize, "bootromSize")
+  // cg7 space block 0 start = base - (cfxha << 42) (DADAO-12 §3.8/§2.1).
+  private val hmonSpaceStart = hmonBaseValue - (BigInt(3) << 42)
+  private val powerSpaceStart = bootromBaseValue - (BigInt(63) << 42)
+
+  // DADAO-12 §3.1 / ADR-0045 D4: the four synchronous source masks reset to
+  // "only cfx_power and itself allowed" (bit3 self is ignored by hardware);
+  // `cfx_intr_mask` resets to all ones (Tiny has no asynchronous sources).
+  private val maskInitHmon = BigInt("7ffffffffffffff7", 16)
+  private val maskInitPower = BigInt("fffffffffffffff7", 16)
+  private val allOnes = BigInt("ffffffffffffffff", 16)
+  private def sourceMask = RegInit(VecInit(Seq(
+    maskInitHmon.U(64.W), maskInitPower.U(64.W))))
+
+  val cfxTrapMask = sourceMask // cg3 rc0
+  val cfxMemMask  = sourceMask // cg3 rc1
+  val cfxRegMask  = sourceMask // cg3 rc2
+  val cfxExeMask  = sourceMask // cg3 rc3
+  val cfxIntrMask = RegInit(VecInit(Seq.fill(2)(allOnes.U(64.W)))) // cg3 rc4
+  // cg3 rc10: the internal SRAM base of each cfx (DADAO-13 §1): the hmon SRAM
+  // for cfx_hmon, the BootROM for cfx_power (DADAO-12 §2.1).
+  val cfxVector = RegInit(VecInit(Seq(
+    hmonBaseValue.U(64.W), bootromBaseValue.U(64.W))))
+  // cg5 rc0 / rc2 / rc3 / rc4 exception frame.
+  val cfxPrevMode  = RegInit(VecInit(Seq.fill(2)(0.U(2.W))))
+  val cfxCauseId   = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+  val cfxCauseIp   = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+  val cfxCauseInfo = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+
+  // `inner_run_mode` (DADAO-12 §5.2 step 6).  Tiny starts and stays in hypv:
+  // exception entry loads `switch_run_mode`, which the profile pins at 3, and
+  // only `escape` can move it back to `excp_prev_run_mode`.
+  val runMode = RegInit(3.U(2.W))
+
+  val CFXTRAP_BIT = 0
+  val CFXMEM_BIT  = 1
+  val CFXREG_BIT  = 2
+  val CFXESC_BIT  = 3
+  val ILLI_BIT    = 8
+  val UNDI_BIT    = 9
+  val MALIGN_BIT  = 12
+  val IALIGN_BIT  = 13
+  // `excp_cause_id` is a one-hot 64-bit value (DADAO-12 §5.2(二)); 0 means "no
+  // valid frame" and is what `escape` checks before switching back.
+  val cfxHasFrame = cfxCauseId(0) =/= 0.U
+
+  val sIdle :: sFreq :: sFwait :: sExec :: sTrap :: sSemi :: sExc :: sMreq :: sMwait :: sSlow :: sFault :: sHalt :: Nil = Enum(12)
+  val state = RegInit(sIdle)
+
+  // Simulation-time cycle stamp for the timing evidence (`+verbose`).
+  val cycles = RegInit(0.U(64.W))
+  cycles := cycles + 1.U
+
+  // Semihosting return register (contract-semihosting: scalar result in rd8).
+  val semiRetReg = 8.U(6.W)
+  val semiOp = RegInit(0.U(8.W))
+  val semiArg = RegInit(0.U(64.W))
+  val semiPc = RegInit(0.U(64.W))
+  val semiIsHost = RegInit(false.B)
+
+  val rf = Module(new WumingRegFile)
+  rf.io.ip := ip
+
+  // ---- fetch queue (fetchDepth consecutive beats) -------------------------
+  val qBeat = Reg(Vec(fetchDepth, UInt(beatBits.W))) // beat index (address >> 3)
+  val qData = Reg(Vec(fetchDepth, UInt(64.W)))       // 8 bytes in address order
+  val qHead = RegInit(0.U(ptrBits.W))
+  val qCount = RegInit(0.U(cntBits.W))
+  // Beat index of the next entry to push.  Kept explicitly because the queue can
+  // be empty (after a flush or the `waitBeat` hand-over) while prefetch requests
+  // are still in flight: `qBeat(qHead)` is meaningless then.
+  val nextBeatReg = RegInit(0.U(beatBits.W))
+  val qFull = qCount === fetchDepth.U
+
+  // Single write port for the queue: every producer goes through these wires so
+  // a push, a pop and a flush in the same cycle cannot clobber each other.
+  val fifoPush = WireDefault(false.B)
+  val fifoPop = WireDefault(0.U(cntBits.W))
+  val fifoFlush = WireDefault(false.B)
+  val pushBeat = WireDefault(0.U(beatBits.W))
+  val pushData = WireDefault(0.U(64.W))
+
+  val headBeat = qBeat(qHead)
+  val curBeat = ip(addrBits - 1, 3)
+  val curOff = curBeat - headBeat
+  val queueHit = qCount =/= 0.U && curOff < qCount
+  val instIdx = (qHead + curOff)(ptrBits - 1, 0)
+  val beatData = qData(instIdx)
+
+  // TileLink puts byte k of a beat in bits [8k+7, 8k] (little-endian lanes);
+  // DADAO is big-endian, so re-assemble the beat in address order.
+  def addressOrder(value: UInt): UInt =
+    Cat((0 until beatBytes).map(i => value(8 * i + 7, 8 * i)))
+
+  def laneOrder(value: UInt): UInt =
+    Cat((0 until beatBytes).reverse.map(i => value(63 - 8 * i, 56 - 8 * i)))
+
+  val inst = Mux(ip(2), beatData(31, 0), beatData(63, 32))
+
+  // ---- decode ------------------------------------------------------------
+  val dec = Module(new WumingDecoder)
+  dec.io.inst := inst
+  val d = dec.io.dec
+
+  // ---- cfx register file access (m12-019) ---------------------------------
+  // Two implemented cfx (cfx_hmon, cfx_power) and the register subset listed at
+  // the declaration above; anything else is an unsupported register access and
+  // raises CFXREG (never a silent read of zero / silent drop of a write).
+  val cfxIsHmon = d.cfxHa === C_HMON
+  val cfxIsPower = d.cfxHa === C_POWER
+  val cfxImplemented = cfxIsHmon || cfxIsPower
+  private val monIdx = Mux(cfxIsHmon, 0.U(1.W), 1.U(1.W))
+  private val isCg3 = d.cfxCg === 3.U
+  // DADAO-13 §1: the whole cg3 row is hypv-only.
+  private val cg3Allowed = !isCg3 || runMode === 3.U
+  private val isMask = isCg3 && d.cfxRc <= 4.U
+  private val isSwitchMode = isCg3 && d.cfxRc === 8.U
+  private val isVector = isCg3 && d.cfxRc === 10.U
+  private val isPrevMode = d.cfxCg === 5.U && d.cfxRc === 0.U
+  private val isCauseId = d.cfxCg === 5.U && d.cfxRc === 2.U
+  private val isCauseIp = d.cfxCg === 5.U && d.cfxRc === 3.U
+  private val isCauseInfo = d.cfxCg === 5.U && d.cfxRc === 4.U
+  private val isSpace = d.cfxCg === 7.U
+  private val cfxReadOk = cfxImplemented && cg3Allowed &&
+    (isMask || isSwitchMode || isVector || isPrevMode || isCauseId ||
+      isCauseIp || isCauseInfo || isSpace)
+  // cg3 rc8 accepts the write and ignores it (Tiny keeps hypv); cg5 rc2/rc4
+  // are hardware-written and cg7 is read-only, so writing them is CFXREG.
+  private val cfxWriteOk = cfxImplemented && cg3Allowed &&
+    (isMask || isSwitchMode || isVector || isPrevMode || isCauseIp)
+  val cfxRegOk = Mux(d.cfxWrite, cfxWriteOk, cfxReadOk)
+  // A rejected cfx2 access is a precise CFXREG: the destination register must
+  // not be modified (DADAO-12 §5 "目标寄存器/内存/RA 未更新").
+  val cfxFault = d.isCfx2 && !cfxRegOk
+  private val cg3MaskData = MuxLookup(d.cfxRc, 0.U(64.W))(Seq(
+    0.U -> cfxTrapMask(monIdx), 1.U -> cfxMemMask(monIdx),
+    2.U -> cfxRegMask(monIdx), 3.U -> cfxExeMask(monIdx),
+    4.U -> cfxIntrMask(monIdx)))
+  // cg7: 16 blocks of 4 words (desc/start/size/attr); only block 0 exists.
+  private val cg7Block0 = d.cfxRc(5, 2) === 0.U
+  private val cg7Data = MuxLookup(d.cfxRc(1, 0), 0.U(64.W))(Seq(
+    0.U -> Mux(cfxIsHmon, 0x3.U(64.W), 0x5.U(64.W)), // exists|SRAM / exists|ROM
+    1.U -> Mux(cfxIsHmon, hmonSpaceStart.U(64.W), powerSpaceStart.U(64.W)),
+    2.U -> Mux(cfxIsHmon, hmonSizeValue.U(64.W), bootromSizeValue.U(64.W)),
+    3.U -> Mux(cfxIsHmon, 0x7.U(64.W), 0x5.U(64.W)))) // R|W|X / R|X
+  private val cg7Rdata = Mux(cg7Block0, cg7Data, 0.U(64.W))
+  val cfxRdata = Mux(isMask, cg3MaskData,
+    Mux(isSwitchMode, 3.U(64.W), // Tiny: the saved value stays 3
+      Mux(isVector, cfxVector(monIdx),
+        Mux(isPrevMode, cfxPrevMode(monIdx).pad(64),
+          Mux(isCauseId, cfxCauseId(monIdx),
+            Mux(isCauseIp, cfxCauseIp(monIdx),
+              Mux(isCauseInfo, cfxCauseInfo(monIdx), cg7Rdata)))))))
+
+  // ---- operands / ALU ----------------------------------------------------
+  rf.io.r0Idx := d.srcAIdx; rf.io.r0Rb := d.srcARb
+  rf.io.r1Idx := d.srcBIdx; rf.io.r1Rb := d.srcBRb
+  rf.io.r2Idx := d.srcCIdx; rf.io.r2Rb := d.srcCRb
+
+  val srcA = Mux(d.srcAIsIp, ip, rf.io.r0Data)
+  val srcB = rf.io.r1Data
+
+  // `SLOW` latches the operands in `EXEC` and re-uses the same ALU, so the
+  // shift/bit-field result is not on the `EXEC` critical path (R1 = C).
+  val slowA = RegInit(0.U(64.W))
+  val slowB = RegInit(0.U(64.W))
+  val slowShamt = RegInit(0.U(6.W))
+  val slowOp = RegInit(0.U(5.W))
+  val slowWidth = RegInit(3.U(2.W))
+  val slowWp = RegInit(0.U(2.W))
+  val slowW0En = RegInit(false.B)
+  val slowW0Idx = RegInit(0.U(6.W))
+  val slowW0Rb = RegInit(false.B)
+  val slowW0Sel = RegInit(0.U(1.W))
+  val slowW1En = RegInit(false.B)
+  val slowW1Idx = RegInit(0.U(6.W))
+  val slowW1Rb = RegInit(false.B)
+
+  val alu = Module(new WumingALU)
+  val aluSel = state === sSlow
+  alu.io.op := Mux(aluSel, slowOp, d.aluOp)
+  alu.io.opWidth := Mux(aluSel, slowWidth, d.opWidth)
+  alu.io.a := Mux(aluSel, slowA, srcA)
+  alu.io.b := Mux(aluSel, slowB, Mux(d.useImmB, d.imm, srcB))
+  alu.io.shamt := Mux(aluSel, slowShamt, Mux(d.shamtFromImm, d.imm(5, 0), srcB(5, 0)))
+  alu.io.wp := Mux(aluSel, slowWp, d.wp)
+
+  val jumpTarget = (srcA + srcB + d.jumpOff)(63, 0)
+  val memAddr = (srcA + d.memOff)(63, 0)
+  val storeValue = srcB
+
+  // ---- write-back --------------------------------------------------------
+  val execFault = d.ill || d.undi
+  val ldData = addressOrder(io.dmem.d.bits.data)
+
+  // R1 = C: shifts / bit-field ops take the two-cycle path.
+  val slowOps = Seq(WumingAluOp.SHL, WumingAluOp.SHR_U, WumingAluOp.SHR_S,
+    WumingAluOp.ROL, WumingAluOp.EXT_U, WumingAluOp.EXT_S)
+  val aluIsSlow = slowOps.map(op => d.aluOp === op).reduce(_ || _)
+
+  val execW0 = state === sExec && !execFault && !cfxFault && !aluIsSlow && d.w0En
+  val slowW0 = state === sSlow && slowW0En
+  val ldW0 = state === sMwait && d.isLd
+  val semiW0 = state === sSemi && io.semi.resp.valid
+
+  rf.io.w0En := execW0 || slowW0 || ldW0 || semiW0
+  rf.io.w0Idx := Mux(semiW0, semiRetReg,
+    Mux(ldW0, d.ldDst, Mux(slowW0, slowW0Idx, d.w0Idx)))
+  rf.io.w0Rb := Mux(semiW0 || ldW0, false.B, Mux(slowW0, slowW0Rb, d.w0Rb))
+  rf.io.w0Data := Mux(semiW0, io.semi.resp.value,
+    Mux(d.isCfx2, cfxRdata,
+    Mux(ldW0, ldData,
+      Mux(slowW0, Mux(slowW0Sel === 1.U, alu.io.hi, alu.io.lo),
+        Mux(d.w0Sel === 1.U, alu.io.hi, alu.io.lo)))))
+
+  // rrrr: w0 = high half (w0Sel = 1), w1 = low half (m12-005 shape).
+  rf.io.w1En := (state === sExec && !execFault && !cfxFault && !aluIsSlow && d.w1En) ||
+    (state === sSlow && slowW1En)
+  rf.io.w1Idx := Mux(state === sSlow, slowW1Idx, d.w1Idx)
+  rf.io.w1Rb := Mux(state === sSlow, slowW1Rb, d.w1Rb)
+  rf.io.w1Data := alu.io.lo
+
+  // ---- fetch port (demand + prefetch) ------------------------------------
+  // Demand beat address, latched at the A-channel handshake, and the
+  // "wait for a beat that is already in flight" mode of `sFwait` (see
+  // `finish`); both are read by the prefetch logic below.
+  val demandBeat = RegInit(0.U(beatBits.W))
+  val waitBeat = RegInit(false.B)
+
+  val fetchAddr = Cat(0.U((64 - addrBits).W), ip(addrBits - 1, 3), 0.U(3.W))
+  val (_, fetchBits) = fetchEdge.Get(FETCH_SRC, fetchAddr(addrBits - 1, 0), lgSize)
+  // m12-019: `TLEdge.Get` returns the *fast* legality, which decodes only the
+  // supported ranges and therefore presumes a legal address; an unbacked
+  // address can come back "legal" and reach the bus (where the monitor rejects
+  // it).  The safe variants check every manager, which is what the
+  // architectural CFXMEM test needs (spec/Machine-v5 §4.4).
+  val fetchLegal = fetchEdge.manager.supportsGetSafe(fetchAddr(addrBits - 1, 0), lgSize)
+
+  // Four prefetch slots keep the queue walking forward (m12-020).  Every live
+  // prefetch is for a beat after the newest queued one, and replies are matched
+  // back to their slot by source ID, so no assumption is made about the order in
+  // which the manager answers.  A demand fetch marks the outstanding prefetches
+  // stale: their replies are dropped instead of being queued into a stream that
+  // no longer exists (speculative fetches never fault,
+  // `.tao/knowledge/refs/m12-006-cycle-design.md` §5.5 rule 7), which is why the
+  // D channel is always ready.
+  //
+  // Data priority (m12-020): while the data port has a request outstanding the
+  // core starts no new prefetch, so a long load/store burst is not crowded out
+  // of the SRAM.  Prefetches already on the bus are left alone (their slots are
+  // still released by their replies, and still flushed as stale).  Arbitration
+  // resumes as soon as the data port has no outstanding request
+  // (`MREQ`/`MWAIT` are the only states with one).
+  val pfValid = RegInit(VecInit(Seq.fill(pfSlots)(false.B)))
+  val pfStale = RegInit(VecInit(Seq.fill(pfSlots)(false.B)))
+  val pfBeatV = RegInit(VecInit(Seq.fill(pfSlots)(0.U(beatBits.W))))
+  val pfLiveV = VecInit((0 until pfSlots).map(i => pfValid(i) && !pfStale(i)))
+  // `pfLive` = prefetches that still extend the queue; `pfBusy` = source IDs in
+  // use (a flushed request keeps its ID until its reply arrives).
+  val pfLive = PopCount(pfLiveV)
+  val pfBusy = PopCount(pfValid)
+  val pfBeat = nextBeatReg + pfLive // beat index of the next prefetch
+
+  // The launch register: a prefetch is prepared in one cycle and then held on
+  // the A channel until the handshake, so `a.valid` is never retracted and the
+  // `bits` are stable while it is high.  The slot is reserved at that point,
+  // which is exact because the request is guaranteed to be sent.
+  val pfReqValid = RegInit(false.B)
+  val pfReqBeat = RegInit(0.U(beatBits.W))
+  val pfReqSlot = RegInit(0.U(log2Ceil(pfSlots).W))
+  val pfReqAddr = Cat(0.U((64 - addrBits).W), pfReqBeat, 0.U(3.W))
+  val pfReqBits = VecInit((0 until pfSlots).map(i =>
+    fetchEdge.Get((i + 1).U(srcBits.W), pfReqAddr(addrBits - 1, 0), lgSize)._2))
+
+  val imemFire = io.imem.d.valid && io.imem.d.ready
+  val imemD = io.imem.d.bits
+  val fetchResp = imemFire && imemD.source === FETCH_SRC
+  val imemFirePrefetch = imemFire && imemD.source =/= FETCH_SRC
+
+  val atDemand = state === sFreq
+  val dataBusy = state === sMreq || state === sMwait
+  // The stream is live when the queue holds a beat or when the core is waiting
+  // for one that is already in flight (`waitBeat`).  In the latter case the
+  // queue is empty but `nextBeatReg` still marks the next beat of the live
+  // stream, so the four slots can be filled ahead instead of stop-and-wait
+  // (m12-020: with `qCount =/= 0` alone the core launched at most one prefetch
+  // before entering `FWAIT`, which is why the extra slots had no effect).
+  val pfStreamLive = qCount =/= 0.U || waitBeat
+  val pfRoom = (qCount +& pfLive) < fetchDepth.U && pfBusy < pfSlots.U
+  // m12-019: a prefetch is only issued when the address is backed by some
+  // manager.  An unroutable request would never be answered (and its source ID
+  // would leak), while the architectural answer for an unroutable *demand*
+  // access is CFXMEM (`sFreq`).
+  private val pfAddrLegal =
+    fetchEdge.manager.supportsGetSafe(pfReqAddr(addrBits - 1, 0), lgSize)
+  val pfWanted = pfStreamLive && pfRoom && !atDemand && !dataBusy && !fifoFlush &&
+    !pfReqValid && pfAddrLegal
+  when(pfWanted) {
+    val freeSlot = PriorityEncoder(pfValid.map(!_))
+    pfReqValid := true.B
+    pfReqBeat := pfBeat
+    pfReqSlot := freeSlot
+    pfValid(freeSlot) := true.B
+    pfBeatV(freeSlot) := pfBeat
+    pfStale(freeSlot) := false.B
+  }
+  when(io.imem.a.fire && !atDemand) { pfReqValid := false.B }
+
+  io.imem.a.valid := (atDemand && fetchLegal) || pfReqValid
+  io.imem.a.bits := Mux(atDemand, fetchBits, pfReqBits(pfReqSlot))
+  io.imem.d.ready := true.B
+
+  // Replies are matched by source ID (slot i owns source i + 1), so the slots do
+  // not depend on the order in which the manager answers.
+  val pfRespSlot = imemD.source - 1.U
+  val pfRespOk = imemFirePrefetch && pfRespSlot < pfSlots.U && pfValid(pfRespSlot)
+  val pfOldBeat = pfBeatV(pfRespSlot)
+  val pfOldStale = pfStale(pfRespSlot)
+
+  when(pfRespOk) { pfValid(pfRespSlot) := false.B }
+  // A flush does *not* release the slots: those requests are already on the bus
+  // and their source IDs stay in use until the replies arrive (reusing a source
+  // ID while a reply is outstanding is a TileLink protocol violation).  They
+  // are marked stale instead, so their replies are dropped rather than queued
+  // for a stream that no longer exists.
+  when(fifoFlush) {
+    for (i <- 0 until pfSlots) { when(pfValid(i)) { pfStale(i) := true.B } }
+  }
+
+  // A prefetch may only enter the queue when it is exactly the beat we expect
+  // next (so a stale or out-of-order reply is dropped, and the demand fetch path
+  // re-fetches it) and when the demand path is not re-filling the queue.
+  val pfPushOk = pfRespOk && !pfOldStale && !fifoFlush && !qFull && !imemD.denied &&
+    state =/= sFreq && (state =/= sFwait || waitBeat)
+  when(pfPushOk && pfOldBeat === nextBeatReg) {
+    fifoPush := true.B
+    pushBeat := pfOldBeat
+    pushData := addressOrder(imemD.data)
+  }
+
+  // m12-020: SRAM round-trip latency of the demand fetch, in cycles.  Latched
+  // when the demand request is accepted and sampled when its reply arrives; the
+  // register keeps the last measurement (also printed below) and is used to
+  // calibrate how many prefetch slots the queue actually needs.
+  val demandSentCycle = RegInit(0.U(64.W))
+  val fetchLatency = RegInit(0.U(64.W))
+  when(atDemand && io.imem.a.fire) { demandSentCycle := cycles }
+  when(fetchResp) { fetchLatency := cycles - demandSentCycle }
+
+  // ---- data port ---------------------------------------------------------
+  val (_, ldBits) = dataEdge.Get(DATA_SRC, memAddr(addrBits - 1, 0), lgSize)
+  val (_, stBits) = dataEdge.Put(DATA_SRC, memAddr(addrBits - 1, 0), lgSize,
+    laneOrder(storeValue))
+  // Safe legality (see the fetch port): every manager is checked, so an
+  // unbacked address is CFXMEM instead of an unsupported bus request.
+  val ldLegal = dataEdge.manager.supportsGetSafe(memAddr(addrBits - 1, 0), lgSize)
+  val stLegal = dataEdge.manager.supportsPutFullSafe(memAddr(addrBits - 1, 0), lgSize)
+
+  io.dmem.a.valid := state === sMreq
+  io.dmem.a.bits := Mux(d.isLd, ldBits, stBits)
+  io.dmem.d.ready := state === sMwait
+
+  // ---- semihosting request (boundary lift, no host call in the core) -----
+  io.semi.req.valid := state === sSemi
+  io.semi.req.op := semiOp
+  io.semi.req.arg := semiArg
+  io.semi.req.ret := semiRetReg
+  io.semi.req.pc := semiPc
+
+  // ---- completion exit (§5.3: ip <- nextIp, then IALIGN, then hit) -------
+  /** Continue at `nextIp` (4-byte aligned): queue hit / wait / re-fetch. */
+  def continueAt(nextIp: UInt): Unit = {
+    val off = nextIp(addrBits - 1, 3) - headBeat
+    when(qCount =/= 0.U && off < qCount) {
+      fifoPop := off(cntBits - 1, 0) // sequential prefetch keeps the rest valid
+      state := sExec
+    }.elsewhen(off < (qCount +& pfLive)) {
+      // The beat is still in the prefetch pipeline: wait for it instead of
+      // throwing the queue away and paying for a demand round trip.  Beats
+      // older than the one we need are dropped, so the arriving prefetches stay
+      // contiguous with the queue head.
+      fifoPop := qCount
+      waitBeat := true.B
+      state := sFwait
+    }.otherwise {
+      fifoFlush := true.B
+      state := sFreq
+    }
+  }
+
+  /**
+    * Synchronous exception entry into the `cfx_hmon` vector (DADAO-12 §5.2):
+    * save the frame (`excp_prev_run_mode`/`excp_cause_ip`/`excp_cause_id`/
+    * `excp_cause_info`), force `hypv` and jump to `excp_vector`.  The vector is
+    * 4-byte aligned (rc10 drops the low two bits), so no further IALIGN is
+    * possible from here.
+    */
+  def enterHmon(causeIpValue: UInt, causeOneHot: UInt, info: UInt): Unit = {
+    printf(p"WumingCore: excp cause=0x${Hexadecimal(causeOneHot)} cause_ip=0x${Hexadecimal(causeIpValue(47, 0))} info=0x${Hexadecimal(info)} vector=0x${Hexadecimal(cfxVector(0)(47, 0))} cycle=${cycles}\n")
+    cfxCauseId(0) := causeOneHot
+    cfxCauseIp(0) := causeIpValue
+    cfxCauseInfo(0) := info
+    cfxPrevMode(0) := runMode
+    // Tiny: cfx_hmon cg3 rc8 (`switch_run_mode`) is fixed at 3, so exception
+    // entry always lands in hypv (spec/Machine-v5 §2).
+    runMode := 3.U
+    ip := cfxVector(0)
+    continueAt(cfxVector(0))
+  }
+
+  def finish(nextIp: UInt): Unit = {
+    ip := nextIp
+    when(nextIp(1, 0) =/= 0.U) {
+      // IALIGN: precise exception, IP stays at the illegal address and
+      // `excp_cause_ip`/`excp_cause_info` carry it (spec/Machine-v5 §4.4).
+      enterHmon(nextIp, (1.U << IALIGN_BIT).pad(64), nextIp)
+    }.otherwise {
+      continueAt(nextIp)
+    }
+  }
+
+  // ---- state machine -----------------------------------------------------
+  switch(state) {
+    is(sIdle) {
+      when(io.bootEnable) {
+        ip := io.resetVector.pad(64)
+        when(io.resetVector.pad(64)(1, 0) =/= 0.U) {
+          // An unaligned reset vector is the same IALIGN as any other fetch.
+          enterHmon(io.resetVector.pad(64), (1.U << IALIGN_BIT).pad(64),
+            io.resetVector.pad(64))
+        }.otherwise {
+          state := sFreq
+        }
+      }
+    }
+    is(sFreq) {
+      waitBeat := false.B
+      when(!fetchLegal) {
+        // No manager backs this address: CFXMEM with the fetch address as
+        // `cause_info` (spec/Machine-v5 §4.4).  The demand request is not
+        // issued (an unroutable TileLink request would never be answered).
+        enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), ip)
+      }.elsewhen(io.imem.a.fire) {
+        demandBeat := ip(addrBits - 1, 3)
+        state := sFwait
+      }
+    }
+    is(sFwait) {
+      when(waitBeat) {
+        when(queueHit) {
+          waitBeat := false.B
+          state := sExec
+        }.elsewhen(pfLive === 0.U && pfBusy === 0.U) {
+          // Nothing left in flight and still not queued (a denied or dropped
+          // prefetch): fall back to a demand fetch, which raises CFXMEM if the
+          // address really is unreachable.
+          waitBeat := false.B
+          fifoFlush := true.B
+          state := sFreq
+        }
+      }.elsewhen(fetchResp) {
+        when(imemD.denied) {
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), ip)
+        }.otherwise {
+          fifoPush := true.B
+          pushBeat := demandBeat
+          pushData := addressOrder(imemD.data)
+          state := sExec
+        }
+      }
+    }
+    is(sExec) {
+      when(!queueHit) {
+        // Row 0 of the §5.3 table: the current beat is not queued, so there is
+        // nothing to decode; re-fetch it instead of executing garbage.
+        fifoFlush := true.B
+        state := sFreq
+      }.elsewhen(execFault) {
+        // ILLI/UNDI: a decode fault is a synchronous exception into the
+        // monitor with the instruction word as `cause_info` (§4.4).  Reserved
+        // cfxha (`trap`/`escape`/`cfx2*`) is ILLI as well, so this check
+        // precedes the CFXREG check.
+        enterHmon(ip,
+          Mux(d.undi, (1.U << UNDI_BIT).pad(64), (1.U << ILLI_BIT).pad(64)),
+          inst.pad(64))
+      }.elsewhen(cfxFault) {
+        // Unsupported cfx register access -> CFXREG to the current monitor
+        // (DADAO-12 §5.2(一)).
+        enterHmon(ip, (1.U << CFXREG_BIT).pad(64), inst.pad(64))
+      }.elsewhen(d.isTrap) {
+        // Every `trap` enters sTrap; the semihosting window (immu18[17:8] ==
+        // 0x3FF) is the one that goes to the host responder, every other
+        // `trap cfx_hmon` is the CFXTRAP handoff (DADAO-12 §5.2).
+        semiOp := inst(7, 0)
+        semiArg := rf.io.r2Data
+        semiPc := ip
+        semiIsHost := d.isSemi
+        state := sTrap
+      }.elsewhen(aluIsSlow) {
+        slowA := srcA
+        slowB := Mux(d.useImmB, d.imm, srcB)
+        slowShamt := Mux(d.shamtFromImm, d.imm(5, 0), srcB(5, 0))
+        slowOp := d.aluOp
+        slowWidth := d.opWidth
+        slowWp := d.wp
+        slowW0En := d.w0En
+        slowW0Idx := d.w0Idx
+        slowW0Rb := d.w0Rb
+        slowW0Sel := d.w0Sel
+        slowW1En := d.w1En
+        slowW1Idx := d.w1Idx
+        slowW1Rb := d.w1Rb
+        state := sSlow
+      }.elsewhen(d.isBr) {
+        // spec/SimRISC-06 §1: target = rb0 + (imms18 << 2), rb0 = current IP.
+        // Codes: 0 = n, 1 = nn, 2 = z, 3 = nz, 4 = p, 5 = np (rd0 reads 0, so
+        // `br.z rd0` is always taken and `br.nz rd0` never).
+        val v = srcA
+        val taken = MuxLookup(d.brCond, false.B)(Seq(
+          0.U -> v(63),
+          1.U -> !v(63),
+          2.U -> (v === 0.U),
+          3.U -> (v =/= 0.U),
+          4.U -> (v =/= 0.U && !v(63)),
+          5.U -> (v === 0.U || v(63))))
+        finish(Mux(taken, (ip + d.brOff)(63, 0), ip + 4.U))
+      }.elsewhen(d.isEscape) {
+        // DADAO-12 §5.3: cfxha must be the current cfx (hmon after the
+        // handoff) and the frame must be valid; otherwise CFXESC enters the
+        // current cfx without switching anything.
+        when(d.cfxHa =/= C_HMON || !cfxHasFrame) {
+          enterHmon(ip, (1.U << CFXESC_BIT).pad(64), inst.pad(64))
+        }.otherwise {
+          // The target/return cfx is always the current cfx, so the hmon frame
+          // is the one `escape` restores (`excp_prev_run_mode`, DADAO-12 §5.3).
+          runMode := cfxPrevMode(0)
+          finish((cfxCauseIp(0) + d.escOff)(63, 0))
+        }
+      }.elsewhen(d.isCfx2) {
+        // cfx2rd writes rd through the normal write-back path (the decoder
+        // sets w0En); cfx2rc is committed by `cfxWriteEn` below.
+        finish(ip + 4.U)
+      }.elsewhen(d.isLd || d.isSt) {
+        when(memAddr(2, 0) =/= 0.U) {
+          // MALIGN: detected after address generation and before the access;
+          // `cause_info` is the access address (spec/Machine-v5 §4.4).
+          enterHmon(ip, (1.U << MALIGN_BIT).pad(64), memAddr)
+        }.elsewhen(!Mux(d.isLd, ldLegal, stLegal)) {
+          // CFXMEM: no manager backs the access address (§4.4).
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), memAddr)
+        }.otherwise {
+          state := sMreq
+        }
+      }.otherwise {
+        finish(Mux(d.isJump, jumpTarget, ip + 4.U))
+      }
+    }
+    is(sTrap) {
+      // §5.3 TRAP row: the semihosting window goes to SEMI; `trap cfx_hmon`
+      // outside it is the CFXTRAP handoff into the hmon vector (m12-007).
+      // The four synchronous source masks do not gate synchronous exceptions
+      // (DADAO-12 §5.2(二)) and the only trap source on Tiny is the current
+      // cfx (bit ignored), so entry is allowed here.
+      when(semiIsHost) {
+        state := sSemi
+      }.elsewhen(d.cfxHa === C_HMON) {
+        enterHmon(ip, (1.U << CFXTRAP_BIT).pad(64), inst.pad(64))
+      }.otherwise {
+        // `trap` to a cfx other than hmon: Tiny routes non-semihosting traps to
+        // cfx_hmon only (spec/Machine-v5 §4.1); every other target is ILLI.
+        enterHmon(ip, (1.U << ILLI_BIT).pad(64), inst.pad(64))
+      }
+    }
+    is(sSemi) {
+      when(io.semi.resp.valid) {
+        finish(ip + 4.U)
+      }
+    }
+    is(sExc) {
+      // m12-019: every synchronous fault enters the hmon vector from the
+      // detecting state, so this sink is defensive only (a core invariant
+      // violation, not a guest fault) and ends in `HALT`.
+      state := sFault
+    }
+    is(sMreq) {
+      when(io.dmem.a.ready) { state := sMwait }
+    }
+    is(sMwait) {
+      when(io.dmem.d.fire) {
+        when(io.dmem.d.bits.denied) {
+          // The address is mapped but the manager denies the operation (e.g. a
+          // store into the read-only BootROM): CFXMEM with the address.
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), memAddr)
+        }.otherwise {
+          finish(ip + 4.U)
+        }
+      }
+    }
+    is(sSlow) {
+      finish(ip + 4.U)
+    }
+    is(sFault) {
+      state := sHalt
+    }
+    is(sHalt) { }
+  }
+
+  // ---- queue update (single writer for head/count/entries) ---------------
+  when(fifoFlush) {
+    qCount := 0.U
+  }.otherwise {
+    qCount := qCount - fifoPop + fifoPush.asUInt
+  }
+  qHead := qHead + fifoPop(ptrBits - 1, 0)
+  when(fifoPush && !fifoFlush) {
+    val tail = (qHead + qCount)(ptrBits - 1, 0)
+    qBeat(tail) := pushBeat
+    qData(tail) := pushData
+    nextBeatReg := pushBeat + 1.U
+  }
+  // A demand fetch re-bases the stream on the current instruction's beat.
+  when(state === sFreq && io.imem.a.fire) { nextBeatReg := ip(addrBits - 1, 3) }
+
+  // ---- legality assertions ------------------------------------------------
+  // m12-019: an address that no manager backs is CFXMEM (`sFreq`/`sExec`), so
+  // only a routable demand fetch ever reaches the A channel and only a
+  // routable load/store ever reaches `sMreq`.
+  assert(!(state === sMreq) || Mux(d.isLd, ldLegal, stLegal),
+    "WumingCore: load/store address is not backed by a capable manager")
+
+  // ---- cfx register writes (m12-019) --------------------------------------
+  // rc10 drops the low 2 bits on write (DADAO-13 §1); switch_run_mode accepts
+  // and ignores the write (Tiny keeps hypv, the saved value stays 3).
+  val cfxWriteEn = state === sExec && d.isCfx2 && d.cfxWrite && cfxRegOk
+  when(cfxWriteEn) {
+    when(isMask) {
+      switch(d.cfxRc) {
+        is(0.U) { cfxTrapMask(monIdx) := srcA }
+        is(1.U) { cfxMemMask(monIdx) := srcA }
+        is(2.U) { cfxRegMask(monIdx) := srcA }
+        is(3.U) { cfxExeMask(monIdx) := srcA }
+        is(4.U) { cfxIntrMask(monIdx) := srcA }
+      }
+    }.elsewhen(isVector) {
+      cfxVector(monIdx) := Cat(srcA(63, 2), 0.U(2.W))
+    }.elsewhen(isPrevMode) {
+      cfxPrevMode(monIdx) := srcA(1, 0)
+    }.elsewhen(isCauseIp) {
+      cfxCauseIp(monIdx) := srcA
+    }
+  }
+
+  // ---- observability ------------------------------------------------------
+  when(state === sIdle && io.bootEnable) {
+    printf(p"WumingCore: boot hartid=${io.hartid} reset_vector=0x${Hexadecimal(io.resetVector)} cycle=${cycles}\n")
+  }
+  when(pfReqValid && io.imem.a.fire) {
+    printf(p"WumingCore: prefetch 0x${Hexadecimal(pfReqAddr)} count=${qCount} live=${pfLive} busy=${pfBusy} lat=${fetchLatency} cycle=${cycles}\n")
+  }
+  when(state === sFreq && io.imem.a.fire) {
+    printf(p"WumingCore: fetch 0x${Hexadecimal(fetchAddr)} cycle=${cycles}\n")
+  }
+  when(fetchResp) {
+    printf(p"WumingCore: fetchresp 0x${Hexadecimal(Cat(demandBeat, 0.U(3.W)))} latency=${cycles - demandSentCycle} cycle=${cycles}\n")
+  }
+  when(state === sExec && queueHit) {
+    printf(p"WumingCore: exec ip=0x${Hexadecimal(ip(47, 0))} inst=0x${Hexadecimal(inst)} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isSemi) {
+    printf(p"WumingCore: semihost ip=0x${Hexadecimal(ip(47, 0))} op=0x${Hexadecimal(inst(7, 0))} arg=0x${Hexadecimal(rf.io.r2Data)} ret=rd${semiRetReg} cycle=${cycles}\n")
+  }
+  when(state === sSemi && io.semi.resp.valid) {
+    printf(p"WumingCore: semihost 0x${Hexadecimal(semiOp)} -> rd${semiRetReg}=0x${Hexadecimal(io.semi.resp.value)} cycle=${cycles}\n")
+  }
+  when(state === sMwait && io.dmem.d.fire && d.isSt) {
+    printf(p"WumingCore: st 0x${Hexadecimal(memAddr(47, 0))} <= 0x${Hexadecimal(storeValue)} ok cycle=${cycles}\n")
+  }
+  when(state === sMwait && io.dmem.d.fire && d.isLd) {
+    printf(p"WumingCore: ld 0x${Hexadecimal(memAddr(47, 0))} -> 0x${Hexadecimal(ldData)} ok cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isBr) {
+    printf(p"WumingCore: br ip=0x${Hexadecimal(ip(47, 0))} cond=${d.brCond} off=${d.brOff} cycle=${cycles}\n")
+  }
+  when(state === sTrap && !semiIsHost) {
+    printf(p"WumingCore: cfxtrap ip=0x${Hexadecimal(ip(47, 0))} magic=0x${Hexadecimal(inst(17, 0))} vector=0x${Hexadecimal(cfxVector(0)(47, 0))} cycle=${cycles}\n")
+  }
+  // `mode` is the run mode the instruction executes in (before `escape`
+  // restores `excp_prev_run_mode`); `wdata` is the value a cfx2rc write puts
+  // on the register, `data` the value a read returns.  Faulting escape/cfx2
+  // instructions do not execute, so they print nothing.
+  when(state === sExec && d.isEscape && !execFault) {
+    printf(p"WumingCore: escape ip=0x${Hexadecimal(ip(47, 0))} frame=0x${Hexadecimal(cfxCauseId(0))} cause_ip=0x${Hexadecimal(cfxCauseIp(0)(47, 0))} target=0x${Hexadecimal((cfxCauseIp(0) + d.escOff)(47, 0))} mode=${runMode} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isCfx2 && !execFault) {
+    printf(p"WumingCore: cfx2 ip=0x${Hexadecimal(ip(47, 0))} ha=${d.cfxHa} cg=${d.cfxCg} rc=${d.cfxRc} write=${d.cfxWrite} ok=${cfxRegOk} mode=${runMode} data=0x${Hexadecimal(cfxRdata)} wdata=0x${Hexadecimal(srcA)} cycle=${cycles}\n")
+  }
+  val faultPrinted = RegInit(false.B)
+  when(state === sFault && !faultPrinted) {
+    // Defensive: no synchronous fault reaches `FAULT` after m12-019.
+    faultPrinted := true.B
+    printf(p"WumingCore: fault ip=0x${Hexadecimal(ip(47, 0))} inst=0x${Hexadecimal(inst)} cycle=${cycles}\n")
+  }
+
+  io.halted := state === sHalt
+}
