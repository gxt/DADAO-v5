+      // throwing the queue away and paying for a demand round trip.  Beats
+      // older than the one we need are dropped, so the arriving prefetches stay
+      // contiguous with the queue head.
+      fifoPop := qCount
+      waitBeat := true.B
+      state := sFwait
+    }.otherwise {
+      fifoFlush := true.B
+      state := sFreq
+    }
+  }
+
+  /**
+    * Synchronous exception entry into the `cfx_hmon` vector (DADAO-12 §5.2):
+    * save the frame, force `hypv` and jump to `excp_vector`.  The vector is
+    * 4-byte aligned (rc10 drops the low two bits), so no further IALIGN is
+    * possible from here.
+    */
+  def enterHmon(causeIpValue: UInt, causeOneHot: UInt, info: UInt): Unit = {
+    printf(p"WumingCore: excp cause=0x${Hexadecimal(causeOneHot)} cause_ip=0x${Hexadecimal(causeIpValue(47, 0))} info=0x${Hexadecimal(info)} vector=0x${Hexadecimal(cfxVector(0)(47, 0))} cycle=${cycles}\n")
+    cfxCauseId(0) := causeOneHot
+    cfxCauseIp(0) := causeIpValue
+    cfxCauseInfo(0) := info
+    cfxPrevMode(0) := runMode
+    runMode := 3.U
+    // Any exception entry clears the reservation (spec/SimRISC-12 §1.1): an
+    // `sc` after an exception handler must fail.
+    resvValid := false.B
+    ip := cfxVector(0)
+    continueAt(cfxVector(0))
+  }
+
+  def finish(nextIp: UInt): Unit = {
+    ip := nextIp
+    when(nextIp(1, 0) =/= 0.U) {
+      // IALIGN: precise exception, IP stays at the illegal address and
+      // `excp_cause_ip`/`excp_cause_info` carry it (spec/Machine-v5 §4.4).
+      enterHmon(nextIp, (1.U << IALIGN_BIT).pad(64), nextIp)
+    }.otherwise {
+      continueAt(nextIp)
+    }
+  }
+
+  // ---- state machine -----------------------------------------------------
+  switch(state) {
+    is(sIdle) {
+      when(io.bootEnable) {
+        ip := io.resetVector.pad(64)
+        when(io.resetVector.pad(64)(1, 0) =/= 0.U) {
+          // An unaligned reset vector is the same IALIGN as any other fetch.
+          enterHmon(io.resetVector.pad(64), (1.U << IALIGN_BIT).pad(64),
+            io.resetVector.pad(64))
+        }.otherwise {
+          state := sFreq
+        }
+      }
+    }
+    is(sFreq) {
+      waitBeat := false.B
+      when(!fetchLegal) {
+        // No manager backs this address: CFXMEM with the fetch address as
+        // `cause_info` (spec/Machine-v5 §4.4).
+        enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), ip)
+      }.elsewhen(io.imem.a.fire) {
+        demandBeat := ip(addrBits - 1, 3)
+        state := sFwait
+      }
+    }
+    is(sFwait) {
+      when(waitBeat) {
+        when(queueHit) {
+          waitBeat := false.B
+          state := sExec
+        }.elsewhen(pfLive === 0.U && pfBusy === 0.U) {
+          // Nothing left in flight and still not queued (a denied or dropped
+          // prefetch): fall back to a demand fetch, which raises CFXMEM if the
+          // address really is unreachable.
+          waitBeat := false.B
+          fifoFlush := true.B
+          state := sFreq
+        }
+      }.elsewhen(fetchResp) {
+        when(imemD.denied) {
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), ip)
+        }.otherwise {
+          fifoPush := true.B
+          pushBeat := demandBeat
+          pushData := addressOrder(imemD.data)
+          state := sExec
+        }
+      }
+    }
+    is(sExec) {
+      when(!queueHit) {
+        // Row 0 of the §5.3 table: the current beat is not queued, so there is
+        // nothing to decode; re-fetch it instead of executing garbage.
+        fifoFlush := true.B
+        state := sFreq
+      }.elsewhen(execFault) {
+        // ILLI/UNDI: a decode fault is a synchronous exception into the
+        // monitor with the instruction word as `cause_info` (§4.4).
+        enterHmon(ip,
+          Mux(d.undi, (1.U << UNDI_BIT).pad(64), (1.U << ILLI_BIT).pad(64)),
+          inst.pad(64))
+      }.elsewhen(cfxFault) {
+        // Unsupported cfx register access -> CFXREG to the current monitor
+        // (DADAO-12 §5.2(一)).
+        enterHmon(ip, (1.U << CFXREG_BIT).pad(64), inst.pad(64))
+      }.elsewhen(d.isTrap) {
+        // Every `trap` enters sTrap; the semihosting window (immu18[17:8] ==
+        // 0x3FF) is the one that goes to the host responder, every other
+        // `trap cfx_hmon` is the CFXTRAP handoff (DADAO-12 §5.2).
+        semiOp := inst(7, 0)
+        semiArg := rf.io.r2Data
+        semiPc := ip
+        semiIsHost := d.isSemi
+        state := sTrap
+      }.elsewhen(aluIsSlow) {
+        slowA := srcA
+        slowB := Mux(d.useImmB, d.imm, srcB)
+        slowShamt := Mux(d.shamtFromImm, d.imm(5, 0), srcB(5, 0))
+        slowOp := d.aluOp
+        slowWidth := d.opWidth
+        slowWp := d.wp
+        slowW0En := d.w0En
+        slowW0Idx := d.w0Idx
+        slowW0Bank := d.w0Bank
+        slowW0Sel := d.w0Sel
+        slowW1En := d.w1En
+        slowW1Idx := d.w1Idx
+        slowW1Bank := d.w1Bank
+        state := sSlow
+      }.elsewhen(d.isCall) {
+        // Push the return address (ip + 4) and jump to the call target
+        // (spec/SimRISC-06 §3, spec/SimRISC-00 §2.4.1).
+        when(callRasOf) {
+          // C3b with MRPTR == 0: no MemRAS to spill into (precise: no push).
+          enterHmon(ip, (1.U << RASOF_BIT).pad(64), callRetAddr.pad(64))
+        }.elsewhen(callNeedsSpill) {
+          when(!callSpillLegal) {
+            // C3b spill target is not backed: precise CFXMEM, no push.
+            enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), (mrptr - 8.U).pad(64))
+          }.otherwise {
+            // C3b: write the oldest RegRAS entry to MemRAS[MRPTR - 8] first;
+            // the shift-push is committed when the store is accepted.
+            memStore := true.B
+            memMulti := false.B
+            memWidthLat := 3.U
+            memSignedLat := false.B
+            memBase := (mrptr - 8.U).pad(64)
+            memCount := 1.U
+            memBank := WumingBank.RD
+            memStart := 0.U
+            memElem := 0.U
+            memBeat := spillBeat
+            memData := rf.io.rasOldest
+            memMask := "hff".U(8.W)
+            memPacked := true.B
+            memBeatValid := false.B
+            rasMemKind := 1.U
+            memAux := 0.U
+            rasNextIp := jumpTarget
+            state := sMreq
+          }
+        }.otherwise {
+          rasOp := Mux(callFold, WumingRasOp.FOLD, WumingRasOp.PUSH)
+          rasPushAddr := callRetAddr
+          finish(jumpTarget)
+        }
+      }.elsewhen(d.isRet) {
+        // Pop the RAS (spec/SimRISC-06 §4, spec/SimRISC-00 §2.4.2).
+        when(retRasUf) {
+          // D1 (count == 0) or D4a (cold stack): precise RASUF.
+          enterHmon(ip, (1.U << RASUF_BIT).pad(64), 0.U)
+        }.elsewhen(retDec) {
+          // D2: recursive count > 1, the address stays on the stack.
+          rasOp := WumingRasOp.DEC
+          finish(topAddr.pad(64))
+        }.elsewhen(retPop) {
+          // D3: count == 1, the entry is popped.
+          rasOp := WumingRasOp.POP
+          finish(topAddr.pad(64))
+        }.otherwise {
+          // D4b: RACNT == 0 and MemRAS enabled — read the entry at MRPTR first
+          // (the RASUF/consume/refill decision is taken when it arrives).
+          when(!retMemLegal) {
+            enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), mrptr.pad(64))
+          }.otherwise {
+            memStore := false.B
+            memMulti := false.B
+            memWidthLat := 3.U
+            memSignedLat := false.B
+            memBase := mrptr.pad(64)
+            memCount := 1.U
+            memBank := WumingBank.RD
+            memStart := 0.U
+            memElem := 0.U
+            memBeat := retMemBeat
+            memData := 0.U
+            memMask := 0.U
+            memPacked := true.B
+            memBeatValid := false.B
+            rasMemKind := 2.U
+            memAux := 0.U
+            retRdIdx := d.w0Idx
+            retRdVal := d.imm
+            state := sMreq
+          }
+        }
+      }.elsewhen(d.isBr) {
+        // spec/SimRISC-06 §1: target = rb0 + (imms18 << 2), rb0 = current IP.
+        // Codes: 0 = n, 1 = nn, 2 = z, 3 = nz, 4 = p, 5 = np (rd0 reads 0, so
+        // `br.z rd0` is always taken and `br.nz rd0` never).
+        val v = srcA
+        val taken = MuxLookup(d.brCond, false.B)(Seq(
+          0.U -> v(63),
+          1.U -> !v(63),
+          2.U -> (v === 0.U),
+          3.U -> (v =/= 0.U),
+          4.U -> (v =/= 0.U && !v(63)),
+          5.U -> (v === 0.U || v(63)),
+          6.U -> (v === srcB),        // br.eq
+          7.U -> (v =/= srcB)))       // br.ne
+        finish(Mux(taken, (ip + d.brOff)(63, 0), ip + 4.U))
+      }.elsewhen(d.isEscape) {
+        // DADAO-12 §5.3: cfxha must be the current cfx (hmon after the
+        // handoff) and the frame must be valid; otherwise CFXESC enters the
+        // current cfx without switching anything.
+        when(d.cfxHa =/= C_HMON || !cfxHasFrame) {
+          enterHmon(ip, (1.U << CFXESC_BIT).pad(64), inst.pad(64))
+        }.otherwise {
+          runMode := cfxPrevMode(0)
+          finish((cfxCauseIp(0) + d.escOff)(63, 0))
+        }
+      }.elsewhen(d.isCfx2) {
+        // cfx2rd writes rd through the normal write-back path (the decoder
+        // sets w0En); cfx2rc is committed by `cfxWriteEn` below.
+        finish(ip + 4.U)
+      }.elsewhen(d.isLr || d.isSc) {
+        when(lrscAlignFail) {
+          // Natural alignment by access width, checked before any access
+          // (spec/SimRISC-12 §1.1: .b=1 / .w=2 / .t=4 / .o=8).
+          enterHmon(ip, (1.U << MALIGN_BIT).pad(64), lrscAddr)
+        }.elsewhen(d.isLr && !lrscGetLegal) {
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), lrscAddr)
+        }.elsewhen(d.isSc && scFailNow) {
+          // Reservation miss: rdHB = 1, no memory access, and the reservation
+          // is consumed either way (spec/SimRISC-12 §1.1).  The rd write is
+          // the `scFailExec` write-back path.
+          resvValid := false.B
+          finish(ip + 4.U)
+        }.elsewhen(d.isSc && scMemFail) {
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), lrscAddr)
+        }.otherwise {
+          memStore := false.B
+          memMulti := false.B
+          memWidthLat := d.memWidth
+          memSignedLat := false.B // `lr` zero-extends the loaded window
+          memBase := lrscAddr
+          memCount := 1.U
+          memBank := WumingBank.RD
+          // `lr` writes rdHC; `sc`'s store value also comes from rdHC (the
+          // decoder puts it on the B operand index).
+          memStart := Mux(d.isLr, d.ldDst, d.srcBIdx)
+          memElem := 0.U
+          memBeat := beatOf(lrscAddr)
+          memData := 0.U
+          memMask := 0.U
+          memPacked := true.B
+          memBeatValid := false.B
+          rasMemKind := 0.U
+          // 1 = lr load, 2 = sc reservation check (load first).
+          memAux := Mux(d.isLr, 1.U, 2.U)
+          state := sMreq
+        }
+      }.elsewhen(d.isCopy) {
+        // Register-block copy (spec/SimRISC-02 §1): one register per cycle.
+        // The decoder already rejected dst_rd0/dst_rb0, mreg_zero, range
+        // overflow and same-bank overlap, so nothing can fault here.
+        copyDstStart := d.w0Idx
+        copySrcStart := d.srcAIdx
+        copyCount := d.imm(5, 0)
+        copyIdx := 0.U
+        copyDstBankL := d.copyDstBank
+        copySrcBankL := d.copySrcBank
+        state := sCopy
+      }.elsewhen(d.isLd || d.isSt || d.isLdm || d.isStm) {
+        when(memAlignFail) {
+          // MALIGN: address generated and checked before any bus request;
+          // `cause_info` is the access address (spec/Machine-v5 §4.4).
+          enterHmon(ip, (1.U << MALIGN_BIT).pad(64), memAddrNow)
+        }.elsewhen(!memRangeLegalNow) {
+          // CFXMEM: no manager backs the access (whole `ldm`/`stm` range is
+          // checked here, before the first beat, so the fault is precise).
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), memAddrNow)
+        }.otherwise {
+          memStore := d.isSt || d.isStm
+          memMulti := isMulti
+          memWidthLat := d.memWidth
+          memSignedLat := d.memSigned
+          memBase := memAddrNow
+          memCount := memCountNow
+          memBank := Mux(isMulti, d.mregBank, Mux(d.isLd, d.ldBank, d.stBank))
+          memStart := Mux(isMulti, d.mregStart, d.ldDst)
+          memElem := 0.U
+          memBeat := beatOf(memAddrNow)
+          memData := 0.U
+          memMask := 0.U
+          memPacked := !(d.isSt || d.isStm)
+          memBeatValid := false.B
+          rasMemKind := 0.U
+          memAux := 0.U
+          state := sMreq
+        }
+      }.otherwise {
+        finish(Mux(d.isJump, jumpTarget, ip + 4.U))
+      }
+    }
+    is(sTrap) {
+      // §5.3 TRAP row: the semihosting window goes to SEMI; `trap cfx_hmon`
+      // outside it is the CFXTRAP handoff into the hmon vector (m12-007).
+      when(semiIsHost) {
+        state := sSemi
+      }.elsewhen(d.cfxHa === C_HMON) {
+        enterHmon(ip, (1.U << CFXTRAP_BIT).pad(64), inst.pad(64))
+      }.otherwise {
+        // `trap` to a cfx other than hmon: Tiny routes non-semihosting traps to
+        // cfx_hmon only (spec/Machine-v5 §4.1); every other target is ILLI.
+        enterHmon(ip, (1.U << ILLI_BIT).pad(64), inst.pad(64))
+      }
+    }
+    is(sSemi) {
+      when(io.semi.resp.valid) {
+        finish(ip + 4.U)
+      }
+    }
+    is(sExc) {
+      // m12-019: every synchronous fault enters the hmon vector from the
+      // detecting state, so this sink is defensive only.
+      state := sFault
+    }
+    is(sMreq) {
+      when(memStore && rasMemKind === 0.U) {
+        when(!memPacked) {
+          when(memElemInBeat) {
+            // Pack one element of this beat: place the source register's
+            // low bytes at the element's address offset (big-endian within
+            // the 8-byte beat) and enable exactly those byte lanes.
+            val elem = rf.io.r2Data & memElemValueMask
+            memData := memData | (elem << memElemShift)(63, 0)
+            memMask := memMask | memElemMask
+            memElem := memElem + 1.U
+          }.otherwise {
+            memPacked := true.B
+          }
+        }.elsewhen(io.dmem.a.ready) {
+          state := sMwait
+        }
+      }.elsewhen(io.dmem.a.ready) {
+        state := sMwait
+      }
+    }
+    is(sMwait) {
+      when(io.dmem.d.fire) {
+        when(io.dmem.d.bits.denied || io.dmem.d.bits.corrupt) {
+          // The address passed the EXEC precheck but the manager still denies
+          // (or corrupts) the transfer.  A failure in the middle of an
+          // `ldm`/`stm` cannot be made precise, so it is reported as CFXMEM
+          // (task baseline R7); the monitor may re-enter the whole
+          // instruction.  `corrupt` is the same architectural outcome
+          // (design note §3.3: denied/corrupt are one CFXMEM fallback).  The
+          // same holds for a MemRAS access: the RAS state is untouched.
+          enterHmon(ip, (1.U << CFXMEM_BIT).pad(64), memBeat)
+        }.elsewhen(rasMemKind === 1.U) {
+          // C3b spill accepted: commit MRPTR -= 8 and the shift-push.
+          rasOp := WumingRasOp.SPILL
+          rasPushAddr := callRetAddr
+          finish(rasNextIp)
+        }.elsewhen(rasMemKind === 2.U) {
+          // D4b: the entry decides between RASUF, consume (count 1) and
+          // refill (count > 1).  `MRPTR` is only advanced on success.
+          val entry = addressOrder(io.dmem.d.bits.data)
+          when(entry(63, 48) === 0.U) {
+            enterHmon(ip, (1.U << RASUF_BIT).pad(64), 0.U)
+          }.elsewhen(entry(63, 48) === 1.U) {
+            rasOp := WumingRasOp.CONSUME
+            finish(entry(47, 0).pad(64))
+          }.otherwise {
+            rasOp := WumingRasOp.REFILL
+            rasPushCount := entry(63, 48) - 1.U
+            rasMemAddr := entry(47, 0)
+            finish(entry(47, 0).pad(64))
+          }
+        }.elsewhen(memAux === 2.U) {
+          // `sc` reservation check: the word must still hold the value `lr`
+          // read (a changed word means another store landed in between, which
+          // is a legal spurious failure, spec/SimRISC-12 §1.1).
+          when(addressOrder(io.dmem.d.bits.data) === resvWord) {
+            // Hold the value: pack and write it, one width-sized byte mask.
+            memStore := true.B
+            memMulti := false.B
+            memPacked := false.B
+            memData := 0.U
+            memMask := 0.U
+            memElem := 0.U
+            memBeatValid := false.B
+            memAux := 3.U
+            state := sMreq
+          }.otherwise {
+            resvValid := false.B
+            finish(ip + 4.U)
+          }
+        }.elsewhen(memStore) {
+          when(memElem === memCount) {
+            when(memAux === 3.U) { resvValid := false.B }
+            finish(ip + 4.U)
+          }.otherwise {
+            memBeat := memBeat + 8.U
+            memData := 0.U
+            memMask := 0.U
+            memPacked := false.B
+            state := sMreq
+          }
+        }.otherwise {
+          memData := addressOrder(io.dmem.d.bits.data)
+          memBeatValid := true.B
+        }
+      }
+      when(rasMemKind === 0.U && !memStore && memBeatValid) {
+        when(memElemInBeat) {
+          memElem := memElem + 1.U
+          when(memElem + 1.U === memCount) {
+            // `lr`: the reservation is taken on the successfully read value.
+            when(memAux === 1.U) {
+              resvValid := true.B
+              resvAddr := memBase(47, 0)
+              resvWidth := memWidthLat
+              resvWord := memData
+            }
+            finish(ip + 4.U)
+          }
+        }.otherwise {
+          memBeatValid := false.B
+          memBeat := memBeat + 8.U
+          state := sMreq
+        }
+      }
+    }
+    is(sSlow) {
+      finish(ip + 4.U)
+    }
+    is(sCopy) {
+      // One register per cycle: the source is read on the r0 port and written
+      // through w0 in the same cycle (spec/SimRISC-02 §1).  Same-bank overlap
+      // was rejected by the decoder, so source and destination never alias.
+      copyIdx := copyIdx + 1.U
+      when(copyIdx + 1.U === copyCount) { finish(ip + 4.U) }
+    }
+    is(sFault) {
+      state := sHalt
+    }
+    is(sHalt) { }
+  }
+
+  // ---- queue update (single writer for head/count/entries) ---------------
+  when(fifoFlush) {
+    qCount := 0.U
+  }.otherwise {
+    qCount := qCount - fifoPop + fifoPush.asUInt
+  }
+  qHead := qHead + fifoPop(ptrBits - 1, 0)
+  when(fifoPush && !fifoFlush) {
+    val tail = (qHead + qCount)(ptrBits - 1, 0)
+    qBeat(tail) := pushBeat
+    qData(tail) := pushData
+    nextBeatReg := pushBeat + 1.U
+  }
+  // A demand fetch re-bases the stream on the current instruction's beat.
+  when(state === sFreq && io.imem.a.fire) { nextBeatReg := ip(addrBits - 1, 3) }
+
+  // ---- legality assertions ------------------------------------------------
+  // Only a backed beat ever reaches the data A channel: the EXEC precheck
+  // covers the whole transfer, so this is the belt-and-braces form.
+  assert(!(state === sMreq) ||
+    Mux(memStore, dataPutLegal(memBeat), dataGetLegal(memBeat)),
+    "WumingCore: load/store beat is not backed by a capable manager")
+
+  // ---- cfx register writes (m12-019) --------------------------------------
+  val cfxWriteEn = state === sExec && d.isCfx2 && d.cfxWrite && cfxRegOk
+  when(cfxWriteEn) {
+    when(isMask) {
+      switch(d.cfxRc) {
+        is(0.U) { cfxTrapMask(monIdx) := srcA }
+        is(1.U) { cfxMemMask(monIdx) := srcA }
+        is(2.U) { cfxRegMask(monIdx) := srcA }
+        is(3.U) { cfxExeMask(monIdx) := srcA }
+        is(4.U) { cfxIntrMask(monIdx) := srcA }
+      }
+    }.elsewhen(isVector) {
+      cfxVector(monIdx) := Cat(srcA(63, 2), 0.U(2.W))
+    }.elsewhen(isPrevMode) {
+      cfxPrevMode(monIdx) := srcA(1, 0)
+    }.elsewhen(isCauseIp) {
+      cfxCauseIp(monIdx) := srcA
+    }
+  }
+
+  // ---- observability ------------------------------------------------------
+  when(state === sIdle && io.bootEnable) {
+    printf(p"WumingCore: boot hartid=${io.hartid} reset_vector=0x${Hexadecimal(io.resetVector)} cycle=${cycles}\n")
+  }
+  when(pfReqValid && io.imem.a.fire) {
+    printf(p"WumingCore: prefetch 0x${Hexadecimal(pfReqAddr)} count=${qCount} live=${pfLive} busy=${pfBusy} lat=${fetchLatency} cycle=${cycles}\n")
+  }
+  when(state === sFreq && io.imem.a.fire) {
+    printf(p"WumingCore: fetch 0x${Hexadecimal(fetchAddr)} cycle=${cycles}\n")
+  }
+  when(fetchResp) {
+    printf(p"WumingCore: fetchresp 0x${Hexadecimal(Cat(demandBeat, 0.U(3.W)))} latency=${cycles - demandSentCycle} cycle=${cycles}\n")
+  }
+  when(state === sExec && queueHit) {
+    printf(p"WumingCore: exec ip=0x${Hexadecimal(ip(47, 0))} inst=0x${Hexadecimal(inst)} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isSemi) {
+    printf(p"WumingCore: semihost ip=0x${Hexadecimal(ip(47, 0))} op=0x${Hexadecimal(inst(7, 0))} arg=0x${Hexadecimal(rf.io.r2Data)} ret=rd${semiRetReg} cycle=${cycles}\n")
+  }
+  when(state === sSemi && io.semi.resp.valid) {
+    printf(p"WumingCore: semihost 0x${Hexadecimal(semiOp)} -> rd${semiRetReg}=0x${Hexadecimal(io.semi.resp.value)} cycle=${cycles}\n")
+  }
+  when(state === sExec && (d.isLd || d.isSt || d.isLdm || d.isStm) &&
+    !execFault && !cfxFault && !memAlignFail && memRangeLegalNow) {
+    // Kind: 0 = ld, 1 = st, 2 = ldm, 3 = stm.  `count` is the element count
+    // (1 for single ld/st) and `width` the log2 of the access size.
+    val kind = Mux(d.isSt, 1.U, Mux(d.isLdm, 2.U, Mux(d.isStm, 3.U, 0.U)))
+    printf(p"WumingCore: memop ip=0x${Hexadecimal(ip(47, 0))} kind=${kind} addr=0x${Hexadecimal(memAddrNow(47, 0))} width=${d.memWidth} count=${memCountNow} cycle=${cycles}\n")
+  }
+  when(state === sMwait && io.dmem.d.fire && memStore) {
+    printf(p"WumingCore: beat st 0x${Hexadecimal(memBeat(47, 0))} mask=0x${Hexadecimal(memMask)} data=0x${Hexadecimal(memData)} cycle=${cycles}\n")
+  }
+  when(state === sMwait && io.dmem.d.fire && !memStore) {
+    printf(p"WumingCore: beat ld 0x${Hexadecimal(memBeat(47, 0))} -> 0x${Hexadecimal(addressOrder(io.dmem.d.bits.data))} cycle=${cycles}\n")
+  }
+  when(memElemWrite && memElem + 1.U === memCount) {
+    printf(p"WumingCore: ld 0x${Hexadecimal(memElemAddr(47, 0))} -> 0x${Hexadecimal(memLdElem)} last count=${memCount} cycle=${cycles}\n")
+  }
+  when(memStore && state === sMwait && io.dmem.d.fire && memElem === memCount) {
+    printf(p"WumingCore: st... done beat=0x${Hexadecimal(memBeat(47, 0))} count=${memCount} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isBr) {
+    printf(p"WumingCore: br ip=0x${Hexadecimal(ip(47, 0))} cond=${d.brCond} off=${d.brOff} cycle=${cycles}\n")
+  }
+  // m12-010 traces: atomics, barrier/no-op, conditional assign, block copy.
+  when(state === sExec && (d.isLr || d.isSc) && !execFault && !cfxFault) {
+    printf(p"WumingCore: atomic ip=0x${Hexadecimal(ip(47, 0))} lr=${d.isLr} sc=${d.isSc} width=${d.memWidth} addr=0x${Hexadecimal(lrscAddr(47, 0))} resv=${resvValid} resvaddr=0x${Hexadecimal(resvAddr)} hit=${scHit} align=${lrscAlignFail} cycle=${cycles}\n")
+  }
+  when(scCheckFail) {
+    printf(p"WumingCore: atomic sc-fail ip=0x${Hexadecimal(ip(47, 0))} reason=word-changed cycle=${cycles}\n")
+  }
+  when(scStoreDone) {
+    printf(p"WumingCore: atomic sc-ok ip=0x${Hexadecimal(ip(47, 0))} addr=0x${Hexadecimal(resvAddr)} width=${resvWidth} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isFence && !execFault) {
+    printf(p"WumingCore: fence ip=0x${Hexadecimal(ip(47, 0))} cfxha=${d.cfxHa} imm=0x${Hexadecimal(inst(17, 0))} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isSwym && !execFault) {
+    printf(p"WumingCore: swym ip=0x${Hexadecimal(ip(47, 0))} imm=0x${Hexadecimal(inst(17, 0))} cycle=${cycles}\n")
+  }
+  when(state === sCopy) {
+    printf(p"WumingCore: copy ip=0x${Hexadecimal(ip(47, 0))} dstbank=${copyDstBankL} dst=${(copyDstStart + copyIdx)(5, 0)} srcbank=${copySrcBankL} src=${(copySrcStart + copyIdx)(5, 0)} count=${copyCount} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isCs && !execFault) {
+    printf(p"WumingCore: cs ip=0x${Hexadecimal(ip(47, 0))} cond=${d.csCond} taken=${csCondTrue} dst=${d.w0Idx} value=0x${Hexadecimal(csData)} cycle=${cycles}\n")
+  }
+  when(state === sExec && !execFault && !cfxFault && (d.isJump || d.isCall || d.isRet)) {
+    // Control-flow trace for the timing/return-address evidence.  `target` is
+    // the architectural next IP for `jump`/`call`; `ret` takes its target from
+    // the RAS, so its trace carries the RAS state instead.
+    printf(p"WumingCore: ctrl ip=0x${Hexadecimal(ip(47, 0))} call=${d.isCall} ret=${d.isRet} target=0x${Hexadecimal(jumpTarget(47, 0))} racnt=${racnt} topcnt=${topCount} mrptr=0x${Hexadecimal(mrptr)} cycle=${cycles}\n")
+  }
+  when(state === sTrap && !semiIsHost) {
+    printf(p"WumingCore: cfxtrap ip=0x${Hexadecimal(ip(47, 0))} magic=0x${Hexadecimal(inst(17, 0))} vector=0x${Hexadecimal(cfxVector(0)(47, 0))} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isEscape && !execFault) {
+    printf(p"WumingCore: escape ip=0x${Hexadecimal(ip(47, 0))} frame=0x${Hexadecimal(cfxCauseId(0))} cause_ip=0x${Hexadecimal(cfxCauseIp(0)(47, 0))} target=0x${Hexadecimal((cfxCauseIp(0) + d.escOff)(47, 0))} mode=${runMode} cycle=${cycles}\n")
+  }
+  when(state === sExec && d.isCfx2 && !execFault) {
+    printf(p"WumingCore: cfx2 ip=0x${Hexadecimal(ip(47, 0))} ha=${d.cfxHa} cg=${d.cfxCg} rc=${d.cfxRc} write=${d.cfxWrite} ok=${cfxRegOk} mode=${runMode} data=0x${Hexadecimal(cfxRdata)} wdata=0x${Hexadecimal(srcA)} cycle=${cycles}\n")
+  }
+  val faultPrinted = RegInit(false.B)
+  when(state === sFault && !faultPrinted) {
+    faultPrinted := true.B
+    printf(p"WumingCore: fault ip=0x${Hexadecimal(ip(47, 0))} inst=0x${Hexadecimal(inst)} cycle=${cycles}\n")
+  }
+
+  io.halted := state === sHalt
+}
