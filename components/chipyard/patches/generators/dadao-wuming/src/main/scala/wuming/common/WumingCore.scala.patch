index 0000000..db90a55
--- /dev/null
+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingCore.scala
@@ -0,0 +1,1371 @@
+// See LICENSE for license details.
+//
+// DADAO "wuming" core: split fetch/data ports, 8-beat fetch queue and the
+// m12-006 multi-cycle state-machine skeleton.
+//
+// Structure (`.tao/knowledge/refs/m12-006-cycle-design.md` §5):
+//
+//   * two independent TileLink client ports.  `imem` carries the demand fetch
+//     plus the sequential prefetch; `dmem` carries loads/stores.  Each port
+//     owns its own A/D channel pair and its own request/response state, so a
+//     slow data access cannot stall fetch progress.
+//   * a `fetchDepth` (= 8 beats = 64 B) circular queue of consecutive beats.
+//     The prefetch walks the queue forward over the client's spare source IDs;
+//     a hit costs no extra cycle (`EXEC` decodes straight out of the queue).
+//   * the 12-state skeleton of §5.1: IDLE / FREQ / FWAIT / EXEC / TRAP / SEMI
+//     / EXC / MREQ / MWAIT / SLOW / FAULT / HALT.  Cycle policy R1 = C:
+//     shift/bit-field ops take two cycles (`EXEC` latches the operands,
+//     `SLOW` computes and writes back), plain arithmetic takes one.  The
+//     register file keeps its 2-write/3-read shape (R8 = 2R2W).
+//
+// m12-chipyard-008 adds the memory unit (spec/SimRISC-01, spec/SimRISC-05):
+//
+//   * `ld`/`st` at every integer width (b/w/t/o, zero/sign extending) in the
+//     rd, rb and ra banks; `ldm`/`stm` (1..63 registers) as 8-byte TileLink
+//     beats — every element fits inside one beat (its address is width
+//     aligned and the width divides 8), so a beat is packed from consecutive
+//     registers and unpacked into consecutive registers without per-element
+//     bus transactions.
+//   * whole-transfer precheck in `EXEC` (alignment + address-map window) so a
+//     MALIGN/CFXMEM is precise and no beat of a bad `ldm`/`stm` ever reaches
+//     the bus.  A bus denial in the middle of a transfer raises CFXMEM into
+//     the monitor; the instruction may be re-entered from its start
+//     (m12-chipyard-008 task baseline R7).
+//   * only 8-byte, beat-aligned TileLink accesses: loads are full-beat `Get`s
+//     that select/extend the addressed bytes, stores are full-beat `Put`s
+//     with a byte mask (§3.3/§5.5 of the design note).
+//
+// m12-chipyard-007 adds the *boot handoff* half of cfx_hmon: the CFXTRAP entry
+// produced by `trap cfx_hmon, <magic>`, the cause frame
+// (`excp_cause_id`/`excp_cause_ip`/`excp_cause_info`), `excp_vector` (cg3
+// rc10; reset value = hmon SRAM base, writes drop the low 2 bits) and `escape`
+// with the fixed 0/+4 offsets.
+//
+// m12-chipyard-019 completes cfx_hmon and adds cfx_power's register group
+// (DADAO-13 §1/§2, DADAO-12 §3/§4.12, Machine-v5 §3/§4.4): the four
+// synchronous source masks, `cfx_intr_mask`, `switch_run_mode` (Tiny keeps
+// hypv), the cg7 space descriptors, `excp_prev_run_mode` and the five
+// synchronous fault classes (CFXMEM/ILLI/UNDI/MALIGN/IALIGN) — each one writes
+// the cause frame and jumps to `excp_vector` instead of terminating the core.
+//
+// m12-chipyard-009 completes control flow and the return address stack
+// (spec/SimRISC-06, spec/SimRISC-00 §2.4):
+//
+//   * `jump` (iiii and rrii), `call` (iiii/rrii: push `ip + 4`), `ret rdHA,
+//     imms18` (pop the RAS, write one rd) and `br.eq`/`br.ne` alongside the
+//     rd/rb `br.*` forms added by m12-007;
+//   * RegRAS push/pop cases C1/C2/C3a and D1/D2/D3 complete combinationally in
+//     `EXEC` (1 cycle); the MemRAS cases are one 8-byte store (C3b spill to
+//     `MRPTR - 8`) or load (D4b refill from `MRPTR`) through the data port and
+//     commit only after the access succeeds;
+//   * RASOF (`1 << 10`) and RASUF (`1 << 11`) are precise synchronous faults
+//     into the monitor: no RA register, no memory and (for `ret`) no rd is
+//     modified, and `excp_cause_ip` stays at the `call`/`ret` instruction.
+//
+// m12-chipyard-010 adds the rest of the non-cfx set:
+//
+//   * `lr`/`sc` reuse the single-element memory path.  `lr` writes rdHC and
+//     takes a reservation keyed by the exact address + access width; `sc`
+//     re-reads the 8-byte word (the value `lr` saw is kept in `resvWord`) and
+//     stores only when the reservation is held and the word is unchanged,
+//     writing 0/1 to rdHB.  A changed word is a legal spurious failure, so this
+//     matches QEMU's word-granularity reservation (ADR-0034 D6).  Exception
+//     entry, a successful/failed `sc` and another `lr` all clear it;
+//   * `cs.*` computes the predicate in `EXEC` and gates the write-back
+//     (`csTaken`); the value comes from rdHC/rdHD;
+//   * register-block copies run one register per cycle in the new `sCopy`
+//     state (12 states -> 13);
+//   * `fence`/`swym` are recognised no-ops (one cycle, no write-back).
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+import freechips.rocketchip.tilelink.{TLBundle, TLEdgeOut}
+
+class WumingCore(
+  fetchEdge: TLEdgeOut,
+  dataEdge: TLEdgeOut,
+  params: WumingCoreParams,
+  hartidBits: Int,
+  resetVectorBits: Int
+) extends Module {
+  require(fetchEdge.bundle.dataBits == dataEdge.bundle.dataBits,
+    "WumingCore: the fetch and data ports must negotiate the same beat width")
+  require(fetchEdge.bundle.addressBits == dataEdge.bundle.addressBits,
+    "WumingCore: the fetch and data ports must negotiate the same address width")
+
+  val io = IO(new Bundle {
+    val imem = new TLBundle(fetchEdge.bundle)
+    val dmem = new TLBundle(dataEdge.bundle)
+    val hartid = Input(UInt((hartidBits max 1).W))
+    val resetVector = Input(UInt(resetVectorBits.W))
+    val bootEnable = Input(Bool())
+    val semi = new Bundle {
+      val req = Output(new WumingSemiReq)
+      val resp = Input(new WumingSemiResp)
+    }
+    val halted = Output(Bool())
+  })
+
+  val addrBits = fetchEdge.bundle.addressBits
+  val beatBytes = fetchEdge.bundle.dataBits / 8
+  require(beatBytes == 8, "WumingCore: expected a 64-bit TileLink beat")
+  require(addrBits >= 48, "WumingCore: the Tiny address map must negotiate >= 48 bits")
+  val lgSize = log2Ceil(beatBytes).U
+
+  val fetchDepth = params.fetchDepth
+  require(fetchDepth >= 2, "WumingCore: FETCH_DEPTH must hold at least two beats")
+  private val ptrBits = log2Ceil(fetchDepth)
+  private val cntBits = log2Ceil(fetchDepth + 1)
+  private val beatBits = addrBits - 3
+  // Prefetch slots = the source IDs this port does not use for the demand
+  // fetch.  m12-020 widened `IdRange(0, 3)` to `IdRange(0, 5)`, so four
+  // prefetches can be in flight and the queue no longer drains at every beat
+  // boundary.
+  private val pfSlots = 4
+
+  // TileLink source IDs of the fetch port.  The data port is a separate client
+  // node with its own (client-local) source space, so §5.5's global numbering
+  // (0 = fetch, 1 = data, 2 = prefetch) collapses to "0 = demand fetch, the
+  // spare IDs = prefetch slots" on the fetch port.  Prefetch slot i uses
+  // source i + 1.
+  private val srcBits = fetchEdge.bundle.sourceBits
+  val FETCH_SRC = 0.U(srcBits.W)
+  val DATA_SRC = 0.U(srcBits.W)
+
+  // ---- architectural state ----------------------------------------------
+  val ip = RegInit(0.U(64.W)) // address of the instruction being executed
+
+  // ---- cfx register groups: cfx_hmon (cfx3) and cfx_power (cfx63) ----------
+  //
+  //   cg3 rc0-rc3  cfxtrap / cfxmem / cfxreg / cfxexe source masks   (RW)
+  //   cg3 rc4      cfx_intr_mask                                     (RW)
+  //   cg3 rc8      switch_run_mode — Tiny: writes ignored, reads 3
+  //   cg3 rc10     excp_vector — reset = the cfx's own base; writes drop the
+  //                low 2 bits (DADAO-13 §1)
+  //   cg5 rc0      excp_prev_run_mode (RW; `escape` restores it)
+  //   cg5 rc2/rc4  excp_cause_id / excp_cause_info (hardware-written)
+  //   cg5 rc3      excp_cause_ip (RW)
+  //   cg7 rc0-63   internal space descriptors (read-only; writes are CFXREG)
+  //
+  // Every other (cg, rc) of these two cfx is not implemented on this profile
+  // and reads/writes as CFXREG — never as a silent zero.
+  private val C_HMON = 3.U(6.W)
+  private val C_POWER = 63.U(6.W)
+
+  private def requiredValue[A](opt: Option[A], what: String): A = opt.getOrElse(
+    throw new IllegalArgumentException(
+      s"WumingCore: $what must be configured from the machine address map"))
+  private val hmonBaseValue = requiredValue(params.hmonBase, "hmonBase")
+  private val hmonSizeValue = requiredValue(params.hmonSize, "hmonSize")
+  private val bootromBaseValue = requiredValue(params.bootromBase, "bootromBase")
+  private val bootromSizeValue = requiredValue(params.bootromSize, "bootromSize")
+  // cg7 space block 0 start = base - (cfxha << 42) (DADAO-12 §3.8/§2.1).
+  private val hmonSpaceStart = hmonBaseValue - (BigInt(3) << 42)
+  private val powerSpaceStart = bootromBaseValue - (BigInt(63) << 42)
+
+  // DADAO-12 §3.1 / ADR-0045 D4: the four synchronous source masks reset to
+  // "only cfx_power and itself allowed" (bit3 self is ignored by hardware);
+  // `cfx_intr_mask` resets to all ones (Tiny has no asynchronous sources).
+  private val maskInitHmon = BigInt("7ffffffffffffff7", 16)
+  private val maskInitPower = BigInt("fffffffffffffff7", 16)
+  private val allOnes = BigInt("ffffffffffffffff", 16)
+  private def sourceMask = RegInit(VecInit(Seq(
+    maskInitHmon.U(64.W), maskInitPower.U(64.W))))
+
+  val cfxTrapMask = sourceMask // cg3 rc0
+  val cfxMemMask  = sourceMask // cg3 rc1
+  val cfxRegMask  = sourceMask // cg3 rc2
+  val cfxExeMask  = sourceMask // cg3 rc3
+  val cfxIntrMask = RegInit(VecInit(Seq.fill(2)(allOnes.U(64.W)))) // cg3 rc4
+  // cg3 rc10: the internal SRAM base of each cfx (DADAO-13 §1): the hmon SRAM
+  // for cfx_hmon, the BootROM for cfx_power (DADAO-12 §2.1).
+  val cfxVector = RegInit(VecInit(Seq(
+    hmonBaseValue.U(64.W), bootromBaseValue.U(64.W))))
+  // cg5 rc0 / rc2 / rc3 / rc4 exception frame.
+  val cfxPrevMode  = RegInit(VecInit(Seq.fill(2)(0.U(2.W))))
+  val cfxCauseId   = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+  val cfxCauseIp   = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+  val cfxCauseInfo = RegInit(VecInit(Seq.fill(2)(0.U(64.W))))
+
+  // `inner_run_mode` (DADAO-12 §5.2 step 6).  Tiny starts and stays in hypv.
+  val runMode = RegInit(3.U(2.W))
+
+  val CFXTRAP_BIT = 0
+  val CFXMEM_BIT  = 1
+  val CFXREG_BIT  = 2
+  val CFXESC_BIT  = 3
+  val ILLI_BIT    = 8
+  val UNDI_BIT    = 9
+  val RASOF_BIT   = 10
+  val RASUF_BIT   = 11
+  val MALIGN_BIT  = 12
+  val IALIGN_BIT  = 13
+  // `excp_cause_id` is a one-hot 64-bit value (DADAO-12 §5.2(二)); 0 means "no
+  // valid frame" and is what `escape` checks before switching back.
+  val cfxHasFrame = cfxCauseId(0) =/= 0.U
+
+  val sIdle :: sFreq :: sFwait :: sExec :: sTrap :: sSemi :: sExc :: sMreq :: sMwait :: sSlow :: sCopy :: sFault :: sHalt :: Nil = Enum(13)
+  val state = RegInit(sIdle)
+
+  // Simulation-time cycle stamp for the timing evidence (`+verbose`).
+  val cycles = RegInit(0.U(64.W))
+  cycles := cycles + 1.U
+
+  // Semihosting return register (contract-semihosting: scalar result in rd8).
+  val semiRetReg = 8.U(6.W)
+  val semiOp = RegInit(0.U(8.W))
+  val semiArg = RegInit(0.U(64.W))
+  val semiPc = RegInit(0.U(64.W))
+  val semiIsHost = RegInit(false.B)
+
+  val rf = Module(new WumingRegFile)
+  rf.io.ip := ip
+
+  // ---- fetch queue (fetchDepth consecutive beats) -------------------------
+  val qBeat = Reg(Vec(fetchDepth, UInt(beatBits.W))) // beat index (address >> 3)
+  val qData = Reg(Vec(fetchDepth, UInt(64.W)))       // 8 bytes in address order
+  val qHead = RegInit(0.U(ptrBits.W))
+  val qCount = RegInit(0.U(cntBits.W))
+  // Beat index of the next entry to push.  Kept explicitly because the queue can
+  // be empty (after a flush or the `waitBeat` hand-over) while prefetch requests
+  // are still in flight: `qBeat(qHead)` is meaningless then.
+  val nextBeatReg = RegInit(0.U(beatBits.W))
+  val qFull = qCount === fetchDepth.U
+
+  // Single write port for the queue: every producer goes through these wires so
+  // a push, a pop and a flush in the same cycle cannot clobber each other.
+  val fifoPush = WireDefault(false.B)
+  val fifoPop = WireDefault(0.U(cntBits.W))
+  val fifoFlush = WireDefault(false.B)
+  val pushBeat = WireDefault(0.U(beatBits.W))
+  val pushData = WireDefault(0.U(64.W))
+
+  val headBeat = qBeat(qHead)
+  val curBeat = ip(addrBits - 1, 3)
+  val curOff = curBeat - headBeat
+  val queueHit = qCount =/= 0.U && curOff < qCount
+  val instIdx = (qHead + curOff)(ptrBits - 1, 0)
+  val beatData = qData(instIdx)
+
+  // TileLink puts byte k of a beat in bits [8k+7, 8k] (little-endian lanes);
+  // DADAO is big-endian, so re-assemble the beat in address order.
+  def addressOrder(value: UInt): UInt =
+    Cat((0 until beatBytes).map(i => value(8 * i + 7, 8 * i)))
+
+  def laneOrder(value: UInt): UInt =
+    Cat((0 until beatBytes).reverse.map(i => value(63 - 8 * i, 56 - 8 * i)))
+
+  val inst = Mux(ip(2), beatData(31, 0), beatData(63, 32))
+
+  // ---- decode ------------------------------------------------------------
+  val dec = Module(new WumingDecoder)
+  dec.io.inst := inst
+  val d = dec.io.dec
+
+  // ---- cfx register file access (m12-019) ---------------------------------
+  val cfxIsHmon = d.cfxHa === C_HMON
+  val cfxIsPower = d.cfxHa === C_POWER
+  val cfxImplemented = cfxIsHmon || cfxIsPower
+  private val monIdx = Mux(cfxIsHmon, 0.U(1.W), 1.U(1.W))
+  private val isCg3 = d.cfxCg === 3.U
+  // DADAO-13 §1: the whole cg3 row is hypv-only.
+  private val cg3Allowed = !isCg3 || runMode === 3.U
+  private val isMask = isCg3 && d.cfxRc <= 4.U
+  private val isSwitchMode = isCg3 && d.cfxRc === 8.U
+  private val isVector = isCg3 && d.cfxRc === 10.U
+  private val isPrevMode = d.cfxCg === 5.U && d.cfxRc === 0.U
+  private val isCauseId = d.cfxCg === 5.U && d.cfxRc === 2.U
+  private val isCauseIp = d.cfxCg === 5.U && d.cfxRc === 3.U
+  private val isCauseInfo = d.cfxCg === 5.U && d.cfxRc === 4.U
+  private val isSpace = d.cfxCg === 7.U
+  private val cfxReadOk = cfxImplemented && cg3Allowed &&
+    (isMask || isSwitchMode || isVector || isPrevMode || isCauseId ||
+      isCauseIp || isCauseInfo || isSpace)
+  // cg3 rc8 accepts the write and ignores it (Tiny keeps hypv); cg5 rc2/rc4
+  // are hardware-written and cg7 is read-only, so writing them is CFXREG.
+  private val cfxWriteOk = cfxImplemented && cg3Allowed &&
+    (isMask || isSwitchMode || isVector || isPrevMode || isCauseIp)
+  val cfxRegOk = Mux(d.cfxWrite, cfxWriteOk, cfxReadOk)
+  // A rejected cfx2 access is a precise CFXREG: the destination register must
+  // not be modified (DADAO-12 §5 "目标寄存器/内存/RA 未更新").
+  val cfxFault = d.isCfx2 && !cfxRegOk
+  private val cg3MaskData = MuxLookup(d.cfxRc, 0.U(64.W))(Seq(
+    0.U -> cfxTrapMask(monIdx), 1.U -> cfxMemMask(monIdx),
+    2.U -> cfxRegMask(monIdx), 3.U -> cfxExeMask(monIdx),
+    4.U -> cfxIntrMask(monIdx)))
+  // cg7: 16 blocks of 4 words (desc/start/size/attr); only block 0 exists.
+  private val cg7Block0 = d.cfxRc(5, 2) === 0.U
+  private val cg7Data = MuxLookup(d.cfxRc(1, 0), 0.U(64.W))(Seq(
+    0.U -> Mux(cfxIsHmon, 0x3.U(64.W), 0x5.U(64.W)), // exists|SRAM / exists|ROM
+    1.U -> Mux(cfxIsHmon, hmonSpaceStart.U(64.W), powerSpaceStart.U(64.W)),
+    2.U -> Mux(cfxIsHmon, hmonSizeValue.U(64.W), bootromSizeValue.U(64.W)),
+    3.U -> Mux(cfxIsHmon, 0x7.U(64.W), 0x5.U(64.W)))) // R|W|X / R|X
+  private val cg7Rdata = Mux(cg7Block0, cg7Data, 0.U(64.W))
+  val cfxRdata = Mux(isMask, cg3MaskData,
+    Mux(isSwitchMode, 3.U(64.W), // Tiny: the saved value stays 3
+      Mux(isVector, cfxVector(monIdx),
+        Mux(isPrevMode, cfxPrevMode(monIdx).pad(64),
+          Mux(isCauseId, cfxCauseId(monIdx),
+            Mux(isCauseIp, cfxCauseIp(monIdx),
+              Mux(isCauseInfo, cfxCauseInfo(monIdx), cg7Rdata)))))))
+
+  // ---- lr/sc reservation + block copy state (m12-chipyard-010) ------------
+  //
+  // The reservation key is the exact address + access width (spec/SimRISC-12
+  // §1.1).  `resvWord` keeps the 8-byte word read by `lr` so `sc` can also
+  // reject a store when that word changed in between: that is a *spurious
+  // failure*, which the spec allows ("sc 可能偶发性失败"), and it is what QEMU
+  // compares against (ADR-0034 D6), so both implementations agree.
+  val resvValid = RegInit(false.B)
+  val resvAddr  = RegInit(0.U(48.W))
+  val resvWidth = RegInit(3.U(2.W))
+  val resvWord  = RegInit(0.U(64.W))
+
+  // 0 = none, 1 = lr load, 2 = sc reservation check (load), 3 = sc store.
+  val memAux = RegInit(0.U(2.W))
+
+  // Block copy: destination/source start registers and the element index.
+  val copyDstStart = RegInit(0.U(6.W))
+  val copySrcStart = RegInit(0.U(6.W))
+  val copyCount    = RegInit(1.U(6.W))
+  val copyIdx      = RegInit(0.U(6.W))
+  val copyDstBankL = RegInit(WumingBank.RD)
+  val copySrcBankL = RegInit(WumingBank.RD)
+
+  // ---- operands / ALU ----------------------------------------------------
+  // The block-copy loop reads its source register through the r0 port.
+  val inCopy = state === sCopy
+  rf.io.r0Idx := Mux(inCopy, (copySrcStart + copyIdx)(5, 0), d.srcAIdx)
+  rf.io.r0Bank := Mux(inCopy, copySrcBankL, d.srcABank)
+  rf.io.r1Idx := d.srcBIdx; rf.io.r1Bank := d.srcBBank
+
+  val srcA = Mux(d.srcAIsIp, ip, rf.io.r0Data)
+  val srcB = rf.io.r1Data
+
+  // `SLOW` latches the operands in `EXEC` and re-uses the same ALU, so the
+  // shift/bit-field result is not on the `EXEC` critical path (R1 = C).
+  val slowA = RegInit(0.U(64.W))
+  val slowB = RegInit(0.U(64.W))
+  val slowShamt = RegInit(0.U(6.W))
+  val slowOp = RegInit(0.U(6.W))
+  val slowWidth = RegInit(3.U(2.W))
+  val slowWp = RegInit(0.U(2.W))
+  val slowW0En = RegInit(false.B)
+  val slowW0Idx = RegInit(0.U(6.W))
+  val slowW0Bank = RegInit(WumingBank.RD)
+  val slowW0Sel = RegInit(0.U(1.W))
+  val slowW1En = RegInit(false.B)
+  val slowW1Idx = RegInit(0.U(6.W))
+  val slowW1Bank = RegInit(WumingBank.RD)
+
+  val alu = Module(new WumingALU)
+  val aluSel = state === sSlow
+  alu.io.op := Mux(aluSel, slowOp, d.aluOp)
+  alu.io.opWidth := Mux(aluSel, slowWidth, d.opWidth)
+  alu.io.a := Mux(aluSel, slowA, srcA)
+  alu.io.b := Mux(aluSel, slowB, Mux(d.useImmB, d.imm, srcB))
+  alu.io.shamt := Mux(aluSel, slowShamt, Mux(d.shamtFromImm, d.imm(5, 0), srcB(5, 0)))
+  alu.io.wp := Mux(aluSel, slowWp, d.wp)
+
+  val jumpTarget = (srcA + srcB + d.jumpOff)(63, 0)
+
+  // ---- memory unit (m12-008, spec/SimRISC-01 / SimRISC-05) ----------------
+  //
+  // One access shape covers every memory instruction: `memCount` elements of
+  // `1 << memWidth` bytes starting at `memBase`, `memStore` selecting the
+  // direction.  Single ld/st is count = 1; ldm/stm is count = immu6.  The
+  // transfer walks 8-byte beats: a store packs its beat from consecutive
+  // registers one element per cycle, a load unpacks a received beat into
+  // consecutive registers one element per cycle.  Elements never straddle a
+  // beat (a width-aligned element of 1/2/4/8 bytes always fits in its beat).
+  val memStore = RegInit(false.B)
+  val memMulti = RegInit(false.B)
+  val memWidthLat = RegInit(3.U(2.W))
+  val memSignedLat = RegInit(false.B)
+  val memBase = RegInit(0.U(64.W))
+  val memCount = RegInit(1.U(6.W))
+  val memBank = RegInit(WumingBank.RD)
+  val memStart = RegInit(0.U(6.W))
+  val memElem = RegInit(0.U(6.W))
+  val memBeat = RegInit(0.U(64.W))
+  val memData = RegInit(0.U(64.W))  // address-ordered beat payload
+  val memMask = RegInit(0.U(8.W))   // byte enable per address offset
+  val memPacked = RegInit(false.B)
+  val memBeatValid = RegInit(false.B)
+
+  val isMulti = d.isLdm || d.isStm
+  val memAddrNow = (srcA + Mux(isMulti, srcB, d.memOff))(63, 0)
+  val memCountNow = Mux(isMulti, d.mregCount, 1.U(6.W))
+  val memBytesNow = (1.U << d.memWidth)(3, 0)
+  val memAlignMask = (memBytesNow - 1.U)(2, 0)
+  val memAlignFail = (memAddrNow & memAlignMask) =/= 0.U
+  val memEndNow = memAddrNow + (memCountNow << d.memWidth) - 1.U
+
+  // m12-008: the *architectural* backing test is the Tiny three-segment window
+  // (spec/Machine-v5 §1.1 + the hmon ruling), not `manager.supportsXxx` alone:
+  // the chipyard SoC also maps a debug controller at address 0 and other
+  // peripherals that the DADAO address map does not have, so trusting the
+  // negotiated map would silently turn an unmapped access into a bus access
+  // instead of CFXMEM.  The manager capability check is kept on top of it.
+  private val sramBaseValue = requiredValue(params.loadMemBase, "loadMemBase")
+  private val sramSizeValue = requiredValue(params.loadMemSize, "loadMemSize")
+  private def inWindow(x: UInt, base: BigInt, size: BigInt): Bool = {
+    val lower = base.U(64.W)
+    val upper = (base + size).U(64.W)
+    x >= lower && x < upper
+  }
+  private def specBacked(x: UInt): Bool =
+    inWindow(x, sramBaseValue, sramSizeValue) ||
+      inWindow(x, hmonBaseValue, hmonSizeValue) ||
+      inWindow(x, bootromBaseValue, bootromSizeValue)
+
+  // The bus always moves whole 8-byte beats; check the managers that carry the
+  // first and last beat (the safe variants probe every manager, unlike the
+  // fast ones which presume a legal address).
+  def beatOf(x: UInt): UInt = Cat(x(addrBits - 1, 3), 0.U(3.W))
+  def dataGetLegal(x: UInt): Bool =
+    specBacked(x) && dataEdge.manager.supportsGetSafe(x(addrBits - 1, 0), lgSize)
+  def dataPutLegal(x: UInt): Bool =
+    specBacked(x) && dataEdge.manager.supportsPutPartialSafe(x(addrBits - 1, 0), lgSize)
+  val memGetLegalNow = dataGetLegal(beatOf(memAddrNow)) && dataGetLegal(beatOf(memEndNow))
+  val memPutLegalNow = dataPutLegal(beatOf(memAddrNow)) && dataPutLegal(beatOf(memEndNow))
+  val memRangeLegalNow = Mux(d.isSt || d.isStm, memPutLegalNow, memGetLegalNow)
+
+  // ---- lr/sc decision (spec/SimRISC-12 §1) -------------------------------
+  // `lr`/`sc` share the single-element address arithmetic (`rbHD` + 0) and the
+  // width-alignment rule; the reservation check itself is a register compare.
+  val lrscAddr = memAddrNow
+  val lrscGetLegal = dataGetLegal(beatOf(lrscAddr))
+  val lrscPutLegal = dataPutLegal(beatOf(lrscAddr))
+  // The reservation key is the exact address + access width.
+  val scHit = resvValid && (resvAddr === lrscAddr(47, 0)) &&
+    (resvWidth === d.memWidth)
+  // MALIGN is checked on the operand address before any access, on success and
+  // on failure alike (a misaligned `sc` faults whether or not a reservation is
+  // held).
+  val lrscAlignFail = (d.isLr || d.isSc) && memAlignFail
+  val lrscOk = !d.ill && !d.undi && !cfxFault
+  val lrFailNow = d.isLr && lrscOk && !lrscAlignFail && !lrscGetLegal
+  // `sc` only touches memory when the reservation matches, so an unbacked
+  // address is only a CFXMEM on that path.
+  val scFailNow = d.isSc && lrscOk && !lrscAlignFail && !scHit
+  val scMemFail = d.isSc && lrscOk && !lrscAlignFail && scHit &&
+    !(lrscGetLegal && lrscPutLegal)
+
+  // ---- control flow + return address stack (m12-009) ----------------------
+  //
+  // `call` pushes the return address (= the `call` instruction's own address
+  // + 4, spec/SimRISC-06 §3); `ret` pops it (spec/SimRISC-06 §4) and writes one
+  // rd with the sign-extended imms18.  The push/pop cases are those of
+  // spec/SimRISC-00 §2.4.1/§2.4.2: the RegRAS cases (C1/C2/C3a, D1-D3)
+  // complete combinationally in `EXEC` (1 cycle), while the MemRAS cases are a
+  // single 8-byte store (C3b spill) or load (D4b refill) through the data port.
+  // Every decision is taken before any RA register or memory is modified, so
+  // RASOF/RASUF and a denied MemRAS access are precise (§2.4 "精确异常").
+  val rasOp = WireDefault(WumingRasOp.NONE)
+  val rasPushAddr = WireDefault(0.U(48.W))
+  val rasPushCount = WireDefault(0.U(16.W))
+  val rasMemAddr = WireDefault(0.U(48.W))
+  rf.io.rasOp := rasOp
+  rf.io.rasPushAddr := rasPushAddr
+  rf.io.rasPushCount := rasPushCount
+  rf.io.rasMemAddr := rasMemAddr
+
+  val racnt = rf.io.rasRacnt
+  val mrptr = rf.io.rasMrptr
+  val topCount = rf.io.rasTopCount
+  val topAddr = rf.io.rasTopAddr
+
+  def beatOf48(x: UInt): UInt = beatOf(x(47, 0).pad(64))
+
+  // push: C1 (empty) / C2 (recursive fold) / C3a (room) / C3b (spill or RASOF)
+  val callRetAddr = (ip + 4.U)(47, 0)
+  val callFold = racnt =/= 0.U && callRetAddr === topAddr && topCount < 0xFFFF.U
+  val callNeedsSpill = racnt === 63.U && !callFold
+  val callRasOf = callNeedsSpill && mrptr === 0.U
+  val spillBeat = beatOf48((mrptr - 8.U)(47, 0))
+  val callSpillLegal = dataPutLegal(spillBeat)
+
+  // pop: D1 (count 0) / D2 (count > 1) / D3 (count 1) / D4a (cold) / D4b (MemRAS)
+  val retRasUf = (racnt =/= 0.U && topCount === 0.U) || (racnt === 0.U && mrptr === 0.U)
+  val retDec = racnt =/= 0.U && topCount > 1.U
+  val retPop = racnt =/= 0.U && topCount === 1.U
+  val retMem = racnt === 0.U && mrptr =/= 0.U
+  val retMemBeat = beatOf48(mrptr)
+  val retMemLegal = dataGetLegal(retMemBeat)
+
+  // 0 = none, 1 = C3b spill store, 2 = D4b refill load.
+  val rasMemKind = RegInit(0.U(2.W))
+  val rasNextIp = RegInit(0.U(64.W))
+  val retRdIdx = RegInit(0.U(6.W))
+  val retRdVal = RegInit(0.U(64.W))
+
+  // EXEC-time RAS faults (precise: nothing is written back) and the deferred
+  // `ret` rd write (the D4b decision needs the MemRAS read first).
+  val rasExecFault = Mux(d.isCall, callRasOf, d.isRet && retRasUf)
+  val retDeferred = d.isRet && retMem
+
+  val memElemAddr = memBase + (memElem << memWidthLat)
+  val memElemInBeat = memElem < memCount && memElemAddr(63, 3) === memBeat(63, 3)
+  val memElemOff = memElemAddr(2, 0)
+  val memElemBytes = (1.U << memWidthLat)(3, 0)
+  // Byte-enable for the element: `memElemBytes` lanes starting at the element's
+  // address offset (bit o = address byte o).
+  val memElemMask = (((1.U << memElemBytes) - 1.U) << memElemOff)(7, 0)
+  val memElemValueMask = MuxLookup(memWidthLat, "hffffffffffffffff".U(64.W))(Seq(
+    0.U -> "h00000000000000ff".U(64.W),
+    1.U -> "h000000000000ffff".U(64.W),
+    2.U -> "h00000000ffffffff".U(64.W)))
+  val memElemShift = ((8.U - memElemOff - memElemBytes) << 3)(5, 0)
+
+  // Extract the addressed element out of an address-ordered beat and apply
+  // the element's sign/zero extension.
+  def extractElem(v: UInt, off: UInt): UInt = {
+    val b = (0 until beatBytes).map(i => v(63 - 8 * i, 56 - 8 * i)) :+ 0.U(8.W)
+    val zx = MuxLookup(memWidthLat, 0.U(64.W))(Seq(
+      0.U -> MuxLookup(off, 0.U(64.W))((0 until 8).map(o => o.U -> b(o).pad(64))),
+      1.U -> MuxLookup(off, 0.U(64.W))((0 until 7).map(o =>
+        o.U -> Cat(b(o), b(o + 1)).pad(64))),
+      2.U -> MuxLookup(off, 0.U(64.W))((0 until 5).map(o =>
+        o.U -> Cat(b(o), b(o + 1), b(o + 2), b(o + 3)).pad(64))),
+      3.U -> MuxLookup(off, 0.U(64.W))((0 until 1).map(o =>
+        o.U -> Cat(b(0), b(1), b(2), b(3), b(4), b(5), b(6), b(7))))))
+    val sx = MuxLookup(memWidthLat, zx)(Seq(
+      0.U -> Cat(Fill(56, zx(7)), zx(7, 0)),
+      1.U -> Cat(Fill(48, zx(15)), zx(15, 0)),
+      2.U -> Cat(Fill(32, zx(31)), zx(31, 0)),
+      3.U -> zx))
+    Mux(memSignedLat, sx, zx)
+  }
+  val memLdElem = extractElem(memData, memElemOff)
+
+  // The data port: one outstanding request, held on the A channel until the
+  // handshake, then waited on in `MWAIT`.
+  val (_, memGetBits) = dataEdge.Get(DATA_SRC, memBeat(addrBits - 1, 0), lgSize)
+  val (_, memPutBits) = dataEdge.Put(DATA_SRC, memBeat(addrBits - 1, 0), lgSize,
+    laneOrder(memData), memMask)
+  io.dmem.a.valid := state === sMreq && (!memStore || memPacked)
+  io.dmem.a.bits := Mux(memStore, memPutBits, memGetBits)
+  io.dmem.d.ready := state === sMwait
+
+  // The element source for a store beat is read combinationally on the r2
+  // port while the beat is being packed; the element destination for a load
+  // beat is written through w0 while the beat is being unpacked.  An `lr` load
+  // writes its destination (memAux 1); an `sc` reservation check (memAux 2)
+  // and the `sc` store (memAux 3) use their own write-back paths.
+  val memElemRead = state === sMreq && memStore && !memPacked && memElemInBeat
+  val memElemWrite = state === sMwait && !memStore && memBeatValid && memElemInBeat &&
+    rasMemKind === 0.U && (memAux === 0.U || memAux === 1.U)
+  rf.io.r2Idx := Mux(memElemRead, (memStart + memElem)(5, 0), d.srcCIdx)
+  rf.io.r2Bank := Mux(memElemRead, memBank, d.srcCBank)
+
+  // ---- write-back --------------------------------------------------------
+  val execFault = d.ill || d.undi
+
+  // R1 = C: shifts / bit-field ops take the two-cycle path.
+  val slowOps = Seq(WumingAluOp.SHL, WumingAluOp.SHR_U, WumingAluOp.SHR_S,
+    WumingAluOp.ROL, WumingAluOp.EXT_U, WumingAluOp.EXT_S,
+    WumingAluOp.REV, WumingAluOp.CTPOP, WumingAluOp.CTLZ, WumingAluOp.CTTZ,
+    WumingAluOp.CLMUL128)
+  val aluIsSlow = slowOps.map(op => d.aluOp === op).reduce(_ || _)
+
+  // cs.* (spec/SimRISC-02 §2): the value is written only when the predicate
+  // holds.  Codes 0/1/2 read their "then" value from rdHC and their "else"
+  // value from rdHD; codes 3/4 assign rdHD to rdHC.
+  val csCondTrue = MuxLookup(d.csCond, false.B)(Seq(
+    0.U -> srcA(63),                        // cs.n
+    1.U -> (srcA === 0.U),                  // cs.z
+    2.U -> (srcA =/= 0.U && !srcA(63)),     // cs.p
+    3.U -> (srcA === srcB),                 // cs.eq
+    4.U -> (srcA =/= srcB)))                // cs.ne
