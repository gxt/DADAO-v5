+// See LICENSE for license details.
+//
+// DADAO floating-point infrastructure (m12-chipyard-011).
+//
+// The internal representation, the encode/decode primitives, the rounding
+// primitive and the classification predicate follow the *semantics* of
+// berkeley-hardfloat (John R. Hauser), which the DADAO specification borrows
+// for its IEEE 754 behaviour (spec/SimRISC-07, ADR-0050):
+//
+//   berkeley-hardfloat primitive      | this file                            | semantics point
+//   ----------------------------------|--------------------------------------|---------------------------------
+//   recFNFromFN.scala                 | WumingRecFN.recFNFromFN              | IEEE binary -> recoded format
+//   fNFromRecFN.scala                 | WumingRecFN.fNFromRecFN              | recoded format -> IEEE binary
+//   rawFloatFromFN.scala              | WumingRecFN.rawFloatFromFN           | unpack + normalise FN
+//   rawFloatFromRecFN.scala           | WumingRecFN.rawFloatFromRecFN        | unpack recFN
+//   primitives.scala (countLeadingZeros) | WumingRecFN.countLeadingZeros     | subnormal normalisation
+//   RoundAnyRawFNToRecFN.scala        | WumingRoundAnyRawFNToRecFN           | the one rounding primitive
+//   classifyRecFN.scala               | WumingRecFN.classifyRecFN            | SimRISC-07 §5 class bits
+//   consts.scala (round_*)            | WumingRoundMode                      | the five rounding directions
+//
+// The code is written from scratch against those semantics; **hardfloat is not
+// a build dependency of the core** (a hardfloat instance appears only in the
+// unit bench `WumingFPUnitHarness.scala`, which is never elaborated into the
+// SoC).  Two DADAO-specific differences from the upstream primitives are
+// deliberate and are marked `DADAO:` below:
+//
+//   * the exception flags are packed in the `rf0[4:0]` order of
+//     spec/SimRISC-00 §2.3.1 (bit0 NV, bit1 DZ, bit2 OF, bit3 UF, bit4 NX),
+//     i.e. the reverse of hardfloat's `exceptionFlags` ordering;
+//   * a quiet NaN input propagates its payload (spec/SimRISC-07 §1.4
+//     "*NaN 传播 payload*"), where hardfloat canonicalises it.  A signalling
+//     NaN and an invalid operation are signalled by the caller through
+//     `invalidExc` and produce the canonical quiet NaN.
+//
+// The recoded format (hardfloat's "recFN") is the format all FP data takes
+// inside the core: `sign ## exp(expWidth+1) ## sig(sigWidth-1)`, i.e. one
+// exponent bit more than the IEEE format, so that subnormals stay normalised
+// and only the encoder/decoder deal with denormalisation.
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+
+/** Field widths of the two IEEE formats (spec/SimRISC-00 §2.3: ft = binary32,
+  * fo = binary64).  `sigWidth` counts the hidden bit, so the significand
+  * carried in the internal bundles has `sigWidth - 1` fraction bits.
+  */
+object WumingFmt {
+  val ftExp = 8
+  val ftSig = 24
+  val foExp = 11
+  val foSig = 53
+}
+
+/** The rounded directions of spec/SimRISC-07 §1.1 / ADR-0050 D2.
+  *
+  * The 3-bit codes are hardfloat's `round_*` constants, which keeps the unit
+  * bench a one-to-one comparison against `RoundAnyRawFNToRecFN`; only the five
+  * directions DADAO can request are implemented (no `round_odd`).
+  */
+object WumingRoundMode {
+  val RNE = 0.U(3.W) // round_near_even   (0x01 static, rf0 00)
+  val RTZ = 1.U(3.W) // round_minMag      (0x04 static, rf0 01)
+  val RDN = 2.U(3.W) // round_min         (0x10 static, rf0 10)
+  val RUP = 3.U(3.W) // round_max         (0x08 static, rf0 11)
+  val RNA = 4.U(3.W) // round_near_maxMag (0x02 static, no rf0 encoding)
+
+  /** `rf0[33:32]` -> direction (`00` RNE, `01` RTZ, `10` RDN, `11` RUP). */
+  def fromFcsr(bits: UInt): UInt = MuxLookup(bits, RNE)(Seq(
+    0.U -> RNE, 1.U -> RTZ, 2.U -> RDN, 3.U -> RUP))
+
+  /** The `immu6` one-hot field of the six-direction forms (ADR-0050 D2,
+    * spec/SimRISC-07 §1.1): `0x01` RNE, `0x02` RNA, `0x04` RTZ, `0x08` RUP,
+    * `0x10` RDN, `0x20` dynamic (read `rf0[33:32]`).  Returns
+    * `(legal, direction)`; every other value is ILLI.
+    */
+  def fromOneHot(immu6: UInt, fcsrMode: UInt): (Bool, UInt) = {
+    val legal = immu6 === 0x01.U || immu6 === 0x02.U || immu6 === 0x04.U ||
+      immu6 === 0x08.U || immu6 === 0x10.U || immu6 === 0x20.U
+    val dir = MuxLookup(immu6, RNE)(Seq(
+      0x01.U -> RNE,
+      0x02.U -> RNA,
+      0x04.U -> RTZ,
+      0x08.U -> RUP,
+      0x10.U -> RDN,
+      0x20.U -> fromFcsr(fcsrMode)))
+    (legal, dir)
+  }
+}
+
+/** Unpacked floating-point value (hardfloat's `RawFloat`).
+  *
+  * Invariants: at most one of `isNaN`/`isInf`/`isZero` is set; for any other
+  * value `sig(sigWidth)` is 0 and `sig(sigWidth-1)` is 1 (the significand is
+  * normalised, the exponent is not).  `sExp` is the recoded exponent: the IEEE
+  * biased exponent plus `2^(expWidth-1) + 1`, so the smallest normal value has
+  * `sExp = 2^(expWidth-1) + 2`.
+  */
+class WumingRawFloat(val expWidth: Int, val sigWidth: Int) extends Bundle {
+  val isNaN = Bool()
+  val isInf = Bool()
+  val isZero = Bool()
+  val sign = Bool()
+  val sExp = SInt((expWidth + 2).W)
+  val sig = UInt((sigWidth + 1).W)
+
+  /** Signalling NaN: a NaN whose payload's most significant bit is clear
+    * (hardfloat `isSigNaNRawFloat`; spec/SimRISC-07 §5 classification).
+    */
+  def isSigNaN: Bool = isNaN && !sig(sigWidth - 2)
+}
+
+object WumingRecFN {
+  def width(expWidth: Int, sigWidth: Int): Int = expWidth + sigWidth + 1
+
+  def minNormExp(expWidth: Int): BigInt = (BigInt(1) << (expWidth - 1)) + 2
+
+  /** Index of the most significant set bit, `n` when the input is zero
+    * (hardfloat `countLeadingZeros`, used for subnormal normalisation).
+    */
+  def countLeadingZeros(in: UInt): UInt = PriorityEncoder(in.asBools.reverse)
+
+  /** IEEE binary -> unpacked raw float (hardfloat `rawFloatFromFN`). */
+  def rawFloatFromFN(expWidth: Int, sigWidth: Int, in: UInt): WumingRawFloat = {
+    val sign = in(expWidth + sigWidth - 1)
+    val expIn = in(expWidth + sigWidth - 2, sigWidth - 1)
+    val fractIn = in(sigWidth - 2, 0)
+
+    val isZeroExpIn = expIn === 0.U
+    val isZeroFractIn = fractIn === 0.U
+
+    // A subnormal is normalised by shifting the fraction left by the number of
+    // leading zeros and dropping the exponent accordingly (the wrapped
+    // arithmetic below lands it one step below the smallest normal).
+    val normDist = countLeadingZeros(fractIn)
+    val subnormFract = (fractIn << normDist)(sigWidth - 3, 0) << 1
+    val adjustedExp =
+      Mux(isZeroExpIn,
+        normDist ^ ((BigInt(1) << (expWidth + 1)) - 1).U,
+        expIn) + ((BigInt(1) << (expWidth - 1)).U | Mux(isZeroExpIn, 2.U, 1.U))
+
+    val isZero = isZeroExpIn && isZeroFractIn
+    // `DADAO:` hardfloat leaves the exponent of a zero value as a don't-care
+    // (the leading-zero count of an all-zero fraction).  Pinning it to 0 keeps
+    // the encoder deterministic and independent of the leading-zero counter's
+    // all-zero behaviour; every consumer tests `isZero` first anyway.
+    val exponent = Mux(isZero, 0.U, adjustedExp(expWidth, 0))
+    val isSpecial = exponent(expWidth, expWidth - 1) === 3.U
+
+    val out = Wire(new WumingRawFloat(expWidth, sigWidth))
+    out.isNaN := isSpecial && !isZeroFractIn
+    out.isInf := isSpecial && isZeroFractIn
+    out.isZero := isZero
+    out.sign := sign
+    out.sExp := exponent.zext
+    out.sig := 0.U(1.W) ## !isZero ## Mux(isZeroExpIn, subnormFract, fractIn)
+    out
+  }
+
+  /** Unpacked raw float -> IEEE binary (inverse of `rawFloatFromFN`). */
+  def recFNFromFN(expWidth: Int, sigWidth: Int, in: UInt): UInt = {
+    val rawIn = rawFloatFromFN(expWidth, sigWidth, in)
+    rawIn.sign ##
+      (Mux(rawIn.isZero, 0.U(3.W), rawIn.sExp(expWidth, expWidth - 2)) |
+        Mux(rawIn.isNaN, 1.U, 0.U)) ##
+      rawIn.sExp(expWidth - 3, 0) ##
+      rawIn.sig(sigWidth - 2, 0)
+  }
+
+  /** Recoded format -> unpacked raw float (hardfloat `rawFloatFromRecFN`). */
+  def rawFloatFromRecFN(expWidth: Int, sigWidth: Int, in: UInt): WumingRawFloat = {
+    val exp = in(expWidth + sigWidth - 1, sigWidth - 1)
+    // The recoded exponent carries one bit more than the IEEE format; the two
+    // top exponent bits therefore also flag the special values.
+    val isZero = exp(expWidth, expWidth - 2) === 0.U
+    val isSpecial = exp(expWidth, expWidth - 1) === 3.U
+
+    val out = Wire(new WumingRawFloat(expWidth, sigWidth))
+    out.isNaN := isSpecial && exp(expWidth - 2)
+    out.isInf := isSpecial && !exp(expWidth - 2)
+    out.isZero := isZero
+    out.sign := in(expWidth + sigWidth)
+    out.sExp := exp.zext
+    out.sig := 0.U(1.W) ## !isZero ## in(sigWidth - 2, 0)
+    out
+  }
+
+  /** Unpacked raw float -> recoded format (hardfloat `recFNFromRawFN`, the
+    * inverse of `rawFloatFromRecFN`; used by arithmetic modules that build a
+    * raw result and hand it to the rounding primitive).
+    */
+  def recFNFromRawFloat(rawIn: WumingRawFloat): UInt = {
+    val ew = rawIn.expWidth
+    val sw = rawIn.sigWidth
+    rawIn.sign ##
+      (Mux(rawIn.isZero, 0.U(3.W), rawIn.sExp(ew, ew - 2)) |
+        Mux(rawIn.isNaN, 1.U, 0.U)) ##
+      rawIn.sExp(ew - 3, 0) ##
+      rawIn.sig(sw - 2, 0)
+  }
+
+  /** Recoded format -> IEEE binary (hardfloat `fNFromRecFN`).
+    *
+    * The recoded exponent of a subnormal is below the smallest normal one; the
+    * significand is shifted back down by exactly the number of steps it was
+    * normalised up by, giving the IEEE subnormal encoding with a zero
+    * exponent field.
+    */
+  def fNFromRecFN(expWidth: Int, sigWidth: Int, in: UInt): UInt = {
+    val minNorm = minNormExp(expWidth)
+    val rawIn = rawFloatFromRecFN(expWidth, sigWidth, in)
+
+    val isSubnormal = rawIn.sExp < minNorm.S
+    val denormShiftDist = 1.U - rawIn.sExp(log2Up(sigWidth - 1) - 1, 0)
+    val denormFract = ((rawIn.sig >> 1) >> denormShiftDist)(sigWidth - 2, 0)
+
+    val expOut =
+      Mux(isSubnormal,
+        0.U,
+        rawIn.sExp(expWidth - 1, 0) -
+          ((BigInt(1) << (expWidth - 1)) + 1).U) |
+        Fill(expWidth, rawIn.isNaN || rawIn.isInf)
+    val fractOut =
+      Mux(isSubnormal,
+        denormFract,
+        Mux(rawIn.isInf, 0.U, rawIn.sig(sigWidth - 2, 0)))
+    Cat(rawIn.sign, expOut, fractOut)
+  }
+
+  /** Classification bits of spec/SimRISC-07 §5.
+    *
+    * `DADAO:` the bit order is the manual's, bit0 signalling NaN ... bit9
+    * positive infinity, which is the reverse of hardfloat's `classifyRecFN`
+    * (that one follows the RISC-V `fclass` numbering).  Only `[9:0]` is
+    * meaningful; the caller zero-extends to the 64-bit `rd` value.
+    */
+  def classifyRaw(rawIn: WumingRawFloat): UInt = {
+    val minNorm = minNormExp(rawIn.expWidth)
+    val isSigNaN = rawIn.isSigNaN
+    val isQuietNaN = rawIn.isNaN && !isSigNaN
+    val isFiniteNonzero = !rawIn.isNaN && !rawIn.isInf && !rawIn.isZero
+    val isSubnormal = rawIn.sExp < minNorm.S
+    val isNormal = isFiniteNonzero && !isSubnormal
+    Cat(
+      !rawIn.sign && rawIn.isInf,                        // 9 positiveInfinity
+      !rawIn.sign && isNormal,                           // 8 positiveNormal
+      !rawIn.sign && isFiniteNonzero && isSubnormal,     // 7 positiveSubnormal
+      !rawIn.sign && rawIn.isZero,                       // 6 positiveZero
+      rawIn.sign && rawIn.isZero,                        // 5 negativeZero
+      rawIn.sign && isFiniteNonzero && isSubnormal,      // 4 negativeSubnormal
+      rawIn.sign && isNormal,                            // 3 negativeNormal
+      rawIn.sign && rawIn.isInf,                         // 2 negativeInfinity
+      isQuietNaN,                                        // 1 quietNaN
+      isSigNaN)                                          // 0 signalingNaN
+  }
+
+  /** copySign / negate-copySign (spec/SimRISC-07 §3): every bit of `hc` except
+    * the format's sign bit, combined with the sign of `hd` (optionally
+    * inverted).  `hd` = 0 therefore yields `abs(hc)` / `-abs(hc)`.
+    */
+  def signInject(hc: UInt, hd: UInt, signPos: Int, invert: Boolean): UInt = {
+    // Both operands are 64-bit `rf` registers; the sign sits at bit 31 (ft) or
+    // 63 (fo) of that word, so the mask is formed at full register width.
+    val mask = (BigInt(1) << signPos).U(64.W)
+    val hdSign = if (invert) (hd & mask) ^ mask else hd & mask
+    (hc.pad(64) & ~mask) | hdSign
+  }
+
+  def classifyRecFN(expWidth: Int, sigWidth: Int, in: UInt): UInt =
+    classifyRaw(rawFloatFromRecFN(expWidth, sigWidth, in))
+
+  def classifyFN(expWidth: Int, sigWidth: Int, in: UInt): UInt =
+    classifyRaw(rawFloatFromFN(expWidth, sigWidth, in))
+}
+
+/** The single rounding primitive (hardfloat `RoundAnyRawFNToRecFN`).
+  *
+  * `in.sig` must have the canonical raw-float shape (`sig(inSigWidth)` = 0,
+  * `sig(inSigWidth-1)` = 1 for non-special values); the "significand MSB is
+  * always zero" variant that hardfloat uses for some arithmetic modules is not
+  * needed by the FP conversion family and is not implemented.
+  *
+  * Tininess is detected **after rounding** as spec/SimRISC-07 §1.4 requires,
+  * so there is no `detectTininess` port.  `exceptionFlags` is in `rf0[4:0]`
+  * order (`DADAO:`) and `infiniteExc` is the divide-by-zero input that the
+  * division family drives (unused by the conversion family).
+  */
+class WumingRoundAnyRawFNToRecFN(
+    inExpWidth: Int,
+    inSigWidth: Int,
+    outExpWidth: Int,
+    outSigWidth: Int)
+    extends Module {
+  val io = IO(new Bundle {
+    val invalidExc = Input(Bool()) // invalid operation (sNaN, 0*Inf, ...)
+    val infiniteExc = Input(Bool()) // divide by zero
+    val in = Input(new WumingRawFloat(inExpWidth, inSigWidth))
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(WumingRecFN.width(outExpWidth, outSigWidth).W))
+    // rf0[4:0] order: NV, DZ, OF, UF, NX
+    val exceptionFlags = Output(UInt(5.W))
+  })
+
+  // `neverUnderflows`/`neverOverflows` are hardfloat's names; the narrower input
+  // exponent range is exactly the widening-conversion case, where an
+  // underflow/overflow of the target format cannot occur.
+  val neverUnderflows = inExpWidth < outExpWidth
+  val neverOverflows = inExpWidth < outExpWidth
+
+  val outNaNExp = BigInt(7) << (outExpWidth - 2)
+  val outInfExp = BigInt(6) << (outExpWidth - 2)
+  val outMaxFiniteExp = outInfExp - 1
+  val outMinNormExp = WumingRecFN.minNormExp(outExpWidth)
+  val outMinNonzeroExp = outMinNormExp - outSigWidth + 1
+
+  val roundingMode_near_even = io.roundingMode === WumingRoundMode.RNE
+  val roundingMode_minMag = io.roundingMode === WumingRoundMode.RTZ
+  val roundingMode_min = io.roundingMode === WumingRoundMode.RDN
+  val roundingMode_max = io.roundingMode === WumingRoundMode.RUP
+  val roundingMode_near_maxMag = io.roundingMode === WumingRoundMode.RNA
+
+  // Rounding the magnitude up happens for RDN on a negative value and RUP on a
+  // positive one (hardfloat `roundMagUp`).
+  val roundMagUp =
+    (roundingMode_min && io.in.sign) || (roundingMode_max && !io.in.sign)
+
+  // ---- align the significand on the target exponent ----------------------
+  // `sAdjustedExp` re-bases the input exponent on the output bias; when the
+  // input format is narrower the sum is taken in the wider width and truncated
+  // back, which is what keeps the widening conversions exact.
+  val sAdjustedExp: SInt =
+    if (inExpWidth < outExpWidth) {
+      (io.in.sExp +&
+        ((BigInt(1) << outExpWidth) - (BigInt(1) << inExpWidth)).S)(outExpWidth, 0).zext
+    } else if (inExpWidth == outExpWidth) {
+      io.in.sExp
+    } else {
+      io.in.sExp +& ((BigInt(1) << outExpWidth) - (BigInt(1) << inExpWidth)).S
+    }
+
+  // Keep `outSigWidth + 2` significand bits: the hidden bit lands on bit
+  // `outSigWidth + 1`, bit 1 is the round bit and bit 0 the sticky bit.  A
+  // wider input folds every dropped bit into the sticky position.
+  val adjustedSig: UInt =
+    if (inSigWidth <= outSigWidth + 2) {
+      (io.in.sig << (outSigWidth - inSigWidth + 2))(outSigWidth + 2, 0)
+    } else {
+      io.in.sig(inSigWidth, inSigWidth - outSigWidth - 1) ##
+        io.in.sig(inSigWidth - outSigWidth - 2, 0).orR
+    }
+
+  // ---- rounding position -------------------------------------------------
+  // Base drop is 2 bits; a result below the smallest normal loses one further
+  // bit per step of denormalisation, because the subnormal quantum is coarser
+  // than the value's own last bit (hardfloat expresses the same thing as a
+  // growing round mask).  The cap only has to be wide enough to clear the whole
+  // significand; beyond that the result is zero (or the pegged minimum).
+  val sigWidthBits = outSigWidth + 3
+  val denormSteps = outMinNormExp.S - sAdjustedExp
+  val extraDrop =
+    Mux(denormSteps <= 0.S, 0.U,
+      Mux(denormSteps >= sigWidthBits.S, sigWidthBits.U(8.W),
+        denormSteps(7, 0)))
+  val drop = extraDrop + 2.U
+
+  // Mask of the bits strictly below the round bit: `drop - 1` low bits.
+  val fullMask = ((BigInt(1) << sigWidthBits) - 1).U(sigWidthBits.W)
+  val belowMask =
+    Mux(drop === 0.U, 0.U(sigWidthBits.W),
+      Mux(drop - 1.U >= sigWidthBits.U, fullMask,
+        fullMask >> (sigWidthBits.U - (drop - 1.U))))
+  val roundPosBit = Mux(drop >= 1.U, (adjustedSig >> (drop - 1.U))(0), false.B)
+  val anyRoundExtra = (adjustedSig & belowMask).orR
+  val anyRound = roundPosBit || anyRoundExtra
+
+  val kept = adjustedSig >> drop
+  val roundIncr =
+    (roundingMode_near_even && roundPosBit && (anyRoundExtra || kept(0))) ||
+      (roundingMode_near_maxMag && roundPosBit) ||
+      (roundMagUp && anyRound)
+  // Re-normalise the rounded magnitude: a subnormal result carries its
+  // significand shifted back up, so the recoded word has exactly one spelling
+  // (the decoder discards the redundant low bits anyway).  A rounded-up
+  // subnormal carries into bit `outSigWidth`, which is the exponent step.
+  val roundedSig =
+    ((kept +& roundIncr.asUInt) << extraDrop)(outSigWidth, 0)
+
+  // The exponent step from a rounding carry is a positive one: `asUInt.zext`
+  // (not `asSInt`, which would read the 1-bit carry as -1).
+  val expCarry = roundedSig(outSigWidth)
+  val sRoundedExp: SInt = sAdjustedExp +& expCarry.asUInt.zext
+
+  val common_expOut = sRoundedExp(outExpWidth, 0)
+  val common_fractOut = roundedSig(outSigWidth - 2, 0)
+
+  // Magnitude below the smallest positive value representable in the target
+  // format (rounds to zero); it also makes the result inexact.
+  val common_totalUnderflow =
+    if (neverUnderflows) false.B else sRoundedExp < outMinNonzeroExp.S
+  val common_overflow =
+    if (neverOverflows) false.B else (sRoundedExp >> (outExpWidth - 1) >= 3.S)
+  val common_inexact = common_totalUnderflow || anyRound
+  // Underflow: the *rounded* magnitude is below the smallest normal (tininess
+  // after rounding) and the rounding dropped a nonzero part.  A value that
+  // rounds up onto the smallest normal is therefore not tiny.
+  val common_underflow = common_inexact && (sRoundedExp < outMinNormExp.S)
+
+  // ---- special values and pegging ---------------------------------------
+  val isNaNOut = io.invalidExc || io.in.isNaN
+  val notNaN_isSpecialInfOut = io.infiniteExc || io.in.isInf
+  val commonCase = !isNaNOut && !notNaN_isSpecialInfOut && !io.in.isZero
+
+  val overflow = commonCase && common_overflow
+  val underflow = if (neverUnderflows) false.B else commonCase && common_underflow
+  val inexact = overflow || (commonCase && common_inexact)
+
+  val overflow_roundMagUp =
+    roundingMode_near_even || roundingMode_near_maxMag || roundMagUp
+  val pegMinNonzeroMagOut = commonCase && common_totalUnderflow && roundMagUp
+  val pegMaxFiniteMagOut = overflow && !overflow_roundMagUp
+  val notNaN_isInfOut =
+    notNaN_isSpecialInfOut || (overflow && overflow_roundMagUp)
+
+  val signOut = Mux(isNaNOut, false.B, io.in.sign)
+  val expOut =
+    (common_expOut &
+      ~Mux(io.in.isZero || common_totalUnderflow,
+        (BigInt(7) << (outExpWidth - 2)).U((outExpWidth + 1).W),
+        0.U((outExpWidth + 1).W)) &
+      ~Mux(pegMinNonzeroMagOut,
+        ~outMinNonzeroExp.U((outExpWidth + 1).W),
+        0.U((outExpWidth + 1).W)) &
+      ~Mux(pegMaxFiniteMagOut,
+        (BigInt(1) << (outExpWidth - 1)).U((outExpWidth + 1).W),
+        0.U((outExpWidth + 1).W)) &
+      ~Mux(notNaN_isInfOut,
+        (BigInt(1) << (outExpWidth - 2)).U((outExpWidth + 1).W),
+        0.U((outExpWidth + 1).W))) |
+      Mux(pegMinNonzeroMagOut, outMinNonzeroExp.U((outExpWidth + 1).W), 0.U) |
+      Mux(pegMaxFiniteMagOut, outMaxFiniteExp.U((outExpWidth + 1).W), 0.U) |
+      Mux(notNaN_isInfOut, outInfExp.U((outExpWidth + 1).W), 0.U) |
+      Mux(isNaNOut, outNaNExp.U((outExpWidth + 1).W), 0.U)
+
+  // DADAO: a quiet NaN input keeps its payload (truncated on narrowing, with
+  // the dropped bits OR-ed into the last payload bit; shifted up on widening).
+  // An invalid operation produces the canonical quiet NaN, like hardfloat.
+  val payload =
+    if (inSigWidth == outSigWidth) {
+      io.in.sig(outSigWidth - 2, 0)
+    } else if (inSigWidth > outSigWidth) {
+      io.in.sig(inSigWidth - 2, inSigWidth - outSigWidth) |
+        Fill(outSigWidth - 1, io.in.sig(inSigWidth - outSigWidth - 1, 0).orR)
+    } else {
+      io.in.sig(inSigWidth - 2, 0) << (outSigWidth - inSigWidth)
+    }
+  val quietBit = (BigInt(1) << (outSigWidth - 2)).U((outSigWidth - 1).W)
+  val nanFract = Mux(io.invalidExc || !io.in.isNaN,
+    quietBit,
+    payload.pad(outSigWidth - 1) | quietBit)
+
+  val fractOut =
+    Mux(isNaNOut || io.in.isZero || common_totalUnderflow,
+      Mux(isNaNOut, nanFract, 0.U),
+      common_fractOut) |
+      Fill(outSigWidth - 1, pegMaxFiniteMagOut)
+
+  io.out := signOut ## expOut ## fractOut
+  io.exceptionFlags :=
+    Cat(inexact, underflow, overflow, io.infiniteExc, io.invalidExc)
+}
+
+/** Floating-point -> integer (hardfloat `RecFNToIN.scala`), m12-chipyard-012.
+  *
+  * Converts one recoded float to an `intWidth`-bit integer with the requested
+  * rounding direction, saturating instead of raising (spec/SimRISC-07 §1.4:
+  * "NaN/Inf/超出目标整型范围 ⇒ 返回整型饱和值（最大/最小）并置 NV，不置 NX").
+  *
+  * The alignment trick is the same one hardfloat uses: shift the significand
+  * so that bit 2 of `alignedSig` becomes the units bit (bits 1/0 are then the
+  * half and sticky bits), then round the low two bits.  `DADAO:` the upstream
+  * module reports `{invalid, overflow, inexact}`; here the first two are folded
+  * into the single `NV` bit of `rf0[4:0]` because a conversion that cannot be
+  * represented in the destination integer is one IEEE "invalid operation"
+  * (spec/SimRISC-07 §1.4), not an overflow.
+  */
+class WumingRecFNToIN(expWidth: Int, sigWidth: Int, intWidth: Int)
+    extends Module {
+  val io = IO(new Bundle {
+    val in = Input(UInt(WumingRecFN.width(expWidth, sigWidth).W))
+    val roundingMode = Input(UInt(3.W))
+    val signedOut = Input(Bool())
+    val out = Output(UInt(intWidth.W))
+    val flags = Output(UInt(5.W)) // rf0[4:0] order
+  })
+
+  val rawIn = WumingRecFN.rawFloatFromRecFN(expWidth, sigWidth, io.in)
+
+  // `sExp` is the recoded exponent (= unbiased exponent + 2^expWidth), so
+  // |v| >= 1 exactly when its bit `expWidth` is set and `posExp` is then the
+  // unbiased exponent itself.  Everything in [0.5, 1) has `posExp` all ones
+  // with `magGeOne` clear.
+  val magGeOne = rawIn.sExp(expWidth)
+  val posExp = rawIn.sExp(expWidth - 1, 0)
+  val magJustBelowOne = !magGeOne && posExp.andR
+
+  // Shifting by the unbiased exponent puts the binary point two bits above the
+  // bottom of `alignedSig`.  The shift is capped at the point beyond which any
+  // result would overflow anyway (that case is decided from `posExp`, not from
+  // the shifted bits), which keeps the shifter small.
+  val shiftCap = math.min(expWidth - 2, log2Ceil(intWidth) - 1)
+  val shiftedSig = (magGeOne ## rawIn.sig(sigWidth - 2, 0)) <<
+    Mux(magGeOne, rawIn.sExp(shiftCap, 0), 0.U)
+  val alignedSig =
+    (shiftedSig >> (sigWidth - 2)) ## shiftedSig(sigWidth - 3, 0).orR
+  val unroundedInt = (alignedSig >> 2).pad(intWidth)
+
+  // Any non-zero bit below the units bit makes the result inexact; a value
+  // with magnitude below 1 is inexact unless it is exactly zero.
+  val common_inexact = Mux(magGeOne, alignedSig(1, 0).orR, !rawIn.isZero)
+  val roundIncr_near_even =
+    (magGeOne && (alignedSig(2, 1).andR || alignedSig(1, 0).andR)) ||
+      (magJustBelowOne && alignedSig(1, 0).orR)
+  val roundIncr_near_maxMag = (magGeOne && alignedSig(1)) || magJustBelowOne
+  // Rounding the magnitude away from zero: RDN on a negative value, RUP on a
+  // positive one (hardfloat `roundMagUp`).
+  val roundIncr =
+    (io.roundingMode === WumingRoundMode.RNE && roundIncr_near_even) ||
+      (io.roundingMode === WumingRoundMode.RNA && roundIncr_near_maxMag) ||
+      (io.roundingMode === WumingRoundMode.RDN && rawIn.sign && common_inexact) ||
+      (io.roundingMode === WumingRoundMode.RUP && !rawIn.sign && common_inexact)
+
+  // Two's-complement result: rounding up a negative value decrements it, which
+  // is the same as incrementing the complemented magnitude.
+  val complUnroundedInt = Mux(rawIn.sign, ~unroundedInt, unroundedInt)
+  val roundedInt =
+    Mux(roundIncr ^ rawIn.sign, complUnroundedInt + 1.U, complUnroundedInt)
+
+  // ---- destination range -------------------------------------------------
+  val magGeOne_atOverflowEdge = posExp === (intWidth - 1).U
+  // Adding the rounding increment carries out of the top of the magnitude.
+  val roundCarryBut2 = unroundedInt(intWidth - 3, 0).andR && roundIncr
+  val common_overflow = Mux(magGeOne,
+    posExp >= intWidth.U ||
+      Mux(io.signedOut,
+        Mux(rawIn.sign,
+          magGeOne_atOverflowEdge &&
+            (unroundedInt(intWidth - 2, 0).orR || roundIncr),
+          magGeOne_atOverflowEdge ||
+            ((posExp === (intWidth - 2).U) && roundCarryBut2)),
+        rawIn.sign ||
+          (magGeOne_atOverflowEdge && unroundedInt(intWidth - 2) &&
+            roundCarryBut2)),
+    // |v| < 1: only a negative value that rounds to -1 is out of range for an
+    // unsigned destination (rounding to 0 is exact-or-inexact, never invalid).
+    !io.signedOut && rawIn.sign && roundIncr)
+
+  val invalidExc = rawIn.isNaN || rawIn.isInf
+  val overflow = !invalidExc && common_overflow
+  val inexact = !invalidExc && !common_overflow && common_inexact
+
+  // Saturation value: the largest/smallest integer of the destination, with
+  // the sign of the input (a NaN counts as positive, as in hardfloat / QEMU /
+  // gem5's `toInt`).
+  val excSign = !rawIn.isNaN && rawIn.sign
+  val excOut =
+    Mux(io.signedOut === excSign,
+      (BigInt(1) << (intWidth - 1)).U(intWidth.W), 0.U(intWidth.W)) |
+      Mux(!excSign,
+        ((BigInt(1) << (intWidth - 1)) - 1).U(intWidth.W), 0.U(intWidth.W))
+
+  io.out := Mux(invalidExc || common_overflow, excOut, roundedInt)
+  io.flags := Cat(inexact, false.B, false.B, false.B, invalidExc || overflow)
+}
+
+/** Integer -> floating point (hardfloat `INToRecFN.scala` + `rawFloatFromIN`),
+  * m12-chipyard-012.
+  *
+  * The integer magnitude is normalised into a raw float and handed to the one
+  * rounding primitive, so integer->float shares the rounding, tininess and
+  * flag logic with every other conversion.  An integer is never tiny, so only
+  * `NX` (a precision loss) can be raised; the primitive's derived
+  * `neverUnderflows`/`neverOverflows` cover both because the integer exponent
+  * range is narrower than either IEEE format's.
+  */
+class WumingINToRecFN(intWidth: Int, outExpWidth: Int, outSigWidth: Int)
+    extends Module {
+  val io = IO(new Bundle {
+    val in = Input(UInt(64.W)) // the integer in the low `intWidth` bits
+    val signedIn = Input(Bool())
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W)) // rf0[4:0] order
+  })
+
+  // hardfloat's `rawFloatFromIN`: the exponent width follows from the integer
+  // width, so the largest magnitude (2^(intWidth-1)) is representable.
+  val inExpWidth = log2Ceil(intWidth) + 1
+  val inBits = io.in(intWidth - 1, 0)
+  val sign = io.signedIn && inBits(intWidth - 1)
+  val absIn = Mux(sign, (~inBits).asUInt + 1.U, inBits)
+  val isZero = absIn === 0.U
+  val normDist = WumingRecFN.countLeadingZeros(absIn)
+  // After the shift the hidden bit is at `intWidth - 1`, which is exactly the
+  // canonical raw-float shape for `inSigWidth = intWidth`.
+  val sigWide = (0.U(1.W) ## absIn) << normDist
+  val sExpU = (BigInt(1) << inExpWidth).U((inExpWidth + 2).W) +
+    (intWidth - 1).U - normDist
+
+  val raw = Wire(new WumingRawFloat(inExpWidth, intWidth))
+  raw.isNaN := false.B
+  raw.isInf := false.B
+  raw.isZero := isZero
+  raw.sign := sign
+  raw.sExp := Mux(isZero, 0.S, sExpU.asSInt)
+  raw.sig := Cat(0.U(1.W), sigWide(intWidth - 1, 0))
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    inExpWidth, intWidth, outExpWidth, outSigWidth))
+  rounder.io.in := raw
+  rounder.io.invalidExc := false.B
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := io.roundingMode
+
+  // The `rf` register holds IEEE binary (spec/SimRISC-00 §2.3), so the recoded
+  // result is decoded back before it leaves the unit.
+  io.out := WumingRecFN.fNFromRecFN(outExpWidth, outSigWidth,
+    rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** Float -> float format conversion (hardfloat `RoundAnyRawFNToRecFN`),
+  * m12-chipyard-012: `ft2fo` (widening, exact, SBZ) and `fo2ft` (narrowing,
+  * six rounding directions).
+  *
+  * An sNaN input raises `NV` and produces the canonical quiet NaN, which is
+  * what the other two engines do for a format conversion as well
+  * (`SimRISC-07 §1.4`: sNaN as an arithmetic input).
+  *
+  * Overflow follows IEEE 754-2019 §7.4 (spec/SimRISC-07 §1.4): the result is
+  * the unrounded magnitude rounded with an unbounded exponent range, so
+  * RNE/RNA give `±Inf`, RUP gives `+Inf` on a positive / `−ft_max` on a
+  * negative overflow, RDN gives `+ft_max` on a positive / `−Inf` on a negative
+  * one, and RTZ gives `±ft_max`; `OF|NX` is raised either way.  That is exactly
+  * what `WumingRoundAnyRawFNToRecFN` produces via `pegMaxFiniteMagOut`
+  * (m12-chipyard-025 removed the former "always ±Inf" override).
+  */
+class WumingF2F(
+    srcExpWidth: Int,
+    srcSigWidth: Int,
+    dstExpWidth: Int,
+    dstSigWidth: Int)
+    extends Module {
+  val io = IO(new Bundle {
+    val in = Input(UInt(64.W))
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W)) // rf0[4:0] order
+  })
+
+  val rawIn = WumingRecFN.rawFloatFromFN(srcExpWidth, srcSigWidth,
+    io.in(srcExpWidth + srcSigWidth - 1, 0))
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    srcExpWidth, srcSigWidth, dstExpWidth, dstSigWidth))
+  rounder.io.in := rawIn
+  rounder.io.invalidExc := rawIn.isSigNaN
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := io.roundingMode
+
+  io.out := WumingRecFN.fNFromRecFN(dstExpWidth, dstSigWidth,
+    rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** The kind selectors of `WumingFPConvert` (m12-chipyard-012). */
+object WumingCvtKind {
+  val F2I_FT_T = 0.U(4.W) // ft -> 32-bit integer  (ft2it / ft2ut)
+  val F2I_FT_O = 1.U(4.W) // ft -> 64-bit integer  (ft2io / ft2uo)
+  val F2I_FO_T = 2.U(4.W) // fo -> 32-bit integer  (fo2it / fo2ut)
+  val F2I_FO_O = 3.U(4.W) // fo -> 64-bit integer  (fo2io / fo2uo)
+  val I2F_T_FT = 4.U(4.W) // 32-bit integer -> ft (it2ft / ut2ft)
+  val I2F_O_FT = 5.U(4.W) // 64-bit integer -> ft (io2ft / uo2ft)
+  val I2F_T_FO = 6.U(4.W) // 32-bit integer -> fo (it2fo / ut2fo, exact)
+  val I2F_O_FO = 7.U(4.W) // 64-bit integer -> fo (io2fo / uo2fo)
+  val FT2FO = 8.U(4.W) // ft -> fo (exact, SBZ)
+  val FO2FT = 9.U(4.W) // fo -> ft (six directions)
+}
+
+/** Every conversion unit of spec/SimRISC-07 §1 behind one port, so the core
+  * instantiates and routes a single module (m12-chipyard-012).
+  *
+  * `signedOp` is the signedness of the *integer* side: `signedOut` for
+  * float->integer, `signedIn` for integer->float (unused by the two f2f
+  * kinds).  All results are returned at the `rd`/`rf` width the core writes.
+  */
+class WumingFPConvert extends Module {
+  val io = IO(new Bundle {
+    val kind = Input(UInt(4.W))
+    val mode = Input(UInt(3.W))
+    val in = Input(UInt(64.W))
+    val signedOp = Input(Bool())
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val f2iFtT = Module(new WumingRecFNToIN(
+    WumingFmt.ftExp, WumingFmt.ftSig, 32))
+  val f2iFtO = Module(new WumingRecFNToIN(
+    WumingFmt.ftExp, WumingFmt.ftSig, 64))
+  val f2iFoT = Module(new WumingRecFNToIN(
+    WumingFmt.foExp, WumingFmt.foSig, 32))
+  val f2iFoO = Module(new WumingRecFNToIN(
+    WumingFmt.foExp, WumingFmt.foSig, 64))
+  val i2fTFt = Module(new WumingINToRecFN(32, WumingFmt.ftExp, WumingFmt.ftSig))
+  val i2fOFt = Module(new WumingINToRecFN(64, WumingFmt.ftExp, WumingFmt.ftSig))
+  val i2fTFo = Module(new WumingINToRecFN(32, WumingFmt.foExp, WumingFmt.foSig))
+  val i2fOFo = Module(new WumingINToRecFN(64, WumingFmt.foExp, WumingFmt.foSig))
+  val ft2fo = Module(new WumingF2F(WumingFmt.ftExp, WumingFmt.ftSig,
+    WumingFmt.foExp, WumingFmt.foSig))
+  val fo2ft = Module(new WumingF2F(WumingFmt.foExp, WumingFmt.foSig,
+    WumingFmt.ftExp, WumingFmt.ftSig))
+
+  // ---- float -> integer: the recoded input comes from the ft/fo encoding ---
+  // `rawFloatFromFN` is combinational, so the recoding is done here once for
+  // the two ft and the two fo units instead of in each unit.
+  val ftRec = WumingRecFN.recFNFromFN(WumingFmt.ftExp, WumingFmt.ftSig,
+    io.in(31, 0))
+  val foRec = WumingRecFN.recFNFromFN(WumingFmt.foExp, WumingFmt.foSig, io.in)
+
+  for ((unit, rec) <- Seq(
+      (f2iFtT, ftRec), (f2iFtO, ftRec), (f2iFoT, foRec), (f2iFoO, foRec))) {
+    unit.io.in := rec
+  }
+  for (unit <- Seq(f2iFtT, f2iFtO, f2iFoT, f2iFoO)) {
+    unit.io.roundingMode := io.mode
+    unit.io.signedOut := io.signedOp
+  }
+
+  for (unit <- Seq(i2fTFt, i2fOFt, i2fTFo, i2fOFo)) {
+    unit.io.in := io.in
+    unit.io.signedIn := io.signedOp
+    unit.io.roundingMode := io.mode
+  }
+
+  for (unit <- Seq(ft2fo, fo2ft)) {
+    unit.io.in := io.in
+    unit.io.roundingMode := io.mode
+  }
+
+  // The SBZ conversions (`it2fo`/`ut2fo`, and the 32-bit -> fo widening) are
+  // exact: their result never depends on the rounding direction.
+  val out = WireDefault(0.U(64.W))
+  val flags = WireDefault(0.U(5.W))
+  switch(io.kind) {
+    is(WumingCvtKind.F2I_FT_T) {
+      // 32-bit results are widened to the 64-bit rd: sign for signed, zero for
+      // unsigned (spec/SimRISC-04 §2 value semantics).
+      out := Mux(io.signedOp, f2iFtT.io.out.asSInt.pad(64).asUInt,
+        f2iFtT.io.out.pad(64))
+      flags := f2iFtT.io.flags
+    }
+    is(WumingCvtKind.F2I_FT_O) {
+      out := f2iFtO.io.out; flags := f2iFtO.io.flags
+    }
+    is(WumingCvtKind.F2I_FO_T) {
+      out := Mux(io.signedOp, f2iFoT.io.out.asSInt.pad(64).asUInt,
+        f2iFoT.io.out.pad(64))
+      flags := f2iFoT.io.flags
+    }
+    is(WumingCvtKind.F2I_FO_O) {
+      out := f2iFoO.io.out; flags := f2iFoO.io.flags
+    }
+    is(WumingCvtKind.I2F_T_FT) {
+      out := i2fTFt.io.out; flags := i2fTFt.io.flags
+    }
+    is(WumingCvtKind.I2F_O_FT) {
+      out := i2fOFt.io.out; flags := i2fOFt.io.flags
+    }
+    is(WumingCvtKind.I2F_T_FO) {
+      out := i2fTFo.io.out; flags := i2fTFo.io.flags
+    }
+    is(WumingCvtKind.I2F_O_FO) {
+      out := i2fOFo.io.out; flags := i2fOFo.io.flags
+    }
+    is(WumingCvtKind.FT2FO) {
+      out := ft2fo.io.out; flags := ft2fo.io.flags
+    }
+    is(WumingCvtKind.FO2FT) {
+      out := fo2ft.io.out; flags := fo2ft.io.flags
+    }
+  }
+  io.out := out
+  io.flags := flags
+}
+
+/** The operations behind `WumingFPArith` (spec/SimRISC-07 §2). */
+object WumingFPArithOp {
+  val ADD = 0.U(3.W) // ftadd / foadd            (spec §2.1)
+  val SUB = 1.U(3.W) // ftsub / fosub            (add with the sign of b inverted)
+  val MUL = 2.U(3.W) // ftmul / fomul            (spec §2.1)
+  val FMA = 3.U(3.W) // ftfma / fofma            (spec §2.5, single rounding)
+  val MIN = 4.U(3.W) // ftmin / fomin            (spec §2.4)
+  val MAX = 5.U(3.W) // ftmax / fomax
+  val QCMP = 6.U(3.W) // ftqcmp / foqcmp         (spec §4)
+  val SCMP = 7.U(3.W) // ftscmp / foscmp
+}
+
+/** Fixed-point helpers shared by the arithmetic units (m12-chipyard-013).
+  *
+  * The three rounding operations (add/sub, multiply, fused multiply-add) are
+  * computed as *exact* integer significands at a common scale, then normalised
+  * into the single rounding primitive (`WumingRoundAnyRawFNToRecFN`).  Two
+  * guard bits below the target significand carry the round bit and the sticky
+  * bit; four more window bits let the smaller operand of a sum stay exact
+  * whenever a cancellation is possible.
+  */
+object WumingFPAlu {
+  /** Index of the most significant set bit of `in`; 0 when `in` is zero.
+    *
+    * `PriorityEncoder(in.asBools.reverse)` is hardfloat's `countLeadingZeros`
+    * (the number of leading zeros, not the bit index), so it is subtracted
+    * from the width here.  An all-zero input returns 0 explicitly (Chisel's
+    * `PriorityEncoder` answers 0 for it, which would alias bit `width-1`).
+    */
+  def msbIndex(in: UInt): UInt = {
+    val n = in.getWidth
+    val leadingZeros = PriorityEncoder(in.asBools.reverse)
+    Mux(in.orR, (n - 1).U - leadingZeros, 0.U)
+  }
+
+  /** `sig * 2^sh` placed in a `w`-bit window (negative `sh` shifts right).
+    *
+    * Returns `(window, sticky)` where `window` is the magnitude truncated
+    * towards zero and `sticky` is set when any bit of `sig` fell out of the
+    * window.  The window is the magnitude's integer part at the caller's scale
+    * and `sticky` is the "there is something below the window" flag, which is
+    * exactly the guard/round/sticky contract of the rounding primitive.
+    */
+  def place(sig: UInt, sh: SInt, w: Int): (UInt, Bool) = {
+    val lw = log2Ceil(w + 1)
+    val left = sh >= 0.S
+    val mag = Mux(left, sh.asUInt, (-sh).asUInt)
+    val over = mag >= w.U
+    val m = Mux(over, (w - 1).U, mag)(lw - 1, 0)
+
+    val leftShifted = sig << m
+    val leftBits = leftShifted(w - 1, 0)
+    val leftDropped = (leftShifted >> w).orR
+
+    // `pad` keeps the discarded low bits visible in the comparison below.
+    val rightWide = sig.pad(sig.getWidth + w + 1)
+    val rightShifted = rightWide >> m
+    val rightBits = rightShifted(w - 1, 0)
+    val rightDropped = ((rightShifted << m) =/= rightWide)
+
+    val bits = Mux(over, 0.U, Mux(left, leftBits, rightBits))
+    val sticky = Mux(over, sig.orR, Mux(left, leftDropped, rightDropped))
+    (bits, sticky)
+  }
+
+  /** Normalise the fixed-point magnitude `mag * 2^qExp` into the rounding
+    * primitive's input form for a `sigWidth`-wide significand: a
+    * `sigWidth+2`-bit word whose bit `sigWidth+1` is the hidden bit and whose
+    * two low bits are the round bit and the sticky flag.
+    *
+    * The recoded exponent is `qExp + msbIndex + 2^expWidth` (the scale
+    * relation `value = sig * 2^(sExp - 2^expWidth - (sigWidth+1))`), clamped
+    * into the overflow region rather than wrapping: a magnitude that large is
+    * an overflow for the rounding primitive to report, never a value.
+    */
+  def normalise(mag: UInt, qExp: SInt, expWidth: Int, sigWidth: Int)
+      : (UInt, SInt) = {
+    val top = sigWidth + 1
+    val k = msbIndex(mag)
+    val down = Mux(k > top.U, k - top.U, 0.U)
+    val up = Mux(k < top.U, top.U - k, 0.U)
+
+    val shiftedDown = mag >> down
+    val hi = shiftedDown(top, 0)
+    val dropped = (shiftedDown << down) =/= mag
+    val sigRight = Cat(hi(top, 1), hi(0) || dropped)
+    val sigLeft = (mag << up)(top, 0)
+    val sig = Mux(k <= top.U, sigLeft, sigRight)
+
+    val kS = k.pad(qExp.getWidth + 1).asSInt
+    val unit = (BigInt(1) << expWidth).S((qExp.getWidth + 2).W)
+    val sExpWide = qExp + kS + unit
+    // `outInfExp + 2` (6 << (expWidth-2)) is inside the overflow region the
+    // primitive tests for (`sRoundedExp >> (expWidth-1) >= 3`).
+    val maxSExp = ((BigInt(6) << (expWidth - 2)) + 2).S(sExpWide.getWidth.W)
+    val clamped =
+      Mux(sExpWide > maxSExp, maxSExp,
+        Mux(sExpWide < 0.S, 0.S(sExpWide.getWidth.W), sExpWide))
+    (sig, clamped(expWidth + 1, 0).asSInt)
+  }
+}
+
+/** Addition / subtraction (hardfloat `AddRecFN`), spec/SimRISC-07 §2.1.
+  *
+  * The two magnitudes are aligned in a fixed-point window whose least
+  * significant bit sits below the larger operand's LSB: the larger operand is
+  * exact and the smaller one loses only bits below the window (folded into the
+  * sticky flag).  With opposite signs the *magnitude* is
+  * `floor(|large| - |small|)` and the sticky flag says whether a positive
+  * remainder follows, which is precisely how the rounding primitive wants a
+  * value it must round.
+  *
+  * `DADAO:` a quiet NaN input propagates its payload (spec/SimRISC-07 §1.4);
+  * a signalling NaN or `Inf + (-Inf)` raises `NV` and returns the canonical
+  * quiet NaN (the rounding primitive's `invalidExc` path).
+  */
+class WumingAddRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val subOp = Input(Bool())
+    val a = Input(UInt(64.W)) // IEEE binary (ft uses the low 32 bits)
+    val b = Input(UInt(64.W))
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W)) // rf0[4:0] order
+  })
+
+  val guard = 4
+  val win = sigWidth + 2 + guard
+
+  val rawA = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.a(expWidth + sigWidth - 1, 0))
+  val rawB = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.b(expWidth + sigWidth - 1, 0))
+  val signB = rawB.sign ^ io.subOp
+
+  // The datapath only sees finite non-zero magnitudes.  A special operand
+  // contributes a zero significand at the smallest exponent (so it loses every
+  // magnitude comparison and never disturbs the alignment) and the result is
+  // overridden below.
+  val specA = rawA.isNaN || rawA.isInf || rawA.isZero
+  val specB = rawB.isNaN || rawB.isInf || rawB.isZero
+  val sigA = Mux(specA, 0.U, rawA.sig(sigWidth - 1, 0))
+  val sigB = Mux(specB, 0.U, rawB.sig(sigWidth - 1, 0))
+  val expA = Mux(specA, 0.S, rawA.sExp)
+  val expB = Mux(specB, 0.S, rawB.sExp)
+
+  // The larger magnitude is the one placed at the top of the window, so only
+  // the smaller one can lose bits.
+  val aLarger = (expA > expB) || (expA === expB && sigA >= sigB)
+  val largeSig = Mux(aLarger, sigA, sigB)
+  val smallSig = Mux(aLarger, sigB, sigA)
+  val largeExp = Mux(aLarger, expA, expB)
+  val smallExp = Mux(aLarger, expB, expA)
+
+  // Window units: 2^(largeExp - (sigWidth-1) - guard).
+  val smallShift = guard.S - (largeExp - smallExp)
+  val (smallWin, smallSticky) = WumingFPAlu.place(smallSig, smallShift, win)
+  val largeWin = (largeSig.pad(win) << guard)(win - 1, 0)
+
+  val sameSign = rawA.sign === signB
+  val magAbs = Mux(sameSign, largeWin +& smallWin,
+    largeWin - smallWin - smallSticky.asUInt)
+  val sticky = smallSticky
+
+  val signLarge = Mux(aLarger, rawA.sign, signB)
+  val sumSign = Mux(sameSign, rawA.sign, signLarge)
+
+  // Window units: 2^(largeExp - 2^expWidth - (sigWidth-1) - guard), i.e. the
+  // scale the recoded exponent is expressed in.
+  val qExp = largeExp - (BigInt(1) << expWidth).S - (sigWidth - 1).S - guard.S
+  val (sigNorm, sExpNorm) = WumingFPAlu.normalise(magAbs, qExp, expWidth, sigWidth)
+  // A magnitude below one window unit: the exact value is in (0, 2^qExp) and
+  // `qExp` is at least `guard` bits below the smallest subnormal quantum, so
+  // the primitive's total-underflow path rounds it to zero (or pegs the
+  // smallest magnitude) with UF|NX.
+  val tinyOnly = (magAbs === 0.U) && sticky
+  // The smaller operand's dropped bits are the result's sticky bit; they must
+  // ride along in the rounder's LSB whatever the normalisation did.
+  val sigOut = Mux(tinyOnly, 1.U, sigNorm | sticky.asUInt)
+
+  val invalidExc = rawA.isSigNaN || rawB.isSigNaN ||
+    (rawA.isInf && rawB.isInf && (rawA.sign =/= signB))
+  val nanIn = rawA.isNaN || rawB.isNaN
+  val isInfOut = (rawA.isInf || rawB.isInf) && !invalidExc
+  val infSign = Mux(rawA.isInf, rawA.sign, signB)
+  val zeroSign = Mux(rawA.sign === signB, rawA.sign,
+    io.roundingMode === WumingRoundMode.RDN)
+  val exactZero = (magAbs === 0.U) && !sticky && !isInfOut && !nanIn
+
+  // First NaN wins (a quiet NaN keeps its payload, spec/SimRISC-07 §1.4); the
+  // primitive expects the payload at `inSigWidth-2` downwards, i.e. shifted up
+  // by the two guard bits of the arithmetic input.
+  val nanSrc = Mux(rawA.isNaN, rawA, rawB)
+  val nanSig = (nanSrc.sig << 2)(sigWidth + 2, 0)
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    expWidth, sigWidth + 2, expWidth, sigWidth))
+  rounder.io.in.isNaN := nanIn
+  rounder.io.in.isInf := isInfOut
+  rounder.io.in.isZero := exactZero
+  rounder.io.in.sign := Mux(isInfOut, infSign, Mux(exactZero, zeroSign, sumSign))
+  rounder.io.in.sExp := Mux(isInfOut || exactZero, 0.S, sExpNorm)
+  rounder.io.in.sig := Mux(nanIn, nanSig.pad(sigWidth + 3),
+    Mux(isInfOut || exactZero, 0.U, sigOut.pad(sigWidth + 3)))
+  rounder.io.invalidExc := invalidExc
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := io.roundingMode
+
+  io.out := WumingRecFN.fNFromRecFN(expWidth, sigWidth, rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** Multiplication (hardfloat `MulRecFN`), spec/SimRISC-07 §2.1.
+  *
+  * The significands are multiplied exactly (a `2*sigWidth`-bit product) and
+  * rounded once, so the result is the correctly rounded product rather than a
+  * sequence of rounded partial products.
+  */
+class WumingMulRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val a = Input(UInt(64.W))
+    val b = Input(UInt(64.W))
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val rawA = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.a(expWidth + sigWidth - 1, 0))
+  val rawB = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.b(expWidth + sigWidth - 1, 0))
+
+  val specA = rawA.isNaN || rawA.isInf || rawA.isZero
+  val specB = rawB.isNaN || rawB.isInf || rawB.isZero
+  val sigA = Mux(specA, 0.U, rawA.sig(sigWidth - 1, 0))
+  val sigB = Mux(specB, 0.U, rawB.sig(sigWidth - 1, 0))
+  val expA = Mux(specA, 0.S, rawA.sExp)
+  val expB = Mux(specB, 0.S, rawB.sExp)
+
+  // value = pSig * 2^(sExpA + sExpB - 2^(expWidth+1) - 2*(sigWidth-1))
+  val pSig = (sigA * sigB)(2 * sigWidth - 1, 0)
+  val pExp = (expA +& expB) -
+    ((BigInt(1) << (expWidth + 1)) + 2 * (sigWidth - 1)).S((expWidth + 4).W)
+  val (sigNorm, sExpNorm) =
+    WumingFPAlu.normalise(pSig, pExp, expWidth, sigWidth)
+
+  val signProd = rawA.sign ^ rawB.sign
+  val invalidExc = rawA.isSigNaN || rawB.isSigNaN ||
+    (rawA.isInf && rawB.isZero) || (rawA.isZero && rawB.isInf)
+  val nanIn = rawA.isNaN || rawB.isNaN
+  val isInfOut = (rawA.isInf || rawB.isInf) && !invalidExc
+  val isZeroOut = (rawA.isZero || rawB.isZero) && !invalidExc && !nanIn
+
+  val nanSrc = Mux(rawA.isNaN, rawA, rawB)
+  val nanSig = (nanSrc.sig << 2)(sigWidth + 2, 0)
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    expWidth, sigWidth + 2, expWidth, sigWidth))
+  rounder.io.in.isNaN := nanIn
+  rounder.io.in.isInf := isInfOut
+  rounder.io.in.isZero := isZeroOut
+  rounder.io.in.sign := signProd
+  rounder.io.in.sExp := Mux(isInfOut || isZeroOut, 0.S, sExpNorm)
+  rounder.io.in.sig := Mux(nanIn, nanSig.pad(sigWidth + 3),
+    Mux(isInfOut || isZeroOut, 0.U, sigNorm.pad(sigWidth + 3)))
+  rounder.io.invalidExc := invalidExc
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := io.roundingMode
+
+  io.out := WumingRecFN.fNFromRecFN(expWidth, sigWidth, rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** Fused multiply-add (hardfloat `MulAddRecFN`), spec/SimRISC-07 §2.5.
+  *
+  * The product is formed exactly (`2*sigWidth` bits) and added to the addend at
+  * a common scale, so the sum is rounded **once**: the result is
+  * `fma(a, b, c)`, not `round(round(a*b) + c)`.  The window is two
+  * significands wide plus the guard bits, and it is anchored on whichever of the
+  * product and the addend has the higher exponent, so that operand stays exact;
+  * only the other one can be truncated, and only below the rounding position.
+  *
+  * `DADAO:` the contract fixes the NaN result of this family to the canonical
+  * quiet NaN (spec/SimRISC-07 §2.5 "canonical 化"), so no payload is passed to
+  * the primitive here.
+  */
+class WumingMulAddRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val a = Input(UInt(64.W)) // multiplicand (rfHB)
+    val b = Input(UInt(64.W)) // multiplier   (rfHC)
+    val c = Input(UInt(64.W)) // addend       (rfHD)
+    val roundingMode = Input(UInt(3.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val guard = 4
+  val win = 2 * sigWidth + 2 + guard
+
+  val rawA = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.a(expWidth + sigWidth - 1, 0))
+  val rawB = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.b(expWidth + sigWidth - 1, 0))
+  val rawC = WumingRecFN.rawFloatFromFN(expWidth, sigWidth,
+    io.c(expWidth + sigWidth - 1, 0))
+
+  val specA = rawA.isNaN || rawA.isInf || rawA.isZero
+  val specB = rawB.isNaN || rawB.isInf || rawB.isZero
+  val specC = rawC.isNaN || rawC.isInf || rawC.isZero
+  val sigA = Mux(specA, 0.U, rawA.sig(sigWidth - 1, 0))
+  val sigB = Mux(specB, 0.U, rawB.sig(sigWidth - 1, 0))
+  val sigC = Mux(specC, 0.U, rawC.sig(sigWidth - 1, 0))
+  val expC = Mux(specC, 0.S, rawC.sExp)
+
+  val pSig = (sigA * sigB)(2 * sigWidth - 1, 0)
+  // Product least significant bit: value = pSig * 2^pExp.
+  val pExp = (Mux(specA, 0.S, rawA.sExp) +& Mux(specB, 0.S, rawB.sExp)) -
+    ((BigInt(1) << (expWidth + 1)) + 2 * (sigWidth - 1)).S((expWidth + 4).W)
+  val cExp = Mux(specC, 0.S, rawC.sExp) - (BigInt(1) << expWidth).S - (sigWidth - 1).S
+
+  // Anchor the window on the operand with the higher top bit, so that operand
+  // is exact (the product occupies `2*sigWidth` bits from the window top, the
+  // addend `sigWidth`).
+  val tP = pExp + (2 * sigWidth - 1).S
+  val tC = cExp + (sigWidth - 1).S
+  val cDominant = tC >= tP
+  val qExp = Mux(cDominant, tC, tP) - (win - 1).S
+  val (pWin, pSticky) = WumingFPAlu.place(pSig, pExp - qExp, win)
+  val (cWin, cSticky) = WumingFPAlu.place(sigC, cExp - qExp, win)
+
+  // Magnitude order of the two summands; on equal window values the one with a
+  // truncated remainder is the larger one.
+  val pLarger = (pWin > cWin) || ((pWin === cWin) && !cSticky)
+  val sameSign = (rawA.sign ^ rawB.sign) === rawC.sign
+  val magAbs = Mux(sameSign, pWin +& cWin,
+    Mux(pLarger, pWin - cWin - cSticky.asUInt,
+      cWin - pWin - pSticky.asUInt))
+  val sticky = Mux(sameSign, pSticky || cSticky, Mux(pLarger, cSticky, pSticky))
+
+  val signProd = rawA.sign ^ rawB.sign
+  val sumSign = Mux(sameSign, signProd, Mux(pLarger, signProd, rawC.sign))
+  val zeroSign = Mux(signProd === rawC.sign, signProd,
+    io.roundingMode === WumingRoundMode.RDN)
+
+  val (sigNorm, sExpNorm) = WumingFPAlu.normalise(magAbs, qExp, expWidth, sigWidth)
+  val tinyOnly = (magAbs === 0.U) && sticky
+  // The truncated summand's dropped bits are the result's sticky bit (see the
+  // adder's note).
+  val sigOut = Mux(tinyOnly, 1.U, sigNorm | sticky.asUInt)
+
+  // ---- special values (spec/SimRISC-07 §2.5) ------------------------------
+  // `prodInf` means "the product is +-Inf", which needs both factors to be
+  // numbers: a NaN multiplicand makes the product NaN even when the other
+  // factor is an infinity (the Inf rule is "Inf x finite non-zero").
+  val mulNan = rawA.isNaN || rawB.isNaN
+  val prodInf = (rawA.isInf || rawB.isInf) && !mulNan
+  // 0 x Inf is invalid even when the addend is a quiet NaN.
+  val infZero = (rawA.isInf && rawB.isZero) || (rawA.isZero && rawB.isInf)
+  val infDiff = prodInf && rawC.isInf && (signProd =/= rawC.sign)
+  val invalidExc = rawA.isSigNaN || rawB.isSigNaN || rawC.isSigNaN ||
+    infZero || infDiff
+  val nanIn = rawA.isNaN || rawB.isNaN || rawC.isNaN
+  val isInfOut = (prodInf || rawC.isInf) && !invalidExc
+  val infSign = Mux(prodInf, signProd, rawC.sign)
+  val exactZero = (magAbs === 0.U) && !sticky && !isInfOut && !nanIn
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    expWidth, sigWidth + 2, expWidth, sigWidth))
+  rounder.io.in.isNaN := nanIn
+  rounder.io.in.isInf := isInfOut
+  rounder.io.in.isZero := exactZero
+  rounder.io.in.sign := Mux(isInfOut, infSign, Mux(exactZero, zeroSign, sumSign))
+  rounder.io.in.sExp := Mux(isInfOut || exactZero, 0.S, sExpNorm)
+  // The fused family's NaN result is canonical (spec/SimRISC-07 §2.5), so no
+  // payload is handed to the primitive.
+  rounder.io.in.sig := Mux(nanIn || isInfOut || exactZero, 0.U,
+    sigOut.pad(sigWidth + 3))
+  rounder.io.invalidExc := invalidExc
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := io.roundingMode
+
+  io.out := WumingRecFN.fNFromRecFN(expWidth, sigWidth, rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** Division and square root (hardfloat `DivSqrtRecFN_small` semantics),
+  * spec/SimRISC-07 §2.1 (`fodiv`) / §2.2 (`foroot` = `rootn(x, 2)`),
+  * m12-chipyard-014.
+  *
+  * A one-bit-per-cycle fixed-point state machine: `start` latches the operands
+  * and `done` pulses for one cycle once `out`/`flags` are settled.  The
+  * iteration count is fixed (`sigWidth + 2` steps for both operations), so the
+  * latency does not depend on the operands.
+  *
+  * Division keeps an exact *truncated* quotient together with the remainder
+  * the truncation threw away: `Q = floor(|a| / |b| * 2^N)` with
+  * `N = sigWidth + 2` holds the quotient's digits down to and past the
+  * rounding position, and `R != 0` says the quotient continues below them.
+  * That pair is exactly the `(significand, round bit, sticky)` form the
+  * rounding primitive wants, so the result is rounded once from the exact
+  * quotient.
+  *
+  * Square root works digit by digit the same way: `root = floor(sqrt(X))` over
+  * a radicand scaled to an even exponent, `rem != 0` marking the irrational
+  * tail.  `rootn(-0, 2)` is unspecified by spec §2.2; -0 is returned, which is
+  * what both reference engines produce.
+  *
+  * `DADAO:` a quiet NaN input propagates its payload and a signalling NaN or
+  * an invalid operation (0/0, Inf/Inf, sqrt of a negative number) produces the
+  * canonical quiet NaN with `NV` (spec/SimRISC-07 §1.4).  The divide-by-zero
+  * lane splits its two roles: `infiniteExc` is the sole source of `DZ` (and,
+  * with `sExp = 0`, already pegs the exponent to infinity), while `in.isInf`
+  * carries the `±Inf` results that raise no `DZ` (infinite dividend,
+  * `sqrt(+Inf)`), as hardfloat splits them; both are family-level, not per shape.
+  */
+class WumingDivSqrtRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val start  = Input(Bool())
+    val sqrtOp = Input(Bool())
+    val a      = Input(UInt(64.W)) // dividend / radicand (rfHC)
+    val b      = Input(UInt(64.W)) // divisor (rfHD), unused for the root
+    val mode   = Input(UInt(3.W))
+    val out    = Output(UInt(64.W))
+    val flags  = Output(UInt(5.W))
+    val done   = Output(Bool())
+    val busy   = Output(Bool())
+  })
+
+  val sw = sigWidth
+  val ew = expWidth
+  val nSteps = sw + 2            // quotient bits (div) / radicand digit pairs
+
+  val rawA = WumingRecFN.rawFloatFromFN(ew, sw, io.a(ew + sw - 1, 0))
+  val rawB = WumingRecFN.rawFloatFromFN(ew, sw, io.b(ew + sw - 1, 0))
+
+  // ---- special values (hardfloat's DivSqrtRawFN_small decode) ------------
+  val invalidDiv  = (rawA.isZero && rawB.isZero) || (rawA.isInf && rawB.isInf)
+  val invalidSqrt = !rawA.isNaN && !rawA.isZero && rawA.sign
+  val invalid = Mux(io.sqrtOp, rawA.isSigNaN || invalidSqrt,
+    rawA.isSigNaN || rawB.isSigNaN || invalidDiv)
+  val nanIn = Mux(io.sqrtOp, rawA.isNaN, rawA.isNaN || rawB.isNaN)
+  // A *finite non-zero* dividend over zero is the one divide-by-zero: 0/0 is
+  // the invalid case above and an infinity over zero is infinite without a
+  // `DZ` (softfloat and hardfloat both order them that way).
+  val divZero = !io.sqrtOp && !rawA.isNaN && !rawA.isInf && !rawA.isZero &&
+    rawB.isZero
+  val infOut = Mux(io.sqrtOp, rawA.isInf, rawA.isInf || rawB.isZero)
+  val zeroOut = Mux(io.sqrtOp, rawA.isZero, rawA.isZero || rawB.isInf)
+  val normal = Mux(io.sqrtOp,
+    !(rawA.isNaN || rawA.isInf || rawA.isZero) && !rawA.sign,
+    !(rawA.isNaN || rawA.isInf || rawA.isZero) &&
+      !(rawB.isNaN || rawB.isInf || rawB.isZero))
+  val sign = Mux(io.sqrtOp, rawA.sign, rawA.sign ^ rawB.sign)
+  val nanSrc = Mux(rawA.isNaN, rawA, rawB)
+  val nanSig = (nanSrc.sig << 2)(sw + 2, 0)
+
+  // ---- exponent bookkeeping ---------------------------------------------
+  // `ea` is the exponent of the significand's least significant bit:
+  // value = sig * 2^(sExp - 2^expWidth - (sigWidth-1)).
+  val ea = rawA.sExp - (BigInt(1) << ew).S - (sw - 1).S
+  val dExp = rawA.sExp - rawB.sExp
+  // Square root: sqrt(sig * 2^ea) = sqrt(sig << (sw+2+p)) * 2^((ea-sw-2-p)/2),
+  // where p = (ea - (sw+2)) mod 2 makes the half exponent integral.
+  val pBit = ea(0) ^ ((sw + 2) % 2).B
+  val pS = Mux(pBit, 1.S(4.W), 0.S(4.W))
+  val sqrtExp = (ea - (sw + 2).S - pS) >> 1
+  val divExp = dExp - nSteps.S
+
+  // ---- state -------------------------------------------------------------
+  val busy = RegInit(false.B)
+  val doneReg = RegInit(false.B)
+  val step = RegInit(0.U(log2Ceil(nSteps + 1).W))
+  val loopZ = RegInit(false.B)
+  val sqrtZ = RegInit(false.B)
+  val remZ = RegInit(0.U((sw + 5).W))
+  val sigZ = RegInit(0.U((sw + 3).W))
+  val xZ = RegInit(0.U((2 * sw + 4).W))
+  val mbZ = RegInit(0.U(sw.W))
+  val qExpZ = RegInit(0.S((ew + 6).W))
+  val signZ = RegInit(false.B)
+  val invalidZ = RegInit(false.B)
+  val divZeroZ = RegInit(false.B)
+  val nanInZ = RegInit(false.B)
+  val infZ = RegInit(false.B)
+  val zeroZ = RegInit(false.B)
+  val nanSigZ = RegInit(0.U((sw + 3).W))
+
+  val lastStep = step === (nSteps - 1).U
+  val startNow = io.start && !busy
+
+  // Quotient bit (division) and root digit (square root) of this cycle.
+  val divRem2 = remZ << 1
+  val divBit = divRem2 >= mbZ.pad(sw + 6)
+  val divSig = (sigZ << 1) | divBit
+  val divRem = Mux(divBit, divRem2 - mbZ.pad(sw + 6), divRem2)
+
+  // The radicand register is shifted left by two each step, so the digit pair
+  // being consumed always sits at the top of the register (constant indices).
+  val pairBits = xZ(2 * nSteps - 1, 2 * nSteps - 2)
+  val sqrtRem2 = (remZ << 2) | pairBits.pad(3)
+  val sqrtTrial = (sigZ << 2) | 1.U
+  val sqrtBit = sqrtRem2 >= sqrtTrial.pad(sw + 7)
+  val sqrtSig = (sigZ << 1) | sqrtBit
+  val sqrtRem = Mux(sqrtBit, sqrtRem2 - sqrtTrial.pad(sw + 7), sqrtRem2)
+
+  // The significand ratio lies in (0.5, 2), so the quotient's integer part is
+  // the single bit `ma >= mb`; taking it out first leaves a remainder below the
+  // divisor, which is the invariant every following step relies on.
+  val leadBit = rawA.sig(sw - 1, 0) >= rawB.sig(sw - 1, 0)
+  val leadRem = Mux(leadBit,
+    (rawA.sig(sw - 1, 0) - rawB.sig(sw - 1, 0))(sw - 1, 0), rawA.sig(sw - 1, 0))
+
+  when(startNow) {
+    busy := normal
+    loopZ := normal
+    step := 0.U
+    sqrtZ := io.sqrtOp
+    remZ := Mux(io.sqrtOp, 0.U(sw + 5), leadRem.pad(sw + 5))
+    sigZ := Mux(io.sqrtOp, 0.U(sw + 3), Cat(Fill(sw + 2, false.B), leadBit))
+    // Radicand: sig << (sw+2+p), i.e. the same scale the exponent path uses.
+    xZ := Mux(pBit,
+      (rawA.sig(sw - 1, 0).pad(2 * sw + 4) << (sw + 3))(2 * sw + 3, 0),
+      (rawA.sig(sw - 1, 0).pad(2 * sw + 4) << (sw + 2))(2 * sw + 3, 0))
+    mbZ := rawB.sig(sw - 1, 0)
+    qExpZ := Mux(io.sqrtOp, sqrtExp, divExp).pad(ew + 6)
+    signZ := sign
+    invalidZ := invalid
+    divZeroZ := divZero
+    nanInZ := nanIn
+    infZ := infOut
+    zeroZ := zeroOut
+    nanSigZ := nanSig.pad(sw + 3)
+  }.elsewhen(busy) {
+    step := step + 1.U
+    when(loopZ) {
+      remZ := Mux(sqrtZ, sqrtRem, divRem)(sw + 4, 0)
+      sigZ := Mux(sqrtZ, sqrtSig, divSig)(sw + 2, 0)
+      xZ := Mux(sqrtZ, (xZ << 2)(2 * sw + 3, 0), xZ)
+    }
+    when(lastStep) { busy := false.B }
+  }
+  // A special-value operation has no iteration: its result is ready one cycle
+  // after `start` (the same `done` shape as the remainder's no-loop path).
+  doneReg := (busy && lastStep) || (startNow && !normal)
+  io.done := doneReg
+  io.busy := busy
+
+  // ---- result ------------------------------------------------------------
+  // `R != 0` is the sticky bit: the quotient/root continues below its last
+  // computed digit.  The rounding primitive consumes both from here.
+  val (sigNorm, sExpNorm) = WumingFPAlu.normalise(sigZ, qExpZ, ew, sw)
+  val sigOut = sigNorm | remZ.orR
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(ew, sw + 2, ew, sw))
+  rounder.io.in.isNaN := nanInZ
+  rounder.io.in.isInf := infZ
+  rounder.io.in.isZero := zeroZ
+  rounder.io.in.sign := signZ
+  rounder.io.in.sExp := Mux(loopZ, sExpNorm, 0.S)
+  rounder.io.in.sig := Mux(loopZ, sigOut.pad(sw + 3),
+    Mux(nanInZ, nanSigZ, 0.U))
+  rounder.io.invalidExc := invalidZ
+  rounder.io.infiniteExc := divZeroZ
+  rounder.io.roundingMode := io.mode
+
+  io.out := WumingRecFN.fNFromRecFN(ew, sw, rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** IEEE 754 remainder (`ftrem` / `forem`), spec/SimRISC-07 §2.1,
+  * m12-chipyard-014.
+  *
+  * `r = a - n*b` with `n` the integer nearest `a/b`, ties to even.  The
+  * computation is the classic restoring long division over the significands:
+  * at the end `rem = |a| mod |b|`, so the only remaining decisions are "is
+  * 2*rem above, equal to or below |b|" (round the quotient up / exact tie /
+  * down) plus the quotient's parity for the tie.  Both operands share the
+  * scale of the smaller exponent, so the remainder is an integer times
+  * `2^(min(ea, eb))`: it never needs rounding, hence `NX`/`OF`/`UF` are never
+  * raised.
+  *
+  * One digit per cycle: `sigWidth + d` steps for `d = ea - eb >= 0`, and no
+  * iteration at all when `d < 0` -- then `|a/b| < 2`, so `n` is 0 or 1 and a
+  * single comparison decides it.  The step count therefore tracks the
+  * exponent distance: this is the operation whose cost depends on its
+  * operands.
+  */
+class WumingRemRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val start = Input(Bool())
+    val a     = Input(UInt(64.W)) // dividend (rfHC)
+    val b     = Input(UInt(64.W)) // divisor  (rfHD)
+    val out   = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+    val done  = Output(Bool())
+    val busy  = Output(Bool())
+  })
+
+  val sw = sigWidth
+  val ew = expWidth
+
+  val rawA = WumingRecFN.rawFloatFromFN(ew, sw, io.a(ew + sw - 1, 0))
+  val rawB = WumingRecFN.rawFloatFromFN(ew, sw, io.b(ew + sw - 1, 0))
+
+  // NaN first (softfloat/QEMU order): `Inf rem qNaN` is a propagation, not
+  // the invalid operation `Inf rem x` is.  A finite dividend over an infinite
+  // divisor and a zero dividend both return the dividend unchanged, which the
+  // pass-through below hands back bit for bit (sign of zero included).
+  val nanIn = rawA.isNaN || rawB.isNaN
+  // A signalling NaN is an invalid (arithmetic) input even next to another
+  // NaN: `NV` plus the canonical quiet NaN (spec/SimRISC-07 §1.4).
+  val invalid = rawA.isSigNaN || rawB.isSigNaN ||
+    (!nanIn && (rawA.isInf || rawB.isZero))
+  val passThrough = !nanIn && !invalid && (rawB.isInf || rawA.isZero)
+  val nanSrc = Mux(rawA.isNaN, rawA, rawB)
+  val nanSig = (nanSrc.sig << 2)(sw + 2, 0)
+  val normal = !nanIn && !invalid && !rawB.isInf && !rawA.isZero
+
+  val ma = rawA.sig(sw - 1, 0)
+  val mb = rawB.sig(sw - 1, 0)
+  val dExp = rawA.sExp - rawB.sExp            // ea - eb
+  val dNeg = dExp < 0.S
+  val ea = rawA.sExp - (BigInt(1) << ew).S - (sw - 1).S
+  val eb = rawB.sExp - (BigInt(1) << ew).S - (sw - 1).S
+  val rExp = Mux(dNeg, ea, eb)                // min(ea, eb)
+
+  // `d == -1` is the only negative distance that can round the quotient up:
+  // n = 1 needs |b| < 2|a|, i.e. d > -2.  Then n = 1 exactly when ma > mb.
+  val n1 = (dExp === (-1).S) && (ma > mb)
+  val rmagNeg = Mux(n1, (mb << 1) - ma, ma)
+  val rsignNeg = rawA.sign ^ n1
+
+  // ---- state -------------------------------------------------------------
+  val busy = RegInit(false.B)
+  val doneReg = RegInit(false.B)
+  val i = RegInit(0.U(16.W))
+  val nTotal = RegInit(0.U(16.W))
+  val rem = RegInit(0.U((sw + 1).W))
+  val mbZ = RegInit(0.U(sw.W))
+  val maZ = RegInit(0.U(sw.W))
+  val signZ = RegInit(false.B)
+  val rmagZ = RegInit(0.U(sw.W))
+  val rexpZ = RegInit(0.S((ew + 6).W))
+  val nanInZ = RegInit(false.B)
+  val invalidZ = RegInit(false.B)
+  val passZ = RegInit(false.B)
+  val passBitsZ = RegInit(0.U(64.W))
+  val nanSigZ = RegInit(0.U((sw + 3).W))
+
+  val startNow = io.start && !busy
+  // One long-division step: shift in the next dividend digit (zero once the
+  // significand is exhausted) and subtract the divisor when it fits.
+  val inSig = i < sw.U
+  val aBit = (maZ >> ((sw - 1).U - i))(0)
+  val rem2 = (rem << 1) | Mux(inSig, aBit, false.B)
+  val ge = rem2 >= mbZ.pad(sw + 2)
+  val remNew = Mux(ge, rem2 - mbZ.pad(sw + 2), rem2)
+
+  val lastStep = i === (nTotal - 1.U)
+  // Once the significand is exhausted a zero remainder stays zero: every
+  // remaining quotient digit is 0, so the result is already exact.
+  val earlyOut = !inSig && remNew === 0.U && !lastStep
+
+  // Final remainder: the quotient is rounded to nearest, ties to even.  The
+  // decision uses the remainder *after* this cycle's step (`remNew`) and `ge`,
+  // which is the quotient's least significant digit at that point.
+  val finalRem2 = remNew << 1
+  val roundUp = (finalRem2 > mbZ.pad(sw + 3)) ||
+    (finalRem2 === mbZ.pad(sw + 3) && ge)
+
+  val runLoop = normal && !dNeg
+  when(startNow) {
+    busy := runLoop
+    i := 0.U
+    nTotal := sw.U + Mux(dNeg, 0.U, dExp.asUInt.pad(16))
+    // The loop consumes the dividend's digits (then `d` zeros), so it starts
+    // from an empty remainder: `rem` ends as `ma * 2^d mod mb`.
+    rem := 0.U
+    maZ := ma
+    mbZ := mb
+    signZ := Mux(dNeg, rsignNeg, rawA.sign)
+    nanInZ := nanIn
+    invalidZ := invalid
+    passZ := passThrough
+    passBitsZ := io.a(ew + sw - 1, 0).pad(64)
+    nanSigZ := nanSig.pad(sw + 3)
+    rmagZ := Mux(dNeg, rmagNeg, 0.U)
+    rexpZ := rExp.pad(ew + 6)
+  }.elsewhen(busy) {
+    i := i + 1.U
+    rem := remNew(sw, 0)
+    when(lastStep || earlyOut) {
+      busy := false.B
+      rmagZ := Mux(roundUp, mbZ - remNew, remNew)(sw - 1, 0)
+      rexpZ := eb.pad(ew + 6)
+      signZ := rawA.sign ^ roundUp
+    }
+  }
+  doneReg := busy && (lastStep || earlyOut)
+  // The negative-distance path has no loop: its result is ready one cycle
+  // after `start`.
+  when(startNow && !runLoop) { doneReg := true.B }
+  io.done := doneReg
+  io.busy := busy
+
+  // ---- result ------------------------------------------------------------
+  val isZeroOut = !nanInZ && !invalidZ && !passZ && rmagZ === 0.U
+  // `normalise` masks the magnitude to `sigWidth + 2` bits, so the final
+  // remainder (which is narrower than that) is zero-extended first.
+  val (sigNorm, sExpNorm) =
+    WumingFPAlu.normalise(rmagZ.pad(sw + 2), rexpZ, ew, sw)
+
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(ew, sw + 2, ew, sw))
+  rounder.io.in.isNaN := nanInZ
+  rounder.io.in.isInf := false.B
+  rounder.io.in.isZero := isZeroOut
+  rounder.io.in.sign := signZ
+  rounder.io.in.sExp := Mux(nanInZ || invalidZ || passZ || isZeroOut, 0.S,
+    sExpNorm)
+  rounder.io.in.sig := Mux(nanInZ, nanSigZ,
+    Mux(passZ || invalidZ || isZeroOut, 0.U, sigNorm.pad(sw + 3)))
+  rounder.io.invalidExc := invalidZ
+  rounder.io.infiniteExc := false.B
+  rounder.io.roundingMode := WumingRoundMode.RNE
+
+  val self = WumingRecFN.fNFromRecFN(ew, sw, rounder.io.out).pad(64)
+  // `a rem Inf` and `0 rem b` return the dividend unchanged and raise nothing
+  // (spec/SimRISC-07 §2.1), so that lane bypasses the rounding primitive whole.
+  io.out := Mux(passZ, passBitsZ, self)
+  io.flags := Mux(passZ, 0.U(5.W), rounder.io.exceptionFlags)
+}
+
+/** The multi-cycle floating-point operations behind one port
+  * (m12-chipyard-014), so the core instantiates and routes a single module.
+  *
+  * `kind` selects the unit (`DIV`/`SQRT`/`REM`) and `isFo` the format; `start`
+  * is a one-cycle pulse, and `done` is a one-cycle pulse one cycle after the
+  * last iteration, at which point `out`/`flags` are valid.  `mode` is
+  * `rf0[33:32]` decoded (the division family rounds with it).
+  */
+object WumingFpSlowKind {
+  val DIV  = 0.U(2.W) // ftdiv / fodiv    (spec/SimRISC-07 §2.1)
+  val SQRT = 1.U(2.W) // ftroot / foroot  (§2.2, `immu6` = n = 2)
+  val REM  = 2.U(2.W) // ftrem / forem    (§2.1, IEEE 754 remainder)
+}
+
+class WumingFpSlow extends Module {
+  val io = IO(new Bundle {
+    val kind  = Input(UInt(2.W))
+    val isFo  = Input(Bool())
+    val mode  = Input(UInt(3.W))
+    val a     = Input(UInt(64.W)) // rfHC
+    val b     = Input(UInt(64.W)) // rfHD
+    val start = Input(Bool())
+    val out   = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+    val done  = Output(Bool())
+    val busy  = Output(Bool())
+  })
+
+  val ftExp = WumingFmt.ftExp
+  val ftSig = WumingFmt.ftSig
+  val foExp = WumingFmt.foExp
+  val foSig = WumingFmt.foSig
+
+  val divFt = Module(new WumingDivSqrtRecFN(ftExp, ftSig))
+  val divFo = Module(new WumingDivSqrtRecFN(foExp, foSig))
+  val sqrtFt = Module(new WumingDivSqrtRecFN(ftExp, ftSig))
+  val sqrtFo = Module(new WumingDivSqrtRecFN(foExp, foSig))
+  val remFt = Module(new WumingRemRecFN(ftExp, ftSig))
+  val remFo = Module(new WumingRemRecFN(foExp, foSig))
+
+  // Only the selected unit is started; the others stay idle and their outputs
+  // are ignored.  `kind` is a one-of-three selector, so at most one unit runs.
+  val selDiv = io.kind === WumingFpSlowKind.DIV
+  val selSqrt = io.kind === WumingFpSlowKind.SQRT
+  val selRem = io.kind === WumingFpSlowKind.REM
+
+  // Only the selected unit *of the selected format* is started: a unit left
+  // running the other format's operands would still be busy when the next
+  // operation of its own format arrives, and that one would silently be
+  // dropped.
+  for ((u, isFo) <- Seq((divFt, false), (divFo, true))) {
+    u.io.start := io.start && selDiv && (io.isFo === isFo.B)
+    u.io.sqrtOp := false.B
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.mode := io.mode
+  }
+  for ((u, isFo) <- Seq((sqrtFt, false), (sqrtFo, true))) {
+    u.io.start := io.start && selSqrt && (io.isFo === isFo.B)
+    u.io.sqrtOp := true.B
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.mode := io.mode
+  }
+  for ((u, isFo) <- Seq((remFt, false), (remFo, true))) {
+    u.io.start := io.start && selRem && (io.isFo === isFo.B)
+    u.io.a := io.a
+    u.io.b := io.b
+  }
+
+  def pick[T <: chisel3.Data](isFo: Bool, ft: T, fo: T): T = Mux(isFo, fo, ft)
+  io.out := MuxLookup(io.kind, 0.U(64.W))(Seq(
+    WumingFpSlowKind.DIV -> pick(io.isFo, divFt.io.out, divFo.io.out),
+    WumingFpSlowKind.SQRT -> pick(io.isFo, sqrtFt.io.out, sqrtFo.io.out),
+    WumingFpSlowKind.REM -> pick(io.isFo, remFt.io.out, remFo.io.out)))
+  io.flags := MuxLookup(io.kind, 0.U(5.W))(Seq(
+    WumingFpSlowKind.DIV -> pick(io.isFo, divFt.io.flags, divFo.io.flags),
+    WumingFpSlowKind.SQRT -> pick(io.isFo, sqrtFt.io.flags, sqrtFo.io.flags),
+    WumingFpSlowKind.REM -> pick(io.isFo, remFt.io.flags, remFo.io.flags)))
+  io.done := MuxLookup(io.kind, false.B)(Seq(
+    WumingFpSlowKind.DIV -> pick(io.isFo, divFt.io.done, divFo.io.done),
+    WumingFpSlowKind.SQRT -> pick(io.isFo, sqrtFt.io.done, sqrtFo.io.done),
+    WumingFpSlowKind.REM -> pick(io.isFo, remFt.io.done, remFo.io.done)))
+  io.busy := MuxLookup(io.kind, false.B)(Seq(
+    WumingFpSlowKind.DIV -> pick(io.isFo, divFt.io.busy, divFo.io.busy),
+    WumingFpSlowKind.SQRT -> pick(io.isFo, sqrtFt.io.busy, sqrtFo.io.busy),
+    WumingFpSlowKind.REM -> pick(io.isFo, remFt.io.busy, remFo.io.busy)))
+}
+
+/** `roundToIntegral` (spec/SimRISC-07 §2.3, IEEE 754-2019 §5.3.1),
+  * m12-chipyard-015.
+  *
+  * The six `immu6` codes are resolved by the core (ADR-0050 D2): `mode` is the
+  * direction (`RNE`/`RNA`/`RTZ`/`RUP`/`RDN`) and `exact` marks the dynamic code
+  * `0x20` (`roundToIntegralExact`), the only variant that accrues `NX`
+  * (IEEE 754-2019 §5.9: the five static variants never signal inexact).
+  *
+  * The value is `raw.sig * 2^qExp`.  `qExp >= 0` means every significand bit is
+  * an integer bit -- for a `p`-bit significand that is exactly `|x| >= 2^p`,
+  * the spec's "原样返回" case -- so the input passes through unchanged.
+  * Otherwise the magnitude is truncated at the binary point
+  * (`WumingFPAlu.place`), which yields the integer part plus the round bit and
+  * the sticky flag; the rounded integer is encoded back exactly (an integer
+  * below `2^p` always fits the format) and the `±0` results keep the input's
+  * sign (IEEE 754-2019 §5.9).
+  *
+  * `DADAO:` every NaN result is the canonical quiet NaN (spec §2.3
+  * "canonical 化", the same rule as QEMU's default-NaN mode); an sNaN input
+  * raises `NV`, a quiet NaN does not (IEEE 754-2019 §6.2).  This operation can
+  * never raise `OF`/`UF`/`DZ`, and `NX` only for the `0x20` code.
+  */
+class WumingFpRound(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val mode  = Input(UInt(3.W))
+    val exact = Input(Bool())
+    val in    = Input(UInt((expWidth + sigWidth).W))
+    val out   = Output(UInt(64.W))
+    val flags = Output(UInt(5.W)) // rf0[4:0] order: NV, DZ, OF, UF, NX
+  })
+
+  val raw = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, io.in)
+  val bias = (BigInt(1) << (expWidth - 1)) - 1
+
+  // Exponent of the least significant significand bit: `value = sig * 2^qExp`
+  // in the recoded convention of `WumingRawFloat` (same expression as the
+  // divisor/remainder units above).
+  val qExp: SInt = raw.sExp - (BigInt(1) << expWidth).S - (sigWidth - 1).S
+  val integral = qExp >= 0.S
+
+  // Integer part and the two bits below it.  Working on `2 * |x|` puts the
+  // round bit in bit 0 of the window and leaves everything below it to the
+  // sticky flag: `place` truncates towards zero and reports any dropped bit.
+  val (twiceBits, belowRound) =
+    WumingFPAlu.place(raw.sig, qExp +& 1.S, sigWidth + 2)
+  val mag = twiceBits(sigWidth + 1, 1)
+  val roundBit = twiceBits(0)
+  val inexact = roundBit || belowRound
+
+  val roundUp = MuxLookup(io.mode, false.B)(Seq(
+    WumingRoundMode.RNE -> (roundBit && (belowRound || mag(0))),
+    WumingRoundMode.RNA -> roundBit,
+    WumingRoundMode.RTZ -> false.B,
+    WumingRoundMode.RUP -> (!raw.sign && inexact),
+    WumingRoundMode.RDN -> (raw.sign && inexact)))
+  val res = mag +& roundUp
+
+  // Encode the integer exactly: `res <= 2^sigWidth` (`|x| < 2^sigWidth` because
+  // `qExp < 0`), so it is either zero or a normal value of this format.
+  val msb = WumingFPAlu.msbIndex(res)
+  val shift = Mux(msb <= (sigWidth - 1).U, (sigWidth - 1).U - msb, 0.U)
+  val fract = Mux(msb <= (sigWidth - 1).U, (res << shift)(sigWidth - 2, 0),
+    0.U((sigWidth - 1).W))
+  val expOut = Mux(res === 0.U, 0.U, (msb +& bias.U)(expWidth - 1, 0))
+  val rounded = raw.sign ## expOut ## fract
+
+  // Canonical quiet NaN of this format: sign 0, payload 0 (spec §2.3).
+  val qnan = 0.U(1.W) ##
+    ((BigInt(1) << expWidth) - 1).U(expWidth.W) ##
+    (BigInt(1) << (sigWidth - 2)).U((sigWidth - 1).W)
+
+  io.out := Mux(raw.isNaN, qnan,
+    Mux(integral, io.in, rounded)).pad(64)
+  // `NX` only for `roundToIntegralExact` and only when the value changed; the
+  // pass-through shapes (already integral, Inf, zero) are never inexact.
+  // `rf0[4:0]` order: bit4 NX ... bit0 NV, so `NX` comes first in the `Cat`.
+  io.flags := Cat(io.exact && !integral && inexact && !raw.isNaN,
+    false.B, false.B, false.B, raw.isSigNaN)
+}
+
+/** `scaleB` (spec/SimRISC-07 §2.1, IEEE 754-2019 §9.2), m12-chipyard-015.
+  *
+  * `x * 2^n` with `n` the signed 64-bit integer of the `rd` operand.  The
+  * significand is untouched and only the recoded exponent moves, so the single
+  * rounding primitive rounds exactly once (this is what makes the operation
+  * `scaleB` rather than "multiply by a power of two", which would round twice
+  * whenever `2^n` itself is not representable).  Overflow, underflow and
+  * inexact are then the primitive's IEEE rules (spec §2.1: "NaN/Inf/溢出/下溢
+  * 行为遵循 IEEE 754"): a magnitude that only *rounds* back to the largest
+  * finite value reports `NX` without `OF` (IEEE 754-2019 §7.4), and a result
+  * that lands on the smallest normal after rounding is not tiny (§7.5).
+  *
+  * The exponent sum is clamped outside the range where it can still change
+  * the result: at or below `lo` every direction yields ±0 (or the pegged
+  * minimum) and at or above `hi` the operation overflows, exactly as a much
+  * larger `|n|` would.  Clamping therefore cannot alter the result, and it
+  * keeps the arithmetic inside the exponent field's width.
+  */
+class WumingFpScale(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val mode  = Input(UInt(3.W))
+    val in    = Input(UInt((expWidth + sigWidth).W))
+    val n     = Input(SInt(64.W)) // rdHD: the signed 64-bit integer exponent
+    val out   = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val raw = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, io.in)
+  val rounder = Module(new WumingRoundAnyRawFNToRecFN(
+    expWidth, sigWidth, expWidth, sigWidth))
+
+  val lo = WumingRecFN.minNormExp(expWidth) - sigWidth - 2
+  val hi = (BigInt(6) << (expWidth - 2)) + 2
+  val wide = 72
+  val sum: SInt = raw.sExp.pad(wide) + io.n.pad(wide)
+  val hiS = hi.S((wide + 1).W)
+  val loS = lo.S((wide + 1).W)
+  val clamped = Mux(sum > hiS, hiS, Mux(sum < loS, loS, sum))
+
+  val scaled = Wire(new WumingRawFloat(expWidth, sigWidth))
+  scaled.isNaN := raw.isNaN
+  scaled.isInf := raw.isInf
+  scaled.isZero := raw.isZero
+  scaled.sign := raw.sign
+  scaled.sExp := clamped(expWidth + 1, 0).asSInt
+  scaled.sig := raw.sig
+
+  rounder.io.in := scaled
+  rounder.io.invalidExc := raw.isSigNaN // sNaN raises NV; a qNaN only propagates
+  rounder.io.infiniteExc := false.B // scaleB has no divide-by-zero lane
+  rounder.io.roundingMode := io.mode
+
+  io.out := WumingRecFN.fNFromRecFN(expWidth, sigWidth, rounder.io.out).pad(64)
+  io.flags := rounder.io.exceptionFlags
+}
+
+/** `roundToIntegral` and `scaleB` behind one port (m12-chipyard-015). */
+object WumingFpMiscOp {
+  val RND  = 0.U(1.W) // ftrnd / fornd  (spec/SimRISC-07 §2.3)
+  val SCLB = 1.U(1.W) // ftsclb / fosclb (§2.1)
+}
+
+class WumingFpMisc extends Module {
+  val io = IO(new Bundle {
+    val op    = Input(UInt(1.W))
+    val isFo  = Input(Bool())
+    val mode  = Input(UInt(3.W))
+    val exact = Input(Bool())
+    val a     = Input(UInt(64.W)) // rfHC
+    val n     = Input(SInt(64.W)) // rdHD (scaleB only)
+    val out   = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val rndFt = Module(new WumingFpRound(WumingFmt.ftExp, WumingFmt.ftSig))
+  val rndFo = Module(new WumingFpRound(WumingFmt.foExp, WumingFmt.foSig))
+  val sclbFt = Module(new WumingFpScale(WumingFmt.ftExp, WumingFmt.ftSig))
+  val sclbFo = Module(new WumingFpScale(WumingFmt.foExp, WumingFmt.foSig))
+
+  for ((u, isFo) <- Seq((rndFt, false), (rndFo, true))) {
+    u.io.mode := io.mode
+    u.io.exact := io.exact
+    u.io.in := io.a
+  }
+  for ((u, isFo) <- Seq((sclbFt, false), (sclbFo, true))) {
+    u.io.mode := io.mode
+    u.io.in := io.a
+    u.io.n := io.n
+  }
+
+  def pick[T <: chisel3.Data](isFo: Bool, ft: T, fo: T): T = Mux(isFo, fo, ft)
+  io.out := MuxLookup(io.op, 0.U(64.W))(Seq(
+    WumingFpMiscOp.RND -> pick(io.isFo, rndFt.io.out, rndFo.io.out),
+    WumingFpMiscOp.SCLB -> pick(io.isFo, sclbFt.io.out, sclbFo.io.out)))
+  io.flags := MuxLookup(io.op, 0.U(5.W))(Seq(
+    WumingFpMiscOp.RND -> pick(io.isFo, rndFt.io.flags, rndFo.io.flags),
+    WumingFpMiscOp.SCLB -> pick(io.isFo, sclbFt.io.flags, sclbFo.io.flags)))
+}
+
+/** Quiet / signalling compare (hardfloat `CompareRecFN`), spec/SimRISC-07 §4.
+  *
+  * The comparison itself is the total order on the IEEE encoding (sign then
+  * magnitude, so `-0 < +0`); an unordered pair returns a quiet NaN for
+  * `ftqcmp`/`foqcmp` and a signalling NaN for `ftscmp`/`foscmp`, both with a
+  * clear sign bit.  `NV` follows spec/SimRISC-07 §4 and IEEE 754-2019 §5.6.1
+  * / §5.11 (m12-chipyard-024): a signalling compare (`ftscmp`/`foscmp`) raises
+  * it for **any** unordered pair, quiet NaN included; a quiet compare
+  * (`ftqcmp`/`foqcmp`) raises it only when an operand is a signalling NaN --
+  * a quiet NaN operand alone raises nothing.  This is hardfloat's
+  * `CompareRecFN` rule bit for bit.
+  */
+class WumingCompareRecFN(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val a = Input(UInt(64.W))
+    val b = Input(UInt(64.W))
+    val signaling = Input(Bool())
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val fmtW = expWidth + sigWidth
+  val aBits = io.a(fmtW - 1, 0)
+  val bBits = io.b(fmtW - 1, 0)
+  val rawA = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, aBits)
+  val rawB = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, bBits)
+
+  // Monotone key of the IEEE encoding: flip the magnitude bits of a negative
+  // value and set the sign bit of a non-negative one.  This makes the unsigned
+  // key order identical to the IEEE numeric order, `-0` below `+0` included.
+  val signBit = (BigInt(1) << (fmtW - 1)).U(fmtW.W)
+  val keyA = Mux(rawA.sign, ~aBits, aBits | signBit)
+  val keyB = Mux(rawB.sign, ~bBits, bBits | signBit)
+
+  val unordered = rawA.isNaN || rawB.isNaN
+  // Every zero encoding is numerically equal to every other one (the monotone
+  // key deliberately orders `-0` below `+0`, which is the min/max rule but not
+  // the comparison rule).
+  val bothZero = rawA.isZero && rawB.isZero
+  val lt = !unordered && !bothZero && keyA < keyB
+  val gt = !unordered && !bothZero && keyA > keyB
+
+  val expOnes = ((BigInt(1) << expWidth) - 1) << (sigWidth - 1)
+  val quietNan = expOnes | (BigInt(1) << (sigWidth - 2))
+  val sigNan = expOnes | 1
+  val nanBits = Mux(io.signaling, sigNan.U(fmtW.W), quietNan.U(fmtW.W))
+
+  val cmp = Mux(lt, "hffff_ffff_ffff_ffff".U, Mux(gt, 1.U, 0.U))
+  io.out := Mux(unordered, nanBits.pad(64), cmp.pad(64))
+  io.flags := Cat(false.B, false.B, false.B, false.B,
+    Mux(io.signaling, unordered, rawA.isSigNaN || rawB.isSigNaN))
+}
+
+/** `minimumNumber` / `maximumNumber` (spec/SimRISC-07 §2.4).
+  *
+  * Neither operand is rounded: the result is one of the input encodings (or the
+  * canonical quiet NaN for two NaNs).  A single NaN returns the number (a
+  * signalling NaN still raises `NV`); two NaNs return the canonical quiet NaN
+  * of the format and raise `NV` if either was signalling.  `-0` is ordered
+  * below `+0`, which the monotone key comparison gives for free.
+  */
+class WumingMinMax(expWidth: Int, sigWidth: Int) extends Module {
+  val io = IO(new Bundle {
+    val a = Input(UInt(64.W))
+    val b = Input(UInt(64.W))
+    val isMax = Input(Bool())
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val fmtW = expWidth + sigWidth
+  val aBits = io.a(fmtW - 1, 0)
+  val bBits = io.b(fmtW - 1, 0)
+  val rawA = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, aBits)
+  val rawB = WumingRecFN.rawFloatFromFN(expWidth, sigWidth, bBits)
+
+  val signBit = (BigInt(1) << (fmtW - 1)).U(fmtW.W)
+  val keyA = Mux(rawA.sign, ~aBits, aBits | signBit)
+  val keyB = Mux(rawB.sign, ~bBits, bBits | signBit)
+  val pickA = Mux(io.isMax, keyA >= keyB, keyA <= keyB)
+  val numeric = Mux(pickA, aBits, bBits)
+
+  val canonNan = (((BigInt(1) << expWidth) - 1) << (sigWidth - 1)) |
+    (BigInt(1) << (sigWidth - 2))
+  val bothNan = rawA.isNaN && rawB.isNaN
+  val sel = Mux(bothNan, canonNan.U(fmtW.W),
+    Mux(rawA.isNaN, bBits, Mux(rawB.isNaN, aBits, numeric)))
+
+  io.out := sel.pad(64)
+  io.flags := Cat(false.B, false.B, false.B, false.B,
+    rawA.isSigNaN || rawB.isSigNaN)
+}
+
+/** Every arithmetic unit of spec/SimRISC-07 §2 behind one port, so the core
+  * instantiates and routes a single module (m12-chipyard-013).
+  *
+  * `a`/`b` are the two `orrr` sources (`rfHC`/`rfHD`) and, for the FMA, the
+  * multiplicand and multiplier (`rfHB`/`rfHC`); `c` is the FMA addend
+  * (`rfHD`).  All operands and results are IEEE binary words: `ft` occupies
+  * the low 32 bits and results are zero-extended to the 64-bit register
+  * (spec/SimRISC-00 §2.3).
+  */
+class WumingFPArith extends Module {
+  val io = IO(new Bundle {
+    val kind = Input(UInt(3.W))
+    val isFo = Input(Bool())
+    val mode = Input(UInt(3.W))
+    val a = Input(UInt(64.W))
+    val b = Input(UInt(64.W))
+    val c = Input(UInt(64.W))
+    val out = Output(UInt(64.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val ftExp = WumingFmt.ftExp
+  val ftSig = WumingFmt.ftSig
+  val foExp = WumingFmt.foExp
+  val foSig = WumingFmt.foSig
+
+  val addFt = Module(new WumingAddRecFN(ftExp, ftSig))
+  val addFo = Module(new WumingAddRecFN(foExp, foSig))
+  val subFt = Module(new WumingAddRecFN(ftExp, ftSig))
+  val subFo = Module(new WumingAddRecFN(foExp, foSig))
+  val mulFt = Module(new WumingMulRecFN(ftExp, ftSig))
+  val mulFo = Module(new WumingMulRecFN(foExp, foSig))
+  val fmaFt = Module(new WumingMulAddRecFN(ftExp, ftSig))
+  val fmaFo = Module(new WumingMulAddRecFN(foExp, foSig))
+  val minFt = Module(new WumingMinMax(ftExp, ftSig))
+  val minFo = Module(new WumingMinMax(foExp, foSig))
+  val maxFt = Module(new WumingMinMax(ftExp, ftSig))
+  val maxFo = Module(new WumingMinMax(foExp, foSig))
+  val qcmpFt = Module(new WumingCompareRecFN(ftExp, ftSig))
+  val qcmpFo = Module(new WumingCompareRecFN(foExp, foSig))
+  val scmpFt = Module(new WumingCompareRecFN(ftExp, ftSig))
+  val scmpFo = Module(new WumingCompareRecFN(foExp, foSig))
+
+  for ((u, sub) <- Seq((addFt, false), (addFo, false),
+                        (subFt, true), (subFo, true))) {
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.subOp := sub.B
+    u.io.roundingMode := io.mode
+  }
+  for (u <- Seq(mulFt, mulFo)) {
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.roundingMode := io.mode
+  }
+  for (u <- Seq(fmaFt, fmaFo)) {
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.c := io.c
+    u.io.roundingMode := io.mode
+  }
+  for ((u, isMax) <- Seq((minFt, false), (minFo, false),
+                          (maxFt, true), (maxFo, true))) {
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.isMax := isMax.B
+  }
+  for ((u, sgn) <- Seq((qcmpFt, false), (qcmpFo, false),
+                        (scmpFt, true), (scmpFo, true))) {
+    u.io.a := io.a
+    u.io.b := io.b
+    u.io.signaling := sgn.B
+  }
+
+  def pick(isFo: Bool, ft: UInt, fo: UInt): UInt = Mux(isFo, fo, ft)
+
+  val outs = Seq(
+    WumingFPArithOp.ADD -> pick(io.isFo, addFt.io.out, addFo.io.out),
+    WumingFPArithOp.SUB -> pick(io.isFo, subFt.io.out, subFo.io.out),
+    WumingFPArithOp.MUL -> pick(io.isFo, mulFt.io.out, mulFo.io.out),
+    WumingFPArithOp.FMA -> pick(io.isFo, fmaFt.io.out, fmaFo.io.out),
+    WumingFPArithOp.MIN -> pick(io.isFo, minFt.io.out, minFo.io.out),
+    WumingFPArithOp.MAX -> pick(io.isFo, maxFt.io.out, maxFo.io.out),
+    WumingFPArithOp.QCMP -> pick(io.isFo, qcmpFt.io.out, qcmpFo.io.out),
+    WumingFPArithOp.SCMP -> pick(io.isFo, scmpFt.io.out, scmpFo.io.out))
+
+  val flagss = Seq(
+    WumingFPArithOp.ADD -> pick(io.isFo, addFt.io.flags, addFo.io.flags),
+    WumingFPArithOp.SUB -> pick(io.isFo, subFt.io.flags, subFo.io.flags),
+    WumingFPArithOp.MUL -> pick(io.isFo, mulFt.io.flags, mulFo.io.flags),
+    WumingFPArithOp.FMA -> pick(io.isFo, fmaFt.io.flags, fmaFo.io.flags),
+    WumingFPArithOp.MIN -> pick(io.isFo, minFt.io.flags, minFo.io.flags),
+    WumingFPArithOp.MAX -> pick(io.isFo, maxFt.io.flags, maxFo.io.flags),
+    WumingFPArithOp.QCMP -> pick(io.isFo, qcmpFt.io.flags, qcmpFo.io.flags),
+    WumingFPArithOp.SCMP -> pick(io.isFo, scmpFt.io.flags, scmpFo.io.flags))
+
+  io.out := MuxLookup(io.kind, 0.U(64.W))(outs)
+  io.flags := MuxLookup(io.kind, 0.U(5.W))(flagss)
+}
+
+/** Classify one `rf` register (spec/SimRISC-07 §5).
+  *
+  * `ft` values live in the low 32 bits of the register, `fo` values in all 64
+  * (spec/SimRISC-00 §2.3); the class bits are returned in the manual's order
+  * (`WumingRecFN.classifyRaw`) and padded to 64 bits by the core.
+  */
+class WumingClassify extends Module {
+  val io = IO(new Bundle {
+    val isFo = Input(Bool())
+    val in = Input(UInt(64.W))
+    val out = Output(UInt(10.W))
+  })
+  io.out := Mux(io.isFo,
+    WumingRecFN.classifyFN(WumingFmt.foExp, WumingFmt.foSig, io.in),
+    WumingRecFN.classifyFN(WumingFmt.ftExp, WumingFmt.ftSig, io.in(31, 0)))
+}
+
+/** Software-visible part of the FP environment: `rf0` (spec/SimRISC-00 §2.3.1).
+  *
+  * `rf0` is simultaneously the FCSR and the quiet NaN of both formats:
+  * `[63:51]`/`[31:22]` are read-only quiet-NaN bits, `[50:34]`/`[21:5]` are
+  * SBZ and read back zero, `[33:32]` is the rounding mode and `[4:0]` the
+  * accrued exception flags.  A write only updates `[33:32]` and `[4:0]`
+  * (everything else keeps its value), and a software write sets the flag field
+  * outright, which is how the software clears it; the flags raised by FP
+  * operations accumulate (sticky) until then.
+  */
+class WumingFcsr extends Module {
+  val io = IO(new Bundle {
+    val writeEn = Input(Bool())
+    val writeData = Input(UInt(64.W))
+    val fflags = Input(UInt(5.W)) // flags raised by this cycle's FP operation
+    val read = Output(UInt(64.W))
+    val mode = Output(UInt(2.W))
+    val flags = Output(UInt(5.W))
+  })
+
+  val resetValue = "h7ff800007fc00000".U(64.W)
+  val modeReg = RegInit(resetValue(33, 32))
+  val flagsReg = RegInit(resetValue(4, 0))
+
+  when(io.writeEn) {
+    modeReg := io.writeData(33, 32)
+    flagsReg := io.writeData(4, 0)
+  }.otherwise {
+    flagsReg := flagsReg | io.fflags
+  }
+
+  io.mode := modeReg
+  io.flags := flagsReg
+  // Everything except `[33:32]` and `[4:0]` is read-only: the quiet-NaN bits
+  // are fixed and the SBZ columns read as zero.
+  val writableMask = ("h3".U(64.W) << 32) | "h1f".U(64.W)
+  io.read := (resetValue & ~writableMask) |
+    (modeReg << 32) | flagsReg.pad(64)
+}
