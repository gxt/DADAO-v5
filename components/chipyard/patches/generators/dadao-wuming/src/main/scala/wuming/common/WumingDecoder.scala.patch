+        is(0x11.U) { subHandled := true.B; tetraOrrr(WumingAluOp.ROL) }
+        is(0x12.U) { subHandled := true.B; tetraOrrr(WumingAluOp.SHR_U) }
+        is(0x13.U) { subHandled := true.B; tetraOrrr(WumingAluOp.SHR_S) }
+        is(0x18.U) { subHandled := true.B; tetraOrri(WumingAluOp.SHL) }
+        is(0x19.U) { subHandled := true.B; tetraOrri(WumingAluOp.ROL) }
+        is(0x1A.U) { subHandled := true.B; tetraOrri(WumingAluOp.SHR_U) }
+        is(0x1B.U) { subHandled := true.B; tetraOrri(WumingAluOp.SHR_S) }
+        is(0x20.U) { subHandled := true.B; tetraOrrr(WumingAluOp.ADD_U) }
+        is(0x21.U) { subHandled := true.B; tetraOrrr(WumingAluOp.ADD_S) }
+        is(0x28.U) { subHandled := true.B; tetraOrrr(WumingAluOp.SUB_U) }
+        is(0x29.U) { subHandled := true.B; tetraOrrr(WumingAluOp.SUB_S) }
+        is(0x2A.U) { subHandled := true.B; tetraOrrr(WumingAluOp.CMP_U) }
+        is(0x2B.U) { subHandled := true.B; tetraOrrr(WumingAluOp.CMP_S) }
