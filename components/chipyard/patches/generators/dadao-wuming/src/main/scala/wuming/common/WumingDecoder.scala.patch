+    d.srcAIdx := ha; d.srcABank := WumingBank.RB
+    d.srcBIdx := hb; d.srcBBank := WumingBank.RD
+    d.jumpOff := (imms12 << 2)(63, 0)
+  }.elsewhen(opc === 0x76.U) {
