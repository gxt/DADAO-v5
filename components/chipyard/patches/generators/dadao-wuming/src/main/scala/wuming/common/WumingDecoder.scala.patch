+    // follows the opcode order.
+    recognized := true.B
+    d.isBr := true.B
+    d.brCond := opc - 0x68.U
+    d.brOff := (imms18 << 2)(63, 0)
+    d.srcAIdx := ha
+  }.elsewhen(opc === 0x72.U || opc === 0x73.U) {
+    // br.z / br.nz (rb): same target arithmetic, operand in the rb bank.
+    recognized := true.B
+    d.isBr := true.B
+    d.brCond := opc - 0x70.U
+    d.brOff := (imms18 << 2)(63, 0)
+    d.srcAIdx := ha; d.srcABank := WumingBank.RB
+  }.elsewhen(opc === 0x74.U) {
+    // call [rb0, imms26]: target as `jump iiii`; the RAS push (return address
+    // = ip + 4) is the core's job (spec/SimRISC-06 §3).
+    recognized := true.B
+    d.isJump := true.B; d.isCall := true.B
+    d.srcAIdx := 0.U; d.srcABank := WumingBank.RB
+    d.srcBIdx := 0.U; d.srcBBank := WumingBank.RD
+    d.jumpOff := (sext(imm24) << 2)(63, 0)
+  }.elsewhen(opc === 0x75.U) {
+    // call [rbHA, rdHB, imms14]: rbHA is read-only for both call forms.
+    recognized := true.B
+    d.isJump := true.B; d.isCall := true.B
+    d.srcAIdx := ha; d.srcABank := WumingBank.RB
+    d.srcBIdx := hb; d.srcBBank := WumingBank.RD
+    d.jumpOff := (imms12 << 2)(63, 0)
+  }.elsewhen(opc === 0x76.U) {
+    // ret rdHA, imms18: rdHA = sign-extended imms18, then jump to the RAS
+    // pop result.  `ret rd0, <imm18 != 0>` is illegal (dst_rd0_nonzero,
+    // spec/SimRISC-06 §4).
+    recognized := true.B
+    d.isRet := true.B
+    d.aluOp := WumingAluOp.ADD_U
+    d.srcAIdx := 0.U; d.srcABank := WumingBank.RD // rd0 reads 0
+    d.useImmB := true.B; d.imm := imms18
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(ha === 0.U && imm18 =/= 0.U) { d.ill := true.B }
+  }.elsewhen(opc === 0x7F.U) {
+    // trap (spec/SimRISC-11).  The semihosting window is judged on immu18 only
+    // (Machine-v5 §5.4, user ruling 2026-11-09), independent of cfxha; every
+    // other `trap cfx_hmon` is the CFXTRAP handoff of DADAO-12 §5.2.
+    recognized := true.B
+    d.isTrap := true.B
+    d.cfxHa := ha
+    d.isSemi := imm18(17, 8) === 0x3FF.U
+    when(d.isSemi) { d.srcCIdx := 16.U; d.srcCBank := WumingBank.RB }
+    when(!d.isSemi && !cfxAccessible(ha)) { d.ill := true.B }
+  }.elsewhen(opc === 0x7E.U) {
+    // escape (DADAO-12 §5.3): imms18[17:1] is SBZ, the byte offset is 0 or +4.
+    recognized := true.B
+    d.isEscape := true.B
+    d.cfxHa := ha
+    d.escOff := Cat(imm18(0), 0.U(2.W))
+    when(imm18(17, 1) =/= 0.U) { d.ill := true.B }
+    when(!cfxAccessible(ha)) { d.ill := true.B }
+  }.elsewhen(opc === 0x7A.U || opc === 0x7B.U) {
+    // cfx2rd / cfx2rc: cfxha[23:18], cg[17:12], rc[11:6], rd[5:0].
+    recognized := true.B
+    d.isCfx2 := true.B
+    d.cfxWrite := opc === 0x7B.U
+    d.cfxHa := ha
+    d.cfxCg := hb
+    d.cfxRc := hc
+    d.cfxDst := hd
+    d.srcAIdx := hd
+    when(!cfxAccessible(ha)) { d.ill := true.B }
+    when(!d.cfxWrite) { d.w0En := true.B; d.w0Idx := hd; d.w0Sel := 0.U }
+  }
+
+  // ---- classification of everything not handled above -------------------
+  def opcDefined(o: UInt): Bool =
+    // QFC main table (spec/SimRISC-00 §4): 0x00-0x0F and 0x1B-0x1F are blank
+    // cells (UNDI); 0x33-0x37 and 0x77/0x78/0x7C/0x7D are blank as well.
+    (o >= 0x10.U && o <= 0x1A.U) ||
+    (o >= 0x20.U && o <= 0x32.U) || (o >= 0x38.U && o <= 0x3F.U) ||
+    (o >= 0x40.U && o <= 0x4F.U) ||
+    (o >= 0x50.U && o <= 0x56.U) || (o >= 0x59.U && o <= 0x5F.U) ||
+    (o >= 0x60.U && o <= 0x6F.U) || (o >= 0x70.U && o <= 0x76.U) ||
+    (o >= 0x79.U && o <= 0x7B.U) || o === 0x7E.U || o === 0x7F.U
+
+  when(!recognized) {
+    when(opcDefined(opc)) { d.ill := true.B }.otherwise { d.undi := true.B }
+  }
+}
