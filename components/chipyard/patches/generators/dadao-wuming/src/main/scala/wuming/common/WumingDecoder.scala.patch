+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingDecoder.scala
@@ -0,0 +1,817 @@
+// See LICENSE for license details.
+//
+// DADAO decoder for the M12 integer core.
+//
+// Formats covered (spec/SimRISC-00 §3.1): `orrr`, `orri`, `rrrr`, `riii`,
+// `rrii`, `rrri` plus the `rwii` forms retained from m12-003, and the legacy
+// `ld.o` / `st.o` / `jump` / semihosting `trap` shapes.  Instruction families:
+//
+//   SimRISC-01 (memory)  ld/st every integer width (b/w/t/o, signed and zero
+//                        extending), the RD/RB/RA banks and ldm/stm (m12-008)
+//   SimRISC-04 (64-bit)  and/or/xor/xnor, shl/rol/shr, ext, cmp, add.o/sub.o,
+//                        div/rem, and the `rrrr` add/sub/mul (128-bit result)
+//   SimRISC-05 (address) add.si (rd/rb), aip.si, add.o/sub.o, cmp.uo (dbb)
+//   SimRISC-08 (32-bit)  add/sub/cmp/mul/div/rem/shl/rol/shr
+//
+// Everything else is a fault, never a silent NOP:
+//   * an encoding defined by contracts/opcodes.yaml but not implemented in
+//     this milestone  -> ILLI (spec/SimRISC-00 §6.1)
+//   * an unallocated QFC / sub-table cell -> UNDI (spec/SimRISC-00 §6.2,
+//     contracts/legality_rules.yaml `excp_undi`)
+// and the legality rules of contracts/legality_rules.yaml are applied to the
+// implemented families (`dst_rd0`, `dst_rb0`, `dst_dual_same`, `encode_sbz`,
+// `mreg_zero`, `mreg_range_overflow`).
+//
+// m12-chipyard-007 adds exactly what the BootROM firmware needs to make the
+// `power -> hmon -> application` handoff run on this core (fixed firmware,
+// spec/Machine-v5 §6.1/§6.2):
+//
+//   * `br.n`/`br.nn`/`br.z`/`br.nz`/`br.p`/`br.np` (rd) and `br.z`/`br.nz`
+//     (rb) — the table-validation/copy loops of the power stub; relative to
+//     `rb0` = current IP, offset `imms18 << 2` (spec/SimRISC-06 §1);
+//   * `trap cfx_hmon, <immu18>` outside the semihosting tag window (CFXTRAP
+//     handoff); the semihosting window stays `immu18[17:8] == 0x3FF`;
+//   * `escape cfx_hmon, [excp_cause_ip, 0|4]` (DADAO-12 §5.3);
+//   * `cfx2rd`/`cfx2rc` for the minimal `cfx_hmon` register subset the two
+//     stubs use (cg3 rc10 vector, cg5 rc2/rc3/rc4 cause frame).
+//
+// The rest of control flow (`call`/`ret`/relative `jump`/`br.eq`/`br.ne`/RAS)
+// and the full cfx register group stay with m12-chipyard-009/019.
+//
+// m12-chipyard-009 completes control flow (spec/SimRISC-06, spec/SimRISC-00
+// §2.4): `br.eq`/`br.ne` (rrii), the relative `jump` (iiii), `call` (iiii and
+// rrii, return address = current IP + 4) and `ret rdHA, imms18` (the return
+// address comes from the RAS, not from an operand).  The RAS push/pop cases
+// (C1-C3b / D1-D4b) live in the core; the decoder only marks the operation.
+//
+// m12-chipyard-010 closes the non-cfx instruction set:
+//
+//   * bit manipulation: `rev.o/.t/.w/.b` (`encode_onehot` on the unit size),
+//     `rol.o/.t/.w/.b` (orrr/orri), `ctpop`/`ctlz`/`cttz` (the immediate is the
+//     valid-bit bound, so every value is legal) and `clmul.o`;
+//   * the whole OPC-tetra/wyde/byte sub-table layout (arithmetic, compare,
+//     shifts) through one shared `widthTable` helper;
+//   * atomics `lr`/`sc` (24 forms: `sc`'s rdHB is the result, `lr`'s is SBZ)
+//     and the barrier/no-op pair `fence`/`swym`;
+//   * `cs.n/.z/.p/.eq/.ne` conditional assignment and the register-block copies
+//     `rd2rd`/`ra2rd`/`rd2ra`/`rb2rb`/`rd2rb`/`rb2rd` (with the range and
+//     overlap legality rules).
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+
+/** Register bank selectors shared by the decoder, the core and the regfile. */
+object WumingBank {
+  val RD = 0.U(2.W)
+  val RB = 1.U(2.W)
+  val RA = 2.U(2.W)
+}
+
+class WumingDecode extends Bundle {
+  val ill  = Bool()
+  val undi = Bool()
+
+  val aluOp = UInt(6.W)
+  val opWidth = UInt(2.W) // 3 = octa, 2 = tetra
+
+  val srcAIdx  = UInt(6.W)
+  val srcABank = UInt(2.W)
+  val srcAIsIp = Bool()
+  val srcBIdx  = UInt(6.W)
+  val srcBBank = UInt(2.W)
+  val srcCIdx  = UInt(6.W)
+  val srcCBank = UInt(2.W)
+
+  val useImmB     = Bool()
+  val shamtFromImm = Bool()
+  val imm         = UInt(64.W)
+  val wp          = UInt(2.W)
+
+  val w0En   = Bool()
+  val w0Idx  = UInt(6.W)
+  val w0Bank = UInt(2.W)
+  val w0Sel  = UInt(1.W) // 0 = ALU lo, 1 = ALU hi
+  val w1En   = Bool()
+  val w1Idx  = UInt(6.W)
+  val w1Bank = UInt(2.W)
+  val w1Sel  = UInt(1.W)
+
+  val isJump  = Bool()
+  val jumpOff = UInt(64.W)
+  // m12-009: `call` reuses the jump target arithmetic and additionally pushes
+  // the return address (ip + 4); `ret` pops the RAS and writes one rd with the
+  // sign-extended imms18 (spec/SimRISC-06 §3/§4).
+  val isCall  = Bool()
+  val isRet   = Bool()
+  val isLd    = Bool()
+  val isSt    = Bool()
+  val memOff  = UInt(64.W)
+  val ldDst   = UInt(6.W)
+
+  // m12-008: memory access shape (single and multi-register).
+  //   memWidth: 0 = byte, 1 = wyde, 2 = tetra, 3 = octa (1 << memWidth bytes)
+  val isLdm    = Bool()
+  val isStm    = Bool()
+  val memWidth = UInt(2.W)
+  val memSigned = Bool()
+  val ldBank   = UInt(2.W) // single load destination bank
+  val stBank   = UInt(2.W) // single store data-source bank
+  val mregStart = UInt(6.W)
+  val mregBank  = UInt(2.W)
+  val mregCount = UInt(6.W)
+
+  val isSemi  = Bool()
+
+  // m12-007: branches, CFXTRAP handoff, escape and the minimal cfx register
+  // subset.  `brCond` codes: 0 = n, 1 = nn, 2 = z, 3 = nz, 4 = p, 5 = np.
+  val isBr     = Bool()
+  val brCond   = UInt(3.W)
+  val brOff    = UInt(64.W)
+  val isTrap   = Bool()
+  val isEscape = Bool()
+  val escOff   = UInt(64.W)
+  val isCfx2   = Bool()
+  val cfxWrite = Bool()
+  val cfxHa    = UInt(6.W)
+  val cfxCg    = UInt(6.W)
+  val cfxRc    = UInt(6.W)
+  val cfxDst   = UInt(6.W)
+
+  // m12-010: `lr`/`sc` (spec/SimRISC-12 §1).  The address register is `rbHD`,
+  // the loaded value / stored value register is `rdHC`; `sc`'s success flag is
+  // `rdHB` and its access width is that of the mnemonic.
+  val isLr     = Bool()
+  val isSc     = Bool()
+  // m12-010: `fence` (spec/SimRISC-11 §5) and `swym` (spec/SimRISC-12 §2) are
+  // recognised no-ops on this core: they only consume the fetch slot.
+  val isFence  = Bool()
+  val isSwym   = Bool()
+  // m12-010: conditional assignment (spec/SimRISC-02 §2).
+  //   csCond: 0 = n, 1 = z, 2 = p, 3 = eq, 4 = ne
+  val isCs     = Bool()
+  val csCond   = UInt(3.W)
+  // m12-010: same-bank / cross-bank register-block copy (spec/SimRISC-02 §1).
+  val isCopy      = Bool()
+  val copyDstBank = UInt(2.W)
+  val copySrcBank = UInt(2.W)
+}
+
+class WumingDecoder extends Module {
+  val io = IO(new Bundle {
+    val inst = Input(UInt(32.W))
+    val dec  = Output(new WumingDecode)
+  })
+
+  val d    = io.dec
+  val inst = io.inst
+
+  val opc  = inst(31, 24)
+  val ha   = inst(23, 18)
+  val hb   = inst(17, 12)
+  val hc   = inst(11, 6)
+  val hd   = inst(5, 0)
+  val imm16 = inst(15, 0)
+  val imm12 = inst(11, 0)
+  val imm18 = inst(17, 0)
+  val imm24 = inst(23, 0)
+
+  def sext(x: UInt): UInt = x.asSInt.pad(64).asUInt
+  def zext(x: UInt): UInt = x.pad(64)
+
+  val imms18 = sext(imm18)
+  // cfxha of a *defined* core feature extension: 0-5, 15, 32-34, 62-63
+  // (contracts/opcodes.yaml `encode_cfx_reserved`, spec/DADAO-12 §5.1).
+  def cfxAccessible(x: UInt): Bool =
+    (x <= 5.U) || (x === 15.U) || (x >= 32.U && x <= 34.U) || (x >= 62.U)
+  val imms12 = sext(imm12)
+  val immu12 = zext(imm12)
+
+  // ---- defaults ---------------------------------------------------------
+  d.ill := false.B
+  d.undi := false.B
+  d.aluOp := WumingAluOp.ADD_U
+  d.opWidth := 3.U
+  d.srcAIdx := 0.U; d.srcABank := WumingBank.RD; d.srcAIsIp := false.B
+  d.srcBIdx := 0.U; d.srcBBank := WumingBank.RD
+  d.srcCIdx := 16.U; d.srcCBank := WumingBank.RB
+  d.useImmB := false.B; d.shamtFromImm := false.B
+  d.imm := 0.U
+  d.wp := inst(17, 16)
+  d.w0En := false.B; d.w0Idx := 0.U; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+  d.w1En := false.B; d.w1Idx := 0.U; d.w1Bank := WumingBank.RD; d.w1Sel := 0.U
+  d.isJump := false.B; d.jumpOff := 0.U
+  d.isCall := false.B; d.isRet := false.B
+  d.isLd := false.B; d.isSt := false.B; d.memOff := 0.U; d.ldDst := 0.U
+  d.isLdm := false.B; d.isStm := false.B
+  d.memWidth := 3.U; d.memSigned := false.B
+  d.ldBank := WumingBank.RD; d.stBank := WumingBank.RD
+  d.mregStart := 0.U; d.mregBank := WumingBank.RD; d.mregCount := 1.U
+  d.isSemi := false.B
+  d.isBr := false.B; d.brCond := 0.U; d.brOff := 0.U
+  d.isTrap := false.B; d.isEscape := false.B; d.escOff := 0.U
+  d.isCfx2 := false.B; d.cfxWrite := false.B
+  d.cfxHa := 0.U; d.cfxCg := 0.U; d.cfxRc := 0.U; d.cfxDst := 0.U
+  d.isLr := false.B; d.isSc := false.B
+  d.isFence := false.B; d.isSwym := false.B
+  d.isCs := false.B; d.csCond := 0.U
+  d.isCopy := false.B; d.copyDstBank := WumingBank.RD; d.copySrcBank := WumingBank.RD
+
+  val recognized = WireDefault(false.B)
+
+  def bankOf(isRb: Bool): UInt = Mux(isRb, WumingBank.RB, WumingBank.RD)
+
+  // ---- rwii: set.zw / set.ow / or.w / andn.w (SimRISC-03) ---------------
+  def rwii(isRb: Bool, op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := ha; d.srcABank := bankOf(isRb)
+    d.useImmB := true.B
+    d.imm := zext(imm16)
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := bankOf(isRb); d.w0Sel := 0.U
+    when(ha === 0.U) { d.ill := true.B }
+  }
+
+  // ---- shared operand/result shapes -------------------------------------
+  def orrrLogic(op: UInt): Unit = {
+    d.aluOp := op
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD; d.srcAIsIp := false.B
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def orrrShift(op: UInt): Unit = {
+    // Register form: rdHB = shift/ext(rdHC, rdHD[5:0]).
+    d.aluOp := op
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def rriiDst(op: UInt, signedImm: Bool): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hb; d.srcABank := WumingBank.RD
+    d.useImmB := true.B
+    d.imm := Mux(signedImm, imms12, immu12)
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(ha === 0.U) { d.ill := true.B }
+  }
+
+  def quad(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 1.U
+    d.w1En := true.B; d.w1Idx := hb; d.w1Bank := WumingBank.RD; d.w1Sel := 0.U
+    when(ha === 0.U && hb === 0.U) { d.ill := true.B }
+    when(ha === hb && ha =/= 0.U) { d.ill := true.B }
+  }
+
+  def bbd(op: UInt): Unit = {
+    // rbHB = rbHC <op> rdHD
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RB
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RB; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def dbb(op: UInt): Unit = {
+    // rdHB = rbHC <op> rbHD
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RB
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RB
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def octaOrri(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  // ---- m12-010: bit manipulation across the four width sub-tables ---------
+  //
+  // `width` is the log2 code (0 = byte, 1 = wyde, 2 = tetra, 3 = octa).  The
+  // shift/rotate immediate forms take `immu6` as `shamt`; the spec bounds it by
+  // the width (N = 8*2^width - 1) and out-of-range values are `encode_sbz`
+  // (SimRISC-08/09/10 §2).  The register forms mask the amount to N bits, so
+  // they never need a legality check (spec/SimRISC-04 §2.2).
+  def widthOrrr(op: UInt, width: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def widthOrri(op: UInt, width: UInt, shamtMax: Int): Unit = {
+    d.aluOp := op
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+    when(hd > shamtMax.U) { d.ill := true.B }
+  }
+
+  // `rev.<width> rdHB, rdHC, immu6`: block size S = 8*2^width, unit k.  Legality
+  // `encode_onehot`: k must be a power of two and strictly smaller than S
+  // (SimRISC-04 §2.2.1, SimRISC-08/09/10 §2.1).
+  def revOrri(width: UInt, blockBits: Int): Unit = {
+    d.aluOp := WumingAluOp.REV
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+    when(PopCount(hd) =/= 1.U || hd >= blockBits.U) { d.ill := true.B }
+  }
+
+  // `ctpop`/`ctlz`/`cttz rdHB, rdHC, immu6`: `immu6` is the valid-bit upper
+  // bound `hd` (0..63), so every immediate is legal (spec/SimRISC-12 §3).
+  def bitCount(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  // ---- m12-010: register-block copy (spec/SimRISC-02 §1) ------------------
+  //
+  // `orri`: hb = destination start (or rbHB/raHB), hc = source start,
+  // hd = immu6 register count (1..63).
+  def blockCopy(dstBank: UInt, srcBank: UInt): Unit = {
+    d.isCopy := true.B
+    d.copyDstBank := dstBank
+    d.copySrcBank := srcBank
+    d.srcAIdx := hc; d.srcABank := srcBank
+    d.useImmB := true.B; d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := dstBank; d.w0Sel := 0.U
+    when(hd === 0.U) { d.ill := true.B }                    // mreg_zero
+    when(hb +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    when(hc +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    // dst_rd0 / dst_rb0: ra0 and rf0 are legal destinations (spec/SimRISC-02 §1).
+    when(hb === 0.U && (dstBank === WumingBank.RD || dstBank === WumingBank.RB)) {
+      d.ill := true.B
+    }
+    // mreg_range_overlap: only same-bank copies can overlap.
+    when(dstBank === srcBank) {
+      when(hb < (hc +& hd) && hc < (hb +& hd)) { d.ill := true.B }
+    }
+  }
+
+  // ---- m12-010: conditional assignment (spec/SimRISC-02 §2) ---------------
+  //
+  // class 1: cs.n/cs.z/cs.p  -> if (cond(rdHA)) rdHB = rdHC else rdHB = rdHD
+  // class 2: cs.eq/cs.ne     -> if (rdHA ==/!= rdHB) rdHC = rdHD
+  def condAssign(cond: UInt, class1: Boolean): Unit = {
+    d.isCs := true.B
+    d.csCond := cond
+    d.srcAIdx := ha; d.srcABank := WumingBank.RD
+    if (class1) {
+      // The "then" value is rdHC, the "else" value rdHD (r2 port).
+      d.srcBIdx := hc; d.srcBBank := WumingBank.RD
+      d.srcCIdx := hd; d.srcCBank := WumingBank.RD
+      d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+      when(hb === 0.U) { d.ill := true.B }                  // dst_rd0
+    } else {
+      // The second comparand is rdHB; the assigned value is rdHD, and the
+      // destination is rdHC (`dst_rd0` applies to rdHC here).
+      d.srcBIdx := hb; d.srcBBank := WumingBank.RD
+      d.srcCIdx := hd; d.srcCBank := WumingBank.RD
+      d.w0En := true.B; d.w0Idx := hc; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+      when(hc === 0.U) { d.ill := true.B }                  // dst_rd0
+    }
+  }
+
+  // ---- memory shapes (spec/SimRISC-01) ----------------------------------
+  // `memWidth` = log2(access bytes); `memSigned` selects sb/sw/st vs ub/uw/ut.
+  // Single-element address = rbHB + imms12; multi-register address =
+  // rbHB + rdHC (the *original* rdHC, spec/SimRISC-01 §1).
+  def singleMem(isLoad: Bool, width: UInt, signed: Bool, bank: UInt): Unit = {
+    d.isLd := isLoad
+    d.isSt := !isLoad
+    d.memWidth := width
+    d.memSigned := signed
+    d.memOff := imms12
+    d.srcAIdx := hb; d.srcABank := WumingBank.RB
+    d.srcBIdx := ha; d.srcBBank := bank
+    d.ldDst := ha
+    d.ldBank := bank
+    d.stBank := bank
+    // dst_rd0 / dst_rb0: the load destination may not be the bank's zero
+    // register (the RA bank's ra0 is writable, spec/SimRISC-01 §3).
+    when(isLoad && ha === 0.U && bank =/= WumingBank.RA) { d.ill := true.B }
+  }
+
+  def multiMem(isLoad: Bool, width: UInt, signed: Bool, bank: UInt): Unit = {
