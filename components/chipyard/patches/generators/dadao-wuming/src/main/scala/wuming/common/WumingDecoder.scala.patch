+++ b/generators/dadao-wuming/src/main/scala/wuming/common/WumingDecoder.scala
@@ -0,0 +1,1187 @@
+// See LICENSE for license details.
+//
+// DADAO decoder for the M12 integer core.
+//
+// Formats covered (spec/SimRISC-00 §3.1): `orrr`, `orri`, `rrrr`, `riii`,
+// `rrii`, `rrri` plus the `rwii` forms retained from m12-003, and the legacy
+// `ld.o` / `st.o` / `jump` / semihosting `trap` shapes.  Instruction families:
+//
+//   SimRISC-01 (memory)  ld/st every integer width (b/w/t/o, signed and zero
+//                        extending), the RD/RB/RA banks and ldm/stm (m12-008)
+//   SimRISC-04 (64-bit)  and/or/xor/xnor, shl/rol/shr, ext, cmp, add.o/sub.o,
+//                        div/rem, and the `rrrr` add/sub/mul (128-bit result)
+//   SimRISC-05 (address) add.si (rd/rb), aip.si, add.o/sub.o, cmp.uo (dbb)
+//   SimRISC-08 (32-bit)  add/sub/cmp/mul/div/rem/shl/rol/shr
+//
+// Everything else is a fault, never a silent NOP:
+//   * an encoding defined by contracts/opcodes.yaml but not implemented in
+//     this milestone  -> ILLI (spec/SimRISC-00 §6.1)
+//   * an unallocated QFC / sub-table cell -> UNDI (spec/SimRISC-00 §6.2,
+//     contracts/legality_rules.yaml `excp_undi`)
+// and the legality rules of contracts/legality_rules.yaml are applied to the
+// implemented families (`dst_rd0`, `dst_rb0`, `dst_dual_same`, `encode_sbz`,
+// `mreg_zero`, `mreg_range_overflow`, `mreg_range_addr_overlap`).
+//
+// m12-chipyard-007 adds exactly what the BootROM firmware needs to make the
+// `power -> hmon -> application` handoff run on this core (fixed firmware,
+// spec/Machine-v5 §6.1/§6.2):
+//
+//   * `br.n`/`br.nn`/`br.z`/`br.nz`/`br.p`/`br.np` (rd) and `br.z`/`br.nz`
+//     (rb) — the table-validation/copy loops of the power stub; relative to
+//     `rb0` = current IP, offset `imms18 << 2` (spec/SimRISC-06 §1);
+//   * `trap cfx_hmon, <immu18>` outside the semihosting tag window (CFXTRAP
+//     handoff); the semihosting window stays `immu18[17:8] == 0x3FF`;
+//   * `escape cfx_hmon, [excp_cause_ip, 0|4]` (DADAO-12 §5.3);
+//   * `cfx2rd`/`cfx2rc` for the minimal `cfx_hmon` register subset the two
+//     stubs use (cg3 rc10 vector, cg5 rc2/rc3/rc4 cause frame).
+//
+// The rest of control flow (`call`/`ret`/relative `jump`/`br.eq`/`br.ne`/RAS)
+// and the full cfx register group stay with m12-chipyard-009/019.
+//
+// m12-chipyard-009 completes control flow (spec/SimRISC-06, spec/SimRISC-00
+// §2.4): `br.eq`/`br.ne` (rrii), the relative `jump` (iiii), `call` (iiii and
+// rrii, return address = current IP + 4) and `ret rdHA, imms18` (the return
+// address comes from the RAS, not from an operand).  The RAS push/pop cases
+// (C1-C3b / D1-D4b) live in the core; the decoder only marks the operation.
+//
+// m12-chipyard-010 closes the non-cfx instruction set:
+//
+//   * bit manipulation: `rev.o/.t/.w/.b` (`encode_onehot` on the unit size),
+//     `rol.o/.t/.w/.b` (orrr/orri), `ctpop`/`ctlz`/`cttz` (the immediate is the
+//     valid-bit bound, so every value is legal) and `clmul.o`;
+//   * the whole OPC-tetra/wyde/byte sub-table layout (arithmetic, compare,
+//     shifts) through one shared `widthTable` helper;
+//   * atomics `lr`/`sc` (24 forms: `sc`'s rdHB is the result, `lr`'s is SBZ)
+//     and the barrier/no-op pair `fence`/`swym`;
+//   * `cs.n/.z/.p/.eq/.ne` conditional assignment and the register-block copies
+//     `rd2rd`/`ra2rd`/`rd2ra`/`rb2rb`/`rd2rb`/`rb2rd` (with the range and
+//     overlap legality rules).
+//
+// m12-chipyard-011 opens the `rf` (floating point) bank and the FP
+// infrastructure of spec/SimRISC-07:
+//
+//   * the rf forms of the memory family (`ld/st/ldm/stm` in the rf bank,
+//     spec/SimRISC-01 §4), `set.w rf0` (spec/SimRISC-03 §1: only the selected
+//     wyde is replaced, the FCSR write mask makes `wp2`/`wp0` the rounding mode
+//     and the flags and `wp1`/`wp3` write-invalid), `cs.*` rf
+//     (spec/SimRISC-02 §2) and `rd2rf`/`rf2rd` (spec/SimRISC-02 §1);
+//   * `ftcls`/`focls` (block classify, spec/SimRISC-07 §5);
+//   * `ftsgnj`/`ftsgnn`/`fosgnj`/`fosgnn` (sign injection, §3).
+//
+// m12-chipyard-012 adds the format conversions (spec/SimRISC-07 §1): the 15
+// rounded ones (six-direction field), the 3 exact ones (SBZ) and the two
+// register-window copies.
+//
+// m12-chipyard-013 adds the arithmetic family (spec/SimRISC-07 §2/§4): the
+// `orrr` add/sub/multiply, the min/max and the quiet/signalling compare forms,
+// plus the single-destination `rrrr` fused multiply-add (`opc 0x5E/0x5F`).
+//
+// m12-chipyard-014 adds the multi-cycle family (spec/SimRISC-07 §2.1/§2.2):
+// `ftdiv`/`fodiv`, `ftrem`/`forem` and `ftroot`/`foroot` (n = 2 only).
+//
+// m12-chipyard-015 adds `roundToIntegral` (spec/SimRISC-07 §2.3) and `scaleB`
+// (§2.1) -- the last two FP groups; with them every defined FP instruction is
+// decoded and `opc 0x44` has no ILLI cell left except the undefined ones.
+
+package wuming.common
+
+import chisel3._
+import chisel3.util._
+
+/** Register bank selectors shared by the decoder, the core and the regfile. */
+object WumingBank {
+  val RD = 0.U(2.W)
+  val RB = 1.U(2.W)
+  val RA = 2.U(2.W)
+  val RF = 3.U(2.W)
+}
+
+class WumingDecode extends Bundle {
+  val ill  = Bool()
+  val undi = Bool()
+
+  val aluOp = UInt(6.W)
+  val opWidth = UInt(2.W) // 3 = octa, 2 = tetra
+
+  val srcAIdx  = UInt(6.W)
+  val srcABank = UInt(2.W)
+  val srcAIsIp = Bool()
+  val srcBIdx  = UInt(6.W)
+  val srcBBank = UInt(2.W)
+  val srcCIdx  = UInt(6.W)
+  val srcCBank = UInt(2.W)
+
+  val useImmB     = Bool()
+  val shamtFromImm = Bool()
+  val imm         = UInt(64.W)
+  val wp          = UInt(2.W)
+
+  val w0En   = Bool()
+  val w0Idx  = UInt(6.W)
+  val w0Bank = UInt(2.W)
+  val w0Sel  = UInt(1.W) // 0 = ALU lo, 1 = ALU hi
+  val w1En   = Bool()
+  val w1Idx  = UInt(6.W)
+  val w1Bank = UInt(2.W)
+  val w1Sel  = UInt(1.W)
+
+  val isJump  = Bool()
+  val jumpOff = UInt(64.W)
+  // m12-009: `call` reuses the jump target arithmetic and additionally pushes
+  // the return address (ip + 4); `ret` pops the RAS and writes one rd with the
+  // sign-extended imms18 (spec/SimRISC-06 §3/§4).
+  val isCall  = Bool()
+  val isRet   = Bool()
+  val isLd    = Bool()
+  val isSt    = Bool()
+  val memOff  = UInt(64.W)
+  val ldDst   = UInt(6.W)
+
+  // m12-008: memory access shape (single and multi-register).
+  //   memWidth: 0 = byte, 1 = wyde, 2 = tetra, 3 = octa (1 << memWidth bytes)
+  val isLdm    = Bool()
+  val isStm    = Bool()
+  val memWidth = UInt(2.W)
+  val memSigned = Bool()
+  val ldBank   = UInt(2.W) // single load destination bank
+  val stBank   = UInt(2.W) // single store data-source bank
+  val mregStart = UInt(6.W)
+  val mregBank  = UInt(2.W)
+  val mregCount = UInt(6.W)
+
+  val isSemi  = Bool()
+
+  // m12-007: branches, CFXTRAP handoff, escape and the minimal cfx register
+  // subset.  `brCond` codes: 0 = n, 1 = nn, 2 = z, 3 = nz, 4 = p, 5 = np.
+  val isBr     = Bool()
+  val brCond   = UInt(3.W)
+  val brOff    = UInt(64.W)
+  val isTrap   = Bool()
+  val isEscape = Bool()
+  val escOff   = UInt(64.W)
+  val isCfx2   = Bool()
+  val cfxWrite = Bool()
+  val cfxHa    = UInt(6.W)
+  val cfxCg    = UInt(6.W)
+  val cfxRc    = UInt(6.W)
+  val cfxDst   = UInt(6.W)
+
+  // m12-010: `lr`/`sc` (spec/SimRISC-12 §1).  The address register is `rbHD`,
+  // the loaded value / stored value register is `rdHC`; `sc`'s success flag is
+  // `rdHB` and its access width is that of the mnemonic.
+  val isLr     = Bool()
+  val isSc     = Bool()
+  // m12-010: `fence` (spec/SimRISC-11 §5) and `swym` (spec/SimRISC-12 §2) are
+  // recognised no-ops on this core: they only consume the fetch slot.
+  val isFence  = Bool()
+  val isSwym   = Bool()
+  // m12-010: conditional assignment (spec/SimRISC-02 §2).
+  //   csCond: 0 = n, 1 = z, 2 = p, 3 = eq, 4 = ne
+  val isCs     = Bool()
+  val csCond   = UInt(3.W)
+  // m12-011: block FP classification (src rf -> dst rd), one element per cycle.
+  val isCls = Bool()
+  val clsFo = Bool()
+  // m12-010: same-bank / cross-bank register-block copy (spec/SimRISC-02 §1).
+  val isCopy      = Bool()
+  val copyDstBank = UInt(2.W)
+  val copySrcBank = UInt(2.W)
+  // m12-012: format conversions (spec/SimRISC-07 §1, ADR-0050).  `cvtKind`
+  // selects the unit inside `WumingFPConvert`, `cvtImm6` is the low 6 bits of
+  // the instruction (six-direction field or SBZ) and `cvtExact` marks the three
+  // SBZ conversions, whose result never depends on a rounding direction.
+  val isCvt     = Bool()
+  val cvtKind   = UInt(4.W)
+  val cvtImm6   = UInt(6.W)
+  val cvtExact  = Bool()
+  val cvtSigned = Bool()
+  // m12-013: the arithmetic family (spec/SimRISC-07 §2).  `fpKind` selects the
+  // unit inside `WumingFPArith`, `fpFo` the format (ft = 32-bit, fo = 64-bit).
+  val isFpArith = Bool()
+  val fpKind    = UInt(3.W)
+  val fpFo      = Bool()
+  // m12-014: the multi-cycle divide / root / remainder family.  `fpSlowKind`
+  // selects the unit inside `WumingFpSlow`; `fpFo` is shared with the
+  // arithmetic family above.
+  val isFpSlow   = Bool()
+  val fpSlowKind = UInt(2.W)
+  // m12-015: `roundToIntegral` (§2.3) and `scaleB` (§2.1).  `fpRndCode` is the
+  // low 6 bits of `ftrnd`/`fornd` (the six one-hot directions of ADR-0050 D2);
+  // `isFpSclb` marks the forms whose second source is the *integer* `rdHD`.
+  // Both reuse `fpFo` for the format and are single-cycle.
+  val isFpRnd   = Bool()
+  val fpRndCode = UInt(6.W)
+  val isFpSclb  = Bool()
+}
+
+class WumingDecoder extends Module {
+  val io = IO(new Bundle {
+    val inst = Input(UInt(32.W))
+    val dec  = Output(new WumingDecode)
+  })
+
+  val d    = io.dec
+  val inst = io.inst
+
+  val opc  = inst(31, 24)
+  val ha   = inst(23, 18)
+  val hb   = inst(17, 12)
+  val hc   = inst(11, 6)
+  val hd   = inst(5, 0)
+  val imm16 = inst(15, 0)
+  val imm12 = inst(11, 0)
+  val imm18 = inst(17, 0)
+  val imm24 = inst(23, 0)
+
+  def sext(x: UInt): UInt = x.asSInt.pad(64).asUInt
+  def zext(x: UInt): UInt = x.pad(64)
+
+  val imms18 = sext(imm18)
+  // cfxha of a *defined* core feature extension: 0-5, 15, 32-34, 62-63
+  // (contracts/opcodes.yaml `encode_cfx_reserved`, spec/DADAO-12 §5.1).
+  def cfxAccessible(x: UInt): Bool =
+    (x <= 5.U) || (x === 15.U) || (x >= 32.U && x <= 34.U) || (x >= 62.U)
+  val imms12 = sext(imm12)
+  val immu12 = zext(imm12)
+
+  // ---- defaults ---------------------------------------------------------
+  d.ill := false.B
+  d.undi := false.B
+  d.aluOp := WumingAluOp.ADD_U
+  d.opWidth := 3.U
+  d.srcAIdx := 0.U; d.srcABank := WumingBank.RD; d.srcAIsIp := false.B
+  d.srcBIdx := 0.U; d.srcBBank := WumingBank.RD
+  d.srcCIdx := 16.U; d.srcCBank := WumingBank.RB
+  d.useImmB := false.B; d.shamtFromImm := false.B
+  d.imm := 0.U
+  d.wp := inst(17, 16)
+  d.w0En := false.B; d.w0Idx := 0.U; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+  d.w1En := false.B; d.w1Idx := 0.U; d.w1Bank := WumingBank.RD; d.w1Sel := 0.U
+  d.isJump := false.B; d.jumpOff := 0.U
+  d.isCall := false.B; d.isRet := false.B
+  d.isLd := false.B; d.isSt := false.B; d.memOff := 0.U; d.ldDst := 0.U
+  d.isLdm := false.B; d.isStm := false.B
+  d.memWidth := 3.U; d.memSigned := false.B
+  d.ldBank := WumingBank.RD; d.stBank := WumingBank.RD
+  d.mregStart := 0.U; d.mregBank := WumingBank.RD; d.mregCount := 1.U
+  d.isSemi := false.B
+  d.isBr := false.B; d.brCond := 0.U; d.brOff := 0.U
+  d.isTrap := false.B; d.isEscape := false.B; d.escOff := 0.U
+  d.isCfx2 := false.B; d.cfxWrite := false.B
+  d.cfxHa := 0.U; d.cfxCg := 0.U; d.cfxRc := 0.U; d.cfxDst := 0.U
+  d.isLr := false.B; d.isSc := false.B
+  d.isFence := false.B; d.isSwym := false.B
+  d.isCs := false.B; d.csCond := 0.U
+  d.isCls := false.B; d.clsFo := false.B
+  d.isCopy := false.B; d.copyDstBank := WumingBank.RD; d.copySrcBank := WumingBank.RD
+  d.isCvt := false.B; d.cvtKind := WumingCvtKind.F2I_FT_T; d.cvtImm6 := 0.U
+  d.cvtExact := false.B; d.cvtSigned := true.B
+  d.isFpArith := false.B; d.fpKind := WumingFPArithOp.ADD; d.fpFo := false.B
+  d.isFpSlow := false.B; d.fpSlowKind := WumingFpSlowKind.DIV
+  d.isFpRnd := false.B; d.fpRndCode := 0.U; d.isFpSclb := false.B
+
+  val recognized = WireDefault(false.B)
+
+  def bankOf(isRb: Bool): UInt = Mux(isRb, WumingBank.RB, WumingBank.RD)
+
+  // ---- rwii: set.zw / set.ow / or.w / andn.w (SimRISC-03) ---------------
+  def rwii(isRb: Bool, op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := ha; d.srcABank := bankOf(isRb)
+    d.useImmB := true.B
+    d.imm := zext(imm16)
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := bankOf(isRb); d.w0Sel := 0.U
+    when(ha === 0.U) { d.ill := true.B }
+  }
+
+  // ---- shared operand/result shapes -------------------------------------
+  def orrrLogic(op: UInt): Unit = {
+    d.aluOp := op
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD; d.srcAIsIp := false.B
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def orrrShift(op: UInt): Unit = {
+    // Register form: rdHB = shift/ext(rdHC, rdHD[5:0]).
+    d.aluOp := op
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def rriiDst(op: UInt, signedImm: Bool): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hb; d.srcABank := WumingBank.RD
+    d.useImmB := true.B
+    d.imm := Mux(signedImm, imms12, immu12)
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(ha === 0.U) { d.ill := true.B }
+  }
+
+  def quad(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 1.U
+    d.w1En := true.B; d.w1Idx := hb; d.w1Bank := WumingBank.RD; d.w1Sel := 0.U
+    when(ha === 0.U && hb === 0.U) { d.ill := true.B }
+    when(ha === hb && ha =/= 0.U) { d.ill := true.B }
+  }
+
+  def bbd(op: UInt): Unit = {
+    // rbHB = rbHC <op> rdHD
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RB
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RB; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def dbb(op: UInt): Unit = {
+    // rdHB = rbHC <op> rbHD
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RB
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RB
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def octaOrri(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  // ---- m12-010: bit manipulation across the four width sub-tables ---------
+  //
+  // `width` is the log2 code (0 = byte, 1 = wyde, 2 = tetra, 3 = octa).  The
+  // shift/rotate immediate forms take `immu6` as `shamt`; the spec bounds it by
+  // the width (N = 8*2^width - 1) and out-of-range values are `encode_sbz`
+  // (SimRISC-08/09/10 §2).  The register forms mask the amount to N bits, so
+  // they never need a legality check (spec/SimRISC-04 §2.2).
+  def widthOrrr(op: UInt, width: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  def widthOrri(op: UInt, width: UInt, shamtMax: Int): Unit = {
+    d.aluOp := op
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+    when(hd > shamtMax.U) { d.ill := true.B }
+  }
+
+  // `rev.<width> rdHB, rdHC, immu6`: block size S = 8*2^width, unit k.  Legality
+  // `encode_onehot`: k must be a power of two and strictly smaller than S
+  // (SimRISC-04 §2.2.1, SimRISC-08/09/10 §2.1).
+  def revOrri(width: UInt, blockBits: Int): Unit = {
+    d.aluOp := WumingAluOp.REV
+    d.opWidth := width
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+    when(PopCount(hd) =/= 1.U || hd >= blockBits.U) { d.ill := true.B }
+  }
+
+  // `ctpop`/`ctlz`/`cttz rdHB, rdHC, immu6`: `immu6` is the valid-bit upper
+  // bound `hd` (0..63), so every immediate is legal (spec/SimRISC-12 §3).
+  def bitCount(op: UInt): Unit = {
+    d.aluOp := op
+    d.opWidth := 3.U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.shamtFromImm := true.B
+    d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }
+  }
+
+  // ---- m12-010: register-block copy (spec/SimRISC-02 §1) ------------------
+  //
+  // `orri`: hb = destination start (or rbHB/raHB), hc = source start,
+  // hd = immu6 register count (1..63).
+  def blockCopy(dstBank: UInt, srcBank: UInt): Unit = {
+    d.isCopy := true.B
+    d.copyDstBank := dstBank
+    d.copySrcBank := srcBank
+    d.srcAIdx := hc; d.srcABank := srcBank
+    d.useImmB := true.B; d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := dstBank; d.w0Sel := 0.U
+    when(hd === 0.U) { d.ill := true.B }                    // mreg_zero
+    when(hb +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    when(hc +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    // dst_rd0 / dst_rb0: ra0 and rf0 are legal destinations (spec/SimRISC-02 §1).
+    when(hb === 0.U && (dstBank === WumingBank.RD || dstBank === WumingBank.RB)) {
+      d.ill := true.B
+    }
+    // mreg_range_overlap: only same-bank copies can overlap.
+    when(dstBank === srcBank) {
+      when(hb < (hc +& hd) && hc < (hb +& hd)) { d.ill := true.B }
+    }
+  }
+
+  // ---- m12-011: FP infrastructure ---------------------------------------
+  //
+  // `set.w rfHA, wpN, immu16` (spec/SimRISC-03 §1): only the selected wyde is
+  // replaced, so the ALU op preserves the other 48 bits.  rf0 is a legal
+  // destination -> the FCSR write mask turns that into "wp2 = rounding mode,
+  // wp0 = flags, wp1/wp3 = write-invalid".
+  def setWydeRf(): Unit = {
+    d.aluOp := WumingAluOp.SET_W
+    d.opWidth := 3.U
+    d.srcAIdx := ha; d.srcABank := WumingBank.RF
+    d.useImmB := true.B
+    d.imm := zext(imm16)
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+  }
+
+  // `ftcls`/`focls {rdHB:rdHB+immu6-1}, {rfHC:rfHC+immu6-1}` (spec/SimRISC-07
+  // §5): one classification per cycle in the core.  `dst_rd0`, `mreg_zero` and
+  // both range checks apply.
+  def classifyBlock(isFo: Boolean): Unit = {
+    d.isCls := true.B
+    d.clsFo := isFo.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.useImmB := true.B; d.imm := zext(hd)
+    d.w0Idx := hb
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rd0
+    when(hd === 0.U) { d.ill := true.B }                    // mreg_zero
+    when(hb +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    when(hc +& hd > 64.U) { d.ill := true.B }
+  }
+
+  // `ftsgnj`/`ftsgnn`/`fosgnj`/`fosgnn` (spec/SimRISC-07 §3): rfHB =
+  // copySign(rfHC, rfHD), optionally with the sign of rfHD inverted.
+  def signInject(op: UInt, isFo: Boolean): Unit = {
+    d.aluOp := op
+    d.opWidth := (if (isFo) 3 else 2).U
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+  }
+
+  // ---- m12-010: conditional assignment (spec/SimRISC-02 §2) ---------------
+  //
+  // class 1: cs.n/cs.z/cs.p  -> if (cond(rdHA)) rdHB = rdHC else rdHB = rdHD
+  // class 2: cs.eq/cs.ne     -> if (rdHA ==/!= rdHB) rdHC = rdHD
+  def condAssign(cond: UInt, class1: Boolean, rf: Boolean = false): Unit = {
+    d.isCs := true.B
+    d.csCond := cond
+    d.srcAIdx := ha; d.srcABank := WumingBank.RD
+    if (class1) {
+      // The "then" value is rdHC, the "else" value rdHD (r2 port).  The rf
+      // variants read both values from the rf bank and write rfHB.
+      val bank = if (rf) WumingBank.RF else WumingBank.RD
+      d.srcBIdx := hc; d.srcBBank := bank
+      d.srcCIdx := hd; d.srcCBank := bank
+      d.w0En := true.B; d.w0Idx := hb; d.w0Bank := bank; d.w0Sel := 0.U
+      when(hb === 0.U) { d.ill := true.B }                  // dst_rd0 / dst_rf0
+    } else {
+      // The second comparand is rdHB; the assigned value is rdHD, and the
+      // destination is rdHC (`dst_rd0` applies to rdHC here).
+      d.srcBIdx := hb; d.srcBBank := WumingBank.RD
+      d.srcCIdx := hd; d.srcCBank := WumingBank.RD
+      d.w0En := true.B; d.w0Idx := hc; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+      when(hc === 0.U) { d.ill := true.B }                  // dst_rd0
+    }
+  }
+
+  // ---- m12-012: format conversions (spec/SimRISC-07 §1, ADR-0050) --------
+  //
+  // 18 of the 20 conversions carry their rounding direction (15) or a SBZ (3)
+  // in the low 6 bits; the remaining two (`ft2ft`/`fo2fo`) keep the 1..63
+  // register-window form and reuse the block-copy machinery.
+  //
+  // `encode_onehot` (ADR-0050 D2): the direction field is one of the six
+  // one-hot values, anything else (including 0) is ILLI.  `encode_sbz`
+  // (ADR-0050 D3): the exact conversions require 0.
+  def cvtDirection(): Unit = {
+    d.cvtImm6 := hd
+    when(!(hd === 0x01.U || hd === 0x02.U || hd === 0x04.U ||
+      hd === 0x08.U || hd === 0x10.U || hd === 0x20.U)) { d.ill := true.B }
+  }
+
+  // float -> integer: `rdHB` destination (`dst_rd0`), `rfHC` source.
+  def cvtF2I(kind: UInt, signed: Boolean): Unit = {
+    d.isCvt := true.B
+    d.cvtKind := kind
+    d.cvtSigned := signed.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                   // dst_rd0
+    cvtDirection()
+  }
+
+  // integer -> float: `rfHB` destination (`dst_rf0`), `rdHC` source.
+  def cvtI2F(kind: UInt, signed: Boolean, exact: Boolean): Unit = {
+    d.isCvt := true.B
+    d.cvtKind := kind
+    d.cvtSigned := signed.B
+    d.cvtExact := exact.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                   // dst_rf0
+    if (exact) { when(hd =/= 0.U) { d.ill := true.B } }    // encode_sbz
+    else { cvtDirection() }                                // encode_onehot
+  }
+
+  // float -> float: `rfHB` destination, `rfHC` source.
+  def cvtF2F(kind: UInt, exact: Boolean): Unit = {
+    d.isCvt := true.B
+    d.cvtKind := kind
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                   // dst_rf0
+    if (exact) { when(hd =/= 0.U) { d.ill := true.B } }    // encode_sbz
+    else { cvtDirection() }                                // encode_onehot
+  }
+
+  // `ft2ft`/`fo2fo` (spec/SimRISC-07 §1.3): the same register-window copy as
+  // `rd2rd`, in the rf bank, with the copy legality set plus `dst_rf0`
+  // (unlike `rd2rf`, the block conversions of §1.3 may not target rf0).
+  def fpCopy(): Unit = {
+    d.isCopy := true.B
+    d.copyDstBank := WumingBank.RF
+    d.copySrcBank := WumingBank.RF
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.useImmB := true.B; d.imm := zext(hd)
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hd === 0.U) { d.ill := true.B }                    // mreg_zero
+    when(hb +& hd > 64.U) { d.ill := true.B }               // mreg_range_overflow
+    when(hc +& hd > 64.U) { d.ill := true.B }
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+    // mreg_range_overlap: same bank, so a source/destination intersection
+    // (including a full overlap) is ILLI.
+    when(hb < (hc +& hd) && hc < (hb +& hd)) { d.ill := true.B }
+  }
+
+  // ---- m12-013: arithmetic family (spec/SimRISC-07 §2) -------------------
+  //
+  // `orrr` S2D1 (`add`/`sub`/`mul`), `orrr` min/max and compare, and the
+  // single-destination `rrrr` FMA (spec §2.5: no brace form, no dual
+  // destination).  Every form takes its operands from the rf bank, reads them
+  // all before the write-back, and forbids `rf0` as the destination
+  // (`dst_rf0`); the compare forms write `rd` and forbid `rd0` (`dst_rd0`).
+  def fpArith(kind: UInt, isFo: Boolean): Unit = {
+    d.isFpArith := true.B
+    d.fpKind := kind
+    d.fpFo := isFo.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+  }
+
+  def fpCmp(isFo: Boolean, signaling: Boolean): Unit = {
+    d.isFpArith := true.B
+    d.fpKind := (if (signaling) WumingFPArithOp.SCMP else WumingFPArithOp.QCMP)
+    d.fpFo := isFo.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rd0
+  }
+
+  // `ftfma`/`fofma rfHA, rfHB, rfHC, rfHD` (spec §2.5): rfHA = rfHB*rfHC +
+  // rfHD, one destination, three sources (all rf), all may alias the
+  // destination.
+  def fpFma(isFo: Boolean): Unit = {
+    d.isFpArith := true.B
+    d.fpKind := WumingFPArithOp.FMA
+    d.fpFo := isFo.B
+    d.srcAIdx := hb; d.srcABank := WumingBank.RF
+    d.srcBIdx := hc; d.srcBBank := WumingBank.RF
+    d.srcCIdx := hd; d.srcCBank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(ha === 0.U) { d.ill := true.B }                    // dst_rf0
+  }
+
+  // ---- m12-014: divide / root / remainder (spec/SimRISC-07 §2) -----------
+  //
+  // `ftdiv`/`fodiv` and `ftrem`/`forem` are `orrr` (rfHB destination,
+  // rfHC/rfHD sources); `ftroot`/`foroot` are `orri` with `immu6` = n, and
+  // `encode_fp_root_n` (contracts/legality_rules.yaml) accepts only n = 2 --
+  // `rootn(x, 2)` is the square root (spec §2.2).  All six are multi-cycle in
+  // the core and forbid `rf0` as the destination (`dst_rf0`).
+  def fpSlow(kind: UInt, isFo: Boolean): Unit = {
+    d.isFpSlow := true.B
+    d.fpSlowKind := kind
+    d.fpFo := isFo.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+  }
+
+  def fpRoot(isFo: Boolean): Unit = {
+    fpSlow(WumingFpSlowKind.SQRT, isFo)
+    // `immu6` is the root degree; only n = 2 exists (encode_fp_root_n).
+    when(hd =/= 2.U) { d.ill := true.B }
+  }
+
+  // ---- m12-015: roundToIntegral / scaleB (spec/SimRISC-07 §2.3/§2.1) ------
+  //
+  // `ftrnd`/`fornd rfHB, rfHC, immu6`: the low 6 bits are the six-direction
+  // one-hot code (ADR-0050 D2) instead of a register count, so the legality is
+  // `encode_onehot` -- the same rule the rounded conversions use.
+  def fpRoundInt(isFo: Boolean): Unit = {
+    d.isFpRnd := true.B
+    d.fpFo := isFo.B
+    d.fpRndCode := hd
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+    when(!(hd === 0x01.U || hd === 0x02.U || hd === 0x04.U ||
+      hd === 0x08.U || hd === 0x10.U || hd === 0x20.U)) { d.ill := true.B }
+  }
+
+  // `ftsclb`/`fosclb rfHB, rfHC, rdHD`: the third operand is a signed 64-bit
+  // integer from the `rd` bank, not a float register -- `rd0` therefore means
+  // exponent 0, which falls out of `rd0` reading as zero.
+  def fpScaleB(isFo: Boolean): Unit = {
+    d.isFpSclb := true.B
+    d.fpFo := isFo.B
+    d.srcAIdx := hc; d.srcABank := WumingBank.RF
+    d.srcBIdx := hd; d.srcBBank := WumingBank.RD
+    d.w0En := true.B; d.w0Idx := hb; d.w0Bank := WumingBank.RF; d.w0Sel := 0.U
+    when(hb === 0.U) { d.ill := true.B }                    // dst_rf0
+  }
+
+  // ---- memory shapes (spec/SimRISC-01) ----------------------------------
+  // `memWidth` = log2(access bytes); `memSigned` selects sb/sw/st vs ub/uw/ut.
+  // Single-element address = rbHB + imms12; multi-register address =
+  // rbHB + rdHC (the *original* rdHC, spec/SimRISC-01 §1).
+  def singleMem(isLoad: Bool, width: UInt, signed: Bool, bank: UInt): Unit = {
+    d.isLd := isLoad
+    d.isSt := !isLoad
+    d.memWidth := width
+    d.memSigned := signed
+    d.memOff := imms12
+    d.srcAIdx := hb; d.srcABank := WumingBank.RB
+    d.srcBIdx := ha; d.srcBBank := bank
+    d.ldDst := ha
+    d.ldBank := bank
+    d.stBank := bank
+    // dst_rd0 / dst_rb0: the load destination may not be the bank's zero
+    // register.  The RA bank's ra0 and the RF bank's rf0 (FCSR) are writable
+    // (spec/SimRISC-01 §3/§4).
+    when(isLoad && ha === 0.U && (bank === WumingBank.RD || bank === WumingBank.RB)) {
+      d.ill := true.B
+    }
+  }
+
+  def multiMem(isLoad: Bool, width: UInt, signed: Bool, bank: UInt): Unit = {
+    d.isLdm := isLoad
+    d.isStm := !isLoad
+    d.memWidth := width
+    d.memSigned := signed
+    d.srcAIdx := hb; d.srcABank := WumingBank.RB
+    d.srcBIdx := hc; d.srcBBank := WumingBank.RD
+    d.mregStart := ha
+    d.mregBank := bank
+    d.mregCount := hd
+    // mreg_zero / mreg_range_overflow (spec/SimRISC-01 §1, legality_rules).
+    when(hd === 0.U) { d.ill := true.B }
+    when(ha +& hd > 64.U) { d.ill := true.B }
+    when(isLoad && ha === 0.U && (bank === WumingBank.RD || bank === WumingBank.RB)) {
+      d.ill := true.B
+    }
+    // mreg_range_addr_overlap (spec/SimRISC-01 §1/§2, legality_rules): `ldm`
+    // writes the transferred range one element at a time, so an address
+    // register that is itself inside the range would make the later element
+    // addresses depend on how far the loop got.  RD form: the index `rdHC`
+    // lives in the RD bank, like the range.  RB form: the base `rbHB` lives in
+    // the RB bank, like the range.  `stm` only *reads* the range and writes no
+    // register, so it may overlap; the RA/RF forms keep the range and both
+    // address registers in different banks (N/A).
+    when(isLoad) {
+      when(bank === WumingBank.RD && hc >= ha && hc < (ha +& hd)) {
+        d.ill := true.B
+      }
+      when(bank === WumingBank.RB && hb >= ha && hb < (ha +& hd)) {
+        d.ill := true.B
+      }
+    }
+  }
+
+  val widthByte = 0.U(2.W)
+  val widthWyde = 1.U(2.W)
+  val widthTetra = 2.U(2.W)
+  val widthOcta = 3.U(2.W)
+
+  // ---- main decode ------------------------------------------------------
+  when(opc >= 0x10.U && opc <= 0x17.U) {
+    // ld.{ub,uw,ut,sb,sw,st} rd + ld.t rf (SimRISC-01 §1/§4).
+    recognized := true.B
+    when(opc === 0x10.U) { singleMem(true.B, widthByte, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x11.U) { singleMem(true.B, widthWyde, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x12.U) { singleMem(true.B, widthTetra, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x13.U) { singleMem(true.B, widthByte, true.B, WumingBank.RD) }
+      .elsewhen(opc === 0x14.U) { singleMem(true.B, widthWyde, true.B, WumingBank.RD) }
+      .elsewhen(opc === 0x15.U) { singleMem(true.B, widthTetra, true.B, WumingBank.RD) }
+      // 0x16/0x17: `ld.t`/`st.t` in the rf bank (SimRISC-01 §4).  A tetra load
+      // into an rf register sign-extends into the 64-bit register: spec says
+      // bits [63:32] are unspecified for that case and sign extension is what
+      // QEMU does (`MO_BESL`), so the two engines agree bit for bit.
+      .elsewhen(opc === 0x16.U) { singleMem(true.B, widthTetra, true.B, WumingBank.RF) }
+      .otherwise { singleMem(false.B, widthTetra, false.B, WumingBank.RF) }
+  }.elsewhen(opc >= 0x18.U && opc <= 0x1A.U) {
+    // st.{b,w,t} rd (SimRISC-01 §1).  rd0 as the source is legal (reads 0).
+    recognized := true.B
+    when(opc === 0x18.U) { singleMem(false.B, widthByte, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x19.U) { singleMem(false.B, widthWyde, false.B, WumingBank.RD) }
+      .otherwise { singleMem(false.B, widthTetra, false.B, WumingBank.RD) }
+  }.elsewhen(opc >= 0x20.U && opc <= 0x27.U) {
+    // ld.o/st.o in the rd / rb / ra / rf banks (SimRISC-01 §1-§4).
+    recognized := true.B
+    when(opc === 0x20.U) { singleMem(true.B, widthOcta, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x21.U) { singleMem(false.B, widthOcta, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x22.U) { singleMem(true.B, widthOcta, false.B, WumingBank.RB) }
+      .elsewhen(opc === 0x23.U) { singleMem(false.B, widthOcta, false.B, WumingBank.RB) }
+      .elsewhen(opc === 0x24.U) { singleMem(true.B, widthOcta, false.B, WumingBank.RA) }
+      .elsewhen(opc === 0x25.U) { singleMem(false.B, widthOcta, false.B, WumingBank.RA) }
+      // 0x26/0x27: `ld.o`/`st.o` in the rf bank (SimRISC-01 §4).
+      .elsewhen(opc === 0x26.U) { singleMem(true.B, widthOcta, false.B, WumingBank.RF) }
+      .otherwise { singleMem(false.B, widthOcta, false.B, WumingBank.RF) }
+  }.elsewhen(opc >= 0x28.U && opc <= 0x2F.U) {
+    // ldm.{ub,uw,ut,sb,sw,st} rd + ldm.t rf (SimRISC-01 §1/§4).
+    recognized := true.B
+    when(opc === 0x28.U) { multiMem(true.B, widthByte, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x29.U) { multiMem(true.B, widthWyde, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x2A.U) { multiMem(true.B, widthTetra, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x2B.U) { multiMem(true.B, widthByte, true.B, WumingBank.RD) }
+      .elsewhen(opc === 0x2C.U) { multiMem(true.B, widthWyde, true.B, WumingBank.RD) }
+      .elsewhen(opc === 0x2D.U) { multiMem(true.B, widthTetra, true.B, WumingBank.RD) }
+      // 0x2E/0x2F: `ldm.t`/`stm.t` in the rf bank (SimRISC-01 §4).
+      .elsewhen(opc === 0x2E.U) { multiMem(true.B, widthTetra, true.B, WumingBank.RF) }
+      .otherwise { multiMem(false.B, widthTetra, false.B, WumingBank.RF) }
+  }.elsewhen(opc >= 0x30.U && opc <= 0x32.U) {
+    // stm.{b,w,t} rd (SimRISC-01 §1).  rd0 as the start register is legal.
+    recognized := true.B
+    when(opc === 0x30.U) { multiMem(false.B, widthByte, false.B, WumingBank.RD) }
+      .elsewhen(opc === 0x31.U) { multiMem(false.B, widthWyde, false.B, WumingBank.RD) }
+      .otherwise { multiMem(false.B, widthTetra, false.B, WumingBank.RD) }
+  }.elsewhen(opc >= 0x38.U && opc <= 0x3F.U) {
+    // ldm.o/stm.o in the rd / rb / ra / rf banks (SimRISC-01 §1-§4).
