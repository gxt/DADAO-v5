+  }.elsewhen(opc === 0x59.U) {
+    recognized := true.B
+    d.aluOp := WumingAluOp.ADD_S; d.opWidth := 3.U
+    d.srcAIdx := ha; d.srcABank := WumingBank.RD; d.useImmB := true.B; d.imm := imms18
+    d.w0En := true.B; d.w0Idx := ha; d.w0Bank := WumingBank.RD; d.w0Sel := 0.U
