+++ b/generators/dadao-gewu/src/main/scala/gewu/GewuFile.scala
@@ -0,0 +1,2234 @@
+// See LICENSE for license details.
+//
+// DADAO `gewu` generator — Gewu ≡ cfx 寄存器堆（类比 Rocket `CSRFile`）。
+//
+// cfx is the machine-level control plane of the DADAO machine (spec/
+// `DADAO-12`, `DADAO-13`, `Kaiwu`): a register file plus the authority
+// checks, the exception frame, `escape`/`power`/`hmon`.  It is *not* a
+// pipeline unit, so it is shipped as its own chipyard generator (`gewu`) and
+// any core that wants cfx just instantiates `GewuFile` and puts it on its
+// dependency list (ADR-0053 D1/D2).  The module is deliberately a library:
+// it depends on nothing but `rocketchip` types, and it knows no core.
+//
+// Boundaries (ADR-0053):
+//
+//   * D3 — the IO is the cfx contract: register read/write (`cfxha`/`cg`/`rc`
+//     address, write data/commit, read data, read/write permission), the
+//     exception entry (cause id/ip/info), the frame, the run mode, the IP, the
+//     interrupt mask, `escape`, `power`/`hmon` (as cfx instances) and the
+//     redirect request.  Inputs are **architectural events only** — "commit
+//     this cfx write", "enter this exception", "return with this `escape`" —
+//     never an internal pipeline signal, so any core can drive them.
+//   * D4 — `Gewu` only *requests* a redirect (`redirect.valid/target`); the
+//     program counter and the flush stay in the core.  Driving PC here would
+//     double-drive it against the core's own redirect/flush path.
+//   * D5 — every machine-specific number (how many cfx exist, which one owns
+//     the frame, the vector/space descriptors, the mask reset values, the run
+//     modes, the register widths) comes from `GewuParams`; this file contains
+//     no core constant.
+//   * D6 — the module/file is `Gewu`, the *registers* keep their `cfx_*` names
+//     (`spec/Kaiwu` §3, `ADR-0046`): the spec describes the cfx register
+//     file, not `Gewu`.
+//   * D7 — instruction decoding of the cfx instructions (`trap`/`escape`/
+//     `cfx2rd`/`cfx2rc`) is *not* here: each core's decoder owns that and hands
+//     the decoded (cfxha, cg, rc, write) to this module.
+//
+// Register groups implemented on this profile (`DADAO-12` §3, `DADAO-13` §1):
+//
+//   cg3 rc0-rc3  cfxtrap / cfxmem / cfxreg / cfxexe source masks   (RW)
+//                (`rc4` was `<mode>_cfx_intr_mask`; since `ADR-0061` D5 it is a
+//                reserved hole on a machine with `cfx_hart` ⇒ CFXREG, and the
+//                legacy RW row is kept only where no async model exists)
+//   cg3 rc14     switch_run_mode — write accepted, ignored; reads the
+//                configured value (a core that keeps one run mode)
+//   cg3 rc15     excp_vector — reset = the cfx's own base; writes drop the low
+//                two bits
+//   cg5 rc0-rc3  prev run mode / cfx code / ip / intr mask (entry record, RO)
+//   cg5 rc4/rc5  excp_cause_id / excp_cause_info (hardware-written, read-only)
+//   cg5 rc8-rc11 escape run mode / cfx code / ip / intr mask (exit intent,
+//                HW-copied at entry, software-writable, `rc11` resets all 1s)
+//   cg7 rc0-63   internal space descriptors (read-only; writes are CFXREG)
+//
+// `cfx_ptw` (cfx4 on `Kaiwu-Vast`; absent on `Kaiwu-Tiny`, where those rows are
+// CFXREG) contributes its register face only — the walk and the TLB arrays are
+// core state (`m16-chipyard-006`/`007`/`008`):
+//
+//   cg8 rc8      cfx_ptw_enable            (RW; bit0, reset 0)
+//   cg9 rc0      cfx_ptw_ptbr              (RW; stores PPN[55:16] only)
+//   cg12 rc0     cfx_ptw_tlb_control       (WO; the write is the command, no
+//                                           completion state — exposed to the
+//                                           core as a one-cycle event)
+//   cg12 rc1     cfx_ptw_tlb_asid          (RW; [15:0], [63:16] read 0)
+//   cg12 rc2/3   cfx_ptw_tlb_addr_start/size (RW; VA[41:0] / byte count)
+//
+// `cfx_cache` (cfx5 on `Kaiwu-Vast`; absent on `Kaiwu-Tiny`, where those rows
+// are CFXREG) contributes its register face only — the I/D arrays and the
+// maintenance effects are core state (`m16-chipyard-009`/`010`, wired later):
+//
+//   cg8 rc0      cfx_cache_exist            (RO; bit0 = I, bit1 = D)
+//   cg8 rc8      cfx_cache_enable           (RW; reset = exist, masked by it)
+//   cg8 rc9      cfx_cache_ctrl             (WO; the write is the command)
+//   cg8 rc10     cfx_cache_addr_start       (RW; PA[55:0], [63:56] read 0)
+//   cg8 rc11     cfx_cache_addr_size        (RW; byte count)
+//
+// The **monitor common face** (`m16-chipyard-019`) is enabled per cfx with
+// `GewuCfxParams.commonRows`; `Kaiwu-Vast` turns it on for `cfx_umon` (cfx0)
+// and `cfx_smon` (cfx2), the two profiles this task adds.  cfx3/cfx63 keep the
+// legacy subset above so their observable behaviour does not move:
+//
+//   cg0-cg2 rc0-3 four sync source masks (RW; rc4 reserved)
+//   cg0-cg2 rc14   switch_run_mode (reset 2 = supv)
+//   cg0-cg2 rc15   excp_vector (reset 0; writes drop the low two bits)
+//   cg3 rc12       hypv_cg_reg_deleg (reset all ones, bit3 fixed 1)
+//   cg4 rc0-rc6    cfx_id / version / trap·sync·async·escape counts /
+//                  scratch_regs_num (all RO)
+//   cg6 rc0..N-1   scratch registers (RW, N = `GewuCfxParams.scratchRegs`)
+//   cg15 rc3       the running mode's async source mask
+//                  (`cfx_<monitor>_async_intr_mask`, `ADR-0064` D6): RW,
+//                  reset all ones, bit = source cfxha, cfx0-cfx3 only
+//
+// `cfx_hart` (cfx15 on `Kaiwu-Vast`; absent on `Kaiwu-Tiny`, where its rows are
+// CFXREG) adds the hart-management face and the seven-slot asynchronous frame
+// (`DADAO-12` §4.7, `ADR-0061` D7):
+//
+//   cg8 rc0/2/3  hart_id / cycle / insn (RO); `cg8 rc1`/`rc4`/`rc5` reserved
+//   cg15 rc0-rc5 async capture group: prev run mode / prev cfx code / prev ip /
+//                prev intr mask / src frame / raw pending summary (HW/RO;
+//                software writes are ignored without an exception)
+//   cg15 rc14/rc15 async_switch_run_mode (RW 2-bit, reset 2 = supv; also the
+//                entry run-mode upper bound) / async_excp_vector (RW, 4-byte
+//                aligned)
+//   cg15 rc6-rc13 reserved ⇒ CFXREG; `cg9` is reserved (CFXREG)
+//   cg16 rc0/rc1 timer_ctrl (RW; only bit0 ENABLE) / timer_cmp (RW)
+//   cg16 rc16    timer source mask (RW; bit0, 1 = mask, reset all ones)
+//   cg16 rc17    timer source pending (RO; bit0, ack-only clear)
+//   cg16 rc18    timer source ack (W1C; reads 0)
+//   cg16 rc2-rc15/rc19+ reserved ⇒ CFXREG
+//
+// `cfx0`-`cfx3 cg15 rc3` is the running mode's async source mask (`ADR-0064`
+// D6): bit = source cfxha, `0` = allow / `1` = mask, reset all ones; the old
+// `cg8 rc1` is reserved (CFXREG).
+//
+// Source pending (`cg16 rc16/17/18`) is the per-source event latch: an event
+// sets it, only the source ack clears it, and an asynchronous entry never
+// clears it (`ADR-0064` D3).  The source mask only gates the entry.
+//
+// The asynchronous entry obeys the run-mode upper bound (`m18-spec-009`): it
+// only happens while `runMode <= cg15 rc14` (the switch value is also the
+// highest mode that may be interrupted).  A pending source above the bound
+// stays pending with no error.
+//
+// `cfx_time` (cfx34 on `Kaiwu-Vast`; absent on `Kaiwu-Tiny`, where its rows are
+// CFXREG) is the per-system global time counter (`DADAO-12` §4.10): **read
+// only, no interrupt** — the per-hart timer and its interrupt stay in
+// `cfx_hart` (`§4.7`), so nothing here arms, compares or delivers:
+//
+//   cg10 rc0     time_freq (RO; the machine's counting frequency in Hz)
+//   cg10 rc1     time_value (RO; free-running 64-bit count, reset from 0)
+//   cg10 rc2-63  reserved ⇒ CFXREG
+//
+// `cfx_power` also has `cg8 rc1 cfx_power_ctrl` (`DADAO-12` §4.12) on the
+// translating machine (`m16-chipyard-031`): **WO** — the write is accepted,
+// a read is CFXREG, and bits 0-2 raise POWEROFF / HARD_RESET / SOFT_RESET as
+// a one-cycle `io.power` event (bit0 wins; a write of 0 is a no-op).  The
+// consumer decides what the action means; the test machine ends the
+// simulation (a reset is "end + harness restart", the gem5 convention).
+// Kaiwu-Tiny keeps the row unimplemented (`spec/Kaiwu` §3), so there it stays
+// CFXREG for both directions.
+//
+// Every other (cg, rc) of an implemented cfx is not on this profile and
+// reads/writes as CFXREG — never as a silent zero.  A `cfxha` that names no
+// implemented cfx is CFXREG as well.
+//
+// The two-axis `cfx` authority (`<mode>_cfxreg`/`<mode>_cfxtrap` source mask
+// plus the `cg3 rc12` `cg_reg_deleg` bitmap, `DADAO-12` §3, `ADR-0045` D1/D2)
+// is **enforced in every run mode** (`m17-chipyard-001`, `DIV-07` closed).
+// In hypv the mask row is the cfx's legacy `cg3 rc0`-`rc3` set (Kaiwu-Tiny has
+// no other row and its body runs as `cfx_power`; the Vast delivery chain hands
+// the body to `cfx_hmon`); a test body opens the target cfx's masks before it
+// touches an undeclared cfx, which is the test-side preparation recorded as
+// `DIV-07`'s `close_when`.  U/J/S rows keep the per-mode rows of the monitor
+// common face and stay fail-closed for a cfx without one (`DIV-09`).
+//
+// `excp_cause_id` is a **flat bitmap** (`DADAO-12` §3.6, `contract-see`
+// §6.1/§6.1.1, `ADR-0062` D1–D3): one exception sets exactly one bit of the
+// 64-bit word.  `[15:0]` is the one-hot synchronous cause (`CFXMEM` = bit 1,
+// `CFXPERM` = bit 7); `[39:32]` is the PTW permission bitmap, `[55:48]`/`[56]`
+// the PTW miss/memory bitmap; `[31:16]`, `[39]`, `[47:40]`, `[57]` and
+// `[63:58]` are reserved.  `GewuCauseId` below is the single copy of that bit
+// table (both the encoders the cores use and the structure check at this
+// frame-write point read it); the layout is not a core constant, it is the
+// spec's, so it is fixed here rather than in `GewuParams`.
+
+package gewu
+
+import chisel3._
+import chisel3.util._
+
+/**
+  * The flat `excp_cause_id` bitmap (`contract-see` §6.1.1, bit-for-bit with
+  * `DADAO-12` §3.6; `ADR-0062` D1–D3).
+  *
+  * One exception sets **exactly one** bit of the 64-bit word:
+  *
+  *   `[15:0]`   one-hot synchronous cause (`CFXMEM` = bit 1, `CFXPERM` = bit 7)
+  *   `[31:16]`  reserved (asynchronous sources do not occupy this word)
+  *   `[39:32]`  permission bitmap: HSJU / R / W / X denial
+  *   `[47:40]`  reserved
+  *   `[55:48]`  miss/memory bitmap; `[56]` A/D write-back failure
+  *   `[57]`/`[63:58]` reserved
+  *
+  * The constants below are **absolute bit positions** of `excp_cause_id` — this
+  * table is the one copy the cores and the frame-write check read.  `[39]
+  * NCFXPERM` and `[57] NONPTW` are deleted: a cfx source-mask denial is plain
+  * `CFXPERM` and a non-page-table access fault is plain `CFXMEM` (`ADR-0062`
+  * D3).  A PTW fault sets one bitmap bit and leaves `[15:0]` zero (D2).
+  */
+object GewuCauseId {
+  // `[15:0]`: synchronous causes (`contract-see` §6.1, `DADAO-12` §3.6 (一)).
+  /** `CFXMEM` — non-PTW core-internal access fault. */
+  val MEM_BIT = 1
+  /** `CFXPERM` — cfx source-mask denial. */
+  val PERM_BIT = 7
+
+  // `[39:32]`: permission bitmap (`contract-see` §6.1.1).
+  val PERM_NUPERM = 32 // HSJU: user mode not allowed
+  val PERM_NJPERM = 33 // HSJU: jail mode not allowed
+  val PERM_NSPERM = 34 // HSJU: supv mode not allowed
+  val PERM_NHPERM = 35 // HSJU: hypv mode not allowed
+  val PERM_NRPERM = 36 // read, page R = 0
+  val PERM_NWPERM = 37 // write, page W = 0
+  val PERM_NXPERM = 38 // fetch, page X = 0
+
+  // `[55:48]`/`[56]`: miss / memory bitmap (`contract-see` §6.1.1).
+  val MEM_IGPTRAP = 48 // fetch: L1 P=0,SP=0 or L2 P=0
+  val MEM_ISPTRAP = 49 // fetch: L1 P=0,SP=1 (superpage missing)
+  val MEM_IGPFTRAP = 50 // fetch: L2 P=1 and the GPF small-page bit = 0
+  val MEM_ISPFTRAP = 51 // fetch: L1 P=1,SP=1 and the SPF small-page bit = 0
+  val MEM_DGPTRAP = 52 // data: L1 P=0,SP=0 or L2 P=0
+  val MEM_DSPTRAP = 53 // data: L1 P=0,SP=1 (superpage missing)
+  val MEM_DGPFTRAP = 54 // data: L2 P=1 and the GPF small-page bit = 0
+  val MEM_DSPFTRAP = 55 // data: L1 P=1,SP=1 and the SPF small-page bit = 0
+  val MEM_ADWBFAIL = 56 // PTE A/D write-back failed
+
+  /**
+    * Reserved bits, always zero (`DADAO-12` §3.6 (五)): `[31:16]`, `[39]`,
+    * `[47:40]`, `[57]` and `[63:58]`.
+    */
+  val RESERVED: BigInt =
+    (BigInt("ffff", 16) << 16) | (BigInt(1) << 39) |
+      (BigInt("ff", 16) << 40) | (BigInt(1) << 57) |
+      (BigInt("3f", 16) << 58)
+
+  /** One-hot word of an absolute bitmap bit (`0` for a negative position). */
+  def bit(bit: Int): UInt =
+    (if (bit < 0) BigInt(0) else BigInt(1) << bit).U(64.W)
+
+  /**
+    * The synchronous cause implied by a PTW fault bitmap (`ADR-0062` D2/D3):
+    * **any** page-table fault bit — permission (`[38:32]`) or miss/memory
+    * (`[55:48]`/`[56]`) — stands alone with `[15:0] = 0` (neither `CFXPERM`
+    * nor `CFXMEM` is set); no bitmap bit at all is the non-PTW core access
+    * fault, i.e. plain `CFXMEM`.
+    */
+  def causeOfBitmap(bitmap: UInt): UInt =
+    Mux(bitmap =/= 0.U, 0.U(64.W), bit(MEM_BIT))
+
+  /** Finished id of a PTW fault: the implied cause plus the bitmap bit. */
+  def encodePtw(bitmap: UInt): UInt = causeOfBitmap(bitmap) | bitmap
+
+  /**
+    * The flat structural rules of a finished `excp_cause_id` (`DADAO-12`
+    * §3.6 (五); `ADR-0062` D1), as one predicate: exactly one bit of the
+    * 64-bit word is set and every reserved bit is zero.  The single-bit rule
+    * subsumes the former class/wyde pairing — a low cause cannot carry a
+    * bitmap bit, and two bitmap bits cannot coexist.
+    */
+  def wellFormed(causeId: UInt): Bool =
+    PopCount(causeId) === 1.U && (causeId & RESERVED.U(64.W)) === 0.U
+}
+
+/**
+  * One implemented cfx (`cfxha` value + its per-cfx constants).
+  *
+  * `id` is the `cfxha` field value (`DADAO-12` §3.8).  `vectorBase` is both the
+  * reset value of `cg3 rc10` (the cfx's own SRAM/ROM base, `DADAO-13` §1) and
+  * the anchor of the cg7 block-0 start address (`DADAO-12` §2.1/§3.8:
+  * `start = base - (cfxha << 42)`).  `spaceDesc`/`spaceSize`/`spaceAttr` are the
+  * cg7 block-0 descriptor/size/attribute words; `sourceMaskReset` is the reset
+  * value of the four synchronous source masks (`cg3 rc0-rc3`).
+  */
+case class GewuCfxParams(
+  id: Int,
+  vectorBase: BigInt,
+  spaceDesc: BigInt,
+  spaceSize: BigInt,
+  spaceAttr: BigInt,
+  sourceMaskReset: BigInt,
+  /**
+    * Expose the full common register face of `DADAO-12 §3` (mode rows cg0-cg2,
+    * cg3 rc12, cg4, cg5 rc5, cg6, cg8 rc1).  Off by default so a profile that
+    * only ever had the partial subset (`Kaiwu-Tiny` cfx3/cfx63, cfx4/cfx5)
+    * keeps its observable register map unchanged; `m16-chipyard-019` enables it
+    * for the Vast monitors cfx0/cfx2.
+    */
+  commonRows: Boolean = false,
+  /** `cfx_⟨cfxname⟩_scratch_regs_num` (cg4 rc6) when `commonRows` is set. */
+  scratchRegs: Int = 4,
+  /** `cfx_⟨cfxname⟩_version` (cg4 rc1) — test-machine value, spec leaves it HW. */
+  version: BigInt = BigInt("10000", 16),
+  /**
+    * Implement `cg8 rc1 cfx_power_ctrl` (`DADAO-12 §4.12`): WO — the write is
+    * accepted and reads as CFXREG, bits 0-2 raise the POWEROFF/HARD_RESET/
+    * SOFT_RESET action event.  Only the reset cfx (`runCfxReset`) may set it,
+    * and only on the translating machine: `spec/Kaiwu §3` keeps Kaiwu-Tiny's
+    * `power_ctrl` unimplemented (access ⇒ CFXREG), so this flag stays off
+    * there (`m16-chipyard-031`).
+    */
+  powerCtrl: Boolean = false
+)
+
+/**
+  * The `cfx_ptw` register face (`DADAO-12` §4.5, `contract-tlb` §1 TLB-01…TLB-04).
+  *
+  * Only the *registers* are here; the walk, the TLB arrays and the A/D
+  * write-back are core state (`m16-chipyard-007`/`008`).  Keeping the registers
+  * in `gewu` means no core writes architectural cfx state by hand (ADR-0053 D3).
+  *
+  * `cfxId` is the `cfxha` the machine assigns to `cfx_ptw` (`spec` uses 4).  The
+  * row numbers — `ptw_enable` at `cg8 rc8`, the single PTBR at `cg9 rc0`, the
+  * invalidation interface at `cg12 rc0-rc3` — are the *spec's*, so like
+  * `GewuCauseId` they are fixed here rather than injected; only the `cfxha` is a
+  * machine choice.
+  */
+case class GewuPtwParams(cfxId: Int)
+
+/**
+  * The `cfx_cache` register face (`DADAO-12` §4.6, `contract-cache` §1
+  * CACHE-03…CACHE-18).
+  *
+  * Only the *registers* are here; the I/D arrays and the maintenance effects
+  * stay in the core (`WumingCache`, wired by the next task).  The row numbers
+  * (`cg8 rc0/8/9/10/11`) are the spec's, so like `GewuCauseId` they are fixed
+  * here rather than injected; only the `cfxha` and the machine's `cache_exist`
+  * value are machine choices.
+  *
+  * `exists` is the value `cfx_cache_exist` reads back: bit0 = I-cache,
+  * bit1 = D-cache (`contract-cache` CACHE-06), other bits are reserved and read
+  * 0.  `Kaiwu-Vast` has both sides, so it passes `0b11` (CACHE-27); Tiny does
+  * not instantiate this parameter at all (CACHE-28).
+  */
+case class GewuCacheParams(cfxId: Int, exists: Int = 0x3) {
+  require(exists >= 0 && exists < 4,
+    "Gewu: `cache_exist` defines only bit0 (I) and bit1 (D)")
+}
+
+/**
+  * The `cfx_hart` face (`DADAO-12` §4.7, `ADR-0061` D7).
+  *
+  * Only the *register* face lives here: `cg8` carries the hart-management
+  * registers (`hart_id`/`cycle`/`insn`), `cg15` the asynchronous capture group
+  * (`async_*`) and `cg16` the TIMER source face (`ctrl`/`cmp`/mask/pending/
+  * ack).  `hartId` is the value `cg8 rc0`
+  * reads back (single-hart test machine: 0); the time base and the retire
+  * pulse come from the core through `GewuFileIO.hart` because they are not cfx
+  * registers.
+  *
+  * The row numbers are the spec's (`§4.7`), so like `GewuCauseId` they are
+  * fixed here rather than injected; only the `cfxha` is a machine choice.
+  */
+case class GewuHartParams(cfxId: Int, hartId: Int = 0) {
+  require(hartId >= 0 && hartId < 64, "Gewu: `hart_id` must fit a 6-bit cfx field")
+}
+
+/**
+  * The `cfx_time` face (`DADAO-12` §4.10).
+  *
+  * Only two read-only registers: `cg10 rc0` = `time_freq` (the machine's
+  * counting frequency in Hz) and `cg10 rc1` = `time_value` (free-running
+  * 64-bit count).  The counter itself is **not** state of this module: like
+  * `cycle`, it is an architectural time input driven by the core, because the
+  * same time base also serves `cfx_hart cg8 rc2` (`contract-see` §3: 1 count =
+  * 1 ns on the test machine, `cfx_time_value` and the single hart's `cycle`
+  * read the same value).
+  *
+  * There is **no** `timer_cmp`/`timer_ctrl` and **no** interrupt here: the
+  * per-hart compare/interrupt is `cfx_hart`'s (`§4.7`).  `freq` is a machine
+  * constant, so it is injected rather than hard-coded (`ADR-0053` D5); the row
+  * numbers are the spec's, like `GewuCauseId`'s.
+  */
+case class GewuTimeParams(cfxId: Int, freq: BigInt) {
+  require(freq > 0, "Gewu: `time_freq` is a positive counting frequency (Hz)")
+}
+
+/**
+  * The `cfx_pmem` register face and DMA command port (`DADAO-12` §4.9,
+  * `m16-chipyard-022`).
+  *
+  * The registers and the setup validation live here; the byte mover is the
+  * core's bus-side engine (`WumingPmemDma`), fed by `GewuFileIO.pmem`.  Splitting
+  * them keeps every architecture-visible value (STATUS/ERR_CODE/sticky bits)
+  * next to the row decoders, while the TileLink master stays a core concern.
+  *
+  *   * `sramBase` / `sramSize` — the core-address window of the 64 KiB SRAM
+  *     (`spec/Kaiwu §1.1`); `sramOffset` is the cfx-internal offset
+  *     (`0x3ff_0000_0000`, `DADAO-12 §2.1`);
+  *   * `paBase`/`paSize`, `romBase`/`romSize` — the physical windows a transfer
+  *     may target: RAM for both directions, the BootROM only for reads
+  *     (`spec/Kaiwu §3` test-machine DMA rule).
+  *
+  * Every value is injected from the machine address map (`ADR-0053` D5).
+  */
+case class GewuPmemParams(
+  cfxId: Int,
+  sramBase: BigInt,
+  sramSize: BigInt,
+  sramOffset: BigInt,
+  paBase: BigInt,
+  paSize: BigInt,
+  romBase: BigInt,
+  romSize: BigInt
+) {
+  require(sramSize > 0 && (sramSize & (sramSize - 1)) == 0,
+    "Gewu: the cfx_pmem SRAM size must be a power of two")
+  require(sramOffset >= 0 && (sramOffset & ((BigInt(1) << 42) - 1)) == sramOffset,
+    "Gewu: the cfx_pmem SRAM offset must fit the 42-bit cfx space")
+  require(sramBase == (BigInt(cfxId) << 42) + sramOffset,
+    "Gewu: the cfx_pmem SRAM base must be (cfxha << 42) | sramOffset")
+}
+
+/**
+  * `Gewu` parameters (ADR-0053 D5).
+  *
+  * The calling core injects the implemented cfx set and every machine-specific
+  * number, so this generator never hard-codes "two cfx", a mask literal or an
+  * address-map value.
+  *
+  *   - `cfx`             — one entry per implemented cfx (order fixes the frame
+  *                         index, so a caller can name them positionally);
+  *   - `monitor`         — index into `cfx` of the instance that owns the
+  *                         exception frame and receives exception entries; a
+  *                         legal `escape` checks the target against the
+  *                         *current* cfx and reads the frame of the cfx that
+  *                         owns one (`DADAO-12` §5.3);
+  *   - `dataBits`        — width of one cfx register / of the cause fields /
+  *                         of the IP (all 64-bit on this spec);
+  *   - `modeBits`        — width of `excp_prev_run_mode` / `inner_run_mode`;
+  *   - `sourceMaskBits`  — width of the source/interrupt masks;
+  *   - `runModeReset`    — `inner_run_mode` reset value;
+  *   - `runCfxReset`     — `inner_cfx_code` reset value (the cfx whose space the
+  *                         reset vector lives in, `spec/Kaiwu §1`);
+  *   - `hypvMode`        — the mode exception entry forces (`DADAO-12` §5.2);
+  *   - `switchModeValue` — value `cg3 rc8` reads (a core may accept the write
+  *                         and keep one mode, or supply a real mode register);
+  *   - `ptw`             — `Some` when this machine implements `cfx_ptw`
+  *                         (`Kaiwu-Vast`); `None` leaves those rows undefined,
+  *                         i.e. CFXREG (`Kaiwu-Tiny`, `contract-see §3`);
+  *   - `cache`           — `Some` when this machine implements `cfx_cache`
+  *                         (`Kaiwu-Vast`); `None` leaves those rows undefined,
+  *                         i.e. CFXREG (`Kaiwu-Tiny`, `contract-cache` CACHE-28).
+  */
+case class GewuParams(
+  cfx: Seq[GewuCfxParams],
+  monitor: Int,
+  dataBits: Int,
+  modeBits: Int,
+  sourceMaskBits: Int,
+  runModeReset: Int,
+  runCfxReset: Int,
+  hypvMode: Int,
+  switchModeValue: Int,
+  ptw: Option[GewuPtwParams] = None,
+  cache: Option[GewuCacheParams] = None,
+  /**
+    * `m16-chipyard-024`: the asynchronous model switches when this is set.
+    *
+    * `Some` means the machine implements `cfx_hart`, so it has the async
+    * delivery of `DADAO-12 §5.4` (`ADR-0064`): `cg15`/`cg16` exist, `cg0`–`cg3`
+    * `rc4` is reserved (no `<mode>_cfx_intr_mask`) and `cfx0`–`cfx3 cg15 rc3`
+    * is the running mode's `async_intr_mask`.  `None` (Kaiwu-Tiny) keeps the
+    * pre-`ADR-0061` register face bit for bit, since it has no async source and
+    * no `cfx_hart` to deliver to.
+    */
+  hart: Option[GewuHartParams] = None,
+  /**
+    * `m16-chipyard-023`: `cfx_time` (`cg10` freq/value) exists when this is set.
+    *
+    * `Some` means the machine implements the per-system global time counter
+    * (`DADAO-12` §4.10) and exposes `cg10 rc0/rc1` as read-only rows; `None`
+    * (Kaiwu-Tiny) leaves those rows undefined, i.e. CFXREG, and adds no ports.
+    */
+  time: Option[GewuTimeParams] = None,
+  /**
+    * `m16-chipyard-022`: `Some` when this machine implements `cfx_pmem`
+    * (`Kaiwu-Vast`); `None` leaves its rows undefined (CFXREG, `Kaiwu-Tiny`)
+    * and adds neither ports nor flops.
+    */
+  pmem: Option[GewuPmemParams] = None,
+  /**
+    * `m16-chipyard-020`: enable the DADAO-12 §5.2 run-mode entry routing.
+    *
+    * Off (`Kaiwu-Tiny`, whose profile has no U/S/J mode at all — `§Kaiwu` §2
+    * keeps the run mode at hypv and routes every general trap to ILLI) keeps
+    * the pre-020 routing behaviour bit for bit: the entry target is always the
+    * frame monitor and the run mode never leaves `hypvMode`.  On (`Kaiwu-Vast`)
+    * the target of a synchronous exception or asynchronous interrupt is the
+    * monitor of the *exception-time* run mode (`U→cfx0`, `J→cfx1`, `S→cfx2`,
+    * `H→cfx3`, §5.2 step 1), the new run mode is the target cfx's
+    * `<mode>_switch_run_mode` (step 6) and `trap` may name any implemented cfx
+    * (step 1).
+    *
+    * The two-axis `cfxreg`/`cfxtrap` authority checks (`<mode>_cfxreg`/
+    * `<mode>_cfxtrap` source mask plus the `cg3 rc12` `cg_reg_deleg` bitmap,
+    * `ADR-0045`, `contract-see` §3) do **not** depend on this flag: they run in
+    * every run mode, Kaiwu-Tiny included (`m17-chipyard-001`, `DIV-07`).
+    */
+  modeEntry: Boolean = false
+) {
+  require(cfx.nonEmpty, "Gewu: at least one cfx must be implemented")
+  require(cfx.map(_.id).distinct.length == cfx.length,
+    "Gewu: the implemented cfx ids must be unique")
+  require(monitor >= 0 && monitor < cfx.length,
+    "Gewu: `monitor` must index an implemented cfx")
+  require(dataBits >= 4, "Gewu: `excp_vector` drops the low two bits")
+  require(modeBits >= 1 && modeBits <= dataBits,
+    "Gewu: the run mode must fit a cfx register")
+  require(sourceMaskBits == dataBits,
+    "Gewu: the source masks are cfx data registers and share their width")
+  require(runModeReset >= 0 && BigInt(runModeReset) < (BigInt(1) << modeBits),
+    "Gewu: `runModeReset` must fit the run mode field")
+  require(runCfxReset >= 0 && runCfxReset < 64,
+    "Gewu: `runCfxReset` is a 6-bit cfxha")
+  require(hypvMode >= 0 && BigInt(hypvMode) < (BigInt(1) << modeBits),
+    "Gewu: `hypvMode` must fit the run mode field")
+  require(switchModeValue >= 0 && BigInt(switchModeValue) < (BigInt(1) << dataBits),
+    "Gewu: `switchModeValue` must fit a cfx register")
+  // `cfx_ptw` is a normal cfx: its rows must belong to an implemented cfxha, or
+  // every access would be a CFXREG and the register face would be dead code.
+  require(ptw.forall(p => cfx.exists(_.id == p.cfxId)),
+    "Gewu: `ptw.cfxId` must name an implemented cfx")
+  // Same rule for `cfx_cache`: its rows must belong to an implemented cfxha.
+  require(cache.forall(c => cfx.exists(_.id == c.cfxId)),
+    "Gewu: `cache.cfxId` must name an implemented cfx")
+  // Same rule for `cfx_hart`: its cg8/cg15/cg16 rows must belong to an
+  // implemented cfx.
+  require(hart.forall(h => cfx.exists(_.id == h.cfxId)),
+    "Gewu: `hart.cfxId` must name an implemented cfx")
+  // Same rule for `cfx_time`: its cg10 rows must belong to an implemented cfx.
+  require(time.forall(t => cfx.exists(_.id == t.cfxId)),
+    "Gewu: `time.cfxId` must name an implemented cfx")
+  require(time.forall(t => t.freq < (BigInt(1) << dataBits)),
+    "Gewu: `time_freq` must fit one cfx register")
+  // `cfx_power_ctrl` (`DADAO-12 §4.12`) is the reset cfx's WO row.  Two
+  // claimants would make the single event ambiguous, and a non-reset cfx has
+  // no such register in the spec: both are elaboration errors.
+  require(cfx.count(_.powerCtrl) <= 1,
+    "Gewu: at most one cfx may implement `cfx_power_ctrl`")
+  require(cfx.filter(_.powerCtrl).forall(_.id == runCfxReset),
+    "Gewu: `powerCtrl` belongs to the reset cfx (`cfx_power`) only")
+  // Same rule for `cfx_pmem`: its cg8/cg12-cg15 rows must belong to an
+  // implemented cfx.
+  require(pmem.forall(m => cfx.exists(_.id == m.cfxId)),
+    "Gewu: `pmem.cfxId` must name an implemented cfx")
+  // The common mode rows (cg0-cg3 + cg4/cg5/cg6) are defined for every cfx
+  // (`DADAO-12 §3.1`-§3.4); `cg15 rc3` (the running mode's async source mask,
+  // `ADR-0064` D6) is only defined for cfx0-cfx3 and is decoded outside this
+  // matrix.  `cfx_hart` opts in for its mode rows (the two-axis access model of
+  // `contract-see §6.3`) while its own cg8 rows are decoded by the hart face.
+  // `cfx_cache` opts in so U/S can reach its cg8 maintenance rows through the
+  // common `cfxreg`/deleg rows (`DIV-16`), and the reset cfx (the boot owner,
+  // `cfx_power` on this machine) carries the §3.5/§3.7 face (`ISS-524`).
+  require(cfx.filter(_.commonRows).forall(c =>
+    (c.id >= 0 && c.id <= 3) || c.id == runCfxReset ||
+      cache.exists(_.cfxId == c.id) || hart.exists(_.cfxId == c.id) ||
+      pmem.exists(_.cfxId == c.id) || time.exists(_.cfxId == c.id)),
+    "Gewu: `commonRows` is defined for the cfx0-cfx3 monitors, the reset " +
+      "cfx, cfx_cache, cfx_hart, cfx_pmem and cfx_time only")
+  require(cfx.filter(_.commonRows).forall(c => c.scratchRegs >= 2 && c.scratchRegs <= 64),
+    "Gewu: `scratchRegs` must be 2..64 (`DADAO-12 §3.7`)")
+}
+
+/**
+  * The cfx IO contract (ADR-0053 D3).
+  *
+  * Inputs are architectural events only; outputs are the combinational read
+  * data / permission of the addressed register, the frame and mode state a core
+  * needs for its own traces, and the redirect request of D4.
+  */
+class GewuFileIO(val gp: GewuParams) extends Bundle {
+  // ---- cfx register access: one cfx2 read or write per cycle --------------
+  val addr = new Bundle {
+    val ha = Input(UInt(6.W)) // cfxha (`DADAO-12` §5.1)
+    val cg = Input(UInt(6.W)) // cg
+    val rc = Input(UInt(6.W)) // rc
+  }
+  /** "This cycle commits a cfx register write" (architectural event). */
+  val wEn = Input(Bool())
+  val wdata = Input(UInt(gp.dataBits.W))
+  val rdata = Output(UInt(gp.dataBits.W))
+  /** Register is implemented and the access is legal for its group. */
+  val readOk = Output(Bool())
+  /** The write of `wdata` is legal; a rejected write is a CFXREG. */
+  val writeOk = Output(Bool())
+
+  // ---- architectural events ---------------------------------------------
+  /** Exception entry: latch the cause frame and switch to the entry target. */
+  val excp = new Bundle {
+    val valid = Input(Bool())
+    /**
+      * Entry target (`DADAO-12` §5.2 step 1/step 6):
+      *   0 = the monitor of the exception-time run mode (`U→cfx0`,
+      *       `J→cfx1`, `S→cfx2`, `H→cfx3`; falls back to the frame monitor
+      *       when that cfx is not implemented);
+      *   1 = the *current* cfx (`CFXESC` is delivered to the current cfx,
+      *       §5.3 step 0);
+      *   2 = the explicit `targetHa` (`CFXTRAP`: "合法且被允许 → 目标 cfx").
+      */
+    val targetSel = Input(UInt(2.W))
+    val targetHa = Input(UInt(6.W))
+    val cause = Input(UInt(gp.dataBits.W)) // one-hot excp_cause_id
+    val causeIp = Input(UInt(gp.dataBits.W)) // excp_cause_ip
+    val info = Input(UInt(gp.dataBits.W)) // excp_cause_info
+  }
+  /** `escape cfxHA` (`DADAO-12` §5.1/§5.3, `ADR-0061` R3). */
+  val escape = new Bundle {
+    val valid = Input(Bool())
+    val ha = Input(UInt(6.W))
+  }
+  /** The `escape` is legal: `ha` is the current cfx, the target cfx and its
+    * monitor are implemented, and the target mode does not escalate. */
+  val escapeOk = Output(Bool())
+  /** `escape` return address = the current cfx's `cg5 rc10` (`escape ip`,
+    * §5.3 step 2); exposed separately so the core's redirect never routes
+    * through the entry-vector mux (which would close a combinational loop
+    * through `entrySel`). */
+  val escapeTarget = Output(UInt(gp.dataBits.W))
+
+  // ---- redirect request (D4: PC and flush stay in the core) --------------
+  val redirect = new Bundle {
+    val valid = Output(Bool())
+    val target = Output(UInt(gp.dataBits.W))
+    /** Cause information of the redirect: `excp` carries the new frame, an
+      * `escape` return carries the frame being returned from. */
+    val cause = Output(UInt(gp.dataBits.W))
+    val causeIp = Output(UInt(gp.dataBits.W))
+    val info = Output(UInt(gp.dataBits.W))
+    val isEscape = Output(Bool())
+  }
+
+  // ---- state a core needs for its own control and traces ------------------
+  /** `cfxha` of the instance owning the frame (the `trap` handoff target). */
+  val monitorHa = Output(UInt(6.W))
+  /** `excp_vector` of the monitor (cg3 rc10). */
+  val vector = Output(UInt(gp.dataBits.W))
+  /** `excp_vector` of the cfx this exception entry targets: the monitor, or
+    * the current cfx when `excp.toCurrent` is set (`DADAO-12` §5.2 step 7). */
+  val entryVector = Output(UInt(gp.dataBits.W))
+  /** `excp_cause_id != 0`: a frame exists (`escape` may return from it). */
+  val frameValid = Output(Bool())
+  val causeId = Output(UInt(gp.dataBits.W))
+  val causeIp = Output(UInt(gp.dataBits.W))
+  val causeInfo = Output(UInt(gp.dataBits.W))
+  val prevMode = Output(UInt(gp.modeBits.W))
+  /** `excp_prev_cfx_code` of the monitor (cg5 rc1). */
+  val prevCfx = Output(UInt(gp.dataBits.W))
+  /** `inner_run_mode`. */
+  val runMode = Output(UInt(gp.modeBits.W))
+  /** `inner_cfx_code` (`DADAO-12` §5.2 step 6 / §5.3 step 2). */
+  val curCfx = Output(UInt(6.W))
+
+  // ---- `m16-chipyard-020`: entry routing and two-axis authority -----------
+  /** `true` when `addr.ha` names an implemented cfx (`DADAO-12` §3.8). */
+  val implemented = Output(Bool())
+  /** Two-axis denial of the addressed row for `cfx2rd`/`cfx2rc`
+    * (`<mode>_cfxreg` source mask + `cg3 rc12` `cg_reg_deleg`); the caller
+    * reports plain `CFXPERM` **before** the row's own CFXREG rule. */
+  val permDenied = Output(Bool())
+  /** Two-axis denial of `trap` on the addressed cfx (`<mode>_cfxtrap`). */
+  val trapDenied = Output(Bool())
+
+  /**
+    * `cfx_power` power-control event (`DADAO-12 §4.12`, `m16-chipyard-031`).
+    *
+    * `cg8 rc1 cfx_power_ctrl` is WO: the write is accepted (`writeOk`) and the
+    * row has no read path (`readOk` is false ⇒ reading it is CFXREG).  A write
+    * whose bits 0-2 are non-zero raises a one-cycle event; `action` encodes
+    * 0 = POWEROFF (bit0), 1 = HARD_RESET (bit1), 2 = SOFT_RESET (bit2), with
+    * bit0 winning when several are set (the QEMU/gem5 priority).  A write of 0
+    * — or one with only bits ≥3 set — is accepted with no action (`valid`
+    * low).  The consumer decides what "power off" means; the test machine ends
+    * the simulation and lets the harness restart for a reset.
+    */
+  val power = new Bundle {
+    val valid = Output(Bool())
+    val action = Output(UInt(2.W))
+  }
+
+  /**
+    * Asynchronous entry (`DADAO-12 §5.4`, `ADR-0064` D1/D3/D4/D6).
+    *
+    * Each source latches its event in its own `cg16 rc17` pending register
+    * and clears it only through `cg16 rc18` (W1C); an asynchronous entry never
+    * clears it (`ADR-0064` D1/D3).  At an instruction boundary `gewu` offers
+    * one frame carrying **all** pending sources that pass both the source's
+    * own `cg16 rc16` mask and the running mode's monitor mask (`cfx0`–`cfx3
+    * cg15 rc3`).  TIMER additionally requires `ENABLE=1`.  `ack` performs the
+    * entry (frame, supv switch, vector) and counts the frame once.  A masked
+    * event only keeps its pending bit — lifting the mask later delivers it;
+    * nothing is ever queued per source.  Every entry overwrites the `cg15`
+    * capture group: `async_src_frame != 0` is a snapshot, never a gate.
+    */
+  val intr = new Bundle {
+    val valid = Output(Bool())
+    /** Bits entering this frame (union of the allowed sources, `D3`). */
+    val frame = Output(UInt(gp.dataBits.W))
+    val vector = Output(UInt(gp.dataBits.W))
+    /** `async_cause_ip` = the committed instruction's successor (`D10`). */
+    val causeIp = Input(UInt(gp.dataBits.W))
+    val ack = Input(Bool())
+  }
+
+  // ---- `cfx_ptw` state a core's address path consumes (`DADAO-12` §4.5) ----
+  //
+  // The three architectural states the walk needs (`TLB-03`: reset PTBR = 0,
+  // ASID = 0, `ptw_enable` = 0) plus the invalidation interface.  The whole
+  // group is **absent** on a machine that does not implement `cfx_ptw`
+  // (`gp.ptw = None`): such a profile must neither see the ports nor pay for
+  // them, and its `cfx_ptw` rows are CFXREG (`contract-see §3`).
+  val ptw: Option[PtwState] = gp.ptw.map(_ => new PtwState(gp.dataBits))
+
+  // ---- `cfx_cache` state the core's maintenance path consumes (`§4.6`) ----
+  //
+  // The registers only: the effect (I/D arrays) is the core's.  The whole
+  // group is **absent** when the machine does not implement `cfx_cache`
+  // (`gp.cache = None`, Kaiwu-Tiny): such a profile must neither see the ports
+  // nor pay for flops from a feature it reports as CFXREG (CACHE-28).
+  val cache: Option[CacheState] = gp.cache.map(_ => new CacheState(gp.dataBits))
+
+  // ---- `cfx_pmem` state the core's DMA engine consumes (`DADAO-12 §4.9`) ----
+  //
+  // The registers, the row decode and every architecture-visible status value
+  // live here; the byte mover is the core's bus engine.  The group is absent
+  // on a machine without `cfx_pmem` (Kaiwu-Tiny), so such a profile gains no
+  // ports and no flops from rows it reports as CFXREG.
+  val pmem: Option[PmemState] = gp.pmem.map(_ => new PmemState(gp.dataBits))
+
+  // ---- `cfx_hart` state (`DADAO-12` §4.7, `ADR-0060`) ---------------------
+  //
+  // `cycle`/`insn` are read through the cfx file, but their sources are the
+  // core's time base and retirement pulse (an architectural time input, not a
+  // pipeline signal: `cycle` = free-running time in `cfx_time_value` units).
+  // The group is absent on a machine without `cfx_hart` (Kaiwu-Tiny), so Tiny
+  // neither sees these ports nor pays for the flops.
+  val hart: Option[HartState] = gp.hart.map(_ => new HartState(gp.dataBits))
+
+  // ---- `cfx_time` state (`DADAO-12` §4.10) --------------------------------
+  //
+  // `time_value` is **not** cfx state: it is the per-system global count, an
+  // architectural time input driven by the core (the same base as `cycle`).
+  // The group is absent on a machine without `cfx_time` (Kaiwu-Tiny), so Tiny
+  // neither sees these ports nor pays for the flops.
+  val time: Option[TimeState] = gp.time.map(_ => new TimeState(gp.dataBits))
+}
+
+/** The time base and retirement pulse `cfx_hart` consumes (`§4.7`). */
+class HartState(dataBits: Int) extends Bundle {
+  /** Free-running time in `cfx_time_value` units (`cg8 rc2 cycle`). */
+  val timeValue = Input(UInt(dataBits.W))
+  /** One-cycle pulse per retired instruction (`cg8 rc3 insn`). */
+  val retire = Input(Bool())
+}
+
+/** The per-system global time base `cfx_time` reads (`§4.10`). */
+class TimeState(dataBits: Int) extends Bundle {
+  /** Free-running count in `cfx_time_value` units (`cg10 rc1`). */
+  val timeValue = Input(UInt(dataBits.W))
+}
+
+/**
+  * The `cfx_pmem` DMA command port (`DADAO-12` §4.9).
+  *
+  * `start` is a one-cycle launch: it is raised only after the setup checks
+  * (SIZE / CFX_RANGE / PA_RANGE / PA_FAULT) passed, so the engine never has to
+  * repeat them.  `src`/`dst` are the raw 64-bit register values (the engine
+  * masks the CFX side to 42 bits and the PA side to 56 bits); `dir` is the
+  * direction of *this* launch (0 = CFX→PA, 1 = PA→CFX).  The engine owns
+  * `busy`; `done`/`error` are one-cycle completion events.
+  */
+class PmemState(dataBits: Int) extends Bundle {
+  val start = Output(Bool())
+  val src = Output(UInt(dataBits.W))
+  val dst = Output(UInt(dataBits.W))
+  val size = Output(UInt(30.W))
+  val dir = Output(Bool())
+  val busy = Input(Bool())
+  val done = Input(Bool())
+  val error = Input(Bool())
+}
+
+/** The `cfx_cache` state a core's maintenance path consumes (`DADAO-12` §4.6). */
+class CacheState(dataBits: Int) extends Bundle {
+  /** `cg8 rc8 cfx_cache_enable`: bit0 = I, bit1 = D (`contract-cache` CACHE-07). */
+  val enable = Output(UInt(2.W))
+  /** `cg8 rc10 cfx_cache_addr_start`: full 56-bit PA `PA[55:0]` (CACHE-18). */
+  val addrStart = Output(UInt(56.W))
+  /** `cg8 rc11 cfx_cache_addr_size`: byte count (CACHE-03). */
+  val addrSize = Output(UInt(dataBits.W))
+  /** `cg8 rc9 cfx_cache_ctrl` write-commit pulse (WO, write-executes). */
+  val control = Output(Bool())
+  /** Data of that `cache_ctrl` write (`[1:0]` op, `[3:2]` scope, `[15:14]` side
+    * select; `contract-cache` §3 CACHE-09). */
+  val controlData = Output(UInt(dataBits.W))
+}
+
+/** The `cfx_ptw` state a core's address path consumes (`DADAO-12` §4.5). */
+class PtwState(dataBits: Int) extends Bundle {
+  /** `cg8 rc8 cfx_ptw_enable`: 1 = the memory window is translated. */
+  val enable = Output(Bool())
+  /** `cg9 rc0 cfx_ptw_ptbr`: only `PPN[55:16]` is stored. */
+  val ptbr = Output(UInt(40.W))
+  /** `cg12 rc1 cfx_ptw_tlb_asid` (`[15:0]`). */
+  val tlbAsid = Output(UInt(16.W))
+  /** `cg12 rc2 cfx_ptw_tlb_addr_start` (`VA[41:0]`). */
+  val tlbAddrStart = Output(UInt(42.W))
+  /** `cg12 rc3 cfx_ptw_tlb_addr_size` (byte count). */
+  val tlbAddrSize = Output(UInt(dataBits.W))
+  /** `cg12 rc0 cfx_ptw_tlb_control` write-commit pulse (WO, write-executes). */
+  val tlbControl = Output(Bool())
+  /** Data of that `tlb_control` write (`[1:0]` op, `[3:2]` scope, bit4
+    * `ASID_ANY`; `contract-tlb` §5 TLB-19). */
+  val tlbControlData = Output(UInt(dataBits.W))
+}
+
+/**
+  * The cfx register file (`DADAO-12` §3, `DADAO-13` §1).
+  *
+  * One instance holds every cfx of the machine.  Nothing here is pipeline
+  * aware: a read/write is a combinational decode of the register address, and
+  * the three architectural events (register write, exception entry, `escape`
+  * return) update state in the cycle they are asserted.
+  */
+class GewuFile(val gp: GewuParams) extends Module {
+  val io = IO(new GewuFileIO(gp))
+
+  private val monitor = gp.monitor
+  private val allOnes = Fill(gp.sourceMaskBits, 1.U(1.W))
+  /** `ADR-0061`: the machine implements `cfx_hart` and therefore the §5.4
+    * asynchronous model (source bitmap, monitor-owned mask, one frame).
+    * Kaiwu-Tiny has none of it and keeps the pre-`ADR-0061` register face. */
+  private val asyncModel = gp.hart.isDefined
+
+  // cfxha decode.  The ids are unique (see `GewuParams`), so at most one
+  // instance is addressed; an unimplemented cfxha is CFXREG.
+  private val hit = VecInit(gp.cfx.map(c => io.addr.ha === c.id.U(6.W)))
+  private val implemented = hit.asUInt.orR
+  private val sel = PriorityEncoder(hit)
+
+  // ---- architectural state ------------------------------------------------
+  // cg3 rc0-rc3: four independent sync source masks (`DADAO-12 §3.4`:
+  // cfxtrap / cfxmem / cfxreg / cfxexe).  They happen to share one reset value
+  // but are separate RW registers, and the two-axis `cfxreg` check reads rc2.
+  val sourceMask = RegInit(VecInit(gp.cfx.map(c =>
+    VecInit(Seq.fill(4)(c.sourceMaskReset.U(gp.sourceMaskBits.W))))))
+  // cg3 rc4: `DADAO-12 §3.4` no longer defines it (`ADR-0061` D5) — on the
+  // asynchronous machine the row is a reserved hole (CFXREG).  A machine
+  // without `cfx_hart` keeps the legacy `<mode>_cfx_intr_mask` so its register
+  // face does not move (Kaiwu-Tiny regression criterion).
+  val intrMaskOpt: Option[Vec[UInt]] =
+    if (asyncModel) None else Some(RegInit(VecInit(gp.cfx.map(_ => allOnes))))
+  // `cfx0`-`cfx3 cg15 rc3` = `cfx_<monitor>_async_intr_mask` (`ADR-0064` D6):
+  // bit = source cfxha, `0` = allow / `1` = mask, reset all ones.  It is the
+  // *source policy* of the running mode, so `trap`/`escape` never save it.
+  val asyncIntrMaskOpt: Option[Vec[UInt]] =
+    if (asyncModel) Some(RegInit(VecInit(gp.cfx.map(_ => allOnes)))) else None
+  // cg3 rc15: the cfx's own base (`DADAO-13` §1).
+  val vector = RegInit(VecInit(gp.cfx.map(c => c.vectorBase.U(gp.dataBits.W))))
+  // cg5 exception frame (`DADAO-12` §3.6, `ADR-0061` R3-D2):
+  //   rc0-rc3 entry record (HW-written, software read-only),
+  //   rc4/rc5 cause id / info (HW-written),
+  //   rc8-rc11 exit intent (HW-copied at entry, software-writable).
+  val prevMode = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.modeBits.W))))
+  val prevCfx = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val prevIp = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val prevIntrMask = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val causeId = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val causeInfo = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val escapeRunMode = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.modeBits.W))))
+  val escapeCfx = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  val escapeIp = RegInit(VecInit(gp.cfx.map(_ => 0.U(gp.dataBits.W))))
+  // `rc11` resets all ones: fail-safe, every asynchronous source masked.
+  val escapeIntrMask = RegInit(VecInit(gp.cfx.map(_ => allOnes)))
+  val runMode = RegInit(gp.runModeReset.U(gp.modeBits.W))
+  // `inner_cfx_code`: the cfx the core currently runs as.  It starts at the cfx
+  // that owns the reset vector (`spec/Kaiwu §1`), becomes the entry target on an
+  // exception (`DADAO-12` §5.2 step 6) and is restored from the frame on
+  // `escape` (§5.3 step 2).
+  val curCfx = RegInit(gp.runCfxReset.U(6.W))
+
+  // ---- `cfx_ptw` architectural state (`DADAO-12` §4.5) ---------------------
+  // Reset values are the spec's (`contract-tlb` TLB-03): PTBR = 0, ASID = 0,
+  // `ptw_enable` = 0.  Nothing here is a walker: the tables, A/D bits and the
+  // invalidation effects are the core's (`m16-chipyard-007`/`008`); these are
+  // the registers software reads and writes.
+  //
+  // The state exists **only** when the machine implements `cfx_ptw`: a profile
+  // without it (Kaiwu-Tiny) must not gain flops or muxing from a feature it
+  // reports as CFXREG — its RTL identity is a regression criterion.
+  private val ptwId = gp.ptw.map(_.cfxId)
+
+  /** `cfx_ptw`'s registers; created only when `gp.ptw` is set. */
+  private class PtwRegs {
+    val enable = RegInit(false.B)
+    val ptbr = RegInit(0.U(40.W))           // PPN[55:16] only
+    val asid = RegInit(0.U(16.W))           // `[63:16]` reads 0
+    val addrStart = RegInit(0.U(42.W))      // `VA[41:0]`
+    val addrSize = RegInit(0.U(gp.dataBits.W))
+    // `tlb_control` is write-only with no completion state: the *write* is the
+    // command.  The value is latched one cycle for the execute event; no read
+    // path exists (a read of a WO register is CFXREG, `DADAO-12` §4.5 "访问").
+    val control = RegInit(false.B)
+    val controlData = RegInit(0.U(gp.dataBits.W))
+  }
+
+  private val ptwRegs: Option[PtwRegs] = ptwId.map(_ => new PtwRegs)
+
+  // ---- `cfx_cache` architectural state (`DADAO-12` §4.6) -------------------
+  // Reset values are the spec's (`contract-cache` CACHE-07/CACHE-08): every
+  // existing side starts enabled, `addr_start`/`addr_size` start at 0.  Like
+  // `cfx_ptw`, the state exists only on a machine that implements the cfx, so
+  // Kaiwu-Tiny gains no flops and no muxing (CACHE-28).
+  private val cacheId = gp.cache.map(_.cfxId)
+
+  /** `cfx_cache`'s registers; created only when `gp.cache` is set. */
+  private class CacheRegs(exists: Int) {
+    val enable = RegInit(exists.U(2.W))
+    val addrStart = RegInit(0.U(56.W))       // `PA[55:0]`
+    val addrSize = RegInit(0.U(gp.dataBits.W))
+    // `cache_ctrl` is write-only with no completion state: the *write* is the
+    // command.  The value is latched one cycle for the execute event; no read
+    // path exists (a read of a WO register is CFXREG, `§4.6`).
+    val control = RegInit(false.B)
+    val controlData = RegInit(0.U(gp.dataBits.W))
+  }
+
+  private val cacheRegs: Option[CacheRegs] =
+    gp.cache.map(c => new CacheRegs(c.exists))
+  private val cacheExists: Int = gp.cache.map(_.exists).getOrElse(0)
+
+  // ---- `cfx_hart` state (`DADAO-12` §4.7, `ADR-0064` D2/D3/D5) ------------
+  // `cg8` = hart management (`hart_id`/`cycle`/`insn`); `cg15` = the
+  // asynchronous capture group (`rc0`-`rc5`) plus `rc14`/`rc15` configuration;
+  // `cg16` = the TIMER source face (`ctrl`/`cmp`/mask/pending/ack).  Reset
+  // values are the spec's: timer off, cmp 0, mask all ones, pending 0, empty
+  // record, switch mode supv, vector 0.  The `cg15 rc0`-`rc5` record is
+  // HW-written / software-read-only (writes ignored).
+  private val hartId = gp.hart.map(_.cfxId)
+
+  /** `cfx_hart`'s registers; created only when `gp.hart` is set. */
+  private class HartRegs {
+    // cg16: the TIMER source face (`ADR-0064` D2).
+    val timerCmp = RegInit(0.U(gp.dataBits.W))   // rc1
+    val timerEnable = RegInit(false.B)           // rc0 bit0 (only field)
+    val timerMask = RegInit(true.B)              // rc16 bit0, 1 = mask, reset 1
+    val timerPending = RegInit(false.B)          // rc17 bit0, ack-only clear
+    /** Entry-probe arming: source pending is sticky, so probing unconditionally
+      * would re-enter at every boundary before the handler can ack (`ADR-0064`
+      * D4).  Set by a new source event or by a write that can unblock one
+      * (masks/config/`escape`), cleared only by an entry (`gem5`/QEMU use the
+      * same one-shot kick). */
+    val asyncKick = RegInit(false.B)
+    val insn = RegInit(0.U(gp.dataBits.W))       // cg8 rc3 retired instructions
+    /** Last cycle's compare condition: the expiry is an *event* (one pending
+      * bit per arming), so only a 0→1 transition sets it (`D3`). */
+    val timerSeen = RegInit(false.B)
+
+    // cg15: asynchronous entry record / capture buffer (`§4.7`, `ADR-0064` D5).
+    val asyncPrevMode = RegInit(0.U(gp.modeBits.W))   // rc0 HW/RO
+    val asyncPrevCfx = RegInit(0.U(6.W))              // rc1 HW/RO
+    val asyncCauseIp = RegInit(0.U(gp.dataBits.W))    // rc2 HW/RO
+    val asyncPrevMask = RegInit(0.U(gp.dataBits.W))   // rc3 HW/RO
+    val asyncSrcFrame = RegInit(0.U(gp.dataBits.W))   // rc4 HW/RO
+    /** rc14 `async_switch_run_mode`: RW 2-bit, reset 2 = supv (`§4.7`); an
+      * asynchronous entry switches to this value and it is also the run-mode
+      * upper bound of the entry (`m18-spec-009`). */
+    val asyncSwitch = RegInit(2.U(gp.modeBits.W))
+    /** rc15 `async_excp_vector`: RW, 4-byte aligned (`§4.7`). */
+    val asyncVector = RegInit(0.U(gp.dataBits.W))
+  }
+
+  private val hartRegs: Option[HartRegs] = hartId.map(_ => new HartRegs)
+
+  // ---- `cfx_pmem` architectural state (`DADAO-12` §4.9) -------------------
+  // The 64 PM-region descriptors (cg12/13/14), the cg15 DMA registers and the
+  // sticky completion state.  Created only when the machine implements the
+  // cfx, so Kaiwu-Tiny gains no flops and no muxing.
+  private val pmemId = gp.pmem.map(_.cfxId)
+
+  /** `cfx_pmem`'s registers; created only when `gp.pmem` is set. */
+  private class PmemRegs {
+    // cg12/13/14: 64 PM-region descriptors, reset 0 (`DADAO-12` §4.9).
+    val start = RegInit(VecInit(Seq.fill(64)(0.U(gp.dataBits.W))))
+    val size = RegInit(VecInit(Seq.fill(64)(0.U(gp.dataBits.W))))
+    val attr = RegInit(VecInit(Seq.fill(64)(0.U(gp.dataBits.W))))
+    // cg15: DMA command registers.
+    val dmaSrc = RegInit(0.U(gp.dataBits.W))
+    val dmaDst = RegInit(0.U(gp.dataBits.W))
+    val dmaSize = RegInit(0.U(30.W))
+    val dmaDir = RegInit(false.B)        // bit1 DIR (0 = CFX→PA)
+    // cg15 rc4: sticky DONE / ERROR and the one-hot ERR_CODE (`[15:3]`).
+    val done = RegInit(false.B)
+    val error = RegInit(false.B)
+    val errCode = RegInit(0.U(13.W))     // bit0 SIZE, 1 CFX_RANGE, 2 PA_RANGE, 3 PA_FAULT
+    // cg16: the PMEM_DMA source face (`ADR-0064` D2/D3).
+    val dmaMask = RegInit(true.B)        // rc16 bit0, 1 = mask, reset 1
+    val dmaPending = RegInit(false.B)    // rc17 bit0, ack-only clear
+  }
+
+  private val pmemRegs: Option[PmemRegs] = pmemId.map(_ => new PmemRegs)
+
+  // The two asynchronous sources wired on this machine: the hart-local TIMER
+  // (cfxha = `cfx_hart` itself) and `PMEM_DMA` (cfxha 32, `DADAO-12 §4.9`).
+  // Their bits in the hart capture / monitor masks are the *source cfxha*.
+  private val timerSrcBit: UInt = hartId
+    .map(h => (1.U(gp.dataBits.W) << h.U)(gp.dataBits - 1, 0))
+    .getOrElse(0.U(gp.dataBits.W))
+  private val pmemSrcBit: UInt = pmemId
+    .map(h => (1.U(gp.dataBits.W) << h.U)(gp.dataBits - 1, 0))
+    .getOrElse(0.U(gp.dataBits.W))
+  /** `cg15 rc5`: raw pending summary (bit = source cfxha), independent of the
+    * masks; set while a source's `cg16 rc17` is non-zero, cleared only by that
+    * source's ack (`ADR-0064` D4). */
+  private val pendingSummary: UInt =
+    hartRegs.map(r => Mux(r.timerPending, timerSrcBit, 0.U(gp.dataBits.W)))
+      .getOrElse(0.U(gp.dataBits.W)) |
+    pmemRegs.map(p => Mux(p.dmaPending, pmemSrcBit, 0.U(gp.dataBits.W)))
+      .getOrElse(0.U(gp.dataBits.W))
+
+  // ---- monitor common register face (`m16-chipyard-019`) -------------------
+  // `DADAO-12 §3`: cg0-cg2 are the three lower run-mode rows, cg3 is hypv (the
+  // legacy rows above already cover its rc0-rc4/rc14/rc15), cg4 is the config
+  // block, cg6 the scratch registers and cg15 rc3 the monitor's async source
+  // mask.  The state is created only for a cfx whose `commonRows` flag is set,
+  // so a profile that does not opt in (Kaiwu-Tiny, cfx3/cfx63 here) gains no
+  // flops and no muxing.
+  private class CommonRegs(c: GewuCfxParams) {
+    /** cg0-cg2: rc0-rc3 sync source masks (`DADAO-12 §3.1`-§3.3; `rc4` is a
+      * reserved hole since `ADR-0061` D5). */
+    val mask = RegInit(VecInit(Seq.fill(3)(VecInit(
+      Seq.fill(4)(c.sourceMaskReset.U(gp.sourceMaskBits.W))))))
+    /** cg0-cg3 rc14: `switch_run_mode`; modes 0-2 reset to supv, cg3 to hypv
+      * (`§3.1`-`§3.4`).  `m16-chipyard-020` makes the cg3 row a real register so
+      * the hypv→U/S hand-off (`trap` with a software-chosen switch value, the
+      * three-mode environment) is expressible. */
+    val switchMode = RegInit(VecInit(Seq(
+      2.U(gp.dataBits.W), 2.U(gp.dataBits.W), 2.U(gp.dataBits.W),
+      3.U(gp.dataBits.W))))
+    /** cg0-cg2 rc15: `excp_vector` resets to 0 (`§3.1`-`§3.3`). */
+    val vector = RegInit(VecInit(Seq.fill(3)(0.U(gp.dataBits.W))))
+
+    /** cg3 rc12 `hypv_cg_reg_deleg`; bit3 is hardware-fixed 1 (`§3.4`). */
+    val deleg = RegInit(Fill(gp.dataBits, 1.U(1.W)))
+
+    /** cg4 counters (`§3.5`), reset 0; `trap_num` counts `trap` entries. */
+    val trapNum = RegInit(0.U(gp.dataBits.W))
+    val syncNum = RegInit(0.U(gp.dataBits.W))
+    val asyncNum = RegInit(0.U(gp.dataBits.W))
+    val escapeNum = RegInit(0.U(gp.dataBits.W))
+
+    /** cg6: `N` scratch registers, `rc >= N` is CFXREG (`§3.7`). */
+    val scratch = RegInit(VecInit(Seq.fill(c.scratchRegs)(0.U(gp.dataBits.W))))
+  }
+
+  /** One entry per cfx that opts into the monitor common face. */
+  private class CommonEntry(val c: GewuCfxParams) {
+    val regs = new CommonRegs(c)
+    val hit: Bool = io.addr.ha === c.id.U(6.W)
+    /** `cg0-cg2` address decode (the mode row is `io.addr.cg`). */
+    val isMode = hit && io.addr.cg <= 2.U
+    val isMask = isMode && io.addr.rc <= 3.U
+    val isSwitch = isMode && io.addr.rc === 14.U
+    /** `cg3 rc14`: the hypv-mode `switch_run_mode` of a common cfx. */
+    val isHypvSwitch = hit && io.addr.cg === 3.U && io.addr.rc === 14.U
+    val isVector = isMode && io.addr.rc === 15.U
+    val isDeleg = hit && io.addr.cg === 3.U && io.addr.rc === 12.U
+    val isCfg = hit && io.addr.cg === 4.U
+    val isScratch = hit && io.addr.cg === 6.U &&
+      io.addr.rc < c.scratchRegs.U
+    /** Mode-row index (0/1/2); `cg3` uses the legacy rows, not this matrix. */
+    val mode = Mux(io.addr.cg <= 2.U, io.addr.cg(1, 0), 0.U)
+  }
+
+  private val commonEntries: Seq[CommonEntry] =
+    gp.cfx.filter(_.commonRows).map(c => new CommonEntry(c))
+  private val commonHits: Seq[Bool] = commonEntries.map(_.hit)
+  /** `cfx.id` -> its common-face entry (only cfx that opt in). */
+  private val commonById: Map[Int, CommonEntry] =
+    commonEntries.map(e => e.c.id -> e).toMap
+  /** `cfx.id` -> index in `gp.cfx` (for per-cfx register vectors). */
+  private val cfxIndexById: Map[Int, Int] =
+    gp.cfx.zipWithIndex.map { case (c, i) => c.id -> i }.toMap
+
+  // ---- register access ----------------------------------------------------
+  private val isCg3 = io.addr.cg === 3.U
+  // `DADAO-13` §1: the whole cg3 row is hypv-only.
+  private val cg3Allowed = !isCg3 || runMode === gp.hypvMode.U
+  // `cg3 rc0`-`rc3` are the four sync source masks.  `rc4` was the legacy
+  // `<mode>_cfx_intr_mask`; `ADR-0061` D5 removes it (`DADAO-12 §3.1`-§3.4:
+  // reserved => CFXREG) on the asynchronous machine.  Kaiwu-Tiny keeps the
+  // legacy row so its register face is unchanged.
+  private val maskRcMax = if (asyncModel) 3.U else 4.U
+  private val isMask = isCg3 && io.addr.rc <= maskRcMax
+  // `cg0`-`cg3` `rc14`/`rc15` are `<mode>_switch_run_mode` /
+  // `<mode>_excp_vector` (`DADAO-12` §3.1-§3.4, `ADR-0061` R3-D4); the old
+  // `rc8`/`rc10` are reserved holes (CFXREG) and are decoded nowhere.
+  private val isSwitchMode = isCg3 && io.addr.rc === 14.U
+  private val isVector = isCg3 && io.addr.rc === 15.U
+  private val isPrevMode = io.addr.cg === 5.U && io.addr.rc === 0.U
+  private val isPrevCfx = io.addr.cg === 5.U && io.addr.rc === 1.U
+  private val isPrevIp = io.addr.cg === 5.U && io.addr.rc === 2.U
+  private val isPrevIntrMask = io.addr.cg === 5.U && io.addr.rc === 3.U
+  private val isCauseId = io.addr.cg === 5.U && io.addr.rc === 4.U
+  private val isCauseInfo = io.addr.cg === 5.U && io.addr.rc === 5.U
+  private val isEscapeMode = io.addr.cg === 5.U && io.addr.rc === 8.U
+  private val isEscapeCfx = io.addr.cg === 5.U && io.addr.rc === 9.U
+  private val isEscapeIp = io.addr.cg === 5.U && io.addr.rc === 10.U
+  private val isEscapeIntrMask = io.addr.cg === 5.U && io.addr.rc === 11.U
+  private val isSpace = io.addr.cg === 7.U
+  // `cfx0`-`cfx3 cg15 rc3` = the running mode's asynchronous source mask
+  // (`ADR-0064` D6).  Only the four monitor cfx have it; `cfx_hart`'s own
+  // `cg15 rc3` is the capture record (`§4.7`).
+  private val isAsyncMask = asyncIntrMaskOpt.isDefined.B && implemented &&
+    io.addr.ha <= 3.U && io.addr.cg === 15.U && io.addr.rc === 3.U
+  // cfx_ptw rows (`DADAO-12` §4.5), decoded only when the machine implements the
+  // cfx: on any other profile these rows stay CFXREG and add no hardware.
+  private val ptwRows: Option[PtwRows] = ptwId.map { id =>
+    val isCfx = io.addr.ha === id.U(6.W)
+    new PtwRows(
+      isEnable = isCfx && io.addr.cg === 8.U && io.addr.rc === 8.U,
+      isPtbr = isCfx && io.addr.cg === 9.U && io.addr.rc === 0.U,
+      isControl = isCfx && io.addr.cg === 12.U && io.addr.rc === 0.U,
+      isAsid = isCfx && io.addr.cg === 12.U && io.addr.rc === 1.U,
+      isStart = isCfx && io.addr.cg === 12.U && io.addr.rc === 2.U,
+      isSize = isCfx && io.addr.cg === 12.U && io.addr.rc === 3.U)
+  }
+
+  /** The six `cfx_ptw` row decoders (one-hot by cg/rc construction). */
+  private class PtwRows(
+    val isEnable: Bool,
+    val isPtbr: Bool,
+    val isControl: Bool,
+    val isAsid: Bool,
+    val isStart: Bool,
+    val isSize: Bool) {
+    val anyRead = isEnable || isPtbr || isAsid || isStart || isSize
+    val anyWrite = anyRead || isControl
+    val isCfx = isEnable || isPtbr || isControl || isAsid || isStart || isSize
+  }
+
+  // `cfx_cache` rows (`DADAO-12` §4.6), decoded only when the machine implements
+  // the cfx: on any other profile these rows stay CFXREG and add no hardware.
+  private val cacheRows: Option[CacheRows] = cacheId.map { id =>
+    val isCfx = io.addr.ha === id.U(6.W)
+    val isCg8 = isCfx && io.addr.cg === 8.U
+    new CacheRows(
+      isExist = isCg8 && io.addr.rc === 0.U,
+      isEnable = isCg8 && io.addr.rc === 8.U,
+      isControl = isCg8 && io.addr.rc === 9.U,
+      isStart = isCg8 && io.addr.rc === 10.U,
+      isSize = isCg8 && io.addr.rc === 11.U)
+  }
+
+  /** The five `cfx_cache` row decoders (one-hot by cg/rc construction). */
+  private class CacheRows(
+    val isExist: Bool,
+    val isEnable: Bool,
+    val isControl: Bool,
+    val isStart: Bool,
+    val isSize: Bool) {
+    // `cache_exist` is RO and `cache_ctrl` is WO (CACHE-03).
+    val anyRead = isExist || isEnable || isStart || isSize
+    val anyWrite = isEnable || isControl || isStart || isSize
+    val isCfx = isExist || isEnable || isControl || isStart || isSize
+  }
+
+  // `cfx_hart` rows (`DADAO-12` §4.7, `ADR-0061` D7), decoded only when the
+  // machine implements the cfx: on any other profile these rows stay CFXREG and
+  // add no hardware.
+  private val hartRows: Option[HartRows] = hartId.map { id =>
+    val isCfx = io.addr.ha === id.U(6.W)
+    val cg8 = isCfx && io.addr.cg === 8.U
+    val cg15 = isCfx && io.addr.cg === 15.U
+    val cg16 = isCfx && io.addr.cg === 16.U
+    new HartRows(
+      isHartId = cg8 && io.addr.rc === 0.U,
+      isCycle = cg8 && io.addr.rc === 2.U,
+      isInsn = cg8 && io.addr.rc === 3.U,
+      isAsyncPrevMode = cg15 && io.addr.rc === 0.U,
+      isAsyncPrevCfx = cg15 && io.addr.rc === 1.U,
+      isAsyncCauseIp = cg15 && io.addr.rc === 2.U,
+      isAsyncPrevMask = cg15 && io.addr.rc === 3.U,
+      isAsyncSrcFrame = cg15 && io.addr.rc === 4.U,
+      isAsyncSrcPending = cg15 && io.addr.rc === 5.U,
+      isAsyncSwitch = cg15 && io.addr.rc === 14.U,
+      isAsyncVector = cg15 && io.addr.rc === 15.U,
+      isTimerCtrl = cg16 && io.addr.rc === 0.U,
+      isTimerCmp = cg16 && io.addr.rc === 1.U,
+      isTimerMask = cg16 && io.addr.rc === 16.U,
+      isTimerPending = cg16 && io.addr.rc === 17.U,
+      isTimerAck = cg16 && io.addr.rc === 18.U)
+  }
+
+  /** `cfx_hart` row decoders (one-hot by cg/rc construction, `§4.7`). */
+  private class HartRows(
+    val isHartId: Bool,
+    val isCycle: Bool,
+    val isInsn: Bool,
+    val isAsyncPrevMode: Bool,
+    val isAsyncPrevCfx: Bool,
+    val isAsyncCauseIp: Bool,
+    val isAsyncPrevMask: Bool,
+    val isAsyncSrcFrame: Bool,
+    val isAsyncSrcPending: Bool,
+    val isAsyncSwitch: Bool,
+    val isAsyncVector: Bool,
+    val isTimerCtrl: Bool,
+    val isTimerCmp: Bool,
+    val isTimerMask: Bool,
+    val isTimerPending: Bool,
+    val isTimerAck: Bool) {
+    // cg8 rc0/2/3 are RO.  cg15 rc0-rc5 are the HW-written capture group
+    // (`§4.7`, `ADR-0064` D5): software writes are *ignored without an
+    // exception* (accepted, no effect), so they stay in the write set;
+    // rc14/rc15 are RW configuration.  cg16 rc0/rc1/rc16/rc18 are RW, rc17
+    // (`pending`) is RO, so a write of it is CFXREG.
+    val anyRead = isHartId || isCycle || isInsn ||
+      isAsyncPrevMode || isAsyncPrevCfx || isAsyncCauseIp || isAsyncPrevMask ||
+      isAsyncSrcFrame || isAsyncSrcPending || isAsyncSwitch || isAsyncVector ||
+      isTimerCtrl || isTimerCmp || isTimerMask || isTimerPending || isTimerAck
+    val anyWrite = isAsyncPrevMode || isAsyncPrevCfx || isAsyncCauseIp ||
+      isAsyncPrevMask || isAsyncSrcFrame || isAsyncSrcPending ||
+      isAsyncSwitch || isAsyncVector ||
+      isTimerCtrl || isTimerCmp || isTimerMask || isTimerAck
+    val isCfx = anyRead
+  }
+
+  // `cfx_pmem` rows (`DADAO-12` §4.9), decoded only when the machine implements
+  // the cfx: on any other profile these rows stay CFXREG and add no hardware.
+  private val pmemRows: Option[PmemRows] = pmemId.map { id =>
+    val isCfx = io.addr.ha === id.U(6.W)
+    val cg8 = isCfx && io.addr.cg === 8.U
+    val isDma = isCfx && io.addr.cg === 15.U
+    val cg16 = isCfx && io.addr.cg === 16.U
+    new PmemRows(
+      isExist = cg8 && io.addr.rc === 0.U,
+      isStart = isCfx && io.addr.cg === 12.U,
+      isPmSize = isCfx && io.addr.cg === 13.U,
+      isAttr = isCfx && io.addr.cg === 14.U,
+      isDmaSrc = isDma && io.addr.rc === 0.U,
+      isDmaDst = isDma && io.addr.rc === 1.U,
+      isDmaSize = isDma && io.addr.rc === 2.U,
+      isDmaCtrl = isDma && io.addr.rc === 3.U,
+      isDmaStatus = isDma && io.addr.rc === 4.U,
+      isDmaMask = cg16 && io.addr.rc === 16.U,
+      isDmaPending = cg16 && io.addr.rc === 17.U,
+      isDmaAck = cg16 && io.addr.rc === 18.U)
+  }
+
+  /** The `cfx_pmem` row decoders (one-hot by cg/rc construction). */
+  private class PmemRows(
+    val isExist: Bool,
+    val isStart: Bool,
+    val isPmSize: Bool,
+    val isAttr: Bool,
+    val isDmaSrc: Bool,
+    val isDmaDst: Bool,
+    val isDmaSize: Bool,
+    val isDmaCtrl: Bool,
+    val isDmaStatus: Bool,
+    val isDmaMask: Bool,
+    val isDmaPending: Bool,
+    val isDmaAck: Bool) {
+    // `pmem_exist` (cg8 rc0) is RO; `cg15 rc5..63` are reserved and absent from
+    // every set, so they fall through to CFXREG.  `cg16 rc17` (`pending`) is
+    // RO as well; `rc16` mask and `rc18` ack are writable.
+    val anyRead = isExist || isStart || isPmSize || isAttr || isDmaSrc ||
+      isDmaDst || isDmaSize || isDmaCtrl || isDmaStatus ||
+      isDmaMask || isDmaPending || isDmaAck
+    // The DONE/ERROR W1C row is writable; `BUSY` itself is read-only, which the
+    // write block enforces by masking the value.
+    val anyWrite = isStart || isPmSize || isAttr || isDmaSrc || isDmaDst ||
+      isDmaSize || isDmaCtrl || isDmaStatus || isDmaMask || isDmaAck
+    val isCfx = anyRead
+  }
+
+  // `cfx_time` rows (`DADAO-12` §4.10), decoded only when the machine implements
+  // the cfx: on any other profile these rows stay CFXREG and add no hardware.
+  // Both rows are **read-only** and there is no interrupt row at all.
+  private val timeRows: Option[TimeRows] = gp.time.map { t =>
+    val isCfx = io.addr.ha === t.cfxId.U(6.W)
+    new TimeRows(
+      isFreq = isCfx && io.addr.cg === 10.U && io.addr.rc === 0.U,
+      isValue = isCfx && io.addr.cg === 10.U && io.addr.rc === 1.U)
+  }
+
+  /** The two `cfx_time` row decoders (one-hot by cg/rc construction, `§4.10`). */
+  private class TimeRows(val isFreq: Bool, val isValue: Bool) {
+    // cg10 rc0/rc1 are RO; every write of them — and every other rc of cg10 —
+    // is CFXREG (`§4.10`).
+    val anyRead = isFreq || isValue
+    val isCfx = anyRead
+  }
+
+  // `cfx_power` `cg8 rc1 cfx_power_ctrl` (`DADAO-12 §4.12`, `m16-chipyard-031`).
+  // WO: the write is accepted and there is no read path, so the row never joins
+  // a read set (a read stays CFXREG).  Decoded only for the cfx that opts in;
+  // Kaiwu-Tiny keeps the row unimplemented (`spec/Kaiwu §3`).
+  private val powerCtrlRow: Option[PowerCtrlRows] =
+    gp.cfx.find(_.powerCtrl).map { c =>
+      val isCfx = io.addr.ha === c.id.U(6.W)
+      new PowerCtrlRows(
+        isCtrl = isCfx && io.addr.cg === 8.U && io.addr.rc === 1.U)
+    }
+
+  /** The `cfx_power_ctrl` row decoder (WO, no state of its own). */
+  private class PowerCtrlRows(val isCtrl: Bool) {
+    val anyWrite = isCtrl
+  }
+
+  // Monitor common face rows (`m16-chipyard-019`): only the enabled cfx decode
+  // them, so an opted-out profile adds no terms (all `CommonEntry`s absent).
+  private def anyCommon(f: CommonEntry => Bool): Bool =
+    if (commonEntries.isEmpty) false.B
+    else commonEntries.map(f).reduce(_ || _)
+  private val commonRead = anyCommon(e =>
+    e.isMask || e.isSwitch || e.isHypvSwitch || e.isVector || e.isDeleg ||
+      (e.isCfg && io.addr.rc <= 6.U) || e.isScratch)
+  // cg4 is read-only (`DADAO-12 §3.5`); every other common row is RW.
+  private val commonWrite = anyCommon(e =>
+    e.isMask || e.isSwitch || e.isHypvSwitch || e.isVector || e.isDeleg ||
+      e.isScratch)
+
+  // Base rows of every implemented cfx (`DADAO-13` §1, `DADAO-12` §3).
+  private val readBase = isMask || isSwitchMode || isVector ||
+    isPrevMode || isPrevCfx || isPrevIp || isPrevIntrMask ||
+    isCauseId || isCauseInfo ||
+    isEscapeMode || isEscapeCfx || isEscapeIp || isEscapeIntrMask ||
+    isSpace || isAsyncMask
+  // cg3 rc14 accepts the write and ignores it when the core keeps one mode;
+  // cg5 rc0-rc5 are hardware-written, so writing them is CFXREG (`§3.6`,
+  // R3-D2).  cg7 is read-only.
+  private val writeBase = isMask || isSwitchMode || isVector ||
+    isEscapeMode || isEscapeCfx || isEscapeIp || isEscapeIntrMask || isAsyncMask
+  // `cfx_cache_ctrl` encoding check (`contract-cache` §3 CACHE-11…CACHE-14):
+  // selection first, then the operation, then the range encoding and operand.
+  // Only a selected side with a non-`none` operation is checked; `[15:14] = 00`
+  // and `op = none` are unconditional no-ops (CACHE-12/13).  A rejected write
+  // is a precise CFXREG (CACHE-14), so it must fail `writeOk` before any state
+  // changes.
+  private val cacheCtrlLegal: Bool =
+    (for { rows <- cacheRows; regs <- cacheRegs } yield {
+      val sel = io.wdata(15, 14)
+      val op = io.wdata(1, 0)
+      val scope = io.wdata(3, 2)
+      Mux(rows.isControl,
+        !(sel =/= 0.U && op =/= 0.U &&
+          (scope === 3.U || (scope === 2.U && regs.addrSize === 0.U))),
+        true.B)
+    }).getOrElse(true.B)
+
+  io.readOk := implemented && cg3Allowed &&
+    (readBase || commonRead ||
+      ptwRows.map(_.anyRead).getOrElse(false.B) ||
+      cacheRows.map(_.anyRead).getOrElse(false.B) ||
+      hartRows.map(_.anyRead).getOrElse(false.B) ||
+      pmemRows.map(_.anyRead).getOrElse(false.B) ||
+      timeRows.map(_.anyRead).getOrElse(false.B))
+  // `tlb_control` and `cache_ctrl` are WO: writing them is legal, reading them
+  // is not (they are not in the read sets above).  `cfx_time`'s two rows are
+  // RO, so they never appear in the write set: any write of `cg10` is CFXREG.
+  io.writeOk := implemented && cg3Allowed && cacheCtrlLegal &&
+    (writeBase || commonWrite ||
+      ptwRows.map(_.anyWrite).getOrElse(false.B) ||
+      cacheRows.map(_.anyWrite).getOrElse(false.B) ||
+      hartRows.map(_.anyWrite).getOrElse(false.B) ||
+      pmemRows.map(_.anyWrite).getOrElse(false.B) ||
+      powerCtrlRow.map(_.anyWrite).getOrElse(false.B))
+
+  // `cfx_power_ctrl` is write-executes with no state (`DADAO-12 §4.12`): the
+  // accepted write raises a one-cycle action event.  bit0 = POWEROFF wins over
+  // bit1 = HARD_RESET and bit2 = SOFT_RESET (QEMU/gem5 priority); a write of 0
+  // or one with only bits ≥3 set is accepted with no event.
+  private val powerFire = powerCtrlRow.map(r => io.wEn && io.writeOk && r.isCtrl)
+    .getOrElse(false.B)
+  io.power.valid := powerFire && io.wdata(2, 0) =/= 0.U
+  io.power.action := Mux(io.wdata(0), 0.U, Mux(io.wdata(1), 1.U, 2.U))
+
+  /** Per-cfx constant, selected by the addressed instance. */
+  private def perCfx(f: GewuCfxParams => BigInt): UInt =
+    Mux1H(hit, gp.cfx.map(c => f(c).U(gp.dataBits.W)))
+
+  // cg7 space block 0 start = base - (cfxha << 42) (`DADAO-12` §2.1/§3.8).
+  // A cfx without internal space (`spaceDesc` bit0 = 0, e.g. `cfx_ptw`) has no
+  // base to anchor: 0 keeps the arithmetic non-negative and matches the spec's
+  // "exists = 0 ⇒ start/size/attr read 0" rule (the read mux enforces the rest).
+  private def spaceStart(c: GewuCfxParams): BigInt =
+    if ((c.spaceDesc & 1) == 0) BigInt(0) else c.vectorBase - (BigInt(c.id) << 42)
+
+  private val cg7Data = MuxLookup(io.addr.rc(1, 0), 0.U(gp.dataBits.W))(Seq(
+    0.U -> perCfx(_.spaceDesc),
+    1.U -> perCfx(spaceStart),
+    2.U -> perCfx(_.spaceSize),
+    3.U -> perCfx(_.spaceAttr)))
+  // cg7 is 16 blocks of 4 words (desc/start/size/attr); only block 0 exists.
+  // `exists = 0` (desc bit0) ⇒ start/size/attr read 0 (`DADAO-12` §3.8), which is
+  // the path cfx_ptw (no internal space) reads through.  Only a machine with a
+  // spaceless cfx needs that gate: when every implemented cfx has block 0 the
+  // original expression is kept, so a profile without such a cfx gains no muxing.
+  private val anySpaceMissing = gp.cfx.exists(c => (c.spaceDesc & 1) == 0)
+  private val cg7Rdata =
+    if (anySpaceMissing) {
+      Mux(io.addr.rc(5, 2) =/= 0.U, 0.U(gp.dataBits.W),
+        Mux(io.addr.rc(1, 0) === 0.U || perCfx(_.spaceDesc)(0),
+          cg7Data, 0.U(gp.dataBits.W)))
+    } else {
+      Mux(io.addr.rc(5, 2) === 0.U, cg7Data, 0.U(gp.dataBits.W))
+    }
+
+  // The read data is defined for every address (the permission outputs say
+  // whether it may be used): a rejected access must not leak a stale value.
+  private val rcMaskIndex = Mux(io.addr.rc <= 3.U, io.addr.rc(1, 0), 0.U)
+  private val maskData = intrMaskOpt match {
+    case Some(m) => Mux(io.addr.rc === 4.U, m(sel), sourceMask(sel)(rcMaskIndex))
+    case None => sourceMask(sel)(rcMaskIndex)
+  }
+  /** `cfx_<monitor>_async_intr_mask` of the addressed cfx (`cg15 rc3`, D6). */
+  private val asyncMaskData = asyncIntrMaskOpt.map(_(sel))
+    .getOrElse(0.U(gp.dataBits.W))
+  // Base read data (every implemented cfx, `DADAO-13` §1 / `DADAO-12` §3.6).
+  private val baseRdata = Mux(isAsyncMask, asyncMaskData,
+    Mux(isMask, maskData,
+    Mux(isSwitchMode, gp.switchModeValue.U(gp.dataBits.W),
+      Mux(isVector, vector(sel),
+        Mux(isPrevMode, prevMode(sel).pad(gp.dataBits),
+          Mux(isPrevCfx, prevCfx(sel),
+            Mux(isPrevIp, prevIp(sel),
+              Mux(isPrevIntrMask, prevIntrMask(sel),
+                Mux(isCauseId, causeId(sel),
+                  Mux(isCauseInfo, causeInfo(sel),
+                    Mux(isEscapeMode, escapeRunMode(sel).pad(gp.dataBits),
+                      Mux(isEscapeCfx, escapeCfx(sel),
+                        Mux(isEscapeIp, escapeIp(sel),
+                          Mux(isEscapeIntrMask, escapeIntrMask(sel),
+                            cg7Rdata))))))))))))))
+
+  // cfx_ptw read data: PTBR reads back as `[63:56] = 0, [55:16] = PPN,
+  // [15:0] = 0`; ASID as `[15:0]` plus zeros; start as `VA[41:0]` plus zeros
+  // (`DADAO-12` §4.5 — the stored fields are the only readable ones).
+  // `Bool.asUInt` is the same node (Bool <: UInt), so widen the enable with `Cat`.
+  private val ptwRdata = for {
+    rows <- ptwRows
+    regs <- ptwRegs
+  } yield Mux(rows.isEnable, Cat(0.U((gp.dataBits - 1).W), regs.enable),
+    Mux(rows.isPtbr, Cat(0.U((gp.dataBits - 56).W), regs.ptbr, 0.U(16.W)),
+      Mux(rows.isAsid, regs.asid.pad(gp.dataBits),
+        Mux(rows.isStart, regs.addrStart.pad(gp.dataBits),
+          Mux(rows.isSize, regs.addrSize, 0.U(gp.dataBits.W))))))
+
+  // `cfx_cache` read data (`DADAO-12` §4.6): `cache_exist` is the machine's
+  // constant; `cache_enable` reads the two existing-side bits; `addr_start`
+  // reads `PA[55:0]` with `[63:56] = 0` (CACHE-18); `addr_size` is the full
+  // 64-bit byte count.  `cache_ctrl` is WO and reads as CFXREG, so it never
+  // appears here.
+  private val cacheRdata = for {
+    rows <- cacheRows
+    regs <- cacheRegs
+  } yield Mux(rows.isExist, cacheExists.U(gp.dataBits.W),
+    Mux(rows.isEnable, regs.enable.pad(gp.dataBits),
+      Mux(rows.isStart, regs.addrStart.pad(gp.dataBits),
+        Mux(rows.isSize, regs.addrSize, 0.U(gp.dataBits.W)))))
+
+  // `cfx_hart` read data (`DADAO-12` §4.7, `ADR-0064` D2/D3/D5).  `cg16 rc0`
+  // reads back only bit0 ENABLE; `rc16` the source mask bit0, `rc17` the
+  // pending bit0 and `rc18` always 0 (W1C).  `cg15 rc0`-`rc5` is the HW-written
+  // capture group (software read-only), `rc14` the RW entry mode (reset 2 =
+  // supv, also the entry upper bound) and `rc15` the RW vector.
+  private val hartTime: UInt =
+    io.hart.map(_.timeValue).getOrElse(0.U(gp.dataBits.W))
+  private val hartRdata = for {
+    rows <- hartRows
+    regs <- hartRegs
+  } yield {
+    Mux(rows.isHartId, gp.hart.get.hartId.U(gp.dataBits.W),
+      Mux(rows.isCycle, hartTime,
+        Mux(rows.isInsn, regs.insn,
+          Mux(rows.isTimerCmp, regs.timerCmp,
+            Mux(rows.isTimerCtrl,
+              Cat(0.U((gp.dataBits - 1).W), regs.timerEnable),
+              Mux(rows.isTimerMask,
+                Cat(0.U((gp.dataBits - 1).W), regs.timerMask),
+                Mux(rows.isTimerPending,
+                  Cat(0.U((gp.dataBits - 1).W), regs.timerPending),
+                  Mux(rows.isTimerAck, 0.U(gp.dataBits.W),
+                    Mux(rows.isAsyncPrevMode, regs.asyncPrevMode.pad(gp.dataBits),
+                      Mux(rows.isAsyncPrevCfx, regs.asyncPrevCfx.pad(gp.dataBits),
+                        Mux(rows.isAsyncCauseIp, regs.asyncCauseIp,
+                          Mux(rows.isAsyncPrevMask, regs.asyncPrevMask,
+                            Mux(rows.isAsyncSrcFrame, regs.asyncSrcFrame,
+                              Mux(rows.isAsyncSrcPending, pendingSummary,
+                                Mux(rows.isAsyncSwitch,
+                                  regs.asyncSwitch.pad(gp.dataBits),
+                                  Mux(rows.isAsyncVector, regs.asyncVector,
+                                    0.U(gp.dataBits.W)))))))))))))))))
+  }
+
+  private val baseAndPtw =
+    ptwRdata.map(d => Mux(ptwRows.get.isCfx, d, baseRdata)).getOrElse(baseRdata)
+  private val basePtwCache =
+    cacheRdata.map(d => Mux(cacheRows.get.isCfx, d, baseAndPtw)).getOrElse(baseAndPtw)
+  private val basePtwCacheHart =
+    hartRdata.map(d => Mux(hartRows.get.isCfx, d, basePtwCache)).getOrElse(basePtwCache)
+
+  // `cfx_pmem` read data (`DADAO-12` §4.9, `ADR-0064` D2).  `pmem_exist` is
+  // the machine's hardware-set bitmap of PM regions (64 regions on this
+  // machine); `dma_status` reads `BUSY | DONE<<1 | ERROR<<2 | ERR_CODE<<3`;
+  // `dma_ctrl` reads back `DIR` only (START self-clears, bit2+ reserved 0).
+  private val pmemRdata = for {
+    rows <- pmemRows
+    regs <- pmemRegs
+  } yield Mux(rows.isExist, Fill(gp.dataBits, 1.U(1.W)),
+    Mux(rows.isStart, regs.start(io.addr.rc),
+      Mux(rows.isPmSize, regs.size(io.addr.rc),
+        Mux(rows.isAttr, regs.attr(io.addr.rc),
+          Mux(rows.isDmaSrc, regs.dmaSrc,
+            Mux(rows.isDmaDst, regs.dmaDst,
+              Mux(rows.isDmaSize, regs.dmaSize.pad(gp.dataBits),
+                Mux(rows.isDmaCtrl,
+                  Cat(0.U((gp.dataBits - 2).W), regs.dmaDir, 0.U(1.W)),
+                  Mux(rows.isDmaStatus,
+                    Cat(0.U((gp.dataBits - 16).W), regs.errCode, regs.error,
+                      regs.done, io.pmem.map(_.busy).getOrElse(false.B)),
+                    Mux(rows.isDmaMask,
+                      Cat(0.U((gp.dataBits - 1).W), regs.dmaMask),
+                      Mux(rows.isDmaPending,
+                        Cat(0.U((gp.dataBits - 1).W), regs.dmaPending),
+                        Mux(rows.isDmaAck, 0.U(gp.dataBits.W),
+                          0.U(gp.dataBits.W)))))))))))))
+
+  private val basePtwCacheHartPmem =
+    pmemRdata.map(d => Mux(pmemRows.get.isCfx, d, basePtwCacheHart))
+      .getOrElse(basePtwCacheHart)
+
+  // `cfx_time` read data (`DADAO-12` §4.10): `time_freq` is the machine's
+  // counting frequency, `time_value` the free-running per-system count.  Both
+  // are RO; no other rc of cg10 is decoded (writes are CFXREG via `writeOk`).
+  private val timeRdata = for {
+    rows <- timeRows
+    t <- gp.time
+  } yield Mux(rows.isFreq, t.freq.U(gp.dataBits.W),
+    Mux(rows.isValue,
+      io.time.map(_.timeValue).getOrElse(0.U(gp.dataBits.W)),
+      0.U(gp.dataBits.W)))
+  private val basePtwCacheHartPmemTime =
+    timeRdata.map(d => Mux(timeRows.get.isCfx, d, basePtwCacheHartPmem))
+      .getOrElse(basePtwCacheHartPmem)
+
+  // Monitor common face read data (`m16-chipyard-019`, `DADAO-12 §3`).  The
+  // mode-row index is `cg` (0/1/2); `cg3` rows stay in `baseRdata` above.
+  private val commonRdata =
+    if (commonEntries.isEmpty) 0.U(gp.dataBits.W)
+    else Mux1H(commonHits, commonEntries.map { e =>
+      val r = e.regs
+      // `cg0-cg2`: rc0-rc3 are the four sync masks (rc4 is reserved).
+      val rcIdx = Mux(io.addr.rc <= 3.U, io.addr.rc(2, 0), 0.U)
+      val scratchIdx = Mux(io.addr.rc < e.c.scratchRegs.U,
+        io.addr.rc(log2Ceil(e.c.scratchRegs) - 1, 0), 0.U)
+      Mux(e.isMask, r.mask(e.mode)(rcIdx),
+        Mux(e.isSwitch, r.switchMode(e.mode),
+          Mux(e.isHypvSwitch, r.switchMode(3.U),
+            Mux(e.isVector, r.vector(e.mode),
+              Mux(e.isDeleg, r.deleg,
+                Mux(e.isCfg, MuxLookup(io.addr.rc, 0.U(gp.dataBits.W))(Seq(
+                  0.U -> e.c.id.U(gp.dataBits.W),
+                  1.U -> e.c.version.U(gp.dataBits.W),
+                  2.U -> r.trapNum,
+                  3.U -> r.syncNum,
+                  4.U -> r.asyncNum,
+                  5.U -> r.escapeNum,
+                  6.U -> e.c.scratchRegs.U(gp.dataBits.W))),
+                  Mux(e.isScratch, r.scratch(scratchIdx),
+                    0.U(gp.dataBits.W))))))))
+    })
+
+  io.rdata := Mux(commonRead, commonRdata, basePtwCacheHartPmemTime)
+
+  when(io.wEn && io.writeOk) {
+    when(isMask) {
+      if (asyncModel) {
+        sourceMask(sel)(rcMaskIndex) := io.wdata
+      } else {
+        when(io.addr.rc === 4.U) { intrMaskOpt.get(sel) := io.wdata }
+          .otherwise { sourceMask(sel)(rcMaskIndex) := io.wdata }
+      }
+    }.elsewhen(isVector) {
+      // `DADAO-13` §1: the vector is 4-byte aligned, writes drop the low bits.
+      vector(sel) := Cat(io.wdata(gp.dataBits - 1, 2), 0.U(2.W))
+    }.elsewhen(isEscapeMode) {
+      // `cg5 rc8`: 2-bit target run mode (`DADAO-12 §3.6`).
+      escapeRunMode(sel) := io.wdata(gp.modeBits - 1, 0)
+    }.elsewhen(isEscapeCfx) {
+      // `cg5 rc9`: 6-bit target cfxha; reads back zero-extended.
+      escapeCfx(sel) := io.wdata(5, 0)
+    }.elsewhen(isEscapeIp) {
+      // `cg5 rc10`: 48-bit return ip, low two bits dropped (4-byte aligned).
+      escapeIp(sel) := Cat(0.U((gp.dataBits - 48).W),
+        io.wdata(47, 2), 0.U(2.W))
+    }.elsewhen(isEscapeIntrMask) {
+      // `cg5 rc11`: whole 64-bit source mask restored by `escape`.
+      escapeIntrMask(sel) := io.wdata
+    }
+    // cg3 rc14 is accepted and ignored: no run-mode register to write here;
+    // a common cfx keeps its per-mode row in the common-face block below.
+  }
+
+  // `cfx0`-`cfx3 cg15 rc3`: the running mode's async source mask is ordinary
+  // RW policy state (`ADR-0064` D6), disjoint from every other row.
+  for (m <- asyncIntrMaskOpt) {
+    when(io.wEn && io.writeOk && isAsyncMask) { m(sel) := io.wdata }
+  }
+
+  // Monitor common face writes (`m16-chipyard-019`).  Rows are disjoint from
+  // the base/PTW/cache rows by construction (different cg/rc, or a cfx that
+  // opted out), so each enabled cfx gets its own block.
+  for (e <- commonEntries) {
+    when(io.wEn && io.writeOk && e.hit) {
+      val r = e.regs
+      val rcIdx = Mux(io.addr.rc <= 4.U, io.addr.rc(2, 0), 0.U)
+      val scratchIdx = Mux(io.addr.rc < e.c.scratchRegs.U,
+        io.addr.rc(log2Ceil(e.c.scratchRegs) - 1, 0), 0.U)
+      when(e.isMask) {
+        r.mask(e.mode)(rcIdx) := io.wdata
+      }.elsewhen(e.isSwitch) {
+        r.switchMode(e.mode) := io.wdata
+      }.elsewhen(e.isHypvSwitch) {
+        r.switchMode(3.U) := io.wdata
+      }.elsewhen(e.isVector) {
+        // Same alignment rule as cg3 rc10 (`DADAO-12 §3.4`).
+        r.vector(e.mode) := Cat(io.wdata(gp.dataBits - 1, 2), 0.U(2.W))
+      }.elsewhen(e.isDeleg) {
+        // `cg_reg_deleg` bit3 is hardware-fixed 1 (`DADAO-12 §3.4`).
+        r.deleg := io.wdata | 8.U
+      }.elsewhen(e.isScratch) {
+        r.scratch(scratchIdx) := io.wdata
+      }
+    }
+  }
+
+  // cfx_ptw writes (`DADAO-12` §4.5): a separate block because the rows are
+  // disjoint from the base ones by construction (different cg/rc), and it only
+  // exists when the machine implements the cfx.
+  for {
+    rows <- ptwRows
+    regs <- ptwRegs
+  } {
+    // `tlb_control` is a one-cycle pulse: low every cycle, raised by the write.
+    regs.control := false.B
+    when(io.wEn && io.writeOk) {
+      when(rows.isEnable) {
+        // 1 bit of state: 0 = bypass the TLB, 1 = translate (`§4.5`).
+        regs.enable := io.wdata(0)
+      }.elsewhen(rows.isPtbr) {
+        // Only `PPN[55:16]` is stored: 64 KiB alignment is structural, and the
+        // `[63:56]`/`[15:0]` fields do not exist (`§4.5`).
+        regs.ptbr := io.wdata(55, 16)
+      }.elsewhen(rows.isAsid) {
+        regs.asid := io.wdata(15, 0)
+      }.elsewhen(rows.isStart) {
+        regs.addrStart := io.wdata(41, 0)
+      }.elsewhen(rows.isSize) {
+        regs.addrSize := io.wdata
+      }.elsewhen(rows.isControl) {
+        // Write-executes: the write is the command, so the value is only handed
+        // to the core as a one-cycle event (`§4.5` "写即同步执行，无完成状态").
+        regs.control := true.B
+        regs.controlData := io.wdata
+      }
+    }
+  }
+
+  // `cfx_cache` writes (`DADAO-12` §4.6): disjoint from the base and
+  // `cfx_ptw` rows by construction (different cfxha/cg/rc).  A rejected
+  // `cache_ctrl` encoding never reaches this block (`writeOk` is false), so no
+  // command event is produced for a CFXREG write (CACHE-14/CACHE-25).
+  for {
+    rows <- cacheRows
+    regs <- cacheRegs
+  } {
+    // `cache_ctrl` is a one-cycle pulse: low every cycle, raised by the write.
+    regs.control := false.B
+    when(io.wEn && io.writeOk) {
+      when(rows.isEnable) {
+        // Only existing sides are writable; a write of 1 to an absent side has
+        // no effect and reads back 0 (CACHE-07).
+        regs.enable := io.wdata(1, 0) & cacheExists.U(2.W)
+      }.elsewhen(rows.isStart) {
+        // Full 56-bit PA; `[63:56]` is reserved and writes are ignored
+        // (CACHE-18).
+        regs.addrStart := io.wdata(55, 0)
+      }.elsewhen(rows.isSize) {
+        regs.addrSize := io.wdata
+      }.elsewhen(rows.isControl) {
+        // Write-executes; the encoding was checked in `writeOk`.
+        regs.control := true.B
+        regs.controlData := io.wdata
+      }
+    }
+  }
+
+  // `cfx_hart` writes (`DADAO-12` §4.7, `ADR-0060` D2): disjoint from the
+  // other faces by construction (different cfxha/cg/rc).
+  for {
+    rows <- hartRows
+    regs <- hartRegs
+  } {
+    when(io.wEn && io.writeOk) {
+      when(rows.isTimerCmp) {
+        // A new deadline only re-arms; it never clears pending (`ADR-0064`
+        // D3): the event/ack state lives in `cg16 rc17`/`rc18`.
+        regs.timerCmp := io.wdata
+      }.elsewhen(rows.isTimerCtrl) {
+        // bit0 ENABLE only; bits 1+ are reserved (read 0 / write ignored).
+        regs.timerEnable := io.wdata(0)
+      }.elsewhen(rows.isTimerMask) {
+        // Reserved mask bits read 0 / write ignored: only bit0 is stored.
+        regs.timerMask := io.wdata(0)
+      }.elsewhen(rows.isTimerAck) {
+        // W1C: bit0 clears the pending latch; an already-clear bit is a no-op.
+        when(io.wdata(0)) { regs.timerPending := false.B }
+      }.elsewhen(rows.isAsyncSwitch) {
+        // `async_switch_run_mode` (rc14): RW 2-bit, the written value lands and
+        // reads back (`§4.7`); it is also the entry mode upper bound.
+        regs.asyncSwitch := io.wdata(gp.modeBits - 1, 0)
+      }.elsewhen(rows.isAsyncVector) {
+        // `async_excp_vector` (rc15): 48-bit core address, 4-byte aligned.
+        regs.asyncVector := Cat(0.U((gp.dataBits - 48).W),
+          io.wdata(47, 2), 0.U(2.W))
+      }
+      // `cg15 rc0`-`rc5` are the HW-written capture group (`§4.7`, `ADR-0064`
+      // D5): software writes are accepted but ignored, the value reads back
+      // unchanged and no exception is raised.
+    }
+    // Retired instruction counter (`§4.7 insn`).
+    when(io.hart.get.retire) { regs.insn := regs.insn + 1.U }
+  }
+
+  // ---- `cfx_pmem` writes and the DMA command (`DADAO-12` §4.9) -----------
+  // The setup checks (SIZE / CFX_RANGE / PA_RANGE / PA_FAULT) run here, in the
+  // START cycle: a rejected transfer never raises BUSY and sets ERROR with the
+  // one-hot ERR_CODE, while a legal one hands `start` to the core's byte mover
+  // (`GewuFileIO.pmem`).  While `BUSY` is high every cg15 write (registers and
+  // the DONE/ERROR W1C) is accepted by the row rules but has no effect; reads
+  // are unaffected.
+  private val pmemBusy: Bool = io.pmem.map(_.busy).getOrElse(false.B)
+  private val pmemStartWrite: Bool = pmemRows.map { rows =>
+    io.wEn && io.writeOk && rows.isDmaCtrl && io.wdata(0) && !pmemBusy
+  }.getOrElse(false.B)
+  /** One-hot error code of the START-time checks (bit order = §4.9 table). */
+  private val pmemErrNow: UInt =
+    (for {
+      cfg <- gp.pmem
+      regs <- pmemRegs
+    } yield {
+      val size = regs.dmaSize
+      val dir = io.wdata(1)
+      val cfxAddr = Mux(dir, regs.dmaDst, regs.dmaSrc)(41, 0)
+      val paAddr = Mux(dir, regs.dmaSrc, regs.dmaDst)(55, 0)
+      val paLimit = (BigInt(1) << 56).U(57.W)
+      def inWindow(x: UInt, base: BigInt, window: BigInt): Bool =
+        x >= base.U(56.W) && x < (base + window).U(56.W)
+      val sizeBad = size === 0.U || size > (BigInt(1) << 29).U
+      val cfxOff = cfxAddr - cfg.sramOffset.U(42.W)
+      val cfxBad = cfxAddr < cfg.sramOffset.U ||
+        (cfxOff.pad(43) + size.pad(43)) > cfg.sramSize.U
+      val paEnd = paAddr.pad(57) + size.pad(57)
+      val paRangeBad = paEnd > paLimit
+      val ramBad = !inWindow(paAddr, cfg.paBase, cfg.paSize)
+      val romBad = !inWindow(paAddr, cfg.romBase, cfg.romSize)
+      // A read may target RAM or the BootROM; a write only RAM (§4.9, §Kaiwu §3).
+      val paTargetBad = Mux(dir, ramBad && romBad, ramBad)
+      Mux(sizeBad, 1.U(13.W),
+        Mux(cfxBad, 2.U(13.W),
+          Mux(paRangeBad, 4.U(13.W), Mux(paTargetBad, 8.U(13.W), 0.U(13.W)))))
+    }).getOrElse(0.U(13.W))
+  private val pmemStartOk: Bool = pmemStartWrite && pmemErrNow === 0.U
+  private val pmemStartErr: Bool = pmemStartWrite && pmemErrNow =/= 0.U
+  private val pmemDoneEvent: Bool =
+    io.pmem.map(_.done).getOrElse(false.B)
+  private val pmemErrEvent: Bool =
+    io.pmem.map(_.error).getOrElse(false.B)
+  /** PMEM_DMA's single source sub-event (`ADR-0064` D2/D3): a transfer end
+    * (DONE or ERROR) — including a rejected START's setup error — latches
+    * `cg16 rc17` bit0.  It is sticky and only `cg16 rc18` clears it; the
+    * engine's `dma_status` W1C is separate state cleanup and never touches it.
+    * Registered: `pmemStartErr` depends on the write data, and a combinational
+    * path into `intr.valid` would close a loop through the core's own cfx
+    * write path. */
+  private val pmemEvent: Bool = RegNext(
+    pmemDoneEvent || pmemErrEvent || pmemStartErr, false.B)
+
+  for (rows <- pmemRows; regs <- pmemRegs) {
+    when(io.wEn && io.writeOk) {
+      when(rows.isStart) {
+        regs.start(io.addr.rc) := io.wdata
+      }.elsewhen(rows.isPmSize) {
+        regs.size(io.addr.rc) := io.wdata
+      }.elsewhen(rows.isAttr) {
+        regs.attr(io.addr.rc) := io.wdata
+      }.elsewhen(!pmemBusy) {
+        // `BUSY` freezes the whole cg15 group (`DADAO-12` §4.9).  START itself
+        // is not stored: reading `dma_ctrl` always shows 0 there.
+        when(rows.isDmaSrc) {
+          regs.dmaSrc := io.wdata
+        }.elsewhen(rows.isDmaDst) {
+          regs.dmaDst := io.wdata
+        }.elsewhen(rows.isDmaSize) {
+          regs.dmaSize := io.wdata(29, 0)
+        }.elsewhen(rows.isDmaCtrl) {
+          // bit0 START is not stored; bit1 DIR; bit2+ reserved (write ignored).
+          regs.dmaDir := io.wdata(1)
+        }.elsewhen(rows.isDmaStatus) {
+          when(io.wdata(1)) { regs.done := false.B }
+          when(io.wdata(2)) { regs.error := false.B; regs.errCode := 0.U }
+        }
+      }
+      // `cg16` source face (`ADR-0064` D1): mask RW (bit0), pending RO, ack
+      // W1C.  It is not frozen by BUSY — only the cg15 engine group is.
+      when(rows.isDmaMask) {
+        regs.dmaMask := io.wdata(0)
+      }.elsewhen(rows.isDmaAck) {
+        when(io.wdata(0)) { regs.dmaPending := false.B }
+      }
+    }
+    // Sticky completion (`DONE`/`ERROR` are cleared by W1C only) and the
+    // setup error of a rejected START.  Events win over a same-cycle W1C.
+    when(pmemDoneEvent) { regs.done := true.B }
+    when(pmemErrEvent) { regs.error := true.B; regs.errCode := 8.U }
+    when(pmemStartErr) { regs.error := true.B; regs.errCode := pmemErrNow }
+  }
+
+  // The DMA command port to the core's byte mover.
+  for (b <- io.pmem; regs <- pmemRegs) {
+    b.start := pmemStartOk
+    b.src := regs.dmaSrc
+    b.dst := regs.dmaDst
+    b.size := regs.dmaSize
+    // The START write carries this transfer's DIR, so the launch uses the
+    // written bit rather than the value latched a cycle earlier.
+    b.dir := Mux(pmemStartOk, io.wdata(1), regs.dmaDir)
+  }
+
+  // ---- entry target, per-mode vector/switch (`m16-chipyard-020`) ----------
+  // §5.2 step 1: a synchronous exception / asynchronous interrupt enters the
+  // monitor of the *exception-time* run mode (`U→cfx0`, `J→cfx1`, `S→cfx2`,
+  // `H→cfx3`).  A profile that does not implement that cfx (Tiny has no U/S
+  // monitors; J is absent everywhere) falls back to the frame monitor, which is
+  // exactly the pre-020 behaviour.  `targetSel = 1` keeps the `CFXESC` path
+  // (enter the current cfx, §5.3 step 0) and `targetSel = 2` is a legal
+  // `trap` (enter the named cfx, §5.2 step 1).
+  private val hitCur = VecInit(gp.cfx.map(c => curCfx === c.id.U(6.W)))
+  private val curImplemented = hitCur.asUInt.orR
+  private val curIdx = PriorityEncoder(hitCur)
+  private val hitMonitor = VecInit(gp.cfx.zipWithIndex.map {
+    case (_, i) => i.U === monitor.U })
+  private val hitModeMon = VecInit(gp.cfx.map(c => c.id.U(6.W) === runMode))
+  private val modeMonImplemented = hitModeMon.asUInt.orR
+  private val modeSel =
+    if (gp.modeEntry) Mux(modeMonImplemented, hitModeMon, hitMonitor)
+    else hitMonitor
+  private val hitExplicit = VecInit(gp.cfx.map(c => c.id.U(6.W) === io.excp.targetHa))
+  private val explicitImplemented = hitExplicit.asUInt.orR
+  private val entrySel =
+    Mux(io.excp.targetSel === 1.U && curImplemented, hitCur,
+      Mux(io.excp.targetSel === 2.U && explicitImplemented, hitExplicit, modeSel))
+  private val entryIdx = PriorityEncoder(entrySel)
+  private val entryHa = Mux1H(entrySel, gp.cfx.map(c => c.id.U(6.W)))
+  // The frame the core observes and `escape` returns from is the current
+  // cfx's; an unimplemented current code has no frame (fall back to the monitor
+  // for the traces only).
+  private val viewIdx = Mux(curImplemented, curIdx, monitor.U)
+
+  // Per-cfx `<mode>_excp_vector` (step 7) and `<mode>_switch_run_mode`
+  // (step 6).  A common cfx carries real cg0-cg2 rows and its cg3 row is the
+  // legacy hypv one; a cfx without the common face has only the cg3 row, so its
+  // switch value stays the configured constant for every mode.
+  private val perModeVectors: Seq[UInt] = gp.cfx.zipWithIndex.map { case (c, i) =>
+    commonById.get(c.id) match {
+      case Some(e) => MuxLookup(runMode, vector(i))(Seq(
+        0.U -> e.regs.vector(0), 1.U -> e.regs.vector(1),
+        2.U -> e.regs.vector(2)))
+      case None => vector(i)
+    }
+  }
+  private val perModeSwitches: Seq[UInt] = gp.cfx.map { c =>
+    commonById.get(c.id) match {
+      case Some(e) => MuxLookup(runMode, gp.switchModeValue.U(gp.dataBits.W))(Seq(
+        0.U -> e.regs.switchMode(0), 1.U -> e.regs.switchMode(1),
+        2.U -> e.regs.switchMode(2), 3.U -> e.regs.switchMode(3)))
+      case None => gp.switchModeValue.U(gp.dataBits.W)
+    }
+  }
+  private def perModeVector(idx: UInt): UInt = VecInit(perModeVectors)(idx)
+  private def perModeSwitch(idx: UInt): UInt = VecInit(perModeSwitches)(idx)
+
+  private val hasFrame = causeId(viewIdx) =/= 0.U
+  io.monitorHa := gp.cfx(monitor).id.U(6.W)
+  io.vector := vector(monitor)
+  io.entryVector := (if (gp.modeEntry) perModeVector(entryIdx)
+    else vector(entryIdx))
+  // Trace-only: `cause_id != 0` says a frame was entered.  `escape` does **not**
+  // use it as a validity gate (`ADR-0061` R3-D5: no frame-valid bit).
+  io.frameValid := hasFrame
+  io.causeId := causeId(viewIdx)
+  io.causeIp := prevIp(viewIdx)
+  io.causeInfo := causeInfo(viewIdx)
+  io.prevMode := prevMode(viewIdx)
+  io.prevCfx := prevCfx(viewIdx)
+  io.runMode := runMode
+  io.curCfx := curCfx
+
+  // ---- two-axis authority (`m16-chipyard-020`, ADR-0045 D1/D2/D6) --------
+  // Final allow = run-mode axis AND cfx-resource axis.  The cfx axis is the
+  // addressed cfx's `<mode>_cfxreg` source mask (bit = *source* cfx,
+  // `inner_cfx_code`); the mode axis is the supv-only `cg3 rc12`
+  // `cg_reg_deleg` bitmap (bit = addressed cg, no self exemption,
+  // `contract-see` §3).  Self bypasses the cfx axis only.
+  //
+  // Every run mode is enforced (`m17-chipyard-001`; `DIV-07` closed).  In hypv
+  // the mask row is the cfx's legacy `cg3 rc0`-`rc3` set: Kaiwu-Tiny's only
+  // row (its body runs as `cfx_power`, and the reset masks let it reach
+  // `cfx_hmon`), and the Vast delivery chain hands the body to `cfx_hmon`.
+  // A test body opens the masks of the cfx it touches first — that is the
+  // test-side preparation the divergence's `close_when` asks for.  The U/J/S
+  // rows keep the monitor common face's per-mode rows and stay fail-closed for
+  // a cfx without one (`DIV-09`).
+  private val addrIsCur = curImplemented && io.addr.ha === curCfx
+  private val sourceBit = (1.U(gp.dataBits.W) << curCfx)(gp.dataBits - 1, 0)
+  private def legacyMaskOf(id: Int, kind: Int): UInt =
+    sourceMask(cfxIndexById(id))(kind)
+  private val modeRowIdx = Mux(runMode <= 2.U, runMode, 0.U)
+  private val targetIsCommon: Bool = Mux1H(hit, gp.cfx.map { c =>
+    if (commonById.contains(c.id)) true.B else false.B
+  })
+  /** The addressed cfx's `<mode>_<kind>` source mask word (U/J/S rows); in
+    * hypv every cfx uses its legacy `cg3 rc0`-`rc3` word. */
+  private def targetMask(kind: Int): UInt = Mux1H(hit, gp.cfx.map { c =>
+    commonById.get(c.id) match {
+      case Some(e) => Mux(runMode <= 2.U, e.regs.mask(modeRowIdx)(kind),
+        legacyMaskOf(c.id, kind))
+      case None => legacyMaskOf(c.id, kind)
+    }
+  })
+  /** The addressed cfx's `cg3 rc12` delegation bitmap (legacy cfx: reset). */
+  private val targetDeleg: UInt = Mux1H(hit, gp.cfx.map { c =>
+    commonById.get(c.id).map(_.regs.deleg).getOrElse(allOnes)
+  })
+  // A U/J/S access to a cfx without `<mode>` rows has no mask to allow it:
+  // fail closed (the register rules still report CFXREG for the row itself).
+  // In hypv the legacy word is the row, so a non-common cfx is checked there.
+  private val rowAvailable = targetIsCommon || runMode === gp.hypvMode.U
+  private def axisDenied(kind: Int): Bool = !addrIsCur &&
+    (!rowAvailable || ((targetMask(kind) & sourceBit) =/= 0.U))
+  private val delegDenied = runMode === 2.U && ((targetDeleg >> io.addr.cg)(0))
+  io.implemented := implemented
+  io.permDenied := implemented && (axisDenied(2) || delegDenied)
+  // `trap` checks only the target's `<mode>_cfxtrap`; the delegation bitmap is
+  // a direct-access rule (`contract-see` §3; QEMU `helper_cfx_trap` matches).
+  io.trapDenied := implemented && axisDenied(0)
+
+  // ---- asynchronous entry (`ADR-0064` D3/D4/D5, hart-first) --------------
+  // Every asynchronous source enters the same `cfx_hart` supv entry, whichever
+  // mode is running.  Each source owns its `cg16 rc16/17/18` mask/pending/ack
+  // (bit = sub-event), and both bitmaps of the `cg15` capture group are indexed
+  // by the *source cfxha* (TIMER = `cfx_hart`'s own id).  Entry needs the
+  // source pending to pass its own mask and the running mode's monitor mask
+  // (`cfx0`-`cfx3 cg15 rc3`); one frame carries every allowed source.  A
+  // non-zero `src_frame` is only the last capture and never blocks an entry —
+  // each entry overwrites the `cg15` capture group as a whole.
+  private def hartOpt: Option[HartRegs] = hartRegs
+  private val timerCond: Bool = hartOpt.map { r =>
+    r.timerEnable && hartTime >= r.timerCmp
+  }.getOrElse(false.B)
+  /** TIMER expiry (`ADR-0064` D3): one pending bit per arming, so only the
+    * compare condition's rising edge is an event.  `ENABLE` 0→1 with
+    * `cfx_time >= cmp` therefore latches pending once (enable checks the
+    * deadline immediately); `ENABLE=0` never produces a new event. */
+  private val timerEvent: Bool = hartOpt.map { r =>
+    timerCond && !r.timerSeen
+  }.getOrElse(false.B)
+  private val timerCmpWrite: Bool =
+    hartRows.map(_.isTimerCmp).getOrElse(false.B) && io.wEn && io.writeOk
+  private val timerAckWrite: Bool =
+    hartRows.map(_.isTimerAck).getOrElse(false.B) && io.wEn && io.writeOk
+  private val pmemAckWrite: Bool =
+    pmemRows.map(_.isDmaAck).getOrElse(false.B) && io.wEn && io.writeOk
+  /** Accepted writes that can make a pending source deliverable (mask/config
+    * or a capture-group write); an ack only removes pending, so it is not a
+    * kick (`ADR-0064` D4).  Registered for the same loop reason as
+    * `pmemEvent`: the core gates its cfx write with `intr.valid`. */
+  private val hartKickWrite: Bool = RegNext(io.wEn && io.writeOk &&
+    (hartRows.map(r => r.isTimerCtrl || r.isTimerCmp || r.isTimerMask ||
+      r.isAsyncSwitch || r.isAsyncVector).getOrElse(false.B) ||
+      pmemRows.map(_.isDmaMask).getOrElse(false.B) || isAsyncMask), false.B)
+  /** The running mode's async source mask (U→cfx0, J→cfx1, S→cfx2, H→cfx3).
+    * A mode whose monitor is not implemented has no policy: it stays masked. */
+  private val asyncMaskByMode: UInt =
+    if (!asyncModel) allOnes
+    else {
+      val perMode = Seq(0, 1, 2, 3).map { m =>
+        gp.cfx.zipWithIndex.collectFirst {
+          case (c, i) if c.id == m => asyncIntrMaskOpt.get(i)
+        }.getOrElse(allOnes)
+      }
+      MuxLookup(runMode, allOnes)(perMode.zipWithIndex.map {
+        case (mask, i) => i.U -> mask })
+    }
+  /** Per-source entry decision (`ADR-0064` D4): `(pending & ~source mask) != 0`
+    * for each source, and TIMER additionally requires `ENABLE=1`.  The source
+    * mask only gates the entry — a masked event still latches `cg16 rc17`.
+    * The frame then applies the running mode's monitor mask; only implemented
+    * sources can appear (their pending bits are the only ones set). */
+  private val timerAllowed: Bool = hartOpt.map { r =>
+    r.timerPending && !r.timerMask && r.timerEnable
+  }.getOrElse(false.B)
+  private val pmemAllowed: Bool = pmemRegs.map { p =>
+    p.dmaPending && !p.dmaMask
+  }.getOrElse(false.B)
+  private val asyncAllowed: UInt =
+    (Mux(timerAllowed, timerSrcBit, 0.U(gp.dataBits.W)) |
+      Mux(pmemAllowed, pmemSrcBit, 0.U(gp.dataBits.W))) & ~asyncMaskByMode
+  /** Run-mode upper bound (`m18-spec-009`, `DADAO-12 §5.4(一)`): an
+    * asynchronous entry only happens while the running mode is at or below
+    * `cg15 rc14` (the same register that sets the entry mode).  Reset 2 means
+    * `hypv` is never interrupted; a pending source above the bound stays
+    * pending with no error. */
+  private val asyncModeAllowed: Bool = hartOpt.map { r =>
+    runMode <= r.asyncSwitch
+  }.getOrElse(false.B)
+  io.intr.frame := asyncAllowed
+  io.intr.vector := hartOpt.map(_.asyncVector).getOrElse(0.U(gp.dataBits.W))
+
+  // Source pending latches (`ADR-0064` D3): an event sets it, only the source
+  // ack (W1C) clears it, an asynchronous entry does not touch it.  A same-cycle
+  // event wins over an ack so a fresh event is never lost.  Software writes
+  // never reach the pending rows (`cg16 rc17` is RO).
+  for (r <- hartOpt) {
+    when(timerAckWrite && io.wdata(0)) { r.timerPending := false.B }
+    when(timerEvent) { r.timerPending := true.B }
+    // A rewritten deadline is a fresh arming: the compare condition on the new
+    // value must be able to raise a new event even if the old one matched.
+    when(timerCmpWrite) { r.timerSeen := false.B }.otherwise { r.timerSeen := timerCond }
+  }
+  for (p <- pmemRegs) {
+    when(pmemAckWrite && io.wdata(0)) { p.dmaPending := false.B }
+    when(pmemEvent) { p.dmaPending := true.B }
+  }
+
+  // ---- `cfx_ptw` state to the core's address path (D3: outputs) -----------
+  // On a machine without `cfx_ptw` no row can be written, so these keep their
+  // reset values (`TLB-03`) and the core must not treat them as a feature.
+  for (b <- io.ptw; r <- ptwRegs) {
+    b.enable := r.enable
+    b.ptbr := r.ptbr
+    b.tlbAsid := r.asid
+    b.tlbAddrStart := r.addrStart
+    b.tlbAddrSize := r.addrSize
+    b.tlbControl := r.control
+    b.tlbControlData := r.controlData
+  }
+
+  // ---- `cfx_cache` state to the core's maintenance path (D3: outputs) ------
+  // On a machine without `cfx_cache` no row can be written, so these keep their
+  // reset values (`contract-cache` CACHE-07/CACHE-08) and the core must not
+  // treat them as a feature.
+  for (b <- io.cache; r <- cacheRegs) {
+    b.enable := r.enable
+    b.addrStart := r.addrStart
+    b.addrSize := r.addrSize
+    b.control := r.control
+    b.controlData := r.controlData
+  }
+
+  // ---- events and redirect request (D4) -----------------------------------
+  // `escape cfxHA` (`DADAO-12` §5.1/§5.3, `ADR-0061` R3-D5): the core already
+  // rejects `imms18 != 0` as ILLI, so the only operand is `cfxha`.  `cfxha`
+  // must be the *current* cfx; the return tuple comes from that cfx's `cg5`
+  // exit intent `rc8`-`rc11`, and every legality check runs before any state
+  // change: target mode ≤ current mode (no escalation), target cfx
+  // implemented, and that mode's monitor implemented.  There is **no**
+  // frame-valid gate (repeated `escape` is software's responsibility).
+  private val escapeTargetMode: UInt = escapeRunMode(viewIdx)
+  private val escapeTargetCfx: UInt = escapeCfx(viewIdx)(5, 0)
+  private val escapeTargetCfxOk: Bool =
+    VecInit(gp.cfx.map(c => c.id.U(6.W) === escapeTargetCfx)).asUInt.orR
+  private val escapeTargetMonitorOk: Bool =
+    VecInit(gp.cfx.map(c => c.id.U(6.W) === escapeTargetMode.pad(6))).asUInt.orR
+  private val escapeOk =
+    io.escape.valid && curImplemented && io.escape.ha === curCfx &&
+      escapeTargetCfxOk && escapeTargetMonitorOk &&
+      escapeTargetMode <= runMode
+  io.escapeOk := escapeOk
+  /** Probe arming (`ADR-0064` D4): source pending is sticky, so the entry is
+    * only re-evaluated after a source event or a write that can unblock one
+    * (mask/config/`escape`).  Without this the core would re-enter at every
+    * boundary before the handler can ack. */
+  /** `escape` restores the target monitor's `cg15 rc3` and may unblock a
+    * pending source; registered because `escape.valid` is part of the core's
+    * own redirect path and a combinational path would close a loop. */
+  private val escapeKick: Bool = RegNext(escapeOk, false.B)
+  private val asyncKickNow: Bool = hartOpt.map { r =>
+    timerEvent || pmemEvent || hartKickWrite || escapeKick || r.asyncKick
+  }.getOrElse(false.B)
+  io.intr.valid := asyncModel.B && asyncKickNow && asyncAllowed =/= 0.U &&
+    asyncModeAllowed
+  private val escapeTarget =
+    Cat(0.U((gp.dataBits - 48).W), escapeIp(viewIdx)(47, 2), 0.U(2.W))
+  io.escapeTarget := escapeTarget
+  private val escapeCause: UInt = causeId(viewIdx)
+  private val escapeCauseIp: UInt = prevIp(viewIdx)
+
+  io.redirect.valid := io.excp.valid || escapeOk
+  // The target must not depend on `excp.valid`: the core feeds it back into its
+  // own `enterHmon` decision (`finish` checks the low bits for IALIGN), which
+  // would close a combinational loop.  Exception entry and a legal `escape`
+  // never happen in the same cycle, so keying on `escapeOk` alone is exact.
+  io.redirect.target := Mux(escapeOk, escapeTarget, io.entryVector)
+  io.redirect.cause := Mux(io.excp.valid, io.excp.cause,
+    Mux(escapeOk, escapeCause, 0.U(gp.dataBits.W)))
+  io.redirect.causeIp := Mux(io.excp.valid, io.excp.causeIp, escapeCauseIp)
+  io.redirect.info := Mux(io.excp.valid, io.excp.info, 0.U(gp.dataBits.W))
+  io.redirect.isEscape := !io.excp.valid && escapeOk
+
+  // Exception entry wins over an `escape` return in the same cycle: a core
+  // either enters an exception or returns from one, never both, and making the
+  // precedence explicit keeps the state update deterministic.
+  //
+  // The one cycle where an entry and a legal `escape` coincide is the escape
+  // whose return address fails its alignment check: the `escape` commits
+  // (§5.3 step 2 restores mode/cfx) and the resulting `IALIGN` enters
+  // afterwards, so the frame this entry writes must record the *restored*
+  // values (the QEMU model has the same order: restore, then raise).
+  private val entryPrevMode = Mux(escapeOk, escapeRunMode(viewIdx), runMode)
+  private val entryPrevCfx =
+    Mux(escapeOk, escapeCfx(viewIdx), curCfx.pad(gp.dataBits))
+  private val entryPrevIp = io.excp.causeIp
+  private val entryPrevMask =
+    Mux(escapeOk, escapeIntrMask(viewIdx), asyncMaskByMode)
+  when(io.excp.valid) {
+    // §5.2 step 4: entry record rc0-rc5 + a hardware copy into the exit intent
+    // rc8-rc11.  `prev_cfx_code` is sampled before step 6 rewrites it.
+    prevMode(entryIdx) := entryPrevMode
+    prevCfx(entryIdx) := entryPrevCfx
+    prevIp(entryIdx) := entryPrevIp
+    prevIntrMask(entryIdx) := entryPrevMask
+    causeId(entryIdx) := io.excp.cause
+    causeInfo(entryIdx) := io.excp.info
+    escapeRunMode(entryIdx) := entryPrevMode
+    escapeCfx(entryIdx) := entryPrevCfx
+    escapeIp(entryIdx) := Cat(0.U((gp.dataBits - 48).W),
+      entryPrevIp(47, 2), 0.U(2.W))
+    escapeIntrMask(entryIdx) := entryPrevMask
+    // §5.2 step 6: the new run mode is the entry target's `<mode>` switch
+    // value; without the mode routing (Tiny) it stays hypv as before.
+    runMode := (if (gp.modeEntry) perModeSwitch(entryIdx)
+      else gp.hypvMode.U(gp.modeBits.W))
+    curCfx := entryHa
+  }.elsewhen(escapeOk) {
+    // §5.3 steps 1/2: restore the run mode and current cfx from the exit intent.
+    runMode := escapeRunMode(viewIdx)
+    curCfx := escapeCfx(viewIdx)(5, 0)
+  }
+
+  // §5.3 step 3: `rc11` is written **whole-word** into the target mode
+  // monitor's `cg15 rc3` (user→umon, supv→smon, hypv→hmon), atomically with
+  // the mode/cfx switch and the jump.  A target mode without a monitor row was
+  // rejected above, so at most one entry matches.
+  for (m <- asyncIntrMaskOpt; (c, i) <- gp.cfx.zipWithIndex) {
+    when(escapeOk && escapeTargetMode === c.id.U(6.W)) {
+      m(i) := escapeIntrMask(viewIdx)
+    }
+  }
+
+  // ---- asynchronous entry (`ADR-0064` D3/D4/D5, hart-first) ---------------
+  // One *capture* per instruction boundary, whatever the number of sources it
+  // carries: `rc4` := the offered union (already pending-and-allowed), source
+  // pending is NOT consumed (`ADR-0064` D3), `excp_async_num` counts the entry
+  // once and the record points at the committed instruction's successor.  The
+  // target is `cfx_hart`; the entry mode is `cg15 rc14` (reset 2 = supv), which
+  // is also the entry upper bound.  Every entry overwrites `cg15 rc0`-`rc4` and
+  // copies the exit intent into **hart's own `cg5 rc8`-`rc11`** (never rc0-rc3).
+  when(io.intr.ack && io.intr.valid) {
+    for (r <- hartOpt) {
+      val hartIdx = cfxIndexById(gp.hart.get.cfxId)
+      r.asyncKick := false.B
+      val prevMaskNow = asyncMaskByMode
+      val causedIp = Cat(0.U((gp.dataBits - 48).W),
+        io.intr.causeIp(47, 2), 0.U(2.W))
+      r.asyncPrevMode := runMode
+      r.asyncPrevCfx := curCfx
+      r.asyncCauseIp := causedIp
+      r.asyncPrevMask := prevMaskNow
+      r.asyncSrcFrame := asyncAllowed
+      // `cg15 rc5` is the live raw pending summary (`pendingSummary`); the
+      // entry does not clear source pending (`ADR-0064` D3).
+      escapeRunMode(hartIdx) := runMode
+      escapeCfx(hartIdx) := curCfx.pad(gp.dataBits)
+      escapeIp(hartIdx) := causedIp
+      escapeIntrMask(hartIdx) := prevMaskNow
+      runMode := r.asyncSwitch
+      curCfx := gp.hart.get.cfxId.U(6.W)
+    }
+  }
+  // A new source event in the same cycle as an entry re-arms the probe so the
+  // fresh event is not lost (`ADR-0064` D4).  The config write that caused
+  // this entry must NOT re-arm, or it would re-enter before the handler acks.
+  for (r <- hartOpt) {
+    when(timerEvent || pmemEvent) {
+      r.asyncKick := true.B
+    }
+  }
+
+  // ---- cfx config counters (`DADAO-12 §3.5`) ------------------------------
+  // `trap_num` counts `trap` entries (cause bit0 = CFXTRAP), `excp_sync_num`
+  // every other synchronous entry, `excp_async_num` a delivered asynchronous
+  // source and `escape_num` legal `escape` returns from this cfx.
+  for (e <- commonEntries) {
+    when(io.excp.valid && entryHa === e.c.id.U(6.W)) {
+      when(io.excp.cause(0)) { e.regs.trapNum := e.regs.trapNum + 1.U }
+        .otherwise { e.regs.syncNum := e.regs.syncNum + 1.U }
+    }
+    // Asynchronous deliveries are always into `cfx_hart` (`ADR-0060` D1).
+    val isHartEntry = gp.hart.exists(_.cfxId == e.c.id).B
+    when(isHartEntry && io.intr.ack && io.intr.valid) {
+      e.regs.asyncNum := e.regs.asyncNum + 1.U
+    }
+    when(escapeOk && curCfx === e.c.id.U(6.W)) {
+      e.regs.escapeNum := e.regs.escapeNum + 1.U
+    }
+  }
+
+  // ---- `excp_cause_id` structure at the frame-write point ------------------
+  // `ADR-0062` D1 (`contract-see` §6.1.1): two bits set, or a bit in a reserved
+  // field (`[31:16]`, `[39]`, `[47:40]`, `[57]`, `[63:58]`), is a **design**
+  // error, not a guest-visible fault, so it must stop the simulation by name
+  // instead of silently shipping a frame the handler cannot decode.  This is
+  // the single write point of `cg5 rc2`, so no core can bypass it.
+  //
+  // Two channels on purpose: the `assert` is the failure (unconditional and
+  // fatal: `$error` under Verilator, independent of `+verbose`), the `printf`
+  // carries the offending value on the `PRINTF_COND` channel the harness turns
+  // on with `+verbose` (the same channel as every `WumingCore:` trace).
+  assert(!(io.excp.valid && !GewuCauseId.wellFormed(io.excp.cause)),
+    "GewuFile: malformed excp_cause_id (contract-see 6.1.1 / ADR-0062 D1; exactly one bit, [31:16]/[39]/[47:40]/[57]/[63:58] reserved zero)")
+  when(io.excp.valid && !GewuCauseId.wellFormed(io.excp.cause)) {
+    printf(p"GewuFile: ERROR: malformed excp_cause_id 0x${Hexadecimal(io.excp.cause)}\n")
+  }
+}
