# RUN: %llvm_mc --triple=dadao-unknown-elf -filetype=obj %s -o %t.o
# RUN: %llvm_objcopy -O binary --only-section=.text %t.o %t.bin
# RUN: %qemu -M dadao-m1 -bios %trampoline -kernel %t.bin -display none -nographic

# smoke_add: E2E smoke test — RD arithmetic + XOR+ORR comparison
# Tests: set.zw, add.si, xor.o, or.o
# Comparison pattern: XOR+ORR (ADR-0009 D2)

_start:
    set.zw  rb3, 2, 0xffff
    or.w    rb3, 1, 0x8000
    set.zw  rd1, 0, 100
    set.zw  rd2, 0, 55
    add.si  rd1, -45
    xor.o   rd3, rd1, rd2
    or.o    rd3, rd3, rd0
    br.nz   rd3, Lfail
    st.o    rd3, rb3, 0
Lfail:
    set.zw  rd4, 0, 1
    st.o    rd4, rb3, 0
    swym    0
