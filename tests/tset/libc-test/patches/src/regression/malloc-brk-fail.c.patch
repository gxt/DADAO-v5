diff --git a/src/regression/malloc-brk-fail.c b/src/regression/malloc-brk-fail.c
index d0ccd35..9427321 100644
--- a/src/regression/malloc-brk-fail.c
+++ b/src/regression/malloc-brk-fail.c
@@ -16,13 +16,55 @@ int main(void)
 	size_t n;
 	int r;
 
+	// Consume the heap donated by the dynamic loader before filling the
+	// address space.  With 64 KiB pages, ldso hands the page-aligned gaps at
+	// the ends of the writable PT_LOAD segments to mallocng
+	// (ldso/dynlink.c reclaim_gaps); on this target those gaps are
+	// single-slot class-39 groups.  Without consuming them, the malloc(10000)
+	// below is served from one of those slots without any brk/mmap syscall,
+	// so "memory is filled" is not true for the allocator.  Six 32736-byte
+	// requests (size class 39, 16-byte aligned) drain the donated groups and
+	// the class-40 arena that follows them.  On the static (lite_malloc) line
+	// they sum to 196416 bytes and leave only 192 bytes of the current brk,
+	// so the same first malloc still has to grow brk/mmap and fails there
+	// too.  The blocks are retained on purpose: freeing them would hand the
+	// slots back to the heap.
+	void *keep[6];
+	int i;
+
+	for (i = 0; i < 6; i++) {
+		keep[i] = malloc(32736);
+		if (!keep[i]) {
+			t_error("prime malloc failed: %s\n", strerror(errno));
+			return 1;
+		}
+	}
+	(void)keep;
+
 	// fill memory, largest mmaped area is [p,p+n)
 	if (t_vmfill(&p, &n, 1) < 1 || n < 2*65536) {
 		t_error("vmfill failed\n");
 		return 1;
 	}
+	// Lower only the soft RLIMIT_DATA value: t_setrlim() sets rlim_max to 0
+	// too, and the kernel's may_expand_vm() Valgrind workaround only lets a
+	// data mapping through when rlimit(RLIMIT_DATA) == 0 *and* the mapping
+	// still fits in rlimit_max(RLIMIT_DATA).  With max also 0 that workaround
+	// never applies, so the mmap(64 KiB) done after the munmap below would be
+	// refused as well.  Keeping the (unlimited) hard limit preserves the
+	// intent of the test: malloc fails while the address space is full and
+	// succeeds once 64 KiB is unmapped.
+	struct rlimit rl;
 	errno = 0;
-	T(t_setrlim(RLIMIT_DATA, 0));
+	if (getrlimit(RLIMIT_DATA, &rl) != 0) {
+		t_error("getrlimit(RLIMIT_DATA) failed: %s\n", strerror(errno));
+		return 1;
+	}
+	rl.rlim_cur = 0;
+	if (setrlimit(RLIMIT_DATA, &rl) != 0) {
+		t_error("setrlimit(RLIMIT_DATA) failed: %s\n", strerror(errno));
+		return 1;
+	}
 
 	// malloc should fail here
 	errno = 0;
