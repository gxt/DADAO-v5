+static BOOL cnf_SymbolEqualPointer(POINTER A, POINTER B)
+/********************************************************
+  INPUT:   Two symbol values passed through the POINTER-typed
+           list comparator interface.
+  RETURNS: TRUE iff both denote the same SPASS symbol.
+  NOTE:    The original code cast symbol_Equal (BOOL(int,int)) to
+           BOOL(*)(POINTER,POINTER), which is undefined behaviour and
+           breaks on ABIs that pass integers and pointers in different
+           register banks.  This wrapper has the comparator's real
+           prototype and converts the two POINTER values back to the
+           SYMBOL integers they carry, then calls the original function.
+*********************************************************/
+{
+  return symbol_Equal((SYMBOL)(intptr_t) A, (SYMBOL)(intptr_t) B);
+}
