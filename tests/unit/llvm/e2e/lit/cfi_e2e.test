# CFI end-to-end (m14-llvm-004).
#
# Assembles tests/unit/llvm/e2e/cfi_e2e.s (a main() carrying
# .cfi_startproc/.cfi_endproc + .cfi_def_cfa/.cfi_def_cfa_offset/
# .cfi_def_cfa_register/.cfi_offset), links it with the shared crt0 and the
# Tiny contract linker script, and runs it on qemu dadao-tiny with semihosting.
#
# Checks, in order:
#   1. the CFI directives assemble (llvm-mc rc = 0, no abort);
#   2. .eh_frame survives linking (orphan section, no DISCARD rule) and is
#      visible in the linked image;
#   3. the guest exit code is 0 -- CFI state must not change code semantics.
#
# RUN: %llvm_mc --triple=dadao-unknown-elf -filetype=obj %e2e_dir/cfi_e2e.s -o %t.o
# RUN: %llvm_mc --triple=dadao-unknown-elf -filetype=obj %crt0 -o %t.crt0.o
# RUN: %ld -T %linker_script %t.crt0.o %t.o -o %t.elf
# RUN: %llvm_objdump -h %t.elf | %FileCheck %s --check-prefix=SEC
# RUN: timeout 30 %qemu -machine dadao-tiny,bootrom-image=%bootrom -kernel %t.elf -semihosting-config enable=on,target=native -display none -nographic
#
# SEC: .eh_frame
