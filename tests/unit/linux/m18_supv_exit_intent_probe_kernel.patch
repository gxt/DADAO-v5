--- a/arch/dadao/kernel/k2_selftest.c
+++ b/arch/dadao/kernel/k2_selftest.c
@@ -774,6 +774,108 @@ static void __init __noreturn k2_case_p11(void)
 	dadao_early_exit(0x7f);
